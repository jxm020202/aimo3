       | import random, math, numpy as np
       | 
       | def water_volume(alpha):
       |     beta = 8 - alpha
       |     s2 = alpha**2 + beta**2 + 4
       |     s = math.sqrt(s2)
       |     # Monte Carlo integration for V_param
       |     N = 2000000
       |     count = 0
       |     for _ in range(N):
       |         u = random.random()
       |         v = random.random()
       |         w = random.random()
       |         if 2*u + alpha*v + beta*w <= 7:
       |             count += 1
       |     V_param = count / N
       |     return s**3 * V_param
       | 
       | for a in [2,3,4,5,6,7]:
       |     print(a, water_volume(a))
