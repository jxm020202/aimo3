       | def v_p_binom_central(i, p=5):
       |     n = 2**(i-1)
       |     # compute v_p of binom(2n, n)
       |     def v_fact(m):
       |         cnt=0
       |         power=p
       |         while power<=m:
       |             cnt+=m//power
       |             power*=p
       |         return cnt
       |     return v_fact(2*n)-2*v_fact(n)
