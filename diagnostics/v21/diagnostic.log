       | a,b,c = sp.symbols('a b c', positive=True, integer=True)
       | # define cosθ and sinθ
       | cos_theta = (b**2 + c**2 - a**2) / (2*b*c)
       | # sinθ expression using sqrt
       | sin_theta = sp.sqrt(1 - cos_theta**2)  # symbolic sqrt
       | 
       | # t
