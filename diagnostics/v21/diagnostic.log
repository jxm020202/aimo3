       | 
       | # E coordinates
       | xE = c*cos_theta
       | yE = c*sin_theta
       | 
       | # lambda
       | lam = -yD / (yE - yD)
       | 
       | # X coordinate
       | xX = xD + lam * (xE - xD)
       | 
