            def solve_min_dominos_general(n):
                # generate dominos
                dominos = []
                for r in range(1, n+1):
                    for c in range(1, n):
                        dominos.append(('H', r, c))
                for r in range(1, n):
                    for c in range(1, n+1):
                        dominos.append(('V', r, c))
                num_vars = len(dominos)
                # map cell to dominos covering it
                cell_to_dominos = {}
                for i, d in enumerate(dominos):
                    typ, r, c = d
                    cells = [(r,c), (r,c+1)] if typ=='H' else [(r,c), (r+1,c)]
                    for cell in cells:
                        cell_to_dominos.setdefault(cell, []).append(i)
                rows = []
                lbs = []
                ubs = []
                # non-overlap constraints: each cell covered at most once
                for r in range(1, n+1):
                    for c in range(1, n+1):
                        row = np.zeros(num_vars, dtype=int)
                        for idx in cell_to_dominos.get((r,c), []):
                            row[idx] = 1
                        rows.append(row)
                        lbs.append(-np.inf)
                        ubs.append(1)
                # blocking constraints
                for i, d in enumerate(dominos):
                    typ, r, c = d
                    # define neighbor sets for each direction
                    neighbor_sets = []
                    if typ == 'H':
                        # left
                        if c-1 >= 1:
                            neighbor_sets.append([(r, c-1)])
                        # right
                        if c+2 <= n:
                            neighbor_sets.append([(r, c+2)])
                        # up
                        up_cells = []
                        if r-1 >= 1:
                            up_cells.append((r-1, c))
                            up_cells.append((r-1, c+1))
                        if up_cells:
                            neighbor_sets.append(up_cells)
                        # down
                        down_cells = []
                        if r+1 <= n:
                            down_cells.append((r+1, c))
                            down_cells.append((r+1, c+1))
                        if down_cells:
                            neighbor_sets.append(down_cells)
                    else: # vertical
                        # up
                        if r-1 >= 1:
                            neighbor_sets.append([(r-1, c)])
                        # down
                        if r+2 <= n:
                            neighbor_sets.append([(r+2, c)])
                        # left
                        left_cells = []
                        if c-1 >= 1:
                            left_cells.append((r, c-1))
                            left_cells.append((r+1, c-1))
                        if left_cells:
                            neighbor_sets.append(left_cells)
                        # right
                        right_cells = []
                        if c+1 <= n:
                            right_cells.append((r, c+1))
                            right_cells.append((r+1, c+1))
                        if right_cells:
                            neighbor_sets.append(right_cells)
                    # For each neighbor set, need at least one occupied cell
                    for cell_set in neighbor_sets:
                        row = np.zeros(num_vars, dtype=int)
                        for cell in cell_set:
                            for idx in cell_to_dominos.get(cell, []):
                                row[idx] = 1
                        rows.append(row)
                        lbs.append(1)
                        ubs.append(np.inf)
                A = np.vstack(rows)
                lb = np.array(lbs, dtype=float)
                ub = np.array(ubs, dtype=float)
                c_vec = np.ones(num_vars, dtype=int)  # minimize number of dominos
                lin_con = LinearConstraint(A, lb, ub)
                bounds = Bounds(0, 1)
                res = milp(c=c_vec, constraints=lin_con, integrality=np.ones(num_vars, dtype=int), bounds=bounds, options={'presolve': True, 'disp': False})
                return res, dominos
            
