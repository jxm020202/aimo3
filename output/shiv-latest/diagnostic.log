            def bron_kerbosch(R, P, X, adj):
                # R, P, X are bitsets (ints)
                # Return size of max clique found in this branch
                global max_clique_size, start_time
                # pruning: if |R| + |P| <= max_clique_size, cannot improve
                rsize = R.bit_count()
                psize = P.bit_count()
                if rsize + psize <= max_clique_size:
                    return
                if P == 0 and X == 0:
                    # maximal clique
                    if rsize > max_clique_size:
                        max_clique_size = rsize
                    return
                # Choose pivot u from P ∪ X with max degree in P (heuristic)
                # Use simple heuristic: pick u with max |P ∩ N(u)|
                # Compute union
                U = P | X
                # Find pivot
                # iterate bits in U to find max
                max_neighbors = -1
                u = None
                uu = U
                while uu:
                    v = (uu & -uu).bit_length() - 1  # get index of lowest set bit
