            def max_visible(points):
                n=len(points)
                rad=math.radians(100)
                a=[0]*n
                for i,(xi,yi) in enumerate(points):
                    angles=[]
                    for j,(xj,yj) in enumerate(points):
                        if i==j: continue
                        ang=math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                    angles.sort()
                    angles2=angles+[a+2*math.pi for a in angles]
                    left=0
                    maxc=0
                    for right in range(len(angles2)):
                        while angles2[right]-angles2[left] > rad+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>maxc:
                            maxc=cnt
                    a[i]=maxc
                return a, sum(a)
            
            def random_points_in_circle(n, radius=1.0):
                pts=[]
                for _ in range(n):
                    r=radius*math.sqrt(random.random())
                    theta=2*math.pi*random.random()
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def points_on_arc(n, radius=1.0, arc_deg=90):
                start=-math.radians(arc_deg)/2
                end=math.radians(arc_deg)/2
                angles=[start + (end-start)*i/(n-1) for i in range(n)]
                pts=[(radius*math.cos(a), radius*math.sin(a)) for a in angles]
                return pts
            
