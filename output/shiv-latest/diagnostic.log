            def max_edges_given_caps(n):
                # caps: for i from 1..n-1, cap_i = i; for i=n, cap_n = n-1
                caps = [i for i in range(1, n)] + [n-1]
                # Use a priority queue (max-heap)
                import heapq
                # We'll store negative remaining degree to make max-heap
                heap = [(-caps[i], i) for i in range(n)]  # i index 0..n-1 corresponds to vertex i+1
                heapq.heapify(heap)
                edges = 0
                # adjacency not needed, just track degrees
                while heap:
                    # pop vertex with highest remaining degree
                    d_neg, v = heapq.heappop(heap)
                    d = -d_neg
                    if d == 0:
                        # all remaining vertices have zero degree
                        break
                    # Need to connect v to d other vertices with highest remaining degree
                    # Ensure there are at least d other vertices left
                    if d > len(heap):
                        # cannot satisfy degree, reduce d to len(heap)
                        d = len(heap)
                    # Pop next d vertices
                    temp = []
                    for _ in range(d):
                        if not heap:
                            break
                        d2_neg, u = heapq.heappop(heap)
                        d2 = -d2_neg
                        # connect v-u
                        edges += 1
                        # decrement degree of u
                        d2 -= 1
                        temp.append((d2, u))
                    # after connecting, v's degree becomes 0 (we used all d)
                    # push back the updated other vertices if they still have degree >0
                    for d2, u in temp:
                        heapq.heappush(heap, (-d2, u))
                return edges
            
