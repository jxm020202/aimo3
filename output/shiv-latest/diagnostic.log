            def compute_PT(side_len):
                # side_len for QR, RS, ST
                P = sp.Point(0,0)
                Q = sp.Point(2,0)
                # direction QR: angle 105°
                theta_QR = sp.pi*105/180
                QR_vec = side_len * sp.Matrix([sp.cos(theta_QR), sp.sin(theta_QR)])
                R = sp.Point(Q.x + QR_vec[0], Q.y + QR_vec[1])
                # direction RS: left turn 90°
                theta_RS = theta_QR + sp.pi/2
                RS_vec = side_len * sp.Matrix([sp.cos(theta_RS), sp.sin(theta_RS)])
                S = sp.Point(R.x + RS_vec[0], R.y + RS_vec[1])
                # Solve for T on x=0 line such that distance ST = side_len
                y = sp.symbols('y')
                eq = (S.x - 0)**2 + (S.y - y)**2 - side_len**2
                sol = sp.solve(eq, y)
                # choose larger positive solution
                y_val = max(sol)
                PT_len = sp.sqrt((0-0)**2 + (y_val-0)**2)
                return sp.simplify(PT_len)
            for L in [sp.sqrt(2), 1, sp.sqrt(3)]:
                print(L, compute_PT(L))
            
