            def max_A_minus_B_possible():
                # We'll search integer A,B satisfying inequality and also trivial constraints 0<=B<=E, 0<=A<=E
                E=n*(n-1)//2
                max_diff=0
                best=None
                for A in range(E+1):
                    # compute lower bound on B
                    lower = max(0, (2*A*A / n - A) / (n-2))
                    # B must be integer >= ceil(lower)
                    B_min=math.ceil(lower)
                    # also B <= E - A (since total edges)
                    if B_min > E - A:
                        continue
                    diff = A - B_min
                    if diff > max_diff:
                        max_diff=diff
                        best=(A,B_min)
                return max_diff,best
            
