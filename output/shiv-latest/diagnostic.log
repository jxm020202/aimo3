            def construct_graph(n):
                edges = set()
                for i in range(1, n+1):
                    # connect i to next i vertices (higher index) if possible
                    for j in range(i+1, min(n+1, i+1+i)):
                        edges.add((i,j))
                # compute degrees
                deg = [0]*(n+1)
                for (i,j) in edges:
                    deg[i] += 1
                    deg[j] += 1
                return deg[1:], edges
            
