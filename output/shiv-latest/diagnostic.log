            import sympy as sp
            
            def ratio(n):
                k=sp.symbols('k', integer=True, positive=True)
                A = sp.summation(1/(k*(2*k-1)), (k,1,n))
                # denominator sum from k=0 to n-1
                k=sp.symbols('k', integer=True)
                B = sp.summation(1/((k+n+1)*(2*n - k)), (k,0,n-1))
                return sp.simplify(A/B)
            
            for n in range(1,10):
