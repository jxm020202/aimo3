# Let's compute indegree multisets for g and h for n=866 as a test
def g_map(n):
    d = {}
    for x in range(1, n+1):
        y = (866 * x) % n
        if y == 0:
            y = n
        d[x] = y
    return d

def h_map(n):
    m = n + 1
    d = {}
    for x in range(1, n+1):
        y = pow(x, 866, m)
        if y == 0:
            # y=0 is not in domain {1..n}, but this should not happen for x in 1..n when m>1
            # However if y==0, map is invalid for our requirement, we set to None
            d[x] = None
        else:
            d[x] = y
    return d

def indegree_map(mapping):
    indeg = {k:0 for k in mapping}
    for x, y in mapping.items():
        indeg[y] += 1
    # return sorted list of indegrees
    return sorted(indeg.values())

n = 866
