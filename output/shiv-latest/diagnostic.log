            def can_slide(p, placements_set):
                # placements_set: set of indices of placed dominos
                # returns True if any slide possible
                # Determine direction possibilities
                r,c = p['pos']
                if p['type']=='H':
                    # left
                    if c-1 >= 0:
                        # check if cell (r,c-1) empty
                        occupied = any((r,c-1) in placements[i]['cells'] for i in placements_set)
                        if not occupied:
                            return True
                    # right
                    if c+2 <= n-1:
                        occupied = any((r,c+2) in placements[i]['cells'] for i in placements_set)
                        if not occupied:
                            return True
                    # up
                    if r-1 >= 0:
                        # need both cells above empty
                        occupied1 = any((r-1,c) in placements[i]['cells'] for i in placements_set)
                        occupied2 = any((r-1,c+1) in placements[i]['cells'] for i in placements_set)
                        if not (occupied1 or occupied2):
                            # both empty
                            return True
                    # down
                    if r+1 <= n-1:
                        occupied1 = any((r+1,c) in placements[i]['cells'] for i in placements_set)
