                # Precompute bitcount function
                def bitcount(x):
                    return x.bit_count()
                
                # Recursive function
                def expand(Rsize, Pmask, clique_mask):
                    nonlocal best, best_clique_mask
                    if Pmask == 0:
                        if Rsize > best:
                            best = Rsize
                            best_clique_mask = clique_mask
                        return
                    # coloring bound
                    # We'll generate order list and color numbers
                    # Use greedy coloring on Pmask
                    order = []
                    colors = {}
