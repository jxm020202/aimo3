                # We'll create an array of adjacency bitsets restricted to later vertices.
                # Precompute adjacency restricted to order: for each vertex, bits of neighbors that appear later in order.
                pos_in_order = [0]*n
                for idx, v in enumerate(order):
                    pos_in_order[v] = idx
                adj_later = [0]*n
                for v in range(n):
