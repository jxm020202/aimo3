            def max_black_given_B(B):
                # B is binary vector length 361
                # compute b = A @ B (mod 2)
                b = (A @ B) % 2
                # Variables: x (binary length 361), t (integer length 36)
                # We'll formulate constraints: A x - 2 t = b
                # Represent as linear constraints: A x - 2 t - b = 0
                # We'll create matrix for all variables (x then t)
                m = 36
                # Build constraint matrix for milp: each row linear combination = 0
                # We'll use LinearConstraint with lower=upper=0
                # Variables order: first N x variables, then m t variables
                # Build coefficient matrix C of shape (m, N+m)
                C = np.zeros((m, N+m), dtype=int)
                C[:, :N] = A
                C[:, N:] = -2 * np.eye(m, dtype=int)
                # Right-hand side = b
                # LinearConstraint expects lower <= C @ vars <= upper
                lc = LinearConstraint(C, b, b)
                # Bounds: x in [0,1] integer, t free integer (no bounds)
                # milp requires bounds for all variables; we can set large bounds for t
                # set t bounds [-N, N] (since sum a_i x <= N)
                lower = np.concatenate([np.zeros(N), -N*np.ones(m, dtype=int)])
                upper = np.concatenate([np.ones(N), N*np.ones(m, dtype=int)])
                bounds = Bounds(lower, upper)
                # Objective: maximize sum x_i => minimize -sum x_i
                c = np.concatenate([-np.ones(N), np.zeros(m)])  # minimize c^T vars
                # Use milp
                res = milp(c=c, constraints=[lc], bounds=bounds, integrality=np.concatenate([np.ones(N, dtype=int), np.zeros(m, dtype=int)]))
                if not res.success:
                    print("MILP failed")
                    return None
                x_opt = np.round(res.x[:N])
                max_black = int(x_opt.sum())
                return max_black
            
            # Test on random B
            def random_B():
                return np.random.randint(0,2,size=N, dtype=int)
            
