                # define symbolic variables for coordinates in plane: we can param using two basis vectors orthogonal to normal
                # We'll compute line intersection as set of points satisfying both plane equations.
                # Use sympy to get line param: solve linear system of two plane equations.
                lines = []
                for i in prev_indices:
                    a1,b1,c1,d1 = planes[i]
                    # Solve for intersection line (if normals not parallel)
                    # Solve linear equations a0*x + b0*y + c0*z + d0 = 0 and a1*x + b1*y + c1*z + d1 = 0
                    # This yields a line (1 DOF). We'll get param t.
                    # Use sympy linear solve for variables in terms of parameter.
                    x,y,z = sp.symbols('x y z')
                    sol = sp.solve([a0*x + b0*y + c0*z + d0, a1*x + b1*y + c1*z + d1], (x,y,z), dict=True, free_symbol=True)
