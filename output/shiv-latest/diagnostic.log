            import numpy as np, math
            
            def find_solutions_grid(N=401, tol=1e-6):
                sols = []
                for i in range(N):
                    for j in range(N):
                        # map i,j to x,y in [-sqrt(3), sqrt(3)]
                        x = -math.sqrt(3) + 2*math.sqrt(3)*i/(N-1)
                        y = -math.sqrt(3) + 2*math.sqrt(3)*j/(N-1)
                        rad = 3 - x*x - y*y
                        if rad < -1e-9:
                            continue
                        if rad < 0:
