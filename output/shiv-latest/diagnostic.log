            def compute_x(y_val,z_val):
                a_val = 3 - y_val**2 - z_val**2
                if a_val < -1e-9:
                    return None
                denom = y_val**3 + a_val*z_val
                if abs(denom) < 1e-12:
                    # handle separately
                    return None
                x_val = (3 - y_val*z_val**3) / denom
                return x_val
            
            def verify_solution(x_val,y_val,z_val, tol=1e-6):
                return (abs(x_val**2 + y_val**2 + z_val**2 - 3) < tol and
