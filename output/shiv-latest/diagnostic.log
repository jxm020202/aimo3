            def max_edges_under_caps(n):
                # capacities: cap[i] for vertex i (1-indexed)
                caps = [i for i in range(1, n)] + [n-1]  # length n
                # We'll use a list of (cap, vertex) and sort each iteration
                # Use simple loop O(n^2) maybe okay for n=2000
                edges = 0
                # Use while any cap >0
                while True:
                    # find vertex with max cap
                    max_cap = max(caps)
                    if max_cap == 0:
                        break
                    v = caps.index(max_cap)  # first occurrence
                    # Determine partners
                    # list of indices with cap>0 excluding v
                    partners = [i for i, c in enumerate(caps) if c>0 and i!=v]
                    if len(partners) < max_cap:
                        # reduce cap to len(partners)
                        caps[v] = len(partners)
                        max_cap = caps[v]
                    # connect to max_cap partners with highest caps
                    # sort partners by caps descending
                    partners.sort(key=lambda i: caps[i], reverse=True)
                    selected = partners[:max_cap]
                    # decrement caps
                    for u in selected:
                        caps[u] -= 1
                    caps[v] = 0
                    edges += max_cap
                total_cap_sum = sum([i for i in range(1, n)] + [n-1])
                return edges, total_cap_sum
            
            for n in [10,20,30,40,50]:
                edges,total = max_edges_under_caps(n)
                print(n, edges, total, total-2*edges)
            
