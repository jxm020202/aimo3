            def gf2_nullspace(mat):
                # mat shape (m,n)
                m,n = mat.shape
                # Perform Gaussian elimination to row echelon form, track pivot columns
                A = mat.copy()
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot row
                    pivot = None
                    for r in range(row, m):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    if pivot != row:
                        A[[pivot, row]] = A[[row, pivot]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r, col]:
                            A[r] ^= A[row]
                    pivot_cols.append(col)
                    row += 1
                    if row == m:
                        break
                rank = len(pivot_cols)
                free_cols = [c for c in range(n) if c not in pivot_cols]
                # basis vectors for nullspace: for each free column, set that free var =1, others 0, solve for pivot vars
                basis = []
                for free in free_cols:
                    x = np.zeros(n, dtype=np.uint8)
                    x[free] = 1
                    # back substitution to compute pivot vars
                    # iterate rows in reverse order
                    for i in reversed(range(rank)):
                        col = pivot_cols[i]
                        # sum of known variables in this row (excluding pivot col)
                        # row i of A has 1 at pivot col, and possibly other 1s at free cols
                        # compute dot product of row i with x (excluding pivot col)
                        s = (A[i, :] @ x) % 2
                        # Since A[i, col] = 1, we need x[col] = s (to make row dot x = 0)
                        x[col] = s
