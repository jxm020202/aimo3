            def cycle_lengths(perm):
                # perm is dict mapping 1..n to 1..n (list index 1)
                n = len(perm)-1
                visited = [False]*(n+1)
                lengths = []
                for i in range(1,n+1):
                    if not visited[i]:
                        cur = i
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = perm[cur]
                            cnt += 1
                        lengths.append(cnt)
                lengths.sort()
                return lengths
            
            def sigma_perm(n):
                perm = [0]*(n+1)
                for x in range(1,n+1):
                    y = ((866*x - 1) % n) + 1
                    perm[x] = y
