            import itertools, random, math, time, numpy as np
            
            def rand_vector():
                return tuple(random.randint(0,2) for _ in range(6))
            
            def is_independent(vectors):
                # check rank over GF(3)
                # Use numpy with mod 3
                M = np.array(vectors, dtype=int) % 3
                # compute rank over GF(3) via row reduction
                # simple algorithm
                rows = M.tolist()
                rank = 0
                for col in range(6):
                    # find pivot row with non-zero in this column
                    pivot = None
                    for r in range(rank, len(rows)):
                        if rows[r][col] % 3 != 0:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot to current rank row
                    rows[rank], rows[pivot] = rows[pivot], rows[rank]
                    # scale pivot row to make leading 1
                    inv = {1:1, 2:2}[rows[rank][col] % 3]  # 2*2=1 mod3, so inverse of 2 is 2
                    rows[rank] = [(inv * x) % 3 for x in rows[rank]]
                    # eliminate column in other rows
                    for r in range(len(rows)):
                        if r != rank and rows[r][col] % 3 != 0:
                            factor = rows[r][col] % 3
                            rows[r] = [ (rows[r][c] - factor*rows[rank][c]) % 3 for c in range(6) ]
                    rank += 1
                    if rank == len(rows):
                        break
                return rank
            
            def generate_subspace(dim=3):
                # random independent vectors
                while True:
                    gens = []
                    while len(gens) < dim:
                        v = rand_vector()
                        # ensure not zero
                        if all(x==0 for x in v):
                            continue
                        # check independence with existing
                        if is_independent(gens + [v]) == len(gens)+1:
                            gens.append(v)
                    # generate all linear combos
                    # each coefficient in {0,1,2}
                    sub = set()
                    for coeffs in itertools.product([0,1,2], repeat=dim):
                        vec = [0]*6
                        for coeff, gen in zip(coeffs, gens):
                            if coeff==0:
                                continue
                            for i in range(6):
                                vec[i] = (vec[i] + coeff*gen[i]) % 3
                        sub.add(tuple(vec))
                    return sub
            
            def check_property(sub):
                # sub is set of vectors
                for a,b in itertools.combinations(sub,2):
                    same = sum(1 for x,y in zip(a,b) if x==y)
                    if same not in (0,2):
                        return False
                return True
            
            # try many random subspaces
            for trial in range(2000):
                sub = generate_subspace(3)
                if check_property(sub):
                    print("found size", len(sub))
                    break
            
