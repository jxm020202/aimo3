            def compute_F_vec(x):
                # x is list of 9 numbers, sorted ascending
                # compute A = sum_{i=6}^9 x_i - sum_{i=1}^4 x_i
                A = sum(x[5:9]) - sum(x[0:4])
                # B = sum_{i<j} (x_i - x_j)^2 = n*sum x_i^2 - (sum x_i)^2
                n = len(x)
                sum_sq = sum(v*v for v in x)
                sum_ = sum(x)
                B = n * sum_sq - sum_**2
                C = sum_sq
                return (A**2 * B) / (C**3)
            
            def random_search_9(iterations=200000):
                best = -1
