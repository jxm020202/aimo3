            def max_edges_havel_hakimi(n):
                # capacities b_i
                caps = [min(i+1, n-1) for i in range(n)]  # i from 0..n-1 corresponds to vertex i+1
                # adjacency set
                adj = [set() for _ in range(n)]
                # list of vertices with remaining capacity
                # We'll use a list of (remaining, vertex) sorted descending each iteration
                # naive O(n^2) but fine for small n
                remaining = caps[:]
                # We'll iterate while there is a vertex with remaining >0
                while True:
                    # find vertex with max remaining
                    max_rem = max(remaining)
                    if max_rem == 0:
                        break
                    v = remaining.index(max_rem)  # first occurrence
                    # need to connect v to max_rem other vertices that are not already adjacent and have remaining>0
                    # choose vertices with highest remaining
                    candidates = [(remaining[u], u) for u in range(n) if u != v and remaining[u] > 0 and u not in adj[v]]
                    # sort descending by remaining
                    candidates.sort(reverse=True)
                    if len(candidates) < max_rem:
                        # cannot satisfy degree, reduce v's remaining to len(candidates)
                        max_rem = len(candidates)
                    # connect to first max_rem candidates
                    for _, u in candidates[:max_rem]:
                        adj[v].add(u)
                        adj[u].add(v)
                        remaining[u] -= 1
                    remaining[v] = 0
                # compute total edges
                total_edges = sum(len(s) for s in adj)//2
                deg = [len(s) for s in adj]
                return total_edges, deg
            
            for n in range(2, 15):
                edges, deg = max_edges_havel_hakimi(n)
                caps = [min(i+1, n-1) for i in range(n)]
