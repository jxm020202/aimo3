            def min_mean_cycle(V=500):
                # vertices numbered 1..V inclusive (or 0..V-1)
                # We'll use 0-index for arrays: vertex i corresponds to value i+1
                # Precompute weight matrix w[v][u] = floor((v+1)/(u+1))
                values = np.arange(1, V+1)
                # compute matrix using broadcasting
                # w[i][j] = (i+1) // (j+1)
                w = (values[:, None] // values[None, :])  # shape (V, V)
                # dp[k][v] = min weight of walk of length k ending at v
                # We'll keep dp as a 2D array shape (V+1, V)
                dp = np.full((V+1, V), np.iinfo(np.int64).max, dtype=np.int64)
                # base: length 0 walks have weight 0 (starting at any vertex)
                dp[0, :] = 0
                for k in range(1, V+1):
                    # dp[k][v] = min_u dp[k-1][u] + w[v][u]  (note: w[v][u] = floor((v+1)/(u+1))
                    # Use broadcasting: dp[k-1] shape (V,), w[v] shape (V,)
                    # Compute dp[k-1][:, None] + w.T? Actually we need min over u of dp[k-1][u] + w[v][u]
                    # For each v, we can compute dp[k-1] + w[v] (elementwise) and take min.
                    # Use vectorized min across axis 1.
                    dp[k] = np.min(dp[k-1] + w, axis=1)
                # Now compute min mean cycle using Karp's formula.
                # For each vertex v, compute max_{0 <= k <= V-1} (dp[V][v] - dp[k][v]) / (V - k)
                # Then min over v of that max gives min mean weight.
                Vfloat = float(V)
