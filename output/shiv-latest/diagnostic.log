            def find_path_n(n, target_counts):
                N = 1<<n
                target = target_counts[:]  # list length n
                # adjacency list
                neigh = [[] for _ in range(N)]
                for v in range(N):
                    for k in range(n):
                        u = v ^ (1<<k)
                        neigh[v].append((u,k))
                # start at 0
                start = 0
                visited = 1<<start
                path = [start]
                counts = [0]*n
                # recursion
                def dfs(v, visited, depth):
                    if depth == N:
                        # visited all vertices
                        # check counts match target
                        if counts == target:
                            return path[:]
                        else:
                            return None
                    # prune if any count exceeds target
                    for k in range(n):
                        if counts[k] > target[k]:
                            return None
                    # also prune if remaining steps insufficient to reach target counts
                    remaining = N - depth
                    needed = sum(target[k] - counts[k] for k in range(n))
                    if needed > remaining:
                        return None
                    # try neighbors
                    for u,k in neigh[v]:
                        if not (visited>>u)&1:
                            # take edge
                            counts[k] += 1
                            path.append(u)
                            res = dfs(u, visited | (1<<u), depth+1)
                            if res is not None:
                                return res
                            # backtrack
                            path.pop()
                            counts[k] -= 1
                    return None
                return dfs(start, visited, 1)
            
