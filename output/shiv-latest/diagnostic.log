            def compute_ratio(n):
                # b alternating: b_i = (-1)^i
                b = np.array([(-1)**i for i in range(n)], dtype=float)
                # construct T inverse matrix = (1/2) C
                # C_{i,j} = 1 if (j-i) even else -1
                C = np.zeros((n,n))
                for i in range(n):
                    for j in range(n):
                        diff = (j - i) % n
                        C[i,j] = 1 if diff % 2 == 0 else -1
                Tinv = 0.5 * C
                a = Tinv.dot(b)
                max_a = np.max(np.abs(a))
                sums = np.abs(a + np.roll(a, -1))
                max_sum = np.max(sums)
                return max_a, max_sum, max_a / max_sum
            
            for n in [5,7,9]:
                print(n, compute_ratio(n))
            
