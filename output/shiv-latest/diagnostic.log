            def construct_seq(n, S=1):
                # pattern: a_i + a_{i+1} = (-1)**i * S
                a = [0]*n
                a[0] = 0.0  # arbitrary start
                for i in range(n-1):
                    a[i+1] = ((-1)**(i+1) * S) - a[i]  # because a_i + a_{i+1} = (-1)^i S => a_{i+1} = (-1)^i S - a_i
