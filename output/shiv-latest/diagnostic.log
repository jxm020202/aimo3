            import random, math, itertools
            
            def max_in_wedge(points, i, angle_deg=100):
                # points: list of (x,y)
                # compute angles from point i to others
                xi, yi = points[i]
                angles = []
                for j, (xj, yj) in enumerate(points):
                    if j == i: continue
                    ang = math.atan2(yj-yi, xj-xi)  # -pi to pi
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate with +2pi for wrap
                angles2 = angles + [a+2*math.pi for a in angles]
                maxcnt = 0
                j=0
                n=len(angles)
                for k in range(n):
                    while j < k+n and angles2[j] - angles2[k] <= math.radians(angle_deg)+1e-12:
                        j+=1
                    cnt = j - k
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def test_arc(num_points=20, arc_deg=90):
                # place points on unit circle arc from -arc/2 to +arc/2
                points=[]
                for _ in range(num_points):
                    theta = random.uniform(-math.radians(arc_deg)/2, math.radians(arc_deg)/2)
                    points.append((math.cos(theta), math.sin(theta)))
                maxes = [max_in_wedge(points,i) for i in range(num_points)]
                return maxes
            
