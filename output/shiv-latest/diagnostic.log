            def greedy_edges(n):
                import math
                # capacities
                cap = [0]*(n+1)
                for i in range(1, n+1):
                    cap[i] = i
                edges = 0
                # process i descending
                for i in range(n, 0, -1):
                    # need at most cap[i] edges incident to i, but we can only pair with j < i
                    # iterate j descending for maybe better chance to use high j capacities earlier
                    # but we need to stop when cap[i]==0
                    if cap[i]==0:
                        continue
                    for j in range(i-1, 0, -1):
                        if cap[i]==0:
                            break
                        if cap[j]==0:
                            continue
                        if math.gcd(i,j)!=1:
                            continue
                        # add edge
                        cap[i] -= 1
                        cap[j] -= 1
                        edges += 1
                total_degree_used = sum(i - cap[i] for i in range(1,n+1))
                return edges, total_degree_used, cap
            
            edges, deg_used, cap = greedy_edges(200)
            edges, deg_used//2
            
