            def operation_matrix(i,j,n=19):
                # returns vector of length n*n
                vec = [0]*(n*n)
                for k in range(n):
                    vec[i*n + k] = 1  # row i
                    vec[k*n + j] = 1  # column j
                # intersection counted twice -> toggle to 1
                idx = i*n + j
