            def is_graphical(seq):
                # Erdős–Gallai theorem
                seq = sorted(seq, reverse=True)
                if sum(seq) % 2 != 0:
                    return False
                n = len(seq)
                prefix = [0]
                for d in seq:
                    prefix.append(prefix[-1] + d)
                for k in range(1, n+1):
                    left = prefix[k]
                    # right = k*(k-1) + sum_{i=k+1}^n min(d_i, k)
                    right = k*(k-1)
                    for i in range(k, n):
                        right += min(seq[i], k)
                    if left > right:
