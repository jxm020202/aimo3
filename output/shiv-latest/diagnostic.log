            def greedy_independent(order=None):
                if order is None:
                    order = list(range(N))
                    random.shuffle(order)
                independent = set()
                excluded = set()
                for v in order:
                    if v not in excluded:
                        independent.add(v)
                        # exclude its neighbors
                        excluded.update(forbidden_adj[v])
                return independent
            
