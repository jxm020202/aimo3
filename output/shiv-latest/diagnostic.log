            def inv_mod(a,m):
                # compute modular inverse if exists
                for x in range(1,m):
                    if (a*x)%m==1:
                        return x
                return None
            
            def g_of_n(n):
                e5 = sum(n//5**i for i in range(1,20))
                # compute D(n)
                d = D(n)
                # compute 2^{e5} mod 10
                pow2 = pow(2, e5, 10)
                inv_pow2 = inv_mod(pow2,10)
                if inv_pow2 is None:
                    # pow2 may be even, not invertible mod10
                    # but g is odd, so pow2 must be odd? Actually pow2 is even except when e5=0.
                    # Let's compute g via direct product removing 2 and 5.
                    prod=1
                    for i in range(1,n+1):
                        x=i
                        while x%2==0:
                            x//=2
                        while x%5==0:
                            x//=5
                        prod = (prod*x)%10
                    return prod
                else:
                    return (d*inv_pow2)%10
            
