            def ratio(z):
                # compute numerator sum from k=1 to z of 1/(k*(2*k-1))
                # denominator sum from k=0 to z-1 of 1/((k+z+1)*(2*z - k))
                from fractions import Fraction
                num = Fraction(0,1)
                for k in range(1, z+1):
                    num += Fraction(1, k*(2*k-1))
                den = Fraction(0,1)
                for k in range(0, z):
                    den += Fraction(1, (k+z+1)*(2*z - k))
                return num/den
            
            ratio(93)
            
        >>> Output:
            280
            

