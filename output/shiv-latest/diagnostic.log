            from scipy.optimize import LinearConstraint, Bounds, milp
            
            def min_weight_solution(n, r_vec, c_vec):
                N = n*n
                total_vars = N + (2*n-2)
                # objective: minimize sum of x variables (first N)
                c_obj = np.zeros(total_vars)
                c_obj[:N] = 1  # weight of x variables
                # Build constraint matrix rows
                rows = []
                lbs = []
                ubs = []
                # Row constraints
                for i in range(1, n):
                    coeff = np.zeros(total_vars, dtype=int)
                    # row0
                    for j in range(n):
                        coeff[0*n + j] = 1
                    # row i
                    for j in range(n):
                        coeff[i*n + j] = 1
                    # y_i variable
                    y_idx = N + (i-1)
                    coeff[y_idx] = -2
                    rows.append(coeff)
                    lbs.append(r_vec[i-1] % 2)
                    ubs.append(r_vec[i-1] % 2)
                # Column constraints
                for j in range(1, n):
                    coeff = np.zeros(total_vars, dtype=int)
                    # column j
                    for i in range(n):
                        coeff[i*n + j] = 1
                    # row0 sum
                    for jj in range(n):
                        coeff[0*n + jj] = 1
                    # z_j variable
                    z_idx = N + (n-1) + (j-1)
                    coeff[z_idx] = -2
                    rows.append(coeff)
                    lbs.append(c_vec[j-1] % 2)
                    ubs.append(c_vec[j-1] % 2)
                A = np.vstack(rows)
                constraint = LinearConstraint(A, lbs, ubs)
                # bounds: x binary 0-1, y,z integer 0..n
                lower = np.zeros(total_vars)
                upper = np.ones(total_vars) * np.inf
                # set upper for x to 1
                upper[:N] = 1
                # y,z bounds 0..n
                upper[N:] = n
                bounds = Bounds(lower, upper)
                integrality = np.ones(total_vars, dtype=int)  # all integer (binary enforced by bounds)
                res = milp(c=c_obj, constraints=[constraint], bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    # infeasible
                    return None
                # objective value may be float, round
                return int(round(res.fun))
            
            # test for n=3
            print(min_weight_solution(3, [0,0], [0,0]))
            
