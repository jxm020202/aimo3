            def construct_graph_from_deg(seq):
                # seq: list of desired degrees for vertices 0..n-1
                n=len(seq)
                # Use Havel-Hakimi to construct adjacency matrix
                # We'll keep list of (degree, vertex) sorted descending
                import heapq
                # Use max-heap (neg degree)
                heap=[(-seq[i], i) for i in range(n)]
                heapq.heapify(heap)
                adj=[set() for _ in range(n)]
                while heap:
                    deg, v = heapq.heappop(heap)
                    deg = -deg
                    if deg==0:
                        continue
                    # pop next deg vertices
                    if len(heap) < deg:
                        raise ValueError("cannot construct")
                    temp=[]
                    for _ in range(deg):
                        d2, v2 = heapq.heappop(heap)
                        d2 = -d2
                        adj[v].add(v2)
                        adj[v2].add(v)
                        d2 -= 1
                        temp.append((d2, v2))
                    # push back updated vertices
                    for d2, v2 in temp:
                        heapq.heappush(heap, (-d2, v2))
                return adj
            
