            import random, math
            
            def random_point():
                return (random.uniform(-10,10), random.uniform(-10,10))
            
            def count_regions(lines):
                patterns = set()
                for _ in range(200000):
                    x,y = random_point()
                    vals = [a*x + b*y + c for a,b,c in lines]
                    if any(abs(v) < 1e-8 for v in vals):
                        continue
                    signs = tuple(1 if v>0 else -1 for v in vals)
                    patterns.add(signs)
                return len(patterns)
            
            # define lines: we need to generate six lines in plane with three families.
            # Let's pick three directions: direction vectors (1,0), (0,1), (1,1) for simplicity.
            # For each direction, define two parallel lines offset.
            def line_from_point_dir(point, direction):
                # line equation ax+by+c=0 where (a,b) is normal perpendicular to direction
                dx, dy = direction
                # normal vector (a,b) = (dy, -dx)
                a, b = dy, -dx
                # line passes through point (x0,y0): a*x0 + b*y0 + c = 0 => c = -(a*x0 + b*y0)
                x0,y0 = point
                c = -(a*x0 + b*y0)
                return (a,b,c)
            
            # define families
            lines = []
            # family A direction (1,0) horizontal lines y = const
            for y in [-1, 1]:
                lines.append(line_from_point_dir((0,y), (1,0)))
            # family B direction (0,1) vertical lines x = const
            for x in [-1, 1]:
                lines.append(line_from_point_dir((x,0), (0,1)))
            # family C direction (1,1) diagonal lines x - y = const? Actually direction (1,1) normal (-1,1)
            for const in [-2, 2]:
                # line with normal (-1,1) passing through point satisfying -x + y = const
                # choose point (0, const)
                lines.append((-1,1,-const))
            print(lines)
