            def is_graphic(seq):
                # Erdős–Gallai theorem
                seq = sorted(seq, reverse=True)
                n = len(seq)
                if sum(seq) % 2 != 0:
                    return False
                prefix = [0]
                for x in seq:
                    prefix.append(prefix[-1]+x)
                for k in range(1, n+1):
                    left = prefix[k]
                    # right = k*(k-1) + sum_{i=k+1}^{n} min(k, d_i)
                    right = k*(k-1)
                    for i in range(k, n):
                        right += min(k, seq[i])
                    if left > right:
                        return False
                return True
            
            def test_n(n):
                seq = list(range(0, n))  # 0..n-1
                return is_graphic(seq)
            
            for n in range(1, 20):
                print(n, test_n(n))
            
