            def max_visible_from_point(p, others, angle_width=100*math.pi/180):
                # p: tuple (x,y)
                # others: list of points
                angles = []
                for q in others:
                    dx = q[0]-p[0]
                    dy = q[1]-p[1]
                    ang = math.atan2(dy,dx)  # -pi to pi
                    if ang<0:
                        ang += 2*math.pi
                    angles.append(ang)
                angles.sort()
                # duplicate with +2π
                n = len(angles)
                angles2 = angles + [a+2*math.pi for a in angles]
                maxcnt = 0
                j = 0
                for i in range(n):
                    # move j while within interval
                    while j < i+n and angles2[j] - angles2[i] <= angle_width + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_sum(points):
                n = len(points)
                total = 0
                for i in range(n):
                    others = points[:i]+points[i+1:]
                    total += max_visible_from_point(points[i], others)
                return total
            
