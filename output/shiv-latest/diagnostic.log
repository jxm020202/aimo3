                if r1 == r2: # horizontal
                    r = r1
                    c_left = min(c1,c2)
                    # left slide
                    if c_left-1 >= 0:
                        if not occ[r][c_left-1]:
                            # need both target cells empty: cells (r,c_left-1) and (r,c_left)
                            # Wait sliding left moves domino left: new cells would be (r,c_left-1) and (r,c_left)
