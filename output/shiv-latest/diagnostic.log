            def rotate(vec, angle):
                # rotate vector (x,y) by angle (radians) CCW
                x,y = vec
                return sp.Matrix([[sp.cos(angle), -sp.sin(angle)],[sp.sin(angle), sp.cos(angle)]])*sp.Matrix([x,y])
            
            def compute_PT(ccw=True):
                # orientation: if ccw True, rotate left (CCW) at each interior angle; else rotate right (CW)
                # start with vector PQ direction (from P to Q) = (2,0) but we only need direction unit.
                v_in = sp.Matrix([2,0])  # vector from P to Q
                # At Q, interior angle 105 degrees
                angle_Q = sp.rad(105)  # convert to radians
                if not ccw:
                    angle_Q = -angle_Q
                # rotate v_in by angle_Q to get QR direction (same magnitude as v_in? Actually we need length sqrt2)
                # We'll compute unit direction then scale to sqrt2.
                # v_in direction unit = (1,0)
                dir_Q = sp.Matrix([sp.cos(angle_Q), sp.sin(angle_Q)])  # unit direction after rotation
                QR_vec = sqrt2 * dir_Q
                R = Q + sp.Point(QR_vec[0], QR_vec[1])
                # At R, interior angle 90 degrees
                angle_R = sp.rad(90)
                if not ccw:
                    angle_R = -angle_R
                # incoming direction at R is QR_vec (from Q to R)
                # rotate by angle_R to get RS direction (same length sqrt2)
                # Since rotation preserves length, RS_vec = rotate(QR_vec, angle_R)
                RS_vec = rotate(QR_vec, angle_R)
                S = sp.Point(R.x + RS_vec[0], R.y + RS_vec[1])
                # Now we have S. Need to find T such that ST length sqrt2 and PT vertical (since interior angle at P = 90°)
                # Determine PT direction: interior angle at P = 90°, with incoming direction from T to P (vector P - T) and outgoing PQ (2,0)
                # For convex polygon orientation ccw, we need rotate (P - T) by +90° to align with PQ.
                # This implies (P - T) is vertical downwards (0, -k) => T = (0, k) (positive y)
                # For cw orientation, rotate (P - T) by -90° to align with PQ, giving (P - T) vertical upwards => T = (0, -k)
                # We'll handle both.
                # Let PT length = L >0, T = (0, L) for ccw, T = (0, -L) for cw.
                L = sp.symbols('L', positive=True)
                if ccw:
                    T = sp.Point(0, L)
                else:
                    T = sp.Point(0, -L)
                # Condition: distance ST = sqrt2
                eq = (S.distance(T) - sqrt2).expand()
                # Solve for L
                sol = sp.solve(eq, L)
                return sol, S, T, R, Q
            
            sol_ccw, S_ccw, T_ccw, R_ccw, Q_ccw = compute_PT(ccw=True)
            sol_cw, S_cw, T_cw, R_cw, Q_cw = compute_PT(ccw=False)
