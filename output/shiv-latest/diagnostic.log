            def solve_n(n):
                from scipy.optimize import milp, LinearConstraint, Bounds
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                c = np.ones(m)  # minimize sum of y_e (offset)
                # Build triangle constraints
                rows = []
                lbs = []
                for (i,j,k) in itertools.combinations(range(n),3):
                    row = np.zeros(m)
                    idx_ij = edges.index((i,j) if i<j else (j,i))
                    idx_jk = edges.index((j,k) if j<k else (k,j))
                    idx_ik = edges.index((i,k) if i<k else (k,i))
                    row[idx_ij] = 1
                    row[idx_jk] = 1
                    row[idx_ik] = 1
                    rows.append(row)
                    lbs.append(2)  # sum >=2
                A = np.array(rows)
                # lower bounds for each inequality
                lc = LinearConstraint(A, lbs, np.full(len(lbs), np.inf))
                bounds = Bounds(0,2)
                integrality = np.ones(m)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            print(solve_n(5).success)
            
