                return [(866*i) % n for i in range(n)]
            
            def compute_E(n):
                # mapping on C = {1,...,n} represented as indices 0..n-1 corresponding to values 1..n
                m = n+1
                # map index i (value i+1) to value (i+1)^866 mod m, which is in 0..m-1
                # we need mapping within C: if result is 0, we can map to something outside, but we only consider n where no zero occurs
                mapping = []
                for i in range(n):
                    val = pow(i+1, 866, m)
                    if val == 0:
                        # invalid
                        return None
                    # map to index val-1 (since val in 1..n)
                    mapping.append(val-1)
                return mapping
            
            def is_isomorphic(n):
                # check if functional graphs of T and E are isomorphic
                T_map = compute_T(n)
                E_map = compute_E(n)
                if E_map is None:
                    return False
                sig_T = functional_graph_signature(T_map)
                sig_E = functional_graph_signature(E_map)
                return sig_T == sig_E
            
