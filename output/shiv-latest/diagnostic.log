            def hill_climb(points, iterations=20000, step=0.01):
                best_points = [p[:] for p in points]  # copy
                best_sum = sum(max_visible(best_points)[1] for _ in [0])  # compute once
                # Actually compute sum directly
                a, s = max_visible(best_points)
                best_sum = s
                for it in range(iterations):
                    # pick random point index
                    i = random.randrange(len(points))
                    # random move within small radius
                    x,y = best_points[i]
                    angle = random.random()*2*math.pi
                    dx = step*math.cos(angle)
                    dy = step*math.sin(angle)
                    new_x = x+dx
                    new_y = y+dy
                    # ensure within unit circle (playground radius 1)
                    if new_x**2+new_y**2 > 1.0:
                        continue
                    old = best_points[i]
                    best_points[i] = (new_x,new_y)
                    a_new, s_new = max_visible(best_points)
                    if s_new >= best_sum:
                        best_sum = s_new
                        # keep change
                    else:
                        # revert
                        best_points[i] = old
                return best_sum, best_points
            
