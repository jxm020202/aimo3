            for r in range(n):
                for c in range(n-1):
                    placements.append(((r,c),(r,c+1)))  # orientation H
            # Vertical placements
            for r in range(n-1):
                for c in range(n):
                    placements.append(((r,c),(r+1,c)))  # orientation V
            
            len(placements)
            
