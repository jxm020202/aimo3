            import itertools
            import math
            from itertools import combinations
            
            def max_edges_ilp(n):
                # degree upper bounds
                bounds = [min(i, n-1) for i in range(1, n+1)]
                # edges list
                edges = list(combinations(range(n), 2))
                m = len(edges)
                # Use simple brute-force search via bitmask for n up to maybe 12? edges up to 66, 2^66 impossible.
                # We'll use MILP via pulp? Not allowed. Use ortools? not allowed.
                # Use heuristic: start with all edges, then remove edges from vertices exceeding bound.
                # Greedy removal: while any vertex degree > bound, remove an edge incident to that vertex.
                # Choose edge removal that minimally reduces total edges.
                # This may not guarantee optimal but can give lower bound.
                deg = [n-1]*n
                selected = set(edges)
                # while any vertex exceeds bound
                while True:
                    over = [i for i in range(n) if deg[i] > bounds[i]]
                    if not over:
                        break
                    # pick vertex with max excess
                    v = max(over, key=lambda i: deg[i]-bounds[i])
                    # remove an edge incident to v (choose one where other endpoint also exceeds or minimal impact)
                    # choose edge (v,u) where u also exceeds if possible
                    candidates = [ (v,u) for u in range(n) if u!=v and (min(v,u), max(v,u)) in selected ]
                    # prioritize removal where other endpoint also exceeds
                    removed = None
                    for u in range(n):
                        if u==v: continue
                        e = (min(v,u), max(v,u))
                        if e in selected and deg[u] > bounds[u]:
                            selected.remove(e)
                            deg[v]-=1
                            deg[u]-=1
                            removed = e
                            break
                    if removed is None:
                        # remove any edge
                        u = candidates[0][1]
                        e = (min(v,u), max(v,u))
                        selected.remove(e)
                        deg[v]-=1
                        deg[u]-=1
                return len(selected), deg
            
