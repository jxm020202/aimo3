            def construct_path(N):
                if N == 1:
                    return [0]
                if N % 4 == 1:
                    # base N=5
                    path = [1,0,1,2,3,4,3]
                    last = 3
                elif N % 4 == 3:
                    # base N=3
                    path = [0,1,2,1]
                    last = 1
                else:
                    raise ValueError("N must be odd")
                # extend while we can add a block of 4 new indices
                while last + 4 < N:
                    a = last + 1
                    # extension pattern
                    ext = [a, a+1, a, a+1, a+2, a+3, a+4, a+3]
                    path.extend(ext)
                    last = a + 3  # new last index
                return path
            
            def verify(N):
                path = construct_path(N)
                # simulate
                state = [0 if (i%2==0) else 1 for i in range(N)]
                for p in path:
                    state[p] ^= 1
                all_heads = all(s==1 for s in state)
                return all_heads, len(path)
            
