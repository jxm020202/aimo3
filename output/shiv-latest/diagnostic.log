                O1_np = np.array(O1)
                O2_np = np.array(O2)
                R_np = np.array(R_pt)
                v = O2_np - O1_np
                t = np.dot(R_np - O1_np, v) / np.dot(v, v)
                proj = O1_np + t * v
                S_np = 2*proj - R_np
                # length RS
