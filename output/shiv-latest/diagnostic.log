            def is_graphic(seq):
                # Erdős–Gallai theorem
                seq=sorted(seq, reverse=True)
                n=len(seq)
                if sum(seq)%2!=0:
                    return False
                prefix=[0]
                s=0
                for d in seq:
                    s+=d
                    prefix.append(s)
                for k in range(1,n+1):
                    left=prefix[k]
                    right=k*(k-1)+sum(min(d,k) for d in seq[k:])
                    if left>right:
                        return False
                return True
            
