                    return None
                x = res.x[:m]
                t = res.x[m:]
                # round to nearest integer
                x_bin = np.rint(x).astype(int)
                t_bin = np.rint(t).astype(int)
                f = x_bin.sum() - t_bin.sum()
                return f, x_bin, t_bin
            
