                                occ.add(cell)
                        # check each domino
                        blocked = True
                        for idx in combo:
                            typ, r, c, cells = dominos[idx]
                            if typ == 'H':
                                # left
                                if c-1 >= 0:
                                    if (r,c-1) not in occ:
