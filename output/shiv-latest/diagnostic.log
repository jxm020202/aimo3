                remaining = caps[:]
                adj = [set() for _ in range(n)]
                while True:
                    max_rem = max(remaining)
                    if max_rem == 0:
                        break
                    v = remaining.index(max_rem)
                    # candidates sorted by remaining descending
                    candidates = [(remaining[u], u) for u in range(n) if u != v and remaining[u] > 0 and u not in adj[v]]
                    candidates.sort(reverse=True)
                    needed = max_rem
                    if len(candidates) < needed:
                        needed = len(candidates)
                    for _, u in candidates[:needed]:
                        adj[v].add(u)
                        adj[u].add(v)
                        remaining[u] -= 1
                    remaining[v] = 0
                edges = set()
                for i in range(n):
                    for j in adj[i]:
                        if i < j:
                            edges.add((i+1, j+1))
                return edges, adj
            
