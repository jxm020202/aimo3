            import random, math, itertools, sys, time, numpy as np
            
            def max_sum_random(n, trials=20000):
                best = 0
                best_pts = None
                for t in range(trials):
                    # generate random points inside unit circle
                    pts = []
                    for i in range(n):
                        r = math.sqrt(random.random())
                        theta = random.random()*2*math.pi
                        pts.append((r*math.cos(theta), r*math.sin(theta)))
                    # compute a_i
                    a = []
                    for i in range(n):
                        angles = []
                        xi, yi = pts[i]
                        for j in range(n):
                            if i==j: continue
                            xj, yj = pts[j]
                            ang = math.atan2(yj-yi, xj-xi) % (2*math.pi)
                            angles.append(ang)
                        # sort angles
                        angles.sort()
                        # duplicate with +2π for circular wrap
                        angles2 = angles + [ang+2*math.pi for ang in angles]
                        # sliding window length 100° = 100*pi/180 rad
                        L = 100*math.pi/180
                        maxcnt = 0
                        left = 0
                        for right in range(len(angles2)):
                            while angles2[right] - angles2[left] > L + 1e-12:
                                left += 1
                            cnt = right - left + 1
                            if cnt > maxcnt:
                                maxcnt = cnt
                        a.append(maxcnt)
                    S = sum(a)
                    if S > best:
                        best = S
                        best_pts = pts
                return best, best_pts
            
            best10, pts10 = max_sum_random(10, trials=5000)
            best10
            
