                b.append(0)
                # exactly one endpoint besides start: sum z_i = 1
                row = np.zeros(total_vars)
                for i in range(1,N):
                    row[idx_z[i]] = 1
                A.append(row)
                b.append(1)
                # MTZ constraints: for each arc i->j, u_i + 1 <= u_j + N*(1 - x_{i,j})
