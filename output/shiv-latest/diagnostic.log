            def points_on_arc(n, theta_deg=30, radius=1.0):
                # place n points equally spaced on an arc of central angle theta_deg
                theta = math.radians(theta_deg)
                # center at (0,0), start angle -theta/2 to +theta/2
                start = -theta/2
                points = []
                for k in range(n):
                    ang = start + theta * k/(n-1) if n>1 else 0
                    points.append((radius*math.cos(ang), radius*math.sin(ang)))
                return points
            
