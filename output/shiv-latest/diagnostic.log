            def plane_eq(a,b,c,d):
                # returns sympy Plane
                # plane: a*x + b*y + c*z + d = 0
                x,y,z = sp.symbols('x y z')
                # Need a point on plane and normal vector
                normal = sp.Matrix([a,b,c])
                # Find a point satisfying equation: set two coordinates zero, solve for third if possible.
