            def max_ratio_random(n, trials=1000):
                max_r = 0.0
                for _ in range(trials):
                    a = np.random.randn(n)  # normal distribution
                    max_abs_a = np.max(np.abs(a))
                    sums = a + np.roll(a, -1)
                    max_abs_sum = np.max(np.abs(sums))
                    if max_abs_sum == 0:
                        continue
