            def pretty_pairs_fast(alpha, K, max_m, max_n):
                pretty = set()
                for m in range(1, max_m+1):
                    a = math.floor(m*alpha)
                    # We need n such that (K + n*a) % m == 0
                    # Let n vary up to max_n
                    # Compute n*a mod m; we can solve congruence: n*a ≡ -K (mod m)
                    # Let g = gcd(a, m). Then solution exists iff g | K.
                    # Since a varies with m, we can just loop n.
                    for n in range(1, max_n+1):
                        if (K + n*a) % m != 0:
                            continue
                        t = (K + n*a)//m
                        # Check ceil condition
                        if (t-1)/n < alpha <= t/n:
                            pretty.add((m,n))
                return pretty
            
            def count_cool_fast(alpha, K, max_m, max_n):
                pretty = pretty_pairs_fast(alpha, K, max_m, max_n)
                cool = set()
                for (m,n) in pretty:
                    reducible = False
                    if m>n and (m-n,n) in pretty:
                        reducible = True
                    if n>m and (m,n-m) in pretty:
                        reducible = True
                    if not reducible:
