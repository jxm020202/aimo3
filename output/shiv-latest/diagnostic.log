            import numpy as np, scipy.sparse as sp
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def find_feasible(n, total_sum):
                N = n*n
                # variable ordering: first N are x_i, then M edges are b_e
                # edges list
                edges = []
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        if i+1 < n:
                            idx2 = (i+1)*n + j
                            edges.append((idx, idx2))
                        if j+1 < n:
                            idx2 = i*n + (j+1)
                            edges.append((idx, idx2))
                M = len(edges)
                # Build equality constraints for each edge: x_v - x_u - 2*b + 1 = 0
                rows = []
                cols = []
                data = []
                b_eq = []
                for e, (u, v) in enumerate(edges):
                    # x_v coefficient +1
                    rows.append(e); cols.append(v); data.append(1)
                    # x_u coefficient -1
                    rows.append(e); cols.append(u); data.append(-1)
                    # b_e coefficient -2
                    rows.append(e); cols.append(N + e); data.append(-2)
                    # RHS = -1 (move constant to RHS)
                    b_eq.append(-1)
                A_eq = sp.csr_matrix((data, (rows, cols)), shape=(M, N+M))
                b_eq = np.array(b_eq)
                # Sum constraint: sum x_i = total_sum
                rows_sum = np.arange(N)
                cols_sum = np.arange(N)
                data_sum = np.ones(N)
                # We'll add as equality constraint
                A_sum = sp.csr_matrix((data_sum, (np.zeros(N, dtype=int), cols_sum)), shape=(1, N+M))
                # Actually need shape (1, N+M)
                A_sum = sp.csr_matrix((data_sum, (np.zeros(N, dtype=int), cols_sum)), shape=(1, N+M))
                # Combine constraints
                A = sp.vstack([A_eq, A_sum])
                b = np.concatenate([b_eq, [total_sum]])
                # Bounds: x_i >=0 integer, no upper bound (set large)
                # For b_e binary: 0 <= b <= 1 integer
                lower = np.concatenate([np.zeros(N), np.zeros(M)])
                upper = np.concatenate([np.full(N, 1000), np.ones(M)])  # set large upper for x
                bounds = Bounds(lower, upper)
                # integrality: all variables integer (default milp expects integer for all? we can specify integrality vector)
                # In scipy milp, integrality is defined via ctype? Actually milp takes integer constraints via integrality param.
                # Let's set integrality vector: 0 for continuous, 1 for integer.
                integrality = np.concatenate([np.ones(N), np.ones(M)])  # all integer
                # objective c = zero
                c = np.zeros(N+M)
                # Solve
                res = milp(c=c, constraints=LinearConstraint(A, b, b), bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            # try for n=5 small to test
            res = find_feasible(5, 10)
            print(res.success)
            
