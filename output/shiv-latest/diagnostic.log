            def nullspace_basis(N):
                total=N*N
                rows=[]
                for i in range(N):
                    for j in range(N):
                        bits=0
                        for k in range(N):
                            bits |= 1 << (i*N + k)  # row i
                            bits |= 1 << (k*N + j)  # column j
                        rows.append(bits)
                # Gaussian elimination to row-echelon form over GF(2)
                rows = rows[:]  # copy
                pivot_cols=[]
                r=0
                for col in range(total):
                    # find row >= r with bit col set
                    pivot = None
                    for i in range(r, len(rows)):
                        if (rows[i] >> col) & 1:
                            pivot=i
                            break
                    if pivot is None:
                        continue
                    # swap pivot row into position r
                    rows[r], rows[pivot] = rows[pivot], rows[r]
                    pivot_cols.append(col)
                    # eliminate column col from all other rows
                    for i in range(len(rows)):
                        if i!=r and ((rows[i]>>col)&1):
                            rows[i] ^= rows[r]
                    r+=1
                    if r==len(rows):
                        break
                # Now pivot_cols list of pivot columns. Non-pivot columns are free variables.
                free_cols=[c for c in range(total) if c not in pivot_cols]
                basis=[]
                for free in free_cols:
                    # set free variable =1, others 0, solve for pivots
                    vec=0
                    vec |= 1<<free
                    # back substitution: for each pivot row, determine value of pivot variable to satisfy equation.
                    # Each pivot row corresponds to equation: pivot_var + sum_{free vars with 1 in row} =0 (mod2)
                    # Since rows are reduced to have pivot col =1 and other pivot cols eliminated, row has 1 at pivot col and maybe 1s at free cols.
                    for row_idx, piv in enumerate(pivot_cols):
                        row = rows[row_idx]
                        # compute sum of bits of row at free cols where vec has 1
                        # we need to set pivot variable such that dot(row, vec) =0
                        # dot = (vec at pivot) XOR (sum over other bits)
                        # So pivot = sum over other bits (since need total 0)
                        # compute parity of bits where row has 1 and vec has 1, excluding pivot col.
                        mask=row & ((1<<total)-1)
                        # exclude pivot bit
                        mask_without_pivot = mask & ~(1<<piv)
                        parity = bin(mask_without_pivot & vec).count("1") % 2
                        # set pivot bit to parity (since pivot + parity =0 => pivot=parity)
                        if parity:
                            vec |= 1<<piv
                    basis.append(vec)
                return basis
            
