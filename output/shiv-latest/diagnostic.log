            def eg_check(seq):
                # Return True if seq is graphic (Erdős–Gallai)
                n = len(seq)
                seq = sorted(seq, reverse=True)
                if sum(seq) % 2:
                    return False
                prefix = [0]
                for d in seq:
                    prefix.append(prefix[-1] + d)
                # Precompute suffix of min(d_i, k)
                for k in range(1, n+1):
                    left = prefix[k]
                    # right = k*(k-1) + sum_{i=k+1}^{n} min(d_i, k)
                    # Since seq sorted descending, for i>k, d_i <= seq[k] maybe not monotonic.
                    # Compute directly
                    right = k*(k-1)
                    for i in range(k, n):
                        right += min(seq[i], k)
                    if left > right:
                        return False
                return True
            
