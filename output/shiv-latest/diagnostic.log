            def min_total_sum(n):
                # number of edges
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variable indices mapping
                idx = {e:k for k,e in enumerate(edges)}
                # objective: minimize sum w_i
                c = np.ones(m, dtype=int)
                # bounds: each variable integer 1..3
                bounds = Bounds(np.ones(m, dtype=int), np.full(m, 3, dtype=int))
                # integrality: all variables integer
                integrality = np.ones(m, dtype=int)
                # triangle constraints: for each triple (i,j,k)
                A = []
                b = []
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            # edges (i,j),(i,k),(j,k)
                            row = np.zeros(m, dtype=int)
                            row[idx[(i,j)]] = 1
                            row[idx[(i,k)]] = 1
                            row[idx[(j,k)]] = 1
                            A.append(row)
                            b.append(5)  # sum >=5
                A = np.array(A, dtype=int)
                # constraints: A @ x >= b
                # LinearConstraint expects lower and upper bounds
                lc = LinearConstraint(A, lb=b, ub=np.full(len(b), np.inf))
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
