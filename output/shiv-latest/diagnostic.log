            def blocking_cells(p, direction):
                # returns list of cells that must be occupied/off-board to block sliding in given direction
                # if off-board (i.e., no cells needed), return empty list
                r,c = p['pos']
                if p['type']=='H':
                    # cells: (r,c),(r,c+1)
                    if direction=='left':
                        if c-1 >= 0:
                            return [(r,c-1)]
                        else:
                            return []  # off-board blocked
                    if direction=='right':
                        if c+2 <= n-1:
                            return [(r,c+2)]
                        else:
                            return []
                    if direction=='up':
                        if r-1 >= 0:
                            return [(r-1,c), (r-1,c+1)]
                        else:
                            return []
                    if direction=='down':
                        if r+1 <= n-1:
                            return [(r+1,c), (r+1,c+1)]
                        else:
                            return []
                else: # vertical
                    # cells: (r,c),(r+1,c)
                    if direction=='left':
                        if c-1 >= 0:
                            return [(r,c-1), (r+1,c-1)]
                        else:
                            return []
                    if direction=='right':
                        if c+1 <= n-1:
