                        # down neighbor cell (r+2,c)
                        if r+2 < n_rows:
                            neighbor_cells = [(r+2,c)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                        # left neighbor cells (r,c-1) and (r+1,c-1)
                        if c-1 >= 0:
                            neighbor_cells = [(r,c-1), (r+1,c-1)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                        # right neighbor cells (r,c+1) and (r+1,c+1)
                        if c+1 < n_cols:
                            neighbor_cells = [(r,c+1), (r+1,c+1)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                # Convert to numpy arrays
                A = np.vstack(rows).astype(float)
                lb = np.array(lbs, dtype=float)
                ub = np.array(ubs, dtype=float)
                # Objective: minimize sum x_i
                c = np.ones(n, dtype=float)
                # Bounds for variables: 0 <= x_i <= 1
                var_bounds = Bounds(0, 1)
                # Integrality: all variables integer
                integrality = np.ones(n, dtype=int)
                # Solve using milp
                res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=var_bounds,
                           integrality=integrality, options={'presolve': True, 'disp': False})
                return res, placements
            
