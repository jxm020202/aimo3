            from functools import lru_cache
            import math, itertools, sys
            
            def max_ops_bruteforce(n):
                init = tuple(range(1, n+1))
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                pair_index = {pair: idx for idx, pair in enumerate(pairs)}
                total_pairs = len(pairs)
                @lru_cache(maxsize=None)
                def dfs(counts, used_mask):
                    best = 0
                    # bound: each pile i can be used at most counts[i] times (since each use reduces by at least 1)
                    # remaining possible ops <= sum(counts)//2
                    bound = sum(counts)//2
                    # also remaining unused pairs count
                    remaining_pairs = total_pairs - bin(used_mask).count("1")
                    bound = min(bound, remaining_pairs)
                    # early exit if bound <= best? Not needed.
                    for (i,j) in pairs:
                        idx = pair_index[(i,j)]
                        if used_mask & (1<<idx):
                            continue
                        a = counts[i]
                        b = counts[j]
                        if a==0 or b==0:
                            continue
                        d = math.gcd(a,b)
                        new_counts = list(counts)
                        new_counts[i] -= d
                        new_counts[j] -= d
                        new_counts = tuple(new_counts)
                        new_mask = used_mask | (1<<idx)
                        best = max(best, 1 + dfs(new_counts, new_mask))
                    return best
                return dfs(init, 0)
            
