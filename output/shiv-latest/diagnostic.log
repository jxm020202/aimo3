                # reg = (x_cat, y_cat, z_cat, syz, sxz)
                x_cat, y_cat, z_cat, syz, sxz = reg
                # define bounds for x,y,z open intervals
                bounds = {
                    'L': (-10, -eps),  # Actually we need finite bounds; use large negative
                    'M': (eps, 1 - eps),
                    'H': (1 + eps, 10)
                }
                # Use linear programming to find point satisfying constraints
                # Variables x,y,z
                # Constraints:
                # interval bounds: x >= low, x <= high, etc.
                A_ub = []
                b_ub = []
                # lower bounds via bounds list in linprog
                var_bounds = [bounds[x_cat], bounds[y_cat], bounds[z_cat]]
                # sign constraints
                if syz == 1:
                    # y - z >= eps => -y + z <= -eps
                    A_ub.append([0, -1, 1])
                    b_ub.append(-eps)
                else:
                    # y - z <= -eps => y - z <= -eps
                    A_ub.append([0, 1, -1])
                    b_ub.append(-eps)
                if sxz == 1:
                    # x + z -1 >= eps => -x - z <= 1 - eps
                    A_ub.append([-1, 0, -1])
                    b_ub.append(1 - eps)
                else:
