            # compute convex hull using simple algorithm (gift wrapping)
            def cross(o,a,b):
                return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
            pts = inside_points
            # sort by x then y
            pts = sorted(set(pts))
            # lower hull
            lower = []
            for p in pts:
                while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
                    lower.pop()
                lower.append(p)
            # upper hull
            upper = []
