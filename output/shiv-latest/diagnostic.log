            def cycles_T(n,k):
                # permutation on {1,...,n} defined by y = k*x mod n (with 0 as n)
                visited=[False]*(n+1)  # index 1..n
                cycles=[]
                for i in range(1,n+1):
                    if not visited[i]:
                        cur=i
                        cycle=[]
                        while not visited[cur]:
                            visited[cur]=True
                            cycle.append(cur)
                            # compute next
                            nxt = (k*cur) % n
                            if nxt==0:
                                nxt=n
                            cur=nxt
                        cycles.append(cycle)
                return cycles
            
            def cycles_G(m,k):
                # permutation on {1,...,m-1} defined by a -> a^k mod m (excluding 0)
                visited=[False]*m
                cycles=[]
                for a in range(1,m):
                    if not visited[a]:
                        cur=a
                        cycle=[]
                        while not visited[cur]:
                            visited[cur]=True
                            cycle.append(cur)
                            cur=pow(cur,k,m)
                            if cur==0:
                                # should not happen for a in 1..m-1 if map avoids 0
                                # break to avoid infinite loop
                                break
                        cycles.append(cycle)
                return cycles
            
            def cycle_type(cycles):
