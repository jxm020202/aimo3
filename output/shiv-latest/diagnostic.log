            def min_weight_for_syndrome(b):
                # b is binary array length r
                # variables: x (c binary), y (r integer)
                # objective: minimize sum x
                # constraints: H x - 2 y = b
                # We'll set up linear constraints: A_eq x + A_y y = b
                # But milp expects linear constraints in form A @ x <= ub and >= lb.
                # We'll combine x and y into one variable vector of length c+r.
                total_vars = c + r
                # objective coefficients
                c_obj = np.concatenate([np.ones(c), np.zeros(r)])
                # Build matrix for equality constraints: H x - 2 y = b
                A_eq = np.zeros((r, total_vars), dtype=int)
                A_eq[:, :c] = H
                A_eq[:, c:] = -2 * np.eye(r, dtype=int)
                # bounds for variables
                # x binary: 0 <= x <= 1
                # y integer: 0 <= y <= c//2 maybe
                lb = np.concatenate([np.zeros(c), np.zeros(r)])
                ub = np.concatenate([np.ones(c), np.full(r, c//2)])  # y max c/2
                # Use LinearConstraint for equality
                lin_con = LinearConstraint(A_eq, b, b)
                bounds = Bounds(lb, ub)
                res = milp(c=c_obj, constraints=[lin_con], bounds=bounds, integrality=np.concatenate([np.ones(c), np.zeros(r)]), options={'presolve': True, 'disp': False})
                if not res.success:
                    # maybe infeasible? shouldn't happen
                    return None
                x_opt = res.x[:c]
                # round to nearest integer
                weight = int(round(sum(x_opt)))
                return weight
            
            # Test on random b
            b_rand = np.random.randint(0,2,size=r)
            print(min_weight_for_syndrome(b_rand))
            
