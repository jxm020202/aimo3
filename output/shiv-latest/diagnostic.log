            def neighbor_cells_for_domino(d):
                typ, r, c = d
                neighbors = []
                # left/right/up/down constraints
                if typ == 'H':
                    # left neighbor cell
                    if c-1 >= 1:
                        neighbors.append((r, c-1))
                    # right neighbor cell
                    if c+2 <= n:
                        neighbors.append((r, c+2))
                    # up: both cells above
                    if r-1 >= 1:
                        neighbors.append((r-1, c))
                        neighbors.append((r-1, c+1))
                    # down: both cells below
                    if r+1 <= n:
                        neighbors.append((r+1, c))
                        neighbors.append((r+1, c+1))
                else: # vertical
                    # up neighbor cell
                    if r-1 >= 1:
                        neighbors.append((r-1, c))
                    # down neighbor cell
                    if r+2 <= n:
                        neighbors.append((r+2, c))
                    # left: both cells left
                    if c-1 >= 1:
                        neighbors.append((r, c-1))
                        neighbors.append((r+1, c-1))
                    # right: both cells right
                    if c+1 <= n:
                        neighbors.append((r, c+1))
                        neighbors.append((r+1, c+1))
