            import random, math, numpy as np
            def random_point_on_sphere():
                # generate random direction uniformly
                # use normal distribution
                v = np.random.normal(size=3)
                v = v / np.linalg.norm(v) * math.sqrt(3)
                return v
            
            def f_val(pt):
                x,y,z = pt
                return x*y**3 + y*z**3 + z*x**3
            
            def find_close(num_samples=100000, eps=1e-6):
                close = []
                for _ in range(num_samples):
                    pt = random_point_on_sphere()
                    val = f_val(pt)
                    if abs(val-3) < eps:
                        close.append(pt)
                return close
            
