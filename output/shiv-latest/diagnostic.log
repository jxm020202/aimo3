            import sympy as sp
            q = 3
            n = 6
            def Krawt(k,i):
                # compute K_k(i) for q-ary Hamming scheme
                # formula: sum_{j=0}^k (-1)^j (q-1)^{k-j} * C(i, j) * C(n-i, k-j)
