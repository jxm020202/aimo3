            import numpy as np, itertools, math, sys, random, collections, functools, time
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            n = 7
            placements = []
            # store cells covered for each placement
            placement_cells = []
            for r in range(n):
                for c in range(n-1):
                    placements.append(('H', r, c))
                    placement_cells.append([(r,c), (r,c+1)])
            for r in range(n-1):
                for c in range(n):
                    placements.append(('V', r, c))
                    placement_cells.append([(r,c), (r+1,c)])
            num_vars = len(placements)
            # map cell to placements covering it
            cell_to_placements = {}
            for idx, cells in enumerate(placement_cells):
                for cell in cells:
