            import mpmath as mp, math
            
            def H(phi, theta):
                R = math.sqrt(3)
                x = R * math.sin(phi) * math.cos(theta)
                y = R * math.sin(phi) * math.sin(theta)
                z = R * math.cos(phi)
                return x*y**3 + y*z**3 + z*x**3 - 3
            
            # Search for phi,theta where H=0
            def find_solution():
                for phi in np.linspace(0.1, math.pi-0.1, 100):
                    # find theta root using findroot starting from multiple guesses
                    for guess in np.linspace(0, 2*math.pi, 10):
                        try:
