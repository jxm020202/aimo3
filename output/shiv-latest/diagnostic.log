            def is_convex(poly):
                # poly list of points in order
                # compute cross product of consecutive edges, must have same sign (all positive for CCW)
                n = len(poly)
                signs = []
                for i in range(n):
                    a = sp.Matrix(poly[i])
                    b = sp.Matrix(poly[(i+1)%n])
                    c = sp.Matrix(poly[(i+2)%n])
                    # vectors ab = b-a, bc = c-b
                    ab = b - a
                    bc = c - b
                    # cross product z-component (2D)
                    cross = ab[0]*bc[1] - ab[1]*bc[0]
                    signs.append(sp.sign(cross))
                # Remove zero (collinear)
                signs_nonzero = [s for s in signs if s != 0]
                if not signs_nonzero:
                    return False
                first = signs_nonzero[0]
                return all(s == first for s in signs_nonzero)
            
