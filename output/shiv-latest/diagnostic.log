            def min_average(n):
                # enumerate edges
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                edge_index = {e:i for i,e in enumerate(edges)}
                # objective: minimize sum of labels
                c = np.ones(m, dtype=int)
                # constraints: for each triangle, sum >=5 -> -sum <= -5
                triangles = [(i,j,k) for i in range(n) for j in range(i+1,n) for k in range(j+1,n)]
                A = []
                b = []
                for (i,j,k) in triangles:
                    row = np.zeros(m, dtype=int)
                    row[edge_index[(i,j)]] = -1
                    row[edge_index[(i,k)]] = -1
                    row[edge_index[(j,k)]] = -1
                    A.append(row)
                    b.append(-5)
                A = np.array(A)
                b = np.array(b)
                # bounds: each variable between 1 and 3 inclusive
                bounds = Bounds(1,3)
                # integrality: all variables integer
                integrality = np.ones(m, dtype=bool)
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf*np.ones_like(b), b), bounds=bounds,
                           integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("Failed", n, res.message)
                    return None
                total = res.fun
                avg = total / (n*(n-1)/2)
                return total, avg
            
            for n in range(3,9):
                total, avg = min_average(n)
                print(n, total, avg)
            
