            def min_sum_cycle(n, max_val=500):
                # DP over cycles: fix start value s, compute minimal cost for sequence length n, returning to s.
                # We'll compute DP[i][v] = minimal cost for prefix of length i (starting at a1=s) ending at value v.
                # Then total cost = DP[n][v] + floor(s / v) if s >= v else 0? Wait final edge from a_n=v to a_1=s.
                # final cost = floor(s / v) if s >= v else 0 (since ratio <1 gives 0).
                # Actually floor(s / v) when s >= v else 0.
                # We'll compute for each start s and take min.
                INF = 10**9
                # Precompute cost matrix
                cost = [[0]*(max_val+1) for _ in range(max_val+1)]
                for v in range(1, max_val+1):
                    for w in range(1, max_val+1):
                        if w >= v:
                            cost[v][w] = w // v
                        else:
                            cost[v][w] = 0
                best = INF
                # For each start s
                for s in range(1, max_val+1):
                    # DP for length n, we need DP[1][s] = 0
                    dp_prev = [INF]*(max_val+1)
                    dp_prev[s] = 0
                    for i in range(2, n+1):
                        dp_cur = [INF]*(max_val+1)
                        # compute dp_cur[w] = min_v dp_prev[v] + cost[v][w]
                        # naive O(max_val^2) per step -> heavy. We'll limit n small.
                        for v in range(1, max_val+1):
                            dv = dp_prev[v]
                            if dv == INF:
                                continue
                            # iterate w
                            # we can vectorize using loops
                            for w in range(1, max_val+1):
                                c = cost[v][w]
                                new = dv + c
                                if new < dp_cur[w]:
                                    dp_cur[w] = new
                        dp_prev = dp_cur
                    # after length n, add final edge cost from v back to s
                    for v in range(1, max_val+1):
                        total = dp_prev[v] + (s // v if s >= v else 0)
                        if total < best:
                            best = total
                return best
            
            # test for small n
            for n in range(1, 31):
                ms = min_sum_cycle(n, max_val=10)  # small max_val for speed
                print(n, ms)
            
