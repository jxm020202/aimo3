            def max_B(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                maxB = -10**9
                best = None
                for mask in range(1<<m):
                    # Build adjacency list for G1
                    adj = [set() for _ in range(n)]
                    ecount = 0
                    for idx, (i,j) in enumerate(edges):
                        if mask>>idx & 1:
                            adj[i].add(j)
                            adj[j].add(i)
                            ecount += 1
                    # compute forced edges
                    forced = set()
                    for v in range(n):
                        neigh = list(adj[v])
                        for a in range(len(neigh)):
                            for b in range(a+1, len(neigh)):
                                u = neigh[a]
                                w = neigh[b]
                                if u<w:
                                    forced.add((u,w))
                                else:
                                    forced.add((w,u))
                    forced_count = len(forced)
                    B = ecount - forced_count
                    if B > maxB:
                        maxB = B
                        best = (mask, ecount, forced_count)
                return maxB, best
            
