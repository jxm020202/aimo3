            import math
            
            def pell_mul(x,t,k):
                # Multiply (x + t*sqrt(7)) by (8+3 sqrt(7))^k
                # Use exponentiation by repeated multiplication
                a,b = 8,3  # fundamental
                # compute (a+b sqrt(7))^k
                ak,bk = 1,0
                # binary exponent
                kk=k
                while kk>0:
                    if kk%2==1:
                        # multiply (ak+bk sqrt7) by (a+b sqrt7)
                        ak,bk = ak*a + bk*7*b, ak*b + bk*a
                    # square (a+b sqrt7)
                    a,b = a*a + b*b*7, 2*a*b
                    kk//=2
                # now multiply (x + t sqrt7) by (ak+bk sqrt7)
                X = x*ak + t*7*bk
                T = x*bk + t*ak
                return X,T
            
