            def pretty_candidates(k, max_m):
                cand=set()
                for g in [d for d in range(1,k+1) if k%d==0]:
                    kg=k//g
                    # iterate m' up to max_m//g
                    max_mp = max_m//g
                    for m1 in range(1, max_mp+1):
                        # condition |m1 - kg| < min(m1, n1) => need n1 > |m1 - kg|
                        # n1 must be coprime with m1
                        # iterate n1
                        for n1 in range(1, max_mp+1):
                            if math.gcd(m1,n1)!=1:
                                continue
                            if abs(m1 - kg) < min(m1, n1):
                                m=g*m1
                                n=g*n1
                                cand.add((m,n))
                return cand
            
