            import math, random, itertools, numpy as np
            
            def compute_a_i(angles, i, wedge=100):
                # angles list of angles (radians) of points on unit circle
                # compute max number of other points within wedge angle from point i
                # orientation can be any direction; we just need to count points within wedge of size wedge (in radians)
                # Equivalent to: for each other point j, compute angle of vector from i to j (direction)
                # Then find max number within any interval of length wedge.
                # We'll compute all directions and then sliding window.
                n=len(angles)
                # compute direction angles from point i to each other point
                dirs=[]
                xi = np.array([math.cos(angles[i]), math.sin(angles[i])])
                for j in range(n):
                    if j==i: continue
                    xj = np.array([math.cos(angles[j]), math.sin(angles[j])])
                    v = xj - xi
                    ang = math.atan2(v[1], v[0])
                    if ang<0: ang+=2*math.pi
                    dirs.append(ang)
                dirs.sort()
                # duplicate with +2π for wrap-around
                dirs2 = dirs + [d+2*math.pi for d in dirs]
                maxcnt=0
                m=len(dirs)
                j=0
                for k in range(m):
                    while j<k+m and dirs2[j]-dirs2[k] <= wedge+1e-9:
                        j+=1
                    cnt=j-k
                    if cnt>maxcnt: maxcnt=cnt
                return maxcnt
            
            def total_sum_angles(angles):
                return sum(compute_a_i(angles,i) for i in range(len(angles)))
            
