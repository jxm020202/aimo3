            def nullspace_mod2(matrix):
                m = [row[:] for row in matrix]
                n_rows = len(m)
                n_cols = len(m[0]) if n_rows>0 else 0
                pivot_cols = []
                row = 0
                for col in range(n_cols):
                    pivot = None
                    for r in range(row, n_rows):
                        if m[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    m[row], m[pivot] = m[pivot], m[row]
                    pivot_cols.append(col)
                    for r in range(n_rows):
                        if r != row and m[r][col]:
                            m[r] = [(a ^ b) for a,b in zip(m[r], m[row])]
                    row += 1
                    if row == n_rows:
                        break
                free_cols = [c for c in range(n_cols) if c not in pivot_cols]
                basis = []
                for free in free_cols:
                    vec = [0]*n_cols
                    vec[free] = 1
                    # compute pivot vars
                    for r, piv in enumerate(pivot_cols):
                        # row r
                        s = 0
                        for c in free_cols:
                            if m[r][c] and vec[c]:
                                s ^= 1
                        vec[piv] = s
                    basis.append(vec)
                return basis
            
