            from collections import deque
            
            def min_moves(n):
                # n odd, alternating pattern starting with T at position 1 (odd positions tails)
                target = 0
                for i in range(1, n+1):
                    if i % 2 == 1: # odd positions need odd flips => 1
                        target |= 1 << (i-1)
                # BFS
                # state: (pos, mask) where pos is 0-indexed position (0..n-1)
                # mask is integer bits for which positions have been flipped odd times (i.e., current parity)
                # start: any pos, mask with that bit set
                visited = {}
                dq = deque()
                for pos in range(n):
                    mask = 1 << pos
                    visited[(pos, mask)] = 1  # steps count (including first move)
                    dq.append((pos, mask, 1))
                while dq:
                    pos, mask, steps = dq.popleft()
                    if mask == target:
                        return steps
                    # possible moves: adjacent positions
                    for d in (-1, 1):
                        np = pos + d
                        if 0 <= np < n:
                            nmask = mask ^ (1 << np)  # flip that bit
                            if (np, nmask) not in visited:
                                visited[(np, nmask)] = steps + 1
                                dq.append((np, nmask, steps + 1))
                return None
            
            for n in range(1, 21, 2):
                print(n, min_moves(n))
            
