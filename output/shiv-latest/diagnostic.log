            from collections import deque
            
            def is_connected(N, edges, start, end):
                # Build adjacency list for edges with multiplicity>0
                adj = [[] for _ in range(N)]
                for i,m in enumerate(edges):
                    if m>0:
                        adj[i].append(i+1)
                        adj[i+1].append(i)
                # BFS from start, see if can reach end and all vertices with nonzero degree
                visited = [False]*N
                q = deque([start])
                visited[start]=True
                while q:
                    u = q.popleft()
                    for v in adj[u]:
                        if not visited[v]:
                            visited[v]=True
                            q.append(v)
                # check that all vertices with degree>0 are visited
                for i in range(N):
                    deg = 0
                    if i>0:
                        deg += edges[i-1]
                    if i<N-1:
                        deg += edges[i]
                    if deg>0 and not visited[i]:
                        return False
                # also ensure start and end are visited (they have degree>0)
                return visited[end]
            
