                pairs = [(i,j) for i in range(1,n+1) for j in range(i+1,n+1)]
                @lru_cache(maxsize=None)
                def dfs(coins, used_mask):
                    # coins is tuple length n+1
                    best = 0
                    # iterate over pairs
                    for idx, (i,j) in enumerate(pairs):
                        if (used_mask>>idx)&1: continue
                        if coins[i]==0 or coins[j]==0: continue
                        g = math.gcd(coins[i], coins[j])
                        # apply operation
                        new_coins = list(coins)
                        new_coins[i] -= g
                        new_coins[j] -= g
                        new_mask = used_mask | (1<<idx)
                        best = max(best, 1 + dfs(tuple(new_coins), new_mask))
