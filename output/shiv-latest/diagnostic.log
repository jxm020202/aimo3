            import random, math, sympy
            def lambda_m(m):
                # Carmichael function
                fac = sympy.factorint(m)
                l = 1
                for p,e in fac.items():
                    if p==2 and e>=3:
                        lam = 2**(e-2)
                    else:
                        lam = (p-1)*(p**(e-1))
                    # Actually Carmichael for odd prime power p^e is phi(p^e) = p^{e-1}(p-1)
                    # For 2^e with e>=3, lambda = 2^{e-2}
                    l = sympy.ilcm(l, lam)
                return l
            
