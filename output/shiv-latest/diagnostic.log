            def max_ops_greedy(N, trials=100):
                best=0
                for t in range(trials):
                    counts=list(range(N+1))  # index 0 unused, counts[i]=i
                    used=set()
                    ops=0
                    # create list of all unordered pairs
                    pairs=[(i,j) for i in range(1,N) for j in range(i+1,N+1)]
                    random.shuffle(pairs)
                    # We'll attempt to iterate over pairs repeatedly, picking those with gcd=1 and both nonempty
                    # Continue until no such pair left
                    changed=True
                    while changed:
                        changed=False
                        for (i,j) in pairs:
                            if (i,j) in used: continue
                            if counts[i]==0 or counts[j]==0: continue
                            if math.gcd(counts[i], counts[j])==1:
                                # perform operation
                                counts[i]-=1
                                counts[j]-=1
                                used.add((i,j))
                                ops+=1
                                changed=True
                    if ops>best:
                        best=ops
                    # early exit if best reaches theoretical max
                    if best== (N*(N+1)//2)//2:
                        break
                return best
            
