            import math, random
            
            def max_interval_length_for_arc(theta, n=100):
                # points on unit circle from angle 0 to theta inclusive
                angles = [i*theta/(n-1) for i in range(n)]
                # compute max minimal covering interval length across points
                max_len = 0.0
                for i, phi in enumerate(angles):
                    # compute direction angles from point i to all other points
                    # compute vector Q-P
                    dirs = []
                    x_i, y_i = math.cos(phi), math.sin(phi)
                    for j, psi in enumerate(angles):
                        if i==j: continue
                        x_j, y_j = math.cos(psi), math.sin(psi)
                        dx, dy = x_j - x_i, y_j - y_i
                        ang = math.atan2(dy, dx)  # angle in [-pi, pi]
                        dirs.append(ang)
                    # normalize angles to [0, 2π) for covering interval
                    dirs = [(a if a>=0 else a+2*math.pi) for a in dirs]
                    dirs.sort()
                    # find minimal covering interval length on circle that contains all dirs
                    # Equivalent to compute max gap between consecutive angles, then interval length = 2π - max_gap
                    max_gap = max((dirs[(k+1)%len(dirs)] - dirs[k]) % (2*math.pi) for k in range(len(dirs)))
                    interval_len = 2*math.pi - max_gap
                    max_len = max(max_len, interval_len)
                return max_len
            
            def find_theta():
                # binary search for theta such that max interval <= 100° (100° in rad)
                target = math.radians(100)
                lo, hi = 0.0, math.pi # can't exceed 180° for points on circle arc (max 180°)
                for _ in range(30):
                    mid = (lo+hi)/2
                    if max_interval_length_for_arc(mid) <= target:
                        hi = mid
                    else:
                        lo = mid
                return hi, max_interval_length_for_arc(hi)
            
            theta_opt, max_len = find_theta()
            theta_opt_deg = math.degrees(theta_opt)
            max_len_deg = math.degrees(max_len)
            theta_opt_deg, max_len_deg
