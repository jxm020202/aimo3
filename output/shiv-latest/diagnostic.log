            from collections import deque
            
            def min_flips(n):
                # n positions, initial pattern: tails on odd positions (1-indexed)
                init = tuple(1 if (i%2)==1 else 0 for i in range(1,n+1))  # 1 tail, 0 head
                target = tuple(0 for _ in range(n))
