            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np
            
            # Board size
            n=7
            cells = [(r,c) for r in range(n) for c in range(n)]
            
            # Domino placements: list of dicts with cells (tuple of two cells) and orientation
            placements = []
