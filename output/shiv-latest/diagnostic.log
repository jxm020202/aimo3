            import random, math, numpy as np
            
            def find_solutions(num_trials=200000):
                sols = []
                for _ in range(num_trials):
                    # random y,z within sphere radius sqrt(3)
                    # generate random point in square and reject if outside sphere
                    y = random.uniform(-math.sqrt(3), math.sqrt(3))
                    z = random.uniform(-math.sqrt(3), math.sqrt(3))
                    if y*y + z*z > 3:
                        continue
                    R_sq = 3 - y*y - z*z
                    R = math.sqrt(R_sq)
                    # evaluate both cases
                    val_plus = R*y**3 + z*R**3 + y*z**3
                    val_minus = -R*y**3 - z*R**3 + y*z**3
                    if abs(val_plus - 3) < 1e-5:
                        x = R
                        sols.append((x,y,z))
                    if abs(val_minus - 3) < 1e-5:
                        x = -R
                        sols.append((x,y,z))
                return sols
            
            sols = find_solutions(500000)
            len(sols)
            
