            def nullspace_mod2(matrix):
                # matrix: list of rows (list of ints 0/1), shape m x n
                m = len(matrix)
                n = len(matrix[0]) if m>0 else 0
                # Perform Gaussian elimination to row-reduced echelon form, tracking column swaps?
                # We'll compute basis for nullspace (solutions to A x = 0)
                # Use standard algorithm: augment with identity matrix for tracking?
                # Simpler: use sympy's GF(2) matrix: sp.Matrix(matrix).rref(iszerofunc=lambda x: x%2==0, simplify=False, pivots=False) but not mod 2.
                # We'll implement ourselves.
                A = [row[:] for row in matrix]  # copy
                # Keep track of pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot row with A[r][col] = 1 for r>=row
                    pivot = None
                    for r in range(row, m):
                        if A[r][col] == 1:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row to current row
                    A[row], A[pivot] = A[pivot], A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r][col] == 1:
                            # row r = row r XOR row row
                            A[r] = [(a ^ b) for a,b in zip(A[r], A[row])]
                    row += 1
                    if row == m:
                        break
                # Now we have row echelon form. Determine free variables (non-pivot columns)
                free_cols = [c for c in range(n) if c not in pivot_cols]
                basis = []
                # For each free variable, set it to 1 and others to 0, solve for pivots.
                for free in free_cols:
                    # solution vector x of length n
                    x = [0]*n
                    x[free] = 1
                    # For each pivot row, compute value of pivot variable as sum of row entries * free vars (since A row has 1 at pivot col)
                    # Need to reconstruct row representation after elimination. We have A in reduced echelon form (since we eliminated other rows).
                    # So each pivot row has leading 1 at pivot col, and zeros elsewhere in pivot columns. The rest columns (including free) may have 0/1.
                    # So pivot variable = sum of (coeff * free variable) mod 2.
                    for r, piv in enumerate(pivot_cols):
                        # compute dot product of row r with x over free cols (excluding pivot col)
                        # Since pivot col variable appears on left side, we have: x[piv] + sum_{j>piv} A[r][j] * x[j] = 0 => x[piv] = sum_{j>piv} A[r][j] * x[j]
                        s = 0
                        for j in free_cols:
                            if A[r][j] == 1 and x[j] == 1:
                                s ^= 1
                        # also need to consider other free columns that are not the current free? Already accounted.
                        x[piv] = s
                    basis.append(x)
                return basis
            
