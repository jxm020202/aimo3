            def count_triples(k, Nmax):
                triples = []
                for a in range(1, k):
                    b = k - a
                    if math.gcd(a,b)!=1:
                        continue
                    for n in range(1, Nmax+1, 2):  # odd n
                        if pow(a, n, n) + pow(b, n, n) == 0 % n:  # check n | a^n + b^n
                            triples.append((n,a,b))
                return triples
            
            def count_n_for_pair(a,b,Nmax):
                res=[]
                for n in range(1,Nmax+1,2):
                    if pow(a,n,n)+pow(b,n,n)==0:
                        res.append(n)
                return res
            
