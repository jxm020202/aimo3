            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            n_vars = len(placements)
            
            A_rows = []
            lb = []
            ub = []
            
            # Non-overlap constraints: for each square, sum <= 1
            for r in range(R):
                for c in range(C):
                    idxs = square_to_placements.get((r,c), [])
                    row = np.zeros(n_vars, dtype=int)
                    for i in idxs:
                        row[i] = 1
                    A_rows.append(row)
                    lb.append(-np.inf)
                    ub.append(1.0)
            
            # Blocking constraints:
            # For each placement i, for each direction, we need neighbor squares occupied.
            def neighbor_squares(p, direction):
                # returns list of neighbor squares required to be occupied (list of (r,c))
                # direction: 'L','R','U','D'
                typ = p['type']
                cells = p['cells']
                # For horizontal:
                if typ == 'H':
                    r,c = cells[0]  # left cell
                    # cells[0] = (r,c), cells[1] = (r,c+1)
                    if direction == 'L':
                        # left neighbor of left cell
                        if c-1 >= 0:
                            return [(r,c-1)]
                        else:
                            return []  # off-board, no requirement
                    if direction == 'R':
                        # right neighbor of right cell
                        if c+2 < C:
                            return [(r,c+2)]
                        else:
                            return []
                    if direction == 'U':
                        # squares above both cells
                        req = []
                        if r-1 >= 0:
                            req.append((r-1,c))
                            req.append((r-1,c+1))
                        # if r-1 <0, off-board -> no requirement
                        return req
                    if direction == 'D':
                        req = []
                        if r+1 < R:
                            req.append((r+1,c))
                            req.append((r+1,c+1))
                        return req
                else:  # vertical
                    r,c = cells[0]  # top cell
                    # cells[0] = (r,c), cells[1] = (r+1,c)
                    if direction == 'U':
                        if r-1 >= 0:
                            return [(r-1,c)]
                        else:
                            return []
                    if direction == 'D':
                        if r+2 < R:
                            return [(r+2,c)]
                        else:
                            return []
                    if direction == 'L':
                        req = []
                        if c-1 >= 0:
                            req.append((r,c-1))
                            req.append((r+1,c-1))
                        return req
                    if direction == 'R':
                        req = []
                        if c+1 < C:
                            req.append((r,c+1))
                            req.append((r+1,c+1))
                        return req
            
            # For each placement, generate constraints for each direction where requirement list is non-empty.
            directions = ['L','R','U','D']
            for i, p in enumerate(placements):
                for d in directions:
                    req = neighbor_squares(p, d)
                    if not req:
                        # no requirement (edge)
                        continue
                    # For each required square, we need sum of placements covering that square >= x_i
                    # Actually need each required square occupied, not just sum across squares.
                    # So for each square in req, we need sum_{j covering square} x_j >= x_i.
                    for sq in req:
                        idxs = square_to_placements.get(sq, [])
                        row = np.zeros(n_vars, dtype=int)
                        for j in idxs:
                            row[j] = 1
                        row[i] -= 1  # -x_i
                        A_rows.append(row)
                        lb.append(0.0)
                        ub.append(np.inf)
            
            # Now build matrix
            A = np.vstack(A_rows)
            lb = np.array(lb, dtype=float)
            ub = np.array(ub, dtype=float)
            
            # Objective: minimize sum x_i
            c = np.ones(n_vars, dtype=float)
            
            # Bounds for variables: binary (0 or 1)
            bounds = Bounds(0, 1)
            
            # integrality: all vars integer
            integrality = np.ones(n_vars, dtype=int)
            
            print("n_vars", n_vars, "n_constraints", A.shape[0])
            
