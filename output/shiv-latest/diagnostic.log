            def region_count_in_plane(plane, other_planes):
                # compute lines of intersection
                lines = []
                for pl in other_planes:
                    inter = plane.intersection(pl)
                    if inter:
                        lines.append(inter[0])  # Line3D
                L = len(lines)
                # find distinct intersection points
                points = []
                for i in range(L):
                    for j in range(i+1, L):
                        inter = lines[i].intersection(lines[j])
                        if inter:
                            pt = inter[0]  # Point3D
                            points.append(pt)
                # deduplicate points
                unique_points = []
                for pt in points:
                    if not any(pt.equals(up) for up in unique_points):
                        unique_points.append(pt)
                # compute multiplicities: number of lines through each point
                multiplicities = []
                for pt in unique_points:
                    m = sum(1 for line in lines if pt in line)  # line.contains(pt)
                    multiplicities.append(m)
                # region count formula: 1 + L + sum_{p} (m(p)-1)
                region_cnt = 1 + L + sum(m-1 for m in multiplicities)
                return region_cnt
            
