            import math
            def pell_solutions(limit_n):
                sols = []
                base = (10, 1) # x0, u0
                fund = (8, 3)
                # compute (8+3 sqrt7)^n
                # Use recurrence: (a+b sqrt7)*(c+d sqrt7) = (ac+7bd) + (ad+bc) sqrt7
                a,b = 1,0 # start with (1,0) for n=0
                for n in range(limit_n+1):
                    # multiply base by (a,b)
                    x = base[0]*a + 7*base[1]*b
                    u = base[0]*b + base[1]*a
                    sols.append((n, x, u))
                    # update (a,b) = (a,b)*(fund)
                    a,b = a*fund[0] + 7*b*fund[1], a*fund[1] + b*fund[0]
                return sols
            
