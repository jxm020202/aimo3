                    a_prime = a // g
                    m_prime = m // g
                    rhs = ((m - k) // g) % m_prime
                    # modular inverse of a_prime mod m_prime
                    try:
                        inv = pow(a_prime, -1, m_prime)
                    except ValueError:
                        continue
                    n0 = (rhs * inv) % m_prime
                    # generate n = n0 + t*m_prime
                    # ensure n>0
                    t_start = 0
                    if n0 == 0:
                        t_start = 1  # n must be positive
                    # set bound for t such that n <= max_n
                    max_t = (max_n - n0) // m_prime
                    for t in range(t_start, max_t+1):
                        n = n0 + t*m_prime
                        # compute b
