            def third_point_isosceles(P, Q):
                # P on AB (k=0), Q on BC (i=0)
                # compute intersection of line through P parallel to BC and line through Q parallel to AB
                # AB direction = (1,0) (horizontal)
                # BC direction = (-0.5, sqrt(3)/2)
                # line through P: P + t * d_BC
                # line through Q: y = y_Q (horizontal)
                # find intersection
                xP,yP = point_coords(P)
                xQ,yQ = point_coords(Q)
                # solve for t: yP + t*dy = yQ
                dy = d_BC[1]
                dx = d_BC[0]
                t = (yQ - yP) / dy
                xR = xP + t*dx
                yR = yQ
                # find nearest lattice point (j,k) that matches coordinates
                # solve for j,k such that (j + k/2)/4 = xR and sqrt(3)/2 * (k/4) = yR
                # from y: k = 8*yR / sqrt(3)
                k = round(8*yR / math.sqrt(3))
                # from x: j = 4*xR - k/2
                j = round(4*xR - k/2)
                if 0 <= j <= 4 and 0 <= k <= 4 and j + k <= 4:
                    return (j,k)
                else:
                    return None
            
