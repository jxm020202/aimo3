            def solve_mq_np(m,n,L):
                def egcd(a,b):
                    if b==0:
                        return (1,0,a)
                    x1,y1,gc = egcd(b, a%b)
                    return (y1, x1 - (a//b)*y1, gc)
                x0,y0,gc = egcd(m,n)
                if L % gc != 0:
