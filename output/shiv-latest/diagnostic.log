            from collections import deque
            
            def min_moves_bruteforce(n, max_steps=20):
                # initial state: tails at odd positions (1-indexed)
                init = tuple(1 if i%2==1 else 0 for i in range(1,n+1))  # 1 tail, 0 head
                target = tuple(0 for _ in range(n))
                # BFS over (position, state) where position is current coin index (1..n)
                # start: we can flip any coin as first move, so we can start at any i, flipping it.
                visited = set()
                q = deque()
                for i in range(1,n+1):
                    state = list(init)
                    state[i-1] ^= 1  # flip
                    tup = (i, tuple(state))
                    visited.add(tup)
                    q.append((i, tuple(state), 1))
                    if tup[1]==target:
                        return 1
                while q:
                    pos, st, steps = q.popleft()
                    if steps >= max_steps:
                        continue
                    for nxt in [pos-1, pos+1]:
                        if 1 <= nxt <= n:
                            new_state = list(st)
                            new_state[nxt-1] ^= 1
                            new_tup = (nxt, tuple(new_state))
                            if new_tup not in visited:
                                if new_tup[1]==target:
                                    return steps+1
                                visited.add(new_tup)
                                q.append((nxt, tuple(new_state), steps+1))
                return None
            
