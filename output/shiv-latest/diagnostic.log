            def is_graphic(seq):
                # Havel-Hakimi
                seq = sorted(seq, reverse=True)
                while seq and seq[0] > 0:
                    d = seq.pop(0)
                    if d > len(seq):
                        return False
                    for i in range(d):
                        seq[i] -= 1
                        if seq[i] < 0:
                            return False
                    seq = sorted(seq, reverse=True)
                return True
            
            def test_n(n):
                seq = list(range(1, n)) + [n-2]  # degree n-2 for vertex n
                return is_graphic(seq)
            
            for n in range(2, 20):
