            import itertools, cmath, math
            
            def find_solution(n, m, candidates):
                # n variables, m exponents
                for combo in itertools.product(candidates, repeat=n):
                    if all(abs(r) < 1e-9 for r in combo):
                        continue
                    ok = True
                    for e in range(1, m+1):
                        prod = 1
                        for r in combo:
                            prod *= (r**e + 1)
                        if abs(prod - 1) > 1e-6:
                            ok = False
                            break
                    if ok:
                        return combo
                return None
            
