            def gray_code(n):
                seq = [0]
                for i in range(n):
                    seq += [x + (1 << i) for x in reversed(seq)]
                return seq
            
            def count_flips(seq):
                from collections import Counter
                cnt = Counter()
                for a,b in zip(seq, seq[1:]):
                    diff = a ^ b
                    k = diff.bit_length() - 1
                    cnt[k] += 1
                # also last to first for cycle
                diff = seq[-1] ^ seq[0]
                k = diff.bit_length() - 1
                cnt[k] += 1
                return cnt
            
