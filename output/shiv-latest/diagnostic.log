            import itertools
            
            def feasible(n):
                # enumerate all binary assignments for x_i, y_i, s_i, t_i
                # small n only
                edges = n-1
                best = None
                for vals in itertools.product([0,1], repeat=2*edges + 2*n):
                    # assign
                    x = vals[:edges]
                    y = vals[edges:2*edges]
                    s = vals[2*edges:2*edges+n]
                    t = vals[2*edges+n:]
                    # constraints
                    if sum(s)!=1 or sum(t)!=1:
                        continue
                    # flow constraints
                    ok=True
                    for i in range(n):
                        out = (x[i] if i<edges else 0) + (y[i-1] if i>0 else 0)
                        indeg = (x[i-1] if i>0 else 0) + (y[i] if i<edges else 0)
                        if out - indeg != s[i] - t[i]:
                            ok=False
                            break
                    if not ok:
                        continue
                    # parity constraints
                    for i in range(n):
                        indeg = (x[i-1] if i>0 else 0) + (y[i] if i<edges else 0)
                        r = 1 if i%2==0 else 0
                        if r==1:
                            if indeg + s[i] != 1:
                                ok=False
                                break
                        else:
                            if indeg - s[i] != 0:
                                ok=False
                                break
                    if not ok:
                        continue
                    total_edges = sum(x)+sum(y)
                    moves = total_edges + 1
                    if best is None or moves<best:
                        best=moves
                return best
            
