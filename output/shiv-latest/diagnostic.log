            def find_sequence(S):
                for m in range(0,38):
                    n = 37 - m
                    a_min1 = max(m+1, T - 2*S)
                    if n > 0:
                        a_max1 = (S - n*(n+1)//2) // n
                    else:
                        a_max1 = T
                    if a_min1 > a_max1:
                        continue
                    for a in range(a_min1, a_max1+1):
                        min_later = n*a + n*(n+1)//2
                        if min_later > S:
                            continue
                        L_low = max(m*(m+1)//2, T - a - S)
                        L_high = min(m*a - m*(m+1)//2, T - a - min_later)
                        if L_low <= L_high:
                            L = L_low  # choose some feasible L
                            later_sum = T - a - L
                            # Now construct early numbers (m numbers) sum L, each < a, strictly increasing.
                            # We can construct minimal sequence 1..m, then add remaining to the largest elements while staying < a.
                            early = list(range(1, m+1))
                            # need to increase sum from min_sum = m(m+1)/2 to L by distributing extra.
                            extra = L - m*(m+1)//2
                            # We'll add extra to the largest elements as much as possible without reaching a.
                            i = m-1
                            while extra > 0 and i >= 0:
                                # current value early[i] can be increased up to a - (m-i) (since need room for later terms)
                                # Actually need to ensure strict increase: early[i] < early[i+1] (if i+1 exists). Since we will adjust from end.
                                max_val = a - (m - i)  # because we need at least (m - i) numbers after i (including a_{i+1} = at most a-1)
                                # The current value early[i] can be increased up to max_val.
                                inc = min(extra, max_val - early[i])
                                early[i] += inc
                                extra -= inc
                                i -= 1
                            if extra != 0:
                                continue  # couldn't distribute
                            # construct later numbers (n numbers) sum later_sum, each > a, strictly increasing.
                            later = []
                            # start with minimal: a+1, a+2, ..., a+n
                            later = [a + i + 1 for i in range(n)]
                            min_later_sum = sum(later)
                            extra2 = later_sum - min_later_sum
                            # distribute extra2 to later numbers, from the end, increasing them arbitrarily.
                            i = n-1
                            while extra2 > 0 and i >= 0:
                                # we can increase later[i] arbitrarily (no upper bound)
                                inc = extra2  # can put all extra in last element
                                later[i] += inc
                                extra2 -= inc
                                i -= 1
                            if extra2 != 0:
                                continue
                            # combine
                            seq = early + [a] + later
                            # verify
