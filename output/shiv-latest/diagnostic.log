            import random, numpy as np, math
            
            def test_t(n, t, trials=10000):
                L = np.zeros((n,n))
                for i in range(n):
                    L[i,i] = 1
                    L[i,(i+1)%n] = 1
                for _ in range(trials):
                    a = np.random.randn(n)
                    M = np.max(np.abs(a))
                    sums = np.abs(a + np.roll(a, -1))
                    m = np.max(sums)
                    if m == 0:
                        # skip zero denominator case (should be only zero vector)
                        continue
                    if M > t * m + 1e-9:
                        return False
                return True
            
            def construct_counterexample(n):
                # b alternating signs
                b = np.array([(-1)**i for i in range(n)], dtype=float)
                # compute a = L^{-1} b
                L = np.zeros((n,n))
                for i in range(n):
                    L[i,i] = 1
                    L[i,(i+1)%n] = 1
                invL = np.linalg.inv(L)
                a = invL @ b
                M = np.max(np.abs(a))
                sums = np.abs(a + np.roll(a, -1))
                m = np.max(sums)
                return a, M, m, M/m
            
            for n in [5,7,9]:
                a, M, m, ratio = construct_counterexample(n)
