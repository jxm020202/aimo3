            x = sp.symbols('x', real=True)
            
            def interval_for_x(val):
                # compute interval endpoints for given x value (float)
                # using piecewise formulas derived
                xv = float(val)
                D = 2*xv - 1
                # compute y_range
                absx = abs(xv)
                if 1 <= absx <= 2:
                    y_range = absx - 1
                elif 2 <= absx <= 3:
                    y_range = 3 - absx
                else:
                    return None
                # y_min, y_max
                y_min = -y_range
                y_max = y_range
                t1 = (2*y_min - 3)/D
                t2 = (2*y_max - 3)/D
                lo = min(t1, t2)
                hi = max(t1, t2)
                return lo, hi
            
            # sample many points
