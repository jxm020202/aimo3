            def perm_T(n):
                # permutation on 0..n-1 (representing 1..n)
                # mapping i -> (866*i) % n
                # but we treat 0 as n (i.e., element n)
                mapping = {}
                for i in range(n):
                    j = (866 * i) % n
                    mapping[i] = j
                # return mapping dict
                return mapping
            
            def perm_E(m):
                # m = n+1
                # permutation on residues 1..m-1 (i.e., 1..n)
                mapping = {}
                for a in range(1, m):
                    b = pow(a, 866, m)
                    mapping[a] = b
                return mapping
            
            def cycle_type(mapping):
                # mapping dict from elements to elements (same set)
                visited = set()
                cycles = []
                for start in mapping:
                    if start not in visited:
                        cur = start
                        length = 0
                        while cur not in visited:
                            visited.add(cur)
                            cur = mapping[cur]
                            length += 1
                        cycles.append(length)
                cycles.sort()
                return tuple(cycles)
            
            def condition_conjugate(n):
                # check squarefree n+1 and permutation property
                m = n+1
                if not is_squarefree(m):
                    return False
                # check exponentiation map has no zero images (i.e., mapping values !=0)
                # but mapping defined only for a in 1..n, value may be 0 -> invalid
                for a in range(1, m):
                    if pow(a, 866, m) == 0:
