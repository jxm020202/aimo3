                    xi,yi=points[i]
                    angles=[]
                    for j in range(n):
                        if i==j: continue
                        xj,yj=points[j]
                        ang=math.atan2(yj-yi,xj-xi) % (2*math.pi)
                        angles.append((ang,j))
                    # sort angles
                    angles.sort()
                    # duplicate for wrap
                    angles2=angles+[(ang+2*math.pi,j) for (ang,j) in angles]
                    # sliding window to find max count and record which j's are in some optimal interval
                    max_cnt=0
