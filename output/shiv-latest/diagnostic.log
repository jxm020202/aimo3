            import random, math, numpy as np
            def random_point_on_sphere(radius=math.sqrt(3)):
                # generate normal distribution
                v = np.random.normal(size=3)
                v = v / np.linalg.norm(v) * radius
                return v
            
            def f_val(p):
                x,y,z = p
                return x*y**3 + y*z**3 + z*x**3
            
            def sample(n=1000000):
                vals = []
                max_val = -1e9
                min_val = 1e9
                max_pt = None
                min_pt = None
                for _ in range(n):
                    p = random_point_on_sphere()
                    val = f_val(p)
                    if val > max_val:
                        max_val = val
                        max_pt = p
                    if val < min_val:
                        min_val = val
                        min_pt = p
