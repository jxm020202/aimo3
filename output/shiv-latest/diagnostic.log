                n = A.shape[0]
                # try to find S: we can deduce S from first row perhaps.
                # Since each row has 6 ones, we can guess S as set of indices where row 0 has 0? Wait.
                # For bipartite form, rows in same side have identical rows (complement of each other).
                # Actually rows in same side have identical rows (they are all equal to characteristic vector of opposite side).
                # So we can attempt to find partition by grouping rows by equality.
                rows = [tuple(A[i]) for i in range(n)]
                # group indices by row pattern
                pattern_to_indices = {}
                for i, pat in enumerate(rows):
                    pattern_to_indices.setdefault(pat, []).append(i)
                # There should be exactly two distinct patterns (maybe one if all rows same? but not possible because each row has 6 ones)
                if len(pattern_to_indices)!=2:
                    return False
                # patterns should be complements of each other
                pat1, pat2 = list(pattern_to_indices.keys())
                # check complement
                if any(p1 ^ p2 for p1, p2 in zip(pat1, pat2)):
                    # Actually complement means p1[i] + p2[i] == 1 for all i
                    if not all(p1_i + p2_i == 1 for p1_i, p2_i in zip(pat1, pat2)):
                        return False
                # also each pattern must have weight 6
                if sum(pat1)!=6 or sum(pat2)!=6:
                    return False
                # Determine S as indices where row pattern equals pat2? Actually rows with pattern pat1 correspond to side where rows have 1's in columns of opposite side.
                # Let's compute S as set of column indices where pat1 has 1 (i.e., support of pat1). This should be the opposite side of rows with pattern pat2.
