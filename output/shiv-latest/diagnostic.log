            import numpy as np, scipy.sparse as sp
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            T = 1997
            n_a = 38
            n_P = 38
            n_u = 37
            n_X = 1
            n = n_a + n_P + n_u + n_X
            
            # Index offsets
            idx_a = 0
            idx_P = idx_a + n_a
            idx_u = idx_P + n_P
            idx_X = idx_u + n_u
            
            # Build constraints list
            A_rows = []
            lb = []
            ub = []
            
            # 1. a_i >= 1 (lower bound) will be set via Bounds later, not via constraints.
            
            # 2. a_{i+1} - a_i >= 1  => a_i - a_{i+1} <= -1
            for i in range(n_a-1):
                row = np.zeros(n)
                row[idx_a + i] = 1   # a_i
                row[idx_a + i + 1] = -1  # -a_{i+1}
                A_rows.append(row)
                lb.append(-np.inf)
                ub.append(-1)  # <= -1
            
            # 3. P_k = P_{k-1} + a_k for k=1..38
            # For k=1: P_1 - a_1 = 0
            for k in range(1, n_P+1):
                row = np.zeros(n)
                row[idx_P + k - 1] = 1   # P_k
                if k-1 >= 0:
                    row[idx_P + k - 2] = -1  # -P_{k-1}
                row[idx_a + k - 1] = -1   # -a_k
                A_rows.append(row)
                lb.append(0)
                ub.append(0)
            
            # 4. P_38 = T (sum = T)
            row = np.zeros(n)
            row[idx_P + n_P - 1] = 1
            A_rows.append(row)
            lb.append(T)
            ub.append(T)
            
            # 5. For each k=1..37, constraints for min condition
            M = T  # big M
            for k in range(1, n_u+1):
                # first inequality: P_k - X - M*u_k <= 0
                row = np.zeros(n)
                row[idx_P + k - 1] = 1   # P_k
                row[idx_X] = -1          # -X
                row[idx_u + k - 1] = -M  # -M*u_k
                A_rows.append(row)
                lb.append(-np.inf)
                ub.append(0)
                # second inequality: -P_k + M*u_k - X <= 0
                row2 = np.zeros(n)
                row2[idx_P + k - 1] = -1  # -P_k
                row2[idx_X] = -1          # -X
                row2[idx_u + k - 1] = M   # M*u_k
                A_rows.append(row2)
                lb.append(-np.inf)
                ub.append(0)
            
            # Convert to arrays
            A = np.vstack(A_rows)
            A = sp.csc_array(A)
            
            lb = np.array(lb, dtype=float)
            ub = np.array(ub, dtype=float)
            
            # Bounds for variables
            lower_bounds = np.zeros(n)
            upper_bounds = np.full(n, np.inf)
            
            # a_i >= 1
            lower_bounds[idx_a: idx_a + n_a] = 1
            
            # u_k binary: 0 <= u <= 1
            lower_bounds[idx_u: idx_u + n_u] = 0
            upper_bounds[idx_u: idx_u + n_u] = 1
            
            # X >= 0
            lower_bounds[idx_X] = 0
            upper_bounds[idx_X] = T
            
            # Optionally set upper bounds for a_i maybe T, but not needed.
            
            bounds = Bounds(lower_bounds, upper_bounds)
            
            # integrality: all variables integer
            integrality = np.ones(n, dtype=int)
            
            # Objective: minimize X
            c = np.zeros(n)
            c[idx_X] = 1
            
            constraints = LinearConstraint(A, lb, ub)
            
            res = milp(c=c, constraints=constraints, integrality=integrality, bounds=bounds, options={'disp': True})
            print(res.success, res.message)
            print("Objective (X):", res.fun)
            print("X:", res.x[idx_X])
            
