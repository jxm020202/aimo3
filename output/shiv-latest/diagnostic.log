            def max_clique_recursive(R, P, depth=0):
                global max_clique, max_size
                if not P:
                    # no candidates
                    if len(R) > max_size:
                        max_size = len(R)
                        max_clique = R[:]
                    return
                # coloring bound: order vertices in P by degree? Use greedy coloring to get upper bound
                # Convert P (int bitmask) to list of vertices
                # We'll implement simple coloring: assign colors to vertices in order of descending degree within P
                # For bound, we need an ordering and color numbers.
                # We'll produce an ordered list of vertices and color numbers.
                # Use algorithm from Tomita: color class list
                # Build list of vertices in P
                verts = []
                temp = P
                while temp:
                    v = (temp & -temp).bit_length() - 1  # index of least set bit
                    verts.append(v)
                    temp &= temp - 1
                # Sort by degree (optional)
                # Greedy coloring
                colors = {}
                color_class = []
                for v in verts:
                    # find smallest color not used by neighbors already colored
                    used = set()
                    for c, cls in enumerate(color_class):
                        # if any vertex in cls is neighbor of v, then cannot use this color
                        # we can check intersection quickly: if any vertex in cls is neighbor of v
                        # but we store cls as list of vertices
                        for u in cls:
