                # twice signed area using coordinates (x,y)
                (i1,j1) = p1
                (i2,j2) = p2
                (i3,j3) = p3
                # compute actual Euclidean coordinates:
                # x = i + j/2, y = (sqrt(3)/2) * j
                # area formula: (x2-x1)*(y3-y1) - (x3-x1)*(y2-y1)
                # we can compute using rational numbers ignoring sqrt(3) factor:
