            def is_point_in_triangle(P, A, B, C):
                # Using barycentric technique: compute areas via cross product
                # Compute vectors
                def cross(u, v):
                    return u[0]*v[1] - u[1]*v[0]
                # Convert points to tuples
                Ax,Ay = A.x, A.y
                Bx,By = B.x, B.y
                Cx,Cy = C.x, C.y
                Px,Py = P.x, P.y
                # Compute cross products
                cross1 = cross((Bx-Ax, By-Ay), (Px-Ax, Py-Ay))
                cross2 = cross((Cx-Bx, Cy-By), (Px-Bx, Py-By))
                cross3 = cross((Ax-Cx, Ay-Cy), (Px-Cx, Py-Cy))
                # Check if all have same sign or zero
                # Allow zero (on edge)
                # Use sympy sign
                # Convert to sympy to evaluate sign
                # For symbolic sqrt3, cross may be expression; we can check if it is >=0 using .is_nonnegative etc.
                # We'll just check if they are all non-negative or all non-positive
                # Determine sign of first non-zero
                signs = []
                for c in [cross1, cross2, cross3]:
                    if c.is_zero:
                        signs.append(0)
                    elif c.is_positive:
                        signs.append(1)
                    elif c.is_negative:
                        signs.append(-1)
                    else:
                        # symbolic unknown sign, evaluate numerically
                        val = float(c.evalf())
                        if abs(val) < 1e-12:
