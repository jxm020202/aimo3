        >>> Code:
            def last_nonzero_digit_factorial(n):
                # using recurrence
                # D(0)=1
                # D(1)=1, D(2)=2, D(3)=6, D(4)=4
                # D(n) = D(n//5) * D(n%5) * pow(2, n//5, 10) % 10
                if n == 0:
                    return 1
                # iterative approach
                res = 1
                while n > 0:
                    # multiply by D(n%5)
                    r = n % 5
                    if r == 0:
                        d = 1
                    elif r == 1:
                        d = 1
                    elif r == 2:
                        d = 2
                    elif r == 3:
                        d = 6
                    elif r == 4:
                        d = 4
                    res = (res * d) % 10
                    # multiply by 2^{n//5} mod 10
                    res = (res * pow(2, n // 5, 10)) % 10
                    n //= 5
                return res
            
            # test first few values
            print([last_nonzero_digit_factorial(i) for i in range(1,21)])
            
        >>> Output:
            [1, 2, 6, 4, 2, 2, 4, 2, 8, 8, 8, 6, 8, 2, 8, 8, 6, 8, 2, 4]
            

