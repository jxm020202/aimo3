        import math, random, time

def generate_mixed(N, center_frac=0.5):
    pts=[]
    for i in range(N):
        if random.random()<center_frac:
            # near center
            r=0.1*math.sqrt(random.random())
        else:
            # near boundary
            r=0.9+0.1*math.sqrt(random.random())
        theta=2*math.pi*random.random()
        pts.append((r*math.cos(theta), r*math.sin(theta)))
    return pts

def random_search(trials=200):
    best=0
    for _ in range(trials):
        pts=generate_mixed(100)
        s=total_sum(pts)
        if s>best:
            best=s
    return best

