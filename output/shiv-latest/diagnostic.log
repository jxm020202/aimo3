            import math
            
            def last_nonzero_digit_factorial(n):
                # compute n! removing factors of 10
                # naive but for n up to maybe 2000 fine
                res = 1
                for i in range(2, n+1):
                    x = i
                    while x % 5 == 0:
                        x //= 5
                        # will later pair with a 2
                    while x % 2 == 0:
                        x //= 2
                    res = (res * x) % 10
                # multiply by appropriate power of 2 for each removed 5
                # Actually we removed all 2s as well; need to count net 2s after pairing with 5s.
                # Simpler: compute factorial and strip zeros (but factorial huge)
                # Let's use known recurrence method.
                return res
            
            def last_nonzero_digit_factorial_rec(n):
                # using recurrence
                if n == 0:
                    return 1
                # precomputed values for n%5
                small = [1,1,2,6,4]
                # compute recursively
                # L(n) = L(n//5) * L(n%5) * 2^{n//5} mod 10
                # but need to handle modulo 10 with powers of 2 mod 10 cycle 4.
                # Use pow with mod.
                return (last_nonzero_digit_factorial_rec(n//5) * small[n%5] * pow(2, n//5, 10)) % 10
            
            def f(n):
                return last_nonzero_digit_factorial_rec(n)
            
            # test small values
            vals = [f(i) for i in range(1,21)]
            vals[:20]
            
