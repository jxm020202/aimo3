            import math
            from math import floor, ceil, gcd
            
            def is_pretty(m,n,k,alpha):
                return m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k
            
            def is_cool_bruteforce(m,n,k,alpha):
                if not is_pretty(m,n,k,alpha):
                    return False
                # check (m-n,n) if positive
                if m>n:
                    if is_pretty(m-n,n,k,alpha):
                        return False
                # check (m,n-m) if positive
                if n>m:
                    if is_pretty(m,n-m,k,alpha):
                        return False
                return True
            
            def count_cool_bruteforce(k,alpha,limit):
                cnt=0
                pairs=[]
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if is_cool_bruteforce(m,n,k,alpha):
                            cnt+=1
                            pairs.append((m,n))
                return cnt,pairs
            
            def count_cool_formula(k,limit=None):
                # using derived condition: sum over divisors d of k of ordered coprime pairs (x,y) with 1<=x,y<=d, x+y>d
                total=0
                for d in divisors(k):
