            def compute_a_from_b(b):
                n = len(b)
                # Solve linear system (I+P) a = b
                # Build matrix
                import numpy as np
                T = np.zeros((n,n))
                for i in range(n):
                    T[i,i] = 1
                    T[i,(i+1)%n] = 1
                a = np.linalg.solve(T, b)
                return a
            
            def max_a_over_max_b(n):
                b = np.ones(n)
                a = compute_a_from_b(b)
                return max(abs(a)), max(abs(b))
            
