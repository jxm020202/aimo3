            # Reinitialize everything in one cell
            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            from itertools import combinations
            
            N = 7
            M = 7
            
            # Enumerate dominos
            dominos = []
            for r in range(N):
                for c in range(M-1):
                    dominos.append(('H', r, c))
            for r in range(N-1):
                for c in range(M):
                    dominos.append(('V', r, c))
            N_vars = len(dominos)
            
            def cells_of(dom):
                typ, r, c = dom
                if typ == 'H':
                    return [(r,c),(r,c+1)]
                else:
                    return [(r,c),(r+1,c)]
            
            # mapping cell -> list of domino indices covering it
            cell_to_dominos = {}
            for idx, dom in enumerate(dominos):
                for cell in cells_of(dom):
                    cell_to_dominos.setdefault(cell, []).append(idx)
            
            def required_sets(dom):
                typ, r, c = dom
                dirs = []
                if typ == 'H':
                    if c-1 >= 0:
                        dirs.append([(r,c-1)])
                    if c+2 < M:
                        dirs.append([(r,c+2)])
                    if r-1 >= 0:
                        dirs.append([(r-1,c), (r-1,c+1)])
                    if r+1 < N:
                        dirs.append([(r+1,c), (r+1,c+1)])
                else: # V
                    if r-1 >= 0:
                        dirs.append([(r-1,c)])
                    if r+2 < N:
                        dirs.append([(r+2,c)])
                    if c-1 >= 0:
                        dirs.append([(r,c-1), (r+1,c-1)])
                    if c+1 < M:
                        dirs.append([(r,c+1), (r+1,c+1)])
                return dirs
            
            # Build constraint matrix A, lb, ub
            rows = []
            lb = []
            ub = []
            
            # cell non-overlap constraints: sum <= 1
            for r in range(N):
                for c in range(M):
                    row = np.zeros(N_vars, dtype=int)
                    for idx in cell_to_dominos[(r,c)]:
                        row[idx] = 1
                    rows.append(row)
                    lb.append(-np.inf)
                    ub.append(1)
            
            # blocking constraints: for each domino i, each direction set, sum over dominos covering any cell in set >= x_i
            for i, dom in enumerate(dominos):
                dirs = required_sets(dom)
                for cellset in dirs:
                    row = np.zeros(N_vars, dtype=int)
                    covered = set()
                    for cell in cellset:
                        covered.update(cell_to_dominos[cell])
                    for idx in covered:
                        row[idx] = 1
                    row[i] -= 1
                    rows.append(row)
                    lb.append(0)
                    ub.append(np.inf)
            
            A = np.vstack(rows)
            lb = np.array(lb, dtype=float)
            ub = np.array(ub, dtype=float)
            
            c_obj = np.ones(N_vars, dtype=int)  # minimize sum
            
            bounds = Bounds(0, 1)
            
            def solve_with_min_sum(min_sum):
                # add constraint sum x_i >= min_sum
                A_aug = np.vstack([A, np.ones(N_vars, dtype=int)])
                lb_aug = np.append(lb, min_sum)
                ub_aug = np.append(ub, np.inf)
                lin = LinearConstraint(A_aug, lb_aug, ub_aug)
                res = milp(c=c_obj, constraints=lin, integrality=np.ones(N_vars, dtype=int), bounds=bounds, options={'disp': False})
                return res
            
            # quick test: try min_sum=1
