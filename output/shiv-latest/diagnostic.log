                            b.append(-d - epsilon)
                    bounds = [(-bound,bound),(-bound,bound),(-bound,bound)]
                    res = linprog(c=[0,0,0], A_ub=A, b_ub=b, bounds=bounds, method='highs')
                    if res.success:
                        cnt += 1
                return cnt
            
