                    state[start] ^= 1
                    tup = tuple(state)
                    key = (start, tup)
                    visited[key] = 1  # moves count
                    dq.append((start, tup, 1))
                    if tup == target:
                        return 1
                while dq:
                    pos, state, steps = dq.popleft()
                    # next moves: flip neighbor left or right
                    for nb in [pos-1, pos+1]:
