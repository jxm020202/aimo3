            import sympy as sp
            
            # define points
            B = sp.Point3D(1,0,0)
            A1 = sp.Point3D(0,0,1)
            C1 = sp.Point3D(1,1,1)
            D1 = sp.Point3D(0,1,1)
            
            def plane_from_points(p1,p2,p3):
                # returns (a,b,c,d) for plane ax+by+cz+d=0
                # compute normal vector via cross product of (p2-p1) and (p3-p1)
                v1 = sp.Matrix(p2) - sp.Matrix(p1)
                v2 = sp.Matrix(p3) - sp.Matrix(p1)
                n = v1.cross(v2)  # normal vector
                a,b,c = n
                # compute d using point p1: a*x0 + b*y0 + c*z0 + d = 0 => d = -(a*x0 + b*y0 + c*z0)
                d = -(a*p1.x + b*p1.y + c*p1.z)
                # simplify
                return sp.simplify(a), sp.simplify(b), sp.simplify(c), sp.simplify(d)
            
            planes = []
            planes.append(plane_from_points(B, A1, C1))
            planes.append(plane_from_points(B, A1, D1))
            planes.append(plane_from_points(B, C1, D1))
            planes.append(plane_from_points(A1, C1, D1))
            planes
            
