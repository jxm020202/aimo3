            def find_schedule(n, target_ops):
                import math, itertools, sys
                sys.setrecursionlimit(10000)
                caps = [0]+[i if i<n else n-1 for i in range(1,n+1)]
                # We'll try to assign degrees d_i <= caps[i] such that sum d_i = 2*target_ops
                total_deg = 2*target_ops
                # Simple heuristic: start with d_i = min(caps[i], target_ops) maybe.
                # We'll use simple approach: set d_i = caps[i] for i<n, and adjust d_n downwards to meet total_deg.
                d = caps[:]
                current_sum = sum(d[1:])
                # Reduce degrees from highest vertices until sum matches total_deg
                i = n
                while current_sum > total_deg:
                    if d[i] > 0:
                        d[i] -= 1
                        current_sum -= 1
                    i -= 1
                    if i == 0:
                        i = n
                # Now we have degree sequence d
                # Build list of edges to satisfy degree sequence (simple graph) using Havel-Hakimi constructive algorithm
                # We'll produce adjacency list
                deg = d[1:]
                # Use Havel-Hakimi to construct graph
                vertices = list(range(1,n+1))
                adj = {v:set() for v in vertices}
                # Sort vertices by remaining degree descending
                import heapq
                # Use list of (deg, vertex) negative for max-heap
                heap = [(-deg[i-1], vertices[i-1]) for i in range(1,n+1)]
                heapq.heapify(heap)
                while heap:
                    deg_v, v = heapq.heappop(heap)
                    deg_v = -deg_v
                    if deg_v == 0:
                        continue
                    # pop next deg_v vertices with highest degree
                    temp = []
                    for _ in range(deg_v):
                        if not heap:
                            raise ValueError("Cannot construct")
                        d_u, u = heapq.heappop(heap)
                        d_u = -d_u
                        # add edge v-u
                        adj[v].add(u)
                        adj[u].add(v)
                        d_u -= 1
                        temp.append((-d_u, u))
                    # push back updated vertices
                    for item in temp:
                        heapq.heappush(heap, item)
                    # v degree satisfied (0)
                # Now we have a simple graph with degree sequence d
                # Now we need to order edges to maintain gcd=1 each step.
                # We'll attempt backtracking to order edges.
                edges = [(i,j) for i in range(1,n+1) for j in adj[i] if i<j]
                # backtrack ordering
                used = set()
                coins = list(range(n+1))
                def backtrack(order):
                    if len(order) == len(edges):
                        return order
                    # try each remaining edge
                    for e in edges:
                        if e in used: continue
                        i,j = e
                        if coins[i]==0 or coins[j]==0: continue
                        if math.gcd(coins[i], coins[j]) != 1:
                            continue
                        # apply
                        used.add(e)
                        coins[i]-=1
                        coins[j]-=1
                        res = backtrack(order+[e])
                        if res is not None:
                            return res
                        # backtrack
                        used.remove(e)
                        coins[i]+=1
                        coins[j]+=1
                    return None
                order = backtrack([])
                return order, d
            
