                        # evaluate numeric to check within interval
                        val = sp.N(c)
                        if val >= interval[0] - 1e-12 and val <= interval[1] + 1e-12:
                            crit_in.append(c)
                # evaluate expr at interval endpoints and critical points
                points = [interval[0], interval[1]] + crit_in
                vals = [sp.simplify(expr.subs(var, p)) for p in points]
                # compute min and max
                min_val = sp.simplify(min(vals, key=lambda v: sp.N(v)))
                max_val = sp.simplify(max(vals, key=lambda v: sp.N(v)))
                return min_val, max_val, points, vals
            
