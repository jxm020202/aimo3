            def seq_nonperiodic(L, N=2000):
                seq = [0]*N
                # positions of 1's at triangular numbers: k*(k+1)//2
                pos = 0
                k = 1
                while pos < N:
                    seq[pos] = 1
                    k += 1
                    pos = k*(k+1)//2
                return seq
            
            def count_blocks_seq(seq, L):
                blocks = set()
                for n in range(len(seq)-L):
                    blocks.add(tuple(seq[n+1:n+L+1]))
