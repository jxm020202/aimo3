            import numpy as np, math
            
            k = 3.877167644314494
            y1 = 0.6*k
            y2 = -1.69756280441454
            
            C = np.array([-5.0, k])
            R_pt = np.array([-1.0, k])
            D = np.array([5.0, k])
            
            O1 = np.array([-3.0, y1])
            O2 = np.array([2.0, y2])
            
            r1 = np.linalg.norm(C - O1)
            r2 = np.linalg.norm(D - O2)
            
            # compute intersection points of circles O1,r1 and O2,r2
            def circle_intersections(O1, r1, O2, r2):
                d = np.linalg.norm(O2 - O1)
                # check for intersection
                if d > r1 + r2 or d < abs(r1 - r2):
                    return None
                # distance from O1 to line of centers to chord midpoint
                a = (r1**2 - r2**2 + d**2) / (2*d)
                h = math.sqrt(max(r1**2 - a**2, 0))
                # point P2 = O1 + a*(O2-O1)/d
                P2 = O1 + a * (O2 - O1) / d
                # intersection points
                offset = h * np.array([-(O2[1] - O1[1]) / d, (O2[0] - O1[0]) / d])
                inter1 = P2 + offset
                inter2 = P2 - offset
                return inter1, inter2
            
            intersections = circle_intersections(O1, r1, O2, r2)
            intersections
            
