            def count_regions_correct():
                planes = [
                    (1,0,0,0),   # x=0
                    (1,0,0,-1),  # x=1
                    (0,1,0,0),   # y=0
                    (0,1,0,-1),  # y=1
                    (0,0,1,0),   # z=0
                    (0,0,1,-1),  # z=1
                    (1,0,1,-1),  # x+z=1
                    (-1,1,-1,1), # -x + y - z +1 =0
                    (0,-1,1,0),  # -y+z=0
                ]
                n=len(planes)
                feasible={}
                for signs in itertools.product([1,-1], repeat=n):
                    A_ub=[]
                    b_ub=[]
                    for (a,b,c,d), s in zip(planes, signs):
                        if s==1:
                            # a x + b y + c z + d >= t  -> -a x - b y - c z + t <= d
                            A_ub.append([-a, -b, -c, 1])
                            b_ub.append(d)
                        else:
                            # a x + b y + c z + d <= -t -> a x + b y + c z + t <= -d
                            A_ub.append([a, b, c, 1])
                            b_ub.append(-d)
                    bounds=[(None,None),(None,None),(None,None),(0,None)]
                    c=[0,0,0,-1]  # minimize -t
                    res=opt.linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method='highs')
                    if res.success:
                        t_val = -res.fun
                        if t_val > 1e-9:
                            feasible[signs]=res.x[:3]
                return feasible
            
