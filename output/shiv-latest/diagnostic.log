            def compute_a1_for_n(n):
                # n odd
                # recurrence a_{i+1} = s_i - a_i, s_i = (-1)^{i+1}
                # start with a1 = x, compute a_{n+1} as function of x
                import sympy as sp
                x = sp.symbols('x')
                a = x
                for i in range(1, n+1):  # i from 1 to n
                    s = (-1)**(i+1)
                    a = s - a
                # after n steps, a should equal a1 = x
                eq = sp.Eq(a, x)
                sol = sp.solve(eq, x)
                return sol
            
