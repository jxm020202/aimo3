            def find_feasible_bound(n, total_sum, max_val=3):
                import numpy as np, scipy.sparse as sp
                from scipy.optimize import milp, LinearConstraint, Bounds
                N = n*n
                edges = []
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        if i+1 < n:
                            edges.append((idx, (i+1)*n + j))
                        if j+1 < n:
                            edges.append((idx, i*n + (j+1)))
                M = len(edges)
                rows = []
                cols = []
                data = []
                b_eq = []
                for e, (u,v) in enumerate(edges):
                    rows.extend([e, e, e])
                    cols.extend([v, u, N+e])
                    data.extend([1, -1, -2])
                    b_eq.append(-1)
                A_eq = sp.csr_matrix((data, (rows, cols)), shape=(M, N+M))
                b_eq = np.array(b_eq)
                # sum constraint
                rows_sum = np.zeros(N, dtype=int)
                cols_sum = np.arange(N)
                data_sum = np.ones(N)
                A_sum = sp.csr_matrix((data_sum, (rows_sum, cols_sum)), shape=(1, N+M))
                A = sp.vstack([A_eq, A_sum])
                b = np.concatenate([b_eq, [total_sum]])
                lower = np.concatenate([np.zeros(N), np.zeros(M)])
                upper = np.concatenate([np.full(N, max_val), np.ones(M)])
                bounds = Bounds(lower, upper)
                integrality = np.concatenate([np.ones(N), np.ones(M)])
                c = np.zeros(N+M)
                res = milp(c=c, constraints=LinearConstraint(A, b, b), bounds=bounds, integrality=integrality, options={'disp': False, 'maxiter': 5000})
                return res
            
