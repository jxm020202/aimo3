            def possible_sum_min(n):
                # returns set of (sum_a, min_a) for sequences a_0..a_{n-1}
                # a_0 = 0
                # step +/-1 each time
                # we track current value, sum so far, min so far
                states = {(0, 0, 0)}  # (current, sum, min)
                for i in range(1, n):
                    new_states = set()
                    for cur, s, mn in states:
                        for delta in (+1, -1):
                            nxt = cur + delta
                            ns = s + nxt
                            nmn = mn if mn < nxt else nxt
                            new_states.add((nxt, ns, nmn))
                    states = new_states
                # after n-1 steps, we have a_{n-1} as cur, sum includes a_0? we started sum=0 includes a_0=0.
                # sum includes all a_i values (including a_0=0)
                # min includes a_0=0 as initial min
                # return set of (sum, min)
                return {(s, mn) for cur, s, mn in states}
                
