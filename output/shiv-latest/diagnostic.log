            from functools import lru_cache
            import itertools
            
            def max_ops_bruteforce(n):
                # BFS/DFS search for max operations, considering unordered pairs used at most once
                # state: tuple of coin counts, used edges bitmask (we can map pair index)
                # For n up to 5 maybe feasible
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(pairs)
                # map pair to index
                pair_to_idx = {pair: idx for idx,pair in enumerate(pairs)}
                @lru_cache(None)
                def dfs(state_counts, used_mask):
                    best = 0
                    counts = list(state_counts)
                    for (i,j) in pairs:
                        idx = pair_to_idx[(i,j)]
                        if (used_mask>>idx)&1:
                            continue
                        if counts[i]==0 or counts[j]==0:
                            continue
                        d = math.gcd(counts[i], counts[j])
                        # remove d from both
                        new_counts = list(counts)
                        new_counts[i] -= d
                        new_counts[j] -= d
                        new_mask = used_mask | (1<<idx)
                        best = max(best, 1 + dfs(tuple(new_counts), new_mask))
                    return best
                init_counts = tuple(k+1 for k in range(n))
                return dfs(init_counts, 0)
            
