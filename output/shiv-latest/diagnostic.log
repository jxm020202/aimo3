            from collections import deque
            
            def min_moves(N):
                # initial config: odd positions tails (1), even heads (0)
                init = tuple(1 if i%2==0 else 0 for i in range(N))  # 0-index: position i (0..N-1) corresponds to i+1
                target = tuple(0 for _ in range(N))
                # BFS state: (config, last_pos) where last_pos = index of last flipped coin, or -1 for start (no restriction)
                start_state = (init, -1)
                q = deque()
                q.append(start_state)
                visited = set()
                visited.add(start_state)
                steps = 0
                while q:
                    for _ in range(len(q)):
                        config, last = q.popleft()
                        if config == target:
                            return steps
                        # possible flips:
                        if last == -1:
                            candidates = range(N)
                        else:
                            candidates = []
                            if last-1 >= 0:
                                candidates.append(last-1)
                            if last+1 < N:
                                candidates.append(last+1)
                        for pos in candidates:
                            # flip pos
                            new_config = list(config)
                            new_config[pos] ^= 1  # toggle
                            new_state = (tuple(new_config), pos)
                            if new_state not in visited:
                                visited.add(new_state)
                                q.append(new_state)
                    steps += 1
                return None
            
            for N in range(1, 11):
                print(N, min_moves(N))
            
