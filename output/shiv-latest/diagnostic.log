            import itertools, math, numpy as np, scipy.optimize as opt, scipy
            
            def max_edges_milp(n):
                # variables for each unordered pair (i<j)
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(pairs)
                # objective: maximize sum x
                c = -np.ones(m)  # minimize negative to maximize
                # constraints: for each vertex i, sum of incident edges <= cap_i
                caps = [i+1 if i+1 < n else n-1 for i in range(n)]  # i from 0..n-1 corresponds to vertex i+1
                A = np.zeros((n,m), dtype=int)
                for idx,(i,j) in enumerate(pairs):
                    A[i, idx] = 1
                    A[j, idx] = 1
                lb = np.zeros(m)
                ub = np.ones(m)
                # constraints: A x <= caps
                lincon = opt.LinearConstraint(A, -np.inf, caps)
                bounds = opt.Bounds(lb, ub)
                # integrality: all variables integer (binary)
                integrality = np.ones(m)
                res = opt.milp(c=c, constraints=lincon, bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    print("MILP failed")
                    return None
                edges = int(round(-res.fun))
                return edges
            
            for n in range(5,13):
                greedy_edges = total_edges_from_caps(caps_seq(n))
                opt_edges = max_edges_milp(n)
                print(n, greedy_edges, opt_edges)
            
