            def construct_threshold_graph(n):
                caps = [i for i in range(1, n)] + [n-1]  # caps for vertices 1..n
                # sort vertices by caps descending, keep original indices maybe not needed
                # We'll create list of (cap, idx)
                verts = sorted([(caps[i], i) for i in range(n)], key=lambda x: -x[0])
                # adjacency matrix not needed, just track degrees
                deg = [0]*n
                edges = 0
                # We'll maintain a set of remaining vertices after each step
                # For each vertex in order, connect to later vertices (by order in verts list) that still have degree < cap
                # Actually we need to ensure we don't exceed caps of other vertices.
                # We'll iterate over vertices in order, and for each, connect to subsequent vertices in the list (i+1 .. n-1) as long as both have remaining capacity.
                for i in range(n):
                    cap_i, idx_i = verts[i]
                    # remaining capacity for vertex i
                    rem_i = cap_i - deg[idx_i]
                    # connect to later vertices
                    for j in range(i+1, n):
                        if rem_i <= 0:
                            break
                        cap_j, idx_j = verts[j]
                        rem_j = cap_j - deg[idx_j]
                        if rem_j <= 0:
                            continue
                        # add edge
                        deg[idx_i] += 1
                        deg[idx_j] += 1
                        edges += 1
                        rem_i -= 1
                    # continue
                return edges, deg
            
