            def construct_graph_max_degree(upper):
                # upper: list of caps per vertex (unsorted)
                # We'll treat vertices as unlabeled; we just care about sum.
                # We'll use a priority queue of (remaining_degree, vertex_id)
                import heapq
                n = len(upper)
                # use negative for max-heap
                heap = [(-d, i) for i, d in enumerate(upper)]
                heapq.heapify(heap)
                degree_used = [0]*n
                edges = []
                while heap:
                    d_neg, v = heapq.heappop(heap)
                    d = -d_neg
                    if d == 0:
                        break
                    # gather up to d other vertices with highest remaining degree
                    temp = []
                    for _ in range(d):
                        if not heap:
                            # not enough vertices, reduce d
                            d = len(temp)
                            break
                        d2_neg, u = heapq.heappop(heap)
                        d2 = -d2_neg
                        # connect v-u
                        edges.append((v,u))
                        degree_used[v] += 1
                        degree_used[u] += 1
                        d2 -= 1
                        temp.append((d2, u))
                    # push back the modified vertices
                    for d2, u in temp:
                        heapq.heappush(heap, (-d2, u))
                    # if we couldn't connect to all d originally, we stop (no more possible)
                    # The vertex v may still have remaining degree >0 but no partners left; we ignore.
                total_deg = sum(degree_used)
                return total_deg, degree_used, edges
            
