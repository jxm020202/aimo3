                c = -np.ones(m)  # maximize edges => minimize negative
                # constraints: for each vertex i, sum of incident edges <= bound_i
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(edge_list):
                    A[i, idx] = 1
                    A[j, idx] = 1
                lc = LinearConstraint(A, lb=-np.inf, ub=bounds)
                # variables binary
                bounds_vars = Bounds(0, 1)
                res = milp(c=c, constraints=[lc], bounds=bounds_vars, integrality=np.ones(m, dtype=int))
                if not res.success:
                    print("MILP failed")
                    return None
                x = np.rint(res.x).astype(int)
                edges_selected = [edge_list[i] for i in range(m) if x[i]==1]
                return len(edges_selected), x
            
