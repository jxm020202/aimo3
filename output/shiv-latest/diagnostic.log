                for i in range(1,N):
                    row = np.zeros(total_vars)
                    for k in range(n):
                        j = i ^ (1<<k)
                        # arc j->i
                        row[idx_x[(j,i)]] = 1
                    A.append(row)
                    b.append(1)
                # outgoing constraints for each i !=0: sum_{j} x_{i,j} = 1 - z_i
                for i in range(1,N):
