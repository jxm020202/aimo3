            def max_moves_exact(n):
                # map unordered pair (i,j) with i<j to index
                pair_index = {}
                idx=0
                for i in range(1,n+1):
                    for j in range(i+1,n+1):
                        pair_index[(i,j)] = idx
                        idx+=1
                total_pairs = idx
                start_sizes = tuple(range(0,n+1))  # index 0 unused
                start_used = 0  # bitmask
                start_state = (start_sizes, start_used)
                # BFS/DFS with memoization of visited states and max moves so far
                # We'll use DFS recursion with memo returning max moves from state.
                from functools import lru_cache
                @lru_cache(maxsize=None)
                def dfs(sizes, used):
                    sizes = list(sizes)
                    best=0
                    # iterate over possible pairs
                    for i in range(1,n+1):
                        if sizes[i]==0: continue
                        for j in range(i+1,n+1):
                            if sizes[j]==0: continue
                            idx = pair_index[(i,j)]
