            import random, math, sys, itertools, collections, copy
            
            def construct_threshold_graph(N):
                caps = [min(i, N-1) for i in range(1,N+1)]
                # order vertices by caps descending, tie-breaking by original index maybe descending?
                order = sorted(range(N), key=lambda x: (-caps[x], -x))  # vertex indices 0..N-1
                # Build adjacency set
                adj = [set() for _ in range(N)]
                for idx,pos in enumerate(order):
                    cap = caps[pos]
                    # connect to first min(cap, idx) earlier vertices in order list
                    num = min(cap, idx)
                    for j in range(num):
                        other = order[j]
                        adj[pos].add(other)
                        adj[other].add(pos)
                return adj
            
            def max_operations_sim(N, max_iter=10000):
                adj = construct_threshold_graph(N)
                # current sizes
                sizes = [i+1 for i in range(N)]  # 1-indexed
                # edges list
                edges = set()
                for i in range(N):
                    for j in adj[i]:
                        if i<j:
                            edges.add((i,j))
                # Greedy simulation
                while edges:
                    # find any edge with gcd=1
                    found = False
                    for (u,v) in list(edges):
                        if math.gcd(sizes[u], sizes[v]) == 1:
                            # perform operation
                            sizes[u] -= 1
                            sizes[v] -= 1
                            edges.remove((u,v))
                            found = True
                            break
                    if not found:
                        # fail
                        return False, sizes, edges
                return True, sizes, edges
            
            def test(N):
                ok, sizes, edges = max_operations_sim(N)
                return ok
            
