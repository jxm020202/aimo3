            import itertools, math
            
            def min_S_bruteforce(n, M):
                minS=10**9
                best_seq=None
                for seq in itertools.product(range(1,M+1), repeat=n):
                    # compute S
                    S=0
                    for i in range(n):
                        a_i=seq[i]
                        a_next=seq[(i+1)%n]
                        S+= a_next//a_i
                    if S<minS:
                        minS=S
                        best_seq=seq
                return minS, best_seq
            
