            def solve_alternating(n, S=1):
                # solve linear system: a_i + a_{i+1} = (-1)**i * S, indices 0..n-1, with a_n = a_0
                # unknowns a_0..a_{n-1}
                A = np.zeros((n, n))
                b = np.zeros(n)
                for i in range(n):
                    A[i, i] = 1
                    A[i, (i+1)%n] = 1
                    b[i] = ((-1)**i) * S
                sol = np.linalg.solve(A, b)
                return sol
            
