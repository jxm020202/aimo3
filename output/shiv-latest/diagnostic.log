            def sqdist(p,q):
                dx = p[0]-q[0]
                dy = p[1]-q[1]
                return dx*dx + dx*dy + dy*dy
            
            def is_collinear(p,q,r):
                # area = (q-p) x (r-p) in 2D coordinates using basis vectors (1,0) and (1/2, sqrt(3)/2)
                # But we can compute using coordinates in (i,j) representation: area proportional to determinant of vectors in basis.
                # In terms of (i,j) coordinates, the mapping to Euclidean is (x = i + j/2, y = (sqrt3/2)*j)
                # The area (twice) = | (x2-x1)*(y3-y1) - (x3-x1)*(y2-y1) |
                # Compute using i,j directly:
                # x = i + j/2, y = sqrt3/2 * j
                # So we can compute determinant ignoring sqrt3 factor:
                # Let u = (dx1 + dy1/2, dy1), v = (dx2 + dy2/2, dy2) where dy is j difference, dx is i difference.
                # The cross product (2D) = (dx1 + dy1/2)*dy2 - (dx2 + dy2/2)*dy1
                # Multiply by 2 to avoid fractions: (2*dx1 + dy1)*dy2 - (2*dx2 + dy2)*dy1
                # If this equals 0, points are collinear.
                x1,y1 = p
                x2,y2 = q
                x3,y3 = r
                dx1 = x2-x1
                dy1 = y2-y1
                dx2 = x3-x1
                dy2 = y3-y1
                val = (2*dx1 + dy1)*dy2 - (2*dx2 + dy2)*dy1
                return val == 0
            
            def is_isosceles(p,q,r):
                # check non-collinear
                if is_collinear(p,q,r):
                    return False
                d1 = sqdist(p,q)
                d2 = sqdist(q,r)
                d3 = sqdist(r,p)
                # check any two equal
                return d1==d2 or d2==d3 or d1==d3
            
