                # Use sign changes on a fine grid
                thetas = np.linspace(0, 2*math.pi, 1001)
                vals = [g(phi, th) for th in thetas]
                zeros = []
                for i in range(len(thetas)-1):
                    if vals[i]==0:
                        zeros.append(thetas[i])
                    elif vals[i]*vals[i+1] < 0:
                        # bracket root, use bisection
                        a, b = thetas[i], thetas[i+1]
                        fa, fb = vals[i], vals[i+1]
                        for _ in range(30):
                            m = (a+b)/2
                            fm = g(phi, m)
                            if fa*fm <= 0:
                                b, fb = m, fm
                            else:
                                a, fa = m, fm
                        zeros.append((a+b)/2)
                return zeros
            
