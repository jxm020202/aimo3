            import math, itertools, fractions, sys, random
            def max_product_for_n(n):
                # a_i = 2i-1 for i=1..n
                a = [2*i-1 for i in range(1, n+1)]
                best = 0
                best_pair = None
                best_t = None
                for i in range(n):
                    for j in range(i, n):
                        a1 = a[i]
                        a2 = a[j]
                        # if i==j, product always 1 regardless of t (since both same)
                        # but we can ignore.
                        # For i != j, we can treat t weight on a1, (1-t) on a2.
                        # F(t) = (t a1 + (1-t) a2)*(t / a1 + (1-t)/a2)
                        # This is quadratic in t; we can find maximum analytically.
                        # Let's compute derivative and solve.
                        # Use sympy for exact rational.
                        t = sp.symbols('t', real=True)
                        F = (t*a1 + (1-t)*a2)*(t/sp.Integer(a1) + (1-t)/sp.Integer(a2))
                        dF = sp.diff(F, t)
                        # Solve dF=0 for t in [0,1]
                        sol = sp.solve(sp.Eq(dF, 0), t)
                        # sol may include rational expression.
                        for s in sol:
                            if s.is_real:
                                s_val = float(s)
                                if s_val >= -1e-9 and s_val <= 1+1e-9:
                                    val = float(F.subs(t, s))
                                    if val > best:
                                        best = val
                                        best_pair = (a1, a2)
                                        best_t = s_val
                        # also check endpoints
                        for s_val in [0.0, 1.0]:
                            val = float(F.subs(t, s_val))
                            if val > best:
                                best = val
                                best_pair = (a1, a2)
                                best_t = s_val
                return best, best_pair, best_t
            
            for n in range(2, 10):
                best, pair, t = max_product_for_n(n)
                print(n, best, pair, t)
            
