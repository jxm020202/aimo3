            def random_point_numpy():
                # sample from normal distribution
                xs = np.random.normal(size=9)
                # shift to sum 1
                xs = xs - np.mean(xs) + 1/9  # because mean = sum/9, we want sum=1 => adjust each by (1/9 - current mean)
                xs.sort()
                return xs
            
            def expr_np(xs):
                x5 = xs[4]
                A = np.abs(xs - x5).sum()
                C = (xs*xs).sum()
                B = 9*C - 1
                return (A*A * B) / (C**3)
            
            def random_search(N):
