            def total_cap_func(N):
                # compute caps as min(i, C_i)
                pf = [[] for _ in range(N+1)]
                for p in range(2, N+1):
                    if not pf[p]:
                        for mult in range(p, N+1, p):
                            pf[mult].append(p)
                def coprime_count(i):
                    if i == 1:
                        return N-1
                    primes = pf[i]
                    total = N
                    m = len(primes)
                    for mask in range(1, 1<<m):
                        mult = 1
                        bits = 0
                        for idx in range(m):
                            if mask>>idx & 1:
                                mult *= primes[idx]
                                bits += 1
                        term = N // mult
                        if bits % 2 == 1:
                            total -= term
                        else:
                            total += term
                    return total
                caps = [0]*(N+1)
                for i in range(1, N+1):
                    C = coprime_count(i)
                    caps[i] = min(i, C) if i < N else min(N-1, C)
                return sum(caps)
            
