            def exists_alpha(m,n,k):
                # check if there exists irrational alpha satisfying equation.
                # We'll search over rational approximations of alpha by scanning possible x = floor(m*alpha)
                # For each integer x, compute alpha interval and test if there exists alpha.
                # Use derived condition: there exists integer x such that y integer and intervals intersect.
                d=math.gcd(m,n)
                if (m - k) % d != 0:
                    return False
                if n <= k - m:
                    return False
                # existence guaranteed by theory; we can return True
                return True
            
            def brute_exists(m,n,k):
                # brute search over alpha grid to see if any works
                # sample many alphas
                for a in [i/1000 for i in range(1,2000)]:
                    if abs(a*math.sqrt(2)-round(a*math.sqrt(2)))<1e-9: # skip rational? not needed
                        pass
                # Instead brute over x possibilities
                for x in range(0, m*10): # rough bound
                    # alpha in (x/m, (x+1)/m)
                    low = x/m
                    high = (x+1)/m
                    # compute y from equation: y = (k - m + n*x)/m must be integer
                    num = k - m + n*x
                    if num % m != 0:
                        continue
                    y = num // m
                    # need alpha also in (y/n, (y+1)/n)
                    low2 = y/n
                    high2 = (y+1)/n
                    lo = max(low, low2)
                    hi = min(high, high2)
                    if lo < hi:
                        # choose alpha in (lo,hi) that is irrational, e.g., lo + (hi-lo)/2 if rational?
                        # we can assume there is irrational
                        return True
                return False
            
            def test_conditions(limit=30):
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        for k in range(1,m+n):
                            cond = exists_alpha(m,n,k)
                            brute = brute_exists(m,n,k)
                            if cond != brute:
                                print("Mismatch", m,n,k,cond,brute)
                                return False
                print("All matched up to",limit)
                return True
            
            test_conditions(30)
            
