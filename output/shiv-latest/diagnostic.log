            def max_edges_via_EG(n):
                caps = caps_desc(n)
                total = sum(caps)
                # compute prefix sums
                prefix = [0]
                for c in caps:
                    prefix.append(prefix[-1] + c)
                max_excess = 0
                for k in range(1, n+1):
                    L = prefix[k]
                    # compute RHS: k(k-1) + sum_{i=k+1}^n min(caps_i, k)
                    # Since caps are descending, for i>k, caps_i <= caps_k (which is <= n-1)
                    # min(caps_i, k) = caps_i if caps_i <= k else k
                    # caps_i for i>k are decreasing from caps_{k+1} downwards.
                    # We can compute efficiently.
                    # Let's compute sum_min = sum(min(c, k) for c in caps[k:])
                    sum_min = 0
                    for c in caps[k:]:
                        sum_min += c if c <= k else k
                    R = k*(k-1) + sum_min
                    excess = L - R
                    if excess > max_excess:
                        max_excess = excess
                # total reduction needed = max_excess (since we can reduce degrees among first k)
                feasible_total = total - max_excess
                # ensure even
                if feasible_total % 2 == 1:
                    feasible_total -= 1
                return feasible_total // 2, max_excess, feasible_total
            
