            def generate_x(N, start=1, end=None):
                # start and end are vertex indices (odd)
                # assume start=1, end=N for now
                x = [0]*(N+1)
                # we will compute sequentially using parity constraints
                # we need to know which vertices are start/end
                start_odd = start
                end_odd = end if end is not None else N
                # set x[0]=0
                # Determine x[1] from start constraint
                # start odd: x0 + x1 ≡ 1 (mod 4)
                # minimal nonnegative solution: x1 = 1
                x[1] = 1
                for i in range(2, N+1):
                    # Determine parity constraint for vertex i
                    if i == start_odd:
                        # start odd (but only i=1)
                        target_mod = 1
                    elif i == end_odd:
                        # end odd
                        target_mod = 1
                    elif i % 2 == 1:
                        # odd non-start/end
                        target_mod = 2
                    else:
                        # even non-start/end
                        target_mod = 0
                    # Need x_{i-1} + x_i ≡ target_mod (mod 4)
                    prev = x[i-1]
                    # Choose minimal nonnegative x_i satisfying (prev + x_i) %4 = target_mod
                    # x_i = (target_mod - prev) mod 4, but we can add multiples of 4 to keep nonnegative
                    needed = (target_mod - prev) % 4
                    # minimal nonnegative needed is in {0,1,2,3}
                    x[i] = needed
                return x
            
