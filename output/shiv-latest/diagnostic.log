                    if match_idx is None:
                        raise ValueError("No matching component")
                    used_E[match_idx]=True
                    comp_E = struct_E['components'][match_idx]
                    # Determine rotation to align codes
                    codes_T = comp_T['codes']
                    codes_E = comp_E['codes']
                    L = len(codes_T)
