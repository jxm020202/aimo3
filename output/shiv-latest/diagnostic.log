            def count_regions_planes(plane_list):
                total_regions = 1
                for i, new_plane in enumerate(plane_list):
                    # compute distinct intersection lines with previous planes
                    lines = []
                    for prev_plane in plane_list[:i]:
                        inter = new_plane.intersection(prev_plane)
                        if not inter:
                            continue
                        obj = inter[0]
                        if isinstance(obj, Line3D):
                            # deduplicate lines
                            if not any(obj.equals(l) for l in lines):
                                lines.append(obj)
                    # Now count regions on new plane formed by these lines
                    # We'll process lines incrementally, counting distinct intersection points
                    added_lines = []
                    line_regions = 0
                    for line in lines:
                        # compute distinct intersection points with previously added lines
                        points = []
                        for l2 in added_lines:
                            inter = line.intersection(l2)
                            if inter:
                                # intersection could be a point
                                if isinstance(inter[0], sp.geometry.point.Point3D):
                                    pt = inter[0]
                                    # deduplicate points
                                    if not any(pt.equals(p) for p in points):
                                        points.append(pt)
                        # number of distinct intersection points on this line
                        k = len(points)
                        line_regions += k + 1
                        added_lines.append(line)
                    new_regions = 1 + line_regions  # base region
                    total_regions += new_regions
                return total_regions
            
