            import random, math
            
            def max_in_interval(angles, interval=100):
                # angles in degrees [0,360)
                angles = sorted(angles)
                n=len(angles)
                # duplicate with +360 for wrap-around
                ext = angles + [a+360 for a in angles]
                maxcnt=0
                j=0
                for i in range(n):
                    while j < i+n and ext[j] - ext[i] <= interval + 1e-9:
                        j+=1
                    cnt=j-i
                    if cnt>maxcnt:
                        maxcnt=cnt
                return maxcnt
            
            def total_sum(points):
                total=0
                for i,(xi,yi) in enumerate(points):
