            def brute_max(n, step=0.01):
                # iterate over grid values for each variable, but that's huge. Instead we can enumerate combos of counts of 2 and -1 etc.
                # Let's search over possible counts of 2 (p) and -1 (r) and maybe -2 (q) and compute last variable.
                best = -1e9
                best_tuple = None
                for p in range(n+1):
                    for r in range(n-p+1):
                        for q in range(n-p-r+1):
                            # remaining variables s = n - p - r - q
                            s = n - p - r - q
                            # we can assign remaining s variables to some value t (same for all) to satisfy sum zero.
                            # sum linear: 2p + (-1)*r + (-2)*q + t*s = 0 => t = -(2p - r - 2q)/s if s>0 else need sum zero exactly.
                            if s == 0:
                                if 2*p - r - 2*q == 0:
