            def construct_max_edges(n):
                # caps: i for i=1..n-1, n-1 for i=n
                caps = [i for i in range(1, n)] + [n-1]
                # We'll use a priority queue (max-heap) of (remaining degree, vertex)
                import heapq
                # Use negative for max-heap
                heap = [(-deg, v) for v, deg in enumerate(caps)]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    deg_u, u = heapq.heappop(heap)
                    deg_u = -deg_u
                    if deg_u == 0:
                        # all remaining have zero degree
                        break
                    # Need to connect u to deg_u other vertices with highest remaining degree
                    # Pop next deg_u vertices
                    temp = []
                    for _ in range(deg_u):
                        if not heap:
                            # cannot satisfy, break
                            # we will reduce deg_u to len(temp)
                            deg_u = len(temp)
                            break
                        deg_v, v = heapq.heappop(heap)
                        deg_v = -deg_v
                        # connect u-v
                        edges += 1
                        deg_v -= 1
                        temp.append((deg_v, v))
                    # after connecting, u's degree becomes 0 (used all possible)
                    # push back the modified neighbors if they still have degree >0
                    for deg_v, v in temp:
                        heapq.heappush(heap, (-deg_v, v))
                return edges
            
            print(construct_max_edges(10))
            
