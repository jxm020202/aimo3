                if a != 0:
                    pt = sp.Point3D(-d/a, 0, 0)
                elif b != 0:
                    pt = sp.Point3D(0, -d/b, 0)
                elif c != 0:
                    pt = sp.Point3D(0, 0, -d/c)
                else:
