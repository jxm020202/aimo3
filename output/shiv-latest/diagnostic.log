            def verify_solution(selected):
                # selected is list of (typ, r, c)
                # Build occupied set of cells
                occupied = set()
                for typ, r, c in selected:
                    if typ == 'H':
                        occupied.add((r,c))
                        occupied.add((r,c+1))
                    else:
                        occupied.add((r,c))
                        occupied.add((r+1,c))
                # Ensure no overlap
                if len(occupied) != 2*len(selected):
                    return False, "overlap"
                # For each domino, check sliding directions
                for typ, r, c in selected:
                    if typ == 'H':
                        # left
                        if c-1 >= 0:
                            if (r,c-1) not in occupied:
                                return False, f"left slide possible for H at {(r,c)}"
                        # right
                        if c+2 < 7:
                            if (r,c+2) not in occupied:
                                return False, f"right slide possible for H at {(r,c)}"
                        # up
                        if r-1 >= 0:
                            # need both above cells empty for slide
                            if (r-1,c) not in occupied and (r-1,c+1) not in occupied:
                                return False, f"up slide possible for H at {(r,c)}"
                        # down
                        if r+1 < 7:
                            if (r+1,c) not in occupied and (r+1,c+1) not in occupied:
                                return False, f"down slide possible for H at {(r,c)}"
                    else: # V
                        # up
                        if r-1 >= 0:
                            if (r-1,c) not in occupied:
                                return False, f"up slide possible for V at {(r,c)}"
                        # down
                        if r+2 < 7:
                            if (r+2,c) not in occupied:
                                return False, f"down slide possible for V at {(r,c)}"
                        # left
                        if c-1 >= 0:
                            if (r,c-1) not in occupied and (r+1,c-1) not in occupied:
                                return False, f"left slide possible for V at {(r,c)}"
                        # right
                        if c+1 < 7:
                            if (r,c+1) not in occupied and (r+1,c+1) not in occupied:
