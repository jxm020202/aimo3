                cell_to_dominos = {}
                for i, d in enumerate(dominos):
                    typ, r, c = d
                    cells = [(r,c), (r,c+1)] if typ=='H' else [(r,c), (r+1,c)]
                    for cell in cells:
                        cell_to_dominos.setdefault(cell, []).append(i)
                rows = []
                lbs = []
                ubs = []
                # non-overlap constraints: each cell covered at most once
                for r in range(1, n+1):
