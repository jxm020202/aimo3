                total_vars = 2*m
                # objective: maximize sum x - sum t => minimize -sum x + sum t
                c = np.zeros(total_vars)
                c[:m] = -1  # minimize -sum x => maximize sum x
                c[m:] = 1   # minimize + sum t => minimize sum t (since we are minimizing)
