            import networkx as nx
            
            def functional_graph(n, mod, k):
                # returns directed graph of map x -> x^k mod mod, on vertices 1..n (non-zero residues)
                G = nx.DiGraph()
                G.add_nodes_from(range(1, n+1))
                for x in range(1, n+1):
                    y = pow(x, k, mod)
                    # y is in 0..mod-1; need to map 0 to ??? but we only have vertices 1..n
                    # if y==0, then edge goes to node n+1? Not allowed.
                    # For exponentiation map, we consider only mod = n+1, and we need to map to {1..n}
                    # If y == 0, then the map is not within set, thus not a permutation; such n should be excluded.
                    if y == 0:
                        return None
                    G.add_edge(x, y)
                return G
            
            def multiplication_graph(n, a):
                G = nx.DiGraph()
                G.add_nodes_from(range(1, n+1))
                for x in range(1, n+1):
                    y = (a * x) % n
                    if y == 0:
                        y = n
                    G.add_edge(x, y)
                return G
            
            def is_isomorphic(G1, G2):
                # use DiGraphMatcher
                GM = nx.algorithms.isomorphism.DiGraphMatcher(G1, G2)
                return GM.is_isomorphic()
            
