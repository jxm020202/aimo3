            def solutions_for_m(alpha,k,m):
                A=math.floor(m*alpha)
                f=m*alpha - A
                g=math.gcd(A,m)
                # find n0 solving n*A ≡ -k (mod m)
                # Use extended Euclidean to find inverse of A/g modulo m/g
                mod = m//g
                # Solve A/g * n ≡ -k/g (mod mod) if g divides k?
                if k % g != 0:
                    return []  # no solution
                A1 = A//g
                k1 = k//g
                # find inverse of A1 modulo mod
                inv = pow(A1, -1, mod)  # python 3.8 uses pow with mod inverse
                n0 = (-k1 * inv) % mod
                # solutions: n = n0 + t*mod
                low = (k - m)/f
                high = k/f
                sols=[]
                # find t range
                t_min = math.ceil((low - n0)/mod)
                t_max = math.floor((high - n0)/mod)
                for t in range(t_min, t_max+1):
                    n = n0 + t*mod
                    if n>0 and (k-m) < n*f <= k:
                        sols.append(n)
                return sols
            
            alpha=math.sqrt(2)
            k=2310
            for m in range(1,21):
                sols=solutions_for_m(alpha,k,m)
                if sols:
                    print(m, len(sols), sols[:5])
            
