            import cmath, math
            def is_root_of_unity(z, tol=1e-9, max_order=60):
                # check if |z|=1 and argument rational multiple of 2pi with denominator <= max_order
                if abs(abs(z)-1) > tol:
                    return False
                arg = cmath.phase(z)
                if arg < 0:
                    arg += 2*math.pi
                # try orders
                for q in range(1, max_order+1):
                    # find p such that p/q approx arg/(2pi)
                    p = round(arg/(2*math.pi)*q)
                    if p<0: p+=q
                    if abs(arg - 2*math.pi*p/q) < tol:
                        return True
                return False
            
            def find_orders(limit=30):
                res=[]
                for n in range(1,limit+1):
                    for k in range(1,n+1):
                        if math.gcd(k,n)!=1: continue
                        z=cmath.exp(2j*math.pi*k/n)
                        if is_root_of_unity(1+z):
                            res.append((n,k, (1+z)))
                return res
            
