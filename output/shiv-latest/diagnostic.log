            def pretty_condition(m,n,k):
                g=math.gcd(m,n)
                if k%g!=0:
                    return False
                m1=m//g
                n1=n//g
                kg=k//g
                return abs(m1-kg) < min(m1,n1)
            
            def pretty_coprime(k, max_m):
                res=set()
                for m in range(1,max_m+1):
                    for n in range(1,max_m+1):
                        if math.gcd(m,n)!=1:
                            continue
                        if pretty_condition(m,n,k):
                            res.add((m,n))
                return res
            
