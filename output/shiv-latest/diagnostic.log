            def compute_C(n):
                # n odd
                # variables: a[0..n-1], t
                # objective: maximize t
                # constraints: linear inequalities A_ub @ x <= b_ub
                # x = [a0,...,a_{n-1}, t]
                m = n + 1
                # Build constraints
                A = []
                b = []
                # a_i - t <= 0
                for i in range(n):
                    row = [0]*m
                    row[i] = 1
                    row[-1] = -1
                    A.append(row)
                    b.append(0)
                # -a_i - t <= 0
                for i in range(n):
                    row = [0]*m
                    row[i] = -1
                    row[-1] = -1
                    A.append(row)
                    b.append(0)
                # a_i + a_{i+1} <= 1
                for i in range(n):
                    row = [0]*m
                    row[i] = 1
                    row[(i+1)%n] = 1
                    A.append(row)
                    b.append(1)
                # -(a_i + a_{i+1}) <= 1  => -a_i - a_{i+1} <= 1
                for i in range(n):
                    row = [0]*m
                    row[i] = -1
                    row[(i+1)%n] = -1
                    A.append(row)
                    b.append(1)
                # Use linprog to maximize t => minimize -t
                c = [0]*m
                c[-1] = -1  # minimize -t => maximize t
                res = opt.linprog(c, A_ub=A, b_ub=b, bounds=[(None,None)]*m, method='highs')
                if not res.success:
                    print("LP failed", n, res.message)
                    return None
                t_opt = res.x[-1]
                # Since we maximize t, t_opt is the optimum.
                # Return t_opt
                return t_opt
            
            for n in [3,5,7,9,11,13,15]:
                t_opt = compute_C(n)
                print(n, t_opt)
            
