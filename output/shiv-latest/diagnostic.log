            def inv_formula(n):
                # Build S
                S = np.zeros((n,n))
                for i in range(n):
                    S[i,(i+1)%n]=1
                # compute sum_{k=0}^{n-1} (-S)^k
                sum_mat = np.zeros((n,n))
                cur = np.eye(n)
                for k in range(n):
