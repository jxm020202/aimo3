            def max_edges_greedy(n):
                # caps: for i=1..n-1 cap=i, for i=n cap=n-1
                rem = [0]*(n+1)  # 1-indexed
                for i in range(1, n):
                    rem[i] = i
                rem[n] = n-1
                edges = 0
                # We'll maintain a list of vertices with remaining capacity
                # For simplicity O(n^2) loops
                for i in range(n, 0, -1):
                    while rem[i] > 0:
                        # find j < i with rem[j] > 0
                        # choose the smallest j (or any)
                        found = False
                        for j in range(i-1, 0, -1):
                            if rem[j] > 0:
