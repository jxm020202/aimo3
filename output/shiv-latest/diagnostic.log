            start_time = time.time()
            TIME_LIMIT = 25  # seconds
            
            def max_clique(R_bits, P_bits, X_bits):
                global best_size, best_clique_bits, start_time
                # time check
                if time.time() - start_time > TIME_LIMIT:
                    raise TimeoutError
                # bound
                r_size = R_bits.bit_count()
                p_size = P_bits.bit_count()
                if r_size + p_size <= best_size:
                    return
                if P_bits == 0 and X_bits == 0:
                    # maximal clique
                    if r_size > best_size:
                        best_size = r_size
                        best_clique_bits = R_bits
                    return
                # choose pivot u from P|X maximizing |P & N(u)|
                union = P_bits | X_bits
                # find pivot
                max_deg = -1
                u = None
                while union:
                    # extract a vertex
                    v = (union & -union).bit_length() - 1
                    deg = (P_bits & adj_bits[v]).bit_count()
                    if deg > max_deg:
                        max_deg = deg
                        u = v
                    union &= union - 1  # remove lsb
                # candidates = P \ N(u)
                if u is not None:
                    candidates = P_bits & ~adj_bits[u]
                else:
                    candidates = P_bits
                while candidates:
                    v = (candidates & -candidates).bit_length() - 1
                    # recursive call
                    max_clique(R_bits | (1<<v), P_bits & adj_bits[v], X_bits & adj_bits[v])
                    # move v from P to X
                    P_bits &= ~(1<<v)
                    X_bits |= (1<<v)
                    candidates &= ~(1<<v)
            
