            def count_good_pairs(p):
                # compute set S of Q(x,y) for distinct x,y in F_p
                S=set()
                for x in range(p):
                    for y in range(p):
                        if x!=y:
                            Q = (x*x + x*y + y*y) % p
                            S.add(Q)
                good_c = [c for c in range(p) if c not in S]
                # count of good c
                num_good_c = len(good_c)
