            def nullspace_mod2(matrix):
                # matrix: list of rows (list of ints 0/1)
                m = [row[:] for row in matrix]  # copy
                n_rows = len(m)
                n_cols = len(m[0]) if n_rows>0 else 0
                # Perform Gaussian elimination to row-echelon form, track pivot columns
                pivot_cols = []
                row = 0
                for col in range(n_cols):
                    # find pivot row with 1 in this column at or below current row
                    pivot = None
                    for r in range(row, n_rows):
                        if m[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row up
                    m[row], m[pivot] = m[pivot], m[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(n_rows):
                        if r != row and m[r][col]:
                            m[r] = [(a ^ b) for a,b in zip(m[r], m[row])]
                    row += 1
                    if row == n_rows:
                        break
                # Now we have row-echelon form with pivots pivot_cols.
                # Determine free columns
                free_cols = [c for c in range(n_cols) if c not in pivot_cols]
                basis = []
                # For each free variable, set it to 1 and others to 0, solve for pivot variables.
