            def root_phi_by_bisection(theta, N=200):
                # sample phi values
                phi_vals = np.linspace(0, math.pi, N)
                f_vals = [F(theta, phi) for phi in phi_vals]
                roots = []
                for i in range(N-1):
                    if f_vals[i] == 0:
                        roots.append(phi_vals[i])
                    elif f_vals[i]*f_vals[i+1] < 0:
                        # bracket found, use bisection
                        a, b = phi_vals[i], phi_vals[i+1]
                        fa, fb = f_vals[i], f_vals[i+1]
                        for _ in range(40):
                            m = (a+b)/2
                            fm = F(theta, m)
                            if fa*fm <= 0:
                                b = m
                                fb = fm
                            else:
                                a = m
                                fa = fm
                        roots.append((a+b)/2)
                return roots
            
            theta_grid = np.linspace(0, 2*math.pi, 200)
            solutions = []
            for th in theta_grid:
                roots = root_phi_by_bisection(th)
                if roots:
                    solutions.append((th, roots))
            len(solutions)
            
