            def bron_kerbosch(R, P, X, adj, max_clique):
                # R: current clique (set)
                # P: prospective vertices (set)
                # X: excluded vertices (set)
                # adj: adjacency list (list of sets)
                # max_clique: list containing best clique found so far (as mutable)
                if not P and not X:
                    # found maximal clique
                    if len(R) > len(max_clique[0]):
                        max_clique[0] = R.copy()
                    return
                # choose pivot u from P ∪ X with max degree in P
                # simple heuristic: choose vertex with max len(P ∩ N(u))
                u = max(P.union(X), key=lambda v: len(P.intersection(adj[v]))) if P.union(X) else None
                for v in list(P - adj[u] if u is not None else P):
                    bron_kerbosch(R.union({v}), P.intersection(adj[v]), X.intersection(adj[v]), adj, max_clique)
                    P.remove(v)
                    X.add(v)
            
