            def max_achievable_sum(n):
                caps = [i for i in range(1,n)] + [n-1]
                caps_sorted = sorted(caps, reverse=True)
                total = sum(caps_sorted)
                max_excess = 0
                prefix = [0]
                for d in caps_sorted:
                    prefix.append(prefix[-1] + d)
                for k in range(1, n+1):
                    left = prefix[k]
                    # compute right
                    # sum_{i=k+1}^n min(d_i, k)
                    right_sum = 0
                    for d in caps_sorted[k:]:
