            def min_subset_size(p):
                roots=primitive_roots(p)
                target=p-1
                # search increasing size up to maybe 7? but exhaustive for size up to maybe 6 for larger p is huge.
                # We'll use heuristic random search for larger p.
                for size in range(1, len(roots)+1):
                    # limit combinations count
                    comb_count = math.comb(len(roots), size)
                    if comb_count > 200000:
                        # skip exhaustive, use random trials
                        for _ in range(20000):
