            def max_edges_under_bounds(N):
                caps=[min(i, N-1) for i in range(1,N+1)]  # 0-indexed list for vertices 1..N
                # We'll try to construct graph using greedy: sort vertices by remaining cap descending
                # Use simple algorithm: while there are at least two vertices with remaining cap >0, connect them if not already connected.
                adj=[set() for _ in range(N)]
                caps_remaining=caps[:]
                # Use list of vertices sorted by remaining cap each iteration
                while True:
                    # get vertices with remaining cap >0
                    verts=[i for i in range(N) if caps_remaining[i]>0]
                    if len(verts)<2:
                        break
                    # sort descending by remaining cap
                    verts.sort(key=lambda x: caps_remaining[x], reverse=True)
                    # pick first vertex u
                    u=verts[0]
                    # find a vertex v among others not already adjacent to u with caps>0
                    found=False
                    for v in verts[1:]:
                        if v not in adj[u]:
                            # connect u-v
                            adj[u].add(v)
                            adj[v].add(u)
                            caps_remaining[u]-=1
                            caps_remaining[v]-=1
                            found=True
                            break
                    if not found:
                        # cannot find partner, break
                        break
                total_edges=sum(len(s) for s in adj)//2
                total_degree=sum(caps_remaining[i] for i in range(N))
                return total_edges, caps_remaining, caps
            
            for N in range(5,15):
                edges, caps_rem, caps = max_edges_under_bounds(N)
                print(N, edges, sum(caps)-2*edges)
            
