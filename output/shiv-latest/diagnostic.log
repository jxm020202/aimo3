            def subset_counts(m):
                # r_k = primitive (m+1)-th root of unity, exponents 1..m
                # Count number of subsets (including empty) whose sum of exponents mod (m+1) equals j
                from collections import Counter
                cnt = Counter()
                for mask in range(1<<m):
                    s = 0
                    for i in range(m):
                        if mask>>i & 1:
                            s += i+1  # exponent i+1
                    cnt[s % (m+1)] += 1
                return cnt
            
            for m in range(1,7):
                cnt = subset_counts(m)
                print(m, cnt)
            
