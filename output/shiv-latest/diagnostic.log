            def max_clique_branch_and_bound(G):
                # adjacency list as sets for fast intersection
                adj = {v: set(G[v]) for v in G.nodes()}
                best_clique = []
                # order vertices by degree descending maybe
                # Use recursive function
                def expand(R, P):
                    nonlocal best_clique
                    # R: current clique (list)
                    # P: candidate vertices (set)
                    if not P:
                        if len(R) > len(best_clique):
                            best_clique = R[:]
                        return
                    # bound
                    if len(R) + len(P) <= len(best_clique):
                        return
                    # Choose a pivot (Tomita algorithm) to reduce branching
                    # pivot u from P ∪ X (X not needed here)
                    # For simplicity, choose vertex with max degree in P
                    # Actually we can iterate over a copy of P sorted
                    # We'll use simple ordering
                    # Convert P to list for iteration
                    for v in list(P):
                        # prune if cannot beat best
                        if len(R) + len(P) <= len(best_clique):
                            return
                        # add v to R
                        R.append(v)
                        # new candidates = P ∩ N(v)
                        newP = P.intersection(adj[v])
                        expand(R, newP)
                        R.pop()
                        P.remove(v)
                # initial call
                expand([], set(G.nodes()))
                return best_clique
            
            start = time.time()
            best = max_clique_branch_and_bound(G)
            print("max clique size:", len(best), "time:", time.time()-start)
            
