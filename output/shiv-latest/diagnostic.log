            import numpy as np
            
            def compute_ratio(n):
                # Build T = I + shift
                T = np.zeros((n,n))
                for i in range(n):
                    T[i,i] = 1
                    T[i,(i+1)%n] = 1
                # compute inverse
                invT = np.linalg.inv(T)
                # define b = (-1)^i (i from 0)
                b = np.array([(-1)**i for i in range(n)], dtype=float)
                a = invT @ b
                max_a = np.max(np.abs(a))
                # compute sums
                sums = np.array([a[i] + a[(i+1)%n] for i in range(n)])
                max_sum = np.max(np.abs(sums))
                return max_a, max_sum, max_a/max_sum
            
            for n in [3,5,7,9,11]:
                print(n, compute_ratio(n))
            
