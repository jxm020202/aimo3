            def construct_graph(n):
                edges = set()
                for i in range(1, n+1):
                    # connect i to i largest j > i
                    # j from n down to i+1, take first i of them
                    cnt = 0
                    for j in range(n, i, -1):
                        if cnt >= i:
                            break
                        # add edge (i,j)
                        edges.add((i,j))
                        cnt += 1
                # compute degrees
                deg = [0]*(n+1)
                for (i,j) in edges:
                    deg[i] += 1
                    deg[j] += 1
                return edges, deg[1:]
            
