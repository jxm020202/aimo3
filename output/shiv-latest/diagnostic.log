            import sympy as sp
            def solve_uv(u, v, rhs):
                # solve u*B - v*A = rhs for integers A,B
                B, A = sp.symbols('B A', integer=True)
                sol = sp.diophantine(u*B - v*A - rhs)
                # returns set of solutions parametric
                # we can get one solution by extracting first
                for s in sol:
                    return s
                return None
            
            def get_one_solution(u,v,rhs):
                B, A = sp.symbols('B A', integer=True)
                # use extended Euclid manually
                g = math.gcd(u,v)
                assert g==1
                # find x,y such that u*x + v*y = 1
                x, y = sp.gcdex(u, v)[:2]  # returns (s, t, g) where s*u + t*v = g
                # Actually sp.gcdex returns (s,t,g)
                s, t, g = sp.gcdex(u, v)
                # So s*u + t*v = g =1
                # We need u*B - v*A = rhs
                # Let B0 = s*rhs, A0 = -t*rhs
                B0 = s*rhs
                A0 = -t*rhs
                return int(A0), int(B0)
            
            def compute_t(alpha, m, n, k):
                d = math.gcd(m,n)
                u = m//d
                v = n//d
                A = math.floor(m*alpha)
                B = math.floor(n*alpha)
                Kd = k//d
                rhs = Kd - u
                A0, B0 = get_one_solution(u, v, rhs)
                # general solution: A = A0 + u*t, B = B0 + v*t
                # compute t from actual A
                t = (A - A0)//u
                return t
            
