            def solve_milp():
                T = 1997
                n_a = 38
                n_P = 38
                n_u = 37
                n_X = 1
                n = n_a + n_P + n_u + n_X
                idx_a = 0
                idx_P = idx_a + n_a
                idx_u = idx_P + n_P
                idx_X = idx_u + n_u
                
                A_rows = []
                lb = []
                ub = []
                
                # a_{i+1} - a_i >= 1 -> a_i - a_{i+1} <= -1
                for i in range(n_a-1):
                    row = np.zeros(n)
                    row[idx_a + i] = 1
                    row[idx_a + i + 1] = -1
                    A_rows.append(row)
                    lb.append(-np.inf)
                    ub.append(-1)
                
                # Prefix sum constraints
                for k in range(1, n_P+1):
                    row = np.zeros(n)
                    row[idx_P + k - 1] = 1   # P_k
                    if k > 1:
                        row[idx_P + k - 2] = -1  # -P_{k-1}
                    row[idx_a + k - 1] = -1   # -a_k
                    A_rows.append(row)
                    lb.append(0)
                    ub.append(0)
                
                # P_38 = T
                row = np.zeros(n)
                row[idx_P + n_P - 1] = 1
                A_rows.append(row)
                lb.append(T)
                ub.append(T)
                
                M = T
                # min condition constraints using binary u_k
                for k in range(1, n_u+1):
                    # P_k <= X + M*u_k
                    row = np.zeros(n)
                    row[idx_P + k - 1] = 1
                    row[idx_X] = -1
                    row[idx_u + k - 1] = -M
                    A_rows.append(row)
                    lb.append(-np.inf)
                    ub.append(0)
                    # T - P_k <= X + M*(1 - u_k)
                    row2 = np.zeros(n)
                    row2[idx_P + k - 1] = -1  # -P_k
                    row2[idx_X] = -1          # -X
                    row2[idx_u + k - 1] = M   # M*u_k
                    A_rows.append(row2)
                    lb.append(-np.inf)
                    ub.append(0)
                
                A = sp.csc_array(np.vstack(A_rows))
                lb = np.array(lb, dtype=float)
                ub = np.array(ub, dtype=float)
                
                # Bounds
                lower_bounds = np.zeros(n)
                upper_bounds = np.full(n, np.inf)
                # a_i >= 1
                lower_bounds[idx_a: idx_a + n_a] = 1
                # u binary 0-1
                lower_bounds[idx_u: idx_u + n_u] = 0
                upper_bounds[idx_u: idx_u + n_u] = 1
                # X >= 0
                lower_bounds[idx_X] = 0
                upper_bounds[idx_X] = T
                
                bounds = Bounds(lower_bounds, upper_bounds)
                
                integrality = np.ones(n, dtype=int)  # all integer
                # objective minimize X
                c = np.zeros(n)
                c[idx_X] = 1
                
                constraints = LinearConstraint(A, lb, ub)
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
