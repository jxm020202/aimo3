            import cmath, itertools, math
            
            def primitive_roots(p):
                roots=[]
                for k in range(1,p):
                    if math.gcd(k,p)==1:
                        roots.append(cmath.exp(2j*math.pi*k/p))
                return roots
            
            def product_one(roots, m):
                for t in range(1,m+1):
                    prod=1+0j
                    for r in roots:
                        prod*= (r**t + 1)
                    if abs(prod-1)>1e-6:
                        return False
                return True
            
