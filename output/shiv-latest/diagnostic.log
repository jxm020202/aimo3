                                new_sizes = list(sizes)
                                new_sizes[i]-=1
                                new_sizes[j]-=1
                                new_used = used | (1<<idx)
                                moves = 1 + dfs(tuple(new_sizes), new_used)
                                if moves>best:
                                    best=moves
                    return best
                return dfs(start_sizes, start_used)
            
