            import itertools
            
            def hypercube_edges(n):
                edges = []
                for v in range(2**n):
                    for k in range(n):
                        u = v ^ (1<<k)
                        if v < u:
                            edges.append((v,u,k))
                return edges
            
            def neighbors(v,n):
                return [(v ^ (1<<k), k) for k in range(n)]
            
            def all_hamiltonian_paths(n):
                start = 0
                N = 2**n
                visited = [False]*N
                path = [start]
                visited[start]=True
                results=[]
                def dfs(current):
                    if len(path)==N:
                        results.append(list(path))
                        return
                    for nb,k in neighbors(current,n):
                        if not visited[nb]:
                            visited[nb]=True
                            path.append(nb)
                            dfs(nb)
                            path.pop()
                            visited[nb]=False
                dfs(start)
                return results
            
            def edge_counts(path,n):
                counts=[0]*n
                for i in range(1,len(path)):
                    diff = path[i] ^ path[i-1]
                    k = diff.bit_length()-1
                    counts[k]+=1
                return counts
            
            def enumerate_counts(n):
                paths = all_hamiltonian_paths(n)
                cnts=set()
                for p in paths:
