            def verify_solution(selected_indices):
                # Build occupancy map
                occupied = {}
                for idx in selected_indices:
                    for cell in dominos[idx]['cells']:
                        if cell in occupied:
                            # overlap
                            return False, f"Overlap at {cell}"
                        occupied[cell] = idx
                # For each domino, check sliding directions
                for idx in selected_indices:
                    d = dominos[idx]
