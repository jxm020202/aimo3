            def Krawtchouk(j, i, n=6, q=3):
                total = 0
                for h in range(0, j+1):
                    if h > i: continue
                    if j-h > n-i: continue
                    term = ((-1)**h) * ((q-1)**(j-h)) * math.comb(i, h) * math.comb(n-i, j-h)
                    total += term
                return total
            
            # compute table
            K = [[Krawtchouk(j,i) for i in range(7)] for j in range(7)]
            K
            
