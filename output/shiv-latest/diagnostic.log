            def max_edges_with_caps(n):
                # caps list: index 1..n
                caps = [min(i, n-1) for i in range(1, n+1)]
                # sort descending
                caps.sort(reverse=True)
                # We'll use Havel-Hakimi to construct a graphic sequence as close as possible to caps.
                # We'll try to keep sum even.
                # Use a list of degrees that we will adjust.
                deg = caps[:]  # copy
                # We'll implement a loop that reduces degrees when needed.
                # We'll use a while loop: while any degree > 0
                # Use a priority queue (max-heap) for efficiency.
                import heapq
                # Use negative values for max-heap
                heap = [-d for d in deg if d>0]
                heapq.heapify(heap)
                total_edges = 0
                while heap:
                    d = -heapq.heappop(heap)
                    if d == 0:
                        continue
                    if d > len(heap):
                        # cannot satisfy, need to reduce d to len(heap)
                        # reduce d to len(heap)
                        d = len(heap)
                    # connect to next d vertices: pop d largest
                    temp = []
                    for _ in range(d):
                        if not heap:
                            # not enough vertices, break
                            break
                        nd = -heapq.heappop(heap)
                        nd -= 1
                        total_edges += 1  # each connection adds one edge
                        if nd > 0:
                            temp.append(-nd)
                    # push back the modified vertices
                    for val in temp:
                        heapq.heappush(heap, val)
                    # after connecting, d becomes 0 (since we used all its degree)
                    # continue
                return total_edges
            
