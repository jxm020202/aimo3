            import itertools
            
            def max_edges_bruteforce(n):
                caps = list(range(1,n)) + [n-1]
                max_e=0
                best=None
                vertices = list(range(n))
                all_edges = list(itertools.combinations(vertices,2))
                for r in range(len(all_edges)+1):
                    for comb in itertools.combinations(all_edges, r):
                        deg=[0]*n
                        ok=True
                        for (u,v) in comb:
                            deg[u]+=1
                            deg[v]+=1
                            if deg[u]>caps[u] or deg[v]>caps[v]:
                                ok=False
                                break
                        if ok:
                            if r>max_e:
