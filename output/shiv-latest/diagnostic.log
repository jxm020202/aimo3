                        lb.append(-np.inf)
                        ub.append(1)
                        constraint_count += 1
            
                # Blocking constraints
                for idx, p in enumerate(placements):
                    typ = p['type']
                    r,c = p['pos']
                    # define directions list of required cells sets
                    dirs = []
                    if typ == 'H':
                        # left
                        if c-1 >= 0:
                            dirs.append([(r,c-1)])  # single cell
                        # right
                        if c+2 < C:
                            dirs.append([(r,c+2)])
                        # up (two cells)
                        if r-1 >= 0:
                            dirs.append([(r-1,c), (r-1,c+1)])  # set of two cells
                        # down
                        if r+1 < R:
                            dirs.append([(r+1,c), (r+1,c+1)])
                    else: # V
                        # up
                        if r-1 >= 0:
                            dirs.append([(r-1,c)])
                        # down
                        if r+2 < R:
                            dirs.append([(r+2,c)])
                        # left (two cells)
                        if c-1 >= 0:
                            dirs.append([(r,c-1), (r+1,c-1)])
                        # right (two cells)
                        if c+1 < C:
                            dirs.append([(r,c+1), (r+1,c+1)])
                    # For each direction, create constraint sum_{j covering any required cell} >= x_i
                    for cell_set in dirs:
                        # Build row: +1 for each placement covering any cell in cell_set
                        # We'll use a set to avoid duplicate columns if a placement covers both cells (possible? only if placement spans both cells, but that would be overlapping with domino? Could happen if cell_set contains two cells that are adjacent and a placement covering both (i.e., a domino) could cover both cells. That's allowed as long as it doesn't overlap with i (i covers different cells). So we can include each placement once per row; if a placement covers both cells, we still add coefficient +1 (not +2). So we need to avoid double counting.
                        # We'll collect unique placement indices covering any cell in cell_set.
                        covering = set()
                        for cell in cell_set:
                            covering.update(cell_to_placements.get(cell, []))
                        # Add coefficients
                        for j in covering:
                            data.append(1)
                            row_ind.append(constraint_count)
                            col_ind.append(j)
                        # subtract x_i
                        data.append(-1)
                        row_ind.append(constraint_count)
                        col_ind.append(idx)
                        # bounds: >=0
                        lb.append(0)
                        ub.append(np.inf)
                        constraint_count += 1
            
                # Add at least one domino constraint later externally
                A = csr_matrix((data, (row_ind, col_ind)), shape=(constraint_count, n))
                return A, lb, ub, constraint_count
            
            A, lb, ub, cons_cnt = build_ilp()
