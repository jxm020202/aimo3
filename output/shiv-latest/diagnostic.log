            from functools import lru_cache
            import itertools
            
            def max_ops(n):
                # initial counts tuple
                init = tuple(range(1, n+1))
                # all possible pairs (i,j) with i<j
                pairs = [(i, j) for i in range(n) for j in range(i+1, n)]
                # Represent used pairs as bitmask of length len(pairs)
                pair_index = {pair: idx for idx, pair in enumerate(pairs)}
                total_pairs = len(pairs)
                @lru_cache(maxsize=None)
                def dfs(counts, used_mask):
                    best = 0
                    # iterate over possible pairs not used
                    for (i,j) in pairs:
                        idx = pair_index[(i,j)]
                        if used_mask & (1<<idx):
                            continue
                        a = counts[i]
                        b = counts[j]
                        if a==0 or b==0:
                            continue
                        d = math.gcd(a,b)
                        # remove d from each
                        new_counts = list(counts)
                        new_counts[i] -= d
                        new_counts[j] -= d
                        new_counts = tuple(new_counts)
                        new_mask = used_mask | (1<<idx)
                        best = max(best, 1 + dfs(new_counts, new_mask))
                    return best
                return dfs(init, 0)
            
