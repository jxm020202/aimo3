            def feasible_max_t(signs):
                # variables: x,y,z,t
                # maximize t
                # constraints: for each plane i:
                # if sign=+ : a_i x + b_i y + c_i z + d_i >= t
                # else: a_i x + b_i y + c_i z + d_i <= -t
                # convert to <= form
                A = []
                b = []
                for (a,b_,c,d), s in zip(planes, signs):
                    if s == 1:
                        # -(a x + b y + c z) + t <= -d
                        # rewrite: -a x - b y - c z + 1*t <= -d
                        A.append([-a, -b_, -c, 1])
                        b.append(-d)
                    else:
                        # a x + b y + c z + t <= -d? Wait: a x + b y + c z + d <= -t => a x + b y + c z + t <= -d
                        # Actually inequality: a x + b y + c z + d <= -t => a x + b y + c z + t <= -d
                        A.append([a, b_, c, 1])
                        b.append(-d)
                A = np.array(A, dtype=float)
                b = np.array(b, dtype=float)
                # objective: maximize t => minimize -t
                cvec = np.array([0,0,0,-1], dtype=float)
                # bounds: x,y,z free, t >= 0
                bounds = [(None,None), (None,None), (None,None), (0,None)]
                res = linprog(cvec, A_ub=A, b_ub=b, bounds=bounds, method='highs')
                if not res.success:
                    return False, None
                t_opt = res.x[3]
                return t_opt > 1e-9, t_opt
            
            def count_feasible_max():
                cnt = 0
                for signs in itertools.product([1,-1], repeat=len(planes)):
                    feasible,_ = feasible_max_t(signs)
                    if feasible:
                        cnt += 1
                return cnt
            
