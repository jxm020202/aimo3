                m=n+1
                # find primitive root modulo m (if prime)
                if not sympy.isprime(m):
                    return False
                # find primitive root
                for g in range(2,m):
                    if sympy.n_order(g, m) == n:  # order = phi(m) = n
                        primitive = g
                        break
                else:
