            import itertools
            
            def reachable_sums(n, max_val=4):
                # generate all assignments of values 0..max_val to n*n cells, check constraints
                cells = [(i,j) for i in range(n) for j in range(n)]
                adj = {}
                for i,j in cells:
                    neigh = []
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj = i+di, j+dj
                        if 0 <= ni < n and 0 <= nj < n:
                            neigh.append((ni,nj))
                    adj[(i,j)] = neigh
                sums=set()
                # brute force for small n, small max_val
                for values in itertools.product(range(max_val+1), repeat=n*n):
                    # quick parity check: difference must be exactly 1
                    ok=True
                    for idx, (i,j) in enumerate(cells):
                        v = values[idx]
                        for (ni,nj) in adj[(i,j)]:
                            nidx = cells.index((ni,nj))
                            if abs(v - values[nidx]) != 1:
                                ok=False
                                break
                        if not ok:
                            break
                    if ok:
                        sums.add(sum(values))
                return sorted(sums)
            
