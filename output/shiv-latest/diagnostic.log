            import functools
            
            def last_nonzero_digit_factorial(n):
                # Using recurrence
                # L(0)=1
                # L(n) = L(n//5) * L(n%5) * 2^{n//5} mod 10
                # L(0..4) = [1,1,2,6,4]
                if n==0:
                    return 1
                # recursion
                # Use memoization
                @functools.lru_cache(None)
                def L(m):
                    if m==0:
                        return 1
                    # compute recursively
                    q, r = divmod(m,5)
                    # L(r) for r in 0..4
                    small = [1,1,2,6,4]
                    return (L(q) * small[r] * pow(2, q, 10)) % 10
                return L(n)
            
