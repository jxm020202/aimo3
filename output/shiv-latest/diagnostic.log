            b = []
            for idx, (i,j) in enumerate([(i,j) for i in range(N) for j in range(i+1,N) if similarity(vectors[i], vectors[j]) not in (0,2)]):
                row.extend([idx, idx])
                col.extend([i, j])
                data.extend([1,1])
                b.append(1)
            A = sp.csr_matrix((data, (row, col)), shape=(len(b), N)
            lb = -np.inf * np.ones(len(b))
            ub = np.ones(len(b))
            lincon = LinearConstraint(A, lb, ub)
            bounds = Bounds(0,1)
            integrality = np.ones(N, dtype=int)
            
            def test_feas(min_size):
                # add constraint sum x_i >= min_size
                # we can set objective minimize -sum x_i (i.e., maximize)
                c_obj = -np.ones(N)
                # add extra row to A for sum >= min_size: -sum <= -min_size
                # We'll add as inequality: -sum <= -min_size
                A2 = sp.vstack([A, sp.csr_matrix(-np.ones((1,N)))])
                lb2 = np.concatenate([lb, [-np.inf]])
                ub2 = np.concatenate([ub, [-min_size]])
                lincon2 = LinearConstraint(A2, lb2, ub2)
                res = milp(c_obj, constraints=lincon2, bounds=bounds, integrality=integrality, options={'disp': False})
                return res.success, res
            
            # test for size 19
