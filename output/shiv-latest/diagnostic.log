            def match_n(n):
                from math import gcd
                # vertices i: 1..n-1 except 2
                left = [i for i in range(1, n) if i != 2]
                right = list(range(3, n+1))  # counts values for n before final operation
                # Build adjacency list where edge if gcd(i, c) == 1
                adj = {i: [c for c in right if gcd(i,c)==1] for i in left}
                # Use a simple bipartite matching algorithm (DFS augment)
                matchR = {}
                def dfs(u, seen):
                    for v in adj[u]:
                        if v in seen:
                            continue
                        seen.add(v)
                        if v not in matchR or dfs(matchR[v], seen):
                            matchR[v] = u
                            return True
                    return False
                for u in left:
                    if not dfs(u, set()):
                        return None
                # Return matching dict left->right
                matching = {u: v for v,u in matchR.items()}
                return matching
            
            for n in range(5, 30):
                m = match_n(n)
                print(n, "matched" if m else "no")
            
