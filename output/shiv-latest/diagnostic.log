            def gray_code(n):
                # binary reflected Gray code of n bits, list of ints
                res = []
                for i in range(1<<n):
                    res.append(i ^ (i>>1))
                return res
            
            def reverse_bits(x, n):
                rev = 0
                for i in range(n):
                    if (x>>i)&1:
                        rev |= 1 << (n-1-i)
                return rev
            
            def reversed_gray(n):
                # apply bit reversal to standard Gray code
                g = gray_code(n)
                return [reverse_bits(x, n) for x in g]
            
            def counts(seq, n):
                # count flips per bit
                f = [0]*n
                prev = seq[0]
                for cur in seq[1:]:
                    diff = prev ^ cur
                    k = diff.bit_length()-1
                    f[k] += 1
                    prev = cur
                return f
            
