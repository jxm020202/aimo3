            import numpy as np
            def reflect_point(P, A, B):
                # reflect point P across line AB
                P = np.array(P)
                A = np.array(A)
                B = np.array(B)
                # line direction
                v = B - A
                # projection of (P-A) onto v
                proj = A + v * np.dot(P - A, v) / np.dot(v, v)
                return 2*proj - P
            
