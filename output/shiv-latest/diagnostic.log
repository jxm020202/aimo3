            def min_flips_for_parity(n):
                # enumerate all subsets of edges (binary matrix) of size n x n
                N = n*n
                min_flips = {}
                for mask in range(1<<N):
                    # compute row parity and column parity
                    rows = [0]*n
                    cols = [0]*n
                    weight = 0
                    for i in range(n):
                        for j in range(n):
                            idx = i*n + j
                            if (mask>>idx)&1:
                                weight += 1
                                rows[i] ^= 1
                                cols[j] ^= 1
                    a = sum(rows)  # number of odd rows
                    b = sum(cols)  # number of odd cols
                    # store minimal weight for given (a,b)
                    key = (a,b)
                    if key not in min_flips or weight < min_flips[key]:
                        min_flips[key] = weight
                return min_flips
            
