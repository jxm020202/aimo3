                # For sign -, need a*x+b*y+c*z+d <= -s_i, so s_i <= -(a*x+b*y+c*z+d).
                # So we can set s_i = min( a*x+b*y+c*z+d (if sign+), -(a*x+b*y+c*z+d) (if sign-)).
                # Then constraints should hold.
                s_vals = []
                for (a,b,c,d), s in zip(plane_list, signs):
                    val = a*x + b*y + c*z + d
                    if s == 1:
                        s_i = val  # need s_i <= val, we can set s_i = val (positive)
                    else:
                        s_i = -val  # need s_i <= -val, val negative => -val positive
                    s_vals.append(s_i)
                # Now check constraints used in LP:
                # For sign +: -a*x - b*y - c*z + s_i <= d
                # For sign -: a*x + b*y + c*z + s_i <= -d
