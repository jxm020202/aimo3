            import math, itertools, sys, random, time, collections, functools, decimal, fractions, itertools, math, sys, time, random
            def count_cool(alpha, k, N):
                pretty=set()
                for m in range(1,N+1):
                    for n in range(1,N+1):
                        val = m*math.ceil(n*alpha) - n*math.floor(m*alpha)
                        if val==k:
                            pretty.add((m,n))
                cool=set()
                for (m,n) in pretty:
                    if (m-n,n) not in pretty and (m,n-m) not in pretty:
                        cool.add((m,n))
                return len(pretty), len(cool), pretty, cool
            
            def search(alpha, k, max_mn):
                pretty=set()
                for m in range(1,max_mn+1):
                    for n in range(1,max_mn+1):
                        if m*math.ceil(n*alpha)-n*math.floor(m*alpha)==k:
                            pretty.add((m,n))
                return pretty
            
