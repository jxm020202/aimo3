            def feasible_subset(subset, n, strict=True):
                # subset: list of domino indices
                # strict: if True, both neighbor cells must be occupied; else at least one
                # Build occupancy set
                occupied_cells = set()
                for idx in subset:
                    typ, r, c = dominos_all[idx]
                    cells = [(r,c), (r,c+1)] if typ=='H' else [(r,c), (r+1,c)]
                    for cell in cells:
                        if cell in occupied_cells:
                            return False  # overlap
                        occupied_cells.add(cell)
                # check blocking for each domino in subset
                for idx in subset:
                    typ, r, c = dominos_all[idx]
                    # neighbor sets
                    if typ == 'H':
                        # left
                        left = [(r, c-1)] if c-1 >= 1 else []
                        # right
                        right = [(r, c+2)] if c+2 <= n else []
                        # up
                        up = [(r-1, c), (r-1, c+1)] if r-1 >= 1 else []
                        # down
                        down = [(r+1, c), (r+1, c+1)] if r+1 <= n else []
                        dirs = [left, right, up, down]
                    else:
                        # vertical
                        up = [(r-1, c)] if r-1 >= 1 else []
                        down = [(r+2, c)] if r+2 <= n else []
                        left = [(r, c-1), (r+1, c-1)] if c-1 >= 1 else []
                        right = [(r, c+1), (r+1, c+1)] if c+1 <= n else []
                        dirs = [up, down, left, right]
                    for neighbor_set in dirs:
                        if not neighbor_set:
                            continue
                        if strict:
                            # each cell must be occupied
                            for cell in neighbor_set:
                                if cell not in occupied_cells:
                                    return False
                        else:
                            # at least one occupied
                            if not any(cell in occupied_cells for cell in neighbor_set):
                                return False
                return True
            
