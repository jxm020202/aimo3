            import itertools
            
            def min_sum_grid(n):
                best = None
                best_seq = None
                # enumerate v_k for k=1..n-1
                for v_seq in itertools.product([-1,1], repeat=n-1):
                    # compute P_i
                    P = [0]
                    s = 0
                    for k in range(1, n):
                        s += v_seq[k-1]
                        P.append(s)
                    p_min = min(P)
                    # compute row contribution
                    row_contrib = -n * p_min + sum(v_seq[k] * (n - (k+1)) for k in range(n-1))
                    # similarly for columns
                    for h_seq in itertools.product([-1,1], repeat=n-1):
                        Q = [0]
                        s = 0
                        for l in range(1, n):
                            s += h_seq[l-1]
                            Q.append(s)
                        q_min = min(Q)
                        col_contrib = -n * q_min + sum(h_seq[l] * (n - (l+1)) for l in range(n-1))
                        S = n * (row_contrib + col_contrib)
                        if best is None or S < best:
                            best = S
                            best_seq = (v_seq, h_seq, P, Q)
                return best, best_seq
            
