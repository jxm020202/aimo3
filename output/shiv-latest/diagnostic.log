            def is_convex_polygon(pts):
                # compute cross product of successive edges; all should have same sign (non-zero)
                n = len(pts)
                signs = []
                for i in range(n):
                    p0 = pts[i]
                    p1 = pts[(i+1)%n]
                    p2 = pts[(i+2)%n]
                    cross = (p1.x - p0.x)*(p2.y - p1.y) - (p1.y - p0.y)*(p2.x - p1.x)
                    signs.append(float(cross))
                # check all same sign
                eps = 1e-8
                nonzero = [s for s in signs if abs(s)>eps]
                if not nonzero:
                    return False
                first = nonzero[0]
