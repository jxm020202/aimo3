            from scipy.optimize import linprog
            def compute_t(n):
                # variables: a_1..a_n, plus M (max absolute value)
                # We'll maximize M, but linprog does minimization, so minimize -M.
                # Variables order: a_0..a_{n-1}, M
                c = [0]*n + [-1]  # minimize -M => maximize M
                # constraints: a_i + a_{i+1} <= 1, -(a_i + a_{i+1}) <= 1
                A_ub = []
                b_ub = []
                for i in range(n):
                    row = [0]*(n+1)
                    row[i] = 1
                    row[(i+1)%n] = 1
                    row[-1] = 0
                    A_ub.append(row)
                    b_ub.append(1)
                    # negative constraint
                    row2 = [-coeff for coeff in row]
                    A_ub.append(row2)
                    b_ub.append(1)
                # constraints for |a_i| <= M: a_i - M <= 0, -a_i - M <= 0
                for i in range(n):
                    row = [0]*(n+1)
                    row[i] = 1
                    row[-1] = -1  # a_i - M <= 0
                    A_ub.append(row)
                    b_ub.append(0)
                    row2 = [0]*(n+1)
                    row2[i] = -1
                    row2[-1] = -1  # -a_i - M <= 0
                    A_ub.append(row2)
                    b_ub.append(0)
                # bounds: a_i free (no bounds), M free but we can bound M >=0
                bounds = [(None, None)]*n + [(0, None)]
                res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method='highs')
                if not res.success:
                    print("LP failed", n, res.message)
                    return None
                M = res.x[-1]
                return M
            
            for n in [3,5,7,9,11]:
                M = compute_t(n)
