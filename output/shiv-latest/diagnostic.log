                        for j in row:
                            if col_counts[j]+1>half:
                                ok=False
                                break
                        if not ok:
                            continue
                        # update
                        for j in row:
                            col_counts[j]+=1
                        current_rows.append(row)
                        backtrack(r+1)
                        # revert
                        current_rows.pop()
                        for j in row:
                            col_counts[j]-=1
                backtrack(0)
