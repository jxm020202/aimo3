            from itertools import product
            
            # define interval categories
            intervals = ['L','M','H']
            def interval_range(cat):
                if cat == 'L':
                    return (-float('inf'), 0)
                elif cat == 'M':
                    return (0,1)
                else:
                    return (1, float('inf'))
            
            def sum_interval(cat1, cat2):
                # return (low, high) open interval for sum
                low1, high1 = interval_range(cat1)
                low2, high2 = interval_range(cat2)
                # sum of open intervals is open interval (low1+low2, high1+high2)
                # but need to handle infinities
                low = low1 + low2
                high = high1 + high2
                return (low, high)
            
            def contains_one(cat1, cat2):
                low, high = sum_interval(cat1, cat2)
                # check if 1 lies strictly inside (low, high)
                return low < 1 < high
            
            # Count regions after adding y=z
            regions = []
            # each region defined by (x_cat, y_cat, z_cat, sign_yz) where sign_yz is None if y_cat!=z_cat else + or -
            for x_cat, y_cat, z_cat in product(intervals, repeat=3):
                if y_cat == z_cat:
                    # two subregions: y>z and y<z
                    regions.append((x_cat, y_cat, z_cat, 1))
                    regions.append((x_cat, y_cat, z_cat, -1))
                else:
                    # sign determined by ordering of intervals
                    # if y interval less than z interval (L<M<H order)
                    order = {'L':0,'M':1,'H':2}
                    sign = 1 if order[y_cat] > order[z_cat] else -1  # y>z if y interval higher
                    regions.append((x_cat, y_cat, z_cat, sign))
            len(regions)
            
