            def last_nonzero_digit_factorial(n):
                # compute last non-zero digit of n! efficiently using recurrence
                # Use known algorithm: iterative multiplication, removing factors of 10
                res = 1
                for i in range(2, n+1):
                    res *= i
                    while res % 10 == 0:
                        res //= 10
                    res %= 100000  # keep manageable
                return res % 10
            
            def D(n):
                return last_nonzero_digit_factorial(n)
            
            # test small values
            print([D(i) for i in range(1,21)])
            
