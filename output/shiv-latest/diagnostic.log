            def pretty_condition(m,n,k):
                d = math.gcd(m,n)
                if (k - m) % d != 0:
                    return False
                if k > m:
                    return n > (k - m)
                else:
                    return True
            
            def pretty_bruteforce_check(k,bound=200):
                alpha=math.sqrt(2)
                brute=set(pretty_pairs_bruteforce(k,bound))
                cond=set()
                for m in range(1,bound+1):
                    for n in range(1,bound+1):
                        if pretty_condition(m,n,k):
                            cond.add((m,n))
                return brute, cond
            
