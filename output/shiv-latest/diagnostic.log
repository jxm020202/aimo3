            import itertools
            
            # Compute parity-check matrix H: basis for nullspace of generator matrix (size 325 x 361)
            # We'll compute using sympy's GF2 nullspace maybe, but we can use custom Gaussian elimination to find basis of orthogonal complement.
            # Approach: treat generator matrix G (list of rows) as 325 x 361 binary matrix.
            # Compute basis for nullspace of G (i.e., vectors w such that w·g = 0 for all g in G). That's V^\perp.
            
            def nullspace_gf2(matrix):
                # matrix: list of rows (list of ints 0/1)
                m = [row[:] for row in matrix]
                n_rows = len(m)
                n_cols = len(m[0])
                # Perform Gaussian elimination to row echelon form, while tracking column pivots.
                pivot_cols = []
                row = 0
                for col in range(n_cols):
                    # find pivot
                    pivot = None
                    for r in range(row, n_rows):
                        if m[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    m[row], m[pivot] = m[pivot], m[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(n_rows):
                        if r != row and m[r][col]:
                            m[r] = [(a ^ b) for a,b in zip(m[r], m[row])]
                    row += 1
                    if row == n_rows:
                        break
                # Now we have row-echelon form. Determine free columns.
                pivot_set = set(pivot_cols)
                free_cols = [c for c in range(n_cols) if c not in pivot_set]
                # For each free column, construct a nullspace vector.
                null_basis = []
                for free in free_cols:
                    # set free column to 1, others free to 0
                    vec = [0]*n_cols
                    vec[free] = 1
                    # back-substitute to determine pivot columns values.
                    # For each pivot row i (in reverse order):
                    for i, pc in enumerate(pivot_cols):
                        # row i corresponds to pivot column pc
                        # equation: sum_{j >= pc} m[i][j] * x_j = 0 (mod 2)
                        # Since we are solving for x, we can compute x_{pc} = sum_{j > pc} m[i][j] * x_j
                        # because m[i][pc] = 1.
                        # We'll compute parity of known entries (free columns already set)
                        s = 0
                        for j in range(pc+1, n_cols):
                            if m[i][j] and vec[j]:
                                s ^= 1
                        vec[pc] = s  # because need sum = 0 => pc + sum = 0 => pc = sum
                    null_basis.append(vec)
                return null_basis
            
