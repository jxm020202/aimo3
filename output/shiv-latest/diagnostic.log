            def angular_spread_endpoint(alpha, R=1.0):
                # point A at angle -alpha/2 on circle radius R
                A = (R*math.cos(-alpha/2), R*math.sin(-alpha/2))
                # other point B at angle +alpha/2
                B = (R*math.cos(alpha/2), R*math.sin(alpha/2))
                # direction from A to B
                ang = math.atan2(B[1]-A[1], B[0]-A[0]) % (2*math.pi)
                # direction from A to some interior point near A? Let's compute direction to a point near A but slightly inside arc, e.g., angle -alpha/2 + epsilon
                epsilon=1e-6
                C = (R*math.cos(-alpha/2+epsilon), R*math.sin(-alpha/2+epsilon))
                angC = math.atan2(C[1]-A[1], C[0]-A[0]) % (2*math.pi)
                # angular spread between extremes: from direction to B (farthest) and direction to point just next to A (close)
                # compute difference
                diff = (ang - angC) % (2*math.pi)
                return diff
            
            for deg in [30, 60, 90, 120]:
                print(deg, angular_spread_endpoint(math.radians(deg))*180/math.pi)
            
