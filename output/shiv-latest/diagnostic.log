            def is_graphical(seq):
                # Havel-Hakimi using heap for efficiency
                import heapq
                # Use max-heap (negatives)
                heap = [-d for d in seq if d>0]
                heapq.heapify(heap)
                while heap:
                    d = -heapq.heappop(heap)
                    if d > len(heap):
                        return False
                    temp = []
                    for _ in range(d):
                        if not heap:
                            return False
                        nd = -heapq.heappop(heap) - 1
                        if nd < 0:
                            return False
                        if nd > 0:
                            temp.append(-nd)
                    for x in temp:
                        heapq.heappush(heap, x)
                return True
            
