            import random, math, numpy as np
            
            def random_point_on_sphere():
                # generate random point on unit sphere uniformly
                # using normal distribution
                v = np.random.normal(size=3)
                v /= np.linalg.norm(v)
                return v
            
            def random_point_on_plane_positive():
                # plane: 6x+3y+2z=12, x,y,z>0
                # param: choose x,y>0 such that z>0
                # solve for z = (12-6x-3y)/2
                while True:
                    x = random.random()*2  # guess range
                    y = random.random()*4
                    z = (12 - 6*x - 3*y)/2
                    if z>0:
                        return np.array([x,y,z])
            
            def chebyshev_dist(p, q):
                return np.max(np.abs(p-q))
            
            def min_chebyshev_to_sphere(p, n_samples=20000):
                best = 1e9
                for _ in range(n_samples):
                    q = random_point_on_sphere()
                    d = chebyshev_dist(p,q)
                    if d < best:
                        best = d
                return best
            
