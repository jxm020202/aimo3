            def exists_alpha(m,n,k):
                d = math.gcd(m,n)
                if k % d != 0:
                    return False
                m_prime = m//d
                n_prime = n//d
                K = k//d
                # Solve m' B - n' A = K - m'
                # Find A0 modulo m'
                # Compute modular inverse of n' mod m'
                inv_n = pow(n_prime, -1, m_prime)  # Python 3.8+ supports mod inverse
                A0 = (inv_n * (-(K - m_prime))) % m_prime
                # Compute B0
                B0 = (n_prime * A0 + (K - m_prime)) // m_prime
                # Check inequalities
                # A0/m' < (B0+1)/n' and B0/n' < (A0+1)/m'
                if A0 * n_prime < (B0 + 1) * m_prime and B0 * m_prime < (A0 + 1) * n_prime:
                    return True
                else:
                    return False
            
            def test_random(limit):
                k=2310
                cnt=0
                total=0
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        total+=1
                        if exists_alpha(m,n,k):
                            cnt+=1
                return cnt,total
            
            cnt,total = test_random(200)
            cnt,total
            
