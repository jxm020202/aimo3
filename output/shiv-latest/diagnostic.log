            def is_pretty(m,n,alpha,k):
                # compute using floor and ceil
                return m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k
            
            def count_pretty(alpha,k,limit):
                cnt=0
                pairs=[]
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if is_pretty(m,n,alpha,k):
                            cnt+=1
                            pairs.append((m,n))
                return cnt,pairs
            
            def count_cool(alpha,k,limit):
                cnt=0
                cool_pairs=[]
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if not is_pretty(m,n,alpha,k):
                            continue
                        # check neighbors
                        pretty1 = (m>n) and is_pretty(m-n,n,alpha,k)
                        pretty2 = (n>m) and is_pretty(m,n-m,alpha,k)
                        if not pretty1 and not pretty2:
                            cnt+=1
                            cool_pairs.append((m,n))
                return cnt,cool_pairs
            
