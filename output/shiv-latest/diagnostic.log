            def blocking_cells(p, direction):
                typ, r, c = p
                if typ == 'H':
                    if direction == 'left':
                        if c-1 >= 0:
                            return [(r, c-1)]
                    elif direction == 'right':
                        if c+2 < n:
                            return [(r, c+2)]
                    elif direction == 'up':
                        if r-1 >= 0:
                            return [(r-1, c), (r-1, c+1)]
                    elif direction == 'down':
                        if r+1 < n:
                            return [(r+1, c), (r+1, c+1)]
                else:  # V
                    if direction == 'up':
                        if r-1 >= 0:
                            return [(r-1, c)]
                    elif direction == 'down':
                        if r+2 < n:
                            return [(r+2, c)]
                    elif direction == 'left':
                        if c-1 >= 0:
                            return [(r, c-1), (r+1, c-1)]
                    elif direction == 'right':
                        if c+1 < n:
                            return [(r, c+1), (r+1, c+1)]
                return []  # offboard or not applicable
            
            directions = ['left','right','up','down']
            cnt=0
            for i,p in enumerate(placements):
                for d in directions:
                    cells = blocking_cells(p,d)
                    if cells:  # all inside board (since function returns empty if any offboard)
