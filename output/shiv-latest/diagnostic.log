            def find_possible_n_for_pair(a,b,limit_prime=200):
                solutions=[]
                for p in sympy.primerange(3, limit_prime):
                    if p==2: continue
                    if a%p==0 or b%p==0: continue
                    # compute order of r = a*inv(b) mod p
                    invb = sympy.mod_inverse(b, p)
                    r = (a*invb) % p
                    # compute order
                    order = sympy.n_order(r, p)  # returns multiplicative order
                    if order % 2 == 0:
                        # find n solving n ≡ 0 (mod p) and n ≡ order//2 (mod order)
                        # use CRT
                        n0 = sympy.crt([p, order], [0, order//2])[0]
                        # ensure n0 odd
                        if n0 % 2 == 1:
