            def simulated_annealing(n=100, iterations=20000):
                # start with random points inside unit circle
                points=[random_point_in_circle() for _ in range(n)]
                best_sum=compute_sum_fast(points)
                best_points=points[:]
                cur_sum=best_sum
                cur_points=points[:]
                T=1.0
                for it in range(iterations):
                    # temperature schedule
                    T = max(0.001, 1.0 - it/iterations)  # linear cooling
                    # propose move: pick random point and move slightly
