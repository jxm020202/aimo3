            def A(d):
                x = sp.symbols('x')
                Phi = sp.cyclotomic_poly(d, x)
                # product over primitive d-th roots of (z+1) = (-1)^{phi(d)} * Phi(-1)
                phi = sp.totient(d)
                val = (-1)**phi * sp.expand(Phi.subs(x, -1))
                return sp.simplify(val)
            for d in range(1,13):
