            def find_min_k(L=3, alphabet=[0,1], max_k=6):
                # generate all possible blocks of length L over alphabet
                all_blocks = list(itertools.product(alphabet, repeat=L))
                # map each block to its prefix (length L-1) and suffix (length L-1)
                prefix = lambda blk: blk[:L-1]
                suffix = lambda blk: blk[1:]
                # try subsets of size k
                for k in range(1, max_k+1):
                    for subset in itertools.combinations(all_blocks, k):
                        # Build graph: vertices are prefixes (contexts)
                        # edges are blocks; from prefix to suffix (both length L-1 tuples)
                        vertices = set(prefix(b) for b in subset) | set(suffix(b) for b in subset)
                        # adjacency dict
                        out_edges = collections.defaultdict(list)
                        for b in subset:
                            out_edges[prefix(b)].append(b)  # store block
                        # ensure each vertex reachable from some start (we can start at any prefix)
                        # For existence of infinite walk non-eventually periodic:
                        # need a reachable SCC that contains a cycle and a vertex with out-degree >=2 within SCC.
                        # We'll just check if there exists a SCC with these properties.
                        # Build directed graph of vertices (edges from prefix to suffix)
                        graph = collections.defaultdict(set)
                        for b in subset:
                            graph[prefix(b)].add(suffix(b))
                        # compute SCCs using Kosaraju
                        # first order
                        visited=set()
                        order=[]
                        def dfs(v):
                            visited.add(v)
                            for w in graph[v]:
                                if w not in visited:
                                    dfs(w)
                            order.append(v)
                        for v in vertices:
                            if v not in visited:
                                dfs(v)
                        # reverse graph
                        rev=collections.defaultdict(set)
                        for v in graph:
                            for w in graph[v]:
