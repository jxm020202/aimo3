            import random, math, copy, time
            
            def sum_a(points):
                return total_sum(points)
            
            def random_move(points, radius=1.0):
                # move one point randomly within circle
                n = len(points)
                i = random.randrange(n)
                # generate new random point inside circle
                r = radius*math.sqrt(random.random())
                theta = random.random()*2*math.pi
                new_pt = (r*math.cos(theta), r*math.sin(theta))
                new_points = points.copy()
                new_points[i] = new_pt
                return new_points
            
            def simulated_anneal(n, iters=5000):
                # start with random points
                pts = random_points_in_circle(n)
                best = sum_a(pts)
                best_pts = pts
                cur = best
                cur_pts = pts
                T0 = 1.0
                for t in range(1, iters+1):
                    T = T0 * (1 - t/iters)
                    new_pts = random_move(cur_pts)
                    new_val = sum_a(new_pts)
                    if new_val > cur or random.random() < math.exp((new_val - cur)/max(T,1e-9)):
                        cur = new_val
                        cur_pts = new_pts
                        if new_val > best:
                            best = new_val
                            best_pts = new_pts
                return best, best_pts
            
            def find_best(n, runs=5):
                best = 0
                for _ in range(runs):
                    val, pts = simulated_anneal(n, iters=2000)
                    if val > best:
                        best = val
                return best
            
            for n in range(5,13):
                best = find_best(n, runs=3)
                print(n, best)
            
