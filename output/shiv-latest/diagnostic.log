            def solve_ilp():
                n_rows = 7
                n_cols = 7
                # Enumerate placements
                placements = []  # list of (type, cells) where type 'H' or 'V'
                # horizontal placements
                for r in range(n_rows):
                    for c in range(n_cols-1):
                        cells = [(r,c), (r,c+1)]
                        placements.append(('H', cells, (r,c)))  # store top-left coordinate for reference
                # vertical placements
                for r in range(n_rows-1):
                    for c in range(n_cols):
                        cells = [(r,c), (r+1,c)]
                        placements.append(('V', cells, (r,c)))
                n = len(placements)
                # Map cell to list of placement indices covering it
                cell_to_placements = collections.defaultdict(list)
                for idx, (_, cells, _) in enumerate(placements):
                    for cell in cells:
                        cell_to_placements[cell].append(idx)
                # Build constraints
                A_rows = []
                lb = []
                ub = []
                # Non-overlap constraints: sum_{placements covering cell} x <= 1
                for cell, idxs in cell_to_placements.items():
                    row = np.zeros(n, dtype=int)
                    for i in idxs:
                        row[i] = 1
                    A_rows.append(row)
                    lb.append(-np.inf)
                    ub.append(1)
                # Blocking constraints
                for i, (typ, cells, (r,c)) in enumerate(placements):
                    # For each neighbor cell that must be occupied if exists
                    neighbor_cells = []
                    if typ == 'H':
                        # left neighbor cell
                        if c-1 >= 0:
                            neighbor_cells.append((r, c-1))
                        # right neighbor cell
                        if c+2 < n_cols:
                            neighbor_cells.append((r, c+2))
                        # up neighbors (both cells above)
                        if r-1 >= 0:
                            neighbor_cells.append((r-1, c))
                            neighbor_cells.append((r-1, c+1))
                        # down neighbors (both cells below)
                        if r+1 < n_rows:
                            neighbor_cells.append((r+1, c))
                            neighbor_cells.append((r+1, c+1))
                    else:  # 'V'
                        # up neighbor cell
                        if r-1 >= 0:
                            neighbor_cells.append((r-1, c))
                        # down neighbor cell
                        if r+2 < n_rows:
                            neighbor_cells.append((r+2, c))
                        # left neighbors (both cells left)
                        if c-1 >= 0:
                            neighbor_cells.append((r, c-1))
                            neighbor_cells.append((r+1, c-1))
                        # right neighbors (both cells right)
                        if c+1 < n_cols:
                            neighbor_cells.append((r, c+1))
                            neighbor_cells.append((r+1, c+1))
                    # For each neighbor cell, add constraint sum_{j covering neighbor} x_j >= x_i
                    for nr, nc in neighbor_cells:
                        # Build row: sum_{j covering neighbor} x_j - x_i >= 0
                        row = np.zeros(n, dtype=int)
                        for j in cell_to_placements[(nr,nc)]:
                            row[j] = 1
                        row[i] -= 1
                        A_rows.append(row)
                        lb.append(0)
                        ub.append(np.inf)
                A = np.vstack(A_rows)
                # Objective: minimize sum x_i
                c = np.ones(n, dtype=int)
                # Define bounds for variables: 0 <= x_i <= 1
                bounds = opt.Bounds(0, 1)
                # Define integrality
                integrality = np.ones(n, dtype=int)
                # Use milp
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A, lb, ub), bounds=bounds,
                               integrality=integrality, options={"presolve": True, "disp": False})
                return res, placements, cell_to_placements
            
            res, placements, cell_to_placements = solve_ilp()
            print(res.success, res.fun, res.x[:10])
            
