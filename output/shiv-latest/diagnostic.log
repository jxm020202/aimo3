            from functools import lru_cache
            import math, itertools, sys
            
            def max_ops_bruteforce(n):
                # initial counts: list of length n, counts[i] = i+1
                init = tuple(i+1 for i in range(n))
                # total pairs possible:
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                # use recursion with memoization on (counts, used_pairs_bitmask)
                total_pairs = len(pairs)
                # map pair index for bitmask
                pair_to_idx = {pair:i for i,pair in enumerate(pairs)}
                @lru_cache(maxsize=None)
                def dfs(counts, used_mask):
                    best = 0
                    # iterate over remaining pairs
                    for idx, (i,j) in enumerate(pairs):
                        if (used_mask>>idx)&1:
                            continue
                        a = counts[i]
                        b = counts[j]
                        if a==0 or b==0:
                            continue
                        g = math.gcd(a,b)
                        # perform operation
                        new_counts = list(counts)
                        new_counts[i] -= g
                        new_counts[j] -= g
                        new_counts = tuple(new_counts)
                        new_mask = used_mask | (1<<idx)
                        res = 1 + dfs(new_counts, new_mask)
                        if res > best:
                            best = res
                    return best
                return dfs(init, 0)
            
