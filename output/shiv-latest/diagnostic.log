            def EG_check(seq):
                n = len(seq)
                seq_sorted = sorted(seq, reverse=True)
                total = sum(seq_sorted)
                if total % 2 != 0:
                    return False, "odd sum"
                prefix = [0]
                for d in seq_sorted:
                    prefix.append(prefix[-1] + d)
                for k in range(1, n+1):
                    left = prefix[k]
                    # compute right side
                    right = k*(k-1)
                    # sum_{i=k+1}^{n} min(d_i, k)
                    for i in range(k, n):
                        right += min(seq_sorted[i], k)
                    if left > right:
                        return False, f"violation at k={k}: left={left}, right={right}"
                return True, "ok"
            
