            def max_ops_bruteforce(n):
                # initial coins: 1..n
                init = tuple(range(1, n+1))
                # map pair (i,j) to bit index
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                pair_index = {pair: idx for idx, pair in enumerate(pairs)}
                total_pairs = len(pairs)
                
                @lru_cache(maxsize=None)
                def dfs(state, used_mask):
                    # state is tuple of remaining coins
                    best = 0
                    # iterate over possible pairs not used
                    for i in range(n):
                        if state[i]==0: continue
                        for j in range(i+1,n):
                            if state[j]==0: continue
                            idx = pair_index[(i,j)]
                            if used_mask & (1<<idx): continue
                            a = state[i]
                            b = state[j]
                            g = math.gcd(a,b)
