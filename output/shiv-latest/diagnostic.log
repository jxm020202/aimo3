                a = []
                for i in range(n):
                    xi, yi = points[i]
                    angles = []
                    for j in range(n):
                        if i==j: continue
                        xj, yj = points[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        if ang < 0: ang += 2*math.pi
                        angles.append(ang)
                    angles.sort()
                    ang2 = angles + [a+2*math.pi for a in angles]
                    maxcnt = 0
                    j = 0
                    m = len(angles)
                    for i0 in range(m):
