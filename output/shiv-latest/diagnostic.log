            def squared_dist(p,q):
                di = p[0]-q[0]
                dj = p[1]-q[1]
                return di*di + di*dj + dj*dj
            
            def collinear(p,q,r):
                # check if points p,q,r are collinear (area zero)
                # using condition D1*(j3 - j1) == (j2 - j1)*D2
                i1,j1 = p
                i2,j2 = q
                i3,j3 = r
                D1 = 2*(i2 - i1) + (j2 - j1)
                D2 = 2*(i3 - i1) + (j3 - j1)
                return D1*(j3 - j1) == (j2 - j1)*D2
            
            def has_isosceles(triple):
                p,q,r = triple
                # ignore collinear triples
                if collinear(p,q,r):
                    return False
                d1 = squared_dist(p,q)
                d2 = squared_dist(p,r)
                d3 = squared_dist(q,r)
                # check if any two distances equal
                return d1==d2 or d1==d3 or d2==d3
            
            def subset_has_isosceles(subset):
                # subset is list of points
                for triple in itertools.combinations(subset,3):
                    if has_isosceles(triple):
                        return True
                return False
            
