            import itertools
            
            def exists_n_sum(n, target):
                # brute force limited values up to maybe 3
                # use BFS/backtracking
                cells = [(i,j) for i in range(n) for j in range(n)]
                # adjacency list
                adj = {}
                for i,j in cells:
                    neigh = []
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj = i+di, j+dj
                        if 0 <= ni < n and 0 <= nj < n:
                            neigh.append((ni,nj))
                    adj[(i,j)] = neigh
                # we will assign values incrementally using backtracking
                max_val = 4  # limit
                assign = {}
                cells_order = cells
                
                def backtrack(idx, current_sum):
                    if idx == len(cells_order):
                        return current_sum == target
                    cell = cells_order[idx]
                    # compute possible values based on already assigned neighbors
                    # for each neighbor already assigned, value must be neighbor +/-1
                    possible = set(range(max_val+1))
                    for nb in adj[cell]:
                        if nb in assign:
                            nb_val = assign[nb]
                            # allowed values are nb_val+1 or nb_val-1
                            possible = possible.intersection({nb_val+1, nb_val-1})
                    # also must be nonnegative
                    possible = {v for v in possible if v>=0}
                    for v in possible:
                        assign[cell] = v
                        if backtrack(idx+1, current_sum+v):
                            return True
                        del assign[cell]
                    return False
                return backtrack(0,0)
            
            for n in range(1,5):
                for target in range(0,20):
                    if exists_n_sum(n, target):
                        print(n, target)
            
