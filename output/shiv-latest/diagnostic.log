            def D(p,q):
                # squared distance *64: D = (ΔX)^2 + 3*Δk^2 where ΔX = 2Δj + Δk
                i1,j1,k1 = p
                i2,j2,k2 = q
                dj = j1 - j2
                dk = k1 - k2
                DX = 2*dj + dk
                return DX*DX + 3*dk*dk
            
            def collinear(p,q,r):
                # using (j,k) coordinates
                _,j1,k1 = p
                _,j2,k2 = q
                _,j3,k3 = r
                dj1 = j2 - j1
                dk1 = k2 - k1
                dj2 = j3 - j1
                dk2 = k3 - k1
                cross = (2*dj1 + dk1)*dk2 - (2*dj2 + dk2)*dk1
                return cross == 0
            
            def is_isosceles(p,q,r):
                # non-degenerate, at least two equal sides
                if collinear(p,q,r):
                    return False
                d1 = D(p,q)
                d2 = D(p,r)
                d3 = D(q,r)
                # check equality of any two sides, non-zero
                # sides cannot be zero because points distinct
