            import itertools
            
            def walks(n):
                # generate all walks a_1..a_n with steps +-1, staying non-negative
                # start a_1 = 0 (we can shift later)
                def rec(i, cur):
                    if i == n:
                        yield cur
                    else:
                        last = cur[-1]
                        for step in [-1, 1]:
                            nxt = last + step
                            if nxt >= 0:
                                yield from rec(i+1, cur + [nxt])
                yield from rec(1, [0])
            
            def all_sums(n):
                sums=set()
                for a in walks(n):
                    A=sum(a)
                    for b in walks(n):
                        B=sum(b)
                        total = n*(A+B)
                        # shift to make min sum zero? Actually a,b already non-negative and start at 0, so min a_i + min b_j = 0
                        # So total is valid.
                        sums.add(total)
                return sorted(sums)
            
            for n in range(1,5):
                s=all_sums(n)
                print(n, len(s), s[:10], s[-10:])
            
