                expr = sp.simplify(2/(1-p) - (b**2/(2-p)**2 + 3*a**2/p**2))
                # Get numerator after bringing to common denominator
                num = sp.together(expr).as_numer_denom()[0]
                # Solve polynomial equation num=0
                sols = sp.solve(num, p, domain=sp.S.Complexes)  # may return symbolic
                # Filter real solutions and constraints
                real_sols = []
                for sol in sols:
