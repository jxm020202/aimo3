            def real_y_for_z(zval):
                # solve poly(y,zval)=0 for y
                poly_y = sp.Poly(poly.subs(z, zval), y)
                roots = poly_y.nroots()
                real_roots = [complex(r) for r in roots if abs(sp.im(r)) < 1e-10]
                # convert to float
                real_vals = [float(sp.re(r)) for r in real_roots]
                return real_vals
            
