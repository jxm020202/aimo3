            import heapq
            
            def max_edges_given_caps(n):
                # caps: vertex i (1-indexed) has cap = i for i=1..n-1, cap_n = n-1
                caps = [i for i in range(1, n)] + [n-1]  # length n
                # We'll use max-heap of (remaining degree, vertex)
                # Use negative for max-heap
                heap = [(-deg, v) for v, deg in enumerate(caps)]
                heapq.heapify(heap)
                total_edges = 0
                # We'll also store degrees after reduction
                degs = caps[:]
                while True:
                    # pop vertex with max remaining degree
                    while heap and degs[heap[0][1]] != -heap[0][0]:
                        # stale entry
                        heapq.heappop(heap)
                    if not heap:
                        break
                    d, v = heapq.heappop(heap)
                    d = -d
                    if d == 0:
                        break
                    # collect other vertices with positive degree
                    # we need up to d other vertices
                    others = []
                    # We'll pop up to d vertices
                    for _ in range(d):
                        # pop next max
                        while heap and degs[heap[0][1]] != -heap[0][0]:
                            heapq.heappop(heap)
                        if not heap:
                            # not enough vertices, reduce degree of v
                            # we cannot use all d edges, only len(others) edges
                            # So we set d = len(others)
                            break
                        d2, u = heapq.heappop(heap)
                        d2 = -d2
                        if d2 == 0:
                            # cannot use this vertex
                            # push back and break
                            heapq.heappush(heap, (-d2, u))
                            break
                        others.append((u, d2))
                    # actual number of connections we can make
                    m = len(others)
                    # reduce degree of v by m (since we connect to m vertices)
                    degs[v] -= m
                    total_edges += m
                    # update others: each loses 1 degree
                    for u, d2 in others:
                        degs[u] -= 1
                        # push back updated degree
                        heapq.heappush(heap, (-degs[u], u))
                    # push back v if still positive degree
                    if degs[v] > 0:
                        heapq.heappush(heap, (-degs[v], v))
                return total_edges
            
            print(max_edges_given_caps(10))
            
