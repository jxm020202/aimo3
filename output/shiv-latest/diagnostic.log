            def bron_kerbosch(R, P, X, adj):
                # R,P,X sets of vertices (as set)
                # adj: adjacency list dictionary mapping vertex to set of neighbors
                max_clique = []
                stack = [(R, P, X)]
                while stack:
                    R, P, X = stack.pop()
                    if not P and not X:
                        # found a maximal clique
                        if len(R) > len(max_clique):
                            max_clique = list(R)
                        continue
                    # Choose a pivot u from P ∪ X with max degree in P
                    # (heuristic)
                    u = None
                    max_neighbors = -1
                    for v in P|X:
                        deg = len(P & adj[v])
                        if deg > max_neighbors:
                            max_neighbors = deg
                            u = v
                    # Iterate over vertices in P \ N(u)
                    for v in list(P - adj[u]):
                        R_new = R | {v}
                        P_new = P & adj[v]
                        X_new = X & adj[v]
                        stack.append((R_new, P_new, X_new))
                        P.remove(v)
                        X.add(v)
                return max_clique
            
            # Build adjacency list as sets
            adj = {i: set(j for j in range(N) if allowed[i][j]) for i in range(N)}
            
            # Run algorithm (might be slow)
            start = time.time()
            max_clique = bron_kerbosch(set(), set(range(N)), set(), adj)
            print("found clique size", len(max_clique), "time", time.time()-start)
            
