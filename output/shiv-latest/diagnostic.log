            def greedy_coloring(P, adj):
                """
                P: bitset of vertices (candidates)
                adj: adjacency bitsets for original graph (compatible)
                Returns list colors where colors[i] is bitset of vertices assigned color i,
                and also returns an ordering of vertices (list) in the order they were colored.
                """
                colors = []  # list of bitsets
                order = []   # order of vertices processed
                # We'll process vertices in some order, e.g., descending degree within P
                # Extract vertices from P into a list sorted by degree (adjacent count) descending
                vertices = []
                temp = P
                while temp:
                    v = (temp & -temp).bit_length() - 1
                    vertices.append(v)
                    temp &= temp - 1
                # sort by degree (adjacent within P)
                vertices.sort(key=lambda v: (adj[v] & P).bit_count(), reverse=True)
                for v in vertices:
                    # try to assign to existing color
                    placed = False
                    for i, col in enumerate(colors):
                        # check if v is non-adjacent to all vertices in this color (i.e., no edge)
                        # Since we need independent set in original graph, we need that v is not adjacent to any vertex in color
                        if (adj[v] & col) == 0:
                            colors[i] |= (1 << v)
                            placed = True
                            break
                    if not placed:
                        colors.append(1 << v)
                    order.append(v)
