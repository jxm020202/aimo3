            def max_edges_exact_bmatching(n):
                # Build flow network
                G = nx.DiGraph()
                source = 's'
                sink = 't'
                G.add_node(source)
                G.add_node(sink)
                caps = [min(i, n-1) for i in range(1, n+1)]
                # vertex nodes labeled v0..v{n-1}
                for i, cap in enumerate(caps):
                    v = f'v{i}'
                    G.add_edge(source, v, capacity=cap)
                    # edges to edge-nodes will be added later
                # edge nodes
                edge_nodes = {}
                for i in range(n):
                    for j in range(i+1, n):
                        e = f'e{i}_{j}'
                        edge_nodes[(i,j)] = e
                        G.add_edge(e, sink, capacity=1)
                        # connect vertices to edge node
                        G.add_edge(f'v{i}', e, capacity=1)
                        G.add_edge(f'v{j}', e, capacity=1)
                flow_value, flow_dict = nx.maximum_flow(G, source, sink)
                # each unit flow corresponds to an edge selected
                return flow_value
            
