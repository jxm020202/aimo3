            def solve_min_dominos():
                n_rows = n_cols = 7
                placements = []  # list of (type, r, c)
                # Horizontal placements
                for r in range(n_rows):
                    for c in range(n_cols-1):
                        placements.append(('H', r, c))
                # Vertical placements
                for r in range(n_rows-1):
                    for c in range(n_cols):
                        placements.append(('V', r, c))
                n = len(placements)
                # Map cell to list of placement indices covering it
                cell_to_placements = collections.defaultdict(list)
                for idx, (typ, r, c) in enumerate(placements):
                    if typ == 'H':
                        cells = [(r,c), (r,c+1)]
                    else:
                        cells = [(r,c), (r+1,c)]
                    for cell in cells:
                        cell_to_placements[cell].append(idx)
                # Build constraints
                rows = []
                lbs = []
                ubs = []
                # Cell non-overlap constraints: sum <= 1
                for r in range(n_rows):
                    for c in range(n_cols):
                        idxs = cell_to_placements[(r,c)]
                        coeff = np.zeros(n, dtype=int)
                        for i in idxs:
                            coeff[i] = 1
                        rows.append(coeff)
                        lbs.append(-np.inf)  # no lower bound
                        ubs.append(1)        # <=1
                # Direction blocking constraints
                # For each placement i, for each direction where sliding possible
                # define neighbor cells set N
                # We'll create constraint: sum_{j covering any neighbor cell} x_j >= x_i
                # i.e., -x_i + sum_{j in neighbor} x_j >= 0
                for i, (typ, r, c) in enumerate(placements):
                    # Determine neighbor sets for each direction
                    # left, right, up, down
                    # For each direction, compute neighbor cells required to block sliding.
                    # For horizontal domino:
                    if typ == 'H':
                        # left neighbor cell (r,c-1)
                        if c-1 >= 0:
                            # sliding left possible, need neighbor occupied
                            neighbor_cells = [(r, c-1)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                        # right neighbor cell (r,c+2)
                        if c+2 < n_cols:
                            neighbor_cells = [(r, c+2)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                        # up neighbor cells (r-1,c) and (r-1,c+1)
                        if r-1 >= 0:
                            neighbor_cells = [(r-1,c), (r-1,c+1)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                        # down neighbor cells (r+1,c) and (r+1,c+1)
                        if r+1 < n_rows:
                            neighbor_cells = [(r+1,c), (r+1,c+1)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
                                for j in cell_to_placements[cell]:
                                    coeff[j] += 1
                            rows.append(coeff)
                            lbs.append(0)
                            ubs.append(np.inf)
                    else:  # vertical
                        # up neighbor cell (r-1,c)
                        if r-1 >= 0:
                            neighbor_cells = [(r-1,c)]
                            coeff = np.zeros(n, dtype=int)
                            coeff[i] = -1
                            for cell in neighbor_cells:
