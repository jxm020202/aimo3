            def max_min_distance(n=19):
                max_d = -1
                best = []
                for R_odd in range(n+1):
                    for C_odd in range(n+1):
                        if (R_odd % 2) != (C_odd % 2):
                            continue
                        d0 = max(R_odd, C_odd)  # target even
                        d1 = max(n - R_odd, n - C_odd)  # target odd
                        d = min(d0, d1)
                        if d > max_d:
                            max_d = d
                            best = [(R_odd, C_odd, d0, d1)]
