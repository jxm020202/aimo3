            import sympy as sp
            
            def inv_circulant_coeffs(n):
                # n odd
                a = sp.symbols('a0:'+str(n))
                # matrix T: a_i + a_{i+1}
                T = sp.zeros(n)
                for i in range(n):
                    T[i,i] = 1
                    T[i,(i+1)%n] = 1
                T_inv = T.inv()
                # first row of T_inv
                first_row = [sp.simplify(T_inv[0,i]) for i in range(n)]
                return first_row, T_inv
            
