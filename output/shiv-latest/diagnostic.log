            import numpy as np, math, itertools, sys, time, random, collections, itertools, math, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_edges_ilp(n):
                # number of variables = C(n,2)
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(pairs)
                # objective: maximize sum x
                c = -np.ones(m)  # milp minimizes, so negative
                # constraints: for each vertex i, sum of edges incident <= i+1 (since vertices labeled 1..n)
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(pairs):
                    A[i, idx] = 1
                    A[j, idx] = 1
                # each constraint: sum <= cap
                caps = np.arange(1, n+1)  # caps i+1
                # Build LinearConstraint for <= caps
                lc = LinearConstraint(A, -np.inf*np.ones(n), caps)
                # bounds for variables 0 <= x <= 1, integer
                bounds = Bounds(0, 1)
                integrality = np.ones(m, dtype=int)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("MILP failed", res.message)
                    return None
                x = np.rint(res.x)  # round
                total_edges = int(round(-res.fun))
                return total_edges
            
