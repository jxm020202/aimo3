            def is_isosceles(p1, p2, p3):
                x1,y1 = p1
                x2,y2 = p2
                x3,y3 = p3
                area2 = (x2 - x1)*(y3 - y1) - (x3 - x1)*(y2 - y1)
                if area2 == 0:
                    return False
                d12 = (x1 - x2)**2 + (y1 - y2)**2
                d23 = (x2 - x3)**2 + (y2 - y3)**2
                d31 = (x3 - x1)**2 + (y3 - y1)**2
                d12 = sp.simplify(d12)
                d23 = sp.simplify(d23)
                d31 = sp.simplify(d31)
                return d12 == d23 or d23 == d31 or d31 == d12
            
