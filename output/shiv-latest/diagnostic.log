            def max_edges_bmatching(n):
                # compute caps as min(i, C_i) with i<n else C_n
                # compute prime factors for inclusion-exclusion
                pf = [[] for _ in range(n+1)]
                for p in range(2, n+1):
                    if not pf[p]:
                        for mult in range(p, n+1, p):
                            pf[mult].append(p)
                def coprime_count(i):
                    if i == 1:
                        return n-1
                    primes = pf[i]
                    total = n
                    m = len(primes)
                    for mask in range(1, 1<<m):
                        mult = 1
                        bits = 0
                        for idx in range(m):
                            if mask>>idx & 1:
                                mult *= primes[idx]
                                bits += 1
                        term = n // mult
                        if bits % 2 == 1:
                            total -= term
                        else:
                            total += term
                    return total
                caps = [0]*(n+1)
                for i in range(1, n+1):
                    C = coprime_count(i)
                    caps[i] = min(i, C) if i < n else min(n-1, C)
                # Build flow network
                # nodes: 0=source, 1..n = left copies, n+1..2n = right copies, 2n+1 = sink
                N = 2*n + 2
                source = 0
                sink = 2*n + 1
                # adjacency list for Dinic
                adj = [[] for _ in range(N)]
                class Edge:
                    __slots__ = ('to','cap','rev')
                    def __init__(self, to, cap, rev):
                        self.to = to
                        self.cap = cap
                        self.rev = rev
                def add_edge(fr, to, cap):
                    forward = Edge(to, cap, len(adj[to]))
                    backward = Edge(fr, 0, len(adj[fr]))
                    adj[fr].append(forward)
                    adj[to].append(backward)
                # source to left_i
                for i in range(1, n+1):
                    add_edge(source, i, caps[i])
                # right_i to sink
                for i in range(1, n+1):
                    add_edge(n+i, sink, caps[i])
                # left_i to right_j for coprime pairs i<j
                for i in range(1, n+1):
                    for j in range(i+1, n+1):
                        if math.gcd(i,j)==1:
                            add_edge(i, n+j, 1)
                # Dinic
                level = [0]*N
                it = [0]*N
                from collections import deque
                def bfs():
                    for i in range(N):
                        level[i] = -1
                    q = deque()
                    level[source] = 0
                    q.append(source)
                    while q:
                        v = q.popleft()
                        for e in adj[v]:
                            if e.cap > 0 and level[e.to] < 0:
                                level[e.to] = level[v] + 1
                                q.append(e.to)
                    return level[sink] >= 0
                def dfs(v, upTo):
                    if v == sink:
                        return upTo
                    for i in range(it[v], len(adj[v])):
                        e = adj[v][i]
                        if e.cap > 0 and level[v] < level[e.to]:
                            d = dfs(e.to, min(upTo, e.cap))
                            if d > 0:
                                e.cap -= d
                                adj[e.to][e.rev].cap += d
                                return d
                        it[v] += 1
                    return 0
                flow = 0
                INF = 10**9
                while bfs():
                    it = [0]*N
                    f = dfs(source, INF)
                    while f:
                        flow += f
                        f = dfs(source, INF)
                # flow equals number of edges selected (since each unit corresponds to one edge)
                return flow, caps
            
            for N in range(2, 21):
                flow, caps = max_edges_bmatching(N)
                total_cap = sum(caps[1:])
                print(N, flow, total_cap//2, total_cap, flow == total_cap//2)
            
