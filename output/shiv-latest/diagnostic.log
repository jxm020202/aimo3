            def all_paths_n(n):
                N = 2**n
                vertices = list(range(N))
                start = 0
                # generate permutations of remaining vertices (N-1)! huge, but for n=2 it's small
                for perm in itertools.permutations([v for v in vertices if v != start]):
                    seq = (start,) + perm
                    if is_hamiltonian_path(seq):
                        yield seq
            
