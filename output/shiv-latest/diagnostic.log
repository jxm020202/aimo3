                        # second pass
                        visited2=set()
                        sccs=[]
                        def dfs2(v, comp):
                            visited2.add(v)
                            comp.append(v)
                            for w in rev[v]:
                                if w not in visited2:
                                    dfs2(w, comp)
                        for v in reversed(order):
                            if v not in visited2:
                                comp=[]
                                dfs2(v, comp)
                                sccs.append(comp)
                        # check each SCC
                        for comp in sccs:
                            # need at least one edge (block) within SCC that forms a cycle
                            # Actually if SCC size>1, there is a cycle. If size==1, need a self-loop edge.
                            # Determine edges inside SCC
                            edges_inside = [(b) for b in subset if prefix(b) in comp and suffix(b) in comp]
                            if not edges_inside:
