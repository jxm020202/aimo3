            def canonical_representation(N, succ):
                # succ: dict node->successor (1..N)
                # compute predecessors
                preds = defaultdict(list)
                for u,v in succ.items():
                    preds[v].append(u)
                # find cycles and cycle order
                visited = [0]*(N+1)
                in_cycle = [False]*(N+1)
                cycle_of = [None]*(N+1)  # which cycle id
                cycles = []  # list of lists of nodes in order
                for i in range(1,N+1):
                    if visited[i]:
                        continue
                    cur = i
                    path = []
                    while not visited[cur]:
                        visited[cur]=i
                        path.append(cur)
                        cur = succ[cur]
                    if visited[cur]==i:
                        # found cycle
                        idx = path.index(cur)
                        cyc = path[idx:]
                        for node in cyc:
                            in_cycle[node]=True
                        cycles.append(cyc)
                        # assign cycle id
                        cid = len(cycles)-1
                        for node in cyc:
                            cycle_of[node]=cid
                # compute predecessor in cycle for each cycle node
                cycle_pred = {}
                for cyc in cycles:
                    L=len(cyc)
                    for i,node in enumerate(cyc):
                        prev = cyc[i-1]  # predecessor in cycle (since succ[prev]=node)
                        cycle_pred[node]=prev
                from functools import lru_cache
                @lru_cache(None)
                def tree_code(u):
                    # compute code for subtree rooted at u (excluding edge to its successor)
                    # For cycle nodes, exclude predecessor in cycle
                    children = []
                    for v in preds[u]:
                        if in_cycle[u] and v == cycle_pred[u]:
                            continue
                        children.append(tree_code(v))
                    children.sort()
                    return tuple(children)
                # compute code for each cycle node
                cycle_codes = []
                for cyc in cycles:
                    codes = [tree_code(node) for node in cyc]
                    # compute minimal rotation
                    L=len(codes)
                    # generate rotations
                    rotations = [tuple(codes[i:]+codes[:i]) for i in range(L)]
                    canon = min(rotations)
                    cycle_codes.append(canon)
                # sort cycle representations
                cycle_codes.sort()
                return tuple(cycle_codes)
            
            def graph_T(n):
                def T(x):
                    y = (866*x) % n
                    if y==0:
                        y=n
                    return y
                return {i: T(i) for i in range(1,n+1)}
            
            def graph_E(n):
                m=n+1
                return {a: pow(a,866,m) for a in range(1,n+1)}
            
            def is_good_n2(n):
                # squarefree condition for n+1
                fac = sp.factorint(n+1)
                if any(e>1 for e in fac.values()):
                    return False
                # ensure exponentiation never yields 0
                m=n+1
                for a in range(1,n+1):
                    if pow(a,866,m)==0:
                        return False
                # compute canonical reps
                rep_T = canonical_representation(n, graph_T(n))
                rep_E = canonical_representation(n, graph_E(n))
                return rep_T == rep_E
            
            def find_min_n(limit=2000):
                for n in range(866, limit+1):
                    if is_good_n2(n):
                        return n
                return None
            
            print(find_min_n(2000))
            
