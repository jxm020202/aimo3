            def hill_climb(N, iterations=5000, radius=1.0):
                # start with random points
                pts = [random_point_in_circle(radius) for _ in range(N)]
                best = total_sum(pts)
                best_pts = pts[:]
                for it in range(iterations):
                    # pick random point and move slightly
                    i = random.randrange(N)
                    old = pts[i]
                    # propose new position within small radius
                    delta = (random.uniform(-0.1,0.1), random.uniform(-0.1,0.1))
                    new = (old[0]+delta[0], old[1]+delta[1])
                    # ensure inside circle
                    if new[0]**2+new[1]**2 > radius**2:
