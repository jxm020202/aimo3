            import itertools
            import math
            from scipy.optimize import linprog
            import numpy as np
            
            def min_average_lp(n):
                # variables for each edge (i<j)
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # objective: minimize sum of labels
                c = np.ones(m)
                # bounds: 1 <= x <= 3
                bounds = [(1,3)]*m
                # constraints: for each triangle (i,j,k): x_ij + x_jk + x_ik >=5
                # Convert to -x_ij - x_jk - x_ik <= -5
                A = []
                b = []
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            row = np.zeros(m)
                            # find indices
                            idx_ij = edges.index((i,j))
                            idx_jk = edges.index((j,k))
                            idx_ik = edges.index((i,k))
                            row[idx_ij] = -1
                            row[idx_jk] = -1
                            row[idx_ik] = -1
                            A.append(row)
                            b.append(-5)
                res = linprog(c, A_ub=np.array(A), b_ub=np.array(b), bounds=bounds, method='highs')
                if not res.success:
                    return None
                total = res.fun
                avg = total / m
                return avg, total, m
            
            for n in range(3,8):
                avg,total,m = min_average_lp(n)
                print(n, avg, total, m)
            
