            def construct_matching(n):
                # vertices 0..n-1
                # matching edges: pair (i, i+1) for i even up to n-2
                edges = {}
                for i in range(0, n-1, 2):
                    edges[(i,i+1)] = 1
                # all other edges 2
                for i in range(n):
                    for j in range(i+1,n):
                        if (i,j) not in edges:
                            edges[(i,j)] = 2
                return edges
            
            def check_labeling(edges,n):
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            s = edges[(i,j)] + edges[(i,k)] + edges[(j,k)]
                            if s < 5:
                                return False, (i,j,k,s)
