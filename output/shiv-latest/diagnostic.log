            def condition_power5(k):
                # compute s = v5(k)
                s = 0
                temp = k
                while temp % 5 == 0:
                    temp //= 5
                    s += 1
                t = temp  # not divisible by 5
                # get base-5 digits of t
                a = b = 0
                while t > 0:
                    digit = t % 5
                    if digit == 2:
                        a += 1
                    elif digit == 4:
                        b += 1
                    t //= 5
                # condition
                if b % 2 == 0:
                    return (a + s) % 4 == 0
                else:
                    return (a + s) % 4 == 2
            
