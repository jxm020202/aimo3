            from collections import defaultdict
            
            def functional_graph_signature(mapping):
                # mapping: dict or list where mapping[i] = image of i (0-indexed)
                n = len(mapping)
                visited = [False]*n
                # compute reverse adjacency (preimages)
                pre = [[] for _ in range(n)]
                for i, j in enumerate(mapping):
                    pre[j].append(i)
                component_signatures = []
                for i in range(n):
                    if visited[i]:
                        continue
                    # explore component
                    # find cycle using Floyd's algorithm starting from i
                    # but easier: follow until we see a visited node in this component
                    path = []
                    cur = i
                    while not visited[cur]:
                        visited[cur] = True
                        path.append(cur)
                        cur = mapping[cur]
                    # cur is now a node already visited (maybe part of this component or previous)
                    # Need to find the cycle within this component: we can detect by walking from i again until repeat
                    # Simpler: find cycle nodes by traversing from i and detecting first repeat
                    # Use dict to store index
                    idx = {}
                    cur = i
                    while cur not in idx:
                        idx[cur] = len(idx)
                        cur = mapping[cur]
                    # cycle start index
                    start = idx[cur]
                    cycle_nodes = list(idx.keys())[start:]  # but dict order not guaranteed
                    # Instead, reconstruct cycle by following from cur until back to cur
                    cycle = []
                    node = cur
                    while True:
                        cycle.append(node)
                        node = mapping[node]
                        if node == cur:
                            break
                    # Now we have cycle nodes list
                    # For each node in cycle, compute tree shape of its incoming tree excluding predecessor on cycle
                    # We'll compute recursively shape for nodes not in cycle
                    # Define function to compute shape of rooted tree at node, ignoring parent (the node that maps to it)
                    # For nodes not in cycle, we can compute shape using recursion on preimages (children)
                    # For cycle nodes, we need to exclude the predecessor on cycle from its children list
                    # Determine predecessor on cycle for each node
                    pred = {}
                    L = len(cycle)
                    for idx_c, node_c in enumerate(cycle):
                        pred[node_c] = cycle[(idx_c-1)%L]
                    # Recursive shape computation with memoization
                    from functools import lru_cache
                    @lru_cache(None)
                    def shape(node):
                        # children are preimages of node, excluding predecessor if node in cycle
                        children = []
                        for child in pre[node]:
                            if node in cycle and child == pred[node]:
                                continue
                            children.append(shape(child))
                        # sort children shapes to get canonical
                        children.sort()
                        return "(" + "".join(children) + ")"
                    # compute shape for each cycle node
                    cycle_shapes = [shape(node) for node in cycle]
                    # Now we need a canonical representation of the cycle with attached trees up to rotation
                    # Find minimal rotation lexicographically
                    # Duplicate list to handle wrap-around
                    double = cycle_shapes * 2
                    best = None
                    L = len(cycle_shapes)
                    for start_idx in range(L):
                        candidate = tuple(double[start_idx:start_idx+L])
                        if best is None or candidate < best:
                            best = candidate
                    # Represent component signature as tuple of strings (the best rotation)
                    component_signatures.append(best)
                # Sort component signatures to get multiset representation
                component_signatures.sort()
                return tuple(component_signatures)
            
            def compute_T(n):
