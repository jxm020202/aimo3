            def reachable_sums_n(n, max_val=5):
                # enumerate all assignments of values 0..max_val satisfying |diff|=1 on edges
                cells = [(i,j) for i in range(n) for j in range(n)]
                # Use recursion/backtracking to prune
                from functools import lru_cache
                
                # adjacency list
                adj = {}
                for i,j in cells:
                    neigh = []
                    if i>0: neigh.append((i-1,j))
                    if i<n-1: neigh.append((i+1,j))
                    if j>0: neigh.append((i,j-1))
                    if j<n-1: neigh.append((i,j+1))
                    adj[(i,j)] = neigh
                
                # order cells for backtracking
                order = cells
                
                reachable = set()
                assignment = {}
                
                def backtrack(idx):
                    if idx == len(order):
                        total = sum(assignment.values())
                        reachable.add(total)
                        return
                    cell = order[idx]
                    # Determine allowed values based on already assigned neighbors
                    # For each neighbor already assigned, value must differ by exactly 1
                    # If no neighbor assigned yet, we can try any value 0..max_val
                    possible_vals = range(0, max_val+1)
                    for neigh in adj[cell]:
                        if neigh in assignment:
                            neigh_val = assignment[neigh]
                            # value must be neigh_val + 1 or neigh_val - 1
                            possible_vals = [v for v in possible_vals if abs(v - neigh_val) == 1]
                    for v in possible_vals:
                        assignment[cell] = v
                        backtrack(idx+1)
                        del assignment[cell]
                backtrack(0)
                return reachable
            
            for n in range(1,4):
                sums = reachable_sums_n(n, max_val=5)
                print("n", n, "reachable sums up to 5:", sorted(sums)[:20], "...", len(sums))
            
