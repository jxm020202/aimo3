            import sympy as sp
            def get_real_solutions(a,b):
                s,t = sp.symbols('s t')
                D = t**2 + 3*s**2
                eq1 = sp.Eq(a/s + 2/D, 1)
                eq2 = sp.Eq(b/t - 2/D, 1)
                sol = sp.solve([eq1, eq2], (s,t), dict=True)
                real_sols = []
                for s_expr,t_expr in sol:
                    # evaluate numerically
                    s_val = s_expr.evalf()
                    t_val = t_expr.evalf()
                    if s_val.is_real and t_val.is_real:
                        real_sols.append((float(s_val), float(t_val)))
                return real_sols
            
            for a,b in [(-1,-1), (-2,-2), (-3,-3), (-4,-4)]:
                sols = get_real_solutions(a,b)
                print(a,b, sols)
            
