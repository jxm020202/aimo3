            import random, math
            
            def sign(val, eps=1e-9):
                if val > eps:
                    return 1
                elif val < -eps:
                    return 0
                else:
                    # treat as zero; but probability zero
                    return None
            
            def evaluate_point(pt):
                x,y,z = pt
                signs = []
                # plane list: six cube + three tetrahedron
                coeffs = [
                    (1,0,0,0),   # x=0
                    (1,0,0,-1),  # x=1
                    (0,1,0,0),   # y=0
                    (0,1,0,-1),  # y=1
                    (0,0,1,0),   # z=0
                    (0,0,1,-1),  # z=1
                    (-1,1,-1,1), # plane7
                    (-1,0,-1,1), # plane8
                    (0,-1,1,0)   # plane9
                ]
                for a,b,c,d in coeffs:
                    val = a*x + b*y + c*z + d
                    s = sign(val)
                    if s is None:
                        return None
                    signs.append(s)
                return tuple(signs)
            
