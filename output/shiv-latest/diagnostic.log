            def angular_spread(point, others):
                xi, yi = point
                angles=[]
                for (xj,yj) in others:
                    ang = math.atan2(yj-yi, xj-xi)
                    if ang<0: ang+=2*math.pi
                    angles.append(ang)
                # compute minimal angular interval covering all angles (circular)
                # compute max gap
                angles.sort()
                max_gap=0
                for i in range(len(angles)):
                    j=(i+1)%len(angles)
                    diff = (angles[j] - angles[i]) % (2*math.pi)
                    if diff>max_gap:
                        max_gap=diff
                # minimal covering interval = 2π - max_gap
                return 2*math.pi - max_gap
            
