            def max_edges_fast(N):
                # Use algorithm described earlier (greedy reduction) but it's O(N^2). For N up to 2000 fine.
                bounds = [i for i in range(1, N)] + [N-1]
                d = sorted(bounds, reverse=True)
                while True:
                    violated = False
                    prefix = [0]
                    for val in d:
                        prefix.append(prefix[-1] + val)
                    total = prefix[-1]
                    for k in range(1, N+1):
                        left = prefix[k]
                        # compute right side efficiently:
                        # sum_{i=k+1..N} min(d_i, k)
                        # Since d is nonincreasing, we can find the point where d_i <= k.
                        # Let's compute directly for simplicity.
                        s = sum(min(val, k) for val in d[k:])
                        right = k*(k-1) + s
                        if left > right:
