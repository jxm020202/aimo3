            def max_edges_ilp(n):
                # bounds: i for i=1..n-1, bound_n = n-1
                bounds = [i for i in range(1, n)] + [n-1]
                # variable indices mapping (i,j) -> idx
                pairs = []
                for i in range(n):
                    for j in range(i+1, n):
                        pairs.append((i,j))
                m = len(pairs)
                c = -np.ones(m)  # maximize sum => minimize -sum
                # constraints: for each vertex i, sum of edges incident ≤ bound_i
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(pairs):
                    A[i, idx] = 1
                    A[j, idx] = 1
                # inequality: A x <= bounds
                lin_con = LinearConstraint(A, -np.inf, bounds)
                # variable bounds: 0 <= x <= 1, integer
                var_bounds = Bounds(0, 1)
                integrality = np.ones(m, dtype=int)
                res = milp(c=c, constraints=lin_con, bounds=var_bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("ILP failed")
                    return None
                edges = int(-res.fun)  # because we minimized negative sum
                return edges
            
            print(max_edges_ilp(10))
            
