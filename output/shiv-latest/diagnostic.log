            def order_mod(a, m):
                # compute smallest t>0 such that a^t ≡ 1 mod m
                if math.gcd(a,m)!=1:
                    return None
                t=1
                cur=a % m
                while cur!=1:
                    cur=(cur*a)%m
                    t+=1
                    if t>m*2:
                        return None
                return t
            
