            def subset_sum_counts(d):
                from itertools import combinations
                elems = list(range(1,d))
                counts = [0]*d
                n = len(elems)
                for mask in range(1, 1<<n):
                    s = 0
                    for i in range(n):
                        if mask>>i & 1:
                            s += elems[i]
                    counts[s % d] += 1
                return counts
            
