            def tau_perm(n):
                m = n+1
                perm = [0]*(n+1)
                for a in range(1,n+1):
                    y = pow(a, 866, m)
                    # map 0 to m? but should not happen
                    if y == 0:
                        # map to n (i.e., m)
                        y = n
                    perm[a] = y
                return perm
            
