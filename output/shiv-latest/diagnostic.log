            def max_edges_greedy(n):
                # caps: for i=1..n-1: i, for i=n: n-1
                caps = [i for i in range(1, n)] + [n-1]  # index 0 corresponds to vertex 1
                # We'll use a max-heap of (remaining capacity, vertex index)
                import heapq
                # We'll process vertices in descending order of index (or maybe any order)
                # Use list of vertices sorted by caps descending (i.e., index descending)
                # We'll maintain a heap of vertices that still have capacity left and are not the current vertex.
                # Approach: similar to Havel-Hakimi: repeatedly pick vertex with highest remaining degree, connect to others with highest degrees.
                # We'll implement standard Havel-Hakimi construction, but stop when we cannot fulfill connections.
                # We'll maintain a list of (degree, vertex) sorted descending.
                degrees = caps[:]  # mutable
                # We'll use a list of vertices with remaining degree >0
                # We'll use a heap of negative degrees for max
                heap = [(-deg, i) for i, deg in enumerate(degrees) if deg > 0]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    d, v = heapq.heappop(heap)
                    d = -d
                    if d == 0:
                        continue
                    # Need to connect v to d other vertices
                    # Extract d vertices with highest remaining degree
                    temp = []
                    for _ in range(d):
                        if not heap:
                            # cannot fulfill, break
                            # we will not add remaining edges for this vertex
                            # push back the ones we popped
                            for item in temp:
                                heapq.heappush(heap, item)
                            # No more edges possible
                            return edges
                        nd, u = heapq.heappop(heap)
                        nd = -nd
                        # add edge between v and u
                        edges += 1
                        nd -= 1
                        if nd > 0:
                            temp.append((-nd, u))
                    # after connecting, push back the temp vertices
                    for item in temp:
                        heapq.heappush(heap, item)
                    # v's degree becomes 0 (since we used all d)
                    # continue
                return edges
            
