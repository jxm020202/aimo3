            import mpmath as mp
            
            def UV_length(Rb_val):
                # compute using numeric geometry
                y0 = mp.sqrt(Rb_val**2 - 25)
                r1 = mp.sqrt(5)
                r2 = 3*mp.sqrt(5)/2
                # points
                R_pt = (-1, y0)
                O1 = ((Rb_val - r1)/Rb_val * -5, (Rb_val - r1)/Rb_val * y0)
                O2 = ((Rb_val - r2)/Rb_val * 5, (Rb_val - r2)/Rb_val * y0)
                # line O1O2
                # reflect R across line O1O2 to get S
                # Use formula for reflection of point across line defined by two points
                # Compute projection of R onto line O1O2, then reflect.
                import numpy as np
                O1_np = np.array(O1)
                O2_np = np.array(O2)
                R_np = np.array(R_pt)
                # direction vector of line
                v = O2_np - O1_np
                # projection of (R - O1) onto v
                t = np.dot(R_np - O1_np, v) / np.dot(v, v)
                proj = O1_np + t * v
                # reflection: S = 2*proj - R
                S_np = 2*proj - R_np
                # distance from origin to line RS
                # line RS direction
                w = S_np - R_np
                # distance from origin to line = |cross(R, S)| / |w|
                cross = abs(R_np[0]*S_np[1] - R_np[1]*S_np[0])
                d = cross / np.linalg.norm(w)
                # chord length UV = 2*sqrt(Rb^2 - d^2)
                return 2*mp.sqrt(Rb_val**2 - d**2)
            
            def f(Rb_val):
                return UV_length(Rb_val) - 11
            
            # find root
            for guess in [6,7,8,9,10,12,15]:
                try:
                    root = mp.findroot(f, guess)
                    print("guess",guess,"root",root)
                except Exception as e:
                    pass
            
