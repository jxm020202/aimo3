            import random, math, itertools, sys, time, numpy as np
            
            def max_in_wedge(angles, wedge_rad):
                # angles sorted in [0,2π)
                angles = sorted(angles)
                # duplicate with +2π
                angles2 = angles + [a+2*math.pi for a in angles]
                maxcnt = 0
                j = 0
                n = len(angles)
                for i in range(n):
                    while j < i+n and angles2[j] - angles2[i] <= wedge_rad + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def compute_a(points, wedge_deg=100):
                wedge_rad = math.radians(wedge_deg)
                n = len(points)
                a = []
                for i in range(n):
                    angles = []
                    xi, yi = points[i]
                    for j in range(n):
                        if i==j: continue
                        xj, yj = points[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        if ang < 0: ang += 2*math.pi
                        angles.append(ang)
                    a.append(max_in_wedge(angles, wedge_rad))
                return a
            
            def random_points_in_circle(n, radius=1.0):
                pts=[]
                for _ in range(n):
                    r = radius*math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
