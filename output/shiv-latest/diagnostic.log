            def reversed_gray_path(n):
                # generate standard binary reflected Gray code sequence of length 2^n
                # then reverse bits order (i.e., map vertex v to revbits(v) where bits reversed)
                def gray_code(n):
                    if n==0:
                        return [0]
                    prev=gray_code(n-1)
                    res=prev + [(1<<(n-1)) | x for x in reversed(prev)]
                    return res
                seq=gray_code(n)
                # reverse bits
                def revbits(v,n):
                    rev=0
                    for i in range(n):
                        if v>>i & 1:
                            rev |= 1 << (n-1-i)
                    return rev
                rev_seq=[revbits(v,n) for v in seq]
                return rev_seq
            
            def T_of_seq(seq):
                total=0
                for i in range(1,len(seq)):
                    diff=seq[i]^seq[i-1]
                    k=diff.bit_length()-1
                    total+=1/(2**k)
                return total
            
