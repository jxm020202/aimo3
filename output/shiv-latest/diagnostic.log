            def reflect_across_midpoint(p, q):
                # reflect p across midpoint of segment pq: p' = 2*mid - p = q + (q - p) = 2q - p
                # Actually reflection of p across midpoint of pq is point r = 2*mid - p = q + (q - p) = 2q - p
                # So r = (2*q - p)
                j1,k1 = p
                j2,k2 = q
