            def plane_from_coeffs(coeff):
                a,b,c,d = coeff
                normal = sp.Matrix([a,b,c])
                # find a point satisfying equation
                # try set two coordinates to 0 and solve for third
                # Choose variable with non-zero coefficient
                if a != 0:
                    x_val = sp.solve(sp.Eq(a*sp.Symbol('x') + b*0 + c*0 + d, 0), sp.Symbol('x'))[0]
                    pt = sp.Point3D(x_val, 0, 0)
                elif b != 0:
                    y_val = sp.solve(sp.Eq(a*0 + b*sp.Symbol('y') + c*0 + d, 0), sp.Symbol('y'))[0]
