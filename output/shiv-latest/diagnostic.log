            def can_slide(board, placements, idx):
                # board occupancy: '.' empty, 'H' or 'V' occupied
                p = placements[idx]
                typ = p['type']
                (r1,c1),(r2,c2) = p['cells']
                # check each direction
                # left
                if typ == 'H':
                    # left neighbor cell (r1, c1-1)
                    if c1-1 >= 0:
                        if board[r1][c1-1] == '.':
                            return True
                    # right neighbor
                    if c2+1 <= 6:
                        if board[r1][c2+1] == '.':
                            return True
                    # up: need both cells above empty
                    if r1-1 >= 0:
                        if board[r1-1][c1] == '.' and board[r1-1][c2] == '.':
                            return True
                    # down
                    if r1+1 <= 6:
                        if board[r1+1][c1] == '.' and board[r1+1][c2] == '.':
                            return True
                else: # V
                    # left: both cells left empty
                    if c1-1 >= 0:
                        if board[r1][c1-1] == '.' and board[r2][c1-1] == '.':
                            return True
                    # right
                    if c1+1 <= 6:
                        if board[r1][c1+1] == '.' and board[r2][c1+1] == '.':
                            return True
                    # up
                    if r1-1 >= 0:
                        if board[r1-1][c1] == '.':
                            return True
                    # down
                    if r2+1 <= 6:
                        if board[r2+1][c1] == '.':
                            return True
                return False
            
            # Check all placed dominos
            any_slide = False
            for idx, val in enumerate(x):
                if val == 1:
                    if can_slide(board, placements, idx):
                        any_slide = True
                        print("Domino can slide:", idx, placements[idx])
                        break
            any_slide
            
