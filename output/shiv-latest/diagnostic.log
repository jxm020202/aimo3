            from math import isqrt
            
            def mul_solution(sol, unit):
                # sol = (x, u), unit = (a,b) representing a + b*sqrt(7)
                x1,u1 = sol
                a,b = unit
                # (x1 + u1 sqrt7)*(a + b sqrt7) = (x1*a + 7*u1*b) + (x1*b + u1*a) sqrt7
                return (x1*a + 7*u1*b, x1*b + u1*a)
            
            unit = (8,3)  # fundamental solution to x^2 - 7 u^2 = 1
