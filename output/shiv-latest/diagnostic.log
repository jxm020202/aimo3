            def max_edges_havel_hakimi(n):
                caps = [i for i in range(1, n)] + [n-1]
                # sort descending caps with indices
                verts = sorted([(caps[i], i) for i in range(n)], key=lambda x: -x[0])
                # remaining capacities
                rem = [caps[i] for i in range(n)]
                edges = 0
                # We'll use a list for later vertices with remaining capacity >0
                # We'll maintain a pointer to next vertex
                for idx_i, (cap_i, i) in enumerate(verts):
                    # compute remaining capacity for i (may have been reduced by earlier connections)
                    if rem[i] <= 0:
                        continue
                    need = rem[i]
                    # connect to later vertices
                    for idx_j in range(idx_i+1, n):
                        if need <= 0:
                            break
                        _, j = verts[idx_j]
                        if rem[j] <= 0:
                            continue
                        # add edge
                        rem[i] -= 1
                        rem[j] -= 1
                        edges += 1
                        need -= 1
                return edges
            
