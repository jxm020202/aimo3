            def greedy_clique():
                # random start vertex
                v = random.randrange(n)
                clique = {v}
                # candidate set = neighbors of v
                candidates = set(adj[v])
                while candidates:
                    # choose a candidate that has max degree within candidates (heuristic)
                    # or random
                    # Let's pick one with max connections to others in candidates
                    best = None
                    best_score = -1
                    for u in candidates:
                        # number of neighbors of u within candidates
                        score = len(candidates & adj[u])
                        if score > best_score:
                            best_score = score
                            best = u
                    # add best
                    clique.add(best)
                    # update candidates to those adjacent to best
                    candidates = candidates & adj[best]
                return clique
            
