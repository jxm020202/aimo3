            import itertools, math
            
            def crt_pair(a_mods, moduli):
                # a_mods: list of residues for each modulus
                # moduli: list of moduli, pairwise coprime
                # returns integer modulo product
                M = math.prod(moduli)
                result = 0
                for ai, mi in zip(a_mods, moduli):
                    Mi = M // mi
                    # compute inverse of Mi modulo mi
                    inv = pow(Mi, -1, mi)
                    result = (result + ai * Mi * inv) % M
