            def max_edges_greedy(caps):
                # caps list length n
                n = len(caps)
                # list of remaining degrees
                rem = caps.copy()
                edges = 0
                # use a list of vertices with remaining degree >0
                while True:
                    # get vertices with remaining >0
                    verts = [i for i, d in enumerate(rem) if d > 0]
                    if len(verts) < 2:
                        break
                    # pick vertex with max remaining degree
                    i = max(verts, key=lambda x: rem[x])
                    d = rem[i]
                    # candidates other vertices with remaining >0, exclude i
                    candidates = [j for j in verts if j != i]
                    # sort candidates by remaining degree descending
                    candidates.sort(key=lambda x: rem[x], reverse=True)
                    d_prime = min(d, len(candidates))
                    # connect to first d_prime candidates
                    for j in candidates[:d_prime]:
                        rem[j] -= 1
                    rem[i] = 0  # used all its degree
                    edges += d_prime
                return edges
            
