            def triples_for_k(k, n_limit=500):
                results = []
                for a in range(1, k):
                    b = k - a
                    if math.gcd(a,b)!=1:
                        continue
                    for n in range(1, n_limit+1, 2): # odd n
                        if pow(a, n, n) + pow(b, n, n) == 0: # compute modulo n
                            results.append((n,a,b))
                return results
            
            def count_finite_k(max_k=100, n_limit=500):
                finite_k = []
                infinite_k = []
                for k in range(2, max_k+1):
                    triples = triples_for_k(k, n_limit)
                    # Determine if we suspect infinite: if we see many n beyond divisors of k
                    # Let's compute number of distinct n found.
                    ns = set(t[0] for t in triples)
                    # Count divisors of k that are odd
                    odd_divisors = [d for d in sp.divisors(k) if d%2==1]
                    # If there exists n not dividing k, mark as candidate infinite
                    extra = [n for n in ns if k % n != 0]
                    if extra:
                        infinite_k.append((k, extra[:5]))
                    else:
                        finite_k.append(k)
                return finite_k, infinite_k
            
