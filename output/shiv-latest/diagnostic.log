                            # center k
                            idx_xik = pair_index[(i,k)]
                            idx_xjk = pair_index[(j,k)]
                            idx_tij = pair_index[(i,j)]
                            row2 = np.zeros(total_vars)
                            row2[idx_xik] = 1
                            row2[idx_xjk] = 1
                            row2[m+idx_tij] = -1
                            A.append(row2)
                            b.append(1)
                A = np.array(A)
                b = np.array(b)
                # variable bounds: 0 <= var <= 1, integer
                bounds = Bounds(0, 1)
                integrality = np.ones(total_vars)
                # Solve MILP
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
