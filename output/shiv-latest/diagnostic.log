            def covering_radius_n_bruteforce(n):
                max_min = 0
                worst = None
                for bits in range(1 << (2*n-2)):
                    r = [(bits >> i) & 1 for i in range(n-1)]
                    c = [(bits >> (n-1 + i)) & 1 for i in range(n-1)]
                    w = min_weight_solution(n, r, c)
                    if w is None:
                        continue
                    if w > max_min:
                        max_min = w
                        worst = (r,c)
                return max_min, worst
            
