            def product_subgroup(p):
                # find primitive root
                for g in range(2,p):
                    # check if g is primitive
                    seen = set(pow(g,k,p) for k in range(1,p))
                    if len(seen) == p-1:
                        primitive = g
                        break
                # subgroup of index 2: generated by primitive^2
                sub = [pow(primitive, 2*k, p) for k in range((p-1)//2)]
                # compute product
                omega = cmath.exp(2j*math.pi/p)
                for j in range(1,p):
                    prod = 1
                    for a in sub:
                        prod *= (omega**(a*j) + 1)
                    # round
                    if abs(prod - 1) > 1e-6:
                        return False, j, prod
