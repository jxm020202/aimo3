            def max_edges_hh(n):
                caps = [min(i, n-1) for i in range(1, n+1)]
                caps.sort(reverse=True)
                import heapq
                heap = [-c for c in caps if c>0]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    d = -heapq.heappop(heap)
                    if d == 0:
                        continue
                    if d > len(heap):
                        d = len(heap)
                    temp = []
                    for _ in range(d):
                        nd = -heapq.heappop(heap)
                        nd -= 1
                        edges += 1
                        if nd > 0:
                            temp.append(-nd)
                    for val in temp:
                        heapq.heappush(heap, val)
                return edges
            
