            def feasible(signs):
                # signs list of +1 or -1 for each plane: +1 means a*x+b*y+c*z+d > 0, -1 means <0
                # Convert to linear constraints: a*x+b*y+c*z+d >= eps if sign=+1, <= -eps if sign=-1
                A = []
                b = []
                for (a,bcoef,c,d), s in zip(planes, signs):
