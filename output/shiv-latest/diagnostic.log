            def cycle_lengths(mapping):
                n = len(mapping)
                visited = [False]*(n+1)  # 1-indexed
                lengths = []
                for i in range(1,n+1):
                    if not visited[i]:
                        # follow cycle
                        cur = i
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = mapping[cur]
                            cnt += 1
                        lengths.append(cnt)
