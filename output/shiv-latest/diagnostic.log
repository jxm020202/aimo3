            # Build constraints
            rows = []
            lb = []
            ub = []
            
            # Cell constraints: sum <= 1
            for cell in cells:
                row = np.zeros(len(placements), dtype=int)
                for i in cell_to_placements[cell]:
                    row[i] = 1
                rows.append(row)
                lb.append(-np.inf)  # no lower bound
                ub.append(1)
            
            # Sliding constraints
            def placements_covering_cells(target_cells):
                # return set of placement indices that cover any of the target cells
                s = set()
                for cell in target_cells:
                    if cell in cell_to_placements:
                        s.update(cell_to_placements[cell])
                return s
            
            for i,pl in enumerate(placements):
                r,c = pl['pos']
                typ = pl['type']
                if typ == 'H':
                    # left slide
                    if c-1 >= 0:
                        target = [(r,c-1)]
                        T = placements_covering_cells(target)
                        # constraint: sum_{j in T} x_j >= x_i
                        row = np.zeros(len(placements), dtype=int)
                        for j in T:
                            row[j] = 1
                        row[i] -= 1  # bring x_i to RHS: sum - x_i >= 0
                        rows.append(row)
                        lb.append(0)
                        ub.append(np.inf)
                    # right slide
                    if c+2 < n:
                        target = [(r,c+2)]
                        T = placements_covering_cells(target)
