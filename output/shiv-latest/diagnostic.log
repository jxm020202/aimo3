            def min_weight_solution(n, r_vec, c_vec):
                # n: board size
                # r_vec length n-1 (for rows 1..n-1)
                # c_vec length n-1 (for columns 1..n-1)
                N = n*n
                # variable ordering: x_{i,j} flattened row-major
                # We'll use milp with c vector of ones for objective
                c_obj = np.ones(N, dtype=int)
                # constraints: each parity constraint expressed as sum - 2*y = b
                # We'll create A_eq matrix and b_eq for equality constraints.
                # We'll need additional integer variables y_i and z_j.
                # We'll treat them as continuous integer variables with bounds.
                # We'll build A_eq for all constraints.
                # Number of constraints = (n-1)+(n-1) = 2n-2
                # We'll have extra variables: y_i for each row constraint (n-1), z_j for each column constraint (n-1)
                # total variables = N + (2n-2)
                total_vars = N + (2*n-2)
                # Build A_eq as list of rows (sparse)
                A_eq = []
                b_eq = []
                # Row constraints for i=1..n-1
                for i in range(1, n):
                    coeff = np.zeros(total_vars, dtype=int)
                    # sum over row0
                    for j in range(n):
                        coeff[0*n + j] = 1
                    # sum over row i
                    for j in range(n):
                        coeff[i*n + j] = 1
                    # y_i variable index:
                    y_idx = N + (i-1)  # first n-1 y's
                    coeff[y_idx] = -2
                    A_eq.append(coeff)
                    b_eq.append(r_vec[i-1] % 2)
                # Column constraints for j=1..n-1
                for j in range(1, n):
                    coeff = np.zeros(total_vars, dtype=int)
                    # sum over column j
                    for i in range(n):
                        coeff[i*n + j] = 1
                    # sum over row0
                    for jj in range(n):
                        coeff[0*n + jj] = 1
                    # z_j variable index:
                    z_idx = N + (n-1) + (j-1)  # after y's
                    coeff[z_idx] = -2
                    A_eq.append(coeff)
                    b_eq.append(c_vec[j-1] % 2)
                # variable bounds: x binary (0,1), y,z integer between 0 and n (since sum max 2n)
                bounds = [(0,1)]*N + [(0, n)]*(2*n-2)
                # integer constraints: all variables integer, but x binary enforced by bounds.
                integrality = np.arange(total_vars)  # all variables integer
                # Use milp
                res = opt.milp(c=c_obj, A_eq=np.array(A_eq), b_eq=np.array(b_eq), bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    # If infeasible, return None
                    return None
                return int(res.fun)
            
