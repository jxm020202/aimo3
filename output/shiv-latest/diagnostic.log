            import sympy as sp
            
            def find_uv(m):
                u, v = sp.symbols('u v')
                # compute T_e recursively
                T = {0: 2, 1: u}
                equations = []
                for e in range(1, m+1):
                    if e not in T:
                        # compute using recurrence
                        T[e] = u*T[e-1] - v*T[e-2]
                    # condition: v**e + T[e] = 0
                    equations.append(sp.Eq(v**e + T[e], 0))
                # solve system
                sol = sp.solve(equations, (u, v), dict=True)
                return sol
            
            for m in range(1,7):
                sol = find_uv(m)
                print(m, sol)
            
