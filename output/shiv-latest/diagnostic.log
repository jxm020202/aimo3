                        # directed arcs both ways
                        arcs.append((i,j))
                        lengths[(i,j)] = 2**k
                m = len(arcs)
                # variables: x (binary) for each arc, z_i (binary) for endpoint (i !=0), u_i (continuous) for order
                # total variables: m + (N-1) + N (order)
                # index mapping
                idx_x = {arc:i for i,arc in enumerate(arcs)}
                idx_z = {}
                for i in range(1,N):
                    idx_z[i] = m + (i-1)
                idx_u = {}
                for i in range(N):
                    idx_u[i] = m + (N-1) + i
                total_vars = m + (N-1) + N
                # objective: sum x_{i,j} * (1/length)
                c = np.zeros(total_vars)
                for arc, i in idx_x.items():
                    length = lengths[arc]
                    c[i] = 1.0/length
                # integrality: x binary, z binary, u continuous
                integrality = np.zeros(total_vars, dtype=int)
