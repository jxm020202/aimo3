            def max_edges_with_caps(n):
                caps = [i for i in range(1, n)] + [n-1]
                import heapq
                # Use max-heap of (remaining degree, vertex)
                heap = [(-deg, v) for v, deg in enumerate(caps) if deg>0]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    deg_u, u = heapq.heappop(heap)
                    deg_u = -deg_u
                    if deg_u == 0:
                        break
                    # need to connect u to deg_u other vertices with positive remaining degree
                    # collect neighbors
                    neighbors = []
                    for _ in range(deg_u):
                        if not heap:
                            # cannot fulfill remaining degree, break
                            break
                        deg_v, v = heapq.heappop(heap)
                        deg_v = -deg_v
                        # connect u-v
                        edges += 1
                        deg_v -= 1
                        neighbors.append((deg_v, v))
                    # u's degree becomes 0 (used all)
                    # push back neighbors with remaining degree >0
                    for deg_v, v in neighbors:
                        if deg_v > 0:
                            heapq.heappush(heap, (-deg_v, v))
