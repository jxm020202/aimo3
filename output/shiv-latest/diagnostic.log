            def brute_min_m_or(rows, cols):
                dominos = []
                for r in range(rows):
                    for c in range(cols-1):
                        dominos.append(('H', r, c, [(r,c), (r,c+1)]))
                for r in range(rows-1):
                    for c in range(cols):
                        dominos.append(('V', r, c, [(r,c), (r+1,c)]))
                n = len(dominos)
                max_dom = (rows*cols)//2
                for m in range(1, max_dom+1):
                    for combo in itertools.combinations(range(n), m):
                        # non-overlap
                        occupied = set()
                        ok = True
                        for idx in combo:
                            for cell in dominos[idx][3]:
                                if cell in occupied:
                                    ok = False
                                    break
                                occupied.add(cell)
                            if not ok:
