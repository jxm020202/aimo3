            def gray_code(n):
                # returns list of integers 0..2^n-1 in Gray code order
                return [i ^ (i>>1) for i in range(1<<n)]
            
            def bit_reverse(x, n):
                rev = 0
                for i in range(n):
                    rev = (rev<<1) | ((x>>i)&1)
                return rev
            
            def optimal_path_by_bitreverse(n):
                seq = [bit_reverse(g, n) for g in gray_code(n)]
                return seq
            
            def flip_counts(seq):
                n = max(seq).bit_length()
                counts = [0]*n
                for i in range(1,len(seq)):
                    diff = seq[i]^seq[i-1]
                    # diff is power of two
                    k = diff.bit_length()-1
                    counts[k] += 1
                return counts
            
