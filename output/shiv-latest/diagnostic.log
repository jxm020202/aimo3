            from itertools import combinations
            
            def generate_rows(n, half):
                rows = []
                for cols in combinations(range(n), half):
                    row = [0]*n
                    for c in cols:
                        row[c]=1
                    rows.append(row)
                return rows
            
            def search(n):
                half = n//2
                rows = generate_rows(n, half)
                # Precompute row vectors as numpy arrays for speed
                rows_np = [np.array(r, dtype=int) for r in rows]
                solutions = []
                # Use recursion with partial matrix
                col_sums = [0]*n
                matrix = []
                def backtrack(r_idx):
                    if r_idx == n:
                        # full matrix built, check condition
                        A = np.array(matrix)
                        if np.array_equal(A.dot(A) + half*A, half*np.ones((n,n), dtype=int)):
                            solutions.append(A.copy())
                        return
                    # prune: column sums cannot exceed half
                    for row_vec in rows_np:
                        # check column sum constraints
                        ok = True
                        for j in range(n):
                            if col_sums[j] + row_vec[j] > half:
                                ok = False
                                break
                        if not ok:
                            continue
                        # assign
                        matrix.append(row_vec)
                        for j in range(n):
                            col_sums[j] += row_vec[j]
                        backtrack(r_idx+1)
                        # undo
                        for j in range(n):
                            col_sums[j] -= row_vec[j]
                        matrix.pop()
                backtrack(0)
                return solutions
            
            sol6 = search(6)
            len(sol6)
