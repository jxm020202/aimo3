            def exists_SCC_two_vertices(L=3, max_val=2):
                # generate all possible (L-1)-tuples with values in range(-max_val,max_val+1)
                vals = list(range(-max_val, max_val+1))
                vertices = list(itertools.product(vals, repeat=L-1))
                for A in vertices:
                    for B in vertices:
                        if A==B:
                            continue
                        # compute possible successors for each vertex based on possible x values that result in vertex in {A,B}
                        # we need to define a set of blocks (edges) such that each vertex has at least one outgoing edge (maybe multiple)
                        # We can choose any x that yields successor in {A,B}.
                        # For each vertex V, possible successors are those W in {A,B} where V[1:]==W[:L-2]
                        # Actually for L=3, L-2 =1. So we need V[1] == W[0].
                        succ = {}
                        for V in (A,B):
                            possible=[]
                            for W in (A,B):
                                if V[1]==W[0]:
                                    possible.append(W)
                            succ[V]=possible
                        # need each vertex to have at least one possible successor (nonempty)
                        if any(len(s)==0 for s in succ.values()):
                            continue
                        # need at least one vertex with at least two possible successors (branching)
                        if not any(len(s)>=2 for s in succ.values()):
                            continue
                        # need SCC: graph must be strongly connected using possible edges (choose at least one edge per possible successor)
                        # Since we can select any subset of edges as long as each vertex has at least one outgoing edge, we can try to select edges to ensure strong connectivity.
                        # We'll brute over subsets of edges: for each vertex, choose one of its possible successors as the edge to include (or both).
                        # Let's generate all combinations of picking for each vertex a nonempty subset of its possible successors.
                        Vlist=[A,B]
                        # generate all subsets for each vertex (excluding empty)
                        choices=[]
                        for V in Vlist:
                            subs=[]
                            for r in range(1, len(succ[V])+1):
                                for combo in itertools.combinations(succ[V], r):
                                    subs.append(combo)
                            choices.append(subs)
                        for selA in choices[0]:
                            for selB in choices[1]:
                                # build graph
                                G=collections.defaultdict(set)
                                for W in selA:
                                    G[A].add(W)
                                for W in selB:
                                    G[B].add(W)
                                # check strong connectivity (both vertices reachable from each other)
                                # BFS from A
                                def reachable(start):
                                    seen=set([start])
                                    stack=[start]
                                    while stack:
                                        v=stack.pop()
                                        for w in G[v]:
                                            if w not in seen:
                                                seen.add(w); stack.append(w)
                                    return seen
                                if B in reachable(A) and A in reachable(B):
                                    return True, (A,B), (succ, G)
                return False, None, None
            
