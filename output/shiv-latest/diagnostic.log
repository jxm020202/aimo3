            def last_nonzero_digit(n):
                # compute factorial and strip zeros
                res=1
                for i in range(2,n+1):
                    res*=i
                    while res%10==0:
                        res//=10
                    res%=10**12  # keep manageable
                return res%10
            
            def L(n):
                # using recurrence
                if n==0:
                    return 1
                # recursion
                # compute using sympy? Let's implement iterative
                res=1
                while n>0:
                    # multiply by product of numbers 1..n%5 ignoring zeros
                    # L_small = [1,1,2,6,4]
                    small = [1,1,2,6,4][n%5]
                    res = (res * small) % 10
                    # multiply by 2^{n//5}
                    exp = n//5
                    # compute 2^exp mod 10
                    # note phi(10)=4, but 2 and 10 not coprime; pattern of 2^k mod 10 repeats every 4 after k>=1: 2,4,8,6
                    # We'll compute directly
                    res = (res * pow(2, exp, 10)) % 10
                    n //=5
                return res
            
            # test
            for i in range(1,31):
                print(i, L(i), last_nonzero_digit(i))
            
