            def random_point_on_sphere():
                # generate random point uniformly on sphere of radius sqrt(3)
                # using normal distribution
                v = np.random.normal(size=3)
                v = v / np.linalg.norm(v) * math.sqrt(3)
                return v
            
            def find_near_solutions(num_samples=200000, tol=1e-6):
                sols = []
                for _ in range(num_samples):
                    x,y,z = random_point_on_sphere()
                    val = x*y**3 + y*z**3 + z*x**3
                    if abs(val - 3) < tol:
                        sols.append((x,y,z))
                return sols
            
