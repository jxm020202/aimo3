            import random, itertools, math
            
            def random_triangle_free_graph(n, p=0.5):
                # generate random graph and reject if triangle appears, else return adjacency set
                # simple approach: start with empty, add edges randomly while maintaining triangle-free
                edges=set()
                # order of all possible edges
                all_edges=[(i,j) for i in range(n) for j in range(i+1,n)]
                random.shuffle(all_edges)
                for (i,j) in all_edges:
                    if random.random()<p:
                        # check if adding would create triangle
                        # any vertex k such that (i,k) and (j,k) in edges?
                        triangle=False
                        for k in range(n):
                            if k!=i and k!=j:
                                if ((i,k) in edges or (k,i) in edges) and ((j,k) in edges or (k,j) in edges):
                                    triangle=True
                                    break
                        if not triangle:
                            edges.add((i,j))
                return edges
            
            def compute_f(edges,n):
                # edges is set of (i,j) with i<j
                # compute forced edges
                forced=set()
                # adjacency list
                adj=[set() for _ in range(n)]
                for i,j in edges:
                    adj[i].add(j)
                    adj[j].add(i)
                for w in range(n):
                    neigh=list(adj[w])
                    for a in range(len(neigh)):
                        for b in range(a+1,len(neigh)):
                            u,v=neigh[a],neigh[b]
                            if u>v: u,v=v,u
                            forced.add((u,v))
                f=len(edges)-len(forced)
                return f
            
            def test_random(n, trials=1000):
                max_f=-1
                for _ in range(trials):
                    edges=random_triangle_free_graph(n, p=0.5)
                    f=compute_f(edges,n)
                    max_f=max(max_f,f)
