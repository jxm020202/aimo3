            def sign_stats(samples=10000):
                pos = neg = zero = 0
                for _ in range(samples):
                    v = np.random.normal(size=3)
                    v = v / np.linalg.norm(v) * math.sqrt(3)
                    x,y,z = v
                    val = x*y**3 + y*z**3 + z*x**3 - 3
                    if abs(val) < 1e-8:
                        zero += 1
                    elif val > 0:
                        pos += 1
                    else:
