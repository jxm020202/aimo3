                        if r+1 <= n:
                            neighbor_groups.append([(r+1, c), (r+1, c+1)])
                    else:
                        if r-1 >= 1:
                            neighbor_groups.append([(r-1, c)])
                        if r+2 <= n:
                            neighbor_groups.append([(r+2, c)])
                        if c-1 >= 1:
                            neighbor_groups.append([(r, c-1), (r+1, c-1)])
                        if c+1 <= n:
                            neighbor_groups.append([(r, c+1), (r+1, c+1)])
                    for group in neighbor_groups:
                        if strict:
                            for cell in group:
                                row = np.zeros(num_vars, dtype=int)
                                for idx in cell_to_dominos.get(cell, []):
                                    row[idx] = 1
                                row[i] -= 1
                                rows.append(row)
                                lbs.append(0)
