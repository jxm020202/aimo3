            import mpmath as mp
            
            def PT_length(L):
                # L = side length for QR, RS, ST (float)
                # angle at P = 90°, Q=105°, R=90°, PQ=2.
                # Use orientation as before (left turn at Q and R)
                # unknown phi (turn at S)
                # Solve for phi such that final x coordinate is 0.
                # Use mpmath find root.
                def f(phi):
                    # compute final x coordinate
                    # direction angles
                    theta0 = 0
                    theta1 = mp.radians(105)
                    theta2 = theta1 + mp.radians(90)
                    theta3 = theta2 + phi
                    # start at P (0,0), Q (2,0)
                    x = 2
                    y = 0
                    # add QR
                    x += L*mp.cos(theta1)
                    y += L*mp.sin(theta1)
                    # add RS
                    x += L*mp.cos(theta2)
                    y += L*mp.sin(theta2)
                    # add ST
                    x += L*mp.cos(theta3)
                    y += L*mp.sin(theta3)
                    return x  # we need x=0
                # initial guess phi near -1 rad
                phi_root = mp.findroot(f, -1)
                # compute final y (PT length)
                theta1 = mp.radians(105)
                theta2 = theta1 + mp.radians(90)
                theta3 = theta2 + phi_root
                x = 2 + L*mp.cos(theta1) + L*mp.cos(theta2) + L*mp.cos(theta3)
                y = 0 + L*mp.sin(theta1) + L*mp.sin(theta2) + L*mp.sin(theta3)
                return abs(y), phi_root
            
            PT_len, phi_val = PT_length(math.sqrt(2))
            PT_len, phi_val
            
