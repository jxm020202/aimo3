            def max_edges_upper_bounds(n):
                # bounds: for i from 1..n, bound = i except for i=n bound = n-1
                # Process vertices descending
                import heapq
                heap = []  # min-heap of remaining capacities of processed vertices
                total_edges = 0
                # processed vertices will have capacities left after connections
                for i in range(n, 0, -1):
                    bound = i if i < n else n-1
                    # sum of remaining capacities in heap
                    # we will connect to up to bound edges
                    # we need to choose vertices with smallest remaining capacity
                    # We'll pop up to bound times
                    connections = 0
