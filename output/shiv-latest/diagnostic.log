            import random, math
            
            def local_search(N, steps=100000):
                # start with p=N//3 at 2, rest at -1 (if N divisible by 3)
                p = N//3
                xs = [2]*p + [-1]*(N-p)
                # adjust if sum not zero due to integer rounding (should be zero)
                # compute sum
                s = sum(xs)
                # ensure zero
                if abs(s) > 1e-9:
                    # adjust one variable
                    xs[0] -= s
                best = sum(x**3 for x in xs)
                best_xs = xs[:]
                for _ in range(steps):
                    # pick two indices i (positive) and j (negative) to swap small epsilon
                    i = random.randrange(N)
                    j = random.randrange(N)
                    if i==j: continue
                    # propose small delta
                    eps = random.uniform(-0.1,0.1)
                    # propose new values
                    xi = xs[i] + eps
                    xj = xs[j] - eps
                    # ensure bounds
                    if xi < -2 or xi > 2 or xj < -2 or xj > 2:
                        continue
                    # check sum constraint: sum unchanged because we added eps to i and sub eps from j
                    # compute new objective
                    new_val = sum(x**3 for x in xs) + (xi**3 - xs[i]**3) + (xj**3 - xs[j]**3)
                    if new_val > best + 1e-9:
                        # accept
                        xs[i] = xi
                        xs[j] = xj
                        best = new_val
                        best_xs = xs[:]
                return best, best_xs
            
