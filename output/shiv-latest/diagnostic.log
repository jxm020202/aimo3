            def compute_sum(points):
                n = len(points)
                total = 0
                for i, (xi, yi) in enumerate(points):
                    # compute angles to other points
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        angle = math.atan2(yj-yi, xj-xi) # -pi to pi
                        angles.append(angle)
                    # sort angles
                    angles = sorted(angles)
                    # duplicate with +2pi for circular wrap
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window to find max points within 100 degrees = 100*pi/180 rad
                    limit = 100*math.pi/180
                    maxcnt = 0
                    j = 0
                    for k in range(len(angles)):
                        while j < len(angles2) and angles2[j] - angles2[k] <= limit + 1e-12:
                            j+=1
                        cnt = j - k
                        if cnt>maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
