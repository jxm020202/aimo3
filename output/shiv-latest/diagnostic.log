            def can_slide(dom_idx, direction, placement_set):
                # placement_set: set of indices of placed dominos
                typ, cells = dominos[dom_idx]
                (r0,c0),(r1,c1) = cells
                # Determine new cells after moving one step in direction
                if direction == 'left':
                    # move left by 1: new cells = (r0,c0-1) and (r1,c1-1) ??? Wait for horizontal domino, r0=r1, c1=c0+1
                    # For any domino, moving left shifts both cells left by 1.
                    new_cells = [(r0, c0-1), (r1, c1-1)]
                elif direction == 'right':
                    new_cells = [(r0, c0+1), (r1, c1+1)]
                elif direction == 'up':
                    new_cells = [(r0-1, c0), (r1-1, c1)]
                elif direction == 'down':
                    new_cells = [(r0+1, c0), (r1+1, c1)]
                else:
                    raise ValueError
                # Check if new cells are within board
                for (r,c) in new_cells:
                    if not (0 <= r < n and 0 <= c < n):
                        # moving off board not allowed (slide impossible)
                        return False
                # For slide to be possible, both new cells must be empty (not occupied by any domino in placement_set)
                # Determine occupied cells by other dominos (excluding current)
                occupied = set()
                for j in placement_set:
                    if j == dom_idx:
                        continue
                    for cell in dominos[j][1]:
                        occupied.add(cell)
                # Check if any new cell is occupied
                for cell in new_cells:
                    if cell in occupied:
                        return False
                # Also need to ensure that the cells vacated by the domino become empty? That's fine.
                return True
            
            def is_blocked_solution(sol_set):
                for idx in sol_set:
                    for dirc in ['left','right','up','down']:
                        if can_slide(idx, dirc, sol_set):
                            # slide possible
                            return False, (idx, dirc)
                return True, None
            
            blocked, info = is_blocked_solution(set(indices))
            blocked, info
            
