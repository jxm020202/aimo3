                A.append(row)
                b_eq.append(target)
                # adjacency constraints: for each vertical edge between cell (i,j) and (i+1,j)
                # index mapping: cell index = i*n + j (0-index)
                # binary variable index for vertical edges: start after N cells
                # We'll assign order: first vertical edges, then horizontal edges
                # vertical edge binary index k = i*n + j (i from 0..n-2, j 0..n-1)
                # constraint: x_{i+1,j} - x_{i,j} = 1 - 2*b_k
                # i.e., x_{i+1,j} - x_{i,j} - 1 + 2*b_k = 0
                for i in range(n-1):
                    for j in range(n):
                        idx1 = i*n + j
                        idx2 = (i+1)*n + j
                        b_idx = N + i*n + j
                        row = np.zeros(M)
                        row[idx2] = 1
                        row[idx1] = -1
                        row[b_idx] = 2
                        # constant term -1 moved to RHS
                        A.append(row)
                        b_eq.append(1)  # because we moved -1 to RHS? Let's derive:
                        # equation: x2 - x1 = 1 - 2*b => x2 - x1 -1 +2*b =0 => x2 - x1 +2*b =1
                        # So RHS = 1
                # horizontal edges: between (i,j) and (i,j+1)
                # binary index after vertical edges: base = N + v_edges
                for i in range(n):
                    for j in range(n-1):
                        idx1 = i*n + j
                        idx2 = i*n + (j+1)
                        b_idx = N + v_edges + i*(n-1) + j
                        row = np.zeros(M)
                        row[idx2] = 1
                        row[idx1] = -1
                        row[b_idx] = 2
                        A.append(row)
                        b_eq.append(1)
                # Convert to numpy arrays
                A = np.array(A)
                b_eq = np.array(b_eq)
                # Linear constraints: equality constraints
                lin_con = LinearConstraint(A, b_eq, b_eq)
                # Solve MILP
                res = milp(c=c, constraints=[lin_con], bounds=bounds, integrality=np.arange(N, M))
                # integrality indices: from N to M-1 (binary vars)
                return res.success
            
