            import math
            
            def minimal_S():
                T = 1997
                best = None
                best_params = None
                for j in range(1, 39):  # j from 1 to 38 inclusive
                    r = 38 - j
                    A_min = (j-1)*j//2
                    # a must be >= j
                    # total_min = A_min + a*(1+r) + r*(r+1)//2
                    # compute max a such that total_min <= T
                    # solve for a: a*(1+r) <= T - A_min - r*(r+1)//2
                    max_a = (T - A_min - r*(r+1)//2) // (1+r)  # floor
                    # a must be at least j
                    for a in range(j, max_a+1):
                        total_min = A_min + a*(1+r) + r*(r+1)//2
                        if total_min > T:
                            continue
                        delta = T - total_min
                        tail_min = r*a + r*(r+1)//2
                        x_max = (j-1)*(a - j)  # capacity for prefix extra
                        # feasible x range: 0 <= x <= min(x_max, delta)
                        max_x = min(x_max, delta)
                        # compute optimal x
                        # intersection point:
                        x_star = (tail_min + delta - A_min) / 2.0
                        # clamp to feasible integer range
                        # we need integer x, try floor and ceil within range
                        candidates = []
                        for x in [math.floor(x_star), math.ceil(x_star), 0, max_x]:
                            if x < 0: continue
                            if x > max_x: continue
                            # compute S
                            S = max(A_min + x, tail_min + delta - x)
                            candidates.append((S, x))
                        # also consider x = max_x maybe if max_x not integer? Already considered.
                        # choose minimal S among candidates
                        if not candidates:
                            continue
                        S_min = min(c[0] for c in candidates)
                        if best is None or S_min < best:
                            best = S_min
                            best_params = (j, a, A_min, tail_min, delta, x_max, candidates)
                return best, best_params
            
