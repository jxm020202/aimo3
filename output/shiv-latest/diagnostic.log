            def canonical_line(line):
                # line is sympy Line3D
                p1 = line.p1
                p2 = line.p2
                d = sp.Matrix([p2.x - p1.x, p2.y - p1.y, p2.z - p1.z])
                d = sp.nsimplify(d)
                # normalize direction to primitive integer vector
                denoms = [sp.denom(comp) for comp in d]
                lcm = sp.ilcm(*denoms)
                d_int = [int(comp * lcm) for comp in d]
                # reduce by gcd
                from math import gcd
                g = 0
                for val in d_int:
                    g = gcd(g, abs(val))
                if g != 0:
                    d_int = [val // g for val in d_int]
                # ensure first non-zero positive
                for val in d_int:
                    if val != 0:
                        if val < 0:
                            d_int = [-v for v in d_int]
                        break
                # point: use p1 rational coordinates
                pt = (sp.nsimplify(p1.x), sp.nsimplify(p1.y), sp.nsimplify(p1.z))
                return (tuple(d_int), pt)
            
            def dedup_lines(lines):
                uniq = {}
                for line in lines:
                    key = canonical_line(line)
                    uniq[key] = line
                return list(uniq.values())
            
