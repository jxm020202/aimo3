            import random, math, numpy as np
            
            def random_point_on_sphere():
                v = np.random.normal(size=3)
                v = v / np.linalg.norm(v) * math.sqrt(3)
                return v
            
            def F_val(pt):
                x,y,z = pt
                return x*y**3 + y*z**3 + z*x**3
            
            def sample_max(n=200000):
                max_val = -1e9
                max_pt = None
                for _ in range(n):
                    pt = random_point_on_sphere()
                    val = F_val(pt)
                    if val > max_val:
                        max_val = val
                        max_pt = pt
                return max_val, max_pt
            
            max_val, max_pt = sample_max(200000)
