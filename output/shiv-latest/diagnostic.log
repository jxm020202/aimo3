            def D_formula(n):
                # compute using base-5 digits
                d = [1,1,2,6,4]
                # compute product of d[digits]
                prod = 1
                m = n
                while m > 0:
                    prod = (prod * d[m % 5]) % 10
                    m //= 5
                # exponent of 2 is v5(n)
                v5 = 0
                p = 5
                while p <= n:
                    v5 += n // p
                    p *= 5
                return (prod * pow(2, v5, 10)) % 10
            
            # test against D_rec for many n
            ok = all(D_formula(i) == D_rec(i) for i in range(0,2000))
