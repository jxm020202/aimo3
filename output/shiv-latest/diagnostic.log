            from collections import deque
            
            def min_moves(n):
                # n coins, initial pattern: tails on odd positions (1-indexed)
                # Represent state as bitmask of length n: 1 = tail, 0 = head
                init = 0
                for i in range(n):
                    if (i+1)%2==1:  # odd
                        init |= (1<<i)
                target = 0
                # BFS
                # state: (pos, mask)
                # pos: index of last flipped coin (0-indexed)
                # For first move, we can flip any coin: treat as starting from each possible pos after flipping.
                visited = set()
                dq = deque()
                for pos in range(n):
                    mask = init ^ (1<<pos)  # flip that coin
                    visited.add((pos, mask))
                    dq.append((pos, mask, 1))
                while dq:
                    pos, mask, steps = dq.popleft()
                    if mask == target:
                        return steps
                    # next moves: flip adjacent coin
                    for np in [pos-1, pos+1]:
                        if 0 <= np < n:
                            newmask = mask ^ (1<<np)
                            state = (np, newmask)
                            if state not in visited:
                                visited.add(state)
                                dq.append((np, newmask, steps+1))
                return None
            
            for n in range(1,13,2):  # odd n
                print(n, min_moves(n))
            
