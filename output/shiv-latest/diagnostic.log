            import itertools, math
            
            def all_graphs_n(n):
                vertices = list(range(n))
                edges_list = list(itertools.combinations(vertices,2))
                m = len(edges_list)
                for bits in range(1<<m):
                    edges = set()
                    for i, e in enumerate(edges_list):
                        if bits & (1<<i):
                            edges.add(frozenset(e))
                    yield edges
            
            def max_x_minus_C_bruteforce(n):
                max_val = -1
                best = None
                for edges in all_graphs_n(n):
                    if not is_triangle_free(edges, n):
                        continue
                    val = compute_x_minus_C(edges, n)
                    if val > max_val:
                        max_val = val
                        best = edges
                return max_val, best
            
