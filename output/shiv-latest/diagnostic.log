            def min_moves(N):
                # Variables: f_i for i=1..N-1 (edges), integer >=0
                # s_i, t_i binary for i=1..N
                # z_i integer >=0 for i=1..N
                # We'll use MILP via scipy.optimize.milp
                # Number of variables:
                num_f = N-1
                num_s = N
                num_t = N
                num_z = N
                # variable ordering: f (0..num_f-1), s (next), t, z
                total_vars = num_f + num_s + num_t + num_z
                # bounds
                bounds = [(0, None)]*total_vars
                # integer indices: all variables are integer, but s and t are binary
                int_vars = list(range(total_vars))
                # constraints:
                A_eq = []
                b_eq = []
                # For each vertex i (1-indexed)
                for i in range(1, N+1):
                    row = [0]*total_vars
                    # f_{i-1} if i>1
                    if i > 1:
                        row[i-2] = 1  # f_{i-1} index i-2 (since f_1 at index0)
                    # f_i if i<N
                    if i < N:
                        row[i-1] = 1  # f_i index i-1
                    # s_i
                    row[num_f + (i-1)] = 1
                    # t_i
                    row[num_f + num_s + (i-1)] = 1
                    # RHS = 4*z_i + 2*p_i
                    # We'll move 4*z_i to LHS: -4*z_i + ... = 2*p_i
                    row[num_f + num_s + num_t + (i-1)] = -4
                    # RHS
                    p_i = 1 if i%2==1 else 0
                    b = 2*p_i
                    A_eq.append(row)
                    b_eq.append(b)
                # start and end constraints: sum s_i = 1, sum t_i = 1
                row = [0]*total_vars
                for i in range(N):
                    row[num_f + i] = 1
                A_eq.append(row)
                b_eq.append(1)
                row = [0]*total_vars
                for i in range(N):
                    row[num_f + num_s + i] = 1
                A_eq.append(row)
                b_eq.append(1)
                # objective: minimize sum f_i
                c = [1 if i < num_f else 0 for i in range(total_vars)]
                # Convert to scipy format
                A_eq = np.array(A_eq, dtype=float)
                b_eq = np.array(b_eq, dtype=float)
                # Use milp
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A_eq, b_eq, b_eq), bounds=bounds, integrality=int_vars, options={"presolve": True, "disp": False})
                if not res.success:
                    print("MILP failed", res.message)
                    return None
                f_vals = res.x[:num_f]
                total_f = sum(f_vals)
                L = total_f + 1
                # return integer L
                return int(round(L))
            
