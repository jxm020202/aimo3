            def improve_set(ind_set):
                # ind_set is set of vertices
                changed = True
                while changed:
                    changed = False
                    # try each vertex not in set
                    for v in range(N):
                        if v in ind_set: continue
                        # count conflicts with current set
                        conflicts = len(forbidden_adj[v] & ind_set)
                        if conflicts == 0:
                            # can add without removal
                            ind_set.add(v)
                            changed = True
                            break
                        elif conflicts == 1:
                            # net gain 0 (remove 1 add 1) not beneficial
                            continue
                        else:
                            # if conflicts > 1, removing them reduces size more than adding
                            continue
                return ind_set
            
            best = set()
            for _ in range(500):
                s = greedy_independent()
                s = improve_set(s)
                if len(s) > len(best):
                    best = s
                    print("new best", len(best))
            print("final best size", len(best))
            
