            from functools import lru_cache
            import math, itertools
            
            def max_ops_exact(N):
                # encode pair index mapping
                pairs=[]
                pair_index={}
                idx=0
                for i in range(1,N):
                    for j in range(i+1,N+1):
                        pairs.append((i,j))
                        pair_index[(i,j)]=idx
                        idx+=1
                total_pairs=idx
                # initial coin tuple
                init = tuple(i for i in range(1,N+1))
                @lru_cache(maxsize=None)
                def dfs(state, used_mask):
                    # state is tuple of coin counts length N (index 0 corresponds to pile 1)
                    best=0
                    # try each unused pair
                    for p_idx,(i,j) in enumerate(pairs):
                        if used_mask>>p_idx & 1:
                            continue
                        a=state[i-1]
                        b=state[j-1]
                        if a==0 or b==0:
                            continue
                        g=math.gcd(a,b)
                        if g==0:
                            continue
                        # apply operation
                        new_state=list(state)
                        new_state[i-1]=a-g
                        new_state[j-1]=b-g
                        new_state=tuple(new_state)
                        val=1+dfs(new_state, used_mask | (1<<p_idx))
                        if val>best:
                            best=val
                    return best
                return dfs(init,0)
            
            for N in range(2,8):
                print(N, max_ops_exact(N))
            
