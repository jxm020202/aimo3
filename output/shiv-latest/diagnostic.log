            def max_edges_milp(n):
                caps = [i for i in range(1,n)] + [n-1]
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                c = -np.ones(m)  # maximize sum
                # Build constraint matrix
                rows = []
                cols = []
                data = []
                for idx, (u,v) in enumerate(edges):
                    rows.append(u); cols.append(idx); data.append(1)
                    rows.append(v); cols.append(idx); data.append(1)
                A = sp.csr_matrix((data, (rows, cols)), shape=(n, m))
                bounds = opt.Bounds(0, 1)
                constraints = opt.LinearConstraint(A, -np.inf, caps)
                res = opt.milp(c=c, constraints=constraints, integrality=np.ones(m), bounds=bounds, options={'disp': False})
                if not res.success:
                    print("MILP failed", res.message)
                    return None
                max_edges = -res.fun
                return int(round(max_edges))
            
