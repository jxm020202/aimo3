            def R(z):
                # compute R(z) using mp.harmonic
                # z must be positive integer
                H = mp.harmonic
                # Use mp.harmonic for integer; but for large maybe use digamma
                # We'll use mp.harmonic which uses digamma internally.
                N = 2*z - 1
                H2z_1 = H(N)
                H_z_1 = H(z-1) if z>1 else mp.mpf(0)  # H_0 = 0
                Nnum = 2*(H2z_1 - H_z_1) - mp.mpf(1)/z
                Dden = 2*(H(2*z) - H(z)) / (3*z + 1)
                return Nnum / Dden
            
            def R_alt(z):
                # using digamma
                gamma = mp.euler
                def Hn(n):
                    if n==0:
                        return mp.mpf(0)
                    return mp.digamma(n+1) + gamma
                H2z_1 = Hn(2*z-1)
                H_z_1 = Hn(z-1)
                Nnum = 2*(H2z_1 - H_z_1) - mp.mpf(1)/z
                Dden = 2*(Hn(2*z) - Hn(z)) / (3*z + 1)
                return Nnum / Dden
            
