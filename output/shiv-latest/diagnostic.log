            import itertools, numpy.linalg as la
            
            def intersection_type(triple):
                # triple: indices
                A = []
                b = []
                for idx in triple:
                    a,b_,c,d = planes[idx]
                    A.append([a,b_,c])
                    b.append(-d)  # because equation a x + b y + c z + d = 0 => a x + b y + c z = -d
                A = np.array(A, dtype=float)
                b = np.array(b, dtype=float)
                # compute rank
                rank = np.linalg.matrix_rank(A)
                if rank == 3:
                    # unique point
                    sol = np.linalg.solve(A, b)
                    return "point", sol
                elif rank == 2:
                    # line (infinite solutions)
                    return "line", None
                else:
                    # maybe coincident planes (rank<2)
                    return "none", None
            
