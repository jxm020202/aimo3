            def find_sequence_target(n, target):
                total_pairs = [(i,j) for i in range(1,n+1) for j in range(i+1,n+1)]
                m=len(total_pairs)
                from functools import lru_cache
                @lru_cache(None)
                def dfs(counts, used_mask, steps):
                    if steps==target:
                        return []  # success
                    # prune: if remaining possible pairs < target-steps, fail
                    remaining_pairs = m - bin(used_mask).count("1")
                    if remaining_pairs < target-steps:
                        return None
                    # try each possible pair
                    for idx in range(m):
