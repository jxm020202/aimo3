            def generate_pretty_pairs(k, max_m=None, max_n=None):
                pretty = set()
                for d in sp.divisors(k):
                    k_prime = k // d
                    # m' must divide k_prime
                    for m_prime in sp.divisors(k_prime):
                        t = k_prime // m_prime  # integer >=1
                        # condition: n' > m'*(t-1)
                        lower = m_prime * (t - 1) + 1  # strictly greater, so >= lower
                        # n' can be arbitrarily large, but we limit by max_n if given
                        # We'll iterate n' up to some limit
                        # Let's set an upper bound for n' based on max_n/d if max_n given, else some default
                        max_nprime = max_n // d if max_n else None
                        # We'll iterate n' from lower up to max_nprime (if set) else some reasonable limit
                        # For now, we just generate up to a certain max_nprime (maybe 2000)
                        # But we need to ensure we generate enough for testing.
                        # We'll set a global limit for n' to, say, 2000 for testing.
                        # We'll later adjust.
                        # For now, just generate n' up to 2000
                        # But we also need gcd condition
                        # Use simple loop
                        # We'll set a max_nprime default 2000
                        limit = max_nprime if max_nprime else 2000
                        for n_prime in range(lower, limit+1):
                            if sp.gcd(m_prime, n_prime) != 1:
                                continue
                            m = d * m_prime
                            n = d * n_prime
                            if max_m and m > max_m: continue
                            if max_n and n > max_n: continue
                            pretty.add((m,n))
                return pretty
            
