            def build_graph_havel(seq):
                # seq is list of desired degrees for vertices 0..n-1
                n=len(seq)
                # We'll maintain list of (degree, vertex) sorted descending
                import heapq
                # Use max-heap (neg degree)
                heap = [(-d, v) for v,d in enumerate(seq)]
                heapq.heapify(heap)
                adj = [set() for _ in range(n)]
                while heap:
                    d, v = heapq.heappop(heap)
                    d = -d
                    if d == 0:
                        continue
                    # pop next d vertices with highest degree
                    temp = []
                    for _ in range(d):
                        if not heap:
                            raise ValueError("Not graphical")
                        d2, v2 = heapq.heappop(heap)
                        d2 = -d2
                        # add edge v-v2
                        adj[v].add(v2)
                        adj[v2].add(v)
                        d2 -= 1
                        temp.append((d2, v2))
                    # push back updated vertices
                    for d2, v2 in temp:
                        heapq.heappush(heap, (-d2, v2))
                    # push back v with degree 0 (skip)
                return adj
            
            def simulate_ops_graph(adj):
                n=len(adj)
                coins=list(range(1,n+1))
                ops=0
                import math
                # Process vertices in increasing order
                for i in range(n):
                    # edges where i is larger endpoint (j>i)
                    for j in sorted([v for v in adj[i] if v>i]):
                        # ensure gcd=1
                        if math.gcd(coins[i], coins[j]) != 1:
                            return False, ops
                        coins[i] -= 1
                        coins[j] -= 1
                        ops+=1
                return True, ops
            
