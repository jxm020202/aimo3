            import itertools
            
            def min_T(n):
                N = 2**n
                vertices = list(range(N))
                start = 0
                # generate all Hamiltonian paths starting at 0 (brute force) for small n only
                min_T = None
                best_seq = None
                # Use DFS backtracking
                adj = {v: [] for v in vertices}
                for v in vertices:
                    for k in range(n):
                        w = v ^ (1<<k)  # flip bit k
                        adj[v].append(w)
                # backtrack
                visited = [False]*N
                visited[start]=True
                path = [start]
                def dfs(current, total_T):
                    nonlocal min_T, best_seq
                    if len(path)==N:
                        # visited all vertices, done
                        if min_T is None or total_T < min_T:
                            min_T = total_T
                            best_seq = path.copy()
                        return
                    # prune if total_T already exceeds min_T
                    if min_T is not None and total_T >= min_T:
                        return
                    for nxt in adj[current]:
                        if not visited[nxt]:
                            # compute jump length
                            diff = abs(nxt - current)  # but need power of 2 length: it's 2^k where k is bit index flipped
                            # compute k
                            k = (diff).bit_length()-1  # since diff is power of 2
                            # add reciprocal
                            new_T = total_T + 1/(2**k)
                            visited[nxt]=True
                            path.append(nxt)
                            dfs(nxt, new_T)
                            path.pop()
                            visited[nxt]=False
                dfs(start, 0)
                return min_T, best_seq
            
