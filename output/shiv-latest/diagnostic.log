            def compute_A_inv(n):
                # n odd
                # Build matrix A = I + P (cyclic shift forward)
                import numpy as np
                A = np.zeros((n,n), dtype=int)
                for i in range(n):
                    A[i,i] = 1
                    A[i,(i+1)%n] = 1
                # Compute inverse using formula (1/2)*(I - P + P^2 - ... + P^{n-1})
                # Build P matrix
                P = np.zeros((n,n), dtype=int)
                for i in range(n):
                    P[i,(i+1)%n] = 1
                # compute series
                series = np.zeros((n,n), dtype=int)
                cur = np.identity(n, dtype=int)
                for k in range(n):
                    coeff = 1 if (k%2==0) else -1
                    series += coeff * cur
                    cur = cur @ P  # shift by one more
                Ainv = series / 2.0
                return A, Ainv
            
            def test(n):
                A, Ainv = compute_A_inv(n)
                # b alternating signs
                b = np.array([(-1)**i for i in range(n)], dtype=float)
                a = Ainv @ b
                b2 = A @ a
                return a, b2
            
            for n in [3,5,7,9]:
                a,b2 = test(n)
                print("n",n)
                print("a",a)
                print("b2",b2)
            
