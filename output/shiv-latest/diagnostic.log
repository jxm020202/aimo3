            def solve_n(n, target):
                # create mapping from (i,j) to index
                idx = {}
                cells = []
                for i in range(n):
                    for j in range(n):
                        idx[(i,j)] = len(cells)
                        cells.append((i,j))
                N = len(cells)
                # edges list
                edges = []
                for i in range(n):
                    for j in range(n):
                        if i+1 < n:
                            edges.append(((i,j),(i+1,j)))
                        if j+1 < n:
                            edges.append(((i,j),(i,j+1)))
                E = len(edges)
                # variable order: x0..x_{N-1}, y0..y_{E-1}
                total_vars = N + E
                # Build constraints matrix A x = b
                # We'll use LinearConstraint with A_eq matrix.
                # We'll construct list of rows as dict for sparse representation.
                rows = []
                b_eq = []
                # Edge constraints: x_i - x_j - (2*y_e - 1) = 0 => x_i - x_j - 2*y_e = -1
                for e_idx, ((i1,j1),(i2,j2)) in enumerate(edges):
                    row = np.zeros(total_vars, dtype=int)
                    row[idx[(i1,j1)]] = 1
                    row[idx[(i2,j2)]] = -1
                    row[N + e_idx] = -2
                    rows.append(row)
                    b_eq.append(-1)
                # Sum constraint
                row = np.zeros(total_vars, dtype=int)
                for v in range(N):
                    row[v] = 1
                rows.append(row)
                b_eq.append(target)
                # Convert to numpy arrays
                A_eq = np.vstack(rows)
                b_eq = np.array(b_eq)
                # Bounds: x_i >=0, no upper bound; y_e binary => 0 <= y <= 1
                lower = np.zeros(total_vars)
                upper = np.full(total_vars, np.inf)
                # For y variables, set upper bound 1
                upper[N:] = 1
                # integrality: first N variables integer (nonnegative), next E variables integer (binary)
                integrality = np.concatenate([np.ones(N, dtype=int), np.ones(E, dtype=int)])
                # objective: zero (feasibility)
                c = np.zeros(total_vars)
                # Solve
                res = milp(c=c, constraints=LinearConstraint(A_eq, b_eq, b_eq), bounds=Bounds(lower, upper), integrality=integrality, options={'disp': False})
                return res
            
