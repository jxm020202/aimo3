                        # a*x+b*y+c*z+d >= eps => -a*x -b*y -c*z <= -eps - d
                        A.append([-a, -bcoef, -c])
                        b.append(-eps - d)
                    else:
                        # a*x+b*y+c*z+d <= -eps => a*x+b*y+c*z <= -eps - d
                        A.append([a, bcoef, c])
                        b.append(-eps - d)
                # bounds for variables
                bounds = [(-10,10), (-10,10), (-10,10)]
                # objective zero
                c_obj = [0,0,0]
                res = opt.linprog(c=c_obj, A_ub=A, b_ub=b, bounds=bounds, method='highs')
                return res.success
            
