            def real_y_roots_for_x(x_val):
                # substitute x numeric and get polynomial in y
                poly_y = sp.Poly(R.subs(x, x_val), y)
                # get numeric coefficients as floats
                coeffs = [complex(c.evalf()) for c in poly_y.all_coeffs()]
                # Use numpy roots
                roots = np.roots(coeffs)
                real_roots = [root.real for root in roots if abs(root.imag) < 1e-8]
                return real_roots
            
            def find_xy_solutions(num_samples=200):
                solutions = []
                for xv in np.linspace(-math.sqrt(3), math.sqrt(3), num_samples):
                    ys = real_y_roots_for_x(float(xv))
                    for yv in ys:
                        if xv**2 + yv**2 <= 3 + 1e-8:
                            # compute z from sphere
                            z_sq = 3 - xv**2 - yv**2
                            if z_sq < -1e-8:
                                continue
                            z_val = math.sqrt(max(z_sq,0))
                            # Check both signs for z (positive and negative)
                            for sign in [1,-1]:
                                zc = sign*z_val
                                # verify original equations
                                if abs(xv**2 + yv**2 + zc**2 - 3) < 1e-6 and abs(xv*yv**3 + yv*zc**3 + zc*xv**3 - 3) < 1e-5:
                                    solutions.append((xv, yv, zc))
                return solutions
            
            sols_xy = find_xy_solutions(200)
            len(sols_xy)
            
