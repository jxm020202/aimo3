            def max_edges_havel_hakimi(n):
                # construct bound sequence descending: two n-1, then n-2 down to 1
                seq = [n-1, n-1] + list(range(n-2, 0, -1))
                # sort descending (already)
                edges = 0
                while True:
                    # remove zeros
                    seq = [d for d in seq if d > 0]
                    if not seq:
                        break
                    # sort descending
                    seq.sort(reverse=True)
                    d = seq[0]
                    seq = seq[1:]  # remaining
                    if d > len(seq):
                        # cannot connect to more vertices than available, reduce d
                        d = len(seq)
                    # add edges
                    edges += d
                    # subtract 1 from first d elements of seq
                    for i in range(d):
                        seq[i] -= 1
                        if seq[i] < 0:
