            def compute_t_from_abc(a,b,c):
                # Solve quadratic: 3 t^2 - (4a+8b+12c) t + (4a**2 + 16*b**2 + 36*c**2 - 1) = 0
                A = 3.0
                B = -(4*a + 8*b + 12*c)
                C = 4*a*a + 16*b*b + 36*c*c - 1
                # Solve A t^2 + B t + C = 0
                disc = B*B - 4*A*C
                if disc < 0:
                    return None
                sqrt_disc = math.sqrt(disc)
                t1 = (-B + sqrt_disc) / (2*A)
                t2 = (-B - sqrt_disc) / (2*A)
                # t must be positive
                candidates = [t for t in (t1,t2) if t >= 0]
                if not candidates:
                    return None
                # Choose the one that satisfies t <= min(2a,4b,6c) (since x1,y1,z1 >=0)
                mins = min(2*a, 4*b, 6*c)
                # Return smallest candidate that satisfies inequality (should be one)
