            def min_A_per_coord(n):
                q, r = divmod(n, 3)
                # compute sum of C(a_k,2) minimal
                # r categories have q+1, others have q
                total = r * ((q+1)*q//2) + (3-r) * (q*(q-1)//2)
                return total
            
            def max_n_possible(limit=200):
                max_n = 0
                for n in range(1, limit+1):
