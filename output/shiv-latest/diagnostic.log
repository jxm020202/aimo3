            import random, math, numpy as np
            
            def random_point_on_sphere(radius=math.sqrt(3)):
                # random direction uniform
                theta = random.random()*2*math.pi
                phi = math.acos(2*random.random()-1)  # uniform on sphere
                x = radius*math.sin(phi)*math.cos(theta)
                y = radius*math.sin(phi)*math.sin(theta)
                z = radius*math.cos(phi)
                return x,y,z
            
            def find_close(num_samples=100000, tol=1e-6):
                close = []
                for _ in range(num_samples):
                    x,y,z = random_point_on_sphere()
                    T = x*y**3 + y*z**3 + z*x**3
                    if abs(T-3) < tol:
                        close.append((x,y,z,T))
                return close
            
