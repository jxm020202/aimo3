            def threshold_edges_adj(n):
                caps = [i for i in range(1, n)] + [n-1]
                verts = sorted([(caps[i], i) for i in range(n)], key=lambda x: -x[0])
                deg = [0]*n
                adj = {i:set() for i in range(n)}
                for i in range(n):
                    cap_i, idx_i = verts[i]
                    rem_i = cap_i - deg[idx_i]
                    if rem_i <= 0:
                        continue
                    for j in range(i+1, n):
                        if rem_i <= 0:
                            break
                        cap_j, idx_j = verts[j]
                        rem_j = cap_j - deg[idx_j]
                        if rem_j <= 0:
                            continue
                        # add edge
                        deg[idx_i] += 1
                        deg[idx_j] += 1
                        adj[idx_i].add(idx_j)
                        adj[idx_j].add(idx_i)
                        rem_i -= 1
                return adj
            
            def can_use_all_edges(n):
                adj = threshold_edges_adj(n)
                counts = [i+1 for i in range(n)]  # initial counts (1-indexed)
                used_edges = set()
                # We'll attempt greedy: while there exists edge (i,j) not used with gcd(count[i], count[j])==1
                # Choose any such edge.
                while True:
                    found = False
                    for i in range(n):
                        for j in adj[i]:
                            if i<j and (i,j) not in used_edges:
                                if counts[i]>0 and counts[j]>0 and math.gcd(counts[i], counts[j])==1:
                                    # use edge
                                    counts[i] -= 1
                                    counts[j] -= 1
                                    used_edges.add((i,j))
                                    found = True
                                    break
                        if found:
                            break
                    if not found:
                        break
                return len(used_edges) == sum(len(v) for v in adj.values())//2
            
