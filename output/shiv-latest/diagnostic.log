            def compute_ratio_from_b(n, b):
                # Build L and invert
                L = np.zeros((n,n))
                for i in range(n):
                    L[i,i] = 1
                    L[i,(i+1)%n] = 1
                invL = np.linalg.inv(L)
                a = invL @ b
                M = np.max(np.abs(a))
                sums = np.abs(a + np.roll(a, -1))
