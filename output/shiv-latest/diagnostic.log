            def compute_f_lp(n):
                # number of variables
                N = n
                total_vars = 2*n + 1
                # variable ordering: b0..b_{n-1}, s, t0..t_{n-1}
                # objective: minimize -sum t_i
                c = np.zeros(total_vars)
                c[N+1:] = -1.0  # coefficients for t_i (negative for max)
                # inequality constraints A_ub x <= b_ub
                A_ub = []
                b_ub = []
                # constraints for each i
                for i in range(n):
                    row1 = np.zeros(total_vars)
                    # -t_i + b_i - s/(n+1) <= 0
                    row1[i] = 1.0   # b_i coefficient
                    row1[N] = -1.0/(n+1)  # s coefficient (since s at index N)
                    row1[N+1+i] = -1.0   # t_i coefficient
                    A_ub.append(row1)
                    b_ub.append(0.0)
                    row2 = np.zeros(total_vars)
                    # -t_i - b_i + s/(n+1) <= 0
                    row2[i] = -1.0
                    row2[N] = 1.0/(n+1)
                    row2[N+1+i] = -1.0
                    A_ub.append(row2)
                    b_ub.append(0.0)
                A_ub = np.array(A_ub)
                b_ub = np.array(b_ub)
                # equality constraint: s - sum b_i = 0
                A_eq = np.zeros((1, total_vars))
                A_eq[0, :n] = -1.0
                A_eq[0, N] = 1.0
                b_eq = np.array([0.0])
                # bounds
                bounds = []
                for i in range(n):
                    bounds.append((-1.0, 1.0))  # b_i bounds
                bounds.append((-n, n))  # s bounds
                for i in range(n):
                    bounds.append((0.0, None))  # t_i >=0
                # solve
                res = opt.linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
                if not res.success:
                    raise RuntimeError("LP failed")
                max_sum_t = -res.fun  # because we minimized negative
                # compute f(n) = (n+1)/n * max_sum_t
                f_val = (n+1)/n * max_sum_t
                return f_val, res
            
