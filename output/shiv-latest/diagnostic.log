            def max_visible_from_point(point, others, angle_deg=100):
                # compute angles of vectors from point to each other point
                angles = []
                for o in others:
                    dx = o[0]-point[0]
                    dy = o[1]-point[1]
                    ang = math.atan2(dy, dx)  # -pi to pi
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate with +2pi for wrap-around
                angles_extended = angles + [a+2*math.pi for a in angles]
                max_count = 0
                j = 0
                target = math.radians(angle_deg)
                for i in range(len(angles)):
                    while j < i+len(angles) and angles_extended[j] - angles_extended[i] <= target + 1e-12:
                        j += 1
                    count = j - i
                    if count > max_count:
                        max_count = count
                return max_count
            
            def total_max_visible(points, angle_deg=100):
                total = 0
                n = len(points)
                for i, p in enumerate(points):
                    others = points[:i] + points[i+1:]
                    total += max_visible_from_point(p, others, angle_deg)
                return total
            
            def generate_arc_points(n, phi, R=1.0):
                # phi in radians, start angle = -phi/2 to phi/2
                start = -phi/2
                points = []
                for k in range(n):
                    theta = start + phi * k/(n-1) if n>1 else start
                    points.append((R*math.cos(theta), R*math.sin(theta)))
                return points
            
            def test_arc(n, phi_deg):
                phi = math.radians(phi_deg)
                pts = generate_arc_points(n, phi, R=1.0)
                return total_max_visible(pts)
            
            for phi in [30, 60, 90, 120, 150]:
                print(phi, test_arc(100, phi))
            
