            def angle_at_A(theta):
                # theta in radians, total central angle of arc
                # A at -theta/2, B at +theta/2
                A = np.array([math.cos(-theta/2), math.sin(-theta/2)])
                B = np.array([math.cos(theta/2), math.sin(theta/2)])
                OA = A  # radius vector
                # tangent direction at A: rotate OA by +90 degrees (counterclockwise)
                tangent = np.array([-OA[1], OA[0]])  # ( -y, x )
                AB = B - A
                # compute angle between tangent and AB
                dot = np.dot(tangent, AB)
                norm = np.linalg.norm(tangent) * np.linalg.norm(AB)
                ang = math.acos(dot / norm)
