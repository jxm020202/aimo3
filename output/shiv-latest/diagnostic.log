                # occ_grid: bool 7x7 indicating occupied
                if typ == 'H':
                    if direction == 'left':
                        if c == 0: return False
                        return not occ_grid[r][c-1]
                    if direction == 'right':
                        if c+1 == n-1: return False
                        return not occ_grid[r][c+2]
                    if direction == 'up':
                        if r == 0: return False
                        # need both cells above empty
                        return (not occ_grid[r-1][c]) and (not occ_grid[r-1][c+1])
                    if direction == 'down':
                        if r == n-1: return False
                        return (not occ_grid[r+1][c]) and (not occ_grid[r+1][c+1])
                else:  # V
                    if direction == 'up':
                        if r == 0: return False
                        return not occ_grid[r-1][c]
                    if direction == 'down':
