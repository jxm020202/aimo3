            def min_weight_for_syndrome(s):
                # s is integer representing 36-bit syndrome
                # Convert to binary vector length 36
                s_vec = [(s >> i) & 1 for i in range(36)]
                # Variables: x_j binary for j in 0..360
                # Additional integer variables y_i for each parity equation (i=0..35)
                # We'll set up MILP: minimize sum x_j
                c = np.concatenate([np.ones(361), np.zeros(36)])  # objective coefficients: x variables weight 1, y variables weight 0
                # Constraints: H x - 2 y = s
                # Build matrix A for variables (x then y)
                A = np.hstack([H_np, -2*np.eye(36, dtype=int)])  # shape (36, 361+36)
                # Right-hand side b = s_vec
                b = np.array(s_vec, dtype=int)
                # Linear constraints: equality
                lin_con = LinearConstraint(A, b, b)
                # Bounds: x in [0,1], integer; y >= 0 integer (no upper bound)
                bounds = Bounds(np.concatenate([np.zeros(361), np.zeros(36)]),
                                 np.concatenate([np.ones(361), np.full(36, np.inf)])
                # integrality: all variables integer
                integrality = np.concatenate([np.ones(361), np.ones(36)])  # all integer
                # Solve
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    return None
                x = res.x[:361]
                # Round to nearest integer
                weight = int(round(sum(x)))
                return weight
            
