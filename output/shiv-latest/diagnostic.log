            def is_graphical(seq):
                # Erdős–Gallai theorem
                n = len(seq)
                seq = sorted(seq, reverse=True)
                if sum(seq) % 2 != 0:
                    return False
                prefix = [0]
                for x in seq:
                    prefix.append(prefix[-1] + x)
                for k in range(1, n+1):
                    left = prefix[k]
                    # sum of min(d_i, k) for i=k+1..n
                    right = k*(k-1) + sum(min(d, k) for d in seq[k:])
                    if left > right:
                        return False
                return True
            
