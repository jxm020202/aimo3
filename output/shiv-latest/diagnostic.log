                A = []
                lb = []
                ub = []
                # adjacency constraints
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        # right neighbor
                        if j+1 < n:
                            idx_r = i*n + (j+1)
                            # x_idx - x_idx_r <= 1
                            row = np.zeros(N)
                            row[idx] = 1
                            row[idx_r] = -1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                            # x_idx_r - x_idx <= 1
                            row = np.zeros(N)
                            row[idx] = -1
                            row[idx_r] = 1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                        # down neighbor
                        if i+1 < n:
                            idx_d = (i+1)*n + j
                            row = np.zeros(N)
                            row[idx] = 1
                            row[idx_d] = -1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
