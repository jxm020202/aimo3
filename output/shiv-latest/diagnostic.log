            import cmath, math
            def primitive_nth_roots(n):
                roots = []
                for k in range(1,n+1):
                    if math.gcd(k,n)==1:
                        roots.append(cmath.exp(2j*math.pi*k/n))
                return roots
            
            def product_vals(n, e):
                prod = 1+0j
                for r in primitive_nth_roots(n):
                    prod *= (r**e + 1)
                return prod
            
