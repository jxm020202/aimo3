            import itertools, collections
            
            def generate_moves(size):
                moves = []
                for i in range(size):
                    for j in range(size):
                        vec = [0]*(size*size)
                        # row i
                        for k in range(size):
                            idx = i*size + k
                            vec[idx] ^= 1
                        # column j
                        for k in range(size):
                            idx = k*size + j
                            vec[idx] ^= 1
                        # ensure intersection toggled once (already toggled twice -> 0, need to toggle again)
                        idx = i*size + j
                        vec[idx] ^= 1
                        moves.append(tuple(vec))
                return moves
            
            def reachable(start, size):
                moves = generate_moves(size)
                start = tuple(start)
                seen = {start}
                queue = [start]
                while queue:
                    cur = queue.pop()
                    for mv in moves:
                        nxt = tuple((a^b) for a,b in zip(cur,mv))
                        if nxt not in seen:
                            seen.add(nxt)
                            queue.append(nxt)
                return seen
            
            def test_all_black(size):
                # test all possible starts? That's 2^(size^2) huge, but we can test random
                import random
                moves = generate_moves(size)
                # compute subspace dimension
                # We'll test if all black reachable from any start by checking that for each start,
