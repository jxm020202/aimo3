            import itertools, numpy as np
            
            def count_n(n):
                half = n//2
                rows = list(itertools.combinations(range(n), half))
                # each row is a tuple of column indices where 1 appears
                # generate all matrices via product of rows
                count = 0
                mats = []
                for rows_choice in itertools.product(rows, repeat=n):
                    A = np.zeros((n,n), dtype=int)
                    for i, cols in enumerate(rows_choice):
                        A[i, list(cols)] = 1
                    # check condition A^2 + half*A == half*J
                    if np.array_equal(A.dot(A) + half*A, half*np.ones((n,n), dtype=int)):
                        count += 1
                        mats.append(A.copy())
                return count, mats
            
