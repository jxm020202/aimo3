            import math
            def Krawtchouk(k, i, n=6, q=3):
                total = 0
                for j in range(0, k+1):
                    if j <= i and (k-j) <= (n-i):
                        total += ((-1)**j) * ((q-1)**(k-j)) * math.comb(i, j) * math.comb(n-i, k-j)
