            def max_edges_given_caps(N):
                caps = [i for i in range(N)]  # index 0..N-1 corresponds to vertex i+1; caps[i]=i for i<N-1, caps[N-1]=N-1
                caps[-1] = N-1
                # Use a priority queue of (remaining capacity, vertex) descending
                import heapq
                # Python heapq is min-heap; store negative capacities
                heap = [(-caps[i], i) for i in range(N) if caps[i] > 0]
                heapq.heapify(heap)
                edges = 0
                while len(heap) >= 2:
                    # pop vertex with largest capacity
                    cap1, v1 = heapq.heappop(heap)
                    cap1 = -cap1
                    # need to connect v1 to up to cap1 other vertices
                    # get next cap2 vertices
                    temp = []
                    connections = min(cap1, len(heap))
                    # Actually we need to connect to exactly cap1 vertices if possible; if not enough vertices left, then we cannot fill v1 fully.
                    # We'll connect to as many as possible.
                    for _ in range(connections):
                        cap2, v2 = heapq.heappop(heap)
                        cap2 = -cap2
                        # create edge between v1 and v2
                        edges += 1
                        cap1 -= 1
                        cap2 -= 1
                        # store updated caps to reinsert later if >0
                        if cap2 > 0:
                            temp.append((-cap2, v2))
                    # after connecting, reinsert v1 if still has capacity (should be 0 if we connected cap1 times)
                    if cap1 > 0:
                        # cannot connect further because no other vertices with capacity left
                        # break loop
                        # reinsert v1 and break
                        heapq.heappush(heap, (-cap1, v1))
                        # Put back temp
                        for item in temp:
                            heapq.heappush(heap, item)
                        break
                    # reinsert updated other vertices
                    for item in temp:
                        heapq.heappush(heap, item)
                return edges
            
