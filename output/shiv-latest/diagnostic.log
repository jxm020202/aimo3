            import sympy as sp
            
            def find_solution(n, m):
                # variables r1..rn as complex (use a+I*b)
                rs = [sp.symbols(f'r{i}_re') for i in range(n)] + [sp.symbols(f'r{i}_im') for i in range(n)]
                # Actually easier: treat each r as complex variable using sp.symbols with complex=True? Not.
                # We'll treat each r as a complex number a+I*b.
                re_vars = [sp.symbols(f'x{i}') for i in range(n)]
                im_vars = [sp.symbols(f'y{i}') for i in range(n)]
                eqs = []
                for j in range(1, m+1):
                    prod = 1
                    for i in range(n):
                        a = re_vars[i]
                        b = im_vars[i]
                        r = a + sp.I*b
                        term = r**j + 1
                        prod = sp.expand(prod * term)
                    # set product - 1 = 0
                    eqs.append(sp.simplify(prod - 1))
                # also require not all zero: at least one (a,b) not both zero. We'll ignore for solving.
                # Solve system (maybe many solutions). Use nsolve with random initial guesses.
                return re_vars, im_vars, eqs
            
            re_vars, im_vars, eqs = find_solution(2, 2)
            eqs
            
