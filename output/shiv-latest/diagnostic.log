            def greedy_max_edges(n):
                caps = [i if i < n else n-1 for i in range(1,n+1)]
                # adjacency sets
                adj = [set() for _ in range(n)]
                # list of vertices sorted by remaining capacity descending
                # We'll use a priority queue (max-heap) of (remaining, vertex)
                import heapq
                heap = [(-caps[i], i) for i in range(n)]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    # pop vertex with max remaining
                    rem_i, i = heapq.heappop(heap)
                    rem_i = -rem_i
                    if rem_i == 0:
                        continue
                    # we need to connect i to rem_i other vertices
                    # collect candidates: vertices with remaining >0 and not already adjacent
                    # We'll extract from heap temporarily
                    temp = []
                    connections = 0
                    while connections < rem_i and heap:
                        rem_j, j = heapq.heappop(heap)
                        rem_j = -rem_j
                        if rem_j == 0:
                            continue
                        if j in adj[i]:
                            # cannot connect, keep for later
                            temp.append((-rem_j, j))
                            continue
                        # connect i and j
                        adj[i].add(j)
                        adj[j].add(i)
                        edges += 1
                        rem_j -= 1
                        connections += 1
                        # push back j with updated remaining if >0
                        if rem_j > 0:
                            temp.append((-rem_j, j))
                    # after trying to connect, push back i with remaining 0 (should be satisfied)
                    # If we couldn't satisfy all connections, we cannot use remaining capacity of i
                    # push back any leftover connections not made? Actually we cannot fulfill i's remaining degree, so we discard remaining.
                    # push back all temp entries
                    for item in temp:
                        heapq.heappush(heap, item)
                return edges
            
            print(greedy_max_edges(20))
            
