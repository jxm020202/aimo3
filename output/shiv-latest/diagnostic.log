            def inequality_holds(m,n,k):
                lower = max(0, (k - m)/n)
                upper = min(1, k / n)
                return lower < upper
            
            def pretty_condition(m,n,k):
                # returns True if there exists alpha making (m,n) pretty (i.e., both conditions)
                return inequality_holds(m,n,k) and ((m - k) % math.gcd(m,n) == 0)
            
            def check_pretty(m,n,k,alpha):
                return is_pretty_alpha(alpha,m,n,k)
            
            def check_cool_pair(m,n,k,alpha):
                if not check_pretty(m,n,k,alpha):
                    return False
                if m>n and check_pretty(m-n,n,k,alpha):
                    return False
                if n>m and check_pretty(m,n-m,k,alpha):
                    return False
                return True
            
