            import math, sys, itertools, collections, sympy as sp
            
            def cycle_lengths(perm):
                # perm: dict mapping 1..n to 1..n
                n = len(perm)
                visited = [False]*(n+1)
                lengths = []
                for i in range(1,n+1):
                    if not visited[i]:
                        # follow cycle
                        cur = i
                        length = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = perm[cur]
                            length += 1
                        lengths.append(length)
                return sorted(lengths)
            
            def check_n(n):
                # compute L
                L = {}
                for x in range(1,n+1):
                    y = (866*x) % n
                    if y == 0:
                        y = n
                    L[x] = y
                # compute E
                m = n+1
                E = {}
                outputs = set()
                for a in range(1,n+1):
                    b = pow(a, 866, m)
                    if b == 0:
                        return False  # not a permutation
                    # b is in 1..n
                    if b in outputs:
                        return False
                    outputs.add(b)
                    E[a] = b
                # check bijection
                if len(outputs) != n:
                    return False
                # compare cycle types
                clL = cycle_lengths(L)
                clE = cycle_lengths(E)
                return clL == clE
            
            def find_min(limit=2000):
                for n in range(866, limit+1):
                    if check_n(n):
                        return n
                return None
            
            print(find_min(2000))
            
