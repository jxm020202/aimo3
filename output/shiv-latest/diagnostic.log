            def plane_from_points(p1,p2,p3):
                # returns (a,b,c,d) for plane ax+by+cz+d=0
                # normal = (p2-p1) x (p3-p1)
                v1 = sp.Matrix(p2) - sp.Matrix(p1)
                v2 = sp.Matrix(p3) - sp.Matrix(p1)
