            def max_edges_greedy(n):
                caps = [i for i in range(1, n)] + [n-1]  # 0-index: vertex 1 has cap 1, etc.
                rem = caps[:]  # remaining capacity
                edges = 0
                for i in range(n):
                    # connect i with later vertices
                    if rem[i] == 0:
                        continue
                    # iterate j from i+1 to n-1
                    j = i+1
                    while rem[i] > 0 and j < n:
                        if rem[j] > 0:
                            # add edge
                            rem[i] -= 1
                            rem[j] -= 1
                            edges += 1
                        j += 1
                    # after loop, if rem[i] >0, cannot satisfy further
                return edges, rem
            
