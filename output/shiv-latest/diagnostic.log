            def max_graphic_degree_sum(n):
                caps = list(range(1, n)) + [n-1]  # length n
                # caps sorted ascending; we will work with descending for EG
                # Ensure sum even by reducing 1 if odd
                total = sum(caps)
                if total % 2 == 1:
                    # reduce degree of some vertex; choose smallest cap? We'll reduce the smallest non-zero cap (i.e., 1)
                    caps[0] -= 1  # reduce vertex 1 from 1 to 0
                    total -= 1
                # Now we need to adjust to satisfy EG
                # We'll sort descending each iteration and apply EG test; if fails, reduce degree of highest vertex that causes violation
                # Simple iterative reduction
                caps = caps[:]  # copy
                while True:
                    seq = sorted(caps, reverse=True)
                    if sum(seq) % 2 != 0:
                        # reduce smallest positive degree
                        for i in range(len(seq)-1, -1, -1):
                            if seq[i] > 0:
                                seq[i] -= 1
                                break
                        caps = seq[:]
                        continue
                    # check EG
                    nlen = len(seq)
                    prefix = [0]
                    for x in seq:
                        prefix.append(prefix[-1]+x)
                    violated = False
                    for k in range(1, nlen+1):
                        left = prefix[k]
                        right = k*(k-1) + sum(min(k, seq[i]) for i in range(k, nlen))
                        if left > right:
                            violated = True
                            # need to reduce some of the top k degrees
                            # simple: reduce the largest degree among first k by 1
                            # find index of max among first k (seq sorted descending)
                            # reduce it
                            seq[k-1] -= 1  # reduce the kth largest (since sorted)
                            break
                    if not violated:
                        # sequence is graphic
                        return sum(seq)
                    caps = seq[:]
            
            print(max_graphic_degree_sum(10))
            
