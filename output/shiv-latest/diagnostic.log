            def product_qr_value(p, i):
                mp.mp.dps = 50
                z = mp.e**(2*mp.pi*mp.j/p)
                qr = sorted(set([(j*j)%p for j in range(1,(p-1)//2+1)]))
                prod = mp.mpc(1)
                for q in qr:
                    prod *= (1 + z**(q*i))
                return prod
            
