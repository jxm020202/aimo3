            import random, math, time
            
            def max_spread_for_point(pts, i):
                xi, yi = pts[i]
                angles = []
                for j, (xj, yj) in enumerate(pts):
                    if i==j: continue
                    ang = math.atan2(yj-yi, xj-xi) % (2*math.pi)
                    angles.append(ang)
                angles.sort()
                # compute minimal angular interval covering all points (circular)
                # Equivalent to find max gap between consecutive angles; then spread = 2π - max_gap
                max_gap = 0
                for k in range(len(angles)):
                    nxt = angles[(k+1)%len(angles)]
                    diff = (nxt - angles[k]) % (2*math.pi)
                    if diff > max_gap:
                        max_gap = diff
                spread = 2*math.pi - max_gap
                return spread
            
            def max_spread_all(pts):
                return max(max_spread_for_point(pts, i) for i in range(len(pts)))
            
            def random_config(n):
                pts = []
                for _ in range(n):
                    r = math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
