            def pretty_pairs_mod(alpha, k, max_m):
                pairs = []
                for m in range(1, max_m+1):
                    A_m = math.floor(m*alpha)
                    # compute r = (m - k) mod m
                    r = (m - k) % m  # same as (-k) mod m
                    g = math.gcd(A_m, m)
                    if r % g != 0:
                        continue
                    # solve n * (A_m/g) ≡ (r/g) (mod m/g)
                    mod = m // g
                    a = A_m // g
                    b = (r // g) % mod
                    # find modular inverse of a modulo mod
                    try:
                        inv_a = pow(a, -1, mod)
                    except ValueError:
                        continue
                    n0 = (b * inv_a) % mod
                    # generate n = n0 + t*mod for t>=0
                    # need n positive, also need to bound n maybe up to some max_n
                    # We'll generate up to max_n = max_m maybe
                    max_n = max_m
                    n = n0
                    while n <= max_n:
                        if n == 0:
                            n += mod
                            continue
                        # verify condition exactly
                        if m * math.ceil(n*alpha) - n * math.floor(m*alpha) == k:
                            pairs.append((m,n))
                        n += mod
                return pairs
            
