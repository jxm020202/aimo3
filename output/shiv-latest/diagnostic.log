            def is_graphical(seq):
                # Havel-Hakimi using heap for efficiency
                import heapq
                # Use max-heap by negating
                heap = [-d for d in seq if d>0]
                heapq.heapify(heap)
                while heap:
                    d = -heapq.heappop(heap)
                    if d > len(heap):
                        return False
                    # pop d largest
                    temp = []
                    for _ in range(d):
                        nd = -heapq.heappop(heap) - 1
                        if nd < 0:
                            return False
                        if nd > 0:
                            temp.append(-nd)
                    for val in temp:
                        heapq.heappush(heap, val)
                return True
            
