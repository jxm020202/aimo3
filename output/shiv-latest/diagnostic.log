            def pretty_pairs_alpha(alpha, k, max_m):
                pairs = []
                for m in range(1, max_m+1):
                    a = math.floor(m*alpha)
                    # need n positive integer such that exists integer b = floor(n*alpha) satisfying m*b - n*a = k - m
                    # Rearranged: m*b = n*a + k - m => b = (n*a + k - m)/m must be integer
                    # Let n vary; we can compute n modulo m/g where g = gcd(a,m)
                    g = math.gcd(a, m)
                    # The congruence: n*a ≡ m - k (mod m)
                    # Let a' = a/g, m' = m/g. Then n*a' ≡ (m - k)/g (mod m')
                    # Need (m - k) divisible by g, else no solution.
                    if (m - k) % g != 0:
                        continue
                    a_prime = a // g
                    m_prime = m // g
                    rhs = (m - k) // g % m_prime
                    # Solve n*a' ≡ rhs (mod m')
                    # Since a' and m' are coprime, we can find modular inverse.
                    inv = pow(a_prime, -1, m_prime)  # Python 3.8+ supports modular inverse
                    n0 = (rhs * inv) % m_prime
                    # General solution: n = n0 + t*m_prime, t >= 0 integer.
                    # Need n positive.
                    # We'll iterate t such that n up to some bound maybe.
                    # Also need to check b integer and floor condition.
                    # Let's set a max_n bound maybe 5000 or 10000.
                    # We'll generate n up to some max_n.
                    # We'll compute b = (n*a + k - m)//m, ensure integer.
                    # Then verify b == floor(n*alpha).
                    # We'll also ensure n>0.
                    # We'll iterate t while n <= max_n.
                    max_n = max_m*5  # heuristic
                    t = 0
                    while True:
                        n = n0 + t*m_prime
                        if n == 0:
                            t += 1
                            continue
                        if n > max_n:
                            break
                        # compute b
                        num = n*a + k - m
                        if num % m != 0:
                            # shouldn't happen due to congruence
                            t += 1
                            continue
                        b = num // m
                        # check floor condition
                        if b == math.floor(n*alpha):
                            pairs.append((m,n))
                        t += 1
                return pairs
            
