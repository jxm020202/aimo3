            def min_total_sum(n):
                edges = list(itertools.combinations(range(n), 2))
                m = len(edges)
                # variable x_i for each edge, integer 1..3
                c = np.ones(m)  # objective minimize sum
                # bounds 1 to 3
                bounds = Bounds(1, 3)
                # integrality: all variables integer
                integrality = np.ones(m)
                # constraints: for each triangle, sum >=5
                A = []
                lb = []
                ub = []
                for tri in itertools.combinations(range(n), 3):
                    # indices of edges in this triangle
                    idx = []
                    for e in itertools.combinations(tri, 2):
                        idx.append(edges.index(e))
                    row = np.zeros(m)
                    row[idx] = 1
                    A.append(row)
                    lb.append(5)
                    ub.append(np.inf)
                A = np.array(A)
                lc = LinearConstraint(A, lb, ub)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("failed", n)
                    return None
                total = sum(res.x)
                # rounding due to float
                total = int(round(total))
                return total
            
