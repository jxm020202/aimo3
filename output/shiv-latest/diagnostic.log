                        val = float(sol)
                        # check denominators not zero
                        if abs(1-val) < 1e-9 or abs(val) < 1e-9 or abs(2-val) < 1e-9:
                            continue
                        # sign constraints
                        # if a==0 => p must be 0 (since a/u = p, a=0 => p=0). Actually if a=0, p must be 0.
