            import math
            
            def last_nonzero_digit_factorial(n):
                # compute n! and strip zeros, but for n up to maybe 2000 we can compute directly using big ints
                # but we can use known recurrence for speed
                # We'll implement recurrence
                if n==0:
                    return 1
                # recursion
                # Use iterative method
                res = 1
                for i in range(1, n+1):
                    res *= i
                    # remove trailing zeros
                    while res % 10 == 0:
                        res //= 10
                    # keep only last few digits to avoid overflow
                    res %= 1000000  # keep enough digits
                return res % 10
            
            def D(n):
                return last_nonzero_digit_factorial(n)
            
            # test
            print([D(i) for i in range(1,21)])
            
            
