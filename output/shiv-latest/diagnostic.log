                return pow(a, 866, mod)
            
            def analyze(mod):
                n = mod-1
                visited = [False]*(n+1)  # index 0 unused
                cycles = []
                for a in range(1, mod):
                    if not visited[a]:
                        # follow orbit
                        path = []
                        cur = a
                        while not visited[cur]:
                            visited[cur] = True
                            path.append(cur)
                            cur = phi(cur, mod)
                        # now cur is visited; find cycle start
                        if cur in path:
                            idx = path.index(cur)
