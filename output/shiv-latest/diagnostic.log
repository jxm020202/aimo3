            def count_triples(k, n_max=2000):
                triples = []
                for a in range(1, k):
                    b = k - a
                    if math.gcd(a,b) != 1:
                        continue
                    # a,b positive
                    for n in range(1, n_max+1, 2):  # odd n
                        if pow(a, n, n) + pow(b, n, n) % n == 0:  # careful: need modulo sum
