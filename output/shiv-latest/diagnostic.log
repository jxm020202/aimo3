            def compute_N(p):
                # compute Q: squares including 0
                Q = set([ (i*i) % p for i in range(p) ])
                # compute T: values k1^2 + k1*k2 + k2^2 for distinct nonzero k1,k2
                T = set()
                for k1 in range(1,p):
                    for k2 in range(1,p):
                        if k1 != k2:
                            T.add((k1*k1 + k1*k2 + k2*k2) % p)
                # S = union
                S = Q.union(T)
                # compute size
                size_S = len(S)
                N = (p-1)*(p - size_S + 1)  # as derived
                return {
                    'p':p,
                    'Q':len(Q),
                    'T':len(T),
                    'S':size_S,
                    'N':N,
                    'Qset':Q,
                    'Tset':T,
                    'Sset':S
                }
            
            for p in [3,11,61]:
                print(compute_N(p))
            
