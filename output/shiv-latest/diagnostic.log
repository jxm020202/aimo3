                for signs in itertools.product([1,-1], repeat=n):
                    # Build constraints: sign_i * (a_i x + b_i y + c_i z + d_i) >= 1
                    A_ub = []
                    b_ub = []
                    for (a,b,c,d), s in zip(planes, signs):
                        A_ub.append([-s*a, -s*b, -s*c])  # -s*(a x + b y + c z) <= -s*(-d)?? Wait we need include d.
                        # Actually inequality: s*(a x + b y + c z + d) >= 1
