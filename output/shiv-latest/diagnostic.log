            import itertools
            
            def hypercube_edges(n):
                # returns list of edges (u,v) where u<v and differ by one bit
                edges = []
                for u in range(2**n):
                    for i in range(n):
                        v = u ^ (1<<i)
                        if u < v:
                            edges.append((u,v,i))
                return edges
            
            def max_dim_edges(n, dim):
                # brute force Hamiltonian paths starting at 0 for small n
                N = 2**n
                adj = {v: [] for v in range(N)}
                for u,v,i in hypercube_edges(n):
                    adj[u].append((v,i))
                    adj[v].append((u,i))
                max_count = 0
                # backtrack
                visited = [False]*N
                visited[0]=True
                path = [0]
                def dfs(v, count):
                    nonlocal max_count
                    if len(path)==N:
                        max_count = max(max_count, count)
                        return
                    for w,i in adj[v]:
                        if not visited[w]:
                            visited[w]=True
                            path.append(w)
                            dfs(w, count + (1 if i==dim else 0))
                            path.pop()
                            visited[w]=False
                dfs(0,0)
                return max_count
            
            for n in range(2,5):
