            import numpy as np
            
            def jacobian(x,y,z):
                # partial derivatives of F1 = x^2+y^2+z^2-3
                # F2 = x*y**3 + y*z**3 + z*x**3 -3
                J = np.array([[2*x, 2*y, 2*z],
                              [y**3 + 3*z*x**2, z**3 + 3*x*y**2, x**3 + 3*y*z**2]], dtype=float)
                return J
            
            def rank(J):
                return np.linalg.matrix_rank(J, tol=1e-9)
            
