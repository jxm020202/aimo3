            def generate_random_generator():
                # generate 3x6 matrix over GF(3)
                while True:
                    G = np.random.randint(0,3,size=(3,6), dtype=int)
                    # compute rank over GF(3)
                    # Use sympy for rank modulo 3
                    import sympy as sp
                    M = sp.Matrix(G.tolist())
                    if M.rank() == 3:
                        return G
            
            def code_from_generator(G):
                # generate all linear combinations a*row1 + b*row2 + c*row3 over GF(3)
                code = []
                for coeffs in itertools.product(range(3), repeat=3):
                    vec = (coeffs[0]*G[0] + coeffs[1]*G[1] + coeffs[2]*G[2]) % 3
                    code.append(tuple(vec.tolist()))
                return code
            
            def check_code(code):
                # code is list of tuples length 27
                # check pairwise matches count in {0,2}
                for i in range(len(code)):
                    for j in range(i+1, len(code)):
                        m = sum(1 for a,b in zip(code[i], code[j]) if a==b)
                        if m not in (0,2):
                            return False
                return True
            
            def random_search(trials=2000):
                for t in range(trials):
                    G = generate_random_generator()
                    code = code_from_generator(G)
                    if check_code(code):
                        return G, code
                return None, None
            
            start = time.time()
            G, code = random_search(500)
            print("found:", G is not None, "time", time.time()-start)
            
