                            t = -(2*p - r - 2*q)/s
                            if -2 <= t <= 2:
                                val = 8*p + (-1)*r + (-8)*q + (t**3)*s
                                if val > best:
                                    best = val
                                    best_tuple = (p,r,q,t)
                return best, best_tuple
            
