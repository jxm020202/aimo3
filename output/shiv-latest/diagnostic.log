            import random, math, itertools, numpy as np
            
            def max_in_wedge(point, others, wedge_deg=100):
                # compute angles of vectors from point to each other point
                angles = []
                x0,y0 = point
                for (x,y) in others:
                    dx, dy = x - x0, y - y0
                    ang = math.atan2(dy, dx)  # -pi to pi
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate with +2π for circular wrap
                angles2 = angles + [a + 2*math.pi for a in angles]
                maxcnt = 0
                j = 0
                wedge = math.radians(wedge_deg) + 1e-12
                n = len(angles)
                for i in range(n):
                    while j < i+n and angles2[j] - angles2[i] <= wedge:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def generate_config():
                # quadrilateral hull: square of side length 10, centered at (0,0)
                hull = [(-5,-5), (5,-5), (5,5), (-5,5)]
                # interior points near (-5,-5)
                interior = []
                for _ in range(96):
                    # random small offset within radius 0.01
                    r = random.random()*0.01
                    theta = random.random()*2*math.pi
                    interior.append((-5 + r*math.cos(theta), -5 + r*math.sin(theta)))
                points = hull + interior
                return points
            
            pts = generate_config()
            a_vals = []
            for i,p in enumerate(pts):
                others = pts[:i]+pts[i+1:]
                a = max_in_wedge(p, others, 100)
                a_vals.append(a)
