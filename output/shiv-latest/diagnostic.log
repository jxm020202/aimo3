import numpy as np

def check_matrix(A):
    # A is numpy array 12x12 of 0/1
    # each row sum 6
    if not np.all(A.sum(axis=1) == 6):
        return False
    # compute A^2 + 6A
    M = A @ A + 6 * A
    return np.all(M == 6)

def generate_random_partition():
    indices = np.arange(12)
    np.random.shuffle(indices)
    S = set(indices[:6])
    A = np.zeros((12,12), dtype=int)
    for i in range(12):
