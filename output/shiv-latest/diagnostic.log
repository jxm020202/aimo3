            import random, math, numpy as np
            
            def max_visible(points):
                n=len(points)
                total=0
                for i in range(n):
                    # compute angles from point i to others
                    angles=[]
                    xi, yi = points[i]
                    for j in range(n):
                        if i==j: continue
                        xj, yj = points[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                    # sort angles
                    angles = np.array(angles)
                    # duplicate with +2π for wrap
                    angles2 = np.concatenate([angles, angles+2*math.pi])
                    # sliding window of width 100° = 100*pi/180 rad
                    width = math.radians(100)
                    maxcnt=0
                    left=0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > width + 1e-9:
                            left+=1
                        cnt = right - left + 1
                        if cnt>maxcnt:
                            maxcnt=cnt
                    total+=maxcnt
                return total
            
