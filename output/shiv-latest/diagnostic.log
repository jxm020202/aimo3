            def check_structure(n):
                m=n+1
                # compute mapping E
                E=[0]*(n+1) # index 1..n
                indeg=[0]*(n+1)
                for a in range(1,n+1):
                    b=pow(a,866,m)
                    if b==0 or b>n:
                        # map to 0 or out of range: then not allowed for bijection because f(y) must be in 1..n.
                        # So this n fails.
                        return False
                    E[a]=b
                    indeg[b]+=1
                d=math.gcd(866,n)
                # indegree distribution check
                count0=n - n//d
                countd=n//d
                if indeg.count(0)!=count0:
                    return False
                if indeg.count(d)!=countd:
                    return False
                # verify that vertices with indegree d form cycles (each has indegree d, outdegree 1)
                # check that each vertex with indegree d maps to another vertex with indegree d
                for a in range(1,n+1):
                    if indeg[a]==d:
                        if indeg[E[a]]!=d:
                            return False
                # check that each indegree-d vertex has exactly one predecessor within indegree-d set (the one from cycle)
                # we can compute for each indegree-d vertex, count of preimages that also have indegree d
                pred_counts=[0]*(n+1)
                for a in range(1,n+1):
                    b=E[a]
                    if indeg[b]==d and indeg[a]==d:
                        pred_counts[b]+=1
                # each indegree-d vertex should have exactly 1 predecessor from indegree-d set
                for a in range(1,n+1):
                    if indeg[a]==d:
                        if pred_counts[a]!=1:
                            return False
                # also each indegree-d vertex should have exactly d-1 leaf children (preimages with indegree 0)
                leaf_counts=[0]*(n+1)
                for a in range(1,n+1):
                    b=E[a]
                    if indeg[b]==d and indeg[a]==0:
                        leaf_counts[b]+=1
                for a in range(1,n+1):
                    if indeg[a]==d:
                        if leaf_counts[a] != d-1:
                            return False
                # all checks passed
                return True
            
