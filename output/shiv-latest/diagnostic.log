            def greedy_bmatching(n):
                caps = [i for i in range(1, n)] + [n-1]  # length n
                # Use list of (remaining cap, vertex)
                import heapq
                # Use max-heap via negative values
                heap = [(-caps[i], i) for i in range(n)]
                heapq.heapify(heap)
                edges = set()
                while heap:
                    cap_i, i = heapq.heappop(heap)
                    cap_i = -cap_i
                    if cap_i == 0:
                        break
                    # Need to select cap_i other vertices with positive remaining capacity
                    # Extract up to cap_i vertices from heap
                    temp = []
                    partners = []
                    for _ in range(cap_i):
                        if not heap:
                            # cannot satisfy, break
                            break
                        cap_j, j = heapq.heappop(heap)
                        cap_j = -cap_j
                        if cap_j == 0:
                            # no more capacity, cannot use this vertex
                            # push back all and stop
                            temp.append((-cap_j, j))
                            break
                        partners.append((j, cap_j))
                    else:
                        # Successfully got cap_i partners
                        pass
                    # If we didn't get enough partners, we cannot use remaining capacity of i
                    if len(partners) < cap_i:
                        # push back i with 0 capacity (or ignore)
                        # push back all extracted partners
                        for j, cap_j in partners:
                            heapq.heappush(heap, (-cap_j, j))
                        # i cannot be used further
                        continue
                    # Use edge (i,j) for each partner
                    for j, cap_j in partners:
                        edges.add((min(i,j), max(i,j)))
                        # decrement partner's capacity
                        cap_j -= 1
                        heapq.heappush(heap, (-cap_j, j))
                    # i's capacity becomes 0 after using all
                    # (since we used exactly its remaining capacity)
                    # no need to push i back
                return len(edges)
            
            def max_edges_greedy(n):
                return greedy_bmatching(n)
            
            for n in range(2, 15):
                print(n, max_edges_greedy(n))
            
