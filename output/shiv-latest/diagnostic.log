            def find_solutions_for_x(x_val, guesses=20):
                solutions = []
                A = 3 - x_val**2
                if A < -1e-9:
                    return solutions
                y, z = sp.symbols('y z')
                eq1 = y**2 + z**2 - A
                eq2 = x_val*y**3 + y*z**3 + z*x_val**3 - 3
                for _ in range(guesses):
                    # random initial guess within circle radius sqrt(A)
                    r = math.sqrt(max(A,0))
                    theta = random.random()*2*math.pi
                    y0 = r*math.cos(theta)
                    z0 = r*math.sin(theta)
                    try:
                        sol = sp.nsolve([eq1, eq2], (y, z), (y0, z0), tol=1e-14, maxsteps=100)
                        yv, zv = float(sol[0]), float(sol[1])
                        # Round to avoid duplicates
                        # Check if solution satisfies constraints
                        if abs(yv**2 + zv**2 - A) < 1e-6 and abs(x_val*yv**3 + yv*zv**3 + zv*x_val**3 - 3) < 1e-6:
                            # store sorted maybe
