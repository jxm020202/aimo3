                for p in range(2, n+1):
                    if not pf[p]:
                        for mult in range(p, n+1, p):
                            pf[mult].append(p)
                def coprime_count(i):
                    if i == 1:
                        return n-1
                    primes = pf[i]
                    total = n
                    m = len(primes)
                    for mask in range(1, 1<<m):
                        mult = 1
                        bits = 0
                        for idx in range(m):
                            if mask>>idx & 1:
                                mult *= primes[idx]
                                bits += 1
                        term = n // mult
                        if bits % 2 == 1:
                            total -= term
                        else:
                            total += term
                    return total
                caps = [0]*(n+1)
                for i in range(1, n+1):
                    C = coprime_count(i)
                    caps[i] = min(i, C) if i < n else min(n-1, C)
                remaining = caps[:]
                edges = []
                # iterate over pairs in some order, e.g., increasing i then j
                for i in range(1, n+1):
                    for j in range(i+1, n+1):
                        if math.gcd(i,j)==1:
                            if remaining[i]>0 and remaining[j]>0:
