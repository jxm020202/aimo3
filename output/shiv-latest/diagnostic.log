            from functools import lru_cache
            import itertools
            
            def max_ops_bruteforce(n):
                initial = tuple(range(1,n+1))
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                @lru_cache(None)
                def dfs(state, used_mask):
                    max_steps = 0
                    # state is tuple of counts
                    for idx, (i,j) in enumerate(pairs):
                        if not (used_mask>>idx)&1:
                            a = state[i]
                            b = state[j]
                            if a>0 and b>0:
                                g = math.gcd(a,b)
                                new_state = list(state)
                                new_state[i] -= g
                                new_state[j] -= g
                                new_state = tuple(new_state)
                                steps = 1 + dfs(new_state, used_mask | (1<<idx))
                                if steps > max_steps:
                                    max_steps = steps
                    return max_steps
                return dfs(initial, 0)
            
