            def rank_gf3(M):
                # M is list of rows (list of ints 0-2)
                A = [row[:] for row in M]
                m = len(A)
                n = len(A[0])
                rank = 0
                row = 0
                for col in range(n):
                    # find pivot row with non-zero entry in column col
                    pivot = None
                    for r in range(row, m):
                        if A[r][col] % 3 != 0:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row to current row
                    A[row], A[pivot] = A[pivot], A[row]
                    # normalize pivot row to make leading 1
                    inv = {1:1, 2:2}  # since 2*2=4=1 mod3, inverse of 2 is 2
                    factor = inv[A[row][col] % 3]
                    A[row] = [(factor * x) % 3 for x in A[row]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r][col] % 3 != 0:
