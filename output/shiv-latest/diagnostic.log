            def count_regions(epsilon=1e-6):
                # plane coefficients list of (a,b,c,d)
                planes = [
                    (1,0,0,0),   # f1 = x
                    (1,0,0,-1),  # f2 = x-1
                    (0,1,0,0),   # f3 = y
                    (0,1,0,-1),  # f4 = y-1
                    (0,0,1,0),   # f5 = z
                    (0,0,1,-1),  # f6 = z-1
                    (-1,1,-1,1), # f7 = -x + y - z + 1
                    (-1,0,-1,1), # f8 = -x - z + 1
                    (0,-1,1,0)   # f9 = -y + z
                ]
                n = len(planes)
                count = 0
                feasible_patterns = []
                for bits in range(1<<n):
                    # build constraints
                    A_ub = []
                    b_ub = []
                    # we will use inequalities of form a*x + b*y + c*z <= b
                    # For sign positive: a*x+b*y+c*z+d >= epsilon => -(a*x+b*y+c*z+d) <= -epsilon
                    # For sign negative: a*x+b*y+c*z+d <= -epsilon => a*x+b*y+c*z+d <= -epsilon
                    for i, (a,b,c,d) in enumerate(planes):
                        sign = (bits>>i)&1  # 1 for positive side, 0 for negative side
                        if sign==1:
                            # -(a*x+b*y+c*z+d) <= -epsilon
                            A_ub.append([-a, -b, -c])
                            b_ub.append(-d - epsilon)
                        else:
                            # a*x+b*y+c*z+d <= -epsilon
                            A_ub.append([a, b, c])
                            b_ub.append(-d - epsilon)
                    # Solve LP: minimize 0 subject to A_ub x <= b_ub
                    # Use bounds None (unbounded)
                    res = linprog(c=[0,0,0], A_ub=A_ub, b_ub=b_ub, bounds=(None,None), method='highs')
                    if res.success:
                        count += 1
                        feasible_patterns.append(bits)
                return count, feasible_patterns
            
            cnt, patterns = count_regions()
            cnt
