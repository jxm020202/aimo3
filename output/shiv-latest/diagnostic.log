                A.append(row)
                lb.append(total)
                ub.append(total)
                # convert to arrays
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                # bounds for variables: >=0, no upper bound
                var_bounds = Bounds(0, np.inf)
                # integrality: all variables integer
