            from collections import deque
            
            def min_moves(n):
                # n coins, initial pattern: tails at odd positions (1-indexed) i.e., index 0 tails, index1 heads, etc.
                init = tuple(1 if i%2==0 else 0 for i in range(n))  # 0-indexed: even index => position 1,3,... tails
                target = tuple(0 for _ in range(n))
                # BFS
                # state: (config tuple, pos) where pos is index of last flipped coin, or -1 for start (no previous)
