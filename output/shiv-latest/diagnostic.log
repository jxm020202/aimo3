            def generate_partition_matrix(n):
                row_sum = n//2
                J = np.ones((n,n), dtype=int)
                sols = []
                # choose subset S of size row_sum (the opposite part)
                from itertools import combinations
                for S in combinations(range(n), row_sum):
                    S = set(S)
                    # define matrix: A[i,j]=1 iff (i in S) xor (j in S) (i.e., they are in different parts)
                    A = np.zeros((n,n), dtype=int)
                    for i in range(n):
                        for j in range(n):
                            if (i in S) != (j in S):
                                A[i,j]=1
                    # verify condition
                    if np.array_equal(A @ A + row_sum * A, row_sum * J):
                        sols.append(A)
                # Since S and complement produce same matrix, we will have duplicates. Let's deduplicate by converting to tuple.
                uniq = []
                seen = set()
                for A in sols:
                    key = tuple(A.flatten())
                    if key not in seen:
                        seen.add(key)
                        uniq.append(A)
                return uniq
            
            sol6_part = generate_partition_matrix(6)
            len(sol6_part)
            
