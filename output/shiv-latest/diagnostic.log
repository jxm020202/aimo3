                    theta = random.random()*2*math.pi
                    new_pt = (r*math.cos(theta), r*math.sin(theta))
                    new_pts = pts.copy()
                    new_pts[i] = new_pt
                    new_val = total_sum(new_pts)
                    if new_val > cur or random.random() < math.exp((new_val - cur)/max(T,1e-9)):
                        pts = new_pts
                        cur = new_val
                        if new_val > best:
                            best = new_val
                            best_pts = new_pts
                return best, best_pts
            
