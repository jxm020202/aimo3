            import sympy as sp
            
            # Define points
            A = sp.Point3D(0,0,0)
            B = sp.Point3D(1,0,0)
            C = sp.Point3D(1,1,0)
            D = sp.Point3D(0,1,0)
            A1 = sp.Point3D(0,0,1)
            B1 = sp.Point3D(1,0,1)
            C1 = sp.Point3D(1,1,1)
            D1 = sp.Point3D(0,1,1)
            
            def plane_from_points(p1,p2,p3):
                # returns (a,b,c,d) for plane ax+by+cz+d=0
                v1 = sp.Matrix(p2) - sp.Matrix(p1)
                v2 = sp.Matrix(p3) - sp.Matrix(p1)
                normal = v1.cross(v2)
                a,b,c = normal
                # compute d using point p1: a*x0 + b*y0 + c*z0 + d = 0 => d = -(a*x0 + b*y0 + c*z0)
                d = -(a*p1.x + b*p1.y + c*p1.z)
                # simplify
                return sp.simplify(a), sp.simplify(b), sp.simplify(c), sp.simplify(d)
            
            # Cube faces
            planes = []
            # bottom z=0
            planes.append((0,0,1,0))
            # top z=1
            planes.append((0,0,1,-1))
            # y=0
            planes.append((0,1,0,0))
            # y=1
            planes.append((0,1,0,-1))
            # x=0
            planes.append((1,0,0,0))
            # x=1
            planes.append((1,0,0,-1))
            
            # Tetrahedron faces
            # A1C1D1 (top) same as top plane, we can skip adding duplicate
            # B A1 C1
            planes.append(plane_from_points(B, A1, C1))
            # B C1 D1
            planes.append(plane_from_points(B, C1, D1))
            # B D1 A1
            planes.append(plane_from_points(B, D1, A1))
            
            planes
            
