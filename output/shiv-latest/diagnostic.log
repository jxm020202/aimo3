            def find_seq_n(n, edges):
                caps = [i for i in range(1,n)] + [n-1]
                target = edges*2
                # use simple backtracking search for small n
                sol = []
                def backtrack(idx, remaining, cur):
                    if idx == n:
                        if remaining == 0:
                            if is_graphical_debug(cur):
                                return cur[:]
                        return None
                    max_deg = caps[idx]
                    # prune: remaining must be <= sum of max remaining caps
                    max_possible = sum(caps[idx:])
                    min_possible = 0
                    if remaining < min_possible or remaining > max_possible:
                        return None
                    for d in range(min(max_deg, remaining), -1, -1):
                        cur.append(d)
                        res = backtrack(idx+1, remaining - d, cur)
                        if res:
                            return res
                        cur.pop()
                    return None
                return backtrack(0, target, [])
                
