                    pairs=[(0,1),(0,2),(0,3),(1,2),(1,3),(2,3)]
                    edges={}
                    for idx,(i,j) in enumerate(pairs):
                        if (orientation>>idx)&1:
                            edges[(i,j)]=True
                            edges[(j,i)]=False
                        else:
                            edges[(i,j)]=False
                            edges[(j,i)]=True
