            import math, itertools, random, numpy as np
            
            def max_angular_spread(points, i):
                # compute angular spread of vectors from points[i] to all other points
                xi, yi = points[i]
                angles = []
                for j, (xj, yj) in enumerate(points):
                    if i==j: continue
                    ang = math.atan2(yj-yi, xj-xi)
                    angles.append(ang)
                # Normalize to [0, 2π)
                angles = [a % (2*math.pi) for a in angles]
                angles.sort()
                # compute minimal angular interval covering all angles (i.e., max gap)
                max_gap = max((angles[(k+1)%len(angles)] - angles[k]) % (2*math.pi) for k in range(len(angles)))
                # angular spread = 2π - max_gap
                spread = 2*math.pi - max_gap
                return spread
            
            def test_arc(n=100, theta=math.radians(80)):
                # points on circle radius 1, arc from -theta/2 to +theta/2
                R=1.0
                angles = np.linspace(-theta/2, theta/2, n)
                points = [(R*math.cos(a), R*math.sin(a)) for a in angles]
                spreads = [max_angular_spread(points, i) for i in range(n)]
                return max(spreads), min(spreads)
            
