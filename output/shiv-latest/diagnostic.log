            def construct_board(n=19):
                rows = n
                cols = n
                # target column degrees: first 10 columns degree 3, next 8 columns degree 1, last column degree 0
                col_degrees = [3]*10 + [1]*8 + [0]
                # rows each degree 2
                row_degrees = [2]*rows
                # adjacency matrix
                board = [[0]*cols for _ in range(rows)]  # 0 black, 1 white
                # simple greedy: for each row, pick two columns with remaining degree >0
                # We'll iterate rows and assign to columns with highest remaining degree
                import heapq
                # Use max-heap of (remaining degree, column index)
                heap = [(-deg, idx) for idx, deg in enumerate(col_degrees) if deg>0]
                heapq.heapify(heap)
                for i in range(rows):
                    # need to assign 2 columns
                    assigned = []
                    for _ in range(2):
                        if not heap:
                            raise ValueError("Ran out of columns")
                        deg, idx = heapq.heappop(heap)
                        deg = -deg
                        # assign white cell at (i, idx)
                        board[i][idx] = 1
                        deg -= 1
                        assigned.append((deg, idx))
                    # push back updated columns if still have degree
                    for deg, idx in assigned:
                        if deg > 0:
                            heapq.heappush(heap, (-deg, idx))
                # verify column degrees
                col_counts = [sum(board[i][j] for i in range(rows)) for j in range(cols)]
                assert col_counts == col_degrees
                # verify row degrees
                row_counts = [sum(board[i][j] for j in range(cols)) for i in range(rows)]
                assert all(rc == 2 for rc in row_counts)
                # convert to flat list of bits (black=0, white=1)
                flat = [board[i][j] for i in range(rows) for j in range(cols)]
                return flat
            
