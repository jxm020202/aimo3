            def is_graphical(degrees):
                # Erdős–Gallai
                n=len(degrees)
                deg=sorted(degrees, reverse=True)
                if sum(deg)%2!=0:
                    return False
                prefix=[0]
                for d in deg:
                    prefix.append(prefix[-1]+d)
                for k in range(1,n+1):
                    left=prefix[k]
                    # right = k*(k-1) + sum_{i=k+1}^{n} min(d_i, k)
                    right = k*(k-1)
                    for d in deg[k:]:
                        right += min(d, k)
                    if left>right:
                        return False
                return True
            
            n=7671
            degrees=[i for i in range(1,n)] + [n-1]  # i from 1 to n-1, plus n-1 for last
