                # count ordered tuples of length r with entries 1..6 summing to target
                count = 0
                # brute force for r up to 3
                for rolls in itertools.product(range(1,7), repeat=r):
                    if sum(rolls) == target:
                        count += 1
                return count / (6**r)
            
