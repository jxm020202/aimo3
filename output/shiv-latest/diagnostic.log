            import math, itertools
            
            def count_triples(k, n_max):
                count = 0
                triples = []
                for a in range(1, k):
                    if math.gcd(a, k) != 1:
                        continue
                    b = k - a
                    # ensure gcd(a,b)=1 automatically if gcd(a,k)=1
                    for n in range(1, n_max+1, 2):  # odd n
                        if (pow(a, n, n) + pow(b, n, n)) % n == 0:
                            count += 1
                            triples.append((n,a,b))
                return count, triples
            
            def max_n_for_k(k, n_limit):
                # return set of n that work up to n_limit
                ns = set()
                for a in range(1, k):
                    if math.gcd(a, k) != 1:
                        continue
                    b = k - a
                    for n in range(1, n_limit+1, 2):
                        if (pow(a, n, n) + pow(b, n, n)) % n == 0:
                            ns.add(n)
                return ns
            
