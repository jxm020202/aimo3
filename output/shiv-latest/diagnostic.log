                    for n in range(1, max_n+1):
                        ceil_n_alpha = int((alpha * n).to_integral_value(rounding=decimal.ROUND_CEILING))
                        if m*ceil_n_alpha - n*floor_m_alpha == k:
                            pairs.add((m,n))
                return pairs
            
            def cool_pairs(alpha, k, max_m=200, max_n=200):
                pretty = pretty_pairs(alpha, k, max_m, max_n)
                cool = set()
                for (m,n) in pretty:
                    # check neighbors
