                pairs = [(i,j) for i in range(n) for j in range(i+1, n)]
                m = len(pairs)
                # objective: maximize sum x
                c = -np.ones(m)  # linprog minimizes, so negative
                # constraints: for each vertex i, sum over edges incident ≤ caps[i]
                A = np.zeros((n, m))
                for idx, (i,j) in enumerate(pairs):
                    A[i, idx] = 1
                    A[j, idx] = 1
                b = np.array(caps, dtype=float)
                # bounds 0 ≤ x ≤ 1
                bounds = [(0,1)]*m
                res = opt.linprog(c, A_ub=A, b_ub=b, bounds=bounds, method='highs')
                if not res.success:
                    raise RuntimeError("LP failed")
                # objective value
                max_edges = -res.fun
                # Since solution should be integral, round
                return int(round(max_edges))
            
