            def max_edges_given_caps(n):
                # caps: d_i = i for i=1..n-1, d_n = n-1
                caps = list(range(1, n)) + [n-1]  # length n
                # We'll use a multiset sorted descending
                import heapq
                # Use negative values for max-heap
                heap = [-c for c in caps if c>0]
                heapq.heapify(heap)
                total_edges = 0
                while heap:
                    # pop largest degree
                    d = -heapq.heappop(heap)
                    if d == 0:
                        continue
                    # number of other vertices remaining = len(heap)
                    m = len(heap)
                    k = min(d, m)
                    # we can only connect to k other vertices
                    total_edges += k
                    # pop k largest degrees from heap
                    temp = []
                    for _ in range(k):
                        nd = -heapq.heappop(heap)
                        nd -= 1  # reduce by 1 due to edge
                        if nd > 0:
                            temp.append(-nd)
                    # push back reduced degrees
                    for val in temp:
                        heapq.heappush(heap, val)
                    # if d > m, we discard the excess (cannot be used)
                    # continue loop
                return total_edges
            
