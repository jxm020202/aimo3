            def direction_angle(phi, psi):
                # point P at angle phi, target at angle psi on circle radius R=1
                R=1.0
                Px, Py = R*math.cos(phi), R*math.sin(phi)
                Qx, Qy = R*math.cos(psi), R*math.sin(psi)
                dx, dy = Qx-Px, Qy-Py
                return math.atan2(dy, dx)  # returns angle in [-pi, pi]
            
            def angular_spread_arc(theta):
                # compute max angular spread across all points P on arc [-theta/2, theta/2]
                # for each P, compute min and max direction angles to all points on arc
                # return the maximum spread (i.e., minimal covering interval length) across all P
                n_phi = 401
                n_psi = 401
                max_spread = 0.0
                for i in range(n_phi):
                    phi = -theta/2 + i*theta/(n_phi-1)
                    # compute direction angles to all points on arc
                    angles = []
                    for j in range(n_psi):
                        psi = -theta/2 + j*theta/(n_psi-1)
                        if abs(phi-psi) < 1e-12:
                            continue  # skip same point
                        ang = direction_angle(phi, psi)
                        angles.append(ang)
                    # normalize angles to [0, 2pi)
                    angles = [a if a>=0 else a+2*math.pi for a in angles]
                    # sort
                    angles.sort()
                    # compute minimal covering interval length = min over rotations of max-min
                    # Equivalent to compute max gap between consecutive angles (including wrap)
                    max_gap = 0.0
                    for k in range(len(angles)):
                        nxt = angles[(k+1)%len(angles)]
                        cur = angles[k]
                        if k == len(angles)-1:
                            gap = (angles[0] + 2*math.pi) - cur
                        else:
                            gap = nxt - cur
                        if gap > max_gap:
                            max_gap = gap
                    spread = 2*math.pi - max_gap
                    if spread > max_spread:
                        max_spread = spread
                return max_spread
            
