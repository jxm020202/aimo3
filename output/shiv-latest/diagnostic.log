            def cycles_of_map(mapping):
                n = len(mapping)
                visited = set()
                cycles = []
                for start in range(1,n+1):
                    if start not in visited:
                        # follow until repeat
                        cur = start
                        path = {}
                        step = 0
                        while cur not in visited and cur not in path:
                            path[cur] = step
                            step += 1
                            cur = mapping[cur]
                        if cur in path:
                            # found a cycle
                            cycle_start = cur
                            cycle = []
                            while True:
                                cycle.append(cur)
                                cur = mapping[cur]
                                if cur == cycle_start:
                                    break
                            cycles.append(cycle)
                        visited.update(path.keys())
                return cycles
            
