            def orthogonal_basis():
                n=19
                size=n*n
                # Build matrix M of shape (num_vectors, size) over GF(2)
                # each row is v_{i,j}
                M = []
                for i in range(n):
                    for j in range(n):
                        bits=0
                        for k in range(n):
                            idx=i*n + k
                            bits ^= 1 << idx
                        for k in range(n):
                            idx=k*n + j
                            bits ^= 1 << idx
                        idx=i*n + j
                        bits ^= 1 << idx
                        M.append(bits)
                # Perform Gaussian elimination to find nullspace of M (i.e., vectors w such that w·v=0)
                # We'll compute basis of nullspace using standard method: find basis of solutions to M * w^T = 0 (mod2)
                # Represent M as list of rows (int). We'll compute row echelon and track pivot columns.
                rows = M[:]
                size = n*n
                pivot_cols = []
                row = 0
                for col in range(size-1, -1, -1):
                    # find row with bit col set
                    sel = None
                    for r in range(row, len(rows)):
                        if (rows[r]>>col)&1:
                            sel = r
                            break
                    if sel is None:
                        continue
                    # swap
                    rows[row], rows[sel] = rows[sel], rows[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(len(rows)):
                        if r != row and ((rows[r]>>col)&1):
                            rows[r] ^= rows[row]
                    row += 1
                    if row == len(rows):
                        break
                # Now pivot_cols are the pivot columns. Non-pivot columns are free variables.
                pivot_set = set(pivot_cols)
                free_cols = [c for c in range(size) if c not in pivot_set]
                # For each free variable, construct a basis vector for nullspace.
                basis = []
                for free in free_cols:
                    # set free variable to 1, others 0, solve for pivots.
                    vec = 1 << free
                    # Back substitution: for each pivot row, determine pivot variable value.
                    # rows are in echelon form: each row has leading 1 at pivot col, and may have other 1s at free cols.
                    # We can compute pivot variable value such that dot(row, vec)=0.
                    # Since row * w = 0, we have pivot + sum_{free cols with 1} w_free = 0 => w_pivot = sum_{free cols with 1}
                    for r in range(len(pivot_cols)-1, -1, -1):
                        piv = pivot_cols[r]
