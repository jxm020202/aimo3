            import random, math, itertools, time
            
            def sum_ai(points, angle_deg=100):
                n = len(points)
                total = 0
                angle_rad = math.radians(angle_deg)
                for i, (xi, yi) in enumerate(points):
                    # compute angles to other points
                    angs = []
                    for j, (xj, yj) in enumerate(points):
                        if i == j:
                            continue
                        ang = math.atan2(yj-yi, xj-xi)
                        # normalize to [0, 2pi)
                        if ang < 0:
                            ang += 2*math.pi
                        angs.append(ang)
                    # sort angles
                    angs.sort()
                    # duplicate with +2pi for wrap-around
                    angs2 = angs + [a + 2*math.pi for a in angs]
                    # sliding window to find max count within angle_rad
                    maxcnt = 0
                    m = len(angs)
                    j = 0
                    for k in range(m):
                        while j < k+m and angs2[j] - angs2[k] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - k
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
