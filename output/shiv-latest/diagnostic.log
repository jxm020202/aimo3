            import itertools, math
            
            def max_ops_bruteforce(n):
                # BFS search state: (piles tuple, used pairs set)
                from collections import deque
                start = (tuple(range(1,n+1)), frozenset())
                visited = {start}
                max_ops = 0
                queue = deque([start])
                while queue:
                    piles, used = queue.popleft()
                    max_ops = max(max_ops, len(used))
                    # generate possible moves
                    for i in range(n):
                        for j in range(i+1,n):
                            if (i,j) in used: continue
                            if piles[i]==0 or piles[j]==0: continue
                            d = math.gcd(piles[i], piles[j])
                            if d==0: continue
                            # we can apply any d (gcd)
                            newp = list(piles)
                            newp[i] -= d
                            newp[j] -= d
                            newused = set(used)
                            newused.add((i,j))
                            newstate = (tuple(newp), frozenset(newused))
                            if newstate not in visited:
                                visited.add(newstate)
                                queue.append(newstate)
                return max_ops
            
            for n in range(2,6):
                print(n, max_ops_bruteforce(n))
            
