            import math, numpy as np
            
            def angle_at_i(alpha_i, alpha_a, alpha_b):
                # compute angle between vectors i->a and i->b
                xi, yi = math.cos(alpha_i), math.sin(alpha_i)
                xa, ya = math.cos(alpha_a), math.sin(alpha_a)
                xb, yb = math.cos(alpha_b), math.sin(alpha_b)
                va = np.array([xa - xi, ya - yi])
                vb = np.array([xb - xi, yb - yi])
                # compute angle between va and vb
                dot = np.dot(va, vb)
                norm = np.linalg.norm(va)*np.linalg.norm(vb)
                return math.degrees(math.acos(dot/norm))
            
            alpha_i = 0.0 # at center of arc? Actually choose i at 0 rad (midpoint)
