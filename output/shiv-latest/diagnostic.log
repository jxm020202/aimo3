            from functools import lru_cache
            import math, itertools
            
            def max_ops_bruteforce(N):
                # state: tuple of remaining coins (size N)
                init = tuple(range(1, N+1))
                # we also need set of used pairs; but we can treat each pair can be used at most once.
                # Represent used pairs as bitmask of length N*(N-1)/2 maybe large; for N up to 7 it's okay.
                pair_index = {}
                idx = 0
                for i in range(N):
                    for j in range(i+1, N):
                        pair_index[(i,j)] = idx
                        idx += 1
                total_pairs = idx
                @lru_cache(maxsize=None)
                def dfs(state, used_mask):
                    best = 0
                    # iterate over possible pairs not used
                    for i in range(N):
                        if state[i]==0: continue
                        for j in range(i+1, N):
                            if state[j]==0: continue
                            pi = pair_index[(i,j)]
                            if used_mask & (1<<pi): continue
                            g = math.gcd(state[i], state[j])
                            # remove g from each
                            new_state = list(state)
                            new_state[i] -= g
                            new_state[j] -= g
                            new_mask = used_mask | (1<<pi)
                            best = max(best, 1 + dfs(tuple(new_state), new_mask))
                    return best
                return dfs(init, 0)
            
