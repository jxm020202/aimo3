            from functools import lru_cache
            import itertools, math, sys
            
            def max_ops_bruteforce(N):
                initial_counts = tuple(range(N+1))  # index 0 unused
                # encode used pairs as bitmask? Number of possible pairs = N(N-1)/2, for N=7 it's 21, fits in int.
                pair_index = {}
                idx = 0
                for i in range(1,N):
                    for j in range(i+1,N+1):
                        pair_index[(i,j)] = idx
                        idx+=1
                total_pairs = idx
                
                @lru_cache(maxsize=None)
                def dfs(counts, used_mask):
                    best = 0
                    # iterate over all pairs not used
                    for i in range(1,N):
                        if counts[i]==0: continue
                        for j in range(i+1,N+1):
                            if counts[j]==0: continue
                            p = pair_index[(i,j)]
                            if (used_mask>>p)&1: continue
                            g = math.gcd(counts[i], counts[j])
                            new_counts = list(counts)
                            new_counts[i] -= g
                            new_counts[j] -= g
                            new_mask = used_mask | (1<<p)
                            best = max(best, 1 + dfs(tuple(new_counts), new_mask))
                    return best
                return dfs(initial_counts, 0)
            
