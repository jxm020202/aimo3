            import numpy as np, random, math, time
            
            def sum_a_numpy(pts):
                # pts: list of (x,y) length n
                n=len(pts)
                total=0
                width=math.radians(100)
                # convert to arrays
                xs=np.array([p[0] for p in pts])
                ys=np.array([p[1] for p in pts])
                for i in range(n):
                    dx=xs - xs[i]
                    dy=ys - ys[i]
                    # remove self
                    mask = np.arange(n)!=i
                    angles = np.arctan2(dy[mask], dx[mask])
                    angles.sort()
                    angles2 = np.concatenate((angles, angles+2*math.pi))
                    # sliding window using two-pointer
                    best=0
                    left=0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > width + 1e-12:
                            left+=1
                        cnt = right - left + 1
                        if cnt > best:
                            best = cnt
                    total += best
                return int(total)
            
            def collinear_points_np(n, spacing=1.0):
                return [(i*spacing,0.0) for i in range(n)]
            
