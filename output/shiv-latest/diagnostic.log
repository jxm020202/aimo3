                for i in range(n):
                    row[2*(n-1) + i] = 1  # s_i index
                A_eq.append(row)
                b_eq.append(1)
                # exactly one end
                row = [0]*m
                for i in range(n):
                    row[2*(n-1) + n + i] = 1  # t_i index
                A_eq.append(row)
                b_eq.append(1)
                # flow constraints for each vertex
                for i in range(n):
                    row = [0]*m
                    # outdegree_i
                    if i < n-1:
                        row[i] = 1  # x_i
                    if i > 0:
                        row[(n-1) + (i-1)] = 1  # y_{i-1}
                    # indegree_i (subtract)
                    if i > 0:
                        row[i-1] -= 1  # x_{i-1}
                    if i < n-1:
