            from math import comb
            def max_edges_milp(n):
                # use scipy MILP
                import numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                # number of variables: edges for each unordered pair i<j
                m = n*(n-1)//2
                # map pair to index
                pair_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1, n):
                        pair_index[(i,j)] = idx
                        idx += 1
                # objective: maximize sum of x
                c = -np.ones(m)  # milp minimizes, so use negative to maximize
                # constraints: for each vertex i, sum_{j != i} x_{i,j} <= cap_i
                A = np.zeros((n, m), dtype=int)
                caps = [i+1 for i in range(n-1)] + [n-1]  # vertex 0 has cap 1, etc.
                # Actually vertex i (0-index) corresponds to pile i+1, cap = i+1 for i<n-1, cap_n = n-1
                for i in range(n):
                    for j in range(n):
                        if i==j: continue
                        if i<j:
                            idx = pair_index[(i,j)]
                        else:
                            idx = pair_index[(j,i)]
                        A[i, idx] = 1
                # bounds for variables: binary 0/1
                bounds = Bounds(0, 1)
                # integrality: all variables integer
                integrality = np.ones(m, dtype=int)
                # linear constraints
                lc = LinearConstraint(A, -np.inf, caps)  # <= caps
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("MILP failed")
                # objective value is minimized c^T x = -edges, so edges = -res.fun
                edges = -res.fun
                return int(round(edges))
            
