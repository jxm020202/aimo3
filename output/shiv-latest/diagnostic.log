                    A.append(row)
                    b.append(1)
                A = np.array(A, dtype=float)
                b = np.array(b, dtype=float)
                # objective: maximize sum (x - y) => minimize -sum (x - y)
                c = np.zeros(2*m)
                for i in range(m):
                    c[i] = -1  # -x
                    c[m+i] = 1  # +y (since -(-y) = +y)
                # variable integrality
                integrality = np.ones(2*m)
                # bounds 0 to 1
                bounds = Bounds(0,1)
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds,
                           integrality=integrality, options={'disp': False})
                if not res.success:
