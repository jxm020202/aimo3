            import itertools, random, math, time
            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_weight_parity_ilp(m, p, q):
                N = m*m
                # variables: x_ij (binary), y_i (integer), z_j (integer)
                # We'll use integer variables for y_i, z_j but they can be unrestricted non-negative.
                # However milp only supports continuous variables with bounds and integrality flags.
                # We'll treat y_i, z_j as integer variables with bounds [0, m] maybe.
                # Number of variables = N + m + m
                n_vars = N + m + m
                # objective: maximize sum x_ij => minimize -sum x_ij
                c = np.zeros(n_vars)
                c[:N] = -1  # minimize negative sum => maximize sum
                # bounds: x in [0,1], y,z in [0,m] (since max flips per row/col)
                bounds = Bounds([0]*n_vars, [1]*N + [m]*m + [m]*m)
                # integrality: first N variables binary, next 2m integer
                integrality = np.array([True]*N + [True]* (2*m))
                # constraints:
                # Row parity: sum_j x_{i,j} - 2*y_i = p_i
                # Represent as equality: sum_j x - 2*y_i = p_i
                A_eq = []
                b_eq = []
                # rows
                for i in range(m):
                    row = np.zeros(n_vars)
                    for j in range(m):
                        idx = i*m + j
                        row[idx] = 1
                    row[N + i] = -2  # y_i
                    A_eq.append(row)
                    b_eq.append(p[i])
                # columns
                for j in range(m):
                    col = np.zeros(n_vars)
                    for i in range(m):
                        idx = i*m + j
                        col[idx] = 1
                    col[N + m + j] = -2  # z_j
                    A_eq.append(col)
                    b_eq.append(q[j])
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # Use milp
                res = milp(c=c, constraints=[LinearConstraint(A_eq, b_eq, b_eq)], bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    # fallback maybe infeasible
                    return None
                max_weight = -res.fun  # because we minimized negative sum
                return max_weight
            
            def min_weight_parity_ilp(m, p, q):
                # minimize sum x_ij
                N = m*m
                c = np.zeros(N + 2*m)
                c[:N] = 1  # minimize sum
                bounds = Bounds([0]* (N+2*m), [1]*N + [m]*m + [m]*m)
                integrality = np.array([True]*N + [True]* (2*m))
                A_eq = []
                b_eq = []
                for i in range(m):
                    row = np.zeros(N+2*m)
                    for j in range(m):
                        idx = i*m + j
                        row[idx] = 1
                    row[N + i] = -2
                    A_eq.append(row)
                    b_eq.append(p[i])
                for j in range(m):
                    col = np.zeros(N+2*m)
                    for i in range(m):
                        idx = i*m + j
                        col[idx] = 1
                    col[N + m + j] = -2
                    A_eq.append(col)
                    b_eq.append(q[j])
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                res = milp(c=c, constraints=[LinearConstraint(A_eq, b_eq, b_eq)], bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    return None
                min_weight = res.fun
                return min_weight
            
            def compute_n_via_ilp(m, trials=200):
                best_n = m*m+1
                best_pattern = None
                for _ in range(trials):
                    p = [random.randint(0,1) for _ in range(m)]
                    q = [random.randint(0,1) for _ in range(m)]
                    if sum(p)%2 != sum(q)%2:
