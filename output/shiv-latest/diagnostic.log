            def count_triples(k, Nmax):
                triples = []
                for a in range(1, k):
                    b = k - a
                    if math.gcd(a,b) != 1:
                        continue
                    # n odd positive up to Nmax
                    for n in range(1, Nmax+1, 2):
                        if pow(a, n, n) == (-pow(b, n, n)) % n: # check n|a^n+b^n
                            # Equivalent: (a**n + b**n) % n == 0, but use pow mod to avoid large numbers
                            if (pow(a, n, n) + pow(b, n, n)) % n == 0:
                                triples.append((n,a,b))
