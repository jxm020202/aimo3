            # Build matrix rows = generators V_{i,j}
            M = np.zeros((N, N), dtype=np.uint8)
            for i in range(n):
                for j in range(n):
                    row = np.zeros(N, dtype=np.uint8)
                    # row i (all columns)
                    for col in range(n):
                        row[idx(i, col)] ^= 1
                    # column j (all rows)
                    for rowi in range(n):
                        row[idx(rowi, j)] ^= 1
                    # This double counts (i,j) but we want it flipped only once, so we have flipped it twice; need to flip back?
                    # Actually we added row i and column j each toggling (i,j) once, resulting in two toggles -> 0. We need it to be 1.
                    # So we need to toggle (i,j) again.
                    row[idx(i,j)] ^= 1
                    M[idx(i,j), :] = row
            
            # Compute rank over GF(2)
            def rank_gf2(A):
                A = A.copy()
                m, n = A.shape
                rank = 0
                row = 0
                for col in range(n):
                    # find pivot row with A[pivot, col] = 1
                    pivot = None
                    for r in range(row, m):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row with current row
                    if pivot != row:
                        A[[pivot, row]] = A[[row, pivot]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r, col]:
                            A[r] ^= A[row]
                    rank += 1
                    row += 1
                    if row == m:
                        break
                return rank
            
