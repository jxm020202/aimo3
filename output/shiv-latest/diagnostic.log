                    # Reduce the first element (largest) by 1
                    # Find its position in original seq to reduce
                    max_val = seq_sorted[0]
                    # Find index of max_val in seq (first occurrence)
                    idx = seq.index(max_val)
                    seq[idx] -= 1
                total_deg = sum(seq)
