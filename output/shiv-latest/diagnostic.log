            def max_edges_given_bounds(n):
                # upper bounds: for vertices 1..n, bound_i = min(i, n-1)
                bounds = [min(i, n-1) for i in range(1, n+1)]
                # We'll try to assign degrees d_i <= bound_i, maximize sum d_i.
                # Use greedy: start with all vertices with capacity = bound_i.
                # We'll attempt to construct graph using Havel-Hakimi; if fails, we reduce some capacities.
                # Instead, we can use a simple algorithm: while there exist two vertices with remaining capacity >0 and not already connected, connect them.
                # However we need to track edges to avoid duplicates.
                # For large n, we cannot store all edges; but for small n we can.
                import itertools
                # Use adjacency set
                adj = [set() for _ in range(n)]
                caps = bounds[:]  # remaining degree capacity
                # We'll repeatedly pick two vertices i<j with caps[i]>0, caps[j]>0, and not already connected.
                # Choose the pair with highest caps maybe.
                # Simple loop: iterate over all pairs each time may be O(n^2) but fine for n up to 200.
                while True:
                    # find pair
                    found=False
                    # sort vertices by remaining caps descending
                    order = sorted([i for i in range(n) if caps[i]>0], key=lambda x: caps[x], reverse=True)
                    for idx_i in range(len(order)):
                        i = order[idx_i]
                        for idx_j in range(idx_i+1, len(order)):
                            j = order[idx_j]
                            if j in adj[i]:
                                continue
                            # we can connect
                            adj[i].add(j)
                            adj[j].add(i)
                            caps[i]-=1
                            caps[j]-=1
                            found=True
                            break
                        if found:
                            break
                    if not found:
                        break
                total_edges = sum(len(s) for s in adj)//2
                return total_edges, caps, bounds
            
            for n in range(2,13):
                edges, caps, bounds = max_edges_given_bounds(n)
                print(n, edges)
            
