                        # compute row sum and column sum
                        row_sum = sum(a[idx(i,k)] for k in range(size)) % 2
                        col_sum = sum(a[idx(k,j)] for k in range(size)) % 2
                        # t = row_sum + col_sum + a_{i,j} (mod2)
                        t[idx_ij] = (row_sum + col_sum + a[idx(i,j)]) % 2
