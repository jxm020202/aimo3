            def EG_violations(n):
                # caps sorted descending as described
                # compute S_k and R_k
                violations = []
                for k in range(1, n+1):
                    S_k = k*n - k*(k-1)//2 - 1  # integer
                    # compute sum_{i=k+1}^{n} min(d_i, k)
                    # Determine indices i from k+1 to n
                    a = k+1
                    b = n - k  # last index where d_i > k (if a <= b)
                    sum_min = 0
                    if a <= b:
                        # count of indices with d_i > k
                        cnt = b - a + 1
                        sum_min += cnt * k
                        start = b+1
                    else:
                        start = a
                    # now sum d_i from start to n (where d_i <= k)
                    # d_i = n - i + 1 for i >= 3, but also for i=1,2 we have n-1.
                    # However start >= k+1 >= 2, so start >=2.
                    # For i=2, d_2 = n-1, but if start <=2, we need to handle.
                    # We'll compute directly using formula for d_i.
                    for i in range(start, n+1):
                        if i == 1:
                            d = n-1
                        elif i == 2:
                            d = n-1
                        else:
                            d = n - i + 1
                        sum_min += d
                    R_k = k*(k-1) + sum_min
                    if S_k > R_k:
                        violations.append((k, S_k, R_k))
                return violations
            
            viol = EG_violations(20)
            viol[:10]
            
