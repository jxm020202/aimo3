            from functools import lru_cache
            import math
            def max_ops(n):
                # initial piles sizes 1..n
                init = tuple(range(1, n+1))
                # encode used pairs as bitmask of size n*(n-1)//2
                pair_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1, n):
                        pair_index[(i,j)] = idx
                        idx += 1
                total_pairs = idx
                @lru_cache(maxsize=None)
                def dfs(state, used_mask):
                    # state: tuple of sizes
                    best = 0
                    # generate possible operations
                    for i in range(n):
                        a = state[i]
                        if a == 0:
                            continue
                        for j in range(i+1, n):
                            b = state[j]
                            if b == 0:
                                continue
                            if used_mask & (1 << pair_index[(i,j)]):
                                continue
                            g = math.gcd(a,b)
                            if g == 0:
                                continue
                            # perform operation
                            new_state = list(state)
                            new_state[i] -= g
                            new_state[j] -= g
                            new_state = tuple(new_state)
                            new_mask = used_mask | (1 << pair_index[(i,j)])
                            val = 1 + dfs(new_state, new_mask)
                            if val > best:
                                best = val
                    return best
                return dfs(init, 0)
            
            for n in range(2,7):
                print(n, max_ops(n))
            
