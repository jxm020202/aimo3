            import math, random, heapq
            
            def max_ops_gcd(n, max_iter=1000000):
                # initial coins
                a = [i+1 for i in range(n)]  # index 0..n-1 corresponds to pile i+1
                used = set()
                ops = 0
                # We'll use a simple heuristic: at each step, find any pair with gcd=1
                # We'll try random selection many times to see if we can reach theoretical max
                # For small n, we can brute force search for best.
                # Here we implement greedy: pick pair with max min(a_i,a_j) maybe.
                while True:
                    # find all candidate pairs
                    candidates = []
                    for i in range(n):
                        if a[i]==0: continue
                        for j in range(i+1, n):
                            if a[j]==0: continue
                            if (i,j) in used: continue
                            if math.gcd(a[i], a[j]) == 1:
                                candidates.append((i,j))
                    if not candidates:
                        break
                    # pick a random candidate (or heuristic)
                    i,j = random.choice(candidates)
                    # perform operation
                    a[i] -= 1
                    a[j] -= 1
                    used.add((i,j))
                    ops += 1
                return ops, sum(a)
            
