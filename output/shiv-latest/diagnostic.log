            # Blocking constraints
            def get_blocking_cells(typ, r, c, direction):
                # returns list of required cells; empty list if automatically blocked
                if typ == 'H':
                    if direction == 'L':
                        if c == 0:
                            return []  # automatically blocked
                        return [(r, c-1)]
                    if direction == 'R':
                        if c+1 == 6:
                            return []
                        return [(r, c+2)]
                    if direction == 'U':
                        if r == 0:
                            return []
                        return [(r-1, c), (r-1, c+1)]
                    if direction == 'D':
                        if r == 6:
                            return []
                        return [(r+1, c), (r+1, c+1)]
                else: # 'V'
                    if direction == 'U':
                        if r == 0:
                            return []
                        return [(r-1, c)]
                    if direction == 'D':
                        if r+1 == 6:
                            return []
                        return [(r+2, c)]
                    if direction == 'L':
                        if c == 0:
                            return []
                        return [(r, c-1), (r+1, c-1)]
                    if direction == 'R':
                        if c == 6:
                            return []
                        return [(r, c+1), (r+1, c+1)]
                raise ValueError
            
            directions = ['L','R','U','D']
            for i, (typ, r, c) in enumerate(dominoes):
                for d in directions:
                    req_cells = get_blocking_cells(typ, r, c, d)
                    if not req_cells:
                        continue  # automatically blocked
                    # union of domino indices covering any of these cells
                    covering = set()
                    for cell in req_cells:
                        covering.update(cell_to_dominos[cell])
                    # Build constraint: sum_{j in covering} x_j >= x_i
                    row = np.zeros(len(dominoes))
                    for j in covering:
                        row[j] = 1
                    # inequality: sum >= x_i
                    # rewrite as sum - x_i >= 0
                    row[i] -= 1
                    A_rows.append(row)
                    lb.append(0)  # >=0
                    ub.append(np.inf)  # no upper bound
            len(A_rows)
            
