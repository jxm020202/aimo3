                for i, ((a,b,c0,d), s) in enumerate(zip(plane_list, signs)):
                    # row for inequality: expression +/- s_i <= 0
                    row = [0]*total_vars
                    # coefficients for x,y,z
                    row[0] = a
                    row[1] = b
                    row[2] = c0
                    # coefficient for s_i
                    if s == 1:
                        # a*x + b*y + c*z + d - s_i <= 0  (since >= s_i)
                        row[3+i] = -1
                        # constant term: d
                        const = d
                    else:
                        # a*x + b*y + c*z + d + s_i <= 0  (since <= -s_i)
                        row[3+i] = 1
                        const = d
                    A_ub.append(row)
                    b_ub.append(-const)  # move constant to RHS: a*x+... + ... <= -d
