            def feasible_n(n, total):
                # Build MILP for given n and total sum
                N = n*n
                # map cell index to (i,j)
                idx = lambda i,j: i*n + j
                # list of edges
                edges = []
                for i in range(n):
                    for j in range(n):
                        if i+1 < n:
                            edges.append((idx(i,j), idx(i+1,j)))
                        if j+1 < n:
                            edges.append((idx(i,j), idx(i,j+1)))
                E = len(edges)
                # variables: x (N) + d (E)
                # objective: none (feasibility). We'll set dummy objective 0.
                c = np.zeros(N+E)
                # constraints: for each edge, x_u - x_v + 2*d = 1
                A = []
                lb = []
                ub = []
                for (u,v) in edges:
                    row = np.zeros(N+E)
                    row[u] = 1
                    row[v] = -1
                    # d variable index
                    d_idx = N + edges.index((u,v))  # but edges list may have duplicates? Not
                    row[d_idx] = 2
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # sum constraint
                row_sum = np.zeros(N+E)
                row_sum[:N] = 1
                A.append(row_sum)
                lb.append(total)
                ub.append(total)
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                # bounds for variables: x >=0, no upper bound; d binary 0..1
                x_bounds = [(0, None)]*N
                d_bounds = [(0,1)]*E
                bounds = Bounds([b[0] for b in x_bounds+d_bounds],
                                [b[1] if b[1] is not None else np.inf for b in x_bounds+d_bounds])
                # integrality: all variables integer, but we can set integrality for all
                integrality = np.ones(N+E, dtype=int)
                # linear constraints
                lin_con = LinearConstraint(A, lb, ub)
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'disp': False})
                return res.success, res
            
