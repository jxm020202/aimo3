            def get_path(n):
                init = 0
                for i in range(n):
                    if (i+1)%2==1:
                        init |= (1<<i)
                target = 0
                from collections import deque
                visited = {}
                dq = deque()
                for pos in range(n):
                    mask = init ^ (1<<pos)
                    visited[(pos, mask)] = (None, None)  # parent
                    dq.append((pos, mask))
                while dq:
                    pos, mask = dq.popleft()
                    if mask == target:
                        # reconstruct path
                        path = []
                        cur = (pos, mask)
                        while cur is not None:
                            path.append(cur[0])
                            cur = visited[cur][0]
                        path.reverse()
                        return path
                    for np in [pos-1, pos+1]:
                        if 0 <= np < n:
                            newmask = mask ^ (1<<np)
                            state = (np, newmask)
                            if state not in visited:
                                visited[state] = ((pos, mask), None)
                                dq.append(state)
