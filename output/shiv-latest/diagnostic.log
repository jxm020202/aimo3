            import math, collections, itertools, sys, time, random
            
            def pretty_pairs(alpha, k, max_m, max_n=None):
                # generate pretty pairs with m up to max_m, n up to max_n if given else unlimited (but limited by derived n)
                pretty=set()
                for m in range(1, max_m+1):
                    a = math.floor(m*alpha)
                    if a==0:
                        # then equation: m*ceil(nα) = k
                        # So ceil(nα) = k/m must be integer
                        if k % m != 0:
                            continue
                        b = k//m
                        # need n such that ceil(nα)=b
                        # n must satisfy (b-1) < nα <= b
                        # => n in ((b-1)/α, b/α]
                        low = (b-1)/alpha
                        high = b/alpha
                        n_low = math.floor(low)+1
                        n_high = math.floor(high)
                        for n in range(n_low, n_high+1):
                            if n>0:
                                pretty.add((m,n))
                        continue
                    # a>0
                    # we need b such that (m*b - k) % a == 0 and n>0
                    # b must be >=1 (ceil positive)
                    # also n = (m*b - k)//a >0 => m*b > k
                    # Let's bound b: we can limit n to some max_n if provided else we can bound b by maybe (k + a*max_n)/m
                    # We'll iterate b up to a reasonable limit: maybe up to (k + a*max_n)/m where max_n maybe max_m*some factor.
                    # For now, we iterate b up to (k + a*max_m)/m + 10
                    max_b = (k + a* (max_m if max_n is None else max_n) ) // m + 10
                    for b in range(1, max_b+1):
                        if m*b <= k:
                            continue
                        if (m*b - k) % a != 0:
                            continue
                        n = (m*b - k)//a
                        if n <=0:
                            continue
                        # verify ceil(nα) == b
                        if math.ceil(n*alpha) != b:
                            continue
                        # optionally enforce n <= max_n if limit
                        if max_n is not None and n > max_n:
                            continue
                        pretty.add((m,n))
                return pretty
            
            def cool_pairs_from_pretty(pretty):
                cool=set()
                for (m,n) in pretty:
                    if (m-n, n) not in pretty and (m, n-m) not in pretty:
                        cool.add((m,n))
                return cool
            
            def count_cool(alpha, k, max_m, max_n=None):
                pretty = pretty_pairs(alpha, k, max_m, max_n)
                cool = cool_pairs_from_pretty(pretty)
                return len(cool), len(pretty)
            
