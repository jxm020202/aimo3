                for r in range(1, n+1):
                    for c in range(1, n+1):
                        row = np.zeros(num_vars, dtype=int)
                        for idx in cell_to_dominos.get((r,c), []):
                            row[idx] = 1
                        rows.append(row)
                        lbs.append(-np.inf)
                        ubs.append(1)
                # blocking constraints conditional
                for i, d in enumerate(dominos):
                    typ, r, c = d
                    neighbor_groups = []
