            def polygon_coords(sign, y):
                # sign = s orientation (+1 CCW, -1 CW)
                s = sign
                theta = s*105*sp.pi/180
                # compute points
                P = sp.Point(0,0)
                Q = sp.Point(2,0)
                QR = sp.Matrix([sp.sqrt(2)*sp.cos(theta), sp.sqrt(2)*sp.sin(theta)])
                R = sp.Point(Q.x + QR[0], Q.y + QR[1])
                phi = s*90*sp.pi/180
                RS = sp.Matrix([sp.sqrt(2)*sp.cos(theta + phi), sp.sqrt(2)*sp.sin(theta + phi)])
                S = sp.Point(R.x + RS[0], R.y + RS[1])
                T = sp.Point(0, y)
                return [P, Q, R, S, T]
            
            def is_convex(pts):
                # compute cross product signs for consecutive triples
                signs = []
                n = len(pts)
                for i in range(n):
                    o = pts[i]
                    a = pts[(i+1)%n]
                    b = pts[(i+2)%n]
                    cross = (a.x - o.x)*(b.y - o.y) - (a.y - o.y)*(b.x - o.x)
                    signs.append(float(cross))
                # Check all non-zero and same sign
                # ignore near-zero tolerance
                eps = 1e-6
                nonzero = [s for s in signs if abs(s) > eps]
                if not nonzero:
                    return False
                first = nonzero[0]
                return all(s*first > 0 for s in nonzero)
            
