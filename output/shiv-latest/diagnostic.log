            def plane_eq(p1,p2,p3):
                # return coefficients (a,b,c,d) for plane ax+by+cz+d=0
                # compute normal as cross product of (p2-p1) and (p3-p1)
                v1 = sp.Matrix(p2) - sp.Matrix(p1)
                v2 = sp.Matrix(p3) - sp.Matrix(p1)
                n = v1.cross(v2)
                a,b,c = n
                # compute d using point p1: a*x0 + b*y0 + c*z0 + d = 0 => d = -(a*x0+b*y0+c*z0)
                d = -(a* p1.x + b* p1.y + c* p1.z)
