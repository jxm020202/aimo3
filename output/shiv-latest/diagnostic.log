            def plane_from_points(p1,p2,p3):
                # returns (a,b,c,d) such that a x + b y + c z + d = 0
                v1 = sp.Matrix(p2) - sp.Matrix(p1)
                v2 = sp.Matrix(p3) - sp.Matrix(p1)
                normal = v1.cross(v2)
                a,b,c = normal
                # compute d using point p1
                d = -(a*p1.x + b*p1.y + c*p1.z)
                # Simplify
                return sp.simplify(a), sp.simplify(b), sp.simplify(c), sp.simplify(d)
            
            planes = []
            # cube faces
            planes.append((1,0,0,0))   # x=0
            planes.append((1,0,0,-1))  # x-1=0
            planes.append((0,1,0,0))   # y=0
            planes.append((0,1,0,-1))  # y-1=0
            planes.append((0,0,1,0))   # z=0
            planes.append((0,0,1,-1))  # z-1=0
            
            # tetrahedron faces
