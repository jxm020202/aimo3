            def random_vector():
                # generate random sorted vector with sum 1
                # generate 9 random numbers from normal, then shift to sum 1, then sort
                xs = [random.gauss(0,1) for _ in range(9)]
                s = sum(xs)
                xs = [x - s/9 + 1/9 for x in xs]
                xs.sort()
