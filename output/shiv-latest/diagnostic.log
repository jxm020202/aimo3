            def max_clique_bitset():
                n = len(vectors)
                # adjacency bitsets already computed as adj list of ints
                best_clique = []
                # order vertices by degree descending (all same degree)
                # We'll use list of vertices 0..n-1 as initial candidate set
                all_vertices = list(range(n))
                
                # Precompute neighbor sets as bitsets for fast intersection
                neighbor = adj  # list of ints
                
                # Helper to convert list to bitset
                def list_to_bitset(lst):
                    mask = 0
                    for v in lst:
                        mask |= (1 << v)
                    return mask
                
                # Greedy coloring bound for a set of vertices given as list (ordered)
                def coloring_bound(candidates):
                    # greedy coloring: assign smallest possible color not used by neighbors earlier
                    colors = {}
                    max_color = 0
                    # order candidates by descending degree (same)
                    for v in candidates:
                        # find colors used by neighbors already colored
                        used = set()
                        for u, col in colors.items():
                            if (neighbor[v] >> u) & 1:  # u is neighbor of v
                                used.add(col)
                        # assign smallest color not used
                        c = 1
                        while c in used:
                            c += 1
                        colors[v] = c
                        if c > max_color:
                            max_color = c
                    return max_color
                
                # Recursive function
                def expand(R, P):
                    nonlocal best_clique
                    if not P:
                        if len(R) > len(best_clique):
                            best_clique = R[:]
                        return
                    # ordering P for coloring bound: we can sort by degree descending (same)
                    # compute bound
                    bound = len(R) + coloring_bound(P)
                    if bound <= len(best_clique):
                        return
                    # Choose vertex with maybe highest degree (any)
                    # We'll iterate over copy of P in reverse order (as typical)
                    for i in range(len(P)-1, -1, -1):
