            def greedy_clique():
                # start with random vertex
                v = random.randrange(n)
                clique = {v}
                # candidates are neighbors of v
                candidates = set(adj[v])
                while candidates:
                    # choose candidate with max degree within candidates (heuristic)
                    # compute intersection size with candidates
                    best = None
                    best_score = -1
                    for u in candidates:
                        # number of neighbors of u within candidates
                        score = len(adj[u] & candidates)
                        if score > best_score:
                            best_score = score
                            best = u
                    # add best
                    clique.add(best)
                    # update candidates to those adjacent to all in clique
                    candidates = {u for u in candidates if u in adj[best]}
                    # also need to ensure adjacency to all existing clique members
                    # we can intersect with adjacency of each new member
                    for w in list(candidates):
                        if not all(w in adj[x] for x in clique):
                            candidates.remove(w)
                return clique
            
            best_clique = set()
            start = time.time()
            for it in range(2000):
                c = greedy_clique()
                if len(c) > len(best_clique):
                    best_clique = c
                    print("new best", len(best_clique), "iter", it, "time", time.time()-start)
            print("final best size", len(best_clique))
            
