            import random, math
            
            def satisfies_constraints(m,n,k):
                g=math.gcd(m,n)
                if k%g!=0:
                    return False
                k1=k//g
                m1=m//g
                n1=n//g
                if m1+n1 <= k1:
                    return False
                # cool condition: if m1>n1, need m1 <= k1; if n1>m1, need n1 <= k1; if equal, need 2*m1 > k1
                if m1>n1:
                    if m1>k1:
                        return False
                elif n1>m1:
                    if n1>k1:
                        return False
                else: # equal
                    if 2*m1 <= k1:
                        return False
                return True
            
