            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_one_minus_three(n):
                # edges indexed by (i,j) with i<j
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variable order: first x_e for each edge, then y_e for each edge
                # total variables = 2*m
                # objective: maximize sum(x) - sum(y) => c = [-1 for x? Actually milp minimizes c^T x, so we set c = -objective
                c = np.concatenate([ -np.ones(m), np.ones(m) ])  # because we minimize c^T var, var = [x,y]; we want maximize sum(x)-sum(y) => minimize -(sum(x)-sum(y)) = -sum(x)+sum(y)
                # bounds: x,y binary => 0 <= var <= 1
                bounds = Bounds(0, 1)
                # integrality: all variables integer (binary)
                integrality = np.ones(2*m, dtype=int)
                # constraints list
                A = []
                b = []
                # For each triangle, constraints:
                # 1) x_ij + x_jk + x_ik <= 2
                # 2) For each edge, x_other1 + x_other2 <= 1 + y_edge
                # We'll add them as linear inequalities A_ub x <= b_ub
                for (i,j,k) in itertools.combinations(range(n),3):
                    # indices of edges
                    def edge_index(a,b):
                        if a>b: a,b=b,a
                        return edges.index((a,b))
                    idx_ij = edge_index(i,j)
                    idx_jk = edge_index(j,k)
                    idx_ik = edge_index(i,k)
                    # constraint 1: x_ij + x_jk + x_ik <= 2
                    row = np.zeros(2*m)
                    row[idx_ij] = 1
                    row[idx_jk] = 1
                    row[idx_ik] = 1
                    A.append(row)
                    b.append(2)
                    # constraint 2 for edge ij: x_ik + x_jk <= 1 + y_ij
                    row = np.zeros(2*m)
                    row[idx_ik] = 1
                    row[idx_jk] = 1
                    row[m + idx_ij] = -1  # -y_ij on left side
                    # inequality: x_ik + x_jk - y_ij <= 1
                    A.append(row)
                    b.append(1)
                    # similarly for edge jk: x_ij + x_ik <= 1 + y_jk
                    row = np.zeros(2*m)
                    row[idx_ij] = 1
                    row[idx_ik] = 1
                    row[m + idx_jk] = -1
                    A.append(row)
                    b.append(1)
                    # edge ik: x_ij + x_jk <= 1 + y_ik
                    row = np.zeros(2*m)
                    row[idx_ij] = 1
                    row[idx_jk] = 1
                    row[m + idx_ik] = -1
                    A.append(row)
                    b.append(1)
                A = np.array(A)
                b = np.array(b)
                # Use milp
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("Failed", res.message)
                    return None
                x = res.x[:m]
                y = res.x[m:]
                # compute objective value
                obj = sum(x) - sum(y)
                # round to nearest integer
                obj = round(obj)
                return obj
            
            for n in range(3,9):
                print(n, max_one_minus_three(n))
            
