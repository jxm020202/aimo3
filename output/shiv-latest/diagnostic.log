            def skewed_arc_points(n, arc_deg=100, skew=5):
                # generate angles using exponential distribution truncated to [0,arc]
                # skew parameter >0: larger skew means more points near 0
                import random, math
                angles = []
                for _ in range(n):
                    # generate u in (0,1)
                    u = random.random()
                    # transform using inverse CDF of truncated exponential: x = -ln(1 - u*(1 - exp(-skew)))/skew * arc
