            import itertools, math, numpy as np, scipy.optimize as opt, sys, time, warnings, collections, random, math, itertools, numpy as np, scipy.optimize as opt
            def max_ops_ILP(N):
                # variable ordering: for each unordered pair i<j, we have x_{ij} binary, w_{ij} integer >=0
                pairs=[(i,j) for i in range(1,N+1) for j in range(i+1,N+1)]
                m=len(pairs)
                # We'll use MILP with integer variables: w_{ij} integer, x_{ij} binary.
                # Build matrices for constraints.
                # Number of variables = 2*m (x and w)
                # We'll use scipy.optimize.milp which expects c, A_ub, b_ub, A_eq, b_eq, integrality, bounds.
                # Build c (objective) to maximize sum x => minimize -sum x.
                c = np.zeros(2*m)
                # x variables first m, w variables next m
                for idx in range(m):
                    c[idx] = -1  # minimize negative sum => maximize sum x
                # bounds: x in [0,1], w >=0
                bounds = opt.Bounds([0]*2*m, [1]*m + [np.inf]*m)
                integrality = np.concatenate([np.ones(m), np.ones(m)])  # both integer (binary for x, integer for w)
                # Constraints:
                # For each vertex i: sum_{j} w_{ij} = i
                A_eq = np.zeros((N, 2*m))
                b_eq = np.zeros(N)
                for vi in range(1,N+1):
                    row = vi-1
                    for idx,(i,j) in enumerate(pairs):
                        if i==vi or j==vi:
                            # w variable index = m + idx
                            A_eq[row, m+idx] = 1
                    b_eq[row] = vi
                # For each pair (i,j): w_{ij} <= min(i,j) * x_{ij}
                # Also w_{ij} >= x_{ij} (i.e., w - x >= 0)
                A_ub = np.zeros((m*2, 2*m))
                b_ub = np.zeros(m*2)
                for idx,(i,j) in enumerate(pairs):
                    M = min(i,j)
                    # w - M*x <= 0  => w - M*x <= 0
                    A_ub[2*idx, m+idx] = 1
                    A_ub[2*idx, idx] = -M
                    b_ub[2*idx] = 0
                    # -w + x <= 0  => -w + x <= 0  (i.e., w >= x)
                    A_ub[2*idx+1, m+idx] = -1
                    A_ub[2*idx+1, idx] = 1
                    b_ub[2*idx+1] = 0
                # Solve MILP
                res = opt.milp(c, bounds=bounds, constraints=opt.LinearConstraint(A_ub, -np.inf, b_ub), integrality=integrality, options={'disp': False})
                if not res.success:
                    print("MILP failed", res.message)
                    return None
                x_vals = res.x[:m]
                ops = int(round(sum(x_vals)))
                return ops
            
            for N in range(3,9):
                print(N, max_ops_ILP(N))
            
