            from scipy.optimize import milp, LinearConstraint, Bounds
            def max_ops_ILP(N):
                pairs=[(i,j) for i in range(1,N+1) for j in range(i+1,N+1)]
                m=len(pairs)
                # variables: x (binary) first m, w next m
                total_vars=2*m
                c = np.zeros(total_vars)
                c[:m] = -1  # maximize sum x
                # bounds: x in [0,1], w >=0
                lower = np.zeros(total_vars)
                upper = np.concatenate([np.ones(m), np.full(m, np.inf)])
                bounds = Bounds(lower, upper)
                integrality = np.ones(total_vars, dtype=int)
                constraints=[]
                # equality constraints per vertex
                A_eq = np.zeros((N, total_vars))
                for vi in range(1,N+1):
                    row=vi-1
                    for idx,(i,j) in enumerate(pairs):
                        if i==vi or j==vi:
                            A_eq[row, m+idx]=1
                    constraints.append(LinearConstraint(A_eq[row], [vi], [vi]))
                # inequality constraints per pair
                for idx,(i,j) in enumerate(pairs):
                    M=min(i,j)
                    # w - M*x <= 0
                    a = np.zeros(total_vars)
                    a[m+idx]=1
                    a[idx]=-M
                    constraints.append(LinearConstraint(a, -np.inf, 0))
                    # -w + x <= 0  => x - w <=0
                    a2 = np.zeros(total_vars)
                    a2[idx]=1
                    a2[m+idx]=-1
                    constraints.append(LinearConstraint(a2, -np.inf, 0))
                res = milp(c, constraints=constraints, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("failed", res.message)
                    return None
                x_vals = np.rint(res.x[:m])
                ops = int(x_vals.sum())
                return ops
            
            for N in range(3,9):
                print(N, max_ops_ILP(N))
            
