            def compute_sum_fast(points, sector=math.radians(100)):
                n=len(points)
                total=0
                for i in range(n):
                    xi, yi = points[i]
                    # compute angles to others
                    angles=[]
                    for j in range(n):
                        if i==j: continue
                        xj,yj=points[j]
                        ang=math.atan2(yj-yi, xj-xi)
                        if ang<0: ang+=2*math.pi
