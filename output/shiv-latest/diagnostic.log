        \[
f(n)=\max_{a_i\in[-1,1]}\frac1n\sum_{i=1}^{n}\Bigl|\,\frac{S-a_i}{n}-a_i\Bigr|
      =\frac1n\max_{a_i\in[-1,1]}\sum_{i=1}^{n}\bigl|S-(n+1)a_i\bigr|
\]

where \(S=\sum a_i\).
The function \(\sum |S-(n+1)a_i|\) is convex in the vector \((a_1,\dots ,a_n)\);
hence its maximum on the convex cube \([-1,1]^n\) is attained at a vertex,
i.e. each \(a_i\) equals \(\pm1\).

Let \(p\) be the number of \(+1\)’s, \(d=n-p\) the number of \(-1\)’s.
Then  

\[
S=n-2d,\qquad 
|S-(n+1)\cdot 1|=2d+1,\qquad 
|S-(n+1)(-1)|=2p+1 .
\]

Thus  

\[
\sum_{i=1}^{n}|S-(n+1)a_i|
   =p(2d+1)+d(2p+1)=4pd+n .
\]

Consequently  

\[
f(n)=\frac{4p d}{n}+1,\qquad p d=p(n-p).
\]

The product \(p(n-p)\) is maximal for \(p=\lfloor n/2\rfloor\) (or \(\lceil n/2\rceil\)),
giving  

\[
\boxed{f(n)=1+\frac{4\lfloor n/2\rfloor\lceil n/2\rceil}{n}} .
\]

Hence  

\[
f(n)=\begin{cases}
n+1, & n\text{ even},\\[2mm]
n+1-\dfrac1n, & n\text{ odd}.
\end{cases}
\]

Now  

\[
\sum_{k=1}^{225}k f(k)=\sum_{k=1}^{225}k(k+1)-\#\{k\le 225\mid k\text{ odd}\}.
\]

The first sum is  

\[
\sum_{k=1}^{n}k(k+1)=\sum_{k=1}^{n}(k^2+k)
 =\frac{n(n+1)(2n+1)}6+\frac{n(n+1)}2
 =\frac{n(n+1)(n+2)}3 .
\]

For \(n=225\),

\[
\sum_{k=1}^{225}k(k+1)=\frac{225\cdot226\cdot227}{3}=3\,847\,650 .
\]

The number of odd integers \(\le225\) is \((225+1)/2=113\).

Therefore  

\[
\sum_{k=1}^{225}k f(k)=3\,847\,650-113=3\,847\,537 .
\]

\[
\boxed{3847537}
\]

