            def havel_hakimi(N):
                # degree sequence as list of (deg, vertex)
                seq = [(i, i) for i in range(1, N)] + [(N-1, N)]
                # sort descending by degree
                seq.sort(reverse=True)
                adj = {v:set() for v in range(1,N+1)}
                while seq:
                    seq.sort(reverse=True)
                    d, v = seq.pop(0)
                    if d < 0:
                        raise ValueError("negative degree")
                    if d > len(seq):
                        raise ValueError("not graphical")
                    # connect v to first d vertices
                    for i in range(d):
                        d2, u = seq[i]
                        # add edge
                        adj[v].add(u)
                        adj[u].add(v)
                        seq[i] = (d2-1, u)
                    # after connections, v degree satisfied, continue
                return adj
            
