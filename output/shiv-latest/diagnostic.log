            def nullspace_gf2(matrix):
                # matrix: list of rows, each row is int mask of length bits
                rows = matrix[:]
                bits = max(row.bit_length() for row in rows) if rows else 0
                # Gaussian elimination to row-echelon form, also track pivots
                pivots = []
                row = 0
                for b in reversed(range(bits)):
                    # find a row with bit b set
                    i = None
                    for r in range(row, len(rows)):
                        if (rows[r] >> b) & 1:
                            i = r
                            break
                    if i is None:
                        continue
                    # swap to current row
                    rows[row], rows[i] = rows[i], rows[row]
                    pivots.append(b)
                    # eliminate bit b from other rows
                    for r in range(len(rows)):
                        if r != row and ((rows[r] >> b) & 1):
                            rows[r] ^= rows[row]
                    row += 1
                    if row == len(rows):
                        break
                rank = len(pivots)
                # Now find basis for nullspace: free variables are bits not in pivots
                free_bits = [b for b in range(bits) if b not in pivots]
                basis = []
                for free in free_bits:
                    # set this free bit to 1, others 0, solve for pivot bits
                    vec = 1 << free
                    # back substitution: for each pivot row, determine its bit
                    for i, b in enumerate(pivots):
                        # row i corresponds to pivot b
                        # compute dot of row i with vec (excluding pivot column)
                        # row i is rows[i] after elimination (in reduced row echelon? not fully reduced)
                        # Actually rows[i] now has pivot bit b set, and possibly other bits in free positions.
                        # To satisfy row equation, we need pivot bit = sum of other bits in row * vec (mod2)
                        # Since we want rows[i]·vec = 0, we set pivot bit accordingly.
                        # Compute sum of bits in row i (excluding pivot b) that are set in vec.
                        row_mask = rows[i]
                        # remove pivot bit
                        mask_without_pivot = row_mask ^ (1 << b)
                        # compute parity of intersection with vec
                        parity = bin(mask_without_pivot & vec).count('1') % 2
                        # we need pivot bit to make total parity 0, so set pivot bit = parity
                        if parity:
                            vec |= 1 << b
                    basis.append(vec)
                return basis, rank, pivots
            
            # Build matrix rows as int masks for each operation vector
            rows = ops
            basis_perp, rank, pivots = nullspace_gf2(rows)
            len(basis_perp), rank
            
