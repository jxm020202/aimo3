                    for c in range(1, n+1):
                        dominos.append(('V', r, c))
                num_vars = len(dominos)
                cell_to_dominos = {}
                for i, d in enumerate(dominos):
                    typ, r, c = d
                    cells = [(r,c), (r,c+1)] if typ=='H' else [(r,c), (r+1,c)]
                    for cell in cells:
                        cell_to_dominos.setdefault(cell, []).append(i)
                rows = []
                lbs = []
                ubs = []
