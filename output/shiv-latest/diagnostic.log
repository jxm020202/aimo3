                start = time.time()
                for it in range(total_iters):
                    # temperature schedule: linear decay from 1 to 0
                    T = max(0.0, 1.0 - it/total_iters)
                    i = random.randrange(N)
                    old = pts[i]
                    new = random_point_in_circle(radius)
