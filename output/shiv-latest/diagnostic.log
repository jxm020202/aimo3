                # Multiply by LCM of denominators
                dens = [sp.denom(c) for c in n]
                lcm = sp.ilcm(*dens) if dens else 1
                n_int = (n * lcm).applyfunc(sp.nsimplify)
                # Convert to tuple of ints
                n_int = tuple(int(c) for c in n_int)
                # Ensure sign normalization: first non-zero positive
                for comp in n_int:
