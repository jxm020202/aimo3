            import itertools
            
            def min_T_for_n(n):
                N = 2**n
                vertices = list(range(N))
                start = 0
                # adjacency: edges differ by power of 2 (i.e., single bit flip)
                edges = {}
                for v in vertices:
                    edges[v] = []
                    for k in range(n):
                        u = v ^ (1 << k)
                        edges[v].append((u, 1 << k))
                best_T = None
                best_path = None
                visited = [False]*N
                visited[start] = True
                path = [start]
                def dfs(current, T_sum):
                    nonlocal best_T, best_path
                    if len(path) == N:
                        # visited all vertices
                        if best_T is None or T_sum < best_T:
                            best_T = T_sum
                            best_path = path.copy()
                        return
                    # prune if current T already exceeds best_T
                    if best_T is not None and T_sum >= best_T:
                        return
                    for (nbr, length) in edges[current]:
                        if not visited[nbr]:
                            visited[nbr] = True
                            path.append(nbr)
                            dfs(nbr, T_sum + 1/length)
                            path.pop()
                            visited[nbr] = False
