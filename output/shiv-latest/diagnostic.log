            def max_edges_milp(n):
                caps = [i for i in range(1,n)] + [n-1]
                # map edge index
                edges = []
                for i in range(n):
                    for j in range(i+1,n):
                        edges.append((i,j))
                m = len(edges)
                # objective: maximize sum x
                c = np.ones(m)
                # constraints matrix A (n rows)
                data = []
                row_ind = []
                col_ind = []
                for i in range(n):
                    # for each edge, if i is endpoint, coefficient 1
                    for idx, (u,v) in enumerate(edges):
                        if u == i or v == i:
                            data.append(1)
                            row_ind.append(i)
                            col_ind.append(idx)
                A = sp.csr_matrix((data, (row_ind, col_ind)), shape=(n, m))
                ub = np.ones(m)
                lb = np.zeros(m)
                # integrality vector
                integrality = np.ones(m)
                bounds = opt.Bounds(lb, ub)
                constraints = opt.LinearConstraint(A, -np.inf, caps)  # upper bound caps
                res = opt.milp(c=c, constraints=constraints, integrality=integrality, bounds=bounds, options={'disp': False})
                if not res.success:
                    print("failed")
                return int(round(res.fun))  # objective is max sum, but milp returns min? Actually milp solves min c^T x; we need to set c = -1 to maximize
            
            
