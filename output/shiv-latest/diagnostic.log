            def plane_from_points(p1,p2,p3):
                # return normal vector and d such that normal·(x,y,z) + d = 0
                v1 = sp.Matrix(p2) - sp.Matrix(p1)
                v2 = sp.Matrix(p3) - sp.Matrix(p1)
                n = v1.cross(v2)
                # plane: n·(X - p1) = 0 => n·X + d = 0 where d = -n·p1
                d = - (n.dot(sp.Matrix(p1)))
                # simplify
                n = sp.simplify(n)
                d = sp.simplify(d)
                return n, d
            
