            def feasible_n(n, total=471, time_limit=10):
                # Build MILP
                N = n*n
                # objective zero
                c = np.zeros(N, dtype=float)
                # constraints list
                A = []
                lb = []
                ub = []
                # adjacency constraints
                def idx(i,j):
                    return i*n + j
                for i in range(n):
                    for j in range(n):
                        if i+1 < n:
                            # f(i,j) - f(i+1,j) <= 1
                            row = np.zeros(N)
                            row[idx(i,j)] = 1
                            row[idx(i+1,j)] = -1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                            # f(i+1,j) - f(i,j) <= 1
                            row = np.zeros(N)
                            row[idx(i+1,j)] = 1
                            row[idx(i,j)] = -1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                        if j+1 < n:
                            row = np.zeros(N)
                            row[idx(i,j)] = 1
                            row[idx(i,j+1)] = -1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                            row = np.zeros(N)
                            row[idx(i,j+1)] = 1
                            row[idx(i,j)] = -1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                # sum constraint: sum f = total
                row = np.ones(N)
                A.append(row)
                lb.append(total)
                ub.append(total)
                # Convert to arrays
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                # Bounds for variables: 0 <= f <= large (maybe total)
                var_bounds = Bounds(0, total)  # each variable cannot exceed total
                # Linear constraint
                lin_con = LinearConstraint(A, lb, ub)
                # Solve MILP
                try:
                    res = milp(c=c, constraints=lin_con, bounds=var_bounds, integrality=np.ones(N, dtype=int), options={"presolve": True, "time_limit": time_limit})
                except Exception as e:
                    print("Error", e)
                    return None
                return res.success
            
            for n in range(1,11):
                print(n, feasible_n(n))
            
