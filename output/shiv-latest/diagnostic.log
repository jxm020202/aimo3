            def is_pretty_possible(m,n,k):
                d = math.gcd(m,n)
                if k % d != 0:
                    return False
                k_prime = k // d
                m_prime = m // d
                if k_prime % m_prime != 0:
                    return False
                t = k_prime // m_prime
                n_prime = n // d
                if n_prime <= m_prime * (t - 1):
                    return False
                return True
            
