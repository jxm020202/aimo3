            def construct_seq_m(m):
                n=7926
                a=[0]*(n+2)
                # decreasing from 500 down to m
                a[1]=500
                idx=2
                for val in range(499, m-1, -1):  # from 499 down to m
                    a[idx]=val
                    idx+=1
                # now a[idx-1] = m
                # number of decreasing steps = (500 - m)
                d = 500 - m
                # remaining transitions = n - d
                r = n - d
                # we will stay at m for s steps, then increase by 1 each step to 500
                # increments needed from m to 500: (500 - m)
                inc_steps = 500 - m
                # s = r - inc_steps
                s = r - inc_steps
                # fill staying steps
                for _ in range(s):
                    a[idx]=m
                    idx+=1
                # increase by 1 each step
                for val in range(m+1, 501):
                    a[idx]=val
                    idx+=1
                # set a[n+1]=a[1]
                a[n+1]=a[1]
                # compute S
                S=sum(a[i+1]//a[i] for i in range(1,n+1))
