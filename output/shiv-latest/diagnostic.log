            Rb = sp.symbols('Rb', positive=True)
            y0 = sp.sqrt(Rb**2 - 25)
            r1 = sp.sqrt(5)
            r2 = 3*sp.sqrt(5)/2
            
            R_pt = sp.Point(-1, y0)
            O1 = sp.Point( (Rb - r1)/Rb * -5, (Rb - r1)/Rb * y0 )
            O2 = sp.Point( (Rb - r2)/Rb * 5, (Rb - r2)/Rb * y0 )
            v = sp.Matrix([O2.x - O1.x, O2.y - O1.y])
            # projection scalar t = ((R - O1)·v) / (v·v)
            t = ((R_pt.x - O1.x)*v[0] + (R_pt.y - O1.y)*v[1]) / (v[0]**2 + v[1]**2)
            M = sp.Point(O1.x + t*v[0], O1.y + t*v[1])
            S = sp.Point(2*M.x - R_pt.x, 2*M.y - R_pt.y)
            
            # compute d^2 = (cross)^2 / |RS|^2
            cross = R_pt.x*S.y - S.x*R_pt.y
            RS_sq = (S.x - R_pt.x)**2 + (S.y - R_pt.y)**2
            d_sq = sp.simplify(cross**2 / RS_sq)
            
            # Equation: d_sq = Rb**2 - 121/4
            eq = sp.simplify(d_sq - (Rb**2 - sp.Rational(121,4)))
