            import random, math, itertools
            
            def max_in_wedge(points, i, wedge_angle=100):
                # points: list of (x,y)
                ox, oy = points[i]
                angles = []
                for j, (x,y) in enumerate(points):
                    if j == i: continue
                    ang = math.atan2(y-oy, x-ox) # in radians
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate with +2π for circular wrap
                angles2 = angles + [a+2*math.pi for a in angles]
                maxcnt = 0
                # sliding window
                j=0
                n=len(angles)
                for i_start in range(n):
                    while j < i_start + n and angles2[j] - angles2[i_start] <= math.radians(wedge_angle)+1e-9:
                        j+=1
                    cnt = j - i_start
                    if cnt>maxcnt: maxcnt=cnt
                return maxcnt
            
            def total_max(points):
                return sum(max_in_wedge(points,i) for i in range(len(points)))
            
            def random_points_in_sector(n, angle_deg=100, R=1):
                angle_rad = math.radians(angle_deg)
                points=[]
                for _ in range(n):
                    # uniform in sector: choose radius sqrt(r) for uniform area
                    r = math.sqrt(random.random())*R
                    theta = random.random()*angle_rad
                    x = r*math.cos(theta)
                    y = r*math.sin(theta)
                    points.append((x,y))
                return points
            
