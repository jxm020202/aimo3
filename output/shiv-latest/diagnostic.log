                            return True
                    # right slide
                    c_right = max(c1,c2)
                    if c_right+1 < C:
                        if not occ[r][c_right+1]:
                            return True
                    # up slide
                    # need both cells above to be empty
                    if r-1 >= 0:
                        if not occ[r-1][c1] and not occ[r-1][c2]:
                            return True
                    # down slide
                    if r+1 < R:
                        if not occ[r+1][c1] and not occ[r+1][c2]:
                            return True
                else: # vertical
                    c = c1
                    r_top = min(r1,r2)
                    # up slide
                    if r_top-1 >= 0:
                        if not occ[r_top-1][c]:
