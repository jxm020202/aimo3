,{"stream_name":"stdout","time":19207.709443735,"data":"       |                             continue\n"}
,{"stream_name":"stdout","time":19207.709444824,"data":"       |                         if cell in clause:\n"}
,{"stream_name":"stdout","time":19207.709445928,"data":"       |                             new_satisfied.add(idx_c)\n"}
,{"stream_name":"stdout","time":19207.709447091,"data":"       |                 # recursion\n"}
,{"stream_name":"stdout","time":19207.709448181,"data":"       |                 if dfs(new_occupied, new_satisfied, placed+1):\n"}
