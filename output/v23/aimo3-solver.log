,{"stream_name":"stdout","time":19207.730748679,"data":"     [Output]:\n"}
,{"stream_name":"stdout","time":19207.730749735,"data":"       \u003e (1, [(0, 0), (1, 0)])\n"}
,{"stream_name":"stdout","time":19207.730750893,"data":"       \u003e \n"}
