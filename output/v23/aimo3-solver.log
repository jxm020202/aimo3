,{"stream_name":"stdout","time":18877.344733919,"data":"       | def max_min_adjacent_sum(m, n):\n"}
,{"stream_name":"stdout","time":18877.344735005,"data":"       |     N = m*n\n"}
,{"stream_name":"stdout","time":18877.344736069,"data":"       |     # create problem\n"}
,{"stream_name":"stdout","time":18877.344737139,"data":"       |     prob = pulp.LpProblem(\"max_min_adjacent_sum\", pulp.LpMaximize)\n"}
,{"stream_name":"stdout","time":18877.344738382,"data":"       |     # binary variables x[(i,j),k] 1 if cell (i,j) gets number k (1-indexed)\n"}
,{"stream_name":"stdout","time":18877.344739549,"data":"       |     x = {}\n"}
,{"stream_name":"stdout","time":18877.344740595,"data":"       |     for i in range(m):\n"}
,{"stream_name":"stdout","time":18877.344741682,"data":"       |         for j in range(n):\n"}
,{"stream_name":"stdout","time":18877.344744898,"data":"       |             for k in range(1, N+1):\n"}
,{"stream_name":"stdout","time":18877.34474603,"data":"       |                 x[(i,j,k)] = pulp.LpVariable(f\"x_{i}_{j}_{k}\", cat='Binary')\n"}
,{"stream_name":"stdout","time":18877.344747289,"data":"       |     # each cell gets exactly one number\n"}
,{"stream_name":"stdout","time":18877.344748399,"data":"       |     for i in range(m):\n"}
,{"stream_name":"stdout","time":18877.344749488,"data":"       |         for j in range(n):\n"}
,{"stream_name":"stdout","time":18877.344750592,"data":"       |             prob += pulp.lpSum(x[(i,j,k)] for k in range(1,N+1)) == 1\n"}
,{"stream_name":"stdout","time":18877.344751755,"data":"       |     # each number assigned to exactly one cell\n"}
,{"stream_name":"stdout","time":18877.344752888,"data":"       |     for k in range(1,N+1):\n"}
,{"stream_name":"stdout","time":18877.344753979,"data":"       |         prob += pulp.lpSum(x[(i,j,k)] for i in range(m) for j in range(n)) == 1\n"}
,{"stream_name":"stdout","time":18877.344755162,"data":"       |     # variable S\n"}
,{"stream_name":"stdout","time":18877.344756242,"data":"       |     S = pulp.LpVariable(\"S\", lowBound=0, cat='Integer')\n"}
,{"stream_name":"stdout","time":18877.344757468,"data":"       |     prob += S  # maximize S\n"}
