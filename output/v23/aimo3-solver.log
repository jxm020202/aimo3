,{"stream_name":"stdout","time":19207.721191495,"data":"       | def get_unsatisfied_requirements(selected):\n"}
,{"stream_name":"stdout","time":19207.721192573,"data":"       |     # selected: list of placement indices\n"}
,{"stream_name":"stdout","time":19207.721195013,"data":"       |     occupied = set()\n"}
,{"stream_name":"stdout","time":19207.721196113,"data":"       |     for idx in selected:\n"}
,{"stream_name":"stdout","time":19207.721197195,"data":"       |         occupied.update(placement_cells[idx])\n"}
,{"stream_name":"stdout","time":19207.721198303,"data":"       |     reqs = []  # list of sets of cells needed (size 1 or 2)\n"}
,{"stream_name":"stdout","time":19207.721199443,"data":"       |     for idx in selected:\n"}
,{"stream_name":"stdout","time":19207.721200536,"data":"       |         p = placement_cells[idx]\n"}
,{"stream_name":"stdout","time":19207.721201628,"data":"       |         for d in range(4):\n"}
,{"stream_name":"stdout","time":19207.721202699,"data":"       |             # check if slide possible (i.e., not blocked)\n"}
,{"stream_name":"stdout","time":19207.72120388,"data":"       |             # slide possible if all required cells inside board and empty (not occupied)\n"}
,{"stream_name":"stdout","time":19207.721205075,"data":"       |             cells_needed = required_cells_for_move(p, d)\n"}
,{"stream_name":"stdout","time":19207.721206243,"data":"       |             # if any required cell out of board -\u003e blocked\n"}
,{"stream_name":"stdout","time":19207.721207423,"data":"       |             out_of = any(not in_board(cell) for cell in cells_needed)\n"}
,{"stream_name":"stdout","time":19207.72120858,"data":"       |             if out_of:\n"}
,{"stream_name":"stdout","time":19207.721209679,"data":"       |                 continue  # blocked by edge\n"}
,{"stream_name":"stdout","time":19207.721210796,"data":"       |             # if any required cell occupied -\u003e blocked\n"}
,{"stream_name":"stdout","time":19207.721211936,"data":"       |             if any(cell in occupied for cell in cells_needed):\n"}
,{"stream_name":"stdout","time":19207.721213086,"data":"       |                 continue  # blocked by other domino\n"}
,{"stream_name":"stdout","time":19207.721214203,"data":"       |             # otherwise slide possible =\u003e unsatisfied requirement\n"}
,{"stream_name":"stdout","time":19207.721215429,"data":"       |             reqs.append(set(cells_needed))\n"}
,{"stream_name":"stdout","time":19207.721216529,"data":"       |     return reqs\n"}
