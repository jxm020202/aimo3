,{"stream_name":"stdout","time":19207.730733512,"data":"       |         # extend path by moving to adjacent cell not visited\n"}
,{"stream_name":"stdout","time":19207.73073465,"data":"       |         r,c=path[-1]\n"}
,{"stream_name":"stdout","time":19207.730735716,"data":"       |         for dr,dc in moves:\n"}
,{"stream_name":"stdout","time":19207.730736787,"data":"       |             nr,nc=r+dr,c+dc\n"}
,{"stream_name":"stdout","time":19207.730737867,"data":"       |             if 0\u003c=nr\u003cR and 0\u003c=nc\u003cC:\n"}
