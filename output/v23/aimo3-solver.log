,{"stream_name":"stdout","time":19207.709713721,"data":"       |         sys.setrecursionlimit(10000)\n"}
,{"stream_name":"stdout","time":19207.709715156,"data":"       |         def dfs(occupied, unsatisfied, placed):\n"}
,{"stream_name":"stdout","time":19207.709716284,"data":"       |             nonlocal visited, start_time\n"}
,{"stream_name":"stdout","time":19207.70971739,"data":"       |             visited += 1\n"}
,{"stream_name":"stdout","time":19207.709718459,"data":"       |             if time.time() - start_time \u003e limit_time:\n"}
,{"stream_name":"stdout","time":19207.709719623,"data":"       |                 raise TimeoutError\n"}
,{"stream_name":"stdout","time":19207.709720702,"data":"       |             if placed == target:\n"}
,{"stream_name":"stdout","time":19207.709721808,"data":"       |                 return not unsatisfied\n"}
,{"stream_name":"stdout","time":19207.70972291,"data":"       |             remaining = target - placed\n"}
,{"stream_name":"stdout","time":19207.709724022,"data":"       |             # simple prune: if number of unsatisfied requirements \u003e remaining * 2 (since each domino adds at most 2 cells)\n"}
,{"stream_name":"stdout","time":19207.709725304,"data":"       |             if len(unsatisfied) \u003e remaining * 2:\n"}
,{"stream_name":"stdout","time":19207.70972648,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":19207.709727841,"data":"       |             # select a requirement to satisfy: choose smallest size\n"}
,{"stream_name":"stdout","time":19207.709729033,"data":"       |             # unsatisfied is a set of frozensets\n"}
,{"stream_name":"stdout","time":19207.709730424,"data":"       |             # pick one with smallest len\n"}
,{"stream_name":"stdout","time":19207.709731534,"data":"       |             req = min(unsatisfied, key=lambda s: len(s))\n"}
