,{"stream_name":"stdout","time":18877.349309132,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.349310153,"data":"       | Let's compute for n=1 trivial (no adjacency). Not helpful.\n"}
,{"stream_name":"stdout","time":18877.34931129,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.349312323,"data":"       | Let's attempt to compute upper bound using degree-weighted sum for n=5 to see if n^2 -1 plausible.\n"}
,{"stream_name":"stdout","time":18877.34931354,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.349314583,"data":"       | Compute weighted sum bound.\n"}
,{"stream_name":"stdout","time":18877.349315668,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.349316693,"data":"       | assistantanalysis to=python codedef upper_bound_n(n):\n"}
,{"stream_name":"stdout","time":18877.34931784,"data":"       |     total=n*n\n"}
,{"stream_name":"stdout","time":18877.349318888,"data":"       |     corners=4\n"}
,{"stream_name":"stdout","time":18877.349319946,"data":"       |     edges= (n-2)*4 if n\u003e=2 else 0\n"}
,{"stream_name":"stdout","time":18877.349321053,"data":"       |     interior= total - corners - edges\n"}
,{"stream_name":"stdout","time":18877.349322158,"data":"       |     # assign largest numbers to interior, next to edges, smallest to corners\n"}
,{"stream_name":"stdout","time":18877.34932334,"data":"       |     # compute weighted sum max\n"}
,{"stream_name":"stdout","time":18877.349324439,"data":"       |     numbers = list(range(1,total+1))\n"}
,{"stream_name":"stdout","time":18877.34932553,"data":"       |     # assign largest interior numbers\n"}
,{"stream_name":"stdout","time":18877.349328063,"data":"       |     interior_nums = numbers[-interior:]\n"}
,{"stream_name":"stdout","time":18877.349329293,"data":"       |     edge_nums = numbers[-interior-edges:-interior] if edges\u003e0 else []\n"}
,{"stream_name":"stdout","time":18877.349330513,"data":"       |     corner_nums = numbers[:corners]\n"}
,{"stream_name":"stdout","time":18877.34933161,"data":"       |     weighted = 4*sum(interior_nums) + 3*sum(edge_nums) + 2*sum(corner_nums)\n"}
,{"stream_name":"stdout","time":18877.349332773,"data":"       |     E = n*(n-1)*2\n"}
,{"stream_name":"stdout","time":18877.34933388,"data":"       |     avg = weighted / E\n"}
,{"stream_name":"stdout","time":18877.349334948,"data":"       |     return avg\n"}
,{"stream_name":"stdout","time":18877.349336006,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.349337038,"data":"       | for n in range(2,7):\n"}
