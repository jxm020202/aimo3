,{"stream_name":"stdout","time":19207.716923662,"data":"       |     # Precompute for each cell the list of placement indices that cover it\n"}
,{"stream_name":"stdout","time":19207.716924838,"data":"       |     cell_to_pl = cell_to_placements\n"}
,{"stream_name":"stdout","time":19207.716925922,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.716926945,"data":"       |     # Helper to check if a cell is currently occupied\n"}
,{"stream_name":"stdout","time":19207.716928072,"data":"       |     def is_occupied(cell):\n"}
,{"stream_name":"stdout","time":19207.716929156,"data":"       |         return occupied[cell[0]][cell[1]]\n"}
,{"stream_name":"stdout","time":19207.716930262,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.716931282,"data":"       |     # For a given set of chosen placements, we can compute required cells that must be occupied:\n"}
,{"stream_name":"stdout","time":19207.716933759,"data":"       |     # For each chosen placement idx, for each end cell e not None, we need e occupied.\n"}
,{"stream_name":"stdout","time":19207.716934965,"data":"       |     # We'll enforce that eventually.\n"}
,{"stream_name":"stdout","time":19207.716936101,"data":"       |     # We'll maintain a set of required cells that must be occupied (including maybe already occupied).\n"}
,{"stream_name":"stdout","time":19207.716937486,"data":"       |     # But we can compute on the fly.\n"}
,{"stream_name":"stdout","time":19207.716938605,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.716939614,"data":"       |     # recursion\n"}
,{"stream_name":"stdout","time":19207.716940668,"data":"       |     def rec(start, placed, target):\n"}
,{"stream_name":"stdout","time":19207.716941759,"data":"       |         # prune by free cells bound\n"}
,{"stream_name":"stdout","time":19207.716942871,"data":"       |         free_cells = sum(not occupied[i][j] for i in range(R) for j in range(C))\n"}
,{"stream_name":"stdout","time":19207.716944042,"data":"       |         if placed + free_cells//2 \u003c target:\n"}
,{"stream_name":"stdout","time":19207.716945171,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":19207.716946271,"data":"       |         # Check feasibility of required cells for already placed dominos\n"}
,{"stream_name":"stdout","time":19207.716947441,"data":"       |         for idx in chosen:\n"}
,{"stream_name":"stdout","time":19207.716948662,"data":"       |             left_end, right_end = ends_list[idx]\n"}
,{"stream_name":"stdout","time":19207.716949768,"data":"       |             for end in (left_end, right_end):\n"}
,{"stream_name":"stdout","time":19207.716950864,"data":"       |                 if end is None:\n"}
,{"stream_name":"stdout","time":19207.716951951,"data":"       |                     continue\n"}
,{"stream_name":"stdout","time":19207.716953064,"data":"       |                 if not is_occupied(end):\n"}
,{"stream_name":"stdout","time":19207.716954182,"data":"       |                     # need at least one possible placement covering end that does not conflict with current occupancy\n"}
,{"stream_name":"stdout","time":19207.716955428,"data":"       |                     possible = False\n"}
,{"stream_name":"stdout","time":19207.716956509,"data":"       |                     for p_idx in cell_to_pl.get(end, []):\n"}
