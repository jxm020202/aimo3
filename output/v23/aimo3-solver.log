,{"stream_name":"stdout","time":18877.348839349,"data":"       | assistantanalysis to=python codeimport random, math, numpy as np, itertools, time, sys, collections, copy, math, sys, numpy as np\n"}
,{"stream_name":"stdout","time":18877.3488406,"data":"       | def min_adj(grid):\n"}
,{"stream_name":"stdout","time":18877.348841703,"data":"       |     n=grid.shape[0]\n"}
,{"stream_name":"stdout","time":18877.34884277,"data":"       |     mins=10**9\n"}
,{"stream_name":"stdout","time":18877.348843833,"data":"       |     for i in range(n):\n"}
,{"stream_name":"stdout","time":18877.348844889,"data":"       |         for j in range(n):\n"}
,{"stream_name":"stdout","time":18877.348845964,"data":"       |             if i+1\u003cn:\n"}
,{"stream_name":"stdout","time":18877.348847059,"data":"       |                 mins=min(mins, grid[i,j]+grid[i+1,j])\n"}
,{"stream_name":"stdout","time":18877.348848174,"data":"       |             if j+1\u003cn:\n"}
,{"stream_name":"stdout","time":18877.348849273,"data":"       |                 mins=min(mins, grid[i,j]+grid[i,j+1])\n"}
,{"stream_name":"stdout","time":18877.34885042,"data":"       |     return mins\n"}
,{"stream_name":"stdout","time":18877.348851493,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.34885252,"data":"       | def random_grid(n):\n"}
,{"stream_name":"stdout","time":18877.348855107,"data":"       |     arr = np.arange(1,n*n+1)\n"}
,{"stream_name":"stdout","time":18877.348856254,"data":"       |     np.random.shuffle(arr)\n"}
,{"stream_name":"stdout","time":18877.348857347,"data":"       |     return arr.reshape(n,n)\n"}
,{"stream_name":"stdout","time":18877.348858436,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.348859473,"data":"       | def simulated_anneal(n, target, max_iter=200000):\n"}
,{"stream_name":"stdout","time":18877.348860627,"data":"       |     grid = random_grid(n)\n"}
,{"stream_name":"stdout","time":18877.348861703,"data":"       |     current = min_adj(grid)\n"}
,{"stream_name":"stdout","time":18877.34886283,"data":"       |     best = current\n"}
,{"stream_name":"stdout","time":18877.348863893,"data":"       |     best_grid = grid.copy()\n"}
,{"stream_name":"stdout","time":18877.34886498,"data":"       |     T0=1.0\n"}
,{"stream_name":"stdout","time":18877.348866032,"data":"       |     for it in range(1, max_iter+1):\n"}
,{"stream_name":"stdout","time":18877.348867133,"data":"       |         # temperature schedule\n"}
,{"stream_name":"stdout","time":18877.34886824,"data":"       |         T = T0 * (1 - it/max_iter)\n"}
,{"stream_name":"stdout","time":18877.348869343,"data":"       |         # pick two cells to swap\n"}
,{"stream_name":"stdout","time":18877.348870433,"data":"       |         i1,j1,i2,j2 = np.random.randint(0,n,4)\n"}
,{"stream_name":"stdout","time":18877.34887155,"data":"       |         if i1==i2 and j1==j2:\n"}
,{"stream_name":"stdout","time":18877.348872633,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":18877.348873716,"data":"       |         # swap\n"}
,{"stream_name":"stdout","time":18877.348874797,"data":"       |         grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]\n"}
,{"stream_name":"stdout","time":18877.34887594,"data":"       |         new = min_adj(grid)\n"}
,{"stream_name":"stdout","time":18877.34887702,"data":"       |         # accept if better or with probability\n"}
,{"stream_name":"stdout","time":18877.348878163,"data":"       |         if new \u003e= current or random.random() \u003c math.exp((new-current)/ (T+1e-9)):\n"}
,{"stream_name":"stdout","time":18877.348879423,"data":"       |             current = new\n"}
,{"stream_name":"stdout","time":18877.348880526,"data":"       |             if new \u003e best:\n"}
,{"stream_name":"stdout","time":18877.348881639,"data":"       |                 best = new\n"}
,{"stream_name":"stdout","time":18877.348882983,"data":"       |                 best_grid = grid.copy()\n"}
,{"stream_name":"stdout","time":18877.348884073,"data":"       |                 if best \u003e= target:\n"}
,{"stream_name":"stdout","time":18877.34888522,"data":"       |                     return best, best_grid\n"}
,{"stream_name":"stdout","time":18877.348886353,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":18877.348887433,"data":"       |             # revert\n"}
,{"stream_name":"stdout","time":18877.348888509,"data":"       |             grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]\n"}
,{"stream_name":"stdout","time":18877.348889673,"data":"       |     return best, best_grid\n"}
