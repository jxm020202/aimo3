,{"stream_name":"stdout","time":19207.723494949,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.723495969,"data":"       | def cell_index(r,c):\n"}
,{"stream_name":"stdout","time":19207.723497029,"data":"       |     return r*C + c\n"}
,{"stream_name":"stdout","time":19207.723498076,"data":"       | \n"}
