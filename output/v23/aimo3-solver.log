,{"stream_name":"stdout","time":19207.718957001,"data":"       | def generate_placements(k):\n"}
,{"stream_name":"stdout","time":19207.718958092,"data":"       |     # returns list of placements, each as list of domino tuples ((r,c),(r2,c2))\n"}
,{"stream_name":"stdout","time":19207.718959275,"data":"       |     n=7\n"}
,{"stream_name":"stdout","time":19207.718960326,"data":"       |     board = [[0]*n for _ in range(n)]\n"}
,{"stream_name":"stdout","time":19207.718961423,"data":"       |     placements = []\n"}
,{"stream_name":"stdout","time":19207.718962486,"data":"       |     def backtrack(start_cell, placed):\n"}
,{"stream_name":"stdout","time":19207.7189636,"data":"       |         if len(placed)==k:\n"}
,{"stream_name":"stdout","time":19207.718964681,"data":"       |             placements.append([d for d in placed])\n"}
,{"stream_name":"stdout","time":19207.718965934,"data":"       |             return\n"}
,{"stream_name":"stdout","time":19207.718967039,"data":"       |         # find next empty cell index linear\n"}
,{"stream_name":"stdout","time":19207.718968156,"data":"       |         # start from start_cell index to avoid duplicates\n"}
,{"stream_name":"stdout","time":19207.718969325,"data":"       |         for idx in range(start_cell, n*n):\n"}
,{"stream_name":"stdout","time":19207.718970419,"data":"       |             r = idx//n\n"}
,{"stream_name":"stdout","time":19207.718971486,"data":"       |             c = idx%n\n"}
,{"stream_name":"stdout","time":19207.71897254,"data":"       |             if board[r][c]==0:\n"}
,{"stream_name":"stdout","time":19207.718973648,"data":"       |                 # try horizontal\n"}
,{"stream_name":"stdout","time":19207.71897476,"data":"       |                 if c+1\u003cn and board[r][c+1]==0:\n"}
,{"stream_name":"stdout","time":19207.718975907,"data":"       |                     # place\n"}
,{"stream_name":"stdout","time":19207.718977001,"data":"       |                     board[r][c]=board[r][c+1]=1\n"}
,{"stream_name":"stdout","time":19207.718978115,"data":"       |                     placed.append(((r,c),(r,c+1)))\n"}
,{"stream_name":"stdout","time":19207.718979243,"data":"       |                     backtrack(idx+1, placed)\n"}
,{"stream_name":"stdout","time":19207.718980371,"data":"       |                     placed.pop()\n"}
,{"stream_name":"stdout","time":19207.718981472,"data":"       |                     board[r][c]=board[r][c+1]=0\n"}
,{"stream_name":"stdout","time":19207.71898262,"data":"       |                 # try vertical\n"}
,{"stream_name":"stdout","time":19207.718983714,"data":"       |                 if r+1\u003cn and board[r+1][c]==0:\n"}
,{"stream_name":"stdout","time":19207.718986369,"data":"       |                     board[r][c]=board[r+1][c]=1\n"}
,{"stream_name":"stdout","time":19207.718987511,"data":"       |                     placed.append(((r,c),(r+1,c)))\n"}
,{"stream_name":"stdout","time":19207.718988653,"data":"       |                     backtrack(idx+1, placed)\n"}
,{"stream_name":"stdout","time":19207.718992335,"data":"       |                     placed.pop()\n"}
,{"stream_name":"stdout","time":19207.718993483,"data":"       |                     board[r][c]=board[r+1][c]=0\n"}
,{"stream_name":"stdout","time":19207.718994592,"data":"       |                 # after trying placements, also we could leave cell empty (skip)\n"}
,{"stream_name":"stdout","time":19207.718995796,"data":"       |                 # but we need to ensure we consider configurations where some cells stay empty.\n"}
,{"stream_name":"stdout","time":19207.718997004,"data":"       |                 # So we just continue without placing domino at this cell.\n"}
,{"stream_name":"stdout","time":19207.718998158,"data":"       |                 # However to avoid infinite loops, we must mark it as considered.\n"}
,{"stream_name":"stdout","time":19207.718999341,"data":"       |                 # We'll just continue loop; this effectively leaves cell empty.\n"}
,{"stream_name":"stdout","time":19207.719000529,"data":"       |                 # but we must also ensure we don't later try to place a domino covering this cell.\n"}
,{"stream_name":"stdout","time":19207.719001728,"data":"       |                 # Since we didn't mark it occupied, later recursion may consider it again.\n"}
,{"stream_name":"stdout","time":19207.719002908,"data":"       |                 # To avoid duplicates, we need to move start_cell forward.\n"}
,{"stream_name":"stdout","time":19207.719004088,"data":"       |                 # So we just continue loop without marking.\n"}
,{"stream_name":"stdout","time":19207.719006055,"data":"       |                 # That's fine because we will try other cells later.\n"}
,{"stream_name":"stdout","time":19207.719007403,"data":"       |                 # But we must ensure we don't later place a domino covering this cell after skipping.\n"}
,{"stream_name":"stdout","time":19207.719008625,"data":"       |                 # That's allowed because we may later decide to cover it with a domino starting from a later index (which could be this cell's neighbor).\n"}
,{"stream_name":"stdout","time":19207.719009968,"data":"       |                 # However if we skip this cell now, later we might place a domino covering it with neighbor that appears later in order (e.g., vertical from above cell that was earlier). That could cause duplicate configurations where same set of dominos generated in different orders.\n"}
,{"stream_name":"stdout","time":19207.719011463,"data":"       |                 # To avoid duplicates, we can enforce that we only place dominos where the first cell (r,c) is the smallest index among its two cells.\n"}
,{"stream_name":"stdout","time":19207.719012753,"data":"       |                 # That's already satisfied because we only try placements where (r,c) is the first empty cell we encounter.\n"}
,{"stream_name":"stdout","time":19207.719013985,"data":"       |                 # So it's okay.\n"}
,{"stream_name":"stdout","time":19207.71901507,"data":"       |                 # Continue loop.\n"}
,{"stream_name":"stdout","time":19207.719016204,"data":"       |                 pass\n"}
,{"stream_name":"stdout","time":19207.719017266,"data":"       |         # end for\n"}
,{"stream_name":"stdout","time":19207.719018329,"data":"       |     backtrack(0, [])\n"}
,{"stream_name":"stdout","time":19207.719019388,"data":"       |     return placements\n"}
,{"stream_name":"stdout","time":19207.719022091,"data":"       | \n"}
