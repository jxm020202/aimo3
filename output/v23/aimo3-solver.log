,{"stream_name":"stdout","time":18877.338893913,"data":"       |         i1,j1 = random.randrange(m), random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.338895066,"data":"       |         i2,j2 = random.randrange(m), random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.338896222,"data":"       |         if (i1,j1)==(i2,j2): continue\n"}
