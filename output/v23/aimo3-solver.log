,{"stream_name":"stdout","time":19207.718917005,"data":"       |     occupied = [[0]*n for _ in range(n)]\n"}
,{"stream_name":"stdout","time":19207.71891813,"data":"       |     for (a,b) in placement:\n"}
,{"stream_name":"stdout","time":19207.718919233,"data":"       |         (r1,c1)=a\n"}
,{"stream_name":"stdout","time":19207.718920295,"data":"       |         (r2,c2)=b\n"}
,{"stream_name":"stdout","time":19207.718921358,"data":"       |         occupied[r1][c1]=1\n"}
,{"stream_name":"stdout","time":19207.718922433,"data":"       |         occupied[r2][c2]=1\n"}
,{"stream_name":"stdout","time":19207.718923518,"data":"       |     # check each domino\n"}
,{"stream_name":"stdout","time":19207.718924578,"data":"       |     for (a,b) in placement:\n"}
,{"stream_name":"stdout","time":19207.718925651,"data":"       |         (r1,c1)=a\n"}
,{"stream_name":"stdout","time":19207.718926746,"data":"       |         (r2,c2)=b\n"}
,{"stream_name":"stdout","time":19207.718927829,"data":"       |         if r1==r2: # horizontal\n"}
,{"stream_name":"stdout","time":19207.718928962,"data":"       |             left_c = min(c1,c2)-1\n"}
,{"stream_name":"stdout","time":19207.718930059,"data":"       |             right_c = max(c1,c2)+1\n"}
,{"stream_name":"stdout","time":19207.718931147,"data":"       |             # left neighbor\n"}
,{"stream_name":"stdout","time":19207.718932228,"data":"       |             left_block = (left_c\u003c0) or occupied[r1][left_c]==1\n"}
,{"stream_name":"stdout","time":19207.718933418,"data":"       |             right_block = (right_c\u003e=n) or occupied[r1][right_c]==1\n"}
,{"stream_name":"stdout","time":19207.718934629,"data":"       |             if not (left_block and right_block):\n"}
,{"stream_name":"stdout","time":19207.718935748,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":19207.718936843,"data":"       |         else: # vertical\n"}
,{"stream_name":"stdout","time":19207.718937916,"data":"       |             top_r = min(r1,r2)-1\n"}
,{"stream_name":"stdout","time":19207.71893901,"data":"       |             bottom_r = max(r1,r2)+1\n"}
,{"stream_name":"stdout","time":19207.718940097,"data":"       |             top_block = (top_r\u003c0) or occupied[top_r][c1]==1\n"}
,{"stream_name":"stdout","time":19207.718941297,"data":"       |             bottom_block = (bottom_r\u003e=n) or occupied[bottom_r][c1]==1\n"}
,{"stream_name":"stdout","time":19207.718944075,"data":"       |             if not (top_block and bottom_block):\n"}
,{"stream_name":"stdout","time":19207.718945218,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":19207.718946316,"data":"       |     return True\n"}
,{"stream_name":"stdout","time":19207.718947411,"data":"       | \n"}
