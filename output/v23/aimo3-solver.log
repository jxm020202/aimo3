,{"stream_name":"stdout","time":19207.725400987,"data":"       |         if c-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.725402077,"data":"       |             req['L'] = {idx(r,c-1), idx(r+1,c-1)}\n"}
,{"stream_name":"stdout","time":19207.72540318,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.725404227,"data":"       |             req['L'] = None\n"}
,{"stream_name":"stdout","time":19207.725405287,"data":"       |         if c+1 \u003c C:\n"}
