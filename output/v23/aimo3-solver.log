,{"stream_name":"stdout","time":19207.713368545,"data":"       | analysisNow implement backtracking search for minimal D.\n"}
,{"stream_name":"stdout","time":19207.713369665,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713370677,"data":"       | We'll sort dominos maybe.\n"}
,{"stream_name":"stdout","time":19207.713371757,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713372765,"data":"       | We'll need adjacency for matching later.\n"}
,{"stream_name":"stdout","time":19207.713373854,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713374879,"data":"       | Implement function to compute max matching for bipartite graph of free cells.\n"}
,{"stream_name":"stdout","time":19207.713376067,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.71337708,"data":"       | The grid is bipartite by parity (r+c) even/odd.\n"}
,{"stream_name":"stdout","time":19207.71337819,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713379443,"data":"       | We can create adjacency list from each even cell to neighboring odd cells (up/down/left/right) that are also free.\n"}
,{"stream_name":"stdout","time":19207.713380707,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713381721,"data":"       | Implement Hopcroft-Karp.\n"}
,{"stream_name":"stdout","time":19207.713382815,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.71338528,"data":"       | assistantanalysis to=python codedef hopcroft_karp(adj, left_nodes, right_nodes):\n"}
,{"stream_name":"stdout","time":19207.713386472,"data":"       |     # adj: dict left_node -\u003e set of right nodes\n"}
,{"stream_name":"stdout","time":19207.713387663,"data":"       |     INF = 10**9\n"}
,{"stream_name":"stdout","time":19207.713388742,"data":"       |     pair_u = {u: None for u in left_nodes}\n"}
,{"stream_name":"stdout","time":19207.713389852,"data":"       |     pair_v = {v: None for v in right_nodes}\n"}
,{"stream_name":"stdout","time":19207.713390969,"data":"       |     dist = {}\n"}
,{"stream_name":"stdout","time":19207.713392021,"data":"       |     def bfs():\n"}
,{"stream_name":"stdout","time":19207.713393112,"data":"       |         queue = deque()\n"}
,{"stream_name":"stdout","time":19207.713394172,"data":"       |         for u in left_nodes:\n"}
,{"stream_name":"stdout","time":19207.71339525,"data":"       |             if pair_u[u] is None:\n"}
,{"stream_name":"stdout","time":19207.713396325,"data":"       |                 dist[u] = 0\n"}
,{"stream_name":"stdout","time":19207.713397395,"data":"       |                 queue.append(u)\n"}
,{"stream_name":"stdout","time":19207.71339849,"data":"       |             else:\n"}
,{"stream_name":"stdout","time":19207.71339956,"data":"       |                 dist[u] = INF\n"}
,{"stream_name":"stdout","time":19207.713400635,"data":"       |         dist[None] = INF\n"}
,{"stream_name":"stdout","time":19207.713401728,"data":"       |         while queue:\n"}
,{"stream_name":"stdout","time":19207.713402791,"data":"       |             u = queue.popleft()\n"}
,{"stream_name":"stdout","time":19207.713403899,"data":"       |             if dist[u] \u003c dist[None]:\n"}
,{"stream_name":"stdout","time":19207.713405043,"data":"       |                 for v in adj.get(u, []):\n"}
,{"stream_name":"stdout","time":19207.713406145,"data":"       |                     if pair_v[v] is None:\n"}
,{"stream_name":"stdout","time":19207.713407235,"data":"       |                         if dist[None] == INF:\n"}
,{"stream_name":"stdout","time":19207.713408348,"data":"       |                             dist[None] = dist[u] + 1\n"}
,{"stream_name":"stdout","time":19207.713409489,"data":"       |                     else:\n"}
,{"stream_name":"stdout","time":19207.713410565,"data":"       |                         if dist[pair_v[v]] == INF:\n"}
,{"stream_name":"stdout","time":19207.713411706,"data":"       |                             dist[pair_v[v]] = dist[u] + 1\n"}
,{"stream_name":"stdout","time":19207.713412836,"data":"       |                             queue.append(pair_v[v])\n"}
,{"stream_name":"stdout","time":19207.713413958,"data":"       |         return dist[None] != INF\n"}
,{"stream_name":"stdout","time":19207.713415041,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713416072,"data":"       |     def dfs(u):\n"}
,{"stream_name":"stdout","time":19207.713417136,"data":"       |         if u is not None:\n"}
,{"stream_name":"stdout","time":19207.713418221,"data":"       |             for v in adj.get(u, []):\n"}
,{"stream_name":"stdout","time":19207.713419347,"data":"       |                 if pair_v[v] is None or (dist[pair_v[v]] == dist[u] + 1 and dfs(pair_v[v])):\n"}
,{"stream_name":"stdout","time":19207.713420536,"data":"       |                     pair_u[u] = v\n"}
,{"stream_name":"stdout","time":19207.713421617,"data":"       |                     pair_v[v] = u\n"}
,{"stream_name":"stdout","time":19207.713422696,"data":"       |                     return True\n"}
,{"stream_name":"stdout","time":19207.713423792,"data":"       |             dist[u] = INF\n"}
,{"stream_name":"stdout","time":19207.713426447,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":19207.71342755,"data":"       |         return True\n"}
,{"stream_name":"stdout","time":19207.713428614,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713429625,"data":"       |     matching = 0\n"}
,{"stream_name":"stdout","time":19207.713430685,"data":"       |     while bfs():\n"}
,{"stream_name":"stdout","time":19207.713431759,"data":"       |         for u in left_nodes:\n"}
,{"stream_name":"stdout","time":19207.713432857,"data":"       |             if pair_u[u] is None:\n"}
,{"stream_name":"stdout","time":19207.713433939,"data":"       |                 if dfs(u):\n"}
,{"stream_name":"stdout","time":19207.713434999,"data":"       |                     matching += 1\n"}
,{"stream_name":"stdout","time":19207.713436284,"data":"       |     return matching, pair_u, pair_v\n"}
,{"stream_name":"stdout","time":19207.713437399,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713438412,"data":"       | def max_matching_free_cells(free_cells):\n"}
,{"stream_name":"stdout","time":19207.7134395,"data":"       |     # free_cells: set of cell indices\n"}
,{"stream_name":"stdout","time":19207.713440599,"data":"       |     left_nodes = [i for i in free_cells if (rc(i)[0] + rc(i)[1]) % 2 == 0]\n"}
,{"stream_name":"stdout","time":19207.713441759,"data":"       |     right_nodes = [i for i in free_cells if (rc(i)[0] + rc(i)[1]) % 2 == 1]\n"}
,{"stream_name":"stdout","time":19207.713442944,"data":"       |     adj = defaultdict(set)\n"}
,{"stream_name":"stdout","time":19207.713444013,"data":"       |     for u in left_nodes:\n"}
,{"stream_name":"stdout","time":19207.713445091,"data":"       |         r,c = rc(u)\n"}
,{"stream_name":"stdout","time":19207.71344616,"data":"       |         for dr,dc in [(1,0),(-1,0),(0,1),(0,-1)]:\n"}
,{"stream_name":"stdout","time":19207.713447288,"data":"       |             nr, nc = r+dr, c+dc\n"}
,{"stream_name":"stdout","time":19207.713448364,"data":"       |             if 0 \u003c= nr \u003c R and 0 \u003c= nc \u003c C:\n"}
,{"stream_name":"stdout","time":19207.713449661,"data":"       |                 v = idx(nr,nc)\n"}
,{"stream_name":"stdout","time":19207.713450749,"data":"       |                 if v in free_cells:\n"}
,{"stream_name":"stdout","time":19207.713451842,"data":"       |                     adj[u].add(v)\n"}
,{"stream_name":"stdout","time":19207.713452939,"data":"       |     matching,_,_ = hopcroft_karp(adj, left_nodes, right_nodes)\n"}
,{"stream_name":"stdout","time":19207.713454105,"data":"       |     return matching\n"}
,{"stream_name":"stdout","time":19207.713455185,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.713456198,"data":"       | # test\n"}
,{"stream_name":"stdout","time":19207.713457242,"data":"       | free = set(range(N))\n"}
