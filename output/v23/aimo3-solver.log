,{"stream_name":"stdout","time":19207.709741817,"data":"       |                     # place domino\n"}
,{"stream_name":"stdout","time":19207.7097429,"data":"       |                     new_occupied = occupied | {c1,c2}\n"}
,{"stream_name":"stdout","time":19207.709744206,"data":"       |                     # update unsatisfied: remove any requirement intersecting new_occupied\n"}
,{"stream_name":"stdout","time":19207.709745414,"data":"       |                     new_unsatisfied = set()\n"}
