,{"stream_name":"stdout","time":19207.711545724,"data":"       | def dfs(O_mask, unsatisfied, placed):\n"}
,{"stream_name":"stdout","time":19207.711546846,"data":"       |     global best, best_solution\n"}
,{"stream_name":"stdout","time":19207.711547925,"data":"       |     # prune\n"}
,{"stream_name":"stdout","time":19207.711548973,"data":"       |     if placed \u003e= best:\n"}
,{"stream_name":"stdout","time":19207.711550068,"data":"       |         return\n"}
,{"stream_name":"stdout","time":19207.711551123,"data":"       |     if not unsatisfied:\n"}
,{"stream_name":"stdout","time":19207.711552221,"data":"       |         # all satisfied\n"}
