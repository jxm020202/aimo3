,{"stream_name":"stdout","time":19207.72257646,"data":"       |         if dir_idx == 3:  # right\n"}
,{"stream_name":"stdout","time":19207.722577541,"data":"       |             rightc = max(c1,c2)\n"}
,{"stream_name":"stdout","time":19207.722578634,"data":"       |             return [(r1, rightc+1)]\n"}
,{"stream_name":"stdout","time":19207.72257972,"data":"       |         if dir_idx == 0:  # up\n"}
,{"stream_name":"stdout","time":19207.722580791,"data":"       |             return [(r1-1,c1),(r2-1,c2)]\n"}
,{"stream_name":"stdout","time":19207.722581907,"data":"       |         if dir_idx == 1:  # down\n"}
,{"stream_name":"stdout","time":19207.722582997,"data":"       |             return [(r1+1,c1),(r2+1,c2)]\n"}
,{"stream_name":"stdout","time":19207.722584091,"data":"       |     else:  # vertical\n"}
