,{"stream_name":"stdout","time":18877.343905718,"data":"       | def min_edge_sum_grid(grid):\n"}
,{"stream_name":"stdout","time":18877.3439068,"data":"       |     m=len(grid); n=len(grid[0])\n"}
,{"stream_name":"stdout","time":18877.343907892,"data":"       |     mn=10**9\n"}
,{"stream_name":"stdout","time":18877.343908949,"data":"       |     for i in range(m):\n"}
,{"stream_name":"stdout","time":18877.343910001,"data":"       |         for j in range(n):\n"}
,{"stream_name":"stdout","time":18877.343911113,"data":"       |             if i+1\u003cm:\n"}
,{"stream_name":"stdout","time":18877.343912219,"data":"       |                 s=grid[i][j]+grid[i+1][j]\n"}
,{"stream_name":"stdout","time":18877.343913318,"data":"       |                 if s\u003cmn: mn=s\n"}
,{"stream_name":"stdout","time":18877.343914458,"data":"       |             if j+1\u003cn:\n"}
,{"stream_name":"stdout","time":18877.343915549,"data":"       |                 s=grid[i][j]+grid[i][j+1]\n"}
,{"stream_name":"stdout","time":18877.343916649,"data":"       |                 if s\u003cmn: mn=s\n"}
,{"stream_name":"stdout","time":18877.343917779,"data":"       |     return mn\n"}
,{"stream_name":"stdout","time":18877.343918838,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.343919869,"data":"       | def simulated_anneal(m,n,target,iterations=200000):\n"}
,{"stream_name":"stdout","time":18877.343920994,"data":"       |     N=m*n\n"}
,{"stream_name":"stdout","time":18877.343922047,"data":"       |     perm=list(range(1,N+1))\n"}
,{"stream_name":"stdout","time":18877.343923144,"data":"       |     random.shuffle(perm)\n"}
,{"stream_name":"stdout","time":18877.343924222,"data":"       |     grid=[perm[i*n:(i+1)*n] for i in range(m)]\n"}
,{"stream_name":"stdout","time":18877.343925337,"data":"       |     best=min_edge_sum_grid(grid)\n"}
,{"stream_name":"stdout","time":18877.343926418,"data":"       |     best_grid=[row[:] for row in grid]\n"}
,{"stream_name":"stdout","time":18877.343927506,"data":"       |     temp=10.0\n"}
,{"stream_name":"stdout","time":18877.343928581,"data":"       |     for it in range(iterations):\n"}
,{"stream_name":"stdout","time":18877.343929711,"data":"       |         # pick two cells to swap\n"}
,{"stream_name":"stdout","time":18877.343930819,"data":"       |         i1,j1=random.randrange(m),random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.343931957,"data":"       |         i2,j2=random.randrange(m),random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.343933074,"data":"       |         if i1==i2 and j1==j2: continue\n"}
,{"stream_name":"stdout","time":18877.343934184,"data":"       |         # swap\n"}
,{"stream_name":"stdout","time":18877.343936667,"data":"       |         grid[i1][j1],grid[i2][j2]=grid[i2][j2],grid[i1][j1]\n"}
,{"stream_name":"stdout","time":18877.343937856,"data":"       |         cur=min_edge_sum_grid(grid)\n"}
,{"stream_name":"stdout","time":18877.343938977,"data":"       |         if cur\u003ebest:\n"}
,{"stream_name":"stdout","time":18877.343940066,"data":"       |             best=cur\n"}
,{"stream_name":"stdout","time":18877.343941132,"data":"       |             best_grid=[row[:] for row in grid]\n"}
,{"stream_name":"stdout","time":18877.343942246,"data":"       |             if best\u003e=target:\n"}
,{"stream_name":"stdout","time":18877.343943579,"data":"       |                 return best, best_grid\n"}
,{"stream_name":"stdout","time":18877.343944682,"data":"       |         # accept if not worse with probability\n"}
,{"stream_name":"stdout","time":18877.343945792,"data":"       |         if cur \u003e= best:\n"}
,{"stream_name":"stdout","time":18877.343946901,"data":"       |             accept=True\n"}
,{"stream_name":"stdout","time":18877.343948001,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":18877.343949105,"data":"       |             # probability\n"}
,{"stream_name":"stdout","time":18877.343950179,"data":"       |             prob=math.exp((cur-best)/temp)\n"}
,{"stream_name":"stdout","time":18877.343951309,"data":"       |             accept=random.random()\u003cprob\n"}
,{"stream_name":"stdout","time":18877.343952452,"data":"       |         if not accept:\n"}
,{"stream_name":"stdout","time":18877.343953511,"data":"       |             # revert swap\n"}
,{"stream_name":"stdout","time":18877.343954604,"data":"       |             grid[i1][j1],grid[i2][j2]=grid[i2][j2],grid[i1][j1]\n"}
,{"stream_name":"stdout","time":18877.343955742,"data":"       |         # cooling\n"}
,{"stream_name":"stdout","time":18877.343956812,"data":"       |         if it%1000==0 and it\u003e0:\n"}
,{"stream_name":"stdout","time":18877.343957926,"data":"       |             temp*=0.99\n"}
,{"stream_name":"stdout","time":18877.343958986,"data":"       |     return best, best_grid\n"}
,{"stream_name":"stdout","time":18877.343960052,"data":"       | \n"}
