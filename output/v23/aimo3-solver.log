,{"stream_name":"stdout","time":19207.728685138,"data":"       |     else:  # vertical\n"}
,{"stream_name":"stdout","time":19207.728686208,"data":"       |         # up neighbor of top cell (r1,c1-1?) Wait orientation vertical: top cell (r1,c1) and bottom (r2,c2)\n"}
,{"stream_name":"stdout","time":19207.728687418,"data":"       |         # Assume r1 \u003c r2 (top)\n"}
