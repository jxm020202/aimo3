,{"stream_name":"stdout","time":19207.731013125,"data":"       | def search(m, placed_indices=(), occupied_mask=0, required_set=frozenset()):\n"}
,{"stream_name":"stdout","time":19207.731014282,"data":"       |     # placed_indices tuple of domino indices\n"}
,{"stream_name":"stdout","time":19207.731015366,"data":"       |     placed_count = len(placed_indices)\n"}
,{"stream_name":"stdout","time":19207.731016449,"data":"       |     if placed_count == m:\n"}
,{"stream_name":"stdout","time":19207.731017526,"data":"       |         # check if all requirements satisfied\n"}
,{"stream_name":"stdout","time":19207.731018643,"data":"       |         if not required_set:\n"}
,{"stream_name":"stdout","time":19207.731019721,"data":"       |             return placed_indices\n"}
,{"stream_name":"stdout","time":19207.731020836,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.731021899,"data":"       |             return None\n"}
,{"stream_name":"stdout","time":19207.731022959,"data":"       |     # Prune: remaining dominos = m - placed_count\n"}
,{"stream_name":"stdout","time":19207.731024088,"data":"       |     remaining = m - placed_count\n"}
,{"stream_name":"stdout","time":19207.731025163,"data":"       |     # number of cells we can still occupy = 2*remaining\n"}
,{"stream_name":"stdout","time":19207.731026295,"data":"       |     # required cells must be subset of cells we can still occupy (i.e., not already occupied)\n"}
,{"stream_name":"stdout","time":19207.731027533,"data":"       |     # If size of required_set \u003e 2*remaining, impossible\n"}
,{"stream_name":"stdout","time":19207.731028696,"data":"       |     if len(required_set) \u003e 2*remaining:\n"}
,{"stream_name":"stdout","time":19207.731029846,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":19207.731030914,"data":"       |     # Choose next domino to place.\n"}
,{"stream_name":"stdout","time":19207.731032001,"data":"       |     # Heuristic: try to satisfy a required cell if any.\n"}
,{"stream_name":"stdout","time":19207.731033149,"data":"       |     # If required_set nonempty, we should place a domino covering at least one required cell.\n"}
,{"stream_name":"stdout","time":19207.731034347,"data":"       |     # So we can iterate over dominos that cover any required cell.\n"}
,{"stream_name":"stdout","time":19207.73103719,"data":"       |     # else we can try any domino.\n"}
,{"stream_name":"stdout","time":19207.731038356,"data":"       |     # Also ensure no overlap.\n"}
,{"stream_name":"stdout","time":19207.731039447,"data":"       |     # We'll generate candidate indices.\n"}
,{"stream_name":"stdout","time":19207.731040556,"data":"       |     candidates = []\n"}
,{"stream_name":"stdout","time":19207.731041619,"data":"       |     if required_set:\n"}
,{"stream_name":"stdout","time":19207.731042694,"data":"       |         # required cells indices set\n"}
,{"stream_name":"stdout","time":19207.731043809,"data":"       |         req_cells = set(required_set)\n"}
,{"stream_name":"stdout","time":19207.731044911,"data":"       |         for i,d in enumerate(dominos):\n"}
,{"stream_name":"stdout","time":19207.731046029,"data":"       |             if d['mask'] \u0026 occupied_mask:\n"}
,{"stream_name":"stdout","time":19207.731047197,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.73104828,"data":"       |             # check if domino covers any required cell\n"}
,{"stream_name":"stdout","time":19207.731049435,"data":"       |             if any(cell in req_cells for cell in d['cells']):\n"}
,{"stream_name":"stdout","time":19207.731050584,"data":"       |                 candidates.append(i)\n"}
,{"stream_name":"stdout","time":19207.731051886,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":19207.731052939,"data":"       |         # any domino not overlapping\n"}
,{"stream_name":"stdout","time":19207.731054045,"data":"       |         for i,d in enumerate(dominos):\n"}
,{"stream_name":"stdout","time":19207.73105516,"data":"       |             if d['mask'] \u0026 occupied_mask:\n"}
,{"stream_name":"stdout","time":19207.731056321,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.731057416,"data":"       |             candidates.append(i)\n"}
,{"stream_name":"stdout","time":19207.731058502,"data":"       |     # Optionally order candidates to try those with more neighbor satisfaction? We'll just iterate.\n"}
,{"stream_name":"stdout","time":19207.731059702,"data":"       |     for i in candidates:\n"}
