,{"stream_name":"stdout","time":19207.725878932,"data":"       |             # up adjacent\n"}
,{"stream_name":"stdout","time":19207.725880006,"data":"       |             if r_top \u003e 0:\n"}
,{"stream_name":"stdout","time":19207.725881133,"data":"       |                 up_adj = (r_top-1)*7 + c\n"}
,{"stream_name":"stdout","time":19207.725882237,"data":"       |                 if up_adj not in occupied:\n"}
