,{"stream_name":"stdout","time":19207.723528894,"data":"       |         # Similarly sliding right needs cell (r,c+2) empty.\n"}
,{"stream_name":"stdout","time":19207.723530039,"data":"       |         # So direction pairs for horizontal domino are single cells, not pairs.\n"}
,{"stream_name":"stdout","time":19207.723531216,"data":"       |         # However earlier we used pairs for vertical sliding up/down requiring both cells above. That's because vertical domino sliding up requires both cells above.\n"}
,{"stream_name":"stdout","time":19207.723532552,"data":"       |         # So we need to treat direction requirement differently for each orientation.\n"}
