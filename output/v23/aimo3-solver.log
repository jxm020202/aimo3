,{"stream_name":"stdout","time":18877.346658432,"data":"       |         val_i=cells[i]; val_j=cells[j]\n"}
,{"stream_name":"stdout","time":18877.346659536,"data":"       |         # compute new min efficiently? just recompute\n"}
