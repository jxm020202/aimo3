,{"stream_name":"stdout","time":19207.719560894,"data":"       | analysisNow implement recursive search for matchings of size k.\n"}
,{"stream_name":"stdout","time":19207.719562069,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.719563115,"data":"       | We'll need to maintain occupied set (cells used by dominos). When we have a matching of size k, we can compute occupied cells set, then check condition using support cells.\n"}
,{"stream_name":"stdout","time":19207.719564491,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.719565528,"data":"       | Let's implement search for increasing k.\n"}
,{"stream_name":"stdout","time":19207.719566623,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.719567643,"data":"       | assistantanalysis to=python codedef is_matching_valid(matching):\n"}
,{"stream_name":"stdout","time":19207.719568796,"data":"       |     occupied = set()\n"}
,{"stream_name":"stdout","time":19207.719569875,"data":"       |     for (i,j) in matching:\n"}
,{"stream_name":"stdout","time":19207.719570948,"data":"       |         occupied.add(i)\n"}
,{"stream_name":"stdout","time":19207.71957199,"data":"       |         occupied.add(j)\n"}
,{"stream_name":"stdout","time":19207.719573038,"data":"       |     # check each domino's support cells\n"}
,{"stream_name":"stdout","time":19207.719574135,"data":"       |     for (i,j) in matching:\n"}
,{"stream_name":"stdout","time":19207.719575216,"data":"       |         left, right = domino_support[(i,j)]\n"}
,{"stream_name":"stdout","time":19207.719576305,"data":"       |         # left support\n"}
,{"stream_name":"stdout","time":19207.719577396,"data":"       |         left_ok = (left is None) or (left in occupied)\n"}
,{"stream_name":"stdout","time":19207.719578505,"data":"       |         right_ok = (right is None) or (right in occupied)\n"}
,{"stream_name":"stdout","time":19207.719579633,"data":"       |         if not (left_ok and right_ok):\n"}
,{"stream_name":"stdout","time":19207.719580723,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":19207.71958179,"data":"       |     return True\n"}
,{"stream_name":"stdout","time":19207.719582835,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.719583832,"data":"       | def find_min_matching(max_k=10):\n"}
,{"stream_name":"stdout","time":19207.719584901,"data":"       |     all_vertices = set(range(n*n))\n"}
,{"stream_name":"stdout","time":19207.719586028,"data":"       |     # recursion\n"}
,{"stream_name":"stdout","time":19207.719587066,"data":"       |     def recurse(free_vertices, edges, target_k):\n"}
,{"stream_name":"stdout","time":19207.719588159,"data":"       |         # edges list of domino tuples\n"}
,{"stream_name":"stdout","time":19207.719589257,"data":"       |         if len(edges) == target_k:\n"}
,{"stream_name":"stdout","time":19207.719590325,"data":"       |             if is_matching_valid(edges):\n"}
,{"stream_name":"stdout","time":19207.719591416,"data":"       |                 return edges\n"}
,{"stream_name":"stdout","time":19207.719592494,"data":"       |             else:\n"}
,{"stream_name":"stdout","time":19207.719595017,"data":"       |                 return None\n"}
,{"stream_name":"stdout","time":19207.719596148,"data":"       |         if not free_vertices:\n"}
,{"stream_name":"stdout","time":19207.71959723,"data":"       |             return None\n"}
,{"stream_name":"stdout","time":19207.719598282,"data":"       |         # pruning: if not enough vertices left to reach target_k\n"}
,{"stream_name":"stdout","time":19207.719599421,"data":"       |         # each edge consumes 2 vertices\n"}
,{"stream_name":"stdout","time":19207.719600536,"data":"       |         remaining = len(free_vertices)\n"}
,{"stream_name":"stdout","time":19207.719601811,"data":"       |         needed = target_k - len(edges)\n"}
,{"stream_name":"stdout","time":19207.719602911,"data":"       |         if remaining \u003c needed*2:\n"}
,{"stream_name":"stdout","time":19207.719604045,"data":"       |             return None\n"}
,{"stream_name":"stdout","time":19207.719605115,"data":"       |         # pick smallest vertex\n"}
,{"stream_name":"stdout","time":19207.7196062,"data":"       |         v = min(free_vertices)\n"}
,{"stream_name":"stdout","time":19207.719607281,"data":"       |         # option 1: leave v unmatched\n"}
,{"stream_name":"stdout","time":19207.719608391,"data":"       |         new_free = free_vertices - {v}\n"}
,{"stream_name":"stdout","time":19207.719609501,"data":"       |         sol = recurse(new_free, edges, target_k)\n"}
,{"stream_name":"stdout","time":19207.719610619,"data":"       |         if sol:\n"}
,{"stream_name":"stdout","time":19207.719611684,"data":"       |             return sol\n"}
,{"stream_name":"stdout","time":19207.719612764,"data":"       |         # option 2: match v with a neighbor u in free_vertices\n"}
,{"stream_name":"stdout","time":19207.719614826,"data":"       |         for u in neighbors[v]:\n"}
,{"stream_name":"stdout","time":19207.719615926,"data":"       |             if u in free_vertices:\n"}
,{"stream_name":"stdout","time":19207.71961701,"data":"       |                 # add edge (v,u) with ordering v\u003cu\n"}
,{"stream_name":"stdout","time":19207.719618182,"data":"       |                 edge = (v,u) if v\u003cu else (u,v)\n"}
,{"stream_name":"stdout","time":19207.71961935,"data":"       |                 new_free2 = free_vertices - {v,u}\n"}
,{"stream_name":"stdout","time":19207.719620486,"data":"       |                 sol = recurse(new_free2, edges+[edge], target_k)\n"}
,{"stream_name":"stdout","time":19207.719621727,"data":"       |                 if sol:\n"}
,{"stream_name":"stdout","time":19207.719622796,"data":"       |                     return sol\n"}
,{"stream_name":"stdout","time":19207.719623883,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":19207.719624946,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.719625958,"data":"       |     for k in range(1, max_k+1):\n"}
,{"stream_name":"stdout","time":19207.719627031,"data":"       |         print(\"trying k=\",k)\n"}
,{"stream_name":"stdout","time":19207.719628215,"data":"       |         sol = recurse(set(range(n*n)), [], k)\n"}
,{"stream_name":"stdout","time":19207.719629318,"data":"       |         if sol:\n"}
,{"stream_name":"stdout","time":19207.71963037,"data":"       |             print(\"found solution with k=\",k)\n"}
,{"stream_name":"stdout","time":19207.719631516,"data":"       |             return k, sol\n"}
,{"stream_name":"stdout","time":19207.719632605,"data":"       |     return None\n"}
,{"stream_name":"stdout","time":19207.71963368,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.719634691,"data":"       | result = find_min_matching(9)\n"}
