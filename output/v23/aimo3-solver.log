,{"stream_name":"stdout","time":19207.725395057,"data":"       |         if r+2 \u003c R:\n"}
,{"stream_name":"stdout","time":19207.725397709,"data":"       |             req['D'] = {idx(r+2,c)}\n"}
,{"stream_name":"stdout","time":19207.725398843,"data":"       |         else:\n"}
