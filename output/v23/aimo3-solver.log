,{"stream_name":"stdout","time":19207.730129279,"data":"       |         mask |= domino_masks[i]\n"}
,{"stream_name":"stdout","time":19207.730130352,"data":"       |     if overlap continue.\n"}
,{"stream_name":"stdout","time":19207.730131431,"data":"       |     # after building mask, verify neighbor condition:\n"}
,{"stream_name":"stdout","time":19207.730132574,"data":"       |     for i in S:\n"}
,{"stream_name":"stdout","time":19207.730135568,"data":"       |         for n in neighbor_cells[i]:\n"}
,{"stream_name":"stdout","time":19207.73013668,"data":"       |             if n is None (edge) -\u003e continue\n"}
,{"stream_name":"stdout","time":19207.730137818,"data":"       |             if not (mask \u0026 (1 \u003c\u003c n)):\n"}
,{"stream_name":"stdout","time":19207.730139076,"data":"       |                 fail\n"}
,{"stream_name":"stdout","time":19207.730140123,"data":"       |     if all pass: return subset.\n"}
