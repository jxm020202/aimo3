,{"stream_name":"stdout","time":19207.726387247,"data":"       | def search_min_m(max_m=12):\n"}
,{"stream_name":"stdout","time":19207.726388346,"data":"       |     # iterate target m from 1 upward\n"}
,{"stream_name":"stdout","time":19207.726389426,"data":"       |     for target_m in range(1, max_m+1):\n"}
,{"stream_name":"stdout","time":19207.726390515,"data":"       |         # start recursive search\n"}
,{"stream_name":"stdout","time":19207.726391619,"data":"       |         # we need to consider any starting placements; we will choose first placement heuristically.\n"}
,{"stream_name":"stdout","time":19207.726392834,"data":"       |         # We'll implement recursive function that picks a required cell (or any empty cell if none) and tries placements.\n"}
,{"stream_name":"stdout","time":19207.726394059,"data":"       |         visited = set()\n"}
,{"stream_name":"stdout","time":19207.726395128,"data":"       |         def recurse(selected, occupied_mask, required_set):\n"}
,{"stream_name":"stdout","time":19207.726396269,"data":"       |             # prune by remaining capacity\n"}
,{"stream_name":"stdout","time":19207.726397377,"data":"       |             remaining = target_m - len(selected)\n"}
,{"stream_name":"stdout","time":19207.726398482,"data":"       |             if len(required_set) \u003e 2*remaining:\n"}
,{"stream_name":"stdout","time":19207.726399648,"data":"       |                 return None\n"}
,{"stream_name":"stdout","time":19207.726400733,"data":"       |             # if no more placements to add\n"}
,{"stream_name":"stdout","time":19207.72640185,"data":"       |             if len(selected) == target_m:\n"}
,{"stream_name":"stdout","time":19207.72640294,"data":"       |                 if not required_set:\n"}
,{"stream_name":"stdout","time":19207.726404034,"data":"       |                     return selected\n"}
,{"stream_name":"stdout","time":19207.726405129,"data":"       |                 else:\n"}
,{"stream_name":"stdout","time":19207.726406193,"data":"       |                     return None\n"}
,{"stream_name":"stdout","time":19207.726407295,"data":"       |             # memoization key\n"}
,{"stream_name":"stdout","time":19207.726408372,"data":"       |             key = (occupied_mask, tuple(sorted(required_set)), len(selected))\n"}
,{"stream_name":"stdout","time":19207.726409534,"data":"       |             if key in visited:\n"}
,{"stream_name":"stdout","time":19207.726410617,"data":"       |                 return None\n"}
,{"stream_name":"stdout","time":19207.726411682,"data":"       |             visited.add(key)\n"}
,{"stream_name":"stdout","time":19207.726414567,"data":"       |             # choose a cell to cover next: if required_set nonempty, pick one of them; else pick any empty cell that could be part of a domino (maybe we need to add new domino even if not required? but we could also stop early; but we need exactly target_m dominos, so we must add more even if no required cells; they can be placed arbitrarily as long as they don't create unsatisfied required cells)\n"}
,{"stream_name":"stdout","time":19207.726416304,"data":"       |             if required_set:\n"}
