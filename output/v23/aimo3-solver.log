,{"stream_name":"stdout","time":18877.350845877,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.350846932,"data":"       | def min_adj_sum(grid):\n"}
,{"stream_name":"stdout","time":18877.35084802,"data":"       |     n = len(grid)\n"}
,{"stream_name":"stdout","time":18877.350849087,"data":"       |     mins = 10**9\n"}
,{"stream_name":"stdout","time":18877.350850168,"data":"       |     for i in range(n):\n"}
,{"stream_name":"stdout","time":18877.350851249,"data":"       |         for j in range(n):\n"}
,{"stream_name":"stdout","time":18877.350852346,"data":"       |             v = grid[i][j]\n"}
,{"stream_name":"stdout","time":18877.350853428,"data":"       |             if i+1\u003cn:\n"}
,{"stream_name":"stdout","time":18877.350854517,"data":"       |                 mins = min(mins, v+grid[i+1][j])\n"}
,{"stream_name":"stdout","time":18877.35085563,"data":"       |             if j+1\u003cn:\n"}
,{"stream_name":"stdout","time":18877.350856719,"data":"       |                 mins = min(mins, v+grid[i][j+1])\n"}
,{"stream_name":"stdout","time":18877.350857838,"data":"       |     return mins\n"}
,{"stream_name":"stdout","time":18877.350858918,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.350859924,"data":"       | def random_grid(n):\n"}
,{"stream_name":"stdout","time":18877.350861014,"data":"       |     nums = list(range(1,n*n+1))\n"}
,{"stream_name":"stdout","time":18877.350862106,"data":"       |     random.shuffle(nums)\n"}
,{"stream_name":"stdout","time":18877.350863191,"data":"       |     grid = [nums[i*n:(i+1)*n] for i in range(n)]\n"}
,{"stream_name":"stdout","time":18877.350864332,"data":"       |     return grid\n"}
,{"stream_name":"stdout","time":18877.350865404,"data":"       | \n"}
,{"stream_name":"stdout","time":18877.350866425,"data":"       | def hill_climb(n, iterations=200000):\n"}
,{"stream_name":"stdout","time":18877.350867522,"data":"       |     grid = random_grid(n)\n"}
,{"stream_name":"stdout","time":18877.350868602,"data":"       |     best = min_adj_sum(grid)\n"}
,{"stream_name":"stdout","time":18877.350869704,"data":"       |     best_grid = [row[:] for row in grid]\n"}
,{"stream_name":"stdout","time":18877.350870811,"data":"       |     for it in range(iterations):\n"}
,{"stream_name":"stdout","time":18877.350871906,"data":"       |         # pick two random cells to swap\n"}
,{"stream_name":"stdout","time":18877.350873002,"data":"       |         i1,j1,i2,j2 = random.randrange(n), random.randrange(n), random.randrange(n), random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.350874218,"data":"       |         if i1==i2 and j1==j2:\n"}
,{"stream_name":"stdout","time":18877.350875304,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":18877.350876368,"data":"       |         # compute min before swap for affected cells\n"}
,{"stream_name":"stdout","time":18877.350877499,"data":"       |         # We'll compute full min each time for simplicity (n small)\n"}
,{"stream_name":"stdout","time":18877.350880043,"data":"       |         # swap\n"}
,{"stream_name":"stdout","time":18877.350881134,"data":"       |         grid[i1][j1], grid[i2][j2] = grid[i2][j2], grid[i1][j1]\n"}
,{"stream_name":"stdout","time":18877.35088229,"data":"       |         cur = min_adj_sum(grid)\n"}
,{"stream_name":"stdout","time":18877.350883401,"data":"       |         if cur \u003e= best:\n"}
,{"stream_name":"stdout","time":18877.350884532,"data":"       |             best = cur\n"}
,{"stream_name":"stdout","time":18877.350886344,"data":"       |             best_grid = [row[:] for row in grid]\n"}
,{"stream_name":"stdout","time":18877.350887456,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":18877.350888525,"data":"       |             # revert\n"}
,{"stream_name":"stdout","time":18877.350889611,"data":"       |             grid[i1][j1], grid[i2][j2] = grid[i2][j2], grid[i1][j1]\n"}
,{"stream_name":"stdout","time":18877.350890776,"data":"       |     return best, best_grid\n"}
