,{"stream_name":"stdout","time":19207.726380718,"data":"       | # Precompute placements covering each cell\n"}
,{"stream_name":"stdout","time":19207.726381827,"data":"       | placements_by_cell = [[] for _ in range(49)]\n"}
,{"stream_name":"stdout","time":19207.726382933,"data":"       | for i, p in enumerate(placements):\n"}
,{"stream_name":"stdout","time":19207.726384027,"data":"       |     for cell in p[0]:\n"}
,{"stream_name":"stdout","time":19207.726385095,"data":"       |         placements_by_cell[cell].append(i)\n"}
