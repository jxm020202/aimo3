,{"stream_name":"stdout","time":19207.71964039,"data":"       | def is_matching_valid(matching):\n"}
,{"stream_name":"stdout","time":19207.719641482,"data":"       |     occupied = set()\n"}
,{"stream_name":"stdout","time":19207.719642556,"data":"       |     for (i,j) in matching:\n"}
,{"stream_name":"stdout","time":19207.719643637,"data":"       |         occupied.add(i)\n"}
,{"stream_name":"stdout","time":19207.719644685,"data":"       |         occupied.add(j)\n"}
,{"stream_name":"stdout","time":19207.719645755,"data":"       |     # check each domino's support cells\n"}
,{"stream_name":"stdout","time":19207.719646852,"data":"       |     for (i,j) in matching:\n"}
