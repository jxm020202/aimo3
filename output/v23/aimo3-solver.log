,{"stream_name":"stdout","time":19207.725186373,"data":"       | for r in range(R-1):\n"}
,{"stream_name":"stdout","time":19207.725187464,"data":"       |     for c in range(C):\n"}
,{"stream_name":"stdout","time":19207.725188551,"data":"       |         cells = (idx(r,c), idx(r+1,c))\n"}
,{"stream_name":"stdout","time":19207.725189694,"data":"       |         mask = (1\u003c\u003ccells[0]) | (1\u003c\u003ccells[1])\n"}
,{"stream_name":"stdout","time":19207.725190876,"data":"       |         req = {}\n"}
,{"stream_name":"stdout","time":19207.725191934,"data":"       |         if r-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.725193009,"data":"       |             req['U'] = {idx(r-1,c)}\n"}
,{"stream_name":"stdout","time":19207.725194097,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.725195164,"data":"       |             req['U'] = None\n"}
,{"stream_name":"stdout","time":19207.725196251,"data":"       |         if r+2 \u003c R:\n"}
,{"stream_name":"stdout","time":19207.725197347,"data":"       |             req['D'] = {idx(r+2,c)}\n"}
,{"stream_name":"stdout","time":19207.725198463,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.725199511,"data":"       |             req['D'] = None\n"}
,{"stream_name":"stdout","time":19207.725200594,"data":"       |         if c-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.725201659,"data":"       |             req['L'] = {idx(r,c-1), idx(r+1,c-1)}\n"}
,{"stream_name":"stdout","time":19207.725202796,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.725203851,"data":"       |             req['L'] = None\n"}
,{"stream_name":"stdout","time":19207.72520495,"data":"       |         if c+1 \u003c C:\n"}
,{"stream_name":"stdout","time":19207.725206033,"data":"       |             req['R'] = {idx(r,c+1), idx(r+1,c+1)}\n"}
,{"stream_name":"stdout","time":19207.725207147,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.72520822,"data":"       |             req['R'] = None\n"}
,{"stream_name":"stdout","time":19207.725209296,"data":"       |         placements.append({'cells':cells,'mask':mask,'orientation':'V','req':req})\n"}
,{"stream_name":"stdout","time":19207.725210474,"data":"       | N = R*C\n"}
,{"stream_name":"stdout","time":19207.725211521,"data":"       | neighbors = {}\n"}
,{"stream_name":"stdout","time":19207.725212587,"data":"       | for r in range(R):\n"}
,{"stream_name":"stdout","time":19207.725213691,"data":"       |     for c in range(C):\n"}
,{"stream_name":"stdout","time":19207.725214757,"data":"       |         i = idx(r,c)\n"}
,{"stream_name":"stdout","time":19207.725215803,"data":"       |         neigh = []\n"}
,{"stream_name":"stdout","time":19207.725216851,"data":"       |         if r\u003e0: neigh.append(idx(r-1,c))\n"}
,{"stream_name":"stdout","time":19207.725217974,"data":"       |         if r\u003cR-1: neigh.append(idx(r+1,c))\n"}
,{"stream_name":"stdout","time":19207.7252191,"data":"       |         if c\u003e0: neigh.append(idx(r,c-1))\n"}
,{"stream_name":"stdout","time":19207.725220593,"data":"       |         if c\u003cC-1: neigh.append(idx(r,c+1))\n"}
,{"stream_name":"stdout","time":19207.72522173,"data":"       |         neighbors[i] = neigh\n"}
,{"stream_name":"stdout","time":19207.725222827,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.725223867,"data":"       | cell_to_placements = {i: [] for i in range(N)}\n"}
,{"stream_name":"stdout","time":19207.725224969,"data":"       | for i,p in enumerate(placements):\n"}
,{"stream_name":"stdout","time":19207.725226054,"data":"       |     for cell in p['cells']:\n"}
,{"stream_name":"stdout","time":19207.725228573,"data":"       |         cell_to_placements[cell].append(i)\n"}
,{"stream_name":"stdout","time":19207.725229707,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.72523073,"data":"       | # direction sets per placement\n"}
,{"stream_name":"stdout","time":19207.725231841,"data":"       | placement_dir_sets = []\n"}
,{"stream_name":"stdout","time":19207.725232924,"data":"       | for p in placements:\n"}
,{"stream_name":"stdout","time":19207.72523398,"data":"       |     dir_sets = []\n"}
,{"stream_name":"stdout","time":19207.725235064,"data":"       |     for d, req_set in p['req'].items():\n"}
,{"stream_name":"stdout","time":19207.72523616,"data":"       |         if req_set is None:\n"}
,{"stream_name":"stdout","time":19207.725237241,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":19207.725238299,"data":"       |         dir_sets.append(frozenset(req_set))\n"}
,{"stream_name":"stdout","time":19207.725239577,"data":"       |     placement_dir_sets.append(dir_sets)\n"}
,{"stream_name":"stdout","time":19207.725241187,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.725242791,"data":"       | def cell_available(cell, occupied_mask):\n"}
,{"stream_name":"stdout","time":19207.725244277,"data":"       |     if (occupied_mask \u003e\u003e cell) \u0026 1:\n"}
,{"stream_name":"stdout","time":19207.72524544,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":19207.72524649,"data":"       |     for nb in neighbors[cell]:\n"}
,{"stream_name":"stdout","time":19207.725247586,"data":"       |         if ((occupied_mask \u003e\u003e nb) \u0026 1) == 0:\n"}
,{"stream_name":"stdout","time":19207.725248754,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":19207.72524984,"data":"       |     return False\n"}
,{"stream_name":"stdout","time":19207.725250904,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.72525194,"data":"       | def any_cell_available(cell_set, occupied_mask):\n"}
,{"stream_name":"stdout","time":19207.725253049,"data":"       |     for cell in cell_set:\n"}
,{"stream_name":"stdout","time":19207.725254114,"data":"       |         if cell_available(cell, occupied_mask):\n"}
,{"stream_name":"stdout","time":19207.725255243,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":19207.725256304,"data":"       |     return False\n"}
,{"stream_name":"stdout","time":19207.72525735,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.725258361,"data":"       | best_solution = None\n"}
,{"stream_name":"stdout","time":19207.725259431,"data":"       | best_m = 100\n"}
,{"stream_name":"stdout","time":19207.725260524,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.725261534,"data":"       | def compute_unsatisfied(selected, occupied_mask):\n"}
,{"stream_name":"stdout","time":19207.725262633,"data":"       |     unsat = []\n"}
,{"stream_name":"stdout","time":19207.725263686,"data":"       |     for sp_idx in selected:\n"}
,{"stream_name":"stdout","time":19207.7252648,"data":"       |         unsat_sets = []\n"}
,{"stream_name":"stdout","time":19207.725265856,"data":"       |         for dir_set in placement_dir_sets[sp_idx]:\n"}
,{"stream_name":"stdout","time":19207.725266987,"data":"       |             if not any(((occupied_mask \u003e\u003e c) \u0026 1) for c in dir_set):\n"}
,{"stream_name":"stdout","time":19207.725268227,"data":"       |                 unsat_sets.append(dir_set)\n"}
,{"stream_name":"stdout","time":19207.725269331,"data":"       |         if unsat_sets:\n"}
,{"stream_name":"stdout","time":19207.725270423,"data":"       |             unsat.append((sp_idx, unsat_sets))\n"}
,{"stream_name":"stdout","time":19207.725272727,"data":"       |     return unsat\n"}
,{"stream_name":"stdout","time":19207.725273797,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.725274844,"data":"       | def get_candidate_placements_for_dirset(dir_set, occupied_mask, min_idx):\n"}
,{"stream_name":"stdout","time":19207.725276027,"data":"       |     # return list of placement indices that can occupy at least one cell in dir_set, with index \u003e= min_idx, and not overlapping occupied_mask\n"}
,{"stream_name":"stdout","time":19207.725277337,"data":"       |     candidates = set()\n"}
,{"stream_name":"stdout","time":19207.725278391,"data":"       |     for cell in dir_set:\n"}
,{"stream_name":"stdout","time":19207.72527948,"data":"       |         if (occupied_mask \u003e\u003e cell) \u0026 1:\n"}
,{"stream_name":"stdout","time":19207.725280637,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":19207.725281967,"data":"       |         for q_idx in cell_to_placements[cell]:\n"}
,{"stream_name":"stdout","time":19207.725283077,"data":"       |             if q_idx \u003c min_idx:\n"}
,{"stream_name":"stdout","time":19207.725284187,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.725285253,"data":"       |             q = placements[q_idx]\n"}
,{"stream_name":"stdout","time":19207.725286337,"data":"       |             if occupied_mask \u0026 q['mask']:\n"}
,{"stream_name":"stdout","time":19207.725287457,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.72528854,"data":"       |             candidates.add(q_idx)\n"}
,{"stream_name":"stdout","time":19207.725289647,"data":"       |     return list(candidates)\n"}
,{"stream_name":"stdout","time":19207.725290747,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.72529176,"data":"       | def backtrack(selected, occupied_mask, unsat, min_idx):\n"}
,{"stream_name":"stdout","time":19207.725292872,"data":"       |     global best_solution, best_m\n"}
,{"stream_name":"stdout","time":19207.725293942,"data":"       |     # prune by count\n"}
,{"stream_name":"stdout","time":19207.725294982,"data":"       |     if len(selected) \u003e= best_m:\n"}
,{"stream_name":"stdout","time":19207.7252961,"data":"       |         return\n"}
,{"stream_name":"stdout","time":19207.725297159,"data":"       |     # if no unsatisfied, solution found\n"}
,{"stream_name":"stdout","time":19207.725298244,"data":"       |     if not unsat:\n"}
,{"stream_name":"stdout","time":19207.725299302,"data":"       |         best_solution = selected.copy()\n"}
,{"stream_name":"stdout","time":19207.725300387,"data":"       |         best_m = len(selected)\n"}
,{"stream_name":"stdout","time":19207.72530148,"data":"       |         print(\"Found solution m =\", best_m)\n"}
,{"stream_name":"stdout","time":19207.725302644,"data":"       |         return\n"}
,{"stream_name":"stdout","time":19207.72530369,"data":"       |     # Choose unsatisfied direction set with fewest candidate placements\n"}
,{"stream_name":"stdout","time":19207.725304882,"data":"       |     best_choice = None\n"}
,{"stream_name":"stdout","time":19207.725306107,"data":"       |     best_cands = None\n"}
,{"stream_name":"stdout","time":19207.72530717,"data":"       |     for sp_idx, dir_sets in unsat:\n"}
,{"stream_name":"stdout","time":19207.725308247,"data":"       |         for dir_set in dir_sets:\n"}
,{"stream_name":"stdout","time":19207.725309323,"data":"       |             cands = get_candidate_placements_for_dirset(dir_set, occupied_mask, min_idx)\n"}
,{"stream_name":"stdout","time":19207.725310506,"data":"       |             # if no candidates, prune immediately\n"}
,{"stream_name":"stdout","time":19207.725312973,"data":"       |             if not cands:\n"}
,{"stream_name":"stdout","time":19207.72531408,"data":"       |                 return\n"}
,{"stream_name":"stdout","time":19207.725315127,"data":"       |             if best_cands is None or len(cands) \u003c len(best_cands):\n"}
,{"stream_name":"stdout","time":19207.725316352,"data":"       |                 best_cands = cands\n"}
,{"stream_name":"stdout","time":19207.725317424,"data":"       |                 best_choice = (sp_idx, dir_set)\n"}
,{"stream_name":"stdout","time":19207.72531854,"data":"       |                 if len(best_cands) == 1:\n"}
,{"stream_name":"stdout","time":19207.725319626,"data":"       |                     break\n"}
,{"stream_name":"stdout","time":19207.725320699,"data":"       |         if best_cands is not None and len(best_cands) == 1:\n"}
,{"stream_name":"stdout","time":19207.72532184,"data":"       |             break\n"}
,{"stream_name":"stdout","time":19207.725322897,"data":"       |     # iterate over candidates\n"}
,{"stream_name":"stdout","time":19207.725324016,"data":"       |     for q_idx in best_cands:\n"}
,{"stream_name":"stdout","time":19207.725325103,"data":"       |         q = placements[q_idx]\n"}
,{"stream_name":"stdout","time":19207.72532618,"data":"       |         new_selected = selected + [q_idx]\n"}
,{"stream_name":"stdout","time":19207.72532727,"data":"       |         new_occupied = occupied_mask | q['mask']\n"}
,{"stream_name":"stdout","time":19207.725328377,"data":"       |         new_unsat = compute_unsatisfied(new_selected, new_occupied)\n"}
,{"stream_name":"stdout","time":19207.725329517,"data":"       |         # prune: each unsatisfied dir_set must have at least one cell available\n"}
,{"stream_name":"stdout","time":19207.725330697,"data":"       |         prune = False\n"}
,{"stream_name":"stdout","time":19207.725332009,"data":"       |         for sp_i, dir_sets in new_unsat:\n"}
,{"stream_name":"stdout","time":19207.725333113,"data":"       |             for ds in dir_sets:\n"}
,{"stream_name":"stdout","time":19207.725334207,"data":"       |                 if not any_cell_available(ds, new_occupied):\n"}
,{"stream_name":"stdout","time":19207.725335344,"data":"       |                     prune = True\n"}
,{"stream_name":"stdout","time":19207.725336439,"data":"       |                     break\n"}
,{"stream_name":"stdout","time":19207.725337506,"data":"       |             if prune:\n"}
,{"stream_name":"stdout","time":19207.725338567,"data":"       |                 break\n"}
,{"stream_name":"stdout","time":19207.725339624,"data":"       |         if prune:\n"}
,{"stream_name":"stdout","time":19207.725340677,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":19207.725341764,"data":"       |         # continue recursion, enforce ordering to avoid permutations: next min_idx = q_idx+1\n"}
,{"stream_name":"stdout","time":19207.72534297,"data":"       |         backtrack(new_selected, new_occupied, new_unsat, q_idx+1)\n"}
,{"stream_name":"stdout","time":19207.725344126,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.725345132,"data":"       | # start recursion with empty selection\n"}
,{"stream_name":"stdout","time":19207.725346217,"data":"       | start_time = time.time()\n"}
,{"stream_name":"stdout","time":19207.725347313,"data":"       | backtrack([], 0, [], 0)\n"}
,{"stream_name":"stdout","time":19207.725348367,"data":"       | print(\"Best m after search:\", best_m, \"time\", time.time()-start_time)\n"}
,{"stream_name":"stdout","time":19207.72534963,"data":"       | \n"}
