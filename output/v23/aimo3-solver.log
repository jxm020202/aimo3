,{"stream_name":"stdout","time":19207.725176079,"data":"       |             req['U'] = {idx(r-1,c), idx(r-1,c+1)}\n"}
,{"stream_name":"stdout","time":19207.725177214,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.725178257,"data":"       |             req['U'] = None\n"}
,{"stream_name":"stdout","time":19207.72517934,"data":"       |         if r+1 \u003c R:\n"}
,{"stream_name":"stdout","time":19207.725180427,"data":"       |             req['D'] = {idx(r+1,c), idx(r+1,c+1)}\n"}
,{"stream_name":"stdout","time":19207.725181547,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":19207.725182591,"data":"       |             req['D'] = None\n"}
