,{"stream_name":"stdout","time":18877.338921595,"data":"       | def simulated_annealing(m,n,iterations=200000):\n"}
,{"stream_name":"stdout","time":18877.338922713,"data":"       |     total = m*n\n"}
,{"stream_name":"stdout","time":18877.338923778,"data":"       |     target = total\n"}
,{"stream_name":"stdout","time":18877.338924866,"data":"       |     # start with random permutation\n"}
,{"stream_name":"stdout","time":18877.33892597,"data":"       |     perm = list(range(1,total+1))\n"}
,{"stream_name":"stdout","time":18877.338927087,"data":"       |     random.shuffle(perm)\n"}
,{"stream_name":"stdout","time":18877.338928161,"data":"       |     grid = [perm[i*n:(i+1)*n] for i in range(m)]\n"}
,{"stream_name":"stdout","time":18877.338929291,"data":"       |     def min_adj(grid):\n"}
,{"stream_name":"stdout","time":18877.338930383,"data":"       |         mins=10**9\n"}
,{"stream_name":"stdout","time":18877.33893145,"data":"       |         for i in range(m):\n"}
,{"stream_name":"stdout","time":18877.33893252,"data":"       |             for j in range(n):\n"}
,{"stream_name":"stdout","time":18877.338933624,"data":"       |                 v=grid[i][j]\n"}
,{"stream_name":"stdout","time":18877.33893471,"data":"       |                 if i+1\u003cm:\n"}
,{"stream_name":"stdout","time":18877.338935828,"data":"       |                     mins=min(mins, v+grid[i+1][j])\n"}
,{"stream_name":"stdout","time":18877.338936961,"data":"       |                 if j+1\u003cn:\n"}
,{"stream_name":"stdout","time":18877.338938063,"data":"       |                     mins=min(mins, v+grid[i][j+1])\n"}
,{"stream_name":"stdout","time":18877.338939206,"data":"       |         return mins\n"}
,{"stream_name":"stdout","time":18877.33894027,"data":"       |     best = min_adj(grid)\n"}
,{"stream_name":"stdout","time":18877.33894134,"data":"       |     best_grid = [row[:] for row in grid]\n"}
,{"stream_name":"stdout","time":18877.338942435,"data":"       |     T=1.0\n"}
,{"stream_name":"stdout","time":18877.33894348,"data":"       |     for it in range(iterations):\n"}
,{"stream_name":"stdout","time":18877.33894459,"data":"       |         # random swap two cells\n"}
,{"stream_name":"stdout","time":18877.338945685,"data":"       |         i1,j1 = random.randrange(m), random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.338947026,"data":"       |         i2,j2 = random.randrange(m), random.randrange(n)\n"}
,{"stream_name":"stdout","time":18877.338948173,"data":"       |         if (i1,j1)==(i2,j2): continue\n"}
,{"stream_name":"stdout","time":18877.338949267,"data":"       |         # swap\n"}
,{"stream_name":"stdout","time":18877.338950337,"data":"       |         grid[i1][j1], grid[i2][j2] = grid[i2][j2], grid[i1][j1]\n"}
,{"stream_name":"stdout","time":18877.338951481,"data":"       |         cur = min_adj(grid)\n"}
,{"stream_name":"stdout","time":18877.338952572,"data":"       |         if cur \u003e best:\n"}
,{"stream_name":"stdout","time":18877.338953681,"data":"       |             best = cur\n"}
,{"stream_name":"stdout","time":18877.338954752,"data":"       |             best_grid = [row[:] for row in grid]\n"}
,{"stream_name":"stdout","time":18877.338957238,"data":"       |         # accept if better or with probability\n"}
,{"stream_name":"stdout","time":18877.338958396,"data":"       |         if cur \u003e= best or random.random() \u003c math.exp((cur - best)/T):\n"}
,{"stream_name":"stdout","time":18877.338959622,"data":"       |             # keep swap\n"}
,{"stream_name":"stdout","time":18877.338960696,"data":"       |             pass\n"}
,{"stream_name":"stdout","time":18877.338961758,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":18877.338962831,"data":"       |             # revert\n"}
,{"stream_name":"stdout","time":18877.338963949,"data":"       |             grid[i1][j1], grid[i2][j2] = grid[i2][j2], grid[i1][j1]\n"}
,{"stream_name":"stdout","time":18877.338965118,"data":"       |         # cooling\n"}
,{"stream_name":"stdout","time":18877.338966175,"data":"       |         T *= 0.99999\n"}
,{"stream_name":"stdout","time":18877.338967244,"data":"       |     return best, best_grid\n"}
,{"stream_name":"stdout","time":18877.338968373,"data":"       | \n"}
