,{"stream_name":"stdout","time":19207.721218606,"data":"       | def lower_bound_needed(selected, max_total):\n"}
,{"stream_name":"stdout","time":19207.721219716,"data":"       |     # compute lower bound on additional dominos needed to satisfy requirements\n"}
,{"stream_name":"stdout","time":19207.72122091,"data":"       |     reqs = get_unsatisfied_requirements(selected)\n"}
,{"stream_name":"stdout","time":19207.721222036,"data":"       |     # union of required cells\n"}
,{"stream_name":"stdout","time":19207.721223139,"data":"       |     needed_cells = set()\n"}
,{"stream_name":"stdout","time":19207.72122509,"data":"       |     for s in reqs:\n"}
,{"stream_name":"stdout","time":19207.721226163,"data":"       |         needed_cells.update(s)\n"}
,{"stream_name":"stdout","time":19207.721227249,"data":"       |     # cells already occupied are not needed (they are occupied)\n"}
,{"stream_name":"stdout","time":19207.721228392,"data":"       |     occupied = set()\n"}
,{"stream_name":"stdout","time":19207.721229452,"data":"       |     for idx in selected:\n"}
,{"stream_name":"stdout","time":19207.721230556,"data":"       |         occupied.update(placement_cells[idx])\n"}
,{"stream_name":"stdout","time":19207.721231832,"data":"       |     needed_cells = needed_cells - occupied\n"}
,{"stream_name":"stdout","time":19207.721232926,"data":"       |     # each new domino adds 2 cells\n"}
,{"stream_name":"stdout","time":19207.721235659,"data":"       |     lb = (len(needed_cells) + 1) // 2\n"}
,{"stream_name":"stdout","time":19207.721236806,"data":"       |     # also need at least number of remaining dominos allowed\n"}
,{"stream_name":"stdout","time":19207.72123795,"data":"       |     remaining = max_total - len(selected)\n"}
,{"stream_name":"stdout","time":19207.72123904,"data":"       |     if lb \u003e remaining:\n"}
,{"stream_name":"stdout","time":19207.72124072,"data":"       |         return None  # impossible\n"}
,{"stream_name":"stdout","time":19207.721242346,"data":"       |     return lb\n"}
,{"stream_name":"stdout","time":19207.721243956,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.721245392,"data":"       | def can_cover_required_cells(required_cells, occupied_mask):\n"}
