,{"stream_name":"stdout","time":19207.703552133,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.70355314,"data":"       | # Define board size\n"}
,{"stream_name":"stdout","time":19207.703554136,"data":"       | N = 7\n"}
,{"stream_name":"stdout","time":19207.703555117,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703556066,"data":"       | # Generate all possible domino placements (horizontal and vertical)\n"}
,{"stream_name":"stdout","time":19207.703557159,"data":"       | placements = []\n"}
,{"stream_name":"stdout","time":19207.703558152,"data":"       | for r in range(N):\n"}
,{"stream_name":"stdout","time":19207.703559166,"data":"       |     for c in range(N-1):\n"}
,{"stream_name":"stdout","time":19207.703560193,"data":"       |         placements.append(((r,c),(r,c+1)))  # horizontal\n"}
,{"stream_name":"stdout","time":19207.703561292,"data":"       | for r in range(N-1):\n"}
,{"stream_name":"stdout","time":19207.703562286,"data":"       |     for c in range(N):\n"}
,{"stream_name":"stdout","time":19207.703563344,"data":"       |         placements.append(((r,c),(r+1,c)))  # vertical\n"}
,{"stream_name":"stdout","time":19207.703564419,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.70356537,"data":"       | # Function to compute required cells for a placement\n"}
,{"stream_name":"stdout","time":19207.703566432,"data":"       | def required_cells(pl):\n"}
,{"stream_name":"stdout","time":19207.703567423,"data":"       |     (r1,c1),(r2,c2) = pl\n"}
,{"stream_name":"stdout","time":19207.703568439,"data":"       |     req = []\n"}
,{"stream_name":"stdout","time":19207.703569436,"data":"       |     if r1 == r2:  # horizontal\n"}
,{"stream_name":"stdout","time":19207.703570447,"data":"       |         r = r1\n"}
,{"stream_name":"stdout","time":19207.703571433,"data":"       |         c_left = min(c1,c2)\n"}
,{"stream_name":"stdout","time":19207.70357245,"data":"       |         # left shift: need cell (r, c_left-1) if inside\n"}
,{"stream_name":"stdout","time":19207.703573515,"data":"       |         if c_left-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703574552,"data":"       |             req.append({(r, c_left-1)})\n"}
,{"stream_name":"stdout","time":19207.703575582,"data":"       |         # right shift: need cell (r, c_left+2) if inside\n"}
,{"stream_name":"stdout","time":19207.703576647,"data":"       |         if c_left+2 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703577692,"data":"       |             req.append({(r, c_left+2)})\n"}
,{"stream_name":"stdout","time":19207.703578715,"data":"       |         # up shift: need both cells (r-1, c_left) and (r-1, c_left+1) if inside\n"}
,{"stream_name":"stdout","time":19207.703579827,"data":"       |         if r-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703580836,"data":"       |             req.append({(r-1, c_left), (r-1, c_left+1)})\n"}
,{"stream_name":"stdout","time":19207.703581899,"data":"       |         # down shift: need both cells (r+1, c_left) and (r+1, c_left+1) if inside\n"}
,{"stream_name":"stdout","time":19207.703584652,"data":"       |         if r+1 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703585702,"data":"       |             req.append({(r+1, c_left), (r+1, c_left+1)})\n"}
,{"stream_name":"stdout","time":19207.703586775,"data":"       |     else:  # vertical\n"}
,{"stream_name":"stdout","time":19207.703587796,"data":"       |         c = c1\n"}
,{"stream_name":"stdout","time":19207.703588777,"data":"       |         r_top = min(r1,r2)\n"}
,{"stream_name":"stdout","time":19207.703589809,"data":"       |         # up shift: need cell (r_top-1, c) if inside\n"}
,{"stream_name":"stdout","time":19207.70359086,"data":"       |         if r_top-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703591902,"data":"       |             req.append({(r_top-1, c)})\n"}
,{"stream_name":"stdout","time":19207.703593107,"data":"       |         # down shift: need cell (r_top+2, c) if inside\n"}
,{"stream_name":"stdout","time":19207.703594177,"data":"       |         if r_top+2 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703595229,"data":"       |             req.append({(r_top+2, c)})\n"}
,{"stream_name":"stdout","time":19207.703596264,"data":"       |         # left shift: need both cells (r_top, c-1) and (r_top+1, c-1) if inside\n"}
,{"stream_name":"stdout","time":19207.703597357,"data":"       |         if c-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.70359836,"data":"       |             req.append({(r_top, c-1), (r_top+1, c-1)})\n"}
,{"stream_name":"stdout","time":19207.703599426,"data":"       |         # right shift: need both cells (r_top, c+2) and (r_top+1, c+2) if inside\n"}
,{"stream_name":"stdout","time":19207.703600549,"data":"       |         if c+2 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703601564,"data":"       |             req.append({(r_top, c+2), (r_top+1, c+2)})\n"}
,{"stream_name":"stdout","time":19207.703602656,"data":"       |     return req\n"}
,{"stream_name":"stdout","time":19207.703604594,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.70360557,"data":"       | # Precompute required sets for each placement\n"}
,{"stream_name":"stdout","time":19207.703606712,"data":"       | req_sets = [required_cells(pl) for pl in placements]\n"}
,{"stream_name":"stdout","time":19207.703607777,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703608732,"data":"       | # Cells occupied by each placement\n"}
,{"stream_name":"stdout","time":19207.703609763,"data":"       | placement_cells = [set(pl) for pl in placements]\n"}
,{"stream_name":"stdout","time":19207.703611002,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703611947,"data":"       | # Mapping from cell to placements covering it\n"}
,{"stream_name":"stdout","time":19207.703612972,"data":"       | cell_to_placements = {}\n"}
,{"stream_name":"stdout","time":19207.70361398,"data":"       | for idx, cells in enumerate(placement_cells):\n"}
,{"stream_name":"stdout","time":19207.703615162,"data":"       |     for cell in cells:\n"}
,{"stream_name":"stdout","time":19207.703616166,"data":"       |         cell_to_placements.setdefault(cell, []).append(idx)\n"}
,{"stream_name":"stdout","time":19207.703617342,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703618294,"data":"       | def unsatisfied(selected_set, occupied):\n"}
,{"stream_name":"stdout","time":19207.703619309,"data":"       |     unsat = []\n"}
,{"stream_name":"stdout","time":19207.70362032,"data":"       |     for i in selected_set:\n"}
,{"stream_name":"stdout","time":19207.703621415,"data":"       |         for R in req_sets[i]:\n"}
,{"stream_name":"stdout","time":19207.70362244,"data":"       |             if not R.issubset(occupied):\n"}
,{"stream_name":"stdout","time":19207.703632792,"data":"       |                 unsat.append((i,R))\n"}
,{"stream_name":"stdout","time":19207.703633927,"data":"       |     return unsat\n"}
,{"stream_name":"stdout","time":19207.703634944,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703635903,"data":"       | def find_solution(limit, time_limit=10):\n"}
,{"stream_name":"stdout","time":19207.70363697,"data":"       |     start = time.time()\n"}
,{"stream_name":"stdout","time":19207.703637972,"data":"       |     visited = set()\n"}
,{"stream_name":"stdout","time":19207.70363904,"data":"       |     solution = None\n"}
,{"stream_name":"stdout","time":19207.703640054,"data":"       |     \n"}
,{"stream_name":"stdout","time":19207.703641032,"data":"       |     def dfs(selected_set, occupied):\n"}
,{"stream_name":"stdout","time":19207.703642053,"data":"       |         nonlocal solution\n"}
,{"stream_name":"stdout","time":19207.703643067,"data":"       |         if solution is not None:\n"}
,{"stream_name":"stdout","time":19207.703644089,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":19207.703645096,"data":"       |         if len(selected_set) \u003e limit:\n"}
,{"stream_name":"stdout","time":19207.703646153,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":19207.703647172,"data":"       |         unsat = unsatisfied(selected_set, occupied)\n"}
,{"stream_name":"stdout","time":19207.703648235,"data":"       |         if not unsat:\n"}
,{"stream_name":"stdout","time":19207.703649224,"data":"       |             solution = selected_set.copy()\n"}
,{"stream_name":"stdout","time":19207.703650269,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":19207.703651262,"data":"       |         # choose requirement with fewest missing cells\n"}
,{"stream_name":"stdout","time":19207.703652319,"data":"       |         best_missing = None\n"}
,{"stream_name":"stdout","time":19207.703653345,"data":"       |         for i,R in unsat:\n"}
,{"stream_name":"stdout","time":19207.703654362,"data":"       |             missing = [c for c in R if c not in occupied]\n"}
,{"stream_name":"stdout","time":19207.703655629,"data":"       |             if best_missing is None or len(missing) \u003c len(best_missing):\n"}
,{"stream_name":"stdout","time":19207.7036568,"data":"       |                 best_missing = missing\n"}
,{"stream_name":"stdout","time":19207.703657829,"data":"       |                 if len(best_missing) == 1:\n"}
,{"stream_name":"stdout","time":19207.703658862,"data":"       |                     break\n"}
,{"stream_name":"stdout","time":19207.70365986,"data":"       |         cell = best_missing[0]\n"}
,{"stream_name":"stdout","time":19207.703660876,"data":"       |         for p in cell_to_placements.get(cell, []):\n"}
,{"stream_name":"stdout","time":19207.703661924,"data":"       |             if placement_cells[p] \u0026 occupied:\n"}
,{"stream_name":"stdout","time":19207.703663009,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.703664013,"data":"       |             new_selected = selected_set | {p}\n"}
,{"stream_name":"stdout","time":19207.70366506,"data":"       |             new_occupied = occupied | placement_cells[p]\n"}
,{"stream_name":"stdout","time":19207.703666143,"data":"       |             state = (frozenset(new_selected), frozenset(new_occupied))\n"}
,{"stream_name":"stdout","time":19207.703667224,"data":"       |             if state in visited:\n"}
,{"stream_name":"stdout","time":19207.70366826,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.703669265,"data":"       |             visited.add(state)\n"}
,{"stream_name":"stdout","time":19207.703671557,"data":"       |             if time.time() - start \u003e time_limit:\n"}
,{"stream_name":"stdout","time":19207.70367267,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":19207.703673685,"data":"       |             if dfs(new_selected, new_occupied):\n"}
,{"stream_name":"stdout","time":19207.703674737,"data":"       |                 return True\n"}
,{"stream_name":"stdout","time":19207.703675742,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":19207.703676757,"data":"       |     \n"}
,{"stream_name":"stdout","time":19207.70367774,"data":"       |     dfs(set(), set())\n"}
,{"stream_name":"stdout","time":19207.703678726,"data":"       |     return solution, len(visited)\n"}
,{"stream_name":"stdout","time":19207.703679755,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703680737,"data":"       | # Search for minimal m\n"}
,{"stream_name":"stdout","time":19207.703681744,"data":"       | for m in range(1,20):\n"}
,{"stream_name":"stdout","time":19207.703682745,"data":"       |     sol, visited = find_solution(m, time_limit=5)\n"}
