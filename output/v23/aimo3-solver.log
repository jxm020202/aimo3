,{"stream_name":"stdout","time":19207.727656425,"data":"       |     # start with random domino\n"}
,{"stream_name":"stdout","time":19207.727657508,"data":"       |     start = random.choice(range(len(placements)))\n"}
,{"stream_name":"stdout","time":19207.727658636,"data":"       |     selected = {start}\n"}
,{"stream_name":"stdout","time":19207.727661422,"data":"       |     occ_mask = placement_masks[start]\n"}
,{"stream_name":"stdout","time":19207.727662542,"data":"       |     # proceed as before\n"}
,{"stream_name":"stdout","time":19207.727663607,"data":"       |     while True:\n"}
,{"stream_name":"stdout","time":19207.727664668,"data":"       |         unsatisfied = []\n"}
,{"stream_name":"stdout","time":19207.727665763,"data":"       |         for i in selected:\n"}
,{"stream_name":"stdout","time":19207.727666878,"data":"       |             for dname in dirs:\n"}
,{"stream_name":"stdout","time":19207.727667952,"data":"       |                 inside = target_inside[(i,dname)]\n"}
