,{"stream_name":"stdout","time":19207.721252156,"data":"       |             if pm \u0026 occupied_mask == 0:  # placement does not overlap occupied cells\n"}
,{"stream_name":"stdout","time":19207.721253379,"data":"       |                 possible = True\n"}
,{"stream_name":"stdout","time":19207.721254459,"data":"       |                 break\n"}
