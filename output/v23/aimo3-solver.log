,{"stream_name":"stdout","time":19207.722589657,"data":"       |             bottom = max(r1,r2)\n"}
,{"stream_name":"stdout","time":19207.722590746,"data":"       |             return [(bottom+1, c1)]\n"}
,{"stream_name":"stdout","time":19207.722591856,"data":"       |         if dir_idx == 2:  # left\n"}
