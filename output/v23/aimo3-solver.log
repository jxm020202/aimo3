,{"stream_name":"stdout","time":19207.709733763,"data":"       |             for cell in req:\n"}
,{"stream_name":"stdout","time":19207.709734979,"data":"       |                 # iterate over dominoes covering this cell\n"}
,{"stream_name":"stdout","time":19207.709736111,"data":"       |                 for d_idx in cell_to_dominos[cell]:\n"}
