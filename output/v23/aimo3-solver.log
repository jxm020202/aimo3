,{"stream_name":"stdout","time":19207.703687984,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703688936,"data":"       | # Define board size\n"}
,{"stream_name":"stdout","time":19207.703689934,"data":"       | N = 7\n"}
,{"stream_name":"stdout","time":19207.70369092,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703691869,"data":"       | # Generate all possible domino placements (horizontal and vertical)\n"}
,{"stream_name":"stdout","time":19207.703692955,"data":"       | placements = []\n"}
,{"stream_name":"stdout","time":19207.70369395,"data":"       | for r in range(N):\n"}
,{"stream_name":"stdout","time":19207.70369494,"data":"       |     for c in range(N-1):\n"}
,{"stream_name":"stdout","time":19207.703695955,"data":"       |         placements.append(((r,c),(r,c+1)))  # horizontal\n"}
,{"stream_name":"stdout","time":19207.703697026,"data":"       | for r in range(N-1):\n"}
,{"stream_name":"stdout","time":19207.703698042,"data":"       |     for c in range(N):\n"}
,{"stream_name":"stdout","time":19207.70369906,"data":"       |         placements.append(((r,c),(r+1,c)))  # vertical\n"}
,{"stream_name":"stdout","time":19207.703700112,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703701073,"data":"       | # Function to compute required cells for a placement\n"}
,{"stream_name":"stdout","time":19207.703702135,"data":"       | def required_cells(pl):\n"}
,{"stream_name":"stdout","time":19207.703703146,"data":"       |     (r1,c1),(r2,c2) = pl\n"}
,{"stream_name":"stdout","time":19207.703704149,"data":"       |     req = []\n"}
,{"stream_name":"stdout","time":19207.703705135,"data":"       |     if r1 == r2:  # horizontal\n"}
,{"stream_name":"stdout","time":19207.703706146,"data":"       |         r = r1\n"}
,{"stream_name":"stdout","time":19207.703707172,"data":"       |         c_left = min(c1,c2)\n"}
,{"stream_name":"stdout","time":19207.703708207,"data":"       |         # left shift: need cell (r, c_left-1) if inside\n"}
,{"stream_name":"stdout","time":19207.703709505,"data":"       |         if c_left-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703710519,"data":"       |             req.append({(r, c_left-1)})\n"}
,{"stream_name":"stdout","time":19207.703712889,"data":"       |         # right shift: need cell (r, c_left+2) if inside\n"}
,{"stream_name":"stdout","time":19207.703713996,"data":"       |         if c_left+2 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703715026,"data":"       |             req.append({(r, c_left+2)})\n"}
,{"stream_name":"stdout","time":19207.703716069,"data":"       |         # up shift: need both cells (r-1, c_left) and (r-1, c_left+1) if inside\n"}
,{"stream_name":"stdout","time":19207.70371718,"data":"       |         if r-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703718222,"data":"       |             req.append({(r-1, c_left), (r-1, c_left+1)})\n"}
,{"stream_name":"stdout","time":19207.703719289,"data":"       |         # down shift: need both cells (r+1, c_left) and (r+1, c_left+1) if inside\n"}
,{"stream_name":"stdout","time":19207.703720407,"data":"       |         if r+1 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703721416,"data":"       |             req.append({(r+1, c_left), (r+1, c_left+1)})\n"}
,{"stream_name":"stdout","time":19207.703722487,"data":"       |     else:  # vertical\n"}
,{"stream_name":"stdout","time":19207.703723502,"data":"       |         c = c1\n"}
,{"stream_name":"stdout","time":19207.703724499,"data":"       |         r_top = min(r1,r2)\n"}
,{"stream_name":"stdout","time":19207.70372552,"data":"       |         # up shift: need cell (r_top-1, c) if inside\n"}
,{"stream_name":"stdout","time":19207.703726592,"data":"       |         if r_top-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703727615,"data":"       |             req.append({(r_top-1, c)})\n"}
,{"stream_name":"stdout","time":19207.703728655,"data":"       |         # down shift: need cell (r_top+2, c) if inside\n"}
,{"stream_name":"stdout","time":19207.703729715,"data":"       |         if r_top+2 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703730732,"data":"       |             req.append({(r_top+2, c)})\n"}
,{"stream_name":"stdout","time":19207.703731762,"data":"       |         # left shift: need both cells (r_top, c-1) and (r_top+1, c-1) if inside\n"}
,{"stream_name":"stdout","time":19207.703732866,"data":"       |         if c-1 \u003e= 0:\n"}
,{"stream_name":"stdout","time":19207.703733902,"data":"       |             req.append({(r_top, c-1), (r_top+1, c-1)})\n"}
,{"stream_name":"stdout","time":19207.703734962,"data":"       |         # right shift: need both cells (r_top, c+2) and (r_top+1, c+2) if inside\n"}
,{"stream_name":"stdout","time":19207.703736065,"data":"       |         if c+2 \u003c N:\n"}
,{"stream_name":"stdout","time":19207.703737075,"data":"       |             req.append({(r_top, c+2), (r_top+1, c+2)})\n"}
,{"stream_name":"stdout","time":19207.703738126,"data":"       |     return req\n"}
,{"stream_name":"stdout","time":19207.703739129,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703740086,"data":"       | # Precompute required sets for each placement\n"}
,{"stream_name":"stdout","time":19207.703741127,"data":"       | req_sets = [required_cells(pl) for pl in placements]\n"}
,{"stream_name":"stdout","time":19207.703742205,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703743203,"data":"       | # Cells occupied by each placement\n"}
,{"stream_name":"stdout","time":19207.703744237,"data":"       | placement_cells = [set(pl) for pl in placements]\n"}
,{"stream_name":"stdout","time":19207.703745277,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703746235,"data":"       | # Mapping from cell to placements covering it\n"}
,{"stream_name":"stdout","time":19207.703747312,"data":"       | cell_to_placements = {}\n"}
,{"stream_name":"stdout","time":19207.703749772,"data":"       | for idx, cells in enumerate(placement_cells):\n"}
,{"stream_name":"stdout","time":19207.70375103,"data":"       |     for cell in cells:\n"}
,{"stream_name":"stdout","time":19207.703752055,"data":"       |         cell_to_placements.setdefault(cell, []).append(idx)\n"}
,{"stream_name":"stdout","time":19207.70375312,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.7037541,"data":"       | def unsatisfied(selected_set, occupied):\n"}
,{"stream_name":"stdout","time":19207.703755253,"data":"       |     unsat = []\n"}
,{"stream_name":"stdout","time":19207.703756252,"data":"       |     for i in selected_set:\n"}
,{"stream_name":"stdout","time":19207.703757272,"data":"       |         for R in req_sets[i]:\n"}
,{"stream_name":"stdout","time":19207.703758299,"data":"       |             if not R.issubset(occupied):\n"}
,{"stream_name":"stdout","time":19207.703759726,"data":"       |                 unsat.append((i,R))\n"}
,{"stream_name":"stdout","time":19207.703760766,"data":"       |     return unsat\n"}
,{"stream_name":"stdout","time":19207.703761769,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703762725,"data":"       | def find_solution(limit, time_limit=10):\n"}
,{"stream_name":"stdout","time":19207.703763875,"data":"       |     start = time.time()\n"}
,{"stream_name":"stdout","time":19207.703764875,"data":"       |     visited = set()\n"}
,{"stream_name":"stdout","time":19207.703765895,"data":"       |     solution = None\n"}
,{"stream_name":"stdout","time":19207.703766895,"data":"       |     \n"}
,{"stream_name":"stdout","time":19207.70376805,"data":"       |     def dfs(selected_set, occupied):\n"}
,{"stream_name":"stdout","time":19207.70376908,"data":"       |         nonlocal solution\n"}
,{"stream_name":"stdout","time":19207.703770087,"data":"       |         if solution is not None:\n"}
,{"stream_name":"stdout","time":19207.703771133,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":19207.703772127,"data":"       |         if len(selected_set) \u003e limit:\n"}
,{"stream_name":"stdout","time":19207.703773195,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":19207.703774202,"data":"       |         unsat = unsatisfied(selected_set, occupied)\n"}
,{"stream_name":"stdout","time":19207.703775289,"data":"       |         if not unsat:\n"}
,{"stream_name":"stdout","time":19207.703776296,"data":"       |             solution = selected_set.copy()\n"}
,{"stream_name":"stdout","time":19207.703777349,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":19207.703778336,"data":"       |         # choose requirement with fewest missing cells\n"}
,{"stream_name":"stdout","time":19207.703779425,"data":"       |         best_missing = None\n"}
,{"stream_name":"stdout","time":19207.703780447,"data":"       |         for i,R in unsat:\n"}
,{"stream_name":"stdout","time":19207.70378146,"data":"       |             missing = [c for c in R if c not in occupied]\n"}
,{"stream_name":"stdout","time":19207.703782542,"data":"       |             if best_missing is None or len(missing) \u003c len(best_missing):\n"}
,{"stream_name":"stdout","time":19207.703783662,"data":"       |                 best_missing = missing\n"}
,{"stream_name":"stdout","time":19207.703784722,"data":"       |                 if len(best_missing) == 1:\n"}
,{"stream_name":"stdout","time":19207.703785756,"data":"       |                     break\n"}
,{"stream_name":"stdout","time":19207.703786755,"data":"       |         cell = best_missing[0]\n"}
,{"stream_name":"stdout","time":19207.703787767,"data":"       |         for p in cell_to_placements.get(cell, []):\n"}
,{"stream_name":"stdout","time":19207.703790199,"data":"       |             if placement_cells[p] \u0026 occupied:\n"}
,{"stream_name":"stdout","time":19207.703791329,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.703792359,"data":"       |             new_selected = selected_set | {p}\n"}
,{"stream_name":"stdout","time":19207.703793407,"data":"       |             new_occupied = occupied | placement_cells[p]\n"}
,{"stream_name":"stdout","time":19207.703794497,"data":"       |             state = (frozenset(new_selected), frozenset(new_occupied))\n"}
,{"stream_name":"stdout","time":19207.703795619,"data":"       |             if state in visited:\n"}
,{"stream_name":"stdout","time":19207.703796647,"data":"       |                 continue\n"}
,{"stream_name":"stdout","time":19207.703797656,"data":"       |             visited.add(state)\n"}
,{"stream_name":"stdout","time":19207.703798672,"data":"       |             if time.time() - start \u003e time_limit:\n"}
,{"stream_name":"stdout","time":19207.703799759,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":19207.703800793,"data":"       |             if dfs(new_selected, new_occupied):\n"}
,{"stream_name":"stdout","time":19207.703801839,"data":"       |                 return True\n"}
,{"stream_name":"stdout","time":19207.70380286,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":19207.703803885,"data":"       |     \n"}
,{"stream_name":"stdout","time":19207.70380485,"data":"       |     dfs(set(), set())\n"}
,{"stream_name":"stdout","time":19207.703805863,"data":"       |     return solution, len(visited)\n"}
,{"stream_name":"stdout","time":19207.703806886,"data":"       | \n"}
,{"stream_name":"stdout","time":19207.703807842,"data":"       | # Search for minimal m\n"}
,{"stream_name":"stdout","time":19207.703808852,"data":"       | for m in range(1,20):\n"}
,{"stream_name":"stdout","time":19207.70380989,"data":"       |     sol, visited = find_solution(m, time_limit=5)\n"}
,{"stream_name":"stdout","time":19207.703811176,"data":"       |     print(\"m\", m, \"found\", sol is not None, \"visited\", visited)\n"}
