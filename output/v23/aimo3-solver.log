,{"stream_name":"stdout","time":18877.338885945,"data":"       |                     mins=min(mins, v+grid[i][j+1])\n"}
,{"stream_name":"stdout","time":18877.338887076,"data":"       |         return mins\n"}
,{"stream_name":"stdout","time":18877.338888148,"data":"       |     best = min_adj(grid)\n"}
