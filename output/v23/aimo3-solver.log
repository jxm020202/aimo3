,{"stream_name":"stdout","time":18877.34908245,"data":"       |         if i\u003cn-1: d+=1\n"}
,{"stream_name":"stdout","time":18877.349083559,"data":"       |         if j\u003e0: d+=1\n"}
,{"stream_name":"stdout","time":18877.349084662,"data":"       |         if j\u003cn-1: d+=1\n"}
,{"stream_name":"stdout","time":18877.349085767,"data":"       |         return d\n"}
,{"stream_name":"stdout","time":18877.349086855,"data":"       |     cells.sort(key=lambda pos: -degree(*pos))\n"}
,{"stream_name":"stdout","time":18877.349087963,"data":"       |     # adjacency list\n"}
,{"stream_name":"stdout","time":18877.349089039,"data":"       |     adj = {}\n"}
,{"stream_name":"stdout","time":18877.3490901,"data":"       |     for i,j in cells:\n"}
,{"stream_name":"stdout","time":18877.349091167,"data":"       |         neigh=[]\n"}
