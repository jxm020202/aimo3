,{"stream_name":"stdout","time":19207.716620885,"data":"       | # Precompute ends for each placement\n"}
,{"stream_name":"stdout","time":19207.716622058,"data":"       | def ends_of(p):\n"}
,{"stream_name":"stdout","time":19207.716623182,"data":"       |     (r1,c1),(r2,c2) = p\n"}
,{"stream_name":"stdout","time":19207.716624302,"data":"       |     # Determine orientation\n"}
,{"stream_name":"stdout","time":19207.716625443,"data":"       |     if r1==r2: # horizontal\n"}
,{"stream_name":"stdout","time":19207.716626583,"data":"       |         # left cell is (r1,c1) (c1 \u003c c2)\n"}
,{"stream_name":"stdout","time":19207.7166278,"data":"       |         left = (r1, c1-1) if c1-1 \u003e=0 else None\n"}
,{"stream_name":"stdout","time":19207.716629048,"data":"       |         right = (r1, c2+1) if c2+1 \u003c C else None\n"}
,{"stream_name":"stdout","time":19207.716630255,"data":"       |         return (left, right)\n"}
,{"stream_name":"stdout","time":19207.716631448,"data":"       |     else: # vertical\n"}
,{"stream_name":"stdout","time":19207.716632565,"data":"       |         # top cell is (r1,c1) (r1 \u003c r2)\n"}
,{"stream_name":"stdout","time":19207.71663376,"data":"       |         top = (r1-1, c1) if r1-1 \u003e=0 else None\n"}
,{"stream_name":"stdout","time":19207.716634972,"data":"       |         bottom = (r2+1, c2) if r2+1 \u003c R else None\n"}
,{"stream_name":"stdout","time":19207.716636189,"data":"       |         return (top, bottom)\n"}
,{"stream_name":"stdout","time":19207.716637369,"data":"       | \n"}
