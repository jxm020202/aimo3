,{"stream_name":"stdout","time":19207.709420858,"data":"       |                     # impossible to satisfy this clause\n"}
,{"stream_name":"stdout","time":19207.70942198,"data":"       |                     return False\n"}
,{"stream_name":"stdout","time":19207.709423078,"data":"       |                 if best_options is None or len(candidates) \u003c len(best_options):\n"}
,{"stream_name":"stdout","time":19207.709424306,"data":"       |                     best_clause = idx_c\n"}
,{"stream_name":"stdout","time":19207.709425398,"data":"       |                     best_options = candidates\n"}
,{"stream_name":"stdout","time":19207.709426502,"data":"       |                     if len(best_options) == 1:\n"}
,{"stream_name":"stdout","time":19207.709427606,"data":"       |                         break\n"}
,{"stream_name":"stdout","time":19207.709428678,"data":"       |             # branch on candidates\n"}
,{"stream_name":"stdout","time":19207.709429768,"data":"       |             for d_idx in best_options:\n"}
,{"stream_name":"stdout","time":19207.709430855,"data":"       |                 d = dominoes[d_idx]\n"}
,{"stream_name":"stdout","time":19207.709431948,"data":"       |                 c1,c2 = d['cells']\n"}
,{"stream_name":"stdout","time":19207.709433034,"data":"       |                 new_occupied = occupied | {c1,c2}\n"}
