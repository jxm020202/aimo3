,{"stream_name":"stdout","time":19207.713524777,"data":"       | def max_matching_free_cells(free_cells):\n"}
,{"stream_name":"stdout","time":19207.713525877,"data":"       |     # free_cells: set of cell indices\n"}
,{"stream_name":"stdout","time":19207.71352701,"data":"       |     left_nodes = [i for i in free_cells if (rc(i)[0] + rc(i)[1]) % 2 == 0]\n"}
,{"stream_name":"stdout","time":19207.713528184,"data":"       |     right_nodes = [i for i in free_cells if (rc(i)[0] + rc(i)[1]) % 2 == 1]\n"}
,{"stream_name":"stdout","time":19207.71352934,"data":"       |     adj = defaultdict(set)\n"}
