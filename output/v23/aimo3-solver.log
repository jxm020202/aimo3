,{"stream_name":"stdout","time":19207.725870209,"data":"       |                 right_adj = r*7 + (c_right+1)\n"}
,{"stream_name":"stdout","time":19207.725871313,"data":"       |                 if right_adj not in occupied:\n"}
,{"stream_name":"stdout","time":19207.72587243,"data":"       |                     return False\n"}
,{"stream_name":"stdout","time":19207.725873518,"data":"       |         else:  # V\n"}
,{"stream_name":"stdout","time":19207.725874578,"data":"       |             top_cell = cells[0]\n"}
,{"stream_name":"stdout","time":19207.725875688,"data":"       |             bottom_cell = cells[1]\n"}
,{"stream_name":"stdout","time":19207.72587677,"data":"       |             r_top = top_cell // 7\n"}
