            def build_ilp():
                n=7
                # generate placements
                placements=[]
                # each placement: (type, r, c) where type='H' or 'V'
                for r in range(n):
                    for c in range(n-1):
                        placements.append(('H', r, c))
                for r in range(n-1):
                    for c in range(n):
                        placements.append(('V', r, c))
                num=len(placements)
                # map cell to placements covering it
                cell_to_placements = {(i,j): [] for i in range(n) for j in range(n)}
                for idx, (typ, r, c) in enumerate(placements):
                    if typ=='H':
                        cells=[(r,c),(r,c+1)]
                    else:
                        cells=[(r,c),(r+1,c)]
                    for cell in cells:
                        cell_to_placements[cell].append(idx)
                # Build constraints
                rows=[]
                ub=[]
                # cell constraints: sum <=1
                for i in range(n):
                    for j in range(n):
                        coeff = np.zeros(num)
                        for idx in cell_to_placements[(i,j)]:
                            coeff[idx]=1
                        rows.append(coeff)
                        ub.append(1)
                # blocking constraints
                for idx, (typ, r, c) in enumerate(placements):
                    # left/right/up/down constraints as described
                    # For each direction, if neighbor cell(s) exist, enforce sum >= x[idx]
                    # We'll add constraint: x[idx] - sum_{q in neighbor_set} <= 0
                    # i.e., coeff[idx]=1, coeff[neighbor]= -1
                    # left
                    if typ=='H':
                        # left neighbor cell (r,c-1)
                        if c-1 >=0:
                            neighbor_set = cell_to_placements[(r,c-1)]
                            coeff = np.zeros(num)
                            coeff[idx]=1
                            for q in neighbor_set:
                                coeff[q] -= 1
                            rows.append(coeff)
                            ub.append(0)
                        # right neighbor cell (r,c+2)
                        if c+2 < n:
                            neighbor_set = cell_to_placements[(r,c+2)]
                            coeff = np.zeros(num)
                            coeff[idx]=1
                            for q in neighbor_set:
                                coeff[q] -= 1
                            rows.append(coeff)
                            ub.append(0)
                        # up cells (r-1,c) and (r-1,c+1)
                        if r-1 >=0:
                            for cell in [(r-1,c),(r-1,c+1)]:
                                neighbor_set = cell_to_placements[cell]
                                coeff = np.zeros(num)
                                coeff[idx]=1
                                for q in neighbor_set:
                                    coeff[q] -= 1
                                rows.append(coeff)
                                ub.append(0)
                        # down cells (r+1,c) and (r+1,c+1)
                        if r+1 < n:
                            for cell in [(r+1,c),(r+1,c+1)]:
                                neighbor_set = cell_to_placements[cell]
                                coeff = np.zeros(num)
                                coeff[idx]=1
                                for q in neighbor_set:
                                    coeff[q] -= 1
                                rows.append(coeff)
                                ub.append(0)
                    else: # vertical
                        # up neighbor cell (r-1,c)
                        if r-1 >=0:
                            neighbor_set = cell_to_placements[(r-1,c)]
                            coeff = np.zeros(num)
                            coeff[idx]=1
                            for q in neighbor_set:
                                coeff[q] -= 1
                            rows.append(coeff)
                            ub.append(0)
                        # down neighbor cell (r+2,c)
                        if r+2 < n:
                            neighbor_set = cell_to_placements[(r+2,c)]
                            coeff = np.zeros(num)
                            coeff[idx]=1
                            for q in neighbor_set:
                                coeff[q] -= 1
                            rows.append(coeff)
                            ub.append(0)
                        # left cells (r,c-1) and (r+1,c-1)
                        if c-1 >=0:
                            for cell in [(r,c-1),(r+1,c-1)]:
                                neighbor_set = cell_to_placements[cell]
                                coeff = np.zeros(num)
                                coeff[idx]=1
                                for q in neighbor_set:
                                    coeff[q] -= 1
                                rows.append(coeff)
                                ub.append(0)
                        # right cells (r,c+1) and (r+1,c+1)
                        if c+1 < n:
                            for cell in [(r,c+1),(r+1,c+1)]:
                                neighbor_set = cell_to_placements[cell]
                                coeff = np.zeros(num)
                                coeff[idx]=1
                                for q in neighbor_set:
                                    coeff[q] -= 1
                                rows.append(coeff)
                                ub.append(0)
                A = np.vstack(rows)
                ub = np.array(ub)
                # No lower bounds for constraints (i.e., -inf)
                # Use LinearConstraint with lb = -inf, ub = ub
                lb = -np.inf * np.ones(A.shape[0])
                lc = LinearConstraint(A, lb, ub)
                c = np.ones(num)  # minimize sum
                bounds = Bounds(0,1)
                integrality = np.ones(num, dtype=int)
                return c, lc, bounds, integrality, placements
            
            c, lc, bounds, integrality, placements = build_ilp()
            print("num vars", len(c), "num constraints", lc.A.shape[0])
            
