            def f_bruteforce_general(n, limit=5000):
                best = None
                best_tuple = None
                for y in range(1, limit+1):
                    # need three distinct divisors of y summing to n
                    divs = sp.divisors(y)
                    if len(divs) < 3:
                        continue
                    for a,b,c in sp.utilities.iterables.combinations(divs,3):
                        if a+b+c == n:
                            if best is None or y < best:
                                best = y
                                best_tuple = (a,b,c)
                            break
                    # early break if y already > best? but we need minimal
                return best, best_tuple
            
            def f_bruteforce_a1(n, limit=5000):
                best = None
                for y in range(1, limit+1):
                    # need divisors a,b,c distinct sum n, with a=1
                    divs = sp.divisors(y)
                    if 1 not in divs:
                        continue
                    # choose b,c distinct from 1 and each other, and not equal to y maybe
                    for b,c in sp.utilities.iterables.combinations([d for d in divs if d!=1],2):
                        if 1 + b + c == n:
                            if best is None or y < best:
