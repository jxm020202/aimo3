            def verify(board):
                n=7
                # find placements from board
                placements=[]
                visited=set()
                for i in range(n):
                    for j in range(n):
                        if (i,j) in visited: continue
                        ch=board[i][j]
                        if ch=='.': continue
                        if ch=='=':
                            # horizontal, check right neighbor
                            if j+1<n and board[i][j+1]=='=':
                                placements.append(('H', i, j))
                                visited.add((i,j)); visited.add((i,j+1))
                            else:
                                raise ValueError("invalid horizontal")
                        elif ch=='|':
                            if i+1<n and board[i+1][j]=='|':
                                placements.append(('V', i, j))
                                visited.add((i,j)); visited.add((i+1,j))
                            else:
                                raise ValueError("invalid vertical")
                # verify no overlap
                # verify blocking
                # map cell to occupied (by any domino)
                occupied=set()
                for typ,r,c in placements:
                    if typ=='H':
                        occupied.add((r,c)); occupied.add((r,c+1))
                    else:
                        occupied.add((r,c)); occupied.add((r+1,c))
                # check each domino
                for typ,r,c in placements:
                    # left
                    if typ=='H':
                        # left neighbor cell
                        if c-1>=0:
                            if (r,c-1) not in occupied:
                                return False, f"left not blocked for H at {(r,c)}"
                        # right neighbor
                        if c+2< n:
