            def possible_coeffs(p, max_e=6):
                coeffs = set()
                divisors = [d for d in range(1, p+1) if p % d == 0]
                for d in divisors:
                    for e in range(max_e+1):
                        coeffs.add(d / (3**e))
                return sorted(coeffs)
            
