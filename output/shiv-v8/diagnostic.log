import sympy as sp

def min_t_for_c(c):
    # Return minimal divisor t of c such that c/t = 3^i + 3^j with i!=j
    # If no such t, return None
    # Enumerate divisors of c
    divisors = sp.divisors(c)
    # Precompute powers of 3 up to reasonable limit (since c up to ~2.6e8)
    # max power needed: 3^i <= c
    max_pow = int(sp.log(c, 3)) + 2
    powers = [3**i for i in range(max_pow+1)]
    # Create set of sums of two distinct powers
    sums = set()
    for i in range(len(powers)):
        for j in range(i+1, len(powers)):
            s = powers[i] + powers[j]
            if s > 0:
                sums.add(s)
    # Also include reversed order (i>j) same sums already covered
    # Now check divisors
    best = None
    for t in divisors:
        if t == 0:
            continue
        m = c // t
        if m in sums:
            best = t
            break
    return best

# Test on given c values (excluding the huge 4M case)
c_vals = [1848374, 10162574, 265710644, 44636594]
for c in c_vals:
    t = min_t_for_c(c)
    print(c, t)
