            def get_solution():
                c, lc, bounds, integrality, placements = build_ilp_atleast_one()
                # add sum x >= 1 constraint
                A_extra = np.ones((1, len(c)))
                A = np.vstack([lc.A, -A_extra])
                lb = np.hstack([lc.lb, -np.inf])
                ub = np.hstack([lc.ub, -1])
                lc2 = LinearConstraint(A, lb, ub)
                res = milp(c=c, constraints=lc2, bounds=bounds, integrality=integrality, options={"disp": False})
                if not res.success:
