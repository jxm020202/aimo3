                    row = np.zeros(n, dtype=int)
                    for i in idxs:
                        row[i] = 1
                    rows.append(row)
                    ub.append(1)
            
            # sliding constraints: for each domino, each direction
            for d_idx in range(n):
                dirs = neighbor_cells_by_direction(d_idx)
                for cells in dirs:
                    # sum of covering variables for these cells >= x_d
                    row = np.zeros(n, dtype=int)
                    # for each cell, add -1 for each covering variable
                    for cell in cells:
                        covering = cell_to_dominos.get(cell, [])
                        for i in covering:
