            import numpy as np
            
            def max_obj(k, n=2001):
                # grid over quarter circle
                xs = np.linspace(0, 1, n)
                max_val = 0.0
                max_pt = None
                for x in xs:
                    # y max such that x^2 + y^2 <= 1
                    ymax = np.sqrt(1 - x**2)
                    # sample y values
                    ys = np.linspace(0, ymax, n)
                    # compute sqrt(x^2 + y^2)
                    r = np.sqrt(x**2 + ys**2)
                    z = 1 - r
                    # compute objective
                    O = 4*(x*ys + k*x*z)
                    # find max
                    idx = np.argmax(O)
                    if O[idx] > max_val:
                        max_val = O[idx]
                        max_pt = (x, ys[idx], z[idx])
                return max_val, max_pt
            
