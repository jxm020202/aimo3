            def feasible_between(min_m, max_m):
                c, lc, bounds, integrality, placements = build_ilp_atleast_one()
                # sum x >= min_m and <= max_m
                A_extra = np.vstack([np.ones((1,len(c))), np.ones((1,len(c)))])
                # first row for >= min_m: -sum <= -min_m
                # second row for <= max_m: sum <= max_m
                A = np.vstack([lc.A, -A_extra[0], A_extra[1]])
                lb = np.hstack([lc.lb, -np.inf, -np.inf])
                ub = np.hstack([lc.ub, -min_m, max_m])
                lc2 = LinearConstraint(A, lb, ub)
                res = milp(c=c, constraints=lc2, bounds=bounds, integrality=integrality, options={"disp": False})
