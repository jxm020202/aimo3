            import math
            from sympy import crt
            
            def M_mod_d(d):
                # compute M = 3^{2025!} mod d
                # factor d into 3^k * m where m not divisible by 3
                k = 0
                while d % 3 == 0:
                    d //= 3
                    k += 1
                m = d  # now m not divisible by 3
                # compute modulus for 3^k part
                mod1 = 3**k
                # M ≡ 0 mod 3^k (if k>0) else no condition
                # For m part, M ≡ 1 mod m (if m>1) else no condition
                # combine using CRT
                if k == 0:
                    # just mod m, M ≡ 1
                    return 1 % m
                if m == 1:
                    # only 3^k part
                    return 0 % mod1
                # else combine
                # solve x ≡ 0 (mod 3^k), x ≡ 1 (mod m)
                # using sympy crt
                sol, lcm_mod = crt([mod1, m], [0, 1])
                return int(sol % lcm_mod)
            
