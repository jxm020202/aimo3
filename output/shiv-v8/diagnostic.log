            import sympy as sp
            
            def f_bruteforce(n, limit=10000):
                # Search y from 1 upwards
                for y in range(1, limit+1):
                    # Get divisors
                    divs = sp.divisors(y)
                    if len(divs) < 3:
                        continue
                    # choose three distinct divisors
                    # we can check combinations
                    for a in divs:
                        for b in divs:
                            if b <= a: continue
                            for c in divs:
                                if c <= b: continue
                                if a + b + c == n:
                                    return y
                return None
            
            def f_formula(n):
                m = n-1
                # find largest divisor d < m/2
                # get all proper divisors (excluding m)
                divisors = sp.divisors(m)
                proper = [d for d in divisors if d < m]
                # filter d < m/2
                candidates = [d for d in proper if d < m/2]
                if not candidates:
                    # maybe no divisor < m/2, then cannot use 1,d,y construction
                    return None
                d = max(candidates)
                y = n - 1 - d
                return y
            
