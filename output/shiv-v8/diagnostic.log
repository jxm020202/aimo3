            import sympy as sp
            
            def smallest_odd_prime_divisor_of_m(c, is_c_multiple_of_M=False):
                """
                Compute smallest odd prime divisor p of m = M + c - 1,
                where M = 3^K, K = 2025!.
                If is_c_multiple_of_M is True, then c is given as k*M (i.e., c = k*M),
                so we compute c_mod_p = k * M_mod mod p.
                """
                # generate odd primes in increasing order
                # We'll search up to some limit; if not found, we continue.
                # Since we know p must exist (m>1).
                # For efficiency, we precompute factorial modulo for each p-1 as needed.
                # We'll use sympy.primerange.
                for p in sp.primerange(3, 2000000):  # search up to 2 million for safety
                    if p == 2:
                        continue
                    # compute M_mod = 3^K mod p
                    if p == 3:
                        M_mod = 0
                    else:
                        mod = p - 1
                        # compute K_mod = 2025! mod (p-1)
                        # compute factorial modulo mod
                        K_mod = 1
                        for i in range(2, 2026):
                            K_mod = (K_mod * i) % mod
                            # if K_mod becomes 0, break early (since then K_mod=0)
                            # but we continue
                        # Now compute M_mod = 3^K_mod mod p
                        M_mod = pow(3, K_mod, p)
                    if is_c_multiple_of_M:
                        # c = k*M, where k is integer (e.g., 4)
                        # c_mod = k * M_mod mod p
                        # For our case c = 4M, k=4
                        # We'll assume c is given as k * M (k integer)
                        # We'll need k as integer; for now we pass c as k
                        k = c  # c is actually k
                        c_mod = (k * M_mod) % p
                        m_mod = (M_mod + c_mod - 1) % p
                    else:
                        # c is ordinary integer
                        c_mod = c % p
                        m_mod = (M_mod + c_mod - 1) % p
                    if m_mod == 0:
                        return p
                return None
            
            # Test for small c values using reasoning approach
            c_vals = [0, 1848374, 10162574, 265710644, 44636594]
            for c in c_vals:
                p = smallest_odd_prime_divisor_of_m(c)
                print(c, p)
            
