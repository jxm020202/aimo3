            import sympy as sp
            
            def symbolic_max_f(k):
                # variables
                r, theta = sp.symbols('r theta', real=True, nonnegative=True)
                # define x,y,z
                x = r*sp.cos(theta)
                y = r*sp.sin(theta)
                z = 1 - r
                expr = 4*(x*y + k*x*z)
                # substitute constraint: r in [0,1], theta in [0, pi/2]
                # Find critical points: partial derivatives zero
                dr = sp.diff(expr, r)
                dtheta = sp.diff(expr, theta)
                # Solve for interior points (r>0, r<1, theta in (0, pi/2))
                sol = sp.nsolve([dr, dtheta], [r, theta], [0.5, 0.5])
                return sol
            
