            # Verify constraints manually
            def can_slide(p_idx, direction):
                p = placements[p_idx]
                r, c = p['r'], p['c']
                # Determine target cells for slide
                if p['type'] == 'H':
                    if direction == 'L':
                        if c-1 < 0:
                            return False
                        target = [(r, c-1)]
                    elif direction == 'R':
                        if c+2 >= C:
                            return False
                        target = [(r, c+2)]
                    elif direction == 'U':
                        if r-1 < 0:
                            return False
                        target = [(r-1, c), (r-1, c+1)]
                    elif direction == 'D':
                        if r+1 >= R:
                            return False
                        target = [(r+1, c), (r+1, c+1)]
                else:  # V
                    if direction == 'U':
                        if r-1 < 0:
                            return False
                        target = [(r-1, c)]
                    elif direction == 'D':
                        if r+2 >= R:
                            return False
                        target = [(r+2, c)]
                    elif direction == 'L':
                        if c-1 < 0:
                            return False
                        target = [(r, c-1), (r+1, c-1)]
                    elif direction == 'R':
                        if c+1 >= C:
                            return False
                        target = [(r, c+1), (r+1, c+1)]
                # Check if any target cell is occupied by another domino
                for (tr, tc) in target:
