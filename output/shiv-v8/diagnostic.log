            def required_squares(placement):
                typ, r, c = placement
                req = []
                if typ == 'H':
                    # left
                    if c-1 >= 0:
                        req.append((r, c-1))
                    # right
                    if c+2 < C:
                        req.append((r, c+2))
                    # up: both squares
                    if r-1 >= 0:
                        req.append((r-1, c))
                        req.append((r-1, c+1))
                    # down
                    if r+1 < R:
                        req.append((r+1, c))
                        req.append((r+1, c+1))
                else:  # V
                    # up
                    if r-1 >= 0:
                        req.append((r-1, c))
                    # down
                    if r+2 < R:
