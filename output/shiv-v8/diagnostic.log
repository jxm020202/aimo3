            import math
            from functools import lru_cache
            
            def divisors(n):
                divs = []
                for i in range(1, int(math.isqrt(n)) + 1):
                    if n % i == 0:
                        divs.append(i)
                        if i != n//i:
                            divs.append(n//i)
                return sorted(divs)
            
            def f_bruteforce(S, limit=2000):
                # compute minimal N such that there exist distinct a,b,c divisors of N with sum S
                # brute force over N up to some limit
                best = None
                bestN = None
                for N in range(1, limit+1):
                    divs = divisors(N)
                    # need three distinct
                    if len(divs) < 3:
                        continue
                    # check combos
                    for i in range(len(divs)):
                        for j in range(i+1, len(divs)):
                            for k in range(j+1, len(divs)):
                                if divs[i] + divs[j] + divs[k] == S:
                                    if best is None or N < best:
                                        best = N
                                        bestN = (divs[i], divs[j], divs[k])
                    # early break if we found N = S? Not needed
                return best, bestN
            
            def f_bruteforce2(S, Nmax=5000):
                # alternative: iterate over triples a<b<c with sum S, compute lcm and take min
                best = None
                best_trip = None
                # a,b,c positive distinct
                for a in range(1, S-2):
                    for b in range(a+1, S-1-a):
                        c = S - a - b
                        if c <= b:
                            continue
                        # distinct automatically
                        # compute lcm
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
            def f_bruteforce_comb(S):
                # compute min lcm directly
                best = None
                best_trip = None
                for a in range(1, S-1):
                    for b in range(a+1, S-a):
                        c = S - a - b
                        if c <= b:
                            continue
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
            def f_bruteforce_small(S):
                # compute min N by enumerating triples and lcm
                best = None
                best_trip = None
                for a in range(1, S-1):
                    for b in range(a+1, S-a):
                        c = S - a - b
                        if c <= b:
                            continue
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
            def f_bruteforce_check(S):
                best, trip = f_bruteforce_small(S)
                # verify that lcm(trip) indeed has divisors trip and sum S
                N = best
                # check
                divs = divisors(N)
                assert trip[0] in divs and trip[1] in divs and trip[2] in divs
                assert sum(trip) == S
                return best, trip
            
            # test for small S
            for S in range(6, 31):
                best, trip = f_bruteforce_check(S)
                print(S, best, trip)
            
