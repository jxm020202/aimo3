            def can_slide(domino_idx, direction, sol_set):
                # direction: 'L','R','U','D' for left,right,up,down
                typ, r, c = placements[domino_idx]
                # Determine cells occupied by domino
                if typ == 'H':
                    cells = [(r,c), (r,c+1)]
                else:
                    cells = [(r,c), (r+1,c)]
                # Determine target cells after sliding one step in direction
                if direction == 'L':
                    # shift left by 1: each cell column -1
                    new_cells = [(rr, cc-1) for (rr, cc) in cells]
                elif direction == 'R':
                    new_cells = [(rr, cc+1) for (rr, cc) in cells]
                elif direction == 'U':
                    new_cells = [(rr-1, cc) for (rr, cc) in cells]
                elif direction == 'D':
                    new_cells = [(rr+1, cc) for (rr, cc) in cells]
                else:
                    raise ValueError
                # Check if all new_cells are within board
                for (rr, cc) in new_cells:
                    if not (0 <= rr < n and 0 <= cc < n):
                        return False  # off-board, cannot slide
                # Check if any new cell is occupied by another domino in solution
                # Build set of occupied cells by all dominos in solution
                occupied = set()
                for i, val in enumerate(sol_set):
                    if val:
                        typ2, r2, c2 = placements[i]
                        if typ2 == 'H':
                            occ = [(r2,c2), (r2,c2+1)]
                        else:
                            occ = [(r2,c2), (r2+1,c2)]
                        occupied.update(occ)
                # Remove current domino's own cells
                occupied.difference_update(cells)
                # If any new cell is occupied, slide blocked
                for cell in new_cells:
                    if cell in occupied:
                        return False
                # If all new cells empty, slide possible
                return True
            
