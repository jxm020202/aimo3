                    if direction == 'left':
                        if c-1 >= 0:
                            cells.append((r, c-1))
                    elif direction == 'right':
                        if c+2 < 7:
                            cells.append((r, c+2))
                    elif direction == 'up':
                        if r-1 >= 0:
                            cells.append((r-1, c))
                            cells.append((r-1, c+1))
                    elif direction == 'down':
                        if r+1 < 7:
                            cells.append((r+1, c))
                            cells.append((r+1, c+1))
                else: # 'V'
                    if direction == 'up':
                        if r-1 >= 0:
                            cells.append((r-1, c))
                    elif direction == 'down':
                        if r+2 < 7:
                            cells.append((r+2, c))
                    elif direction == 'left':
                        if c-1 >= 0:
                            cells.append((r, c-1))
                            cells.append((r+1, c-1))
                    elif direction == 'right':
                        if c+1 < 7:
                            cells.append((r, c+1))
                            cells.append((r+1, c+1))
                return cells
            
