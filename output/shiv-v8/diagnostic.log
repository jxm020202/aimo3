            import sympy as sp
            
            def f_bruteforce(n, limit=10000):
                # find smallest t such that there exist three distinct divisors summing to n
                # t up to some limit
                for t in range(1, limit+1):
                    divs = sp.divisors(t)
                    if len(divs) < 3:
                        continue
                    # choose three distinct divisors
                    for i in range(len(divs)):
                        for j in range(i+1, len(divs)):
                            for k in range(j+1, len(divs)):
                                if divs[i] + divs[j] + divs[k] == n:
                                    return t
                return None
            
            def f_estimate(n):
                N = n-1
                if sp.isprime(N):
                    # only divisor 1, can't use e>1, maybe need other construction
                    return None
                p = sp.factorint(N)
                smallest_prime = min(p.keys())
                e = N // smallest_prime
                t = N - e
                return t
            
            # test for n up to 200
            fails = []
            for n in range(6, 201):
                f_true = f_bruteforce(n, limit=5000)
                f_est = f_estimate(n)
                if f_true != f_est:
                    fails.append((n, f_true, f_est))
            len(fails), fails[:20]
            
