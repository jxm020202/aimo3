            def f_formula(n):
                m = n-1
                # find largest divisor d of m with d>1 and d <= m//3
                # if none, return None
                best = None
                for d in sp.divisors(m):
                    if d>1 and d <= m//3:
                        if best is None or d>best:
                            best = d
                if best is not None:
                    return n-1 - best
                else:
                    return None
            
