                typ, r, c = placement
                # board is a 7x7 array with 1 if occupied by a domino cell, else 0
                if typ == 'H':
                    # cells: (r,c),(r,c+1)
                    # slide left
                    if c-1 >= 0:
                        if board[r, c-1] == 0:
                            # need both new cells empty? For horizontal sliding left, only left cell needed
                            # Actually sliding left moves domino to (r,c-1)-(r,c)
                            # new cells: (r,c-1) and (r,c) (already occupied by domino)
                            # The cell (r,c-1) must be empty
                            return True
                    # slide right
                    if c+2 < n:
                        if board[r, c+2] == 0:
