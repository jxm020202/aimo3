            def divisors(n):
                divs = []
                i=1
                while i*i<=n:
                    if n%i==0:
                        divs.append(i)
                        if i*i!=n:
                            divs.append(n//i)
                    i+=1
                return sorted(divs)
            
            def is_norwegian(N, target):
                divs = divisors(N)
                # need three distinct positive divisors sum to target
                # brute force combos
                L = len(divs)
                for i in range(L):
                    for j in range(i+1, L):
                        for k in range(j+1, L):
                            if divs[i]+divs[j]+divs[k]==target:
                                return True
                return False
            
            def f_bruteforce(n, limit=10000):
