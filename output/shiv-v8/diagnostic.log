            import sympy as sp
            
            # Precompute 2025! modulo many values? We'll compute factorial modulo (p-1) each time.
            
            def factorial_mod_modulo(mod):
                # compute 2025! % mod
                res = 1 % mod
                for i in range(2, 2026):
                    res = (res * i) % mod
                return res
            
            def find_smallest_prime_factor_N2(limit=2000000):
                # N2 = 5*3^{2025!} - 1
                for p in sp.primerange(5, limit+1):
                    if p == 3:
                        continue
                    # compute exponent e = 2025! mod (p-1)
                    mod = p-1
                    e = factorial_mod_modulo(mod)
                    # compute 3^e mod p
                    val = (5 * pow(3, e, p) - 1) % p
                    if val == 0:
