            def f_estimate_d1(n):
                N = n-1
                # find largest proper divisor e > 1 of N
                if N <= 2:
                    return None
                # factor N
                fac = sp.factorint(N)
                # smallest prime factor
                spf = min(fac.keys())
                if spf == N: # N is prime
                    return None
                e = N // spf
                t = N - e
                return t
            
            def compare_upto(Nmax):
                mismatches = []
                for n in range(6, Nmax+1):
                    f_true = f_bruteforce(n, limit=5000)
                    f_est = f_estimate_d1(n)
                    if f_true != f_est:
                        mismatches.append((n, f_true, f_est))
                return mismatches
            
            mism = compare_upto(200)
            len(mism), mism[:20]
            
