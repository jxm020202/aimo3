,{"stream_name":"stdout","time":2711.4821197,"data":"       | assistantanalysis to=python codedef projection_point_to_line(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.482121433,"data":"       |     # returns foot of perpendicular from P onto line AB\n"}
,{"stream_name":"stdout","time":2711.482122704,"data":"       |     (px,py) = P\n"}
,{"stream_name":"stdout","time":2711.482123866,"data":"       |     (x1,y1) = A\n"}
,{"stream_name":"stdout","time":2711.482125023,"data":"       |     (x2,y2) = B\n"}
,{"stream_name":"stdout","time":2711.482126181,"data":"       |     dx = x2 - x1\n"}
,{"stream_name":"stdout","time":2711.482127322,"data":"       |     dy = y2 - y1\n"}
,{"stream_name":"stdout","time":2711.482128495,"data":"       |     if dx == dy == 0:\n"}
,{"stream_name":"stdout","time":2711.482129742,"data":"       |         return A\n"}
,{"stream_name":"stdout","time":2711.48213095,"data":"       |     t = ((px - x1)*dx + (py - y1)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.482132221,"data":"       |     return (x1 + t*dx, y1 + t*dy)\n"}
,{"stream_name":"stdout","time":2711.482133453,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.482134585,"data":"       | def compute_ratio_for_B(B):\n"}
,{"stream_name":"stdout","time":2711.482135797,"data":"       |     phi = (1+math.sqrt(5))/2\n"}
,{"stream_name":"stdout","time":2711.482137004,"data":"       |     # compute C\n"}
,{"stream_name":"stdout","time":2711.482138211,"data":"       |     C = 2*math.atan(phi*math.tan(B/2))\n"}
,{"stream_name":"stdout","time":2711.482139464,"data":"       |     # points\n"}
,{"stream_name":"stdout","time":2711.482140635,"data":"       |     D = (1.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.482141824,"data":"       |     E = (-math.cos(C), math.sin(C))\n"}
,{"stream_name":"stdout","time":2711.482143019,"data":"       |     F = (-math.cos(B), -math.sin(B))\n"}
,{"stream_name":"stdout","time":2711.482144253,"data":"       |     # B point\n"}
,{"stream_name":"stdout","time":2711.482145408,"data":"       |     yB = (-1 - math.cos(B))/math.sin(B)\n"}
,{"stream_name":"stdout","time":2711.482146643,"data":"       |     Bpt = (1.0, yB)\n"}
,{"stream_name":"stdout","time":2711.482147857,"data":"       |     # C point\n"}
,{"stream_name":"stdout","time":2711.482149045,"data":"       |     yC = (1 + math.cos(C))/math.sin(C)\n"}
,{"stream_name":"stdout","time":2711.482150257,"data":"       |     Cpt = (1.0, yC)\n"}
,{"stream_name":"stdout","time":2711.482151434,"data":"       |     # A point using derived formula\n"}
,{"stream_name":"stdout","time":2711.482152665,"data":"       |     denom = math.sin(B + C)\n"}
,{"stream_name":"stdout","time":2711.482153859,"data":"       |     Ax = -(math.sin(B) + math.sin(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.482155066,"data":"       |     Ay = (math.cos(B) - math.cos(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.482156299,"data":"       |     Apt = (Ax, Ay)\n"}
,{"stream_name":"stdout","time":2711.482157463,"data":"       |     # circumcircle of AEF\n"}
,{"stream_name":"stdout","time":2711.48215868,"data":"       |     center_AEF, r_AEF = circumcenter(Apt, E, F)\n"}
,{"stream_name":"stdout","time":2711.482159908,"data":"       |     # circumcircle of ABC\n"}
,{"stream_name":"stdout","time":2711.482161099,"data":"       |     center_ABC, r_ABC = circumcenter(Apt, Bpt, Cpt)\n"}
,{"stream_name":"stdout","time":2711.482162352,"data":"       |     # intersection of circles\n"}
,{"stream_name":"stdout","time":2711.482164917,"data":"       |     inters = circle_intersections(center_AEF, r_AEF, center_ABC, r_ABC)\n"}
,{"stream_name":"stdout","time":2711.482166235,"data":"       |     # find K (not equal to A)\n"}
,{"stream_name":"stdout","time":2711.482167473,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.482168639,"data":"       |     for pt in inters:\n"}
,{"stream_name":"stdout","time":2711.48216989,"data":"       |         if math.hypot(pt[0]-Apt[0], pt[1]-Apt[1]) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":2711.482171208,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.482172408,"data":"       |             break\n"}
,{"stream_name":"stdout","time":2711.482173624,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.482174819,"data":"       |         # maybe due to numeric error, take first\n"}
,{"stream_name":"stdout","time":2711.482176056,"data":"       |         K = inters[0]\n"}
,{"stream_name":"stdout","time":2711.482177211,"data":"       |     # K'\n"}
,{"stream_name":"stdout","time":2711.482178391,"data":"       |     Kprime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.482179644,"data":"       |     # N: foot from D onto EF\n"}
,{"stream_name":"stdout","time":2711.482180853,"data":"       |     N = projection_point_to_line(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.48218206,"data":"       |     # circle through B and K tangent to BN at B\n"}
,{"stream_name":"stdout","time":2711.482183282,"data":"       |     # line BN direction vector\n"}
,{"stream_name":"stdout","time":2711.482184487,"data":"       |     vBN = (N[0] - Bpt[0], N[1] - Bpt[1])\n"}
,{"stream_name":"stdout","time":2711.482185997,"data":"       |     # perpendicular direction at B\n"}
,{"stream_name":"stdout","time":2711.482187217,"data":"       |     perp_dir = (-vBN[1], vBN[0])\n"}
,{"stream_name":"stdout","time":2711.482188458,"data":"       |     # line through B with direction perp_dir: param B + s*perp_dir\n"}
,{"stream_name":"stdout","time":2711.482189762,"data":"       |     # perpendicular bisector of BK\n"}
,{"stream_name":"stdout","time":2711.482190967,"data":"       |     midBK = ((Bpt[0] + K[0])/2, (Bpt[1] + K[1])/2)\n"}
,{"stream_name":"stdout","time":2711.482192215,"data":"       |     vBK = (K[0] - Bpt[0], K[1] - Bpt[1])\n"}
,{"stream_name":"stdout","time":2711.482193439,"data":"       |     perp_BK = (-vBK[1], vBK[0])\n"}
,{"stream_name":"stdout","time":2711.482194715,"data":"       |     # Solve intersection of two lines: B + s*perp_dir = midBK + t*perp_BK\n"}
,{"stream_name":"stdout","time":2711.482196017,"data":"       |     # Solve for s,t\n"}
,{"stream_name":"stdout","time":2711.48219718,"data":"       |     # B + s*perp_dir = midBK + t*perp_BK\n"}
,{"stream_name":"stdout","time":2711.482198388,"data":"       |     # =\u003e s*perp_dir - t*perp_BK = midBK - B\n"}
,{"stream_name":"stdout","time":2711.48219968,"data":"       |     # Solve linear system 2x2\n"}
,{"stream_name":"stdout","time":2711.482200868,"data":"       |     A_mat = [[perp_dir[0], -perp_BK[0]],\n"}
,{"stream_name":"stdout","time":2711.482202078,"data":"       |              [perp_dir[1], -perp_BK[1]]]\n"}
,{"stream_name":"stdout","time":2711.482203289,"data":"       |     b_vec = [midBK[0] - Bpt[0], midBK[1] - Bpt[1]]\n"}
,{"stream_name":"stdout","time":2711.482204535,"data":"       |     # Solve using determinant\n"}
,{"stream_name":"stdout","time":2711.482205759,"data":"       |     det = A_mat[0][0]*A_mat[1][1] - A_mat[0][1]*A_mat[1][0]\n"}
,{"stream_name":"stdout","time":2711.482207009,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.482209497,"data":"       |         # lines parallel? fallback\n"}
,{"stream_name":"stdout","time":2711.482210779,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.482211979,"data":"       |     s = (b_vec[0]*A_mat[1][1] - b_vec[1]*A_mat[0][1]) / det\n"}
,{"stream_name":"stdout","time":2711.482213244,"data":"       |     # center O_T\n"}
,{"stream_name":"stdout","time":2711.482214417,"data":"       |     O_T = (Bpt[0] + s*perp_dir[0], Bpt[1] + s*perp_dir[1])\n"}
,{"stream_name":"stdout","time":2711.482215668,"data":"       |     R_T = math.hypot(O_T[0] - Bpt[0], O_T[1] - Bpt[1])\n"}
,{"stream_name":"stdout","time":2711.482216911,"data":"       |     # intersect circle with line BC (x=1)\n"}
,{"stream_name":"stdout","time":2711.482218151,"data":"       |     # line BC: x=1, y variable\n"}
,{"stream_name":"stdout","time":2711.482219319,"data":"       |     # circle equation (x - cx)^2 + (y - cy)^2 = R_T^2\n"}
,{"stream_name":"stdout","time":2711.482220602,"data":"       |     # plug x=1 =\u003e (1 - cx)^2 + (y - cy)^2 = R_T^2 =\u003e (y - cy)^2 = R_T^2 - (1 - cx)^2\n"}
,{"stream_name":"stdout","time":2711.482221974,"data":"       |     delta = R_T**2 - (1 - O_T[0])**2\n"}
,{"stream_name":"stdout","time":2711.482223187,"data":"       |     if delta \u003c -1e-12:\n"}
,{"stream_name":"stdout","time":2711.48222445,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.482225602,"data":"       |     sqrt_delta = math.sqrt(max(delta, 0.0))\n"}
,{"stream_name":"stdout","time":2711.482226826,"data":"       |     y_T1 = O_T[1] + sqrt_delta\n"}
,{"stream_name":"stdout","time":2711.482228033,"data":"       |     y_T2 = O_T[1] - sqrt_delta\n"}
,{"stream_name":"stdout","time":2711.482229267,"data":"       |     # choose the one not equal to Bpt's y\n"}
,{"stream_name":"stdout","time":2711.482230634,"data":"       |     if abs(y_T1 - Bpt[1]) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":2711.482231862,"data":"       |         T = (1.0, y_T1)\n"}
,{"stream_name":"stdout","time":2711.482233031,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.482234172,"data":"       |         T = (1.0, y_T2)\n"}
,{"stream_name":"stdout","time":2711.482235348,"data":"       |     # lengths\n"}
,{"stream_name":"stdout","time":2711.482236508,"data":"       |     CT = math.hypot(Cpt[0] - T[0], Cpt[1] - T[1])\n"}
,{"stream_name":"stdout","time":2711.482237733,"data":"       |     BT = math.hypot(Bpt[0] - T[0], Bpt[1] - T[1])\n"}
,{"stream_name":"stdout","time":2711.482239209,"data":"       |     NB = math.hypot(Bpt[0] - N[0], Bpt[1] - N[1])\n"}
,{"stream_name":"stdout","time":2711.482240473,"data":"       |     NE = math.hypot(N[0] - E[0], N[1] - E[1])\n"}
,{"stream_name":"stdout","time":2711.482241668,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.482242869,"data":"       |     # check cyclic condition: K,N,K',B concyclic\n"}
,{"stream_name":"stdout","time":2711.482244088,"data":"       |     # compute circumcenter of K,N,B\n"}
,{"stream_name":"stdout","time":2711.482245292,"data":"       |     center_KNB, r_KNB = circumcenter(K, N, Bpt)\n"}
,{"stream_name":"stdout","time":2711.482246533,"data":"       |     # distance from K' to center\n"}
,{"stream_name":"stdout","time":2711.482247723,"data":"       |     if center_KNB is None:\n"}
,{"stream_name":"stdout","time":2711.482248915,"data":"       |         cyclic = False\n"}
,{"stream_name":"stdout","time":2711.482250121,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.48225129,"data":"       |         dist_Kprime = math.hypot(Kprime[0] - center_KNB[0], Kprime[1] - center_KNB[1])\n"}
,{"stream_name":"stdout","time":2711.48225367,"data":"       |         cyclic = abs(dist_Kprime - r_KNB) \u003c 1e-6\n"}
,{"stream_name":"stdout","time":2711.482255035,"data":"       |     return ratio, cyclic, {\n"}
,{"stream_name":"stdout","time":2711.482256274,"data":"       |         'B':B, 'C':C, 'A':Apt, 'K':K, 'Kprime':Kprime, 'N':N, 'T':T,\n"}
,{"stream_name":"stdout","time":2711.482257568,"data":"       |         'Bpt':Bpt, 'Cpt':Cpt, 'E':E, 'F':F\n"}
,{"stream_name":"stdout","time":2711.482258792,"data":"       |     }\n"}
,{"stream_name":"stdout","time":2711.482259989,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.482261146,"data":"       | # test for B=1 rad\n"}
,{"stream_name":"stdout","time":2711.482266146,"data":"       | result = compute_ratio_for_B(1.0)\n"}
,{"stream_name":"stdout","time":2711.482267395,"data":"       | result[:2]\n"}
,{"stream_name":"stdout","time":2711.482268593,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.482269723,"data":"     [Code]:\n"}
,{"stream_name":"stdout","time":2711.482270848,"data":"       | def projection_point_to_line(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.482272085,"data":"       |     # returns foot of perpendicular from P onto line AB\n"}
,{"stream_name":"stdout","time":2711.482273366,"data":"       |     (px,py) = P\n"}
,{"stream_name":"stdout","time":2711.482274567,"data":"       |     (x1,y1) = A\n"}
,{"stream_name":"stdout","time":2711.48227573,"data":"       |     (x2,y2) = B\n"}
,{"stream_name":"stdout","time":2711.48227688,"data":"       |     dx = x2 - x1\n"}
,{"stream_name":"stdout","time":2711.482278053,"data":"       |     dy = y2 - y1\n"}
,{"stream_name":"stdout","time":2711.482279197,"data":"       |     if dx == dy == 0:\n"}
,{"stream_name":"stdout","time":2711.482280354,"data":"       |         return A\n"}
,{"stream_name":"stdout","time":2711.482281545,"data":"       |     t = ((px - x1)*dx + (py - y1)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.48228281,"data":"       |     return (x1 + t*dx, y1 + t*dy)\n"}
,{"stream_name":"stdout","time":2711.482284061,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.482285171,"data":"       | def compute_ratio_for_B(B):\n"}
,{"stream_name":"stdout","time":2711.482286334,"data":"       |     phi = (1+math.sqrt(5))/2\n"}
,{"stream_name":"stdout","time":2711.482287523,"data":"       |     # compute C\n"}
,{"stream_name":"stdout","time":2711.482288665,"data":"       |     C = 2*math.atan(phi*math.tan(B/2))\n"}
,{"stream_name":"stdout","time":2711.482289892,"data":"       |     # points\n"}
,{"stream_name":"stdout","time":2711.482291057,"data":"       |     D = (1.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.482292224,"data":"       |     E = (-math.cos(C), math.sin(C))\n"}
,{"stream_name":"stdout","time":2711.482293446,"data":"       |     F = (-math.cos(B), -math.sin(B))\n"}
,{"stream_name":"stdout","time":2711.482294648,"data":"       |     # B point\n"}
,{"stream_name":"stdout","time":2711.482295824,"data":"       |     yB = (-1 - math.cos(B))/math.sin(B)\n"}
,{"stream_name":"stdout","time":2711.482297044,"data":"       |     Bpt = (1.0, yB)\n"}
,{"stream_name":"stdout","time":2711.482298217,"data":"       |     # C point\n"}
,{"stream_name":"stdout","time":2711.48229937,"data":"       |     yC = (1 + math.cos(C))/math.sin(C)\n"}
,{"stream_name":"stdout","time":2711.482300551,"data":"       |     Cpt = (1.0, yC)\n"}
,{"stream_name":"stdout","time":2711.482301731,"data":"       |     # A point using derived formula\n"}
,{"stream_name":"stdout","time":2711.482302968,"data":"       |     denom = math.sin(B + C)\n"}
,{"stream_name":"stdout","time":2711.482305445,"data":"       |     Ax = -(math.sin(B) + math.sin(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.482306706,"data":"       |     Ay = (math.cos(B) - math.cos(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.482307991,"data":"       |     Apt = (Ax, Ay)\n"}
,{"stream_name":"stdout","time":2711.482309157,"data":"       |     # circumcircle of AEF\n"}
,{"stream_name":"stdout","time":2711.482310717,"data":"       |     center_AEF, r_AEF = circumcenter(Apt, E, F)\n"}
,{"stream_name":"stdout","time":2711.482311922,"data":"       |     # circumcircle of ABC\n"}
,{"stream_name":"stdout","time":2711.482313122,"data":"       |     center_ABC, r_ABC = circumcenter(Apt, Bpt, Cpt)\n"}
,{"stream_name":"stdout","time":2711.482314419,"data":"       |     # intersection of circles\n"}
,{"stream_name":"stdout","time":2711.482315633,"data":"       |     inters = circle_intersections(center_AEF, r_AEF, center_ABC, r_ABC)\n"}
,{"stream_name":"stdout","time":2711.482316904,"data":"       |     # find K (not equal to A)\n"}
,{"stream_name":"stdout","time":2711.4823181,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.482319275,"data":"       |     for pt in inters:\n"}
,{"stream_name":"stdout","time":2711.482320469,"data":"       |         if math.hypot(pt[0]-Apt[0], pt[1]-Apt[1]) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":2711.482321786,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.48232299,"data":"       |             break\n"}
,{"stream_name":"stdout","time":2711.482324197,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.482325351,"data":"       |         # maybe due to numeric error, take first\n"}
,{"stream_name":"stdout","time":2711.482326571,"data":"       |         K = inters[0]\n"}
,{"stream_name":"stdout","time":2711.482327763,"data":"       |     # K'\n"}
,{"stream_name":"stdout","time":2711.482328892,"data":"       |     Kprime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.482330093,"data":"       |     # N: foot from D onto EF\n"}
,{"stream_name":"stdout","time":2711.482331265,"data":"       |     N = projection_point_to_line(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.482332471,"data":"       |     # circle through B and K tangent to BN at B\n"}
,{"stream_name":"stdout","time":2711.482333713,"data":"       |     # line BN direction vector\n"}
,{"stream_name":"stdout","time":2711.482334916,"data":"       |     vBN = (N[0] - Bpt[0], N[1] - Bpt[1])\n"}
,{"stream_name":"stdout","time":2711.482336104,"data":"       |     # perpendicular direction at B\n"}
,{"stream_name":"stdout","time":2711.482337282,"data":"       |     perp_dir = (-vBN[1], vBN[0])\n"}
,{"stream_name":"stdout","time":2711.482338479,"data":"       |     # line through B with direction perp_dir: param B + s*perp_dir\n"}
,{"stream_name":"stdout","time":2711.482339734,"data":"       |     # perpendicular bisector of BK\n"}
,{"stream_name":"stdout","time":2711.482340937,"data":"       |     midBK = ((Bpt[0] + K[0])/2, (Bpt[1] + K[1])/2)\n"}
,{"stream_name":"stdout","time":2711.482342169,"data":"       |     vBK = (K[0] - Bpt[0], K[1] - Bpt[1])\n"}
,{"stream_name":"stdout","time":2711.482343384,"data":"       |     perp_BK = (-vBK[1], vBK[0])\n"}
,{"stream_name":"stdout","time":2711.482344586,"data":"       |     # Solve intersection of two lines: B + s*perp_dir = midBK + t*perp_BK\n"}
,{"stream_name":"stdout","time":2711.482345854,"data":"       |     # Solve for s,t\n"}
,{"stream_name":"stdout","time":2711.482347048,"data":"       |     # B + s*perp_dir = midBK + t*perp_BK\n"}
,{"stream_name":"stdout","time":2711.482349491,"data":"       |     # =\u003e s*perp_dir - t*perp_BK = midBK - B\n"}
,{"stream_name":"stdout","time":2711.482350794,"data":"       |     # Solve linear system 2x2\n"}
,{"stream_name":"stdout","time":2711.48235199,"data":"       |     A_mat = [[perp_dir[0], -perp_BK[0]],\n"}
,{"stream_name":"stdout","time":2711.482353183,"data":"       |              [perp_dir[1], -perp_BK[1]]]\n"}
,{"stream_name":"stdout","time":2711.48235443,"data":"       |     b_vec = [midBK[0] - Bpt[0], midBK[1] - Bpt[1]]\n"}
,{"stream_name":"stdout","time":2711.482355664,"data":"       |     # Solve using determinant\n"}
,{"stream_name":"stdout","time":2711.48235687,"data":"       |     det = A_mat[0][0]*A_mat[1][1] - A_mat[0][1]*A_mat[1][0]\n"}
,{"stream_name":"stdout","time":2711.482358131,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.482359324,"data":"       |         # lines parallel? fallback\n"}
,{"stream_name":"stdout","time":2711.482360568,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.482361769,"data":"       |     s = (b_vec[0]*A_mat[1][1] - b_vec[1]*A_mat[0][1]) / det\n"}
,{"stream_name":"stdout","time":2711.482363055,"data":"       |     # center O_T\n"}
,{"stream_name":"stdout","time":2711.482364313,"data":"       |     O_T = (Bpt[0] + s*perp_dir[0], Bpt[1] + s*perp_dir[1])\n"}
,{"stream_name":"stdout","time":2711.482365795,"data":"       |     R_T = math.hypot(O_T[0] - Bpt[0], O_T[1] - Bpt[1])\n"}
,{"stream_name":"stdout","time":2711.482367108,"data":"       |     # intersect circle with line BC (x=1)\n"}
,{"stream_name":"stdout","time":2711.482368316,"data":"       |     # line BC: x=1, y variable\n"}
,{"stream_name":"stdout","time":2711.482369494,"data":"       |     # circle equation (x - cx)^2 + (y - cy)^2 = R_T^2\n"}
,{"stream_name":"stdout","time":2711.482370743,"data":"       |     # plug x=1 =\u003e (1 - cx)^2 + (y - cy)^2 = R_T^2 =\u003e (y - cy)^2 = R_T^2 - (1 - cx)^2\n"}
,{"stream_name":"stdout","time":2711.482372131,"data":"       |     delta = R_T**2 - (1 - O_T[0])**2\n"}
,{"stream_name":"stdout","time":2711.482373352,"data":"       |     if delta \u003c -1e-12:\n"}
,{"stream_name":"stdout","time":2711.482374612,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.482375777,"data":"       |     sqrt_delta = math.sqrt(max(delta, 0.0))\n"}
,{"stream_name":"stdout","time":2711.482376986,"data":"       |     y_T1 = O_T[1] + sqrt_delta\n"}
,{"stream_name":"stdout","time":2711.482378166,"data":"       |     y_T2 = O_T[1] - sqrt_delta\n"}
,{"stream_name":"stdout","time":2711.482379349,"data":"       |     # choose the one not equal to Bpt's y\n"}
,{"stream_name":"stdout","time":2711.48238055,"data":"       |     if abs(y_T1 - Bpt[1]) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":2711.482381799,"data":"       |         T = (1.0, y_T1)\n"}
,{"stream_name":"stdout","time":2711.482382991,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.482384185,"data":"       |         T = (1.0, y_T2)\n"}
,{"stream_name":"stdout","time":2711.482385375,"data":"       |     # lengths\n"}
,{"stream_name":"stdout","time":2711.482386538,"data":"       |     CT = math.hypot(Cpt[0] - T[0], Cpt[1] - T[1])\n"}
,{"stream_name":"stdout","time":2711.482387755,"data":"       |     BT = math.hypot(Bpt[0] - T[0], Bpt[1] - T[1])\n"}
,{"stream_name":"stdout","time":2711.482388971,"data":"       |     NB = math.hypot(Bpt[0] - N[0], Bpt[1] - N[1])\n"}
,{"stream_name":"stdout","time":2711.482390219,"data":"       |     NE = math.hypot(N[0] - E[0], N[1] - E[1])\n"}
,{"stream_name":"stdout","time":2711.482391413,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.48239408,"data":"       |     # check cyclic condition: K,N,K',B concyclic\n"}
,{"stream_name":"stdout","time":2711.482396019,"data":"       |     # compute circumcenter of K,N,B\n"}
,{"stream_name":"stdout","time":2711.482397226,"data":"       |     center_KNB, r_KNB = circumcenter(K, N, Bpt)\n"}
,{"stream_name":"stdout","time":2711.482398455,"data":"       |     # distance from K' to center\n"}
,{"stream_name":"stdout","time":2711.482399666,"data":"       |     if center_KNB is None:\n"}
,{"stream_name":"stdout","time":2711.482400861,"data":"       |         cyclic = False\n"}
,{"stream_name":"stdout","time":2711.482402061,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.482403251,"data":"       |         dist_Kprime = math.hypot(Kprime[0] - center_KNB[0], Kprime[1] - center_KNB[1])\n"}
,{"stream_name":"stdout","time":2711.482404531,"data":"       |         cyclic = abs(dist_Kprime - r_KNB) \u003c 1e-6\n"}
,{"stream_name":"stdout","time":2711.482405882,"data":"       |     return ratio, cyclic, {\n"}
,{"stream_name":"stdout","time":2711.4824071,"data":"       |         'B':B, 'C':C, 'A':Apt, 'K':K, 'Kprime':Kprime, 'N':N, 'T':T,\n"}
,{"stream_name":"stdout","time":2711.482408367,"data":"       |         'Bpt':Bpt, 'Cpt':Cpt, 'E':E, 'F':F\n"}
,{"stream_name":"stdout","time":2711.482409625,"data":"       |     }\n"}
,{"stream_name":"stdout","time":2711.482410805,"data":"       | \n"}
