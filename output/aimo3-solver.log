,{"stream_name":"stdout","time":3398.368020006,"data":"       | def intersection_point(seg1, seg2):\n"}
,{"stream_name":"stdout","time":3398.368021153,"data":"       |     # returns (x,y) intersection of lines (not just segments)\n"}
,{"stream_name":"stdout","time":3398.368022376,"data":"       |     (i,j) = seg1\n"}
,{"stream_name":"stdout","time":3398.368023506,"data":"       |     (k,l) = seg2\n"}
