,{"stream_name":"stdout","time":3398.366007784,"data":"       | def point_in_polygon_exact(pt, verts):\n"}
,{"stream_name":"stdout","time":3398.366008941,"data":"       |     # Use winding: for convex polygon, check orientation of each edge with point\n"}
,{"stream_name":"stdout","time":3398.366010149,"data":"       |     x,y = pt\n"}
,{"stream_name":"stdout","time":3398.366011239,"data":"       |     # Determine sign of cross product for each edge\n"}
,{"stream_name":"stdout","time":3398.3660124,"data":"       |     sign = None\n"}
,{"stream_name":"stdout","time":3398.366013699,"data":"       |     for i in range(len(verts)):\n"}
,{"stream_name":"stdout","time":3398.366014837,"data":"       |         x1,y1 = verts[i]\n"}
,{"stream_name":"stdout","time":3398.366015954,"data":"       |         x2,y2 = verts[(i+1)%len(verts)]\n"}
,{"stream_name":"stdout","time":3398.366017091,"data":"       |         ex = x2 - x1\n"}
,{"stream_name":"stdout","time":3398.366019624,"data":"       |         ey = y2 - y1\n"}
,{"stream_name":"stdout","time":3398.366020744,"data":"       |         vx = x - x1\n"}
,{"stream_name":"stdout","time":3398.366021846,"data":"       |         vy = y - y1\n"}
,{"stream_name":"stdout","time":3398.366022968,"data":"       |         cross = sp.simplify(ex*vy - ey*vx)\n"}
,{"stream_name":"stdout","time":3398.366024167,"data":"       |         # cross should be \u003e=0 for interior (if polygon ccw)\n"}
,{"stream_name":"stdout","time":3398.366025453,"data":"       |         # Determine sign: cross should be non-negative\n"}
,{"stream_name":"stdout","time":3398.36603044,"data":"       |         # Since we use exact arithmetic, we can evaluate numeric sign using .evalf()\n"}
,{"stream_name":"stdout","time":3398.366031976,"data":"       |         # But we can also substitute numeric approximations.\n"}
,{"stream_name":"stdout","time":3398.366033206,"data":"       |         # We'll convert to float for sign.\n"}
,{"stream_name":"stdout","time":3398.366034351,"data":"       |         cross_f = float(cross.evalf())\n"}
,{"stream_name":"stdout","time":3398.366035473,"data":"       |         if abs(cross_f) \u003c 1e-9:\n"}
,{"stream_name":"stdout","time":3398.366036657,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":3398.366037811,"data":"       |         cur_sign = cross_f \u003e 0\n"}
,{"stream_name":"stdout","time":3398.366038968,"data":"       |         if sign is None:\n"}
,{"stream_name":"stdout","time":3398.366040081,"data":"       |             sign = cur_sign\n"}
,{"stream_name":"stdout","time":3398.366041196,"data":"       |         elif sign != cur_sign:\n"}
,{"stream_name":"stdout","time":3398.366042301,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":3398.366043432,"data":"       |     return True\n"}
