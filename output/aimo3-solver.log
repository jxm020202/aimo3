,{"stream_name":"stdout","time":3398.358323908,"data":"       |     import sympy as sp\n"}
,{"stream_name":"stdout","time":3398.358325057,"data":"       |     # define line equations\n"}
,{"stream_name":"stdout","time":3398.358326243,"data":"       |     def line_eq(ch):\n"}
