,{"stream_name":"stdout","time":2711.472930682,"data":"       |     O_T = (B[0] + u*d1[0], B[1] + u*d1[1])\n"}
,{"stream_name":"stdout","time":2711.472931891,"data":"       |     T = (2*O_T[0], 0.0)\n"}
