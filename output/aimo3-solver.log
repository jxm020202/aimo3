,{"stream_name":"stdout","time":3398.367958327,"data":"       |     # We'll compute using numpy\n"}
,{"stream_name":"stdout","time":3398.367959469,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":3398.367960584,"data":"       |     A = np.array([[x2-x1, -(x4-x3)], [y2-y1, -(y4-y3)]], dtype=float)\n"}
,{"stream_name":"stdout","time":3398.367961771,"data":"       |     b = np.array([x3-x1, y3-y1], dtype=float)\n"}
,{"stream_name":"stdout","time":3398.367962909,"data":"       |     # solve A*[t,u]^T = b\n"}
,{"stream_name":"stdout","time":3398.367964024,"data":"       |     det = np.linalg.det(A)\n"}
,{"stream_name":"stdout","time":3398.367965129,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":3398.367966309,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.367967409,"data":"       |     t,u = np.linalg.solve(A,b)\n"}
