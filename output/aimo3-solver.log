,{"stream_name":"stdout","time":3102.115752846,"data":"       | B = sp.Point(0,0)\n"}
,{"stream_name":"stdout","time":3102.115753962,"data":"       | C = sp.Point(14,0)\n"}
,{"stream_name":"stdout","time":3102.115755128,"data":"       | P = sp.Point(sp.Rational(567,74), sp.Rational(-147,37))\n"}
,{"stream_name":"stdout","time":3102.115756317,"data":"       | \n"}
,{"stream_name":"stdout","time":3102.11575736,"data":"       | # Vectors\n"}
,{"stream_name":"stdout","time":3102.115758504,"data":"       | BP = sp.Matrix([P.x - B.x, P.y - B.y])\n"}
,{"stream_name":"stdout","time":3102.115759665,"data":"       | BQ = sp.Matrix([xQ - B.x, yQ - B.y])\n"}
,{"stream_name":"stdout","time":3102.11576085,"data":"       | CP = sp.Matrix([P.x - C.x, P.y - C.y])\n"}
,{"stream_name":"stdout","time":3102.115762027,"data":"       | CQ = sp.Matrix([xQ - C.x, yQ - C.y])\n"}
,{"stream_name":"stdout","time":3102.115763177,"data":"       | \n"}
,{"stream_name":"stdout","time":3102.115764289,"data":"       | # Cosine equality: (BP·BQ)/(|BP||BQ|) = (CP·CQ)/(|CP||CQ|)\n"}
,{"stream_name":"stdout","time":3102.115765607,"data":"       | cos_eq = sp.Eq((BP.dot(BQ))/ (sp.sqrt(BP.dot(BP))* sp.sqrt(BQ.dot(BQ))),\n"}
