,{"stream_name":"stdout","time":2711.48935319,"data":"       | Let's compute determinant using numpy for given points.\n"}
,{"stream_name":"stdout","time":2711.489354443,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489355583,"data":"       | assistantanalysis to=python codedef cyclic_condition_det(p,q,r):\n"}
,{"stream_name":"stdout","time":2711.489356876,"data":"       |     A,B,C,F,E,N,K,Kprime = compute_points(p,q,r)\n"}
,{"stream_name":"stdout","time":2711.489358123,"data":"       |     # Build matrix\n"}
,{"stream_name":"stdout","time":2711.489359305,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":2711.489360526,"data":"       |     def row(P):\n"}
,{"stream_name":"stdout","time":2711.489361696,"data":"       |         x,y = P\n"}
,{"stream_name":"stdout","time":2711.48936437,"data":"       |         return [x, y, x*x + y*y, 1]\n"}
,{"stream_name":"stdout","time":2711.489365627,"data":"       |     M = np.array([row(B), row(N), row(K), row(Kprime)], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.489366938,"data":"       |     # compute determinant\n"}
,{"stream_name":"stdout","time":2711.489368139,"data":"       |     det = np.linalg.det(M)\n"}
,{"stream_name":"stdout","time":2711.489369345,"data":"       |     return det\n"}
