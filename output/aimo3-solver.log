,{"stream_name":"stdout","time":2711.489541886,"data":"       |     # Circle equation: (x - O_T.x)^2 + (y - O_T.y)^2 = R_T^2\n"}
,{"stream_name":"stdout","time":2711.489543127,"data":"       |     # Set y=0, solve for x\n"}
,{"stream_name":"stdout","time":2711.48954436,"data":"       |     Ox, Oy = O_T\n"}
,{"stream_name":"stdout","time":2711.489545534,"data":"       |     # (x - Ox)^2 + (0 - Oy)^2 = R_T^2 =\u003e (x - Ox)^2 = R_T^2 - Oy^2\n"}
,{"stream_name":"stdout","time":2711.489546872,"data":"       |     # Since R_T^2 = (Ox)^2 + (Oy)^2 (distance from O_T to B (0,0))\n"}
,{"stream_name":"stdout","time":2711.489548119,"data":"       |     # So R_T^2 - Oy^2 = Ox^2\n"}
,{"stream_name":"stdout","time":2711.489549327,"data":"       |     # Then (x - Ox)^2 = Ox^2 =\u003e x - Ox = ± Ox =\u003e x = 0 or x = 2*Ox\n"}
,{"stream_name":"stdout","time":2711.489552602,"data":"       |     # Indeed, the circle passes through B (x=0). The other intersection is x = 2*Ox.\n"}
,{"stream_name":"stdout","time":2711.489553938,"data":"       |     x_T = 2*Ox\n"}
,{"stream_name":"stdout","time":2711.48955513,"data":"       |     T = (x_T, 0.0)\n"}
,{"stream_name":"stdout","time":2711.489556341,"data":"       |     # compute distances\n"}
