,{"stream_name":"stdout","time":2711.486744256,"data":"       | Ax = -(sinB + sinC) / sinBpC\n"}
,{"stream_name":"stdout","time":2711.486745517,"data":"       | Ay = (cosB - cosC) / sinBpC\n"}
,{"stream_name":"stdout","time":2711.486746696,"data":"       | Apt = sp.Point(Ax, Ay)\n"}
,{"stream_name":"stdout","time":2711.486747884,"data":"       | \n"}
