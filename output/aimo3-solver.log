,{"stream_name":"stdout","time":2711.489532388,"data":"       |     # solve for s,t\n"}
,{"stream_name":"stdout","time":2711.489533541,"data":"       |     sol = np.linalg.solve(A_mat, b_vec)\n"}
,{"stream_name":"stdout","time":2711.489534793,"data":"       |     s = sol[0]\n"}
,{"stream_name":"stdout","time":2711.489535969,"data":"       |     # center O_T\n"}
