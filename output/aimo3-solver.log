,{"stream_name":"stdout","time":2711.469613808,"data":"       |     K = (x + sK*ux, y + sK*uy)\n"}
,{"stream_name":"stdout","time":2711.469614994,"data":"       |     return K, X, O, R, I, (x,y)\n"}
