,{"stream_name":"stdout","time":2711.47172722,"data":"       |     # parameter t for projection\n"}
,{"stream_name":"stdout","time":2711.471728419,"data":"       |     t = ((px-ax)*dx + (py-ay)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.471729648,"data":"       |     projx = ax + t*dx\n"}
,{"stream_name":"stdout","time":2711.471730823,"data":"       |     projy = ay + t*dy\n"}
