,{"stream_name":"stdout","time":2937.179585116,"data":"       |         def lcm(a,b):\n"}
,{"stream_name":"stdout","time":2937.179586243,"data":"       |             return a*b//gcd(a,b)\n"}
,{"stream_name":"stdout","time":2937.17958753,"data":"       |         d = n_vals[0]\n"}
