,{"stream_name":"stdout","time":3398.365999987,"data":"       |     det = sp.simplify(a1*b2 - a2*b1)\n"}
,{"stream_name":"stdout","time":3398.366001111,"data":"       |     if det == 0:\n"}
,{"stream_name":"stdout","time":3398.366002204,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.366003306,"data":"       |     x = sp.simplify((b1*c2 - b2*c1)/det)\n"}
,{"stream_name":"stdout","time":3398.366004475,"data":"       |     y = sp.simplify((c1*a2 - c2*a1)/det)\n"}
,{"stream_name":"stdout","time":3398.366005624,"data":"       |     return (x,y)\n"}
