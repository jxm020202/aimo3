,{"stream_name":"stdout","time":2711.485915854,"data":"       |     D = (mp.mpf(1), mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.485917085,"data":"       |     E = (-mp.cos(C), mp.sin(C))\n"}
,{"stream_name":"stdout","time":2711.485918291,"data":"       |     F = (-mp.cos(B), -mp.sin(B))\n"}
,{"stream_name":"stdout","time":2711.485919476,"data":"       |     yB = (-1 - mp.cos(B))/mp.sin(B)\n"}
,{"stream_name":"stdout","time":2711.485920664,"data":"       |     Bpt = (mp.mpf(1), yB)\n"}
,{"stream_name":"stdout","time":2711.485921858,"data":"       |     yC = (1 + mp.cos(C))/mp.sin(C)\n"}
,{"stream_name":"stdout","time":2711.485924911,"data":"       |     Cpt = (mp.mpf(1), yC)\n"}
,{"stream_name":"stdout","time":2711.485926114,"data":"       |     denom = mp.sin(B + C)\n"}
,{"stream_name":"stdout","time":2711.485927298,"data":"       |     Ax = -(mp.sin(B) + mp.sin(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.485928497,"data":"       |     Ay = (mp.cos(B) - mp.cos(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.485929746,"data":"       |     Apt = (Ax, Ay)\n"}
,{"stream_name":"stdout","time":2711.485930944,"data":"       |     # helper functions\n"}
,{"stream_name":"stdout","time":2711.485932114,"data":"       |     def circumcenter_mp(p1, p2, p3):\n"}
,{"stream_name":"stdout","time":2711.485933357,"data":"       |         x1,y1 = p1\n"}
,{"stream_name":"stdout","time":2711.485934572,"data":"       |         x2,y2 = p2\n"}
,{"stream_name":"stdout","time":2711.485935761,"data":"       |         x3,y3 = p3\n"}
,{"stream_name":"stdout","time":2711.485936951,"data":"       |         d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.485938192,"data":"       |         if mp.almosteq(d, 0):\n"}
,{"stream_name":"stdout","time":2711.485939392,"data":"       |             return None\n"}
,{"stream_name":"stdout","time":2711.485940596,"data":"       |         ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2)) / d\n"}
,{"stream_name":"stdout","time":2711.485941969,"data":"       |         uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1)) / d\n"}
,{"stream_name":"stdout","time":2711.485943298,"data":"       |         r = mp.sqrt((ux - x1)**2 + (uy - y1)**2)\n"}
,{"stream_name":"stdout","time":2711.485944721,"data":"       |         return (ux, uy), r\n"}
,{"stream_name":"stdout","time":2711.485945938,"data":"       |     center_AEF = circumcenter_mp(Apt, E, F)\n"}
,{"stream_name":"stdout","time":2711.485947146,"data":"       |     center_ABC = circumcenter_mp(Apt, Bpt, Cpt)\n"}
,{"stream_name":"stdout","time":2711.485948365,"data":"       |     if center_AEF is None or center_ABC is None:\n"}
,{"stream_name":"stdout","time":2711.485949579,"data":"       |         return mp.mpf('nan')\n"}
,{"stream_name":"stdout","time":2711.485950781,"data":"       |     (c1, r1) = center_AEF\n"}
,{"stream_name":"stdout","time":2711.485951954,"data":"       |     (c2, r2) = center_ABC\n"}
,{"stream_name":"stdout","time":2711.48595317,"data":"       |     # intersect circles\n"}
,{"stream_name":"stdout","time":2711.485954361,"data":"       |     def circle_intersections_mp(c1, r1, c2, r2):\n"}
,{"stream_name":"stdout","time":2711.485955806,"data":"       |         x0,y0 = c1\n"}
,{"stream_name":"stdout","time":2711.485956999,"data":"       |         x1,y1 = c2\n"}
,{"stream_name":"stdout","time":2711.485958167,"data":"       |         dx = x1 - x0\n"}
,{"stream_name":"stdout","time":2711.485959377,"data":"       |         dy = y1 - y0\n"}
,{"stream_name":"stdout","time":2711.485960567,"data":"       |         d = mp.sqrt(dx**2 + dy**2)\n"}
,{"stream_name":"stdout","time":2711.485961765,"data":"       |         if d \u003e r1 + r2 or d \u003c abs(r1 - r2):\n"}
,{"stream_name":"stdout","time":2711.485963041,"data":"       |             return []\n"}
,{"stream_name":"stdout","time":2711.485964226,"data":"       |         a = (r1**2 - r2**2 + d**2) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.485965466,"data":"       |         h_sq = r1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.485966708,"data":"       |         h = mp.sqrt(max(h_sq, 0))\n"}
,{"stream_name":"stdout","time":2711.485967894,"data":"       |         xm = x0 + a*dx/d\n"}
,{"stream_name":"stdout","time":2711.485970304,"data":"       |         ym = y0 + a*dy/d\n"}
,{"stream_name":"stdout","time":2711.485971507,"data":"       |         rx = -dy * (h/d)\n"}
,{"stream_name":"stdout","time":2711.485972712,"data":"       |         ry = dx * (h/d)\n"}
,{"stream_name":"stdout","time":2711.485973882,"data":"       |         p1 = (xm + rx, ym + ry)\n"}
,{"stream_name":"stdout","time":2711.485975111,"data":"       |         p2 = (xm - rx, ym - ry)\n"}
,{"stream_name":"stdout","time":2711.485976308,"data":"       |         if h \u003c mp.mpf('1e-30'):\n"}
,{"stream_name":"stdout","time":2711.485977532,"data":"       |             return [p1]\n"}
,{"stream_name":"stdout","time":2711.485978718,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":2711.485979873,"data":"       |             return [p1, p2]\n"}
,{"stream_name":"stdout","time":2711.485981076,"data":"       |     inters = circle_intersections_mp(c1, r1, c2, r2)\n"}
,{"stream_name":"stdout","time":2711.485982314,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.485983483,"data":"       |     for pt in inters:\n"}
,{"stream_name":"stdout","time":2711.485984715,"data":"       |         if mp.hypot(pt[0]-Apt[0], pt[1]-Apt[1]) \u003e mp.mpf('1e-30'):\n"}
,{"stream_name":"stdout","time":2711.485986074,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.485987218,"data":"       |             break\n"}
,{"stream_name":"stdout","time":2711.485988365,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.485989528,"data":"       |         K = inters[0]\n"}
,{"stream_name":"stdout","time":2711.485990696,"data":"       |     # reflect K across EF\n"}
,{"stream_name":"stdout","time":2711.485991896,"data":"       |     def reflect_point_across_line_mp(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.485993142,"data":"       |         dx = B[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.48599437,"data":"       |         dy = B[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.48599559,"data":"       |         t = ((P[0] - A[0])*dx + (P[1] - A[1])*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.485996843,"data":"       |         proj = (A[0] + t*dx, A[1] + t*dy)\n"}
,{"stream_name":"stdout","time":2711.485998045,"data":"       |         return (2*proj[0] - P[0], 2*proj[1] - P[1])\n"}
,{"stream_name":"stdout","time":2711.485999303,"data":"       |     Kprime = reflect_point_across_line_mp(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.486000527,"data":"       |     # N foot from D onto EF\n"}
,{"stream_name":"stdout","time":2711.486001709,"data":"       |     def projection_point_to_line_mp(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.486002932,"data":"       |         px, py = P\n"}
,{"stream_name":"stdout","time":2711.486004141,"data":"       |         x1, y1 = A\n"}
,{"stream_name":"stdout","time":2711.486005334,"data":"       |         x2, y2 = B\n"}
,{"stream_name":"stdout","time":2711.48600652,"data":"       |         dx = x2 - x1\n"}
,{"stream_name":"stdout","time":2711.486007696,"data":"       |         dy = y2 - y1\n"}
,{"stream_name":"stdout","time":2711.486008871,"data":"       |         if mp.almosteq(dx, 0) and mp.almosteq(dy, 0):\n"}
,{"stream_name":"stdout","time":2711.486010112,"data":"       |             return A\n"}
,{"stream_name":"stdout","time":2711.486011321,"data":"       |         t = ((px - x1)*dx + (py - y1)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.486012581,"data":"       |         return (x1 + t*dx, y1 + t*dy)\n"}
,{"stream_name":"stdout","time":2711.486013794,"data":"       |     N = projection_point_to_line_mp(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.486016416,"data":"       |     # determinant for cyclic condition\n"}
,{"stream_name":"stdout","time":2711.486017652,"data":"       |     def det4(P1,P2,P3,P4):\n"}
,{"stream_name":"stdout","time":2711.486019153,"data":"       |         M = mp.matrix([[P1[0], P1[1], P1[0]**2 + P1[1]**2, 1],\n"}
,{"stream_name":"stdout","time":2711.48602044,"data":"       |                        [P2[0], P2[1], P2[0]**2 + P2[1]**2, 1],\n"}
,{"stream_name":"stdout","time":2711.486021723,"data":"       |                        [P3[0], P3[1], P3[0]**2 + P3[1]**2, 1],\n"}
,{"stream_name":"stdout","time":2711.486023026,"data":"       |                        [P4[0], P4[1], P4[0]**2 + P4[1]**2, 1]])\n"}
,{"stream_name":"stdout","time":2711.486024321,"data":"       |         return mp.det(M)\n"}
,{"stream_name":"stdout","time":2711.486025532,"data":"       |     return det4(K, N, Kprime, Bpt)\n"}
,{"stream_name":"stdout","time":2711.486026745,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486027868,"data":"       | # find small root using bracket and bisection\n"}
,{"stream_name":"stdout","time":2711.48602911,"data":"       | def find_small_root():\n"}
,{"stream_name":"stdout","time":2711.486030281,"data":"       |     a = mp.mpf('1e-6')\n"}
,{"stream_name":"stdout","time":2711.486031475,"data":"       |     b = mp.mpf('0.01')\n"}
,{"stream_name":"stdout","time":2711.486032683,"data":"       |     fa = cyclic_error_mp(a)\n"}
,{"stream_name":"stdout","time":2711.486033851,"data":"       |     fb = cyclic_error_mp(b)\n"}
,{"stream_name":"stdout","time":2711.486035081,"data":"       |     # ensure signs opposite\n"}
,{"stream_name":"stdout","time":2711.48603627,"data":"       |     # we need to find interval where sign changes\n"}
,{"stream_name":"stdout","time":2711.486037517,"data":"       |     # Let's sample\n"}
,{"stream_name":"stdout","time":2711.486038663,"data":"       |     for i in range(1, 1000):\n"}
,{"stream_name":"stdout","time":2711.486039842,"data":"       |         x = a + (b-a)*i/1000\n"}
,{"stream_name":"stdout","time":2711.486041051,"data":"       |         fx = cyclic_error_mp(x)\n"}
,{"stream_name":"stdout","time":2711.486042261,"data":"       |         if fa*fx \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.486043445,"data":"       |             # root between a and x\n"}
,{"stream_name":"stdout","time":2711.486044732,"data":"       |             return mp.findroot(cyclic_error_mp, (a, x))\n"}
,{"stream_name":"stdout","time":2711.486045974,"data":"       |         fa = fx\n"}
,{"stream_name":"stdout","time":2711.486047174,"data":"       |     return None\n"}
,{"stream_name":"stdout","time":2711.486048369,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486049529,"data":"       | root_small = mp.findroot(cyclic_error_mp, 0.001)\n"}
,{"stream_name":"stdout","time":2711.486050776,"data":"       | print(root_small)\n"}
,{"stream_name":"stdout","time":2711.486051944,"data":"       | \n"}
