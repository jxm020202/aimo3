,{"stream_name":"stdout","time":3398.367986461,"data":"       |     # check rectangle: vectors p2-p1 and p4-p1 should be perpendicular and lengths correspond\n"}
,{"stream_name":"stdout","time":3398.367987723,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":3398.367988813,"data":"       |     v1 = np.array(p2) - np.array(p1)\n"}
