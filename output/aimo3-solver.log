,{"stream_name":"stdout","time":2711.495160444,"data":"       |     normEF = mp.sqrt(vEFx**2 + vEFy**2)\n"}
,{"stream_name":"stdout","time":2711.495161643,"data":"       |     uxEF = vEFx / normEF\n"}
