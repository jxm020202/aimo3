,{"stream_name":"stdout","time":2711.478690144,"data":"       |     mC = -2*(a-d)*r / ((a-d)**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.478691377,"data":"       |     # intersection A\n"}
