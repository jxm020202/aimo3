,{"stream_name":"stdout","time":2711.469571781,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.46957294,"data":"       | def compute_K_numeric():\n"}
,{"stream_name":"stdout","time":2711.469574113,"data":"       |     # numeric values from earlier\n"}
,{"stream_name":"stdout","time":2711.4695753,"data":"       |     sqrt5 = mp.sqrt(5)\n"}
,{"stream_name":"stdout","time":2711.46957645,"data":"       |     d = (3 - sqrt5)/2\n"}
,{"stream_name":"stdout","time":2711.469577628,"data":"       |     c_len = sqrt5 - 1\n"}
,{"stream_name":"stdout","time":2711.469578837,"data":"       |     b_len = sqrt5 - 1.5\n"}
,{"stream_name":"stdout","time":2711.469579997,"data":"       |     # coordinates\n"}
,{"stream_name":"stdout","time":2711.469581163,"data":"       |     x = -1/8 + sqrt5/2\n"}
,{"stream_name":"stdout","time":2711.469582388,"data":"       |     y = mp.sqrt(303/64 - 15*sqrt5/8)\n"}
,{"stream_name":"stdout","time":2711.469584568,"data":"       |     # incircle center\n"}
,{"stream_name":"stdout","time":2711.469585796,"data":"       |     s = (1 + b_len + c_len)/2\n"}
,{"stream_name":"stdout","time":2711.46958699,"data":"       |     area = y/2\n"}
,{"stream_name":"stdout","time":2711.469588137,"data":"       |     r = area / s\n"}
,{"stream_name":"stdout","time":2711.469589295,"data":"       |     I = (d, r)\n"}
,{"stream_name":"stdout","time":2711.469590481,"data":"       |     # circumcenter O\n"}
,{"stream_name":"stdout","time":2711.469591703,"data":"       |     O = (0.5, (x**2 + y**2 - x)/(2*y))\n"}
,{"stream_name":"stdout","time":2711.46959293,"data":"       |     R = mp.sqrt((O[0])**2 + (O[1])**2)\n"}
,{"stream_name":"stdout","time":2711.46959416,"data":"       |     # exsimilicenter X external\n"}
,{"stream_name":"stdout","time":2711.469595386,"data":"       |     X = ((R*I[0] - r*O[0])/(R - r), (R*I[1] - r*O[1])/(R - r))\n"}
,{"stream_name":"stdout","time":2711.469596628,"data":"       |     # line AX param\n"}
,{"stream_name":"stdout","time":2711.469598118,"data":"       |     ux = X[0] - x\n"}
,{"stream_name":"stdout","time":2711.469599295,"data":"       |     uy = X[1] - y\n"}
,{"stream_name":"stdout","time":2711.469600517,"data":"       |     # Solve (x + s*ux - O.x)^2 + (y + s*uy - O.y)^2 = R^2\n"}
,{"stream_name":"stdout","time":2711.469601751,"data":"       |     Ax = x - O[0]\n"}
,{"stream_name":"stdout","time":2711.469602961,"data":"       |     Ay = y - O[1]\n"}
,{"stream_name":"stdout","time":2711.46960418,"data":"       |     a_coef = ux**2 + uy**2\n"}
,{"stream_name":"stdout","time":2711.469605381,"data":"       |     b_coef = 2*(Ax*ux + Ay*uy)\n"}
,{"stream_name":"stdout","time":2711.469606578,"data":"       |     c_coef = Ax**2 + Ay**2 - R**2\n"}
,{"stream_name":"stdout","time":2711.469607775,"data":"       |     disc = b_coef**2 - 4*a_coef*c_coef\n"}
,{"stream_name":"stdout","time":2711.469608984,"data":"       |     sqrt_disc = mp.sqrt(disc)\n"}
,{"stream_name":"stdout","time":2711.469610177,"data":"       |     s1 = (-b_coef + sqrt_disc) / (2*a_coef)\n"}
,{"stream_name":"stdout","time":2711.46961137,"data":"       |     s2 = (-b_coef - sqrt_disc) / (2*a_coef)\n"}
