,{"stream_name":"stdout","time":2711.46864301,"data":"       |     e = float(sp.fibonacci(n+1))\n"}
,{"stream_name":"stdout","time":2711.468644235,"data":"       |     Delta = float(sp.fibonacci(n-1))\n"}
,{"stream_name":"stdout","time":2711.468645497,"data":"       |     L = d + e\n"}
,{"stream_name":"stdout","time":2711.468646673,"data":"       |     c = d + 0.5 * Delta\n"}
,{"stream_name":"stdout","time":2711.468647828,"data":"       |     x = (L**2 - 2*c*Delta - Delta**2) / (2*L)\n"}
,{"stream_name":"stdout","time":2711.468649024,"data":"       |     y = mp.sqrt(c**2 - x**2)\n"}
,{"stream_name":"stdout","time":2711.468650238,"data":"       |     s = c + d + Delta\n"}
,{"stream_name":"stdout","time":2711.468651437,"data":"       |     area = 0.5 * L * y\n"}
,{"stream_name":"stdout","time":2711.46865264,"data":"       |     r = area / s\n"}
,{"stream_name":"stdout","time":2711.468653793,"data":"       |     I = (d, r)\n"}
,{"stream_name":"stdout","time":2711.468655001,"data":"       |     tF = (I[0]*x + I[1]*y) / (c**2)\n"}
,{"stream_name":"stdout","time":2711.4686562,"data":"       |     F = (tF * x, tF * y)\n"}
,{"stream_name":"stdout","time":2711.46865739,"data":"       |     vAC = (x - L, y)\n"}
,{"stream_name":"stdout","time":2711.46865856,"data":"       |     w = (d - L, r)\n"}
,{"stream_name":"stdout","time":2711.468659723,"data":"       |     tE = (w[0]*vAC[0] + w[1]*vAC[1]) / ((c+Delta)**2)\n"}
,{"stream_name":"stdout","time":2711.46866098,"data":"       |     E = (L + tE * (x - L), tE * y)\n"}
,{"stream_name":"stdout","time":2711.468662179,"data":"       |     O = (L/2.0, (x**2 + y**2 - x*L) / (2*y))\n"}
,{"stream_name":"stdout","time":2711.468663778,"data":"       |     R = mp.sqrt(O[0]**2 + O[1]**2)\n"}
,{"stream_name":"stdout","time":2711.468665025,"data":"       |     X = ((R*I[0] - r*O[0])/(R - r), (R*I[1] - r*O[1])/(R - r))\n"}
,{"stream_name":"stdout","time":2711.468666308,"data":"       |     u = (X[0] - x, X[1] - y)\n"}
,{"stream_name":"stdout","time":2711.468667518,"data":"       |     Ax = x - O[0]\n"}
,{"stream_name":"stdout","time":2711.468668684,"data":"       |     Ay = y - O[1]\n"}
,{"stream_name":"stdout","time":2711.468669852,"data":"       |     a_coef = u[0]**2 + u[1]**2\n"}
,{"stream_name":"stdout","time":2711.468671035,"data":"       |     b_coef = 2*(Ax*u[0] + Ay*u[1])\n"}
,{"stream_name":"stdout","time":2711.468672246,"data":"       |     c_coef = Ax**2 + Ay**2 - R**2\n"}
,{"stream_name":"stdout","time":2711.468673426,"data":"       |     disc = b_coef**2 - 4*a_coef*c_coef\n"}
,{"stream_name":"stdout","time":2711.468674656,"data":"       |     sqrt_disc = mp.sqrt(disc)\n"}
,{"stream_name":"stdout","time":2711.468675841,"data":"       |     s1 = (-b_coef + sqrt_disc) / (2*a_coef)\n"}
,{"stream_name":"stdout","time":2711.468677047,"data":"       |     s2 = (-b_coef - sqrt_disc) / (2*a_coef)\n"}
,{"stream_name":"stdout","time":2711.468678256,"data":"       |     sK = s1 if abs(s1) \u003e 1e-12 else s2\n"}
,{"stream_name":"stdout","time":2711.468679488,"data":"       |     K = (x + sK*u[0], y + sK*u[1])\n"}
,{"stream_name":"stdout","time":2711.468680699,"data":"       |     # reflect K across EF\n"}
,{"stream_name":"stdout","time":2711.468681864,"data":"       |     v = (F[0] - E[0], F[1] - E[1])\n"}
,{"stream_name":"stdout","time":2711.468683041,"data":"       |     KE = (K[0] - E[0], K[1] - E[1])\n"}
,{"stream_name":"stdout","time":2711.468684263,"data":"       |     dot_KE_v = KE[0]*v[0] + KE[1]*v[1]\n"}
,{"stream_name":"stdout","time":2711.46868641,"data":"       |     dot_v = v[0]**2 + v[1]**2\n"}
,{"stream_name":"stdout","time":2711.46868763,"data":"       |     proj = dot_KE_v / dot_v\n"}
,{"stream_name":"stdout","time":2711.468688808,"data":"       |     foot = (E[0] + proj*v[0], E[1] + proj*v[1])\n"}
,{"stream_name":"stdout","time":2711.468690021,"data":"       |     Kprime = (2*foot[0] - K[0], 2*foot[1] - K[1])\n"}
,{"stream_name":"stdout","time":2711.468691255,"data":"       |     return K, Kprime\n"}
