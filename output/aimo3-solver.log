,{"stream_name":"stdout","time":2711.471871558,"data":"     [Code]:\n"}
,{"stream_name":"stdout","time":2711.471872723,"data":"       | def foot_of_perpendicular(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.47187392,"data":"       |     # return projection of P onto line AB\n"}
,{"stream_name":"stdout","time":2711.471875149,"data":"       |     ax, ay = A\n"}
,{"stream_name":"stdout","time":2711.471876329,"data":"       |     bx, by = B\n"}
,{"stream_name":"stdout","time":2711.471877499,"data":"       |     px, py = P\n"}
,{"stream_name":"stdout","time":2711.471878656,"data":"       |     dx = bx - ax\n"}
,{"stream_name":"stdout","time":2711.471879815,"data":"       |     dy = by - ay\n"}
,{"stream_name":"stdout","time":2711.471882216,"data":"       |     # parameter t for projection\n"}
,{"stream_name":"stdout","time":2711.47188348,"data":"       |     t = ((px-ax)*dx + (py-ay)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.471884723,"data":"       |     projx = ax + t*dx\n"}
,{"stream_name":"stdout","time":2711.471885904,"data":"       |     projy = ay + t*dy\n"}
,{"stream_name":"stdout","time":2711.471887094,"data":"       |     return (projx, projy)\n"}
,{"stream_name":"stdout","time":2711.471888296,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.471889431,"data":"       | def compute_ratio_numeric(c0, d0, r):\n"}
,{"stream_name":"stdout","time":2711.471890705,"data":"       |     # compute ratio and condition value for given r\n"}
,{"stream_name":"stdout","time":2711.471891952,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.471893187,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.471894356,"data":"       |     C = (a, 0.0)\n"}
,{"stream_name":"stdout","time":2711.471895527,"data":"       |     I = (c0, r)\n"}
,{"stream_name":"stdout","time":2711.471896684,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.471897851,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471899094,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471900307,"data":"       |     F = (x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.471901479,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.471902639,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471903862,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471905062,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.47190625,"data":"       |     # A = intersection of lines BF and CE\n"}
,{"stream_name":"stdout","time":2711.471907445,"data":"       |     # line BF: B + t*F\n"}
,{"stream_name":"stdout","time":2711.471908645,"data":"       |     # line CE: C + s*(E - C)\n"}
,{"stream_name":"stdout","time":2711.471909858,"data":"       |     # Solve for t,s: t*F = C + s*(E - C)\n"}
,{"stream_name":"stdout","time":2711.47191108,"data":"       |     # Write as 2 equations\n"}
,{"stream_name":"stdout","time":2711.471912309,"data":"       |     # Use linear solve\n"}
,{"stream_name":"stdout","time":2711.47191348,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":2711.471914651,"data":"       |     # matrix for unknowns t,s\n"}
,{"stream_name":"stdout","time":2711.471915854,"data":"       |     # t*F_x = a + s*(E_x - a)\n"}
,{"stream_name":"stdout","time":2711.471917051,"data":"       |     # t*F_y = s*(E_y - 0)  (since C_y=0)\n"}
,{"stream_name":"stdout","time":2711.471918294,"data":"       |     # Solve\n"}
,{"stream_name":"stdout","time":2711.471919481,"data":"       |     # from second: t = s * (E_y) / F_y  (if F_y != 0)\n"}
,{"stream_name":"stdout","time":2711.471920719,"data":"       |     if abs(F[1]) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.471921974,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.471923142,"data":"       |     # compute s from first equation using t expression\n"}
,{"stream_name":"stdout","time":2711.471924378,"data":"       |     # t*F_x = a + s*(E_x - a)\n"}
,{"stream_name":"stdout","time":2711.471925591,"data":"       |     # substitute t\n"}
,{"stream_name":"stdout","time":2711.471926771,"data":"       |     # s * (E_y/F_y) * F_x = a + s*(E_x - a)\n"}
,{"stream_name":"stdout","time":2711.471929202,"data":"       |     # s * (E_y*F_x / F_y) - s*(E_x - a) = a\n"}
,{"stream_name":"stdout","time":2711.471930438,"data":"       |     # s * (E_y*F_x / F_y - (E_x - a)) = a\n"}
,{"stream_name":"stdout","time":2711.471931675,"data":"       |     denom = (E[1]*F[0]/F[1] - (E[0] - a))\n"}
,{"stream_name":"stdout","time":2711.471933162,"data":"       |     if abs(denom) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.471934396,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.471935618,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.471936778,"data":"       |     t = s * (E[1] / F[1])\n"}
,{"stream_name":"stdout","time":2711.471937975,"data":"       |     A = (t*F[0], t*F[1])\n"}
,{"stream_name":"stdout","time":2711.471939201,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.471940351,"data":"       |     O_ABC = circumcenter(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.471941547,"data":"       |     R_ABC = math.hypot(O_ABC[0]-A[0], O_ABC[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.471942805,"data":"       |     O_AEF = circumcenter(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.471944034,"data":"       |     R_AEF = math.hypot(O_AEF[0]-A[0], O_AEF[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.47194528,"data":"       |     # intersection of circles (A, O_ABC,R_ABC) and (O_AEF,R_AEF)\n"}
,{"stream_name":"stdout","time":2711.471946562,"data":"       |     pts = intersect_circles(O_ABC, R_ABC, O_AEF, R_AEF)\n"}
,{"stream_name":"stdout","time":2711.471947785,"data":"       |     # choose K not equal to A (within tolerance)\n"}
,{"stream_name":"stdout","time":2711.471949059,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.471950227,"data":"       |     for pt in pts:\n"}
,{"stream_name":"stdout","time":2711.471951389,"data":"       |         if math.hypot(pt[0]-A[0], pt[1]-A[1]) \u003e 1e-6:\n"}
,{"stream_name":"stdout","time":2711.471952726,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.471953934,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.471955085,"data":"       |         # maybe due to numeric issues\n"}
,{"stream_name":"stdout","time":2711.471956314,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.47195746,"data":"       |     # K' reflection across line EF\n"}
,{"stream_name":"stdout","time":2711.471958677,"data":"       |     K_prime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.471959905,"data":"       |     # N foot from D to EF\n"}
,{"stream_name":"stdout","time":2711.471961127,"data":"       |     D = (c0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.471962311,"data":"       |     N = foot_of_perpendicular(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.471963511,"data":"       |     # condition: B,N,K,K' cyclic\n"}
,{"stream_name":"stdout","time":2711.471964696,"data":"       |     O_BKKp = circumcenter(B, K, K_prime)\n"}
,{"stream_name":"stdout","time":2711.471965923,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471967196,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
,{"stream_name":"stdout","time":2711.47196846,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.471969682,"data":"       |     # line BN vector\n"}
,{"stream_name":"stdout","time":2711.471971758,"data":"       |     BN_vec = (N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471973049,"data":"       |     # line perpendicular to BN through B: direction = rotate BN by 90 degrees\n"}
,{"stream_name":"stdout","time":2711.471976378,"data":"       |     # direction d1 = (-BN_y, BN_x)\n"}
,{"stream_name":"stdout","time":2711.471977613,"data":"       |     d1 = (-BN_vec[1], BN_vec[0])\n"}
,{"stream_name":"stdout","time":2711.471978813,"data":"       |     # line L1: B + u * d1\n"}
,{"stream_name":"stdout","time":2711.471980022,"data":"       |     # perpendicular bisector of BK: midpoint M, direction perpendicular to BK\n"}
,{"stream_name":"stdout","time":2711.471981429,"data":"       |     M = ((B[0]+K[0])/2.0, (B[1]+K[1])/2.0)\n"}
,{"stream_name":"stdout","time":2711.471982616,"data":"       |     BK_vec = (K[0]-B[0], K[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471983821,"data":"       |     # direction d2 = (-BK_y, BK_x)\n"}
,{"stream_name":"stdout","time":2711.471985038,"data":"       |     d2 = (-BK_vec[1], BK_vec[0])\n"}
,{"stream_name":"stdout","time":2711.47198624,"data":"       |     # Solve for intersection O_T of lines: B + u*d1 = M + v*d2\n"}
,{"stream_name":"stdout","time":2711.471987485,"data":"       |     # Solve 2 equations for u,v\n"}
,{"stream_name":"stdout","time":2711.471988687,"data":"       |     # B + u*d1 = M + v*d2\n"}
,{"stream_name":"stdout","time":2711.471989894,"data":"       |     # =\u003e u*d1 - v*d2 = M - B\n"}
,{"stream_name":"stdout","time":2711.471991442,"data":"       |     # Represent as matrix [[d1x, -d2x],[d1y, -d2y]] * [u, v]^T = M - B\n"}
,{"stream_name":"stdout","time":2711.471992743,"data":"       |     A_mat = [[d1[0], -d2[0]], [d1[1], -d2[1]]]\n"}
,{"stream_name":"stdout","time":2711.471993952,"data":"       |     rhs = (M[0]-B[0], M[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471995173,"data":"       |     # solve linear system\n"}
,{"stream_name":"stdout","time":2711.471996376,"data":"       |     det = A_mat[0][0]*A_mat[1][1] - A_mat[0][1]*A_mat[1][0]\n"}
,{"stream_name":"stdout","time":2711.47199762,"data":"       |     if abs(det) \u003c 1e-12:\n"}
