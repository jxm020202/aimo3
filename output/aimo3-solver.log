,{"stream_name":"stdout","time":3398.366169706,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.366170794,"data":"       | rect_set = set()\n"}
,{"stream_name":"stdout","time":3398.366171902,"data":"       | for d in range(6):\n"}
,{"stream_name":"stdout","time":3398.366173009,"data":"       |     d_perp = d+6\n"}
