,{"stream_name":"stdout","time":3398.366182143,"data":"       |             M2 = lines_perp[M2_idx]\n"}
,{"stream_name":"stdout","time":3398.366184036,"data":"       |             p11 = intersect_exact(L1, M1)\n"}
