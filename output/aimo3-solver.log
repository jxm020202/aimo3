,{"stream_name":"stdout","time":2711.475695554,"data":"       | def find_root_near(c0, d0, r_guess):\n"}
,{"stream_name":"stdout","time":2711.475696782,"data":"       |     # Use bisection around r_guess; find interval where cond changes sign\n"}
,{"stream_name":"stdout","time":2711.475698076,"data":"       |     # Search left and right multiplicative factors\n"}
,{"stream_name":"stdout","time":2711.475699319,"data":"       |     factor = 0.5\n"}
,{"stream_name":"stdout","time":2711.475700496,"data":"       |     lo = r_guess * factor\n"}
,{"stream_name":"stdout","time":2711.475701695,"data":"       |     hi = r_guess / factor\n"}
,{"stream_name":"stdout","time":2711.475702914,"data":"       |     # ensure cond defined at ends\n"}
,{"stream_name":"stdout","time":2711.475704128,"data":"       |     cond_lo = cond_value(c0, d0, lo)\n"}
,{"stream_name":"stdout","time":2711.475705339,"data":"       |     cond_hi = cond_value(c0, d0, hi)\n"}
,{"stream_name":"stdout","time":2711.47570832,"data":"       |     # Expand interval until sign change\n"}
,{"stream_name":"stdout","time":2711.475709617,"data":"       |     for _ in range(50):\n"}
,{"stream_name":"stdout","time":2711.475711071,"data":"       |         if cond_lo is None:\n"}
,{"stream_name":"stdout","time":2711.475712285,"data":"       |             lo *= 0.5\n"}
,{"stream_name":"stdout","time":2711.475713449,"data":"       |             cond_lo = cond_value(c0, d0, lo)\n"}
,{"stream_name":"stdout","time":2711.47571466,"data":"       |         if cond_hi is None:\n"}
,{"stream_name":"stdout","time":2711.475715876,"data":"       |             hi *= 2\n"}
,{"stream_name":"stdout","time":2711.475717009,"data":"       |             cond_hi = cond_value(c0, d0, hi)\n"}
,{"stream_name":"stdout","time":2711.475718232,"data":"       |         if cond_lo is not None and cond_hi is not None and cond_lo*cond_hi \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.475719597,"data":"       |             break\n"}
,{"stream_name":"stdout","time":2711.475720762,"data":"       |         # expand\n"}
,{"stream_name":"stdout","time":2711.475721949,"data":"       |         lo *= 0.5\n"}
,{"stream_name":"stdout","time":2711.475723107,"data":"       |         hi *= 2\n"}
,{"stream_name":"stdout","time":2711.475724272,"data":"       |         cond_lo = cond_value(c0, d0, lo)\n"}
,{"stream_name":"stdout","time":2711.47572546,"data":"       |         cond_hi = cond_value(c0, d0, hi)\n"}
,{"stream_name":"stdout","time":2711.475726671,"data":"       |     if cond_lo is None or cond_hi is None or cond_lo*cond_hi \u003e 0:\n"}
,{"stream_name":"stdout","time":2711.475728058,"data":"       |         return None\n"}
