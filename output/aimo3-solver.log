,{"stream_name":"stdout","time":2711.484401614,"data":"       |     E = (-mp.cos(C), mp.sin(C))\n"}
,{"stream_name":"stdout","time":2711.484402814,"data":"       |     F = (-mp.cos(B), -mp.sin(B))\n"}
,{"stream_name":"stdout","time":2711.484404001,"data":"       |     yB = (-1 - mp.cos(B))/mp.sin(B)\n"}
,{"stream_name":"stdout","time":2711.484405196,"data":"       |     Bpt = (mp.mpf(1), yB)\n"}
,{"stream_name":"stdout","time":2711.484406383,"data":"       |     yC = (1 + mp.cos(C))/mp.sin(C)\n"}
,{"stream_name":"stdout","time":2711.484407583,"data":"       |     Cpt = (mp.mpf(1), yC)\n"}
,{"stream_name":"stdout","time":2711.484408766,"data":"       |     denom = mp.sin(B + C)\n"}
,{"stream_name":"stdout","time":2711.484409979,"data":"       |     Ax = -(mp.sin(B) + mp.sin(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.484411219,"data":"       |     Ay = (mp.cos(B) - mp.cos(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.484412441,"data":"       |     Apt = (Ax, Ay)\n"}
,{"stream_name":"stdout","time":2711.484413627,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.484414793,"data":"       |     def circumcenter_mp(p1, p2, p3):\n"}
,{"stream_name":"stdout","time":2711.484416034,"data":"       |         x1,y1 = p1\n"}
,{"stream_name":"stdout","time":2711.484418413,"data":"       |         x2,y2 = p2\n"}
,{"stream_name":"stdout","time":2711.484419611,"data":"       |         x3,y3 = p3\n"}
,{"stream_name":"stdout","time":2711.484420811,"data":"       |         d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.484422079,"data":"       |         if mp.almosteq(d, 0):\n"}
,{"stream_name":"stdout","time":2711.48442329,"data":"       |             return None\n"}
,{"stream_name":"stdout","time":2711.484424506,"data":"       |         ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2)) / d\n"}
,{"stream_name":"stdout","time":2711.484425849,"data":"       |         uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1)) / d\n"}
,{"stream_name":"stdout","time":2711.484427423,"data":"       |         r = mp.sqrt((ux - x1)**2 + (uy - y1)**2)\n"}
,{"stream_name":"stdout","time":2711.484428656,"data":"       |         return (ux, uy), r\n"}
,{"stream_name":"stdout","time":2711.48442985,"data":"       |     center_AEF = circumcenter_mp(Apt, E, F)\n"}
,{"stream_name":"stdout","time":2711.484431103,"data":"       |     center_ABC = circumcenter_mp(Apt, Bpt, Cpt)\n"}
,{"stream_name":"stdout","time":2711.484432889,"data":"       |     if center_AEF is None or center_ABC is None:\n"}
,{"stream_name":"stdout","time":2711.484434136,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.484435303,"data":"       |     (c1, r1) = center_AEF\n"}
,{"stream_name":"stdout","time":2711.484436481,"data":"       |     (c2, r2) = center_ABC\n"}
,{"stream_name":"stdout","time":2711.484437663,"data":"       |     # intersect circles\n"}
,{"stream_name":"stdout","time":2711.484438823,"data":"       |     def circle_intersections_mp(c1, r1, c2, r2):\n"}
,{"stream_name":"stdout","time":2711.484440056,"data":"       |         x0,y0 = c1\n"}
,{"stream_name":"stdout","time":2711.484441263,"data":"       |         x1,y1 = c2\n"}
,{"stream_name":"stdout","time":2711.484442473,"data":"       |         dx = x1 - x0\n"}
,{"stream_name":"stdout","time":2711.484443643,"data":"       |         dy = y1 - y0\n"}
,{"stream_name":"stdout","time":2711.484444827,"data":"       |         d = mp.sqrt(dx**2 + dy**2)\n"}
,{"stream_name":"stdout","time":2711.48444603,"data":"       |         if d \u003e r1 + r2 or d \u003c abs(r1 - r2):\n"}
,{"stream_name":"stdout","time":2711.48444738,"data":"       |             return []\n"}
,{"stream_name":"stdout","time":2711.484448537,"data":"       |         a = (r1**2 - r2**2 + d**2) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.484449757,"data":"       |         h_sq = r1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.484450926,"data":"       |         h = mp.sqrt(max(h_sq, 0))\n"}
,{"stream_name":"stdout","time":2711.484452139,"data":"       |         xm = x0 + a*dx/d\n"}
,{"stream_name":"stdout","time":2711.484453327,"data":"       |         ym = y0 + a*dy/d\n"}
,{"stream_name":"stdout","time":2711.484454516,"data":"       |         rx = -dy * (h/d)\n"}
,{"stream_name":"stdout","time":2711.484455671,"data":"       |         ry = dx * (h/d)\n"}
,{"stream_name":"stdout","time":2711.48445682,"data":"       |         p1 = (xm + rx, ym + ry)\n"}
,{"stream_name":"stdout","time":2711.484457987,"data":"       |         p2 = (xm - rx, ym - ry)\n"}
,{"stream_name":"stdout","time":2711.484459184,"data":"       |         if h \u003c mp.mpf('1e-30'):\n"}
,{"stream_name":"stdout","time":2711.484460446,"data":"       |             return [p1]\n"}
,{"stream_name":"stdout","time":2711.484461649,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":2711.484463887,"data":"       |             return [p1, p2]\n"}
,{"stream_name":"stdout","time":2711.484465119,"data":"       |     inters = circle_intersections_mp(c1, r1, c2, r2)\n"}
,{"stream_name":"stdout","time":2711.484466363,"data":"       |     # select K not equal to A\n"}
,{"stream_name":"stdout","time":2711.484467586,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.484468763,"data":"       |     for pt in inters:\n"}
,{"stream_name":"stdout","time":2711.484469983,"data":"       |         if mp.hypot(pt[0]-Apt[0], pt[1]-Apt[1]) \u003e mp.mpf('1e-30'):\n"}
,{"stream_name":"stdout","time":2711.484471313,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.484472534,"data":"       |             break\n"}
,{"stream_name":"stdout","time":2711.484473713,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.484474896,"data":"       |         K = inters[0]\n"}
,{"stream_name":"stdout","time":2711.484476076,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.484477303,"data":"       |     def reflect_point_across_line_mp(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.484478533,"data":"       |         # line AB direction\n"}
,{"stream_name":"stdout","time":2711.484479703,"data":"       |         dx = B[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.484480879,"data":"       |         dy = B[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.484482073,"data":"       |         # projection factor t\n"}
,{"stream_name":"stdout","time":2711.484483329,"data":"       |         t = ((P[0] - A[0])*dx + (P[1] - A[1])*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.484484589,"data":"       |         proj = (A[0] + t*dx, A[1] + t*dy)\n"}
,{"stream_name":"stdout","time":2711.484485793,"data":"       |         return (2*proj[0] - P[0], 2*proj[1] - P[1])\n"}
,{"stream_name":"stdout","time":2711.484487016,"data":"       |     Kprime = reflect_point_across_line_mp(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.484488253,"data":"       |     # N foot from D onto EF\n"}
,{"stream_name":"stdout","time":2711.484489783,"data":"       |     N = projection_point_to_line(D, E, F)  # using earlier function (float) but we need mp version\n"}
,{"stream_name":"stdout","time":2711.484491139,"data":"       | \n"}
