,{"stream_name":"stdout","time":2711.472848654,"data":"       | # re-define compute_ratio_numeric (copy from earlier)\n"}
,{"stream_name":"stdout","time":2711.472849893,"data":"       | def compute_ratio_numeric(c0, d0, r):\n"}
,{"stream_name":"stdout","time":2711.472851155,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.472852352,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472853543,"data":"       |     C = (a, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472854777,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.472855924,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.47285714,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472858383,"data":"       |     F = (x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.472859576,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.472860754,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472861989,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472863231,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.47286441,"data":"       |     # compute A intersection BF and CE\n"}
,{"stream_name":"stdout","time":2711.472865843,"data":"       |     # BF: (t*x_f, t*y_f)\n"}
,{"stream_name":"stdout","time":2711.472867069,"data":"       |     # CE: (a + s*(x_e - a), s*y_e)\n"}
,{"stream_name":"stdout","time":2711.472868298,"data":"       |     if abs(y_f) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472869509,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472870692,"data":"       |     denom = (y_e * x_f / y_f - (x_e - a))\n"}
,{"stream_name":"stdout","time":2711.472871898,"data":"       |     if abs(denom) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472873118,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472874319,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.472875487,"data":"       |     t = s * y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.472876684,"data":"       |     A = (t * x_f, t * y_f)\n"}
,{"stream_name":"stdout","time":2711.472877893,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.472879088,"data":"       |     O_ABC = circumcenter(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.472880338,"data":"       |     if O_ABC is None:\n"}
,{"stream_name":"stdout","time":2711.47288153,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472882711,"data":"       |     R_ABC = math.hypot(O_ABC[0]-A[0], O_ABC[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.472883978,"data":"       |     O_AEF = circumcenter(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.4728852,"data":"       |     if O_AEF is None:\n"}
,{"stream_name":"stdout","time":2711.472886383,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472887566,"data":"       |     R_AEF = math.hypot(O_AEF[0]-A[0], O_AEF[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.472888843,"data":"       |     # intersection points of circles\n"}
,{"stream_name":"stdout","time":2711.472890092,"data":"       |     pts = intersect_circles(O_ABC, R_ABC, O_AEF, R_AEF)\n"}
,{"stream_name":"stdout","time":2711.472891404,"data":"       |     if len(pts) \u003c 2:\n"}
,{"stream_name":"stdout","time":2711.472892621,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.47289493,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.472896118,"data":"       |     for pt in pts:\n"}
,{"stream_name":"stdout","time":2711.472897317,"data":"       |         if math.hypot(pt[0]-A[0], pt[1]-A[1]) \u003e 1e-6:\n"}
