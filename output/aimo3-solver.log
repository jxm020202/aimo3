,{"stream_name":"stdout","time":2711.479490966,"data":"       |         't_center': t_center,\n"}
,{"stream_name":"stdout","time":2711.479492193,"data":"       |         'T': T\n"}
,{"stream_name":"stdout","time":2711.479493399,"data":"       |     }\n"}
