,{"stream_name":"stdout","time":3398.361151636,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.361152736,"data":"       | def point_in_polygon(pt, eps=1e-9):\n"}
,{"stream_name":"stdout","time":3398.36115393,"data":"       |     x,y=pt\n"}
,{"stream_name":"stdout","time":3398.361155087,"data":"       |     n=len(poly)\n"}
,{"stream_name":"stdout","time":3398.361156261,"data":"       |     # For convex polygon, check orientation of each edge\n"}
,{"stream_name":"stdout","time":3398.361157497,"data":"       |     # compute cross product (edge) x (point - vertex)\n"}
