,{"stream_name":"stdout","time":2711.467909714,"data":"       |     r = area / s\n"}
,{"stream_name":"stdout","time":2711.467911867,"data":"       |     I = (d, r)\n"}
,{"stream_name":"stdout","time":2711.467913174,"data":"       |     # foot F onto AB\n"}
