,{"stream_name":"stdout","time":2711.489558726,"data":"       |     BT = abs(x_T)\n"}
,{"stream_name":"stdout","time":2711.489559905,"data":"       |     NB = distance(B, N)\n"}
,{"stream_name":"stdout","time":2711.489561085,"data":"       |     NE = distance(N, E)\n"}
,{"stream_name":"stdout","time":2711.489562254,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
