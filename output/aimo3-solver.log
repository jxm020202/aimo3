,{"stream_name":"stdout","time":3398.361220973,"data":"       | We need function to compute intersection of two lines given by two points each. We'll compute line coefficients (a,b,c) for line ax+by+c=0. Intersection of two lines (a1,b1,c1) and (a2,b2,c2) solves linear equations.\n"}
,{"stream_name":"stdout","time":3398.361224097,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.361225266,"data":"       | Let's implement.\n"}
,{"stream_name":"stdout","time":3398.361226394,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.361227517,"data":"       | assistantanalysis to=python codedef line_from_pair(pair):\n"}
,{"stream_name":"stdout","time":3398.361228747,"data":"       |     i,j=pair\n"}
,{"stream_name":"stdout","time":3398.36122988,"data":"       |     x1,y1=verts[i]\n"}
,{"stream_name":"stdout","time":3398.36123101,"data":"       |     x2,y2=verts[j]\n"}
,{"stream_name":"stdout","time":3398.36123216,"data":"       |     # line coefficients a x + b y + c = 0\n"}
,{"stream_name":"stdout","time":3398.361233361,"data":"       |     a = y2 - y1\n"}
,{"stream_name":"stdout","time":3398.36123452,"data":"       |     b = x1 - x2\n"}
,{"stream_name":"stdout","time":3398.361235621,"data":"       |     c = -(a*x1 + b*y1)\n"}
,{"stream_name":"stdout","time":3398.361236767,"data":"       |     return (a,b,c)\n"}
,{"stream_name":"stdout","time":3398.361237904,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.361239014,"data":"       | def intersect(line1,line2):\n"}
,{"stream_name":"stdout","time":3398.361240166,"data":"       |     a1,b1,c1=line1\n"}
,{"stream_name":"stdout","time":3398.361241274,"data":"       |     a2,b2,c2=line2\n"}
,{"stream_name":"stdout","time":3398.361242397,"data":"       |     det=a1*b2 - a2*b1\n"}
,{"stream_name":"stdout","time":3398.361243596,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":3398.36124479,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.361245948,"data":"       |     x = (b1*c2 - b2*c1)/det\n"}
,{"stream_name":"stdout","time":3398.361247124,"data":"       |     y = (c1*a2 - c2*a1)/det\n"}
,{"stream_name":"stdout","time":3398.361248257,"data":"       |     return (x,y)\n"}
,{"stream_name":"stdout","time":3398.361249387,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.361250484,"data":"       | # test intersection of two chords\n"}
