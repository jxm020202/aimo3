,{"stream_name":"stdout","time":2711.494841039,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494842248,"data":"       | Given time, we can approximate p and q rational using rational reconstruction from high-precision α.\n"}
,{"stream_name":"stdout","time":2711.494843587,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.49484477,"data":"       | We can compute α to high precision (say 100 decimal digits) using mpmath with high precision.\n"}
,{"stream_name":"stdout","time":2711.494846085,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494847271,"data":"       | We need to compute geometry with high precision. That may be heavy but we can try for p=1, q=phi.\n"}
,{"stream_name":"stdout","time":2711.494848609,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494849792,"data":"       | Let's implement geometry using mpmath with high precision (say 200 bits) to compute r root and ratio.\n"}
,{"stream_name":"stdout","time":2711.494851091,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494852251,"data":"       | We'll need to compute determinant condition for cyclic quadrilateral using high precision.\n"}
,{"stream_name":"stdout","time":2711.494853602,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494854986,"data":"       | But we can use the condition that the determinant is zero; we can find root for r using mpmath's findroot.\n"}
,{"stream_name":"stdout","time":2711.494856318,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494857484,"data":"       | We already have approximate root r ≈ 0.4452013908971797 for p=1, q=phi.\n"}
,{"stream_name":"stdout","time":2711.494858825,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494859983,"data":"       | We can refine r using high precision.\n"}
,{"stream_name":"stdout","time":2711.494861193,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494862344,"data":"       | Let's implement using mpmath with high precision.\n"}
,{"stream_name":"stdout","time":2711.494863595,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.49486477,"data":"       | assistantanalysis to=python codeimport mpmath as mp\n"}
,{"stream_name":"stdout","time":2711.494865998,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494867122,"data":"       | mp.mp.dps = 80\n"}
,{"stream_name":"stdout","time":2711.494868277,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494869432,"data":"       | phi_mp = (mp.mpf(1) + mp.sqrt(5)) / 2\n"}
,{"stream_name":"stdout","time":2711.494870662,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.494871776,"data":"       | def det_mp(p, q, r):\n"}
,{"stream_name":"stdout","time":2711.494872964,"data":"       |     # compute determinant for cyclic condition using mpmath\n"}
,{"stream_name":"stdout","time":2711.494874233,"data":"       |     # Points as before\n"}
,{"stream_name":"stdout","time":2711.494877429,"data":"       |     B = (mp.mpf(0), mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.494878684,"data":"       |     C = (p+q, mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.49487988,"data":"       |     I = (p, r)\n"}
,{"stream_name":"stdout","time":2711.494881097,"data":"       |     # slopes\n"}
,{"stream_name":"stdout","time":2711.494882264,"data":"       |     mB = 2*p*r/(p**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.494883506,"data":"       |     mC = 2*q*r/(q**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.494884714,"data":"       |     # A\n"}
,{"stream_name":"stdout","time":2711.494885913,"data":"       |     xA = -mC*(p+q)/(mB - mC)\n"}
,{"stream_name":"stdout","time":2711.494887117,"data":"       |     yA = mB*xA\n"}
,{"stream_name":"stdout","time":2711.494888293,"data":"       |     A = (xA, yA)\n"}
,{"stream_name":"stdout","time":2711.494889483,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.494890682,"data":"       |     Fx = p*(p**2 - r**2)/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.494891909,"data":"       |     Fy = 2*p**2*r/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.494893095,"data":"       |     F = (Fx, Fy)\n"}
,{"stream_name":"stdout","time":2711.494894296,"data":"       |     # reflect F across line AI to get E\n"}
,{"stream_name":"stdout","time":2711.494895537,"data":"       |     # line AI direction\n"}
,{"stream_name":"stdout","time":2711.494896707,"data":"       |     ux = I[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.494897889,"data":"       |     uy = I[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.494899095,"data":"       |     norm_u = mp.sqrt(ux**2 + uy**2)\n"}
,{"stream_name":"stdout","time":2711.494900375,"data":"       |     ux /= norm_u\n"}
,{"stream_name":"stdout","time":2711.494901573,"data":"       |     uy /= norm_u\n"}
,{"stream_name":"stdout","time":2711.494902731,"data":"       |     # vector AF\n"}
,{"stream_name":"stdout","time":2711.494903891,"data":"       |     vAx = F[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.494905055,"data":"       |     vAy = F[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.494906257,"data":"       |     proj = vAx*ux + vAy*uy\n"}
,{"stream_name":"stdout","time":2711.494907448,"data":"       |     par_x = proj*ux\n"}
,{"stream_name":"stdout","time":2711.494908591,"data":"       |     par_y = proj*uy\n"}
,{"stream_name":"stdout","time":2711.494909781,"data":"       |     perp_x = vAx - par_x\n"}
,{"stream_name":"stdout","time":2711.494910964,"data":"       |     perp_y = vAy - par_y\n"}
,{"stream_name":"stdout","time":2711.494912164,"data":"       |     Ex = F[0] - 2*perp_x\n"}
,{"stream_name":"stdout","time":2711.49491342,"data":"       |     Ey = F[1] - 2*perp_y\n"}
,{"stream_name":"stdout","time":2711.494914609,"data":"       |     E = (Ex, Ey)\n"}
,{"stream_name":"stdout","time":2711.494915807,"data":"       |     # line EF direction\n"}
,{"stream_name":"stdout","time":2711.49491698,"data":"       |     vEFx = F[0] - E[0]\n"}
,{"stream_name":"stdout","time":2711.494918164,"data":"       |     vEFy = F[1] - E[1]\n"}
,{"stream_name":"stdout","time":2711.494919369,"data":"       |     # foot N from D to EF\n"}
,{"stream_name":"stdout","time":2711.494920547,"data":"       |     D = (p, mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.494921742,"data":"       |     Dx = D[0] - E[0]\n"}
,{"stream_name":"stdout","time":2711.494922896,"data":"       |     Dy = D[1] - E[1]\n"}
,{"stream_name":"stdout","time":2711.494924064,"data":"       |     t = (Dx*vEFx + Dy*vEFy) / (vEFx**2 + vEFy**2)\n"}
,{"stream_name":"stdout","time":2711.494926911,"data":"       |     Nx = E[0] + t*vEFx\n"}
,{"stream_name":"stdout","time":2711.494928132,"data":"       |     Ny = E[1] + t*vEFy\n"}
,{"stream_name":"stdout","time":2711.494929304,"data":"       |     N = (Nx, Ny)\n"}
,{"stream_name":"stdout","time":2711.494930537,"data":"       |     # circumcenter O1 of ABC\n"}
,{"stream_name":"stdout","time":2711.494932082,"data":"       |     xO1 = (p+q)/2\n"}
,{"stream_name":"stdout","time":2711.494933278,"data":"       |     yO1 = ((xA - xO1)**2 + yA**2 - xO1**2) / (2*yA)\n"}
,{"stream_name":"stdout","time":2711.49493452,"data":"       |     O1 = (xO1, yO1)\n"}
,{"stream_name":"stdout","time":2711.494935727,"data":"       |     R1_sq = xO1**2 + yO1**2\n"}
,{"stream_name":"stdout","time":2711.49493695,"data":"       |     # circumcenter O2 of AFE\n"}
,{"stream_name":"stdout","time":2711.494938166,"data":"       |     # Solve linear equations for circumcenter\n"}
,{"stream_name":"stdout","time":2711.494939375,"data":"       |     # using matrix method\n"}
,{"stream_name":"stdout","time":2711.494940654,"data":"       |     # (ox - Ax)^2 + (oy - Ay)^2 = (ox - Fx)^2 + (oy - Fy)^2\n"}
,{"stream_name":"stdout","time":2711.494941951,"data":"       |     # =\u003e 2*ox*(Fx - Ax) + 2*oy*(Fy - Ay) = Ax**2 - Fx**2 + Ay**2 - Fy**2\n"}
,{"stream_name":"stdout","time":2711.49494331,"data":"       |     # similarly with E\n"}
,{"stream_name":"stdout","time":2711.49494446,"data":"       |     M = mp.matrix([[2*(Fx - xA), 2*(Fy - yA)],\n"}
,{"stream_name":"stdout","time":2711.494945734,"data":"       |                   [2*(Ex - xA), 2*(Ey - yA)]])\n"}
,{"stream_name":"stdout","time":2711.494946962,"data":"       |     rhs = mp.matrix([xA**2 - Fx**2 + yA**2 - Fy**2,\n"}
,{"stream_name":"stdout","time":2711.494948221,"data":"       |                      xA**2 - Ex**2 + yA**2 - Ey**2])\n"}
,{"stream_name":"stdout","time":2711.494949453,"data":"       |     sol = mp.lu_solve(M, rhs)\n"}
,{"stream_name":"stdout","time":2711.494950714,"data":"       |     ox2 = sol[0]\n"}
,{"stream_name":"stdout","time":2711.494951889,"data":"       |     oy2 = sol[1]\n"}
,{"stream_name":"stdout","time":2711.494953079,"data":"       |     O2 = (ox2, oy2)\n"}
,{"stream_name":"stdout","time":2711.494954253,"data":"       |     R2_sq = (ox2 - xA)**2 + (oy2 - yA)**2\n"}
,{"stream_name":"stdout","time":2711.494955496,"data":"       |     # vector d\n"}
,{"stream_name":"stdout","time":2711.494956685,"data":"       |     dx = ox2 - xO1\n"}
,{"stream_name":"stdout","time":2711.494957862,"data":"       |     dy = oy2 - yO1\n"}
,{"stream_name":"stdout","time":2711.494959024,"data":"       |     d_sq = dx**2 + dy**2\n"}
,{"stream_name":"stdout","time":2711.494960262,"data":"       |     d = mp.sqrt(d_sq)\n"}
,{"stream_name":"stdout","time":2711.494961422,"data":"       |     a_dist = (R1_sq - R2_sq + d_sq) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.494962625,"data":"       |     h_sq = R1_sq - a_dist**2\n"}
,{"stream_name":"stdout","time":2711.494963843,"data":"       |     # unit vector u\n"}
,{"stream_name":"stdout","time":2711.494965022,"data":"       |     ux = dx/d\n"}
,{"stream_name":"stdout","time":2711.494966214,"data":"       |     uy = dy/d\n"}
,{"stream_name":"stdout","time":2711.494967377,"data":"       |     # point P\n"}
,{"stream_name":"stdout","time":2711.494968546,"data":"       |     Px = xO1 + a_dist*ux\n"}
,{"stream_name":"stdout","time":2711.494969758,"data":"       |     Py = yO1 + a_dist*uy\n"}
,{"stream_name":"stdout","time":2711.494970953,"data":"       |     # perp vector\n"}
,{"stream_name":"stdout","time":2711.494972115,"data":"       |     perp_x = -uy\n"}
,{"stream_name":"stdout","time":2711.49497506,"data":"       |     perp_y = ux\n"}
,{"stream_name":"stdout","time":2711.494976241,"data":"       |     # K candidates\n"}
,{"stream_name":"stdout","time":2711.494977567,"data":"       |     K1 = (Px + mp.sqrt(h_sq)*perp_x, Py + mp.sqrt(h_sq)*perp_y)\n"}
,{"stream_name":"stdout","time":2711.494978871,"data":"       |     K2 = (Px - mp.sqrt(h_sq)*perp_x, Py - mp.sqrt(h_sq)*perp_y)\n"}
,{"stream_name":"stdout","time":2711.494980184,"data":"       |     # choose K not equal to A\n"}
,{"stream_name":"stdout","time":2711.494981575,"data":"       |     def dist(P,Q):\n"}
,{"stream_name":"stdout","time":2711.494982811,"data":"       |         return mp.sqrt((P[0]-Q[0])**2 + (P[1]-Q[1])**2)\n"}
,{"stream_name":"stdout","time":2711.494984225,"data":"       |     if dist(K1, A) \u003e mp.mpf('1e-12'):\n"}
,{"stream_name":"stdout","time":2711.494985512,"data":"       |         K = K1\n"}
,{"stream_name":"stdout","time":2711.494986686,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.494987843,"data":"       |         K = K2\n"}
,{"stream_name":"stdout","time":2711.494989122,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.494990331,"data":"       |     # unit direction of EF\n"}
,{"stream_name":"stdout","time":2711.494991551,"data":"       |     normEF = mp.sqrt(vEFx**2 + vEFy**2)\n"}
,{"stream_name":"stdout","time":2711.494992749,"data":"       |     uxEF = vEFx / normEF\n"}
,{"stream_name":"stdout","time":2711.494994036,"data":"       |     uyEF = vEFy / normEF\n"}
,{"stream_name":"stdout","time":2711.49499522,"data":"       |     EKx = K[0] - Ex\n"}
,{"stream_name":"stdout","time":2711.494996414,"data":"       |     EKy = K[1] - Ey\n"}
,{"stream_name":"stdout","time":2711.494997793,"data":"       |     proj_len = EKx*uxEF + EKy*uyEF\n"}
,{"stream_name":"stdout","time":2711.494999108,"data":"       |     proj_pt = (Ex + proj_len*uxEF, Ey + proj_len*uyEF)\n"}
,{"stream_name":"stdout","time":2711.495000403,"data":"       |     Kprime = (2*proj_pt[0] - K[0], 2*proj_pt[1] - K[1])\n"}
,{"stream_name":"stdout","time":2711.495001653,"data":"       |     # determinant of matrix for cyclic condition\n"}
,{"stream_name":"stdout","time":2711.495002882,"data":"       |     # Build 4x4 matrix\n"}
,{"stream_name":"stdout","time":2711.495004035,"data":"       |     def row(P):\n"}
,{"stream_name":"stdout","time":2711.495005213,"data":"       |         return [P[0], P[1], P[0]**2 + P[1]**2, mp.mpf(1)]\n"}
,{"stream_name":"stdout","time":2711.495006493,"data":"       |     Mdet = mp.matrix([row(B), row(N), row(K), row(Kprime)])\n"}
,{"stream_name":"stdout","time":2711.49500776,"data":"       |     # compute determinant via expansion (mpmath doesn't have det, implement manually)\n"}
,{"stream_name":"stdout","time":2711.4950091,"data":"       |     # Use sympy for determinant of numeric matrix? Use mp.matrix's det? It may have .det()\n"}
,{"stream_name":"stdout","time":2711.495010409,"data":"       |     try:\n"}
,{"stream_name":"stdout","time":2711.495011575,"data":"       |         det_val = Mdet.det()\n"}
,{"stream_name":"stdout","time":2711.495012794,"data":"       |     except AttributeError:\n"}
,{"stream_name":"stdout","time":2711.495013962,"data":"       |         # fallback using sympy\n"}
,{"stream_name":"stdout","time":2711.49501518,"data":"       |         M_sym = sp.Matrix([[float(val) for val in row(B)],\n"}
,{"stream_name":"stdout","time":2711.495016454,"data":"       |                            [float(val) for val in row(N)],\n"}
,{"stream_name":"stdout","time":2711.495017737,"data":"       |                            [float(val) for val in row(K)],\n"}
,{"stream_name":"stdout","time":2711.495020731,"data":"       |                            [float(val) for val in row(Kprime)]])\n"}
,{"stream_name":"stdout","time":2711.495022048,"data":"       |         det_val = float(M_sym.det())\n"}
,{"stream_name":"stdout","time":2711.49502331,"data":"       |     return det_val\n"}
,{"stream_name":"stdout","time":2711.4950245,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.495025605,"data":"       | # find root near 0.44 using findroot\n"}
,{"stream_name":"stdout","time":2711.495026835,"data":"       | p = mp.mpf(1)\n"}
,{"stream_name":"stdout","time":2711.495028019,"data":"       | q = phi_mp\n"}
,{"stream_name":"stdout","time":2711.495029181,"data":"       | f = lambda r: det_mp(p,q,r)\n"}
,{"stream_name":"stdout","time":2711.495030363,"data":"       | root = mp.findroot(f, 0.44)\n"}
,{"stream_name":"stdout","time":2711.495031577,"data":"       | root\n"}
,{"stream_name":"stdout","time":2711.495032787,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.495034027,"data":"     [Code]:\n"}
,{"stream_name":"stdout","time":2711.495035197,"data":"       | import mpmath as mp\n"}
,{"stream_name":"stdout","time":2711.495036387,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.495037511,"data":"       | mp.mp.dps = 80\n"}
,{"stream_name":"stdout","time":2711.495038682,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.495039825,"data":"       | phi_mp = (mp.mpf(1) + mp.sqrt(5)) / 2\n"}
,{"stream_name":"stdout","time":2711.495041066,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.495042227,"data":"       | def det_mp(p, q, r):\n"}
,{"stream_name":"stdout","time":2711.495043438,"data":"       |     # compute determinant for cyclic condition using mpmath\n"}
,{"stream_name":"stdout","time":2711.495044709,"data":"       |     # Points as before\n"}
,{"stream_name":"stdout","time":2711.495045886,"data":"       |     B = (mp.mpf(0), mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.495047095,"data":"       |     C = (p+q, mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.49504833,"data":"       |     I = (p, r)\n"}
,{"stream_name":"stdout","time":2711.495049477,"data":"       |     # slopes\n"}
,{"stream_name":"stdout","time":2711.495050649,"data":"       |     mB = 2*p*r/(p**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.495051856,"data":"       |     mC = 2*q*r/(q**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.495053051,"data":"       |     # A\n"}
,{"stream_name":"stdout","time":2711.495054242,"data":"       |     xA = -mC*(p+q)/(mB - mC)\n"}
,{"stream_name":"stdout","time":2711.495055433,"data":"       |     yA = mB*xA\n"}
,{"stream_name":"stdout","time":2711.495056577,"data":"       |     A = (xA, yA)\n"}
,{"stream_name":"stdout","time":2711.495057729,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.495058885,"data":"       |     Fx = p*(p**2 - r**2)/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.495060164,"data":"       |     Fy = 2*p**2*r/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.495061399,"data":"       |     F = (Fx, Fy)\n"}
,{"stream_name":"stdout","time":2711.495062583,"data":"       |     # reflect F across line AI to get E\n"}
,{"stream_name":"stdout","time":2711.495064083,"data":"       |     # line AI direction\n"}
,{"stream_name":"stdout","time":2711.495065266,"data":"       |     ux = I[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.495066422,"data":"       |     uy = I[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.495067621,"data":"       |     norm_u = mp.sqrt(ux**2 + uy**2)\n"}
,{"stream_name":"stdout","time":2711.495070398,"data":"       |     ux /= norm_u\n"}
,{"stream_name":"stdout","time":2711.495071582,"data":"       |     uy /= norm_u\n"}
,{"stream_name":"stdout","time":2711.495072793,"data":"       |     # vector AF\n"}
,{"stream_name":"stdout","time":2711.495073957,"data":"       |     vAx = F[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.49507514,"data":"       |     vAy = F[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.495076326,"data":"       |     proj = vAx*ux + vAy*uy\n"}
,{"stream_name":"stdout","time":2711.495077504,"data":"       |     par_x = proj*ux\n"}
,{"stream_name":"stdout","time":2711.495078695,"data":"       |     par_y = proj*uy\n"}
,{"stream_name":"stdout","time":2711.495080021,"data":"       |     perp_x = vAx - par_x\n"}
,{"stream_name":"stdout","time":2711.495081244,"data":"       |     perp_y = vAy - par_y\n"}
,{"stream_name":"stdout","time":2711.495082442,"data":"       |     Ex = F[0] - 2*perp_x\n"}
,{"stream_name":"stdout","time":2711.495083633,"data":"       |     Ey = F[1] - 2*perp_y\n"}
,{"stream_name":"stdout","time":2711.495084864,"data":"       |     E = (Ex, Ey)\n"}
,{"stream_name":"stdout","time":2711.495086047,"data":"       |     # line EF direction\n"}
,{"stream_name":"stdout","time":2711.495087242,"data":"       |     vEFx = F[0] - E[0]\n"}
,{"stream_name":"stdout","time":2711.495088403,"data":"       |     vEFy = F[1] - E[1]\n"}
,{"stream_name":"stdout","time":2711.495089617,"data":"       |     # foot N from D to EF\n"}
,{"stream_name":"stdout","time":2711.495090787,"data":"       |     D = (p, mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.49509199,"data":"       |     Dx = D[0] - E[0]\n"}
,{"stream_name":"stdout","time":2711.495093173,"data":"       |     Dy = D[1] - E[1]\n"}
,{"stream_name":"stdout","time":2711.49509436,"data":"       |     t = (Dx*vEFx + Dy*vEFy) / (vEFx**2 + vEFy**2)\n"}
,{"stream_name":"stdout","time":2711.495095577,"data":"       |     Nx = E[0] + t*vEFx\n"}
,{"stream_name":"stdout","time":2711.495096737,"data":"       |     Ny = E[1] + t*vEFy\n"}
,{"stream_name":"stdout","time":2711.49509789,"data":"       |     N = (Nx, Ny)\n"}
,{"stream_name":"stdout","time":2711.495099077,"data":"       |     # circumcenter O1 of ABC\n"}
,{"stream_name":"stdout","time":2711.495100257,"data":"       |     xO1 = (p+q)/2\n"}
,{"stream_name":"stdout","time":2711.495101447,"data":"       |     yO1 = ((xA - xO1)**2 + yA**2 - xO1**2) / (2*yA)\n"}
,{"stream_name":"stdout","time":2711.495102685,"data":"       |     O1 = (xO1, yO1)\n"}
,{"stream_name":"stdout","time":2711.495103876,"data":"       |     R1_sq = xO1**2 + yO1**2\n"}
,{"stream_name":"stdout","time":2711.495105065,"data":"       |     # circumcenter O2 of AFE\n"}
,{"stream_name":"stdout","time":2711.495106304,"data":"       |     # Solve linear equations for circumcenter\n"}
,{"stream_name":"stdout","time":2711.495107507,"data":"       |     # using matrix method\n"}
,{"stream_name":"stdout","time":2711.495108702,"data":"       |     # (ox - Ax)^2 + (oy - Ay)^2 = (ox - Fx)^2 + (oy - Fy)^2\n"}
,{"stream_name":"stdout","time":2711.495109973,"data":"       |     # =\u003e 2*ox*(Fx - Ax) + 2*oy*(Fy - Ay) = Ax**2 - Fx**2 + Ay**2 - Fy**2\n"}
,{"stream_name":"stdout","time":2711.495111355,"data":"       |     # similarly with E\n"}
,{"stream_name":"stdout","time":2711.495112522,"data":"       |     M = mp.matrix([[2*(Fx - xA), 2*(Fy - yA)],\n"}
,{"stream_name":"stdout","time":2711.495113727,"data":"       |                   [2*(Ex - xA), 2*(Ey - yA)]])\n"}
,{"stream_name":"stdout","time":2711.495114936,"data":"       |     rhs = mp.matrix([xA**2 - Fx**2 + yA**2 - Fy**2,\n"}
,{"stream_name":"stdout","time":2711.495118122,"data":"       |                      xA**2 - Ex**2 + yA**2 - Ey**2])\n"}
,{"stream_name":"stdout","time":2711.495119407,"data":"       |     sol = mp.lu_solve(M, rhs)\n"}
,{"stream_name":"stdout","time":2711.495120633,"data":"       |     ox2 = sol[0]\n"}
,{"stream_name":"stdout","time":2711.49512187,"data":"       |     oy2 = sol[1]\n"}
,{"stream_name":"stdout","time":2711.4951231,"data":"       |     O2 = (ox2, oy2)\n"}
,{"stream_name":"stdout","time":2711.495124293,"data":"       |     R2_sq = (ox2 - xA)**2 + (oy2 - yA)**2\n"}
,{"stream_name":"stdout","time":2711.495125532,"data":"       |     # vector d\n"}
,{"stream_name":"stdout","time":2711.495126702,"data":"       |     dx = ox2 - xO1\n"}
,{"stream_name":"stdout","time":2711.495127889,"data":"       |     dy = oy2 - yO1\n"}
,{"stream_name":"stdout","time":2711.495129185,"data":"       |     d_sq = dx**2 + dy**2\n"}
,{"stream_name":"stdout","time":2711.495130468,"data":"       |     d = mp.sqrt(d_sq)\n"}
,{"stream_name":"stdout","time":2711.495131667,"data":"       |     a_dist = (R1_sq - R2_sq + d_sq) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.495132957,"data":"       |     h_sq = R1_sq - a_dist**2\n"}
,{"stream_name":"stdout","time":2711.495134377,"data":"       |     # unit vector u\n"}
,{"stream_name":"stdout","time":2711.495135589,"data":"       |     ux = dx/d\n"}
,{"stream_name":"stdout","time":2711.495136757,"data":"       |     uy = dy/d\n"}
,{"stream_name":"stdout","time":2711.49513791,"data":"       |     # point P\n"}
,{"stream_name":"stdout","time":2711.495139111,"data":"       |     Px = xO1 + a_dist*ux\n"}
,{"stream_name":"stdout","time":2711.495140312,"data":"       |     Py = yO1 + a_dist*uy\n"}
,{"stream_name":"stdout","time":2711.495141503,"data":"       |     # perp vector\n"}
,{"stream_name":"stdout","time":2711.495143306,"data":"       |     perp_x = -uy\n"}
,{"stream_name":"stdout","time":2711.495144505,"data":"       |     perp_y = ux\n"}
,{"stream_name":"stdout","time":2711.495145672,"data":"       |     # K candidates\n"}
,{"stream_name":"stdout","time":2711.4951469,"data":"       |     K1 = (Px + mp.sqrt(h_sq)*perp_x, Py + mp.sqrt(h_sq)*perp_y)\n"}
,{"stream_name":"stdout","time":2711.495148203,"data":"       |     K2 = (Px - mp.sqrt(h_sq)*perp_x, Py - mp.sqrt(h_sq)*perp_y)\n"}
,{"stream_name":"stdout","time":2711.495149473,"data":"       |     # choose K not equal to A\n"}
,{"stream_name":"stdout","time":2711.495150675,"data":"       |     def dist(P,Q):\n"}
,{"stream_name":"stdout","time":2711.495151913,"data":"       |         return mp.sqrt((P[0]-Q[0])**2 + (P[1]-Q[1])**2)\n"}
,{"stream_name":"stdout","time":2711.495153237,"data":"       |     if dist(K1, A) \u003e mp.mpf('1e-12'):\n"}
,{"stream_name":"stdout","time":2711.49515451,"data":"       |         K = K1\n"}
