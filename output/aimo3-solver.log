,{"stream_name":"stdout","time":3102.115126147,"data":"       | Thus we need:\n"}
,{"stream_name":"stdout","time":3102.115127234,"data":"       | \n"}
,{"stream_name":"stdout","time":3102.115128451,"data":"       | (BP·BQ) / (|BP||BQ|) = ((P-C)·(Q-C)) / (|P-C||Q-C|).\n"}
