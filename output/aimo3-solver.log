,{"stream_name":"stdout","time":2711.472172694,"data":"       | def circumcenter(P1, P2, P3):\n"}
,{"stream_name":"stdout","time":2711.47217394,"data":"       |     x1,y1 = P1\n"}
,{"stream_name":"stdout","time":2711.472175122,"data":"       |     x2,y2 = P2\n"}
,{"stream_name":"stdout","time":2711.472176287,"data":"       |     x3,y3 = P3\n"}
,{"stream_name":"stdout","time":2711.472177657,"data":"       |     d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.472178927,"data":"       |     if abs(d) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472180147,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472181342,"data":"       |     ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2)) / d\n"}
,{"stream_name":"stdout","time":2711.472182662,"data":"       |     uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1)) / d\n"}
,{"stream_name":"stdout","time":2711.472183982,"data":"       |     return (ux, uy)\n"}
