,{"stream_name":"stdout","time":2711.472000049,"data":"       |     u = (rhs[0]*A_mat[1][1] - rhs[1]*A_mat[0][1]) / det\n"}
,{"stream_name":"stdout","time":2711.472001294,"data":"       |     # v not needed\n"}
,{"stream_name":"stdout","time":2711.472002453,"data":"       |     O_T = (B[0] + u*d1[0], B[1] + u*d1[1])\n"}
,{"stream_name":"stdout","time":2711.472003683,"data":"       |     # T_x = 2*O_T.x\n"}
,{"stream_name":"stdout","time":2711.4720049,"data":"       |     T = (2*O_T[0], 0.0)\n"}
,{"stream_name":"stdout","time":2711.472006083,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.472007243,"data":"       |     CT = math.hypot(C[0]-T[0], C[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.472008452,"data":"       |     BT = math.hypot(B[0]-T[0], B[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.47200964,"data":"       |     NB = math.hypot(N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472010849,"data":"       |     NE = math.hypot(N[0]-E[0], N[1]-E[1])\n"}
,{"stream_name":"stdout","time":2711.472012045,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
