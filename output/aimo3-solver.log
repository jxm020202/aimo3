,{"stream_name":"stdout","time":2937.181465011,"data":"       | analysisBeta may have negative exponents (Laurent). So sp.Poly cannot handle negative exponents. But we can check that coefficients are integer for each exponent after shifting. Let's compute beta as a dict of coefficients.\n"}
,{"stream_name":"stdout","time":2937.181466559,"data":"       | \n"}
,{"stream_name":"stdout","time":2937.18146762,"data":"       | assistantanalysis to=python codedef laurent_coeffs(expr):\n"}
,{"stream_name":"stdout","time":2937.18146883,"data":"       |     # return dict exponent-\u003ecoeff (integer rational)\n"}
,{"stream_name":"stdout","time":2937.181470095,"data":"       |     expr = sp.expand(expr)\n"}
,{"stream_name":"stdout","time":2937.181471252,"data":"       |     terms = expr.as_ordered_terms()\n"}
,{"stream_name":"stdout","time":2937.18147241,"data":"       |     coeffs = {}\n"}
,{"stream_name":"stdout","time":2937.181473533,"data":"       |     for term in terms:\n"}
,{"stream_name":"stdout","time":2937.181474641,"data":"       |         coeff = term.as_coeff_exponent(x)[0]\n"}
,{"stream_name":"stdout","time":2937.181475856,"data":"       |         exp = term.as_coeff_exponent(x)[1]\n"}
,{"stream_name":"stdout","time":2937.181477,"data":"       |         coeffs[exp] = coeffs.get(exp, 0) + coeff\n"}
,{"stream_name":"stdout","time":2937.181478169,"data":"       |     return coeffs\n"}
,{"stream_name":"stdout","time":2937.181479301,"data":"       | \n"}
,{"stream_name":"stdout","time":2937.181480375,"data":"       | def check_all():\n"}
,{"stream_name":"stdout","time":2937.181483283,"data":"       |     for combo, deg, D in divisors:\n"}
,{"stream_name":"stdout","time":2937.181484472,"data":"       |         for m in range(0, 9-deg):\n"}
,{"stream_name":"stdout","time":2937.181485604,"data":"       |             for s in [1,-1]:\n"}
,{"stream_name":"stdout","time":2937.181486761,"data":"       |                 beta, d = construct_beta(combo, m, s)\n"}
,{"stream_name":"stdout","time":2937.181487948,"data":"       |                 coeffs = laurent_coeffs(beta)\n"}
,{"stream_name":"stdout","time":2937.181489102,"data":"       |                 # check all coefficients are integers\n"}
