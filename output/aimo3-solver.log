,{"stream_name":"stdout","time":3102.117863503,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":3102.117864554,"data":"       | (x-7)^{2}+\\Bigl(y-\\frac{33}{8}\\Bigr)^{2}= \\Bigl(\\frac{65}{8}\\Bigr)^{2}.\n"}
