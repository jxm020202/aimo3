,{"stream_name":"stdout","time":3102.117905302,"data":"       |    =\\frac{(P-C)\\cdot(Q-C)}{|P-C|\\;|Q-C|}.\n"}
,{"stream_name":"stdout","time":3102.117906486,"data":"       | \\]\n"}
