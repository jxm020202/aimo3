,{"stream_name":"stdout","time":3398.366187314,"data":"       |             p21 = intersect_exact(L2, M1)\n"}
,{"stream_name":"stdout","time":3398.366188376,"data":"       |             p22 = intersect_exact(L2, M2)\n"}
,{"stream_name":"stdout","time":3398.366189445,"data":"       |             if None in (p11,p12,p21,p22):\n"}
