,{"stream_name":"stdout","time":3398.366113164,"data":"       |     a1,b1,c1 = line1\n"}
,{"stream_name":"stdout","time":3398.366114326,"data":"       |     a2,b2,c2 = line2\n"}
,{"stream_name":"stdout","time":3398.366115428,"data":"       |     det = sp.simplify(a1*b2 - a2*b1)\n"}
,{"stream_name":"stdout","time":3398.366116576,"data":"       |     if det == 0:\n"}
,{"stream_name":"stdout","time":3398.366117669,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.366118782,"data":"       |     x = sp.simplify((b1*c2 - b2*c1)/det)\n"}
,{"stream_name":"stdout","time":3398.36611993,"data":"       |     y = sp.simplify((c1*a2 - c2*a1)/det)\n"}
,{"stream_name":"stdout","time":3398.36612105,"data":"       |     return (x,y)\n"}
,{"stream_name":"stdout","time":3398.366122164,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.366123231,"data":"       | def point_in_polygon_exact(pt, verts):\n"}
,{"stream_name":"stdout","time":3398.366124384,"data":"       |     # Use winding: for convex polygon, check orientation of each edge with point\n"}
,{"stream_name":"stdout","time":3398.366125584,"data":"       |     x,y = pt\n"}
,{"stream_name":"stdout","time":3398.366126685,"data":"       |     # Determine sign of cross product for each edge\n"}
,{"stream_name":"stdout","time":3398.366127883,"data":"       |     sign = None\n"}
,{"stream_name":"stdout","time":3398.366128984,"data":"       |     for i in range(len(verts)):\n"}
,{"stream_name":"stdout","time":3398.366130115,"data":"       |         x1,y1 = verts[i]\n"}
,{"stream_name":"stdout","time":3398.366131251,"data":"       |         x2,y2 = verts[(i+1)%len(verts)]\n"}
,{"stream_name":"stdout","time":3398.366132434,"data":"       |         ex = x2 - x1\n"}
,{"stream_name":"stdout","time":3398.366133553,"data":"       |         ey = y2 - y1\n"}
,{"stream_name":"stdout","time":3398.36613482,"data":"       |         vx = x - x1\n"}
,{"stream_name":"stdout","time":3398.366135908,"data":"       |         vy = y - y1\n"}
,{"stream_name":"stdout","time":3398.366137018,"data":"       |         cross = sp.simplify(ex*vy - ey*vx)\n"}
,{"stream_name":"stdout","time":3398.366138186,"data":"       |         # cross should be \u003e=0 for interior (if polygon ccw)\n"}
,{"stream_name":"stdout","time":3398.366139447,"data":"       |         # Determine sign: cross should be non-negative\n"}
,{"stream_name":"stdout","time":3398.366140629,"data":"       |         # Since we use exact arithmetic, we can evaluate numeric sign using .evalf()\n"}
,{"stream_name":"stdout","time":3398.366141873,"data":"       |         # But we can also substitute numeric approximations.\n"}
,{"stream_name":"stdout","time":3398.366143046,"data":"       |         # We'll convert to float for sign.\n"}
,{"stream_name":"stdout","time":3398.3661442,"data":"       |         cross_f = float(cross.evalf())\n"}
,{"stream_name":"stdout","time":3398.366145325,"data":"       |         if abs(cross_f) \u003c 1e-9:\n"}
,{"stream_name":"stdout","time":3398.366146477,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":3398.366147547,"data":"       |         cur_sign = cross_f \u003e 0\n"}
,{"stream_name":"stdout","time":3398.366148687,"data":"       |         if sign is None:\n"}
,{"stream_name":"stdout","time":3398.366149807,"data":"       |             sign = cur_sign\n"}
,{"stream_name":"stdout","time":3398.36615095,"data":"       |         elif sign != cur_sign:\n"}
,{"stream_name":"stdout","time":3398.366153871,"data":"       |             return False\n"}
,{"stream_name":"stdout","time":3398.366155039,"data":"       |     return True\n"}
,{"stream_name":"stdout","time":3398.366156171,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.366157247,"data":"       | # Build lines grouped by direction d = (i+j) % n\n"}
,{"stream_name":"stdout","time":3398.366158395,"data":"       | lines_by_d = {d: [] for d in range(n)}\n"}
,{"stream_name":"stdout","time":3398.366159542,"data":"       | pairs_by_d = {d: [] for d in range(n)}\n"}
,{"stream_name":"stdout","time":3398.36616067,"data":"       | for i,j in itertools.combinations(range(n),2):\n"}
,{"stream_name":"stdout","time":3398.366161858,"data":"       |     d = (i+j) % n\n"}
,{"stream_name":"stdout","time":3398.366162948,"data":"       |     line = line_coeff_exact(verts[i], verts[j])\n"}
,{"stream_name":"stdout","time":3398.366164117,"data":"       |     lines_by_d[d].append(line)\n"}
,{"stream_name":"stdout","time":3398.36616523,"data":"       |     pairs_by_d[d].append((i,j))\n"}
,{"stream_name":"stdout","time":3398.366166371,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.36616741,"data":"       | # Count lines per direction\n"}
