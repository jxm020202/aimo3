,{"stream_name":"stdout","time":2937.173771424,"data":"       | def verify_alpha2(alpha_poly, combo):\n"}
,{"stream_name":"stdout","time":2937.173774282,"data":"       |     # compute m = min exponent\n"}
,{"stream_name":"stdout","time":2937.173775467,"data":"       |     monoms = alpha_poly.as_dict()\n"}
,{"stream_name":"stdout","time":2937.173776656,"data":"       |     m = min(exp[0] for exp in monoms)\n"}
,{"stream_name":"stdout","time":2937.173777839,"data":"       |     P_expr = sp.expand(alpha_poly.as_expr() / x**m)\n"}
,{"stream_name":"stdout","time":2937.173779094,"data":"       |     # compute d\n"}
,{"stream_name":"stdout","time":2937.173780235,"data":"       |     if combo:\n"}
,{"stream_name":"stdout","time":2937.173781428,"data":"       |         d = lcm_list(combo)\n"}
,{"stream_name":"stdout","time":2937.173782575,"data":"       |     else:\n"}
