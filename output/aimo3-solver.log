,{"stream_name":"stdout","time":2711.479674656,"data":"       |     for r in rs:\n"}
,{"stream_name":"stdout","time":2711.479675799,"data":"       |         try:\n"}
,{"stream_name":"stdout","time":2711.479676973,"data":"       |             val = det_cyclic_value(n, r)\n"}
,{"stream_name":"stdout","time":2711.479678298,"data":"       |         except Exception as e:\n"}
,{"stream_name":"stdout","time":2711.47967948,"data":"       |             val = None\n"}
,{"stream_name":"stdout","time":2711.479680711,"data":"       |         vals.append(val)\n"}
,{"stream_name":"stdout","time":2711.479681906,"data":"       |     # find sign changes where both vals not None\n"}
,{"stream_name":"stdout","time":2711.479683254,"data":"       |     for i in range(len(rs)-1):\n"}
,{"stream_name":"stdout","time":2711.479684434,"data":"       |         v1 = vals[i]\n"}
,{"stream_name":"stdout","time":2711.479685579,"data":"       |         v2 = vals[i+1]\n"}
,{"stream_name":"stdout","time":2711.479686777,"data":"       |         if v1 is None or v2 is None:\n"}
,{"stream_name":"stdout","time":2711.479687966,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":2711.479689123,"data":"       |         if v1 == 0:\n"}
,{"stream_name":"stdout","time":2711.479690335,"data":"       |             roots.append(rs[i])\n"}
,{"stream_name":"stdout","time":2711.479691566,"data":"       |         if v1 * v2 \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.479692746,"data":"       |             # bracket\n"}
,{"stream_name":"stdout","time":2711.479693923,"data":"       |             a = rs[i]\n"}
,{"stream_name":"stdout","time":2711.479695104,"data":"       |             b = rs[i+1]\n"}
,{"stream_name":"stdout","time":2711.479696285,"data":"       |             # bisection\n"}
,{"stream_name":"stdout","time":2711.479697477,"data":"       |             for _ in range(60):\n"}
,{"stream_name":"stdout","time":2711.47969867,"data":"       |                 m = (a+b)/2\n"}
,{"stream_name":"stdout","time":2711.479699902,"data":"       |                 vm = det_cyclic_value(n, m)\n"}
,{"stream_name":"stdout","time":2711.479702205,"data":"       |                 if vm == 0:\n"}
,{"stream_name":"stdout","time":2711.479703444,"data":"       |                     a=b=m\n"}
,{"stream_name":"stdout","time":2711.479704654,"data":"       |                     break\n"}
,{"stream_name":"stdout","time":2711.479705836,"data":"       |                 if v1 * vm \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.47970707,"data":"       |                     b=m\n"}
,{"stream_name":"stdout","time":2711.479708246,"data":"       |                     v2=vm\n"}
,{"stream_name":"stdout","time":2711.479709434,"data":"       |                 else:\n"}
,{"stream_name":"stdout","time":2711.479710646,"data":"       |                     a=m\n"}
,{"stream_name":"stdout","time":2711.479711798,"data":"       |                     v1=vm\n"}
,{"stream_name":"stdout","time":2711.479712962,"data":"       |             roots.append((a+b)/2)\n"}
