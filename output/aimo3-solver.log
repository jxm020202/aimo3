,{"stream_name":"stdout","time":2711.495477969,"data":"       | def compute_ratio_mp(p,q,r):\n"}
,{"stream_name":"stdout","time":2711.495479213,"data":"       |     # compute ratio using mpmath high precision\n"}
,{"stream_name":"stdout","time":2711.495480446,"data":"       |     # similar steps as before\n"}
,{"stream_name":"stdout","time":2711.495481753,"data":"       |     B = (mp.mpf(0), mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.495482929,"data":"       |     C = (p+q, mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.495484158,"data":"       |     I = (p, r)\n"}
,{"stream_name":"stdout","time":2711.495485334,"data":"       |     # slopes\n"}
,{"stream_name":"stdout","time":2711.495486666,"data":"       |     mB = 2*p*r/(p**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.495487869,"data":"       |     mC = 2*q*r/(q**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.495489037,"data":"       |     xA = -mC*(p+q)/(mB - mC)\n"}
,{"stream_name":"stdout","time":2711.495490226,"data":"       |     yA = mB*xA\n"}
,{"stream_name":"stdout","time":2711.49549155,"data":"       |     A = (xA, yA)\n"}
,{"stream_name":"stdout","time":2711.495492711,"data":"       |     Fx = p*(p**2 - r**2)/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.495493984,"data":"       |     Fy = 2*p**2*r/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.495495189,"data":"       |     F = (Fx, Fy)\n"}
,{"stream_name":"stdout","time":2711.495496353,"data":"       |     # reflect F across line AI\n"}
,{"stream_name":"stdout","time":2711.49549757,"data":"       |     ux = I[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.495498758,"data":"       |     uy = I[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.49549992,"data":"       |     norm_u = mp.sqrt(ux**2 + uy**2)\n"}
,{"stream_name":"stdout","time":2711.495502646,"data":"       |     ux /= norm_u\n"}
,{"stream_name":"stdout","time":2711.495503869,"data":"       |     uy /= norm_u\n"}
,{"stream_name":"stdout","time":2711.495505083,"data":"       |     vAx = F[0] - A[0]\n"}
,{"stream_name":"stdout","time":2711.495506267,"data":"       |     vAy = F[1] - A[1]\n"}
,{"stream_name":"stdout","time":2711.495507453,"data":"       |     proj = vAx*ux + vAy*uy\n"}
,{"stream_name":"stdout","time":2711.49550866,"data":"       |     par_x = proj*ux\n"}
,{"stream_name":"stdout","time":2711.495509826,"data":"       |     par_y = proj*uy\n"}
,{"stream_name":"stdout","time":2711.495511034,"data":"       |     perp_x = vAx - par_x\n"}
,{"stream_name":"stdout","time":2711.495512242,"data":"       |     perp_y = vAy - par_y\n"}
,{"stream_name":"stdout","time":2711.495513426,"data":"       |     Ex = F[0] - 2*perp_x\n"}
,{"stream_name":"stdout","time":2711.495514658,"data":"       |     Ey = F[1] - 2*perp_y\n"}
,{"stream_name":"stdout","time":2711.495515863,"data":"       |     E = (Ex, Ey)\n"}
,{"stream_name":"stdout","time":2711.495517049,"data":"       |     # line EF direction\n"}
,{"stream_name":"stdout","time":2711.495518216,"data":"       |     vEFx = F[0] - E[0]\n"}
,{"stream_name":"stdout","time":2711.495519434,"data":"       |     vEFy = F[1] - E[1]\n"}
,{"stream_name":"stdout","time":2711.49552064,"data":"       |     # foot N from D to EF\n"}
,{"stream_name":"stdout","time":2711.49552184,"data":"       |     D = (p, mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.495523009,"data":"       |     Dx = D[0] - E[0]\n"}
,{"stream_name":"stdout","time":2711.495524223,"data":"       |     Dy = D[1] - E[1]\n"}
,{"stream_name":"stdout","time":2711.49552542,"data":"       |     t = (Dx*vEFx + Dy*vEFy) / (vEFx**2 + vEFy**2)\n"}
,{"stream_name":"stdout","time":2711.495526663,"data":"       |     Nx = E[0] + t*vEFx\n"}
,{"stream_name":"stdout","time":2711.495527822,"data":"       |     Ny = E[1] + t*vEFy\n"}
,{"stream_name":"stdout","time":2711.495529005,"data":"       |     N = (Nx, Ny)\n"}
,{"stream_name":"stdout","time":2711.495530211,"data":"       |     # compute O_T and ratio as before\n"}
,{"stream_name":"stdout","time":2711.495531449,"data":"       |     # Compute K as before\n"}
,{"stream_name":"stdout","time":2711.495532633,"data":"       |     # circumcenter O1\n"}
,{"stream_name":"stdout","time":2711.495533842,"data":"       |     xO1 = (p+q)/2\n"}
,{"stream_name":"stdout","time":2711.4955352,"data":"       |     yO1 = ((xA - xO1)**2 + yA**2 - xO1**2) / (2*yA)\n"}
,{"stream_name":"stdout","time":2711.495536447,"data":"       |     O1 = (xO1, yO1)\n"}
,{"stream_name":"stdout","time":2711.495537644,"data":"       |     R1_sq = xO1**2 + yO1**2\n"}
,{"stream_name":"stdout","time":2711.495539037,"data":"       |     # O2 circumcenter of AFE\n"}
,{"stream_name":"stdout","time":2711.495540339,"data":"       |     M = mp.matrix([[2*(Fx - xA), 2*(Fy - yA)],\n"}
,{"stream_name":"stdout","time":2711.495541564,"data":"       |                   [2*(Ex - xA), 2*(Ey - yA)]])\n"}
,{"stream_name":"stdout","time":2711.495542791,"data":"       |     rhs = mp.matrix([xA**2 - Fx**2 + yA**2 - Fy**2,\n"}
,{"stream_name":"stdout","time":2711.495544064,"data":"       |                      xA**2 - Ex**2 + yA**2 - Ey**2])\n"}
,{"stream_name":"stdout","time":2711.49554533,"data":"       |     sol = mp.lu_solve(M, rhs)\n"}
,{"stream_name":"stdout","time":2711.495546542,"data":"       |     ox2 = sol[0]\n"}
,{"stream_name":"stdout","time":2711.49554776,"data":"       |     oy2 = sol[1]\n"}
,{"stream_name":"stdout","time":2711.495548971,"data":"       |     O2 = (ox2, oy2)\n"}
,{"stream_name":"stdout","time":2711.495551878,"data":"       |     R2_sq = (ox2 - xA)**2 + (oy2 - yA)**2\n"}
,{"stream_name":"stdout","time":2711.495553155,"data":"       |     # vector d\n"}
,{"stream_name":"stdout","time":2711.495554371,"data":"       |     dx = ox2 - xO1\n"}
,{"stream_name":"stdout","time":2711.495555577,"data":"       |     dy = oy2 - yO1\n"}
,{"stream_name":"stdout","time":2711.495556775,"data":"       |     d_sq = dx**2 + dy**2\n"}
,{"stream_name":"stdout","time":2711.495557988,"data":"       |     d = mp.sqrt(d_sq)\n"}
,{"stream_name":"stdout","time":2711.495559175,"data":"       |     a_dist = (R1_sq - R2_sq + d_sq) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.495560395,"data":"       |     h_sq = R1_sq - a_dist**2\n"}
,{"stream_name":"stdout","time":2711.495561602,"data":"       |     ux_u = dx/d\n"}
,{"stream_name":"stdout","time":2711.495562792,"data":"       |     uy_u = dy/d\n"}
,{"stream_name":"stdout","time":2711.495563954,"data":"       |     Px = xO1 + a_dist*ux_u\n"}
,{"stream_name":"stdout","time":2711.495565169,"data":"       |     Py = yO1 + a_dist*uy_u\n"}
,{"stream_name":"stdout","time":2711.49556635,"data":"       |     perp_x = -uy_u\n"}
,{"stream_name":"stdout","time":2711.495567515,"data":"       |     perp_y = ux_u\n"}
,{"stream_name":"stdout","time":2711.49556876,"data":"       |     K1 = (Px + mp.sqrt(h_sq)*perp_x, Py + mp.sqrt(h_sq)*perp_y)\n"}
,{"stream_name":"stdout","time":2711.49557005,"data":"       |     K2 = (Px - mp.sqrt(h_sq)*perp_x, Py - mp.sqrt(h_sq)*perp_y)\n"}
,{"stream_name":"stdout","time":2711.495571301,"data":"       |     # choose K not equal to A\n"}
,{"stream_name":"stdout","time":2711.495572517,"data":"       |     if mp.sqrt((K1[0]-xA)**2 + (K1[1]-yA)**2) \u003e mp.mpf('1e-12'):\n"}
,{"stream_name":"stdout","time":2711.495573835,"data":"       |         K = K1\n"}
,{"stream_name":"stdout","time":2711.495575044,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.495576213,"data":"       |         K = K2\n"}
,{"stream_name":"stdout","time":2711.495577363,"data":"       |     # compute Ox for circle tangent to BN at B\n"}
,{"stream_name":"stdout","time":2711.495578595,"data":"       |     v_x = Nx\n"}
,{"stream_name":"stdout","time":2711.495579782,"data":"       |     v_y = Ny\n"}
,{"stream_name":"stdout","time":2711.495580951,"data":"       |     w_x = -v_y\n"}
,{"stream_name":"stdout","time":2711.495582091,"data":"       |     w_y = v_x\n"}
,{"stream_name":"stdout","time":2711.495583234,"data":"       |     k_x = K[0]\n"}
,{"stream_name":"stdout","time":2711.495584434,"data":"       |     k_y = K[1]\n"}
,{"stream_name":"stdout","time":2711.495585638,"data":"       |     D_cross = v_x*k_y - v_y*k_x\n"}
,{"stream_name":"stdout","time":2711.495586835,"data":"       |     K_norm_sq = k_x**2 + k_y**2\n"}
,{"stream_name":"stdout","time":2711.495588052,"data":"       |     s = (K_norm_sq / 2) / D_cross\n"}
,{"stream_name":"stdout","time":2711.495589287,"data":"       |     Ox = s * w_x\n"}
,{"stream_name":"stdout","time":2711.495590484,"data":"       |     # compute ratio\n"}
,{"stream_name":"stdout","time":2711.495591634,"data":"       |     CT = (p+q) - 2*Ox\n"}
,{"stream_name":"stdout","time":2711.495592789,"data":"       |     BT = 2*Ox\n"}
,{"stream_name":"stdout","time":2711.495593989,"data":"       |     NB = mp.sqrt(Nx**2 + Ny**2)\n"}
,{"stream_name":"stdout","time":2711.495595202,"data":"       |     NE = mp.sqrt((Nx-Ex)**2 + (Ny-Ey)**2)\n"}
,{"stream_name":"stdout","time":2711.495596437,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.495599256,"data":"       |     return ratio\n"}
