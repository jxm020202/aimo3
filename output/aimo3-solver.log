,{"stream_name":"stdout","time":3102.117841436,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":3102.117842476,"data":"       | \n"}
,{"stream_name":"stdout","time":3102.117843507,"data":"       | The midpoint of \\(BC\\) is  \n"}
