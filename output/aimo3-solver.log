,{"stream_name":"stdout","time":2711.484379876,"data":"       |         # projection factor t\n"}
,{"stream_name":"stdout","time":2711.484381093,"data":"       |         t = ((P[0] - A[0])*dx + (P[1] - A[1])*dy) / (dx*dx + dy*dy)\n"}
