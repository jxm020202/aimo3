,{"stream_name":"stdout","time":3398.354137563,"data":"       |     A2,B2,C2 = line_coeff(q1,q2)\n"}
,{"stream_name":"stdout","time":3398.354140403,"data":"       |     det = A1*B2 - A2*B1\n"}
