,{"stream_name":"stdout","time":2711.489501538,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.489504624,"data":"       |     # line BN direction vector\n"}
,{"stream_name":"stdout","time":2711.489505863,"data":"       |     import numpy as np, math\n"}
,{"stream_name":"stdout","time":2711.489507083,"data":"       |     B_np = np.array(B)\n"}
,{"stream_name":"stdout","time":2711.489508262,"data":"       |     N_np = np.array(N)\n"}
,{"stream_name":"stdout","time":2711.489509452,"data":"       |     BN_vec = N_np - B_np\n"}
,{"stream_name":"stdout","time":2711.48951069,"data":"       |     # perpendicular direction to BN (rotate 90 deg)\n"}
,{"stream_name":"stdout","time":2711.48951228,"data":"       |     perp_BN = np.array([-BN_vec[1], BN_vec[0]])  # 90 deg CCW\n"}
,{"stream_name":"stdout","time":2711.48951359,"data":"       |     # line L1: B + s * perp_BN\n"}
,{"stream_name":"stdout","time":2711.489515452,"data":"       |     # line L2: perpendicular bisector of BK\n"}
,{"stream_name":"stdout","time":2711.489516718,"data":"       |     K_np = np.array(K)\n"}
,{"stream_name":"stdout","time":2711.489517912,"data":"       |     # midpoint of BK\n"}
,{"stream_name":"stdout","time":2711.489519124,"data":"       |     mid_BK = (B_np + K_np)/2\n"}
,{"stream_name":"stdout","time":2711.489520334,"data":"       |     # direction of BK\n"}
,{"stream_name":"stdout","time":2711.48952153,"data":"       |     BK_vec = K_np - B_np\n"}
,{"stream_name":"stdout","time":2711.489522705,"data":"       |     # perpendicular to BK\n"}
,{"stream_name":"stdout","time":2711.489523907,"data":"       |     perp_BK = np.array([-BK_vec[1], BK_vec[0]])\n"}
,{"stream_name":"stdout","time":2711.48952516,"data":"       |     # line L2: mid_BK + t * perp_BK\n"}
,{"stream_name":"stdout","time":2711.489526368,"data":"       |     # Solve for intersection of L1 and L2\n"}
,{"stream_name":"stdout","time":2711.489527577,"data":"       |     # Solve B + s*perp_BN = mid_BK + t*perp_BK\n"}
,{"stream_name":"stdout","time":2711.489528781,"data":"       |     # 2 equations, 2 unknowns\n"}
,{"stream_name":"stdout","time":2711.489529956,"data":"       |     A_mat = np.column_stack((perp_BN, -perp_BK))\n"}
