,{"stream_name":"stdout","time":2711.48910096,"data":"       |     # intersection of circles: compute K (other than A)\n"}
,{"stream_name":"stdout","time":2711.489102211,"data":"       |     # Solve using circle intersection formulas\n"}
,{"stream_name":"stdout","time":2711.489103471,"data":"       |     # vector between centers\n"}
,{"stream_name":"stdout","time":2711.48910467,"data":"       |     O1_np = np.array(O1); O2_np = np.array(O2)\n"}
,{"stream_name":"stdout","time":2711.489105872,"data":"       |     d_cent = np.linalg.norm(O2_np - O1_np)\n"}
,{"stream_name":"stdout","time":2711.489107091,"data":"       |     # if circles intersect, compute intersection points\n"}
,{"stream_name":"stdout","time":2711.489108313,"data":"       |     # a = (R1^2 - R2^2 + d^2) / (2d)\n"}
,{"stream_name":"stdout","time":2711.489109487,"data":"       |     a = (R1**2 - R2**2 + d_cent**2) / (2*d_cent)\n"}
,{"stream_name":"stdout","time":2711.489110706,"data":"       |     # height h = sqrt(R1^2 - a^2)\n"}
,{"stream_name":"stdout","time":2711.489111916,"data":"       |     h_sq = R1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.489113115,"data":"       |     if h_sq \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.48911437,"data":"       |         h = 0.0\n"}
,{"stream_name":"stdout","time":2711.489115546,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.489116676,"data":"       |         h = math.sqrt(h_sq)\n"}
,{"stream_name":"stdout","time":2711.489117874,"data":"       |     # point P2 = O1 + a*(O2-O1)/d\n"}
,{"stream_name":"stdout","time":2711.489119052,"data":"       |     P2 = O1_np + a*(O2_np - O1_np)/d_cent\n"}
,{"stream_name":"stdout","time":2711.489120254,"data":"       |     # intersection points:\n"}
,{"stream_name":"stdout","time":2711.489121438,"data":"       |     # offset vector perpendicular to line O1O2: (-(y2-y1), x2-x1) normalized\n"}
,{"stream_name":"stdout","time":2711.489122782,"data":"       |     ox, oy = O2_np - O1_np\n"}
