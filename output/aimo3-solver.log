,{"stream_name":"stdout","time":3398.368031246,"data":"       |     x3,y3 = vertices[k]\n"}
,{"stream_name":"stdout","time":3398.368032347,"data":"       |     x4,y4 = vertices[l]\n"}
,{"stream_name":"stdout","time":3398.368033473,"data":"       |     # Solve for intersection of lines using linear algebra\n"}
,{"stream_name":"stdout","time":3398.368034673,"data":"       |     # line1: p = p1 + t*(p2-p1)\n"}
,{"stream_name":"stdout","time":3398.368035809,"data":"       |     # line2: q = p3 + u*(p4-p3)\n"}
,{"stream_name":"stdout","time":3398.368036989,"data":"       |     # Solve p1 + t*(p2-p1) = p3 + u*(p4-p3)\n"}
,{"stream_name":"stdout","time":3398.368038123,"data":"       |     # Use cross product method\n"}
,{"stream_name":"stdout","time":3398.368039239,"data":"       |     # Represent as A*t + B*u = C\n"}
,{"stream_name":"stdout","time":3398.368040374,"data":"       |     # Solve using determinant\n"}
,{"stream_name":"stdout","time":3398.368041503,"data":"       |     # Use sympy for exact?\n"}
,{"stream_name":"stdout","time":3398.368042636,"data":"       |     # We'll compute using numpy\n"}
,{"stream_name":"stdout","time":3398.36804377,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":3398.368044877,"data":"       |     A = np.array([[x2-x1, -(x4-x3)], [y2-y1, -(y4-y3)]], dtype=float)\n"}
,{"stream_name":"stdout","time":3398.368046119,"data":"       |     b = np.array([x3-x1, y3-y1], dtype=float)\n"}
,{"stream_name":"stdout","time":3398.368047251,"data":"       |     # solve A*[t,u]^T = b\n"}
,{"stream_name":"stdout","time":3398.36804838,"data":"       |     det = np.linalg.det(A)\n"}
,{"stream_name":"stdout","time":3398.368049501,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":3398.368050651,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.368051739,"data":"       |     t,u = np.linalg.solve(A,b)\n"}
,{"stream_name":"stdout","time":3398.368052869,"data":"       |     x = x1 + t*(x2-x1)\n"}
,{"stream_name":"stdout","time":3398.368054009,"data":"       |     y = y1 + t*(y2-y1)\n"}
,{"stream_name":"stdout","time":3398.368055157,"data":"       |     return (x,y)\n"}
,{"stream_name":"stdout","time":3398.368056269,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.368057354,"data":"       | def is_rectangle(rect):\n"}
,{"stream_name":"stdout","time":3398.368058456,"data":"       |     # rect is tuple of 4 chords (a1,a2,b1,b2) as defined earlier\n"}
,{"stream_name":"stdout","time":3398.368059659,"data":"       |     a1,a2,b1,b2 = rect\n"}
,{"stream_name":"stdout","time":3398.368061077,"data":"       |     # compute intersection points in order: a1∩b1, a1∩b2, a2∩b2, a2∩b1 (clockwise)\n"}
,{"stream_name":"stdout","time":3398.36806242,"data":"       |     p1 = intersection_point(a1,b1)\n"}
,{"stream_name":"stdout","time":3398.368063529,"data":"       |     p2 = intersection_point(a1,b2)\n"}
,{"stream_name":"stdout","time":3398.368064699,"data":"       |     p3 = intersection_point(a2,b2)\n"}
,{"stream_name":"stdout","time":3398.368065806,"data":"       |     p4 = intersection_point(a2,b1)\n"}
,{"stream_name":"stdout","time":3398.368066919,"data":"       |     if None in (p1,p2,p3,p4):\n"}
,{"stream_name":"stdout","time":3398.368068057,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.368069186,"data":"       |     # check rectangle: vectors p2-p1 and p4-p1 should be perpendicular and lengths correspond\n"}
,{"stream_name":"stdout","time":3398.368072323,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":3398.36807346,"data":"       |     v1 = np.array(p2) - np.array(p1)\n"}
,{"stream_name":"stdout","time":3398.368074616,"data":"       |     v2 = np.array(p4) - np.array(p1)\n"}
,{"stream_name":"stdout","time":3398.368075836,"data":"       |     # dot product zero?\n"}
,{"stream_name":"stdout","time":3398.368076933,"data":"       |     if abs(np.dot(v1, v2)) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":3398.368078121,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.368079263,"data":"       |     # check opposite sides parallel: v1 should be parallel to p3-p4, v2 parallel to p3-p2\n"}
,{"stream_name":"stdout","time":3398.368080494,"data":"       |     v3 = np.array(p3) - np.array(p4)\n"}
,{"stream_name":"stdout","time":3398.368081636,"data":"       |     v4 = np.array(p3) - np.array(p2)\n"}
,{"stream_name":"stdout","time":3398.368082787,"data":"       |     # check cross product magnitude near zero for parallelism\n"}
,{"stream_name":"stdout","time":3398.368083991,"data":"       |     if abs(np.cross(v1, v3)) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":3398.368085151,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.368086249,"data":"       |     if abs(np.cross(v2, v4)) \u003e 1e-8:\n"}
,{"stream_name":"stdout","time":3398.368087433,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.368088549,"data":"       |     return True\n"}
,{"stream_name":"stdout","time":3398.368089677,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.368090754,"data":"       | # verify all counted rectangles satisfy rectangle condition\n"}
,{"stream_name":"stdout","time":3398.368091939,"data":"       | total_rects = []\n"}
