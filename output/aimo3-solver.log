,{"stream_name":"stdout","time":2711.472910726,"data":"       |     if O_BKKp is None:\n"}
,{"stream_name":"stdout","time":2711.472911935,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472913127,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.47291438,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
,{"stream_name":"stdout","time":2711.472915673,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.472916852,"data":"       |     BN_vec = (N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.47291804,"data":"       |     d1 = (-BN_vec[1], BN_vec[0])\n"}
,{"stream_name":"stdout","time":2711.472919223,"data":"       |     M = ((B[0]+K[0])/2.0, (B[1]+K[1])/2.0)\n"}
,{"stream_name":"stdout","time":2711.472920461,"data":"       |     BK_vec = (K[0]-B[0], K[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472921668,"data":"       |     d2 = (-BK_vec[1], BK_vec[0])\n"}
