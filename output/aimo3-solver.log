,{"stream_name":"stdout","time":2937.177312787,"data":"       | - 2: v2=1\n"}
,{"stream_name":"stdout","time":2937.177313912,"data":"       | - 4: v2=2\n"}
,{"stream_name":"stdout","time":2937.177315054,"data":"       | - 6: v2=1 (since 6=2*3)\n"}
