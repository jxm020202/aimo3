,{"stream_name":"stdout","time":2711.484335904,"data":"       |     def circle_intersections_mp(c1, r1, c2, r2):\n"}
,{"stream_name":"stdout","time":2711.484337137,"data":"       |         x0,y0 = c1\n"}
,{"stream_name":"stdout","time":2711.484338317,"data":"       |         x1,y1 = c2\n"}
,{"stream_name":"stdout","time":2711.484339514,"data":"       |         dx = x1 - x0\n"}
,{"stream_name":"stdout","time":2711.484340679,"data":"       |         dy = y1 - y0\n"}
,{"stream_name":"stdout","time":2711.484341887,"data":"       |         d = mp.sqrt(dx**2 + dy**2)\n"}
,{"stream_name":"stdout","time":2711.484343097,"data":"       |         if d \u003e r1 + r2 or d \u003c abs(r1 - r2):\n"}
,{"stream_name":"stdout","time":2711.484344423,"data":"       |             return []\n"}
,{"stream_name":"stdout","time":2711.484345666,"data":"       |         a = (r1**2 - r2**2 + d**2) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.484346913,"data":"       |         h_sq = r1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.484348097,"data":"       |         h = mp.sqrt(max(h_sq, 0))\n"}
,{"stream_name":"stdout","time":2711.484349283,"data":"       |         xm = x0 + a*dx/d\n"}
,{"stream_name":"stdout","time":2711.484350484,"data":"       |         ym = y0 + a*dy/d\n"}
,{"stream_name":"stdout","time":2711.484351703,"data":"       |         rx = -dy * (h/d)\n"}
,{"stream_name":"stdout","time":2711.484352891,"data":"       |         ry = dx * (h/d)\n"}
,{"stream_name":"stdout","time":2711.484354053,"data":"       |         p1 = (xm + rx, ym + ry)\n"}
,{"stream_name":"stdout","time":2711.484355243,"data":"       |         p2 = (xm - rx, ym - ry)\n"}
,{"stream_name":"stdout","time":2711.484356466,"data":"       |         if h \u003c mp.mpf('1e-30'):\n"}
,{"stream_name":"stdout","time":2711.484357729,"data":"       |             return [p1]\n"}
,{"stream_name":"stdout","time":2711.484358913,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":2711.484360076,"data":"       |             return [p1, p2]\n"}
,{"stream_name":"stdout","time":2711.484361301,"data":"       |     inters = circle_intersections_mp(c1, r1, c2, r2)\n"}
