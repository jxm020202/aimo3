,{"stream_name":"stdout","time":2711.470415034,"data":"       |     NE = mp.sqrt((N[0]-E[0])**2 + (N[1]-E[1])**2)\n"}
,{"stream_name":"stdout","time":2711.470416381,"data":"       |     return NB, NE\n"}
