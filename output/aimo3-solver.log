,{"stream_name":"stdout","time":2711.491293145,"data":"       |     N=2000\n"}
,{"stream_name":"stdout","time":2711.491294302,"data":"       |     xs = np.linspace(1e-9, p-1e-9, N+1)\n"}
,{"stream_name":"stdout","time":2711.491295521,"data":"       |     vals = [det_numeric(p,q,x) for x in xs]\n"}
,{"stream_name":"stdout","time":2711.491296775,"data":"       |     roots = []\n"}
,{"stream_name":"stdout","time":2711.491297993,"data":"       |     for i in range(N):\n"}
,{"stream_name":"stdout","time":2711.491299195,"data":"       |         if vals[i]==0:\n"}
,{"stream_name":"stdout","time":2711.491300363,"data":"       |             roots.append(xs[i])\n"}
,{"stream_name":"stdout","time":2711.491301541,"data":"       |         elif vals[i]*vals[i+1] \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.491302773,"data":"       |             low, high = xs[i], xs[i+1]\n"}
,{"stream_name":"stdout","time":2711.491303996,"data":"       |             for _ in range(60):\n"}
,{"stream_name":"stdout","time":2711.4913052,"data":"       |                 mid = (low+high)/2\n"}
,{"stream_name":"stdout","time":2711.491306403,"data":"       |                 fmid = det_numeric(p,q,mid)\n"}
,{"stream_name":"stdout","time":2711.491307664,"data":"       |                 if vals[i]*fmid \u003c= 0:\n"}
,{"stream_name":"stdout","time":2711.491308895,"data":"       |                     high = mid\n"}
,{"stream_name":"stdout","time":2711.491310103,"data":"       |                 else:\n"}
,{"stream_name":"stdout","time":2711.491311264,"data":"       |                     low = mid\n"}
,{"stream_name":"stdout","time":2711.491312449,"data":"       |                 # update vals[i] maybe not needed\n"}
,{"stream_name":"stdout","time":2711.491313701,"data":"       |             roots.append((low+high)/2)\n"}
,{"stream_name":"stdout","time":2711.491314958,"data":"       |     return roots\n"}
