,{"stream_name":"stdout","time":3398.367976387,"data":"       |     # compute intersection points in order: a1∩b1, a1∩b2, a2∩b2, a2∩b1 (clockwise)\n"}
,{"stream_name":"stdout","time":3398.367977701,"data":"       |     p1 = intersection_point(a1,b1)\n"}
