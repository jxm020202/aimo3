,{"stream_name":"stdout","time":2711.489127789,"data":"       |     inter2 = P2 - h * perp_vec\n"}
,{"stream_name":"stdout","time":2711.489129019,"data":"       |     # Choose the one not equal to A\n"}
,{"stream_name":"stdout","time":2711.489130505,"data":"       |     def close(pt1, pt2, eps=1e-6):\n"}
,{"stream_name":"stdout","time":2711.489131734,"data":"       |         return distance(pt1, pt2) \u003c eps\n"}
,{"stream_name":"stdout","time":2711.489133032,"data":"       |     if close(inter1, A):\n"}
,{"stream_name":"stdout","time":2711.489134237,"data":"       |         K = tuple(inter2.tolist())\n"}
,{"stream_name":"stdout","time":2711.489135452,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.489136594,"data":"       |         K = tuple(inter1.tolist())\n"}
,{"stream_name":"stdout","time":2711.489137797,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.489139002,"data":"       |     # reflect point K across line EF using same method as for E\n"}
,{"stream_name":"stdout","time":2711.489140294,"data":"       |     K_np = np.array(K)\n"}
,{"stream_name":"stdout","time":2711.489141446,"data":"       |     # reflect across line through E with direction v\n"}
,{"stream_name":"stdout","time":2711.4891427,"data":"       |     v = F_np - E_np\n"}
,{"stream_name":"stdout","time":2711.489143899,"data":"       |     v_norm = v / np.linalg.norm(v)\n"}
,{"stream_name":"stdout","time":2711.489145112,"data":"       |     # compute projection of (K-E) onto v\n"}
,{"stream_name":"stdout","time":2711.489146346,"data":"       |     KE = K_np - E_np\n"}
,{"stream_name":"stdout","time":2711.48914751,"data":"       |     proj_K = np.dot(KE, v_norm) * v_norm\n"}
,{"stream_name":"stdout","time":2711.489148734,"data":"       |     perp_K = KE - proj_K\n"}
,{"stream_name":"stdout","time":2711.489149903,"data":"       |     Kprime_np = K_np - 2*perp_K\n"}
,{"stream_name":"stdout","time":2711.489151083,"data":"       |     Kprime = tuple(Kprime_np.tolist())\n"}
,{"stream_name":"stdout","time":2711.489152284,"data":"       |     return A,B,C,F,E,N,K,Kprime\n"}
,{"stream_name":"stdout","time":2711.489153522,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489154646,"data":"       | def cyclic_condition_ptolemy(p,q,r):\n"}
,{"stream_name":"stdout","time":2711.489155844,"data":"       |     A,B,C,F,E,N,K,Kprime = compute_points(p,q,r)\n"}
,{"stream_name":"stdout","time":2711.489157066,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.489158226,"data":"       |     BK = distance(B,K)\n"}
,{"stream_name":"stdout","time":2711.489159398,"data":"       |     BN = distance(B,N)\n"}
,{"stream_name":"stdout","time":2711.489160574,"data":"       |     NKprime = distance(N,Kprime)\n"}
,{"stream_name":"stdout","time":2711.489161758,"data":"       |     BN_KKprime = BN * distance(K,Kprime)\n"}
,{"stream_name":"stdout","time":2711.48916298,"data":"       |     BK_NKprime = BK * NKprime\n"}
,{"stream_name":"stdout","time":2711.489164152,"data":"       |     NK_BKprime = distance(N,K) * distance(B,Kprime)\n"}
,{"stream_name":"stdout","time":2711.489165387,"data":"       |     # Ptolemy condition: BK * N K' = BN * K K' + NK * B K'\n"}
,{"stream_name":"stdout","time":2711.489166666,"data":"       |     return BK_NKprime - (BN * distance(K,Kprime) + distance(N,K) * distance(B,Kprime))\n"}
,{"stream_name":"stdout","time":2711.489168011,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489169133,"data":"       | # test for p=2,q=3\n"}
,{"stream_name":"stdout","time":2711.489170287,"data":"       | for r_guess in [0.5,0.6,0.7,0.8]:\n"}
,{"stream_name":"stdout","time":2711.489173106,"data":"       |     print(r_guess, cyclic_condition_ptolemy(p_val,q_val,r_guess))\n"}
