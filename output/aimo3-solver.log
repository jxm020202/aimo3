,{"stream_name":"stdout","time":3398.356586853,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.356588028,"data":"       |     # Check Pythagorean: diagonal^2 ≈ 2*side^2\n"}
,{"stream_name":"stdout","time":3398.35658928,"data":"       |     if not abs(dists[4]**2 - 2*dists[0]**2) \u003c 1e-5:\n"}
,{"stream_name":"stdout","time":3398.356590575,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.356591731,"data":"       |     return True\n"}
,{"stream_name":"stdout","time":3398.356592885,"data":"       | \n"}
