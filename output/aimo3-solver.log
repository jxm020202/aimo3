,{"stream_name":"stdout","time":2711.470393818,"data":"       |     y = mp.sqrt(c**2 - x**2)\n"}
,{"stream_name":"stdout","time":2711.470395078,"data":"       |     s = c + d + Delta\n"}
,{"stream_name":"stdout","time":2711.470396361,"data":"       |     area = 0.5 * L * y\n"}
,{"stream_name":"stdout","time":2711.470397595,"data":"       |     r = area / s\n"}
