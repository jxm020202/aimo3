,{"stream_name":"stdout","time":2711.472813845,"data":"       |     if O_BKKp is None:\n"}
,{"stream_name":"stdout","time":2711.472815041,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472816248,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472817799,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
