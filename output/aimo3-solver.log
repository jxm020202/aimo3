,{"stream_name":"stdout","time":2711.478677032,"data":"       | def compute_ratio(n, r_val):\n"}
,{"stream_name":"stdout","time":2711.478678288,"data":"       |     # Fibonacci numbers\n"}
,{"stream_name":"stdout","time":2711.478680153,"data":"       |     F = [0,1]\n"}
,{"stream_name":"stdout","time":2711.478681379,"data":"       |     for i in range(2, n+3):\n"}
