,{"stream_name":"stdout","time":3102.114805402,"data":"       \u003e 147*sqrt(37)*(39*(74*s - 11)*sqrt(144*(s - 1)**2 + (2*s - 9)**2) - 5*(370*s + 99)*sqrt(144*(s - 1)**2 + (2*s + 5)**2))/5476\n"}
,{"stream_name":"stdout","time":3102.114806792,"data":"       \u003e \n"}
