,{"stream_name":"stdout","time":2711.472753264,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.472754443,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472755669,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472756868,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.472758058,"data":"       |     # compute A intersection BF and CE\n"}
,{"stream_name":"stdout","time":2711.472759287,"data":"       |     # BF: (t*x_f, t*y_f)\n"}
,{"stream_name":"stdout","time":2711.472760509,"data":"       |     # CE: (a + s*(x_e - a), s*y_e)\n"}
,{"stream_name":"stdout","time":2711.472761703,"data":"       |     if abs(y_f) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472762925,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472764114,"data":"       |     denom = (y_e * x_f / y_f - (x_e - a))\n"}
