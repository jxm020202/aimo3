,{"stream_name":"stdout","time":2711.472186302,"data":"       | def intersect_circles(O1, R1, O2, R2):\n"}
,{"stream_name":"stdout","time":2711.472187524,"data":"       |     x1,y1 = O1\n"}
,{"stream_name":"stdout","time":2711.472188711,"data":"       |     x2,y2 = O2\n"}
,{"stream_name":"stdout","time":2711.472189858,"data":"       |     dx = x2 - x1\n"}
,{"stream_name":"stdout","time":2711.472191015,"data":"       |     dy = y2 - y1\n"}
,{"stream_name":"stdout","time":2711.472192198,"data":"       |     d = math.hypot(dx, dy)\n"}
,{"stream_name":"stdout","time":2711.472193371,"data":"       |     if d == 0:\n"}
,{"stream_name":"stdout","time":2711.472194572,"data":"       |         return []\n"}
,{"stream_name":"stdout","time":2711.472195766,"data":"       |     a = (R1**2 - R2**2 + d**2) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.47219698,"data":"       |     h_sq = R1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.47219814,"data":"       |     if h_sq \u003c -1e-12:\n"}
,{"stream_name":"stdout","time":2711.472199346,"data":"       |         return []\n"}
,{"stream_name":"stdout","time":2711.472200529,"data":"       |     h = math.sqrt(max(0.0, h_sq))\n"}
,{"stream_name":"stdout","time":2711.472201742,"data":"       |     xm = x1 + a * dx / d\n"}
,{"stream_name":"stdout","time":2711.472202947,"data":"       |     ym = y1 + a * dy / d\n"}
,{"stream_name":"stdout","time":2711.472205345,"data":"       |     rx = -dy * (h / d)\n"}
,{"stream_name":"stdout","time":2711.472206578,"data":"       |     ry = dx * (h / d)\n"}
,{"stream_name":"stdout","time":2711.472207763,"data":"       |     p1 = (xm + rx, ym + ry)\n"}
,{"stream_name":"stdout","time":2711.472208962,"data":"       |     p2 = (xm - rx, ym - ry)\n"}
,{"stream_name":"stdout","time":2711.47221018,"data":"       |     return [p1, p2]\n"}
