,{"stream_name":"stdout","time":2711.475743312,"data":"       |             cond_hi = cond_mid\n"}
,{"stream_name":"stdout","time":2711.475744475,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":2711.475745644,"data":"       |             lo = mid\n"}
,{"stream_name":"stdout","time":2711.47574681,"data":"       |             cond_lo = cond_mid\n"}
,{"stream_name":"stdout","time":2711.475748023,"data":"       |     return (lo+hi)/2\n"}
