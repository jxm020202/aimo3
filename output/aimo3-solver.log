,{"stream_name":"stdout","time":2711.47010381,"data":"       |     c = find_c_solution_precise(n)\n"}
,{"stream_name":"stdout","time":2711.470105041,"data":"       |     # compute ratio and also t using earlier method (cyclic_ratio_for_c)\n"}
,{"stream_name":"stdout","time":2711.470106328,"data":"       |     # We'll compute t from that function\n"}
,{"stream_name":"stdout","time":2711.470107534,"data":"       |     # Let's modify cyclic_ratio_for_c to also return t\n"}
,{"stream_name":"stdout","time":2711.470108775,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.470109961,"data":"     [Output]:\n"}
