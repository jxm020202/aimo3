,{"stream_name":"stdout","time":2937.173784959,"data":"       |     # compute Q = (x^d + 1) // P\n"}
,{"stream_name":"stdout","time":2937.173786128,"data":"       |     quotient, remainder = sp.div(x**d + 1, P_expr, domain=sp.ZZ)\n"}
,{"stream_name":"stdout","time":2937.173787656,"data":"       |     if remainder != 0:\n"}
,{"stream_name":"stdout","time":2937.173788876,"data":"       |         return False\n"}
