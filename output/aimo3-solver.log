,{"stream_name":"stdout","time":3398.358439724,"data":"       | def is_rectangle(rect):\n"}
,{"stream_name":"stdout","time":3398.35844087,"data":"       |     verts = rectangle_vertices(rect)\n"}
,{"stream_name":"stdout","time":3398.358442052,"data":"       |     # convert to numeric\n"}
,{"stream_name":"stdout","time":3398.358443236,"data":"       |     pts = [(float(v.x), float(v.y)) for v in verts]\n"}
,{"stream_name":"stdout","time":3398.358444437,"data":"       |     # compute side vectors\n"}
,{"stream_name":"stdout","time":3398.358445633,"data":"       |     # order: we have vertices as (a1∩b1), (a1∩b2), (a2∩b1), (a2∩b2)\n"}
,{"stream_name":"stdout","time":3398.358446944,"data":"       |     # This order may not be cyclic; we need to sort them in cyclic order.\n"}
,{"stream_name":"stdout","time":3398.358448184,"data":"       |     # Let's compute convex hull order (clockwise).\n"}
,{"stream_name":"stdout","time":3398.358449438,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":3398.358450583,"data":"       |     pts_arr = np.array(pts)\n"}
,{"stream_name":"stdout","time":3398.358451752,"data":"       |     # compute centroid\n"}
,{"stream_name":"stdout","time":3398.358452912,"data":"       |     centroid = pts_arr.mean(axis=0)\n"}
,{"stream_name":"stdout","time":3398.358454082,"data":"       |     # compute angles from centroid\n"}
,{"stream_name":"stdout","time":3398.358455278,"data":"       |     angles = np.arctan2(pts_arr[:,1]-centroid[1], pts_arr[:,0]-centroid[0])\n"}
,{"stream_name":"stdout","time":3398.358456543,"data":"       |     order = np.argsort(angles)\n"}
,{"stream_name":"stdout","time":3398.35845771,"data":"       |     ordered = pts_arr[order]\n"}
,{"stream_name":"stdout","time":3398.358458892,"data":"       |     # compute vectors of consecutive edges\n"}
,{"stream_name":"stdout","time":3398.358460075,"data":"       |     edges = np.roll(ordered, -1, axis=0) - ordered\n"}
,{"stream_name":"stdout","time":3398.358461287,"data":"       |     # compute dot products of consecutive edges\n"}
,{"stream_name":"stdout","time":3398.358462519,"data":"       |     dot = np.einsum('ij,ij-\u003ei', edges, np.roll(edges, -1, axis=0))\n"}
,{"stream_name":"stdout","time":3398.358463806,"data":"       |     # check if all dot products ~0 (right angles)\n"}
,{"stream_name":"stdout","time":3398.358465018,"data":"       |     return np.allclose(dot, 0, atol=1e-6)\n"}
