,{"stream_name":"stdout","time":3398.36794904,"data":"       |     # Solve for intersection of lines using linear algebra\n"}
,{"stream_name":"stdout","time":3398.367950219,"data":"       |     # line1: p = p1 + t*(p2-p1)\n"}
