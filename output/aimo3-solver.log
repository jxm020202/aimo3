[{"stream_name":"stdout","time":2711.466762223,"data":"       |     e = float(sp.fibonacci(n+1))\n"}
,{"stream_name":"stdout","time":2711.467897957,"data":"       |     Delta = float(sp.fibonacci(n-1))\n"}
