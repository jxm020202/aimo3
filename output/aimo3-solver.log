,{"stream_name":"stdout","time":2711.471310655,"data":"       |     # condition: B,N,K,K' cyclic\n"}
,{"stream_name":"stdout","time":2711.471312239,"data":"       |     # compute circumcircle of B,K,K'\n"}
,{"stream_name":"stdout","time":2711.471314145,"data":"       |     circ_BKKp = sp.Circle(B, K, K_prime)\n"}
,{"stream_name":"stdout","time":2711.471315456,"data":"       |     # condition: N lies on this circle =\u003e distance from N to center equals radius\n"}
,{"stream_name":"stdout","time":2711.471316796,"data":"       |     cond_expr = (N.distance(circ_BKKp.center) - circ_BKKp.radius).simplify()\n"}
,{"stream_name":"stdout","time":2711.471318112,"data":"       |     # Now compute T: circle through B and K tangent to line BN at B\n"}
,{"stream_name":"stdout","time":2711.471319389,"data":"       |     # line BN\n"}
,{"stream_name":"stdout","time":2711.471320555,"data":"       |     line_BN = sp.Line(B, N)\n"}
,{"stream_name":"stdout","time":2711.471321785,"data":"       |     # perpendicular to BN through B (center lies on this line)\n"}
,{"stream_name":"stdout","time":2711.47132305,"data":"       |     # line perp to BN through B:\n"}
,{"stream_name":"stdout","time":2711.471324238,"data":"       |     line_perp_BN = line_BN.perpendicular_line(B)\n"}
,{"stream_name":"stdout","time":2711.471325498,"data":"       |     # perpendicular bisector of BK\n"}
,{"stream_name":"stdout","time":2711.471326703,"data":"       |     mid_BK = sp.Point((B.x + K.x)/2, (B.y + K.y)/2)\n"}
,{"stream_name":"stdout","time":2711.471327972,"data":"       |     line_perp_BK = sp.Line(B, K).perpendicular_line(mid_BK)\n"}
,{"stream_name":"stdout","time":2711.471329223,"data":"       |     # center O_T is intersection\n"}
,{"stream_name":"stdout","time":2711.471330415,"data":"       |     O_T = line_perp_BN.intersection(line_perp_BK)[0]\n"}
,{"stream_name":"stdout","time":2711.471331692,"data":"       |     # radius\n"}
,{"stream_name":"stdout","time":2711.471332842,"data":"       |     R_T = O_T.distance(B)\n"}
,{"stream_name":"stdout","time":2711.471334052,"data":"       |     # circle equation: (x - O_T.x)^2 + (y - O_T.y)^2 = R_T^2\n"}
,{"stream_name":"stdout","time":2711.47133535,"data":"       |     # intersect with BC (x-axis y=0) to find T (other than B)\n"}
,{"stream_name":"stdout","time":2711.471336595,"data":"       |     # Solve for x coordinate where y=0\n"}
,{"stream_name":"stdout","time":2711.471337801,"data":"       |     x = sp.symbols('x', real=True)\n"}
,{"stream_name":"stdout","time":2711.47133899,"data":"       |     eq = (x - O_T.x)**2 + (0 - O_T.y)**2 - R_T**2\n"}
,{"stream_name":"stdout","time":2711.471341286,"data":"       |     sol_x = sp.solve(eq, x)\n"}
,{"stream_name":"stdout","time":2711.471342522,"data":"       |     # there will be two solutions: x = B.x = 0 and x = other\n"}
,{"stream_name":"stdout","time":2711.47134378,"data":"       |     # choose the one not equal to 0\n"}
,{"stream_name":"stdout","time":2711.471344995,"data":"       |     T_x = None\n"}
,{"stream_name":"stdout","time":2711.47134622,"data":"       |     for sol in sol_x:\n"}
,{"stream_name":"stdout","time":2711.471347395,"data":"       |         if not sp.simplify(sol).equals(0):\n"}
,{"stream_name":"stdout","time":2711.471348665,"data":"       |             T_x = sol\n"}
,{"stream_name":"stdout","time":2711.471349841,"data":"       |     T = sp.Point(T_x, 0)\n"}
,{"stream_name":"stdout","time":2711.471351016,"data":"       |     # compute distances\n"}
,{"stream_name":"stdout","time":2711.471352182,"data":"       |     CT = C.distance(T)\n"}
