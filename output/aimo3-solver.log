,{"stream_name":"stdout","time":3398.354211663,"data":"       | def line_coeff(p, q):\n"}
,{"stream_name":"stdout","time":3398.354212847,"data":"       |     # return (A,B,C) for line Ax + By = C\n"}
,{"stream_name":"stdout","time":3398.354214085,"data":"       |     (x1,y1) = p\n"}
