,{"stream_name":"stdout","time":2711.486750279,"data":"       | def circumcenter_sym(p1, p2, p3):\n"}
,{"stream_name":"stdout","time":2711.486751484,"data":"       |     x1,y1 = p1.x, p1.y\n"}
