,{"stream_name":"stdout","time":2711.484293563,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.484294666,"data":"       | def compute_ratio_mp(B):\n"}
,{"stream_name":"stdout","time":2711.484295839,"data":"       |     C = 2*mp.atan(phi*mp.tan(B/2))\n"}
,{"stream_name":"stdout","time":2711.484297029,"data":"       |     # define points with r=1\n"}
,{"stream_name":"stdout","time":2711.4842982,"data":"       |     D = (mp.mpf(1), mp.mpf(0))\n"}
,{"stream_name":"stdout","time":2711.484299386,"data":"       |     E = (-mp.cos(C), mp.sin(C))\n"}
,{"stream_name":"stdout","time":2711.484300573,"data":"       |     F = (-mp.cos(B), -mp.sin(B))\n"}
,{"stream_name":"stdout","time":2711.484301826,"data":"       |     yB = (-1 - mp.cos(B))/mp.sin(B)\n"}
,{"stream_name":"stdout","time":2711.484303039,"data":"       |     Bpt = (mp.mpf(1), yB)\n"}
,{"stream_name":"stdout","time":2711.484304253,"data":"       |     yC = (1 + mp.cos(C))/mp.sin(C)\n"}
,{"stream_name":"stdout","time":2711.484305694,"data":"       |     Cpt = (mp.mpf(1), yC)\n"}
,{"stream_name":"stdout","time":2711.484306873,"data":"       |     denom = mp.sin(B + C)\n"}
,{"stream_name":"stdout","time":2711.484308051,"data":"       |     Ax = -(mp.sin(B) + mp.sin(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.484309254,"data":"       |     Ay = (mp.cos(B) - mp.cos(C)) / denom\n"}
,{"stream_name":"stdout","time":2711.484310469,"data":"       |     Apt = (Ax, Ay)\n"}
,{"stream_name":"stdout","time":2711.484311673,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.484312834,"data":"       |     def circumcenter_mp(p1, p2, p3):\n"}
,{"stream_name":"stdout","time":2711.484314066,"data":"       |         x1,y1 = p1\n"}
,{"stream_name":"stdout","time":2711.484315266,"data":"       |         x2,y2 = p2\n"}
,{"stream_name":"stdout","time":2711.484316479,"data":"       |         x3,y3 = p3\n"}
,{"stream_name":"stdout","time":2711.484317657,"data":"       |         d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.484318887,"data":"       |         if mp.almosteq(d, 0):\n"}
,{"stream_name":"stdout","time":2711.484320079,"data":"       |             return None\n"}
,{"stream_name":"stdout","time":2711.484321306,"data":"       |         ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2)) / d\n"}
,{"stream_name":"stdout","time":2711.484322699,"data":"       |         uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1)) / d\n"}
,{"stream_name":"stdout","time":2711.484324023,"data":"       |         r = mp.sqrt((ux - x1)**2 + (uy - y1)**2)\n"}
,{"stream_name":"stdout","time":2711.484326263,"data":"       |         return (ux, uy), r\n"}
,{"stream_name":"stdout","time":2711.484327461,"data":"       |     center_AEF = circumcenter_mp(Apt, E, F)\n"}
,{"stream_name":"stdout","time":2711.484328693,"data":"       |     center_ABC = circumcenter_mp(Apt, Bpt, Cpt)\n"}
,{"stream_name":"stdout","time":2711.484329921,"data":"       |     if center_AEF is None or center_ABC is None:\n"}
