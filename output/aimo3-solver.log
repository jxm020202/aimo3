,{"stream_name":"stdout","time":3398.369228921,"data":"       |     x2,y2 = verts[j]\n"}
,{"stream_name":"stdout","time":3398.369230072,"data":"       |     # return line coefficients (A,B,C) for line Ax + By = C\n"}
,{"stream_name":"stdout","time":3398.369231411,"data":"       |     # using cross product: (y2 - y1)x - (x2 - x1) y = (y2 - y1)x1 - (x2 - x1) y1\n"}
,{"stream_name":"stdout","time":3398.369235645,"data":"       |     A = y2 - y1\n"}
,{"stream_name":"stdout","time":3398.369236895,"data":"       |     B = -(x2 - x1)\n"}
,{"stream_name":"stdout","time":3398.369238003,"data":"       |     C = A*x1 + B*y1\n"}
,{"stream_name":"stdout","time":3398.369239223,"data":"       |     return (A,B,C)\n"}
,{"stream_name":"stdout","time":3398.369240349,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369241567,"data":"       | def intersect(line1, line2):\n"}
