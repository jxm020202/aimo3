,{"stream_name":"stdout","time":2711.473620932,"data":"       | def compute_ratio_numeric(c0, d0, r):\n"}
,{"stream_name":"stdout","time":2711.473622199,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.473624003,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.473625199,"data":"       |     C = (a, 0.0)\n"}
,{"stream_name":"stdout","time":2711.47362652,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.47362769,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.473628935,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.473630186,"data":"       |     F = (x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.473631604,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.47363276,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.473635057,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.473636318,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.473637625,"data":"       |     # compute A intersection BF and CE\n"}
,{"stream_name":"stdout","time":2711.473638867,"data":"       |     if abs(y_f) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.473640117,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473641307,"data":"       |     denom = (y_e * x_f / y_f - (x_e - a))\n"}
,{"stream_name":"stdout","time":2711.473642632,"data":"       |     if abs(denom) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.473643852,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473645047,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.473646238,"data":"       |     t = s * y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.473647427,"data":"       |     A = (t * x_f, t * y_f)\n"}
,{"stream_name":"stdout","time":2711.473648629,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.473649814,"data":"       |     O_ABC = circumcenter(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.473651041,"data":"       |     if O_ABC is None:\n"}
,{"stream_name":"stdout","time":2711.473652352,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473653525,"data":"       |     R_ABC = math.hypot(O_ABC[0]-A[0], O_ABC[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.473654803,"data":"       |     O_AEF = circumcenter(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.473655985,"data":"       |     if O_AEF is None:\n"}
,{"stream_name":"stdout","time":2711.473657158,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473658343,"data":"       |     R_AEF = math.hypot(O_AEF[0]-A[0], O_AEF[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.473659594,"data":"       |     # intersection points of circles\n"}
,{"stream_name":"stdout","time":2711.473660845,"data":"       |     pts = intersect_circles(O_ABC, R_ABC, O_AEF, R_AEF)\n"}
,{"stream_name":"stdout","time":2711.473662104,"data":"       |     if len(pts) \u003c 2:\n"}
,{"stream_name":"stdout","time":2711.473663293,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473664515,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.47366567,"data":"       |     for pt in pts:\n"}
,{"stream_name":"stdout","time":2711.473666862,"data":"       |         if math.hypot(pt[0]-A[0], pt[1]-A[1]) \u003e 1e-6:\n"}
,{"stream_name":"stdout","time":2711.473668116,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.473669278,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.473670445,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473671645,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.473672864,"data":"       |     K_prime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.473674103,"data":"       |     # N foot from D to EF\n"}
,{"stream_name":"stdout","time":2711.473675284,"data":"       |     D = (c0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.473676477,"data":"       |     N = foot_of_perpendicular(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.473677702,"data":"       |     # condition: B,N,K,K' cyclic\n"}
,{"stream_name":"stdout","time":2711.473678927,"data":"       |     O_BKKp = circumcenter(B, K, K_prime)\n"}
,{"stream_name":"stdout","time":2711.473681554,"data":"       |     if O_BKKp is None:\n"}
,{"stream_name":"stdout","time":2711.473682804,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473684015,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.473685322,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
,{"stream_name":"stdout","time":2711.473686583,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.47368776,"data":"       |     BN_vec = (N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.473688988,"data":"       |     d1 = (-BN_vec[1], BN_vec[0])\n"}
,{"stream_name":"stdout","time":2711.473690186,"data":"       |     M = ((B[0]+K[0])/2.0, (B[1]+K[1])/2.0)\n"}
,{"stream_name":"stdout","time":2711.473691409,"data":"       |     BK_vec = (K[0]-B[0], K[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.473692601,"data":"       |     d2 = (-BK_vec[1], BK_vec[0])\n"}
,{"stream_name":"stdout","time":2711.473693821,"data":"       |     A_mat = np.array([[d1[0], -d2[0]], [d1[1], -d2[1]]], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.473695158,"data":"       |     rhs = np.array([M[0]-B[0], M[1]-B[1]], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.473696412,"data":"       |     det = A_mat[0,0]*A_mat[1,1] - A_mat[0,1]*A_mat[1,0]\n"}
,{"stream_name":"stdout","time":2711.473697629,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.473698863,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.473700018,"data":"       |     u = (rhs[0]*A_mat[1,1] - rhs[1]*A_mat[0,1]) / det\n"}
,{"stream_name":"stdout","time":2711.473701271,"data":"       |     O_T = (B[0] + u*d1[0], B[1] + u*d1[1])\n"}
,{"stream_name":"stdout","time":2711.473702487,"data":"       |     T = (2*O_T[0], 0.0)\n"}
,{"stream_name":"stdout","time":2711.473703716,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.473704892,"data":"       |     CT = math.hypot(C[0]-T[0], C[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.473706098,"data":"       |     BT = math.hypot(B[0]-T[0], B[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.473707301,"data":"       |     NB = math.hypot(N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.473708495,"data":"       |     NE = math.hypot(N[0]-E[0], N[1]-E[1])\n"}
,{"stream_name":"stdout","time":2711.473709729,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.473710943,"data":"       |     return cond, ratio, {'A':A,'K':K,'Kp':K_prime,'N':N,'T':T}\n"}
