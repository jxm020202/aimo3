,{"stream_name":"stdout","time":3398.356565305,"data":"       |     if len(uniq_pts)!=4:\n"}
,{"stream_name":"stdout","time":3398.356566486,"data":"       |         return False\n"}
,{"stream_name":"stdout","time":3398.356567662,"data":"       |     # check rectangle: compute vectors between consecutive points sorted cyclically? Need order.\n"}
,{"stream_name":"stdout","time":3398.356568983,"data":"       |     # We can compute convex hull of points (should be rectangle)\n"}
,{"stream_name":"stdout","time":3398.356571888,"data":"       |     # Compute distances between all pairs, find 4 sides (shorter distances) and 2 diagonals (longer)\n"}
,{"stream_name":"stdout","time":3398.356573227,"data":"       |     dists = []\n"}
,{"stream_name":"stdout","time":3398.356574393,"data":"       |     for i in range(4):\n"}
,{"stream_name":"stdout","time":3398.356575553,"data":"       |         for j in range(i+1,4):\n"}
,{"stream_name":"stdout","time":3398.356576742,"data":"       |             d = math.hypot(pts[i][0]-pts[j][0], pts[i][1]-pts[j][1])\n"}
,{"stream_name":"stdout","time":3398.356577995,"data":"       |             dists.append(d)\n"}
,{"stream_name":"stdout","time":3398.356579181,"data":"       |     dists.sort()\n"}
,{"stream_name":"stdout","time":3398.356580337,"data":"       |     # In rectangle, there are 4 equal sides (shorter) and 2 equal diagonals (longer, sqrt(2) times side)\n"}
,{"stream_name":"stdout","time":3398.356581671,"data":"       |     # So check first 4 distances equal within tolerance, last 2 equal and \u003e first.\n"}
,{"stream_name":"stdout","time":3398.356583005,"data":"       |     if not (abs(dists[0]-dists[1])\u003c1e-6 and abs(dists[1]-dists[2])\u003c1e-6 and abs(dists[2]-dists[3])\u003c1e-6):\n"}
,{"stream_name":"stdout","time":3398.356584466,"data":"       |         return False\n"}
