,{"stream_name":"stdout","time":2711.496922487,"data":"       |     # compute x_A, y_A\n"}
,{"stream_name":"stdout","time":2711.496923608,"data":"       |     xA = (c**2 - b**2 + a**2) / (2*a)\n"}
,{"stream_name":"stdout","time":2711.496924788,"data":"       |     # yA = sqrt(c^2 - xA^2)\n"}
,{"stream_name":"stdout","time":2711.49692592,"data":"       |     yA = sp.sqrt(c**2 - xA**2)\n"}
,{"stream_name":"stdout","time":2711.496927117,"data":"       |     # points\n"}
,{"stream_name":"stdout","time":2711.49692824,"data":"       |     B = sp.Point(0,0)\n"}
,{"stream_name":"stdout","time":2711.496929391,"data":"       |     C = sp.Point(a,0)\n"}
,{"stream_name":"stdout","time":2711.496930548,"data":"       |     A = sp.Point(xA, yA)\n"}
,{"stream_name":"stdout","time":2711.496931716,"data":"       |     # compute semiperimeter s = (a+b+c)/2 (should hold)\n"}
,{"stream_name":"stdout","time":2711.496932936,"data":"       |     # but we treat s as variable; we can enforce equation s - (a+b+c)/2 = 0\n"}
,{"stream_name":"stdout","time":2711.496934204,"data":"       |     # Actually we have relation: s = (a+b+c)/2. Let's impose that as equation.\n"}
,{"stream_name":"stdout","time":2711.496937301,"data":"       |     # Let's solve for s using that relation.\n"}
,{"stream_name":"stdout","time":2711.496938561,"data":"       |     # s = (a + b + c)/2 =\u003e 2s = a + b + c =\u003e 2s = a + (s - d) + (s - c_seg) =\u003e 2s = a + 2s - (d + c_seg) =\u003e cancel 2s =\u003e 0 = a - (d + c_seg) =\u003e 0 = 0.\n"}
,{"stream_name":"stdout","time":2711.496940167,"data":"       |     # So identity, no constraint.\n"}
,{"stream_name":"stdout","time":2711.496941324,"data":"       |     # So s is free \u003e max(d,c_seg)\n"}
,{"stream_name":"stdout","time":2711.496942584,"data":"       |     # compute points F and E using distances along sides\n"}
,{"stream_name":"stdout","time":2711.496943847,"data":"       |     # BF = s - b_side? Actually BF = s - b (where b is side CA). Wait earlier we said BF = s - b (where b = CA). So BF = s - b = s - (s - d) = d.\n"}
,{"stream_name":"stdout","time":2711.496945308,"data":"       |     # Indeed BF = BD = d! That's a known property: The distance from B to touch point on AB equals BD? Let's verify: BF = s - b = s - (s - d) = d. Yes.\n"}
,{"stream_name":"stdout","time":2711.49694672,"data":"       |     # Similarly, AF = s - a = s - a (a = BC). So AF = s - a.\n"}
,{"stream_name":"stdout","time":2711.496947938,"data":"       |     # So F lies on AB at distance BF = d from B.\n"}
,{"stream_name":"stdout","time":2711.496949164,"data":"       |     # Similarly, CE = s - c = s - (s - c_seg) = c_seg = CD.\n"}
,{"stream_name":"stdout","time":2711.496950374,"data":"       |     # So CE = CD = c_seg.\n"}
,{"stream_name":"stdout","time":2711.496951515,"data":"       |     # And AE = s - a = same as AF.\n"}
,{"stream_name":"stdout","time":2711.496952907,"data":"       |     # So E is on AC such that CE = c_seg from C.\n"}
,{"stream_name":"stdout","time":2711.496954144,"data":"       |     # Good.\n"}
,{"stream_name":"stdout","time":2711.496955287,"data":"       |     # So we can compute F as point along AB at distance d from B.\n"}
,{"stream_name":"stdout","time":2711.496956515,"data":"       |     # Unit vector from B to A: (xA, yA)/c\n"}
,{"stream_name":"stdout","time":2711.496957714,"data":"       |     BF = d\n"}
,{"stream_name":"stdout","time":2711.496958871,"data":"       |     # but need to ensure BF \u003c= c (AB length). Since c = s - c_seg, and BF = d, we need d \u003c= s - c_seg =\u003e s \u003e= d + c_seg = a. So s \u003e= a. So semiperimeter must be at least BC. That's plausible.\n"}
,{"stream_name":"stdout","time":2711.496960504,"data":"       |     # So s must be \u003e= a.\n"}
,{"stream_name":"stdout","time":2711.496961727,"data":"       |     # We'll keep s variable with constraint s \u003e a.\n"}
,{"stream_name":"stdout","time":2711.496963184,"data":"       |     # Compute F:\n"}
,{"stream_name":"stdout","time":2711.49696433,"data":"       |     F = sp.Point(xA * BF / c, yA * BF / c)\n"}
,{"stream_name":"stdout","time":2711.496965524,"data":"       |     # Similarly, E: point on AC at distance CE = c_seg from C towards A.\n"}
,{"stream_name":"stdout","time":2711.496966758,"data":"       |     # Vector from C to A: (xA - a, yA)\n"}
,{"stream_name":"stdout","time":2711.496967941,"data":"       |     CE = c_seg\n"}
,{"stream_name":"stdout","time":2711.496969083,"data":"       |     E = sp.Point(a + (xA - a) * CE / b, 0 + yA * CE / b)\n"}
,{"stream_name":"stdout","time":2711.496970335,"data":"       |     # Compute line EF\n"}
,{"stream_name":"stdout","time":2711.496971465,"data":"       |     line_EF = sp.Line(E, F)\n"}
,{"stream_name":"stdout","time":2711.496972673,"data":"       |     # Compute D = (d,0)\n"}
,{"stream_name":"stdout","time":2711.496975573,"data":"       |     D = sp.Point(d, 0)\n"}
,{"stream_name":"stdout","time":2711.49697673,"data":"       |     # Compute foot N of perpendicular from D to EF\n"}
,{"stream_name":"stdout","time":2711.496977945,"data":"       |     N = line_EF.projection(D)\n"}
,{"stream_name":"stdout","time":2711.496979121,"data":"       |     # Compute circumcircle of ABC (Omega)\n"}
,{"stream_name":"stdout","time":2711.496980293,"data":"       |     Omega = sp.Circle(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.496981451,"data":"       |     # Compute circumcircle of AFE\n"}
,{"stream_name":"stdout","time":2711.496982607,"data":"       |     circle_AFE = sp.Circle(A, F, E)\n"}
,{"stream_name":"stdout","time":2711.496983785,"data":"       |     # Compute intersection points of circles\n"}
,{"stream_name":"stdout","time":2711.496984988,"data":"       |     inter = Omega.intersection(circle_AFE)\n"}
,{"stream_name":"stdout","time":2711.496986154,"data":"       |     # inter contains A and K (maybe order)\n"}
,{"stream_name":"stdout","time":2711.496987327,"data":"       |     # Identify K as point not equal to A\n"}
,{"stream_name":"stdout","time":2711.496988504,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.496989635,"data":"       |     for pt in inter:\n"}
,{"stream_name":"stdout","time":2711.496990801,"data":"       |         if not pt.equals(A):\n"}
,{"stream_name":"stdout","time":2711.496991985,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.496993164,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.496994291,"data":"       |         raise ValueError(\"No K found\")\n"}
,{"stream_name":"stdout","time":2711.496995521,"data":"       |     # Compute reflection of K across line EF =\u003e K'\n"}
,{"stream_name":"stdout","time":2711.496996721,"data":"       |     Kprime = K.reflect(line_EF)\n"}
,{"stream_name":"stdout","time":2711.496997874,"data":"       |     # Condition: K, N, K', B are concyclic\n"}
,{"stream_name":"stdout","time":2711.496999071,"data":"       |     # Compute circle through K, N, B and check if K' lies on it (distance equality)\n"}
,{"stream_name":"stdout","time":2711.497000321,"data":"       |     # Define circle through K, N, B\n"}
,{"stream_name":"stdout","time":2711.497001501,"data":"       |     circle_KNB = sp.Circle(K, N, B)\n"}
,{"stream_name":"stdout","time":2711.497002704,"data":"       |     # Condition: Kprime lies on this circle =\u003e distance from center equals radius\n"}
,{"stream_name":"stdout","time":2711.49700425,"data":"       |     # So equation: (Kprime.distance(circle_KNB.center) - circle_KNB.radius) == 0\n"}
,{"stream_name":"stdout","time":2711.497005578,"data":"       |     eq_cyclic = sp.simplify(Kprime.distance(circle_KNB.center)**2 - circle_KNB.radius**2)\n"}
,{"stream_name":"stdout","time":2711.49700688,"data":"       |     # eq_cyclic should be zero for cyclic condition.\n"}
,{"stream_name":"stdout","time":2711.497008093,"data":"       |     # Now compute T: circle through B and K tangent to line BN at B.\n"}
,{"stream_name":"stdout","time":2711.497009385,"data":"       |     # Tangent condition: line BN is tangent at B, so radius to B is perpendicular to BN.\n"}
,{"stream_name":"stdout","time":2711.497010677,"data":"       |     # Center O_T lies on line through B perpendicular to BN.\n"}
,{"stream_name":"stdout","time":2711.497011914,"data":"       |     line_BN = sp.Line(B, N)\n"}
,{"stream_name":"stdout","time":2711.49701309,"data":"       |     # Perpendicular line through B:\n"}
,{"stream_name":"stdout","time":2711.497014265,"data":"       |     perp_B = line_BN.perpendicular_line(B)\n"}
,{"stream_name":"stdout","time":2711.497017171,"data":"       |     # Also center lies on perpendicular bisector of BK.\n"}
,{"stream_name":"stdout","time":2711.497018385,"data":"       |     mid_BK = sp.Point((B.x + K.x)/2, (B.y + K.y)/2)\n"}
,{"stream_name":"stdout","time":2711.49701958,"data":"       |     # Slope of BK: line_BK = sp.Line(B, K)\n"}
,{"stream_name":"stdout","time":2711.497020774,"data":"       |     line_BK = sp.Line(B, K)\n"}
,{"stream_name":"stdout","time":2711.497021923,"data":"       |     perp_BK = line_BK.perpendicular_line(mid_BK)\n"}
,{"stream_name":"stdout","time":2711.497023114,"data":"       |     # Intersection gives center O_T\n"}
,{"stream_name":"stdout","time":2711.497024297,"data":"       |     O_T = perp_B.intersection(perp_BK)[0]\n"}
,{"stream_name":"stdout","time":2711.497025481,"data":"       |     # Radius = distance O_T to B\n"}
,{"stream_name":"stdout","time":2711.497026647,"data":"       |     r_T = O_T.distance(B)\n"}
,{"stream_name":"stdout","time":2711.497027788,"data":"       |     # Circle_T = sp.Circle(O_T, r_T)\n"}
,{"stream_name":"stdout","time":2711.497028985,"data":"       |     # Intersection of Circle_T with line BC (y=0) gives points B and T\n"}
,{"stream_name":"stdout","time":2711.497030251,"data":"       |     line_BC = sp.Line(B, C)\n"}
,{"stream_name":"stdout","time":2711.497031444,"data":"       |     inter_T = sp.Circle(O_T, r_T).intersection(line_BC)\n"}
,{"stream_name":"stdout","time":2711.497032665,"data":"       |     # Should be two points: B and T\n"}
,{"stream_name":"stdout","time":2711.497033881,"data":"       |     T = None\n"}
,{"stream_name":"stdout","time":2711.497035027,"data":"       |     for pt in inter_T:\n"}
,{"stream_name":"stdout","time":2711.497036171,"data":"       |         if not pt.equals(B):\n"}
,{"stream_name":"stdout","time":2711.49703733,"data":"       |             T = pt\n"}
,{"stream_name":"stdout","time":2711.497038481,"data":"       |     if T is None:\n"}
,{"stream_name":"stdout","time":2711.497039601,"data":"       |         # maybe B repeated\n"}
,{"stream_name":"stdout","time":2711.497040754,"data":"       |         T = inter_T[0] if inter_T[0] != B else inter_T[1]\n"}
,{"stream_name":"stdout","time":2711.497042021,"data":"       |     # Compute distances for ratio: CT, NB, BT, NE\n"}
,{"stream_name":"stdout","time":2711.497043264,"data":"       |     CT = C.distance(T)\n"}
,{"stream_name":"stdout","time":2711.497044404,"data":"       |     NB = N.distance(B)\n"}
,{"stream_name":"stdout","time":2711.497045541,"data":"       |     BT = B.distance(T)\n"}
,{"stream_name":"stdout","time":2711.497046675,"data":"       |     NE = N.distance(E)\n"}
,{"stream_name":"stdout","time":2711.497047834,"data":"       |     # Ratio R = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.497048988,"data":"       |     R = sp.simplify((CT * NB) / (BT * NE))\n"}
,{"stream_name":"stdout","time":2711.497050184,"data":"       |     # Return expression for R and cyclic condition eq_cyclic\n"}
,{"stream_name":"stdout","time":2711.49705142,"data":"       |     return sp.simplify(eq_cyclic), sp.simplify(R), (A,B,C,D,E,F,N,K,Kprime,T,O_T)\n"}
,{"stream_name":"stdout","time":2711.497052744,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.49705402,"data":"       | # Test for a small n, say n=3 (odd) or n=4 (even)\n"}
,{"stream_name":"stdout","time":2711.497055218,"data":"       | eq_cyclic, R_expr, _ = compute_ratio(4)\n"}
,{"stream_name":"stdout","time":2711.497056391,"data":"       | eq_cyclic, R_expr\n"}
