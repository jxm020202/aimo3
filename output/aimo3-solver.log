,{"stream_name":"stdout","time":2711.472767733,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.472768929,"data":"       |     t = s * y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.472770098,"data":"       |     A = (t * x_f, t * y_f)\n"}
