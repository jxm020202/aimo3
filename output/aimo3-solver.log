,{"stream_name":"stdout","time":2711.471268781,"data":"       | def compute_ratio(c0, d0):\n"}
,{"stream_name":"stdout","time":2711.471270016,"data":"       |     r = sp.symbols('r', positive=True, real=True)\n"}
,{"stream_name":"stdout","time":2711.471271246,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.471272411,"data":"       |     # points\n"}
,{"stream_name":"stdout","time":2711.471273581,"data":"       |     B = sp.Point(0,0)\n"}
,{"stream_name":"stdout","time":2711.471274805,"data":"       |     C = sp.Point(a,0)\n"}
,{"stream_name":"stdout","time":2711.471276005,"data":"       |     I = sp.Point(c0, r)\n"}
,{"stream_name":"stdout","time":2711.471277202,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471278433,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471279678,"data":"       |     F = sp.Point(x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.471280873,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471282072,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471283268,"data":"       |     E = sp.Point(x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.471284506,"data":"       |     # lines\n"}
,{"stream_name":"stdout","time":2711.471285652,"data":"       |     line_BF = sp.Line(B, F)\n"}
,{"stream_name":"stdout","time":2711.471286835,"data":"       |     line_CE = sp.Line(C, E)\n"}
,{"stream_name":"stdout","time":2711.471288018,"data":"       |     A = line_BF.intersection(line_CE)[0]\n"}
,{"stream_name":"stdout","time":2711.471289242,"data":"       |     # circles\n"}
,{"stream_name":"stdout","time":2711.471290399,"data":"       |     circ_ABC = sp.Circle(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.471291586,"data":"       |     circ_AEF = sp.Circle(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.471292768,"data":"       |     # intersection points\n"}
,{"stream_name":"stdout","time":2711.471294012,"data":"       |     inter = circ_ABC.intersection(circ_AEF)\n"}
,{"stream_name":"stdout","time":2711.471296409,"data":"       |     # identify K (not A)\n"}
,{"stream_name":"stdout","time":2711.471297623,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.471298796,"data":"       |     for pt in inter:\n"}
,{"stream_name":"stdout","time":2711.47129996,"data":"       |         if not pt.equals(A):\n"}
,{"stream_name":"stdout","time":2711.471301162,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.471302348,"data":"       |     # line EF\n"}
,{"stream_name":"stdout","time":2711.47130352,"data":"       |     line_EF = sp.Line(E, F)\n"}
,{"stream_name":"stdout","time":2711.471304736,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.471305909,"data":"       |     K_prime = K.reflect(line_EF)\n"}
,{"stream_name":"stdout","time":2711.471307095,"data":"       |     # N: foot from D to EF\n"}
,{"stream_name":"stdout","time":2711.471308295,"data":"       |     D = sp.Point(c0, 0)\n"}
