,{"stream_name":"stdout","time":2711.489176779,"data":"       | import math\n"}
,{"stream_name":"stdout","time":2711.48917797,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489179148,"data":"       | def distance(P,Q):\n"}
,{"stream_name":"stdout","time":2711.489180335,"data":"       |     return math.hypot(P[0]-Q[0], P[1]-Q[1])\n"}
,{"stream_name":"stdout","time":2711.489181616,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489182793,"data":"       | def compute_points(p,q,r):\n"}
,{"stream_name":"stdout","time":2711.489185103,"data":"       |     # B, C, I\n"}
,{"stream_name":"stdout","time":2711.489186292,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.489187457,"data":"       |     C = (p+q, 0.0)\n"}
,{"stream_name":"stdout","time":2711.48918862,"data":"       |     I = (p, r)\n"}
,{"stream_name":"stdout","time":2711.489189783,"data":"       |     # slopes\n"}
,{"stream_name":"stdout","time":2711.489190967,"data":"       |     mB = 2*p*r/(p**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.489192192,"data":"       |     mC = 2*q*r/(q**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.489193407,"data":"       |     # A\n"}
,{"stream_name":"stdout","time":2711.489194606,"data":"       |     xA = -mC*(p+q)/(mB - mC)\n"}
,{"stream_name":"stdout","time":2711.489195782,"data":"       |     yA = mB*xA\n"}
,{"stream_name":"stdout","time":2711.489196958,"data":"       |     A = (xA, yA)\n"}
,{"stream_name":"stdout","time":2711.489198118,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.489199295,"data":"       |     Fx = p*(p**2 - r**2)/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.489200795,"data":"       |     Fy = 2*p**2*r/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.489202005,"data":"       |     F = (Fx, Fy)\n"}
,{"stream_name":"stdout","time":2711.48920324,"data":"       |     # line AI: compute reflection of F across line AI to get E\n"}
,{"stream_name":"stdout","time":2711.489204592,"data":"       |     # Represent line AI as point A and direction vector (I-A)\n"}
,{"stream_name":"stdout","time":2711.489205905,"data":"       |     # Compute reflection of point across line defined by point P0 and unit direction u\n"}
,{"stream_name":"stdout","time":2711.489207198,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":2711.489208359,"data":"       |     A_np = np.array(A)\n"}
,{"stream_name":"stdout","time":2711.489209513,"data":"       |     I_np = np.array(I)\n"}
,{"stream_name":"stdout","time":2711.489210661,"data":"       |     F_np = np.array(F)\n"}
,{"stream_name":"stdout","time":2711.489211831,"data":"       |     u = I_np - A_np\n"}
,{"stream_name":"stdout","time":2711.489213003,"data":"       |     # unit direction\n"}
,{"stream_name":"stdout","time":2711.489214198,"data":"       |     u_norm = u / np.linalg.norm(u)\n"}
,{"stream_name":"stdout","time":2711.489215442,"data":"       |     # projection of vector AF onto u\n"}
,{"stream_name":"stdout","time":2711.489216649,"data":"       |     AF = F_np - A_np\n"}
,{"stream_name":"stdout","time":2711.489217833,"data":"       |     proj = np.dot(AF, u_norm) * u_norm\n"}
,{"stream_name":"stdout","time":2711.489219049,"data":"       |     # perpendicular component\n"}
,{"stream_name":"stdout","time":2711.489220233,"data":"       |     perp = AF - proj\n"}
,{"stream_name":"stdout","time":2711.489221445,"data":"       |     # reflection: F' = F - 2*perp\n"}
,{"stream_name":"stdout","time":2711.489224307,"data":"       |     E_np = F_np - 2*perp\n"}
,{"stream_name":"stdout","time":2711.489225561,"data":"       |     E = tuple(E_np.tolist())\n"}
,{"stream_name":"stdout","time":2711.489226747,"data":"       |     # line EF: compute foot N from D to EF\n"}
,{"stream_name":"stdout","time":2711.489227972,"data":"       |     D = (p, 0.0)\n"}
,{"stream_name":"stdout","time":2711.489229167,"data":"       |     # line EF param: E + t*(F-E)\n"}
,{"stream_name":"stdout","time":2711.489230387,"data":"       |     # foot of D onto line: compute projection onto direction vector\n"}
,{"stream_name":"stdout","time":2711.489231766,"data":"       |     E_np = np.array(E)\n"}
,{"stream_name":"stdout","time":2711.489232938,"data":"       |     F_np = np.array(F)\n"}
,{"stream_name":"stdout","time":2711.489234116,"data":"       |     D_np = np.array(D)\n"}
,{"stream_name":"stdout","time":2711.489235338,"data":"       |     v = F_np - E_np\n"}
,{"stream_name":"stdout","time":2711.489236524,"data":"       |     t = np.dot(D_np - E_np, v) / np.dot(v, v)\n"}
,{"stream_name":"stdout","time":2711.489237744,"data":"       |     N_np = E_np + t * v\n"}
,{"stream_name":"stdout","time":2711.489238905,"data":"       |     N = tuple(N_np.tolist())\n"}
,{"stream_name":"stdout","time":2711.489240131,"data":"       |     # circumcircle of ABC: compute center O1 using perpendicular bisectors\n"}
,{"stream_name":"stdout","time":2711.489241441,"data":"       |     # Use function to compute circle center from three points\n"}
,{"stream_name":"stdout","time":2711.489242685,"data":"       |     def circumcenter(P1,P2,P3):\n"}
,{"stream_name":"stdout","time":2711.489243885,"data":"       |         # using linear algebra\n"}
,{"stream_name":"stdout","time":2711.48924511,"data":"       |         x1,y1=P1; x2,y2=P2; x3,y3=P3\n"}
,{"stream_name":"stdout","time":2711.489246304,"data":"       |         d = 2*(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.489247564,"data":"       |         ux = ((x1**2+y1**2)*(y2-y3)+(x2**2+y2**2)*(y3-y1)+(x3**2+y3**2)*(y1-y2))/d\n"}
,{"stream_name":"stdout","time":2711.489248865,"data":"       |         uy = ((x1**2+y1**2)*(x3-x2)+(x2**2+y2**2)*(x1-x3)+(x3**2+y3**2)*(x2-x1))/d\n"}
,{"stream_name":"stdout","time":2711.489250182,"data":"       |         return (ux, uy)\n"}
,{"stream_name":"stdout","time":2711.489251339,"data":"       |     O1 = circumcenter(A,B,C)\n"}
,{"stream_name":"stdout","time":2711.489252527,"data":"       |     R1 = distance(O1, A)\n"}
,{"stream_name":"stdout","time":2711.489253712,"data":"       |     # circumcircle of AFE\n"}
,{"stream_name":"stdout","time":2711.489254958,"data":"       |     O2 = circumcenter(A,F,E)\n"}
,{"stream_name":"stdout","time":2711.48925616,"data":"       |     R2 = distance(O2, A)\n"}
,{"stream_name":"stdout","time":2711.489257627,"data":"       |     # intersection of circles: compute K (other than A)\n"}
,{"stream_name":"stdout","time":2711.489258883,"data":"       |     # Solve using circle intersection formulas\n"}
,{"stream_name":"stdout","time":2711.489260096,"data":"       |     # vector between centers\n"}
,{"stream_name":"stdout","time":2711.489261294,"data":"       |     O1_np = np.array(O1); O2_np = np.array(O2)\n"}
,{"stream_name":"stdout","time":2711.489266176,"data":"       |     d_cent = np.linalg.norm(O2_np - O1_np)\n"}
,{"stream_name":"stdout","time":2711.489267494,"data":"       |     # if circles intersect, compute intersection points\n"}
,{"stream_name":"stdout","time":2711.489268773,"data":"       |     # a = (R1^2 - R2^2 + d^2) / (2d)\n"}
,{"stream_name":"stdout","time":2711.489271621,"data":"       |     a = (R1**2 - R2**2 + d_cent**2) / (2*d_cent)\n"}
,{"stream_name":"stdout","time":2711.489272886,"data":"       |     # height h = sqrt(R1^2 - a^2)\n"}
,{"stream_name":"stdout","time":2711.489274101,"data":"       |     h_sq = R1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.489275317,"data":"       |     if h_sq \u003c 0:\n"}
,{"stream_name":"stdout","time":2711.489276583,"data":"       |         h = 0.0\n"}
,{"stream_name":"stdout","time":2711.489277756,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.489278901,"data":"       |         h = math.sqrt(h_sq)\n"}
,{"stream_name":"stdout","time":2711.489280148,"data":"       |     # point P2 = O1 + a*(O2-O1)/d\n"}
,{"stream_name":"stdout","time":2711.489281347,"data":"       |     P2 = O1_np + a*(O2_np - O1_np)/d_cent\n"}
,{"stream_name":"stdout","time":2711.489282581,"data":"       |     # intersection points:\n"}
,{"stream_name":"stdout","time":2711.48928379,"data":"       |     # offset vector perpendicular to line O1O2: (-(y2-y1), x2-x1) normalized\n"}
,{"stream_name":"stdout","time":2711.489285099,"data":"       |     ox, oy = O2_np - O1_np\n"}
,{"stream_name":"stdout","time":2711.489286271,"data":"       |     perp_vec = np.array([-oy, ox]) / d_cent\n"}
,{"stream_name":"stdout","time":2711.489287485,"data":"       |     inter1 = P2 + h * perp_vec\n"}
,{"stream_name":"stdout","time":2711.4892887,"data":"       |     inter2 = P2 - h * perp_vec\n"}
,{"stream_name":"stdout","time":2711.489289919,"data":"       |     # Choose the one not equal to A\n"}
,{"stream_name":"stdout","time":2711.489291112,"data":"       |     def close(pt1, pt2, eps=1e-6):\n"}
,{"stream_name":"stdout","time":2711.489292548,"data":"       |         return distance(pt1, pt2) \u003c eps\n"}
,{"stream_name":"stdout","time":2711.48929381,"data":"       |     if close(inter1, A):\n"}
,{"stream_name":"stdout","time":2711.489295102,"data":"       |         K = tuple(inter2.tolist())\n"}
,{"stream_name":"stdout","time":2711.48929631,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":2711.489297459,"data":"       |         K = tuple(inter1.tolist())\n"}
,{"stream_name":"stdout","time":2711.489298663,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.489299923,"data":"       |     # reflect point K across line EF using same method as for E\n"}
,{"stream_name":"stdout","time":2711.489301219,"data":"       |     K_np = np.array(K)\n"}
,{"stream_name":"stdout","time":2711.489302376,"data":"       |     # reflect across line through E with direction v\n"}
,{"stream_name":"stdout","time":2711.489303633,"data":"       |     v = F_np - E_np\n"}
,{"stream_name":"stdout","time":2711.489304795,"data":"       |     v_norm = v / np.linalg.norm(v)\n"}
,{"stream_name":"stdout","time":2711.489305984,"data":"       |     # compute projection of (K-E) onto v\n"}
,{"stream_name":"stdout","time":2711.489307196,"data":"       |     KE = K_np - E_np\n"}
,{"stream_name":"stdout","time":2711.489308364,"data":"       |     proj_K = np.dot(KE, v_norm) * v_norm\n"}
,{"stream_name":"stdout","time":2711.489309592,"data":"       |     perp_K = KE - proj_K\n"}
,{"stream_name":"stdout","time":2711.489310785,"data":"       |     Kprime_np = K_np - 2*perp_K\n"}
,{"stream_name":"stdout","time":2711.489311993,"data":"       |     Kprime = tuple(Kprime_np.tolist())\n"}
,{"stream_name":"stdout","time":2711.489313181,"data":"       |     return A,B,C,F,E,N,K,Kprime\n"}
,{"stream_name":"stdout","time":2711.489314379,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489315488,"data":"       | def cyclic_condition_ptolemy(p,q,r):\n"}
,{"stream_name":"stdout","time":2711.489318276,"data":"       |     A,B,C,F,E,N,K,Kprime = compute_points(p,q,r)\n"}
,{"stream_name":"stdout","time":2711.489319559,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.489320781,"data":"       |     BK = distance(B,K)\n"}
,{"stream_name":"stdout","time":2711.48932197,"data":"       |     BN = distance(B,N)\n"}
,{"stream_name":"stdout","time":2711.489323433,"data":"       |     NKprime = distance(N,Kprime)\n"}
,{"stream_name":"stdout","time":2711.489324648,"data":"       |     BN_KKprime = BN * distance(K,Kprime)\n"}
,{"stream_name":"stdout","time":2711.489325877,"data":"       |     BK_NKprime = BK * NKprime\n"}
,{"stream_name":"stdout","time":2711.489327076,"data":"       |     NK_BKprime = distance(N,K) * distance(B,Kprime)\n"}
,{"stream_name":"stdout","time":2711.489328328,"data":"       |     # Ptolemy condition: BK * N K' = BN * K K' + NK * B K'\n"}
,{"stream_name":"stdout","time":2711.489329611,"data":"       |     return BK_NKprime - (BN * distance(K,Kprime) + distance(N,K) * distance(B,Kprime))\n"}
