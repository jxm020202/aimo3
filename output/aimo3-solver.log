,{"stream_name":"stdout","time":2711.471735463,"data":"       | def compute_ratio_numeric(c0, d0, r):\n"}
,{"stream_name":"stdout","time":2711.471736998,"data":"       |     # compute ratio and condition value for given r\n"}
,{"stream_name":"stdout","time":2711.471738256,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.471739411,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.471740569,"data":"       |     C = (a, 0.0)\n"}
,{"stream_name":"stdout","time":2711.471741766,"data":"       |     I = (c0, r)\n"}
,{"stream_name":"stdout","time":2711.47174296,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.471744145,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.4717454,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471746601,"data":"       |     F = (x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.471747788,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.471748967,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471750196,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.471751447,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.471752652,"data":"       |     # A = intersection of lines BF and CE\n"}
,{"stream_name":"stdout","time":2711.471753863,"data":"       |     # line BF: B + t*F\n"}
,{"stream_name":"stdout","time":2711.471755052,"data":"       |     # line CE: C + s*(E - C)\n"}
,{"stream_name":"stdout","time":2711.471756246,"data":"       |     # Solve for t,s: t*F = C + s*(E - C)\n"}
,{"stream_name":"stdout","time":2711.471757468,"data":"       |     # Write as 2 equations\n"}
,{"stream_name":"stdout","time":2711.471758686,"data":"       |     # Use linear solve\n"}
,{"stream_name":"stdout","time":2711.471759863,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":2711.471761087,"data":"       |     # matrix for unknowns t,s\n"}
,{"stream_name":"stdout","time":2711.471762309,"data":"       |     # t*F_x = a + s*(E_x - a)\n"}
,{"stream_name":"stdout","time":2711.471763529,"data":"       |     # t*F_y = s*(E_y - 0)  (since C_y=0)\n"}
,{"stream_name":"stdout","time":2711.471764766,"data":"       |     # Solve\n"}
,{"stream_name":"stdout","time":2711.471765943,"data":"       |     # from second: t = s * (E_y) / F_y  (if F_y != 0)\n"}
,{"stream_name":"stdout","time":2711.471767195,"data":"       |     if abs(F[1]) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.471768432,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.471769589,"data":"       |     # compute s from first equation using t expression\n"}
,{"stream_name":"stdout","time":2711.471770878,"data":"       |     # t*F_x = a + s*(E_x - a)\n"}
,{"stream_name":"stdout","time":2711.471772078,"data":"       |     # substitute t\n"}
,{"stream_name":"stdout","time":2711.471773241,"data":"       |     # s * (E_y/F_y) * F_x = a + s*(E_x - a)\n"}
,{"stream_name":"stdout","time":2711.471774467,"data":"       |     # s * (E_y*F_x / F_y) - s*(E_x - a) = a\n"}
,{"stream_name":"stdout","time":2711.471775684,"data":"       |     # s * (E_y*F_x / F_y - (E_x - a)) = a\n"}
,{"stream_name":"stdout","time":2711.471776914,"data":"       |     denom = (E[1]*F[0]/F[1] - (E[0] - a))\n"}
,{"stream_name":"stdout","time":2711.471778125,"data":"       |     if abs(denom) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.471780474,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.471781696,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.471782856,"data":"       |     t = s * (E[1] / F[1])\n"}
,{"stream_name":"stdout","time":2711.471784046,"data":"       |     A = (t*F[0], t*F[1])\n"}
,{"stream_name":"stdout","time":2711.471785236,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.47178641,"data":"       |     O_ABC = circumcenter(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.471787607,"data":"       |     R_ABC = math.hypot(O_ABC[0]-A[0], O_ABC[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.471788838,"data":"       |     O_AEF = circumcenter(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.471790045,"data":"       |     R_AEF = math.hypot(O_AEF[0]-A[0], O_AEF[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.471791382,"data":"       |     # intersection of circles (A, O_ABC,R_ABC) and (O_AEF,R_AEF)\n"}
,{"stream_name":"stdout","time":2711.471792702,"data":"       |     pts = intersect_circles(O_ABC, R_ABC, O_AEF, R_AEF)\n"}
,{"stream_name":"stdout","time":2711.471802949,"data":"       |     # choose K not equal to A (within tolerance)\n"}
,{"stream_name":"stdout","time":2711.471805197,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.4718064,"data":"       |     for pt in pts:\n"}
,{"stream_name":"stdout","time":2711.471807569,"data":"       |         if math.hypot(pt[0]-A[0], pt[1]-A[1]) \u003e 1e-6:\n"}
,{"stream_name":"stdout","time":2711.471809356,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.471810705,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.471811954,"data":"       |         # maybe due to numeric issues\n"}
,{"stream_name":"stdout","time":2711.471813184,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.471814354,"data":"       |     # K' reflection across line EF\n"}
,{"stream_name":"stdout","time":2711.471815656,"data":"       |     K_prime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.471816898,"data":"       |     # N foot from D to EF\n"}
,{"stream_name":"stdout","time":2711.471818214,"data":"       |     D = (c0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.471819367,"data":"       |     N = foot_of_perpendicular(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.471820581,"data":"       |     # condition: B,N,K,K' cyclic\n"}
,{"stream_name":"stdout","time":2711.471821822,"data":"       |     O_BKKp = circumcenter(B, K, K_prime)\n"}
,{"stream_name":"stdout","time":2711.471823145,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471824402,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
,{"stream_name":"stdout","time":2711.471825815,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.471827021,"data":"       |     # line BN vector\n"}
,{"stream_name":"stdout","time":2711.471828208,"data":"       |     BN_vec = (N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471829417,"data":"       |     # line perpendicular to BN through B: direction = rotate BN by 90 degrees\n"}
,{"stream_name":"stdout","time":2711.471830888,"data":"       |     # direction d1 = (-BN_y, BN_x)\n"}
,{"stream_name":"stdout","time":2711.471832116,"data":"       |     d1 = (-BN_vec[1], BN_vec[0])\n"}
,{"stream_name":"stdout","time":2711.471833308,"data":"       |     # line L1: B + u * d1\n"}
,{"stream_name":"stdout","time":2711.471834504,"data":"       |     # perpendicular bisector of BK: midpoint M, direction perpendicular to BK\n"}
,{"stream_name":"stdout","time":2711.471836956,"data":"       |     M = ((B[0]+K[0])/2.0, (B[1]+K[1])/2.0)\n"}
,{"stream_name":"stdout","time":2711.471838193,"data":"       |     BK_vec = (K[0]-B[0], K[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471839387,"data":"       |     # direction d2 = (-BK_y, BK_x)\n"}
,{"stream_name":"stdout","time":2711.471840595,"data":"       |     d2 = (-BK_vec[1], BK_vec[0])\n"}
,{"stream_name":"stdout","time":2711.471841832,"data":"       |     # Solve for intersection O_T of lines: B + u*d1 = M + v*d2\n"}
,{"stream_name":"stdout","time":2711.471843149,"data":"       |     # Solve 2 equations for u,v\n"}
,{"stream_name":"stdout","time":2711.47184435,"data":"       |     # B + u*d1 = M + v*d2\n"}
,{"stream_name":"stdout","time":2711.471845566,"data":"       |     # =\u003e u*d1 - v*d2 = M - B\n"}
,{"stream_name":"stdout","time":2711.471846812,"data":"       |     # Represent as matrix [[d1x, -d2x],[d1y, -d2y]] * [u, v]^T = M - B\n"}
,{"stream_name":"stdout","time":2711.471848088,"data":"       |     A_mat = [[d1[0], -d2[0]], [d1[1], -d2[1]]]\n"}
,{"stream_name":"stdout","time":2711.471849302,"data":"       |     rhs = (M[0]-B[0], M[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471850514,"data":"       |     # solve linear system\n"}
,{"stream_name":"stdout","time":2711.471851715,"data":"       |     det = A_mat[0][0]*A_mat[1][1] - A_mat[0][1]*A_mat[1][0]\n"}
,{"stream_name":"stdout","time":2711.471852998,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.47185421,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.471855403,"data":"       |     u = (rhs[0]*A_mat[1][1] - rhs[1]*A_mat[0][1]) / det\n"}
,{"stream_name":"stdout","time":2711.471856678,"data":"       |     # v not needed\n"}
,{"stream_name":"stdout","time":2711.471857834,"data":"       |     O_T = (B[0] + u*d1[0], B[1] + u*d1[1])\n"}
,{"stream_name":"stdout","time":2711.471859076,"data":"       |     # T_x = 2*O_T.x\n"}
,{"stream_name":"stdout","time":2711.471860248,"data":"       |     T = (2*O_T[0], 0.0)\n"}
,{"stream_name":"stdout","time":2711.47186142,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.471862629,"data":"       |     CT = math.hypot(C[0]-T[0], C[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.471863837,"data":"       |     BT = math.hypot(B[0]-T[0], B[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.471865458,"data":"       |     NB = math.hypot(N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.471866673,"data":"       |     NE = math.hypot(N[0]-E[0], N[1]-E[1])\n"}
,{"stream_name":"stdout","time":2711.471867883,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.471869096,"data":"       |     return cond, ratio, {'A':A,'K':K,'Kp':K_prime,'N':N,'T':T,'O_T':O_T}\n"}
