,{"stream_name":"stdout","time":3398.369243964,"data":"       |     A2,B2,C2 = line2\n"}
,{"stream_name":"stdout","time":3398.369245069,"data":"       |     det = A1*B2 - A2*B1\n"}
,{"stream_name":"stdout","time":3398.369246181,"data":"       |     if abs(det) \u003c 1e-9:\n"}
,{"stream_name":"stdout","time":3398.369247327,"data":"       |         return None\n"}
