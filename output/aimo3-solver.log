,{"stream_name":"stdout","time":3398.369327427,"data":"       |     if d \u003e= d_perp:\n"}
,{"stream_name":"stdout","time":3398.369328555,"data":"       |         continue\n"}
,{"stream_name":"stdout","time":3398.369329661,"data":"       |     chords_d = by_orient[d]\n"}
,{"stream_name":"stdout","time":3398.369330779,"data":"       |     chords_perp = by_orient[d_perp]\n"}
,{"stream_name":"stdout","time":3398.369331935,"data":"       |     # choose two chords from each\n"}
