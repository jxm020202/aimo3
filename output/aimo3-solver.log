,{"stream_name":"stdout","time":2711.4797215,"data":"       | def find_roots_bracket(n, r_min=0.01, r_max=100, steps=10000):\n"}
,{"stream_name":"stdout","time":2711.479722766,"data":"       |     roots = []\n"}
,{"stream_name":"stdout","time":2711.479723946,"data":"       |     # sample points\n"}
,{"stream_name":"stdout","time":2711.479725145,"data":"       |     rs = np.linspace(r_min, r_max, steps)\n"}
,{"stream_name":"stdout","time":2711.479726362,"data":"       |     vals = []\n"}
