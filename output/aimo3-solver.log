,{"stream_name":"stdout","time":2937.173791239,"data":"       |     # compute convolution as before\n"}
,{"stream_name":"stdout","time":2937.17379242,"data":"       |     a = {exp[0]: coeff for exp, coeff in monoms.items()}\n"}
,{"stream_name":"stdout","time":2937.173793617,"data":"       |     Q_poly = sp.Poly(Q_expr, x, domain=sp.ZZ)\n"}
,{"stream_name":"stdout","time":2937.17380527,"data":"       |     q_coeff = {exp[0]: coeff for exp, coeff in Q_poly.as_dict().items()}\n"}
