,{"stream_name":"stdout","time":2711.486712746,"data":"       | sinB = 2*t/(1 + t**2)\n"}
,{"stream_name":"stdout","time":2711.486713921,"data":"       | cosB = (1 - t**2)/(1 + t**2)\n"}
,{"stream_name":"stdout","time":2711.486715116,"data":"       | sinC = 2*u/(1 + u**2)\n"}
,{"stream_name":"stdout","time":2711.486716292,"data":"       | cosC = (1 - u**2)/(1 + u**2)\n"}
,{"stream_name":"stdout","time":2711.486717489,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486718644,"data":"       | # define points\n"}
,{"stream_name":"stdout","time":2711.48671981,"data":"       | D = sp.Point(1, 0)\n"}
,{"stream_name":"stdout","time":2711.48672098,"data":"       | E = sp.Point(-cosC, sinC)\n"}
,{"stream_name":"stdout","time":2711.486722214,"data":"       | F = sp.Point(-cosB, -sinB)\n"}
,{"stream_name":"stdout","time":2711.486723383,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486724492,"data":"       | # B point\n"}
,{"stream_name":"stdout","time":2711.486725645,"data":"       | yB = (-1 - cosB)/sinB\n"}
,{"stream_name":"stdout","time":2711.486726817,"data":"       | Bpt = sp.Point(1, yB)\n"}
,{"stream_name":"stdout","time":2711.486728014,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486729141,"data":"       | # C point\n"}
,{"stream_name":"stdout","time":2711.486730329,"data":"       | yC = (1 + cosC)/sinC\n"}
,{"stream_name":"stdout","time":2711.486731492,"data":"       | Cpt = sp.Point(1, yC)\n"}
,{"stream_name":"stdout","time":2711.486732664,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486733792,"data":"       | # A point using formula derived earlier\n"}
,{"stream_name":"stdout","time":2711.486735045,"data":"       | denom = sp.sin(sp.atan2(sinB, cosB) + sp.atan2(sinC, cosC))  # not good\n"}
,{"stream_name":"stdout","time":2711.48673634,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.486737543,"data":"       | # Instead compute using earlier derived formula: A = (-(sinB+sinC)/sin(B+C), (cosB - cosC)/sin(B+C))\n"}
