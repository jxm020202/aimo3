,{"stream_name":"stdout","time":2937.183371003,"data":"     [Code]:\n"}
,{"stream_name":"stdout","time":2937.183372113,"data":"       | def all_divisors_of_one_plus_xd(max_d):\n"}
,{"stream_name":"stdout","time":2937.183373329,"data":"       |     polys = set()\n"}
,{"stream_name":"stdout","time":2937.183374491,"data":"       |     for d in range(1, max_d+1):\n"}
,{"stream_name":"stdout","time":2937.183375654,"data":"       |         expr = 1 + x**d\n"}
,{"stream_name":"stdout","time":2937.183376796,"data":"       |         coeff, factors = sp.factor_list(expr, modulus=None)\n"}
,{"stream_name":"stdout","time":2937.183378028,"data":"       |         factor_polys = [sp.Poly(fac, x, domain='ZZ') for fac, exp in factors]\n"}
,{"stream_name":"stdout","time":2937.183379283,"data":"       |         n = len(factor_polys)\n"}
,{"stream_name":"stdout","time":2937.183380478,"data":"       |         from itertools import combinations\n"}
,{"stream_name":"stdout","time":2937.183381683,"data":"       |         for r in range(n+1):\n"}
,{"stream_name":"stdout","time":2937.183382896,"data":"       |             for subset in combinations(factor_polys, r):\n"}
,{"stream_name":"stdout","time":2937.183384784,"data":"       |                 prod = sp.Poly(1, x, domain='ZZ')\n"}
,{"stream_name":"stdout","time":2937.183385996,"data":"       |                 for f in subset:\n"}
,{"stream_name":"stdout","time":2937.183387268,"data":"       |                     prod = prod * f\n"}
,{"stream_name":"stdout","time":2937.183388433,"data":"       |                 for sign in [1, -1]:\n"}
,{"stream_name":"stdout","time":2937.183389636,"data":"       |                     signed = sp.Poly(sign*prod.as_expr(), x, domain='ZZ')\n"}
,{"stream_name":"stdout","time":2937.183390916,"data":"       |                     deg = signed.degree()\n"}
,{"stream_name":"stdout","time":2937.183394026,"data":"       |                     if deg \u003c= 8:\n"}
,{"stream_name":"stdout","time":2937.183395293,"data":"       |                         polys.add(poly_to_tuple(signed))\n"}
,{"stream_name":"stdout","time":2937.183396573,"data":"       |     return polys\n"}
,{"stream_name":"stdout","time":2937.18339774,"data":"       | \n"}
