,{"stream_name":"stdout","time":2711.472243214,"data":"       | def compute_ratio_numeric(c0, d0, r):\n"}
,{"stream_name":"stdout","time":2711.472244427,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.47224558,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472246729,"data":"       |     C = (a, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472247881,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.472249073,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472250355,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472252043,"data":"       |     F = (x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.472254531,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.472255717,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472256967,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472258199,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.472259394,"data":"       |     # compute A intersection BF and CE\n"}
,{"stream_name":"stdout","time":2711.472260614,"data":"       |     # Solve for t,s\n"}
,{"stream_name":"stdout","time":2711.472265277,"data":"       |     # BF: (t*x_f, t*y_f)\n"}
,{"stream_name":"stdout","time":2711.472266626,"data":"       |     # CE: (a + s*(x_e - a), s*y_e)\n"}
,{"stream_name":"stdout","time":2711.47226788,"data":"       |     # Solve:\n"}
,{"stream_name":"stdout","time":2711.472269047,"data":"       |     # t*x_f = a + s*(x_e - a)\n"}
,{"stream_name":"stdout","time":2711.472270254,"data":"       |     # t*y_f = s*y_e\n"}
,{"stream_name":"stdout","time":2711.472271412,"data":"       |     # if y_f == 0, degenerate (should not happen)\n"}
,{"stream_name":"stdout","time":2711.472272647,"data":"       |     if abs(y_f) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472273875,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472275077,"data":"       |     # from second: t = s*y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.472276298,"data":"       |     # plug into first:\n"}
,{"stream_name":"stdout","time":2711.472277528,"data":"       |     # (s*y_e / y_f) * x_f = a + s*(x_e - a)\n"}
,{"stream_name":"stdout","time":2711.472278757,"data":"       |     # s * (y_e * x_f / y_f - (x_e - a)) = a\n"}
,{"stream_name":"stdout","time":2711.47227996,"data":"       |     denom = (y_e * x_f / y_f - (x_e - a))\n"}
,{"stream_name":"stdout","time":2711.472281177,"data":"       |     if abs(denom) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472282396,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472283599,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.472284791,"data":"       |     t = s * y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.47228598,"data":"       |     A = (t * x_f, t * y_f)\n"}
,{"stream_name":"stdout","time":2711.472287202,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.472288372,"data":"       |     O_ABC = circumcenter(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.472289582,"data":"       |     if O_ABC is None:\n"}
,{"stream_name":"stdout","time":2711.472290767,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472291953,"data":"       |     R_ABC = math.hypot(O_ABC[0]-A[0], O_ABC[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.472293185,"data":"       |     O_AEF = circumcenter(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.472294447,"data":"       |     if O_AEF is None:\n"}
,{"stream_name":"stdout","time":2711.472296228,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472297446,"data":"       |     R_AEF = math.hypot(O_AEF[0]-A[0], O_AEF[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.47229886,"data":"       |     # intersection points of circles\n"}
,{"stream_name":"stdout","time":2711.472300098,"data":"       |     pts = intersect_circles(O_ABC, R_ABC, O_AEF, R_AEF)\n"}
,{"stream_name":"stdout","time":2711.472301353,"data":"       |     if len(pts) \u003c 2:\n"}
,{"stream_name":"stdout","time":2711.472302586,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472303889,"data":"       |     # choose K not equal to A\n"}
,{"stream_name":"stdout","time":2711.472306462,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.472307662,"data":"       |     for pt in pts:\n"}
,{"stream_name":"stdout","time":2711.472308887,"data":"       |         if math.hypot(pt[0]-A[0], pt[1]-A[1]) \u003e 1e-6:\n"}
,{"stream_name":"stdout","time":2711.472310364,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.472311553,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.472312711,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.4723139,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.472315256,"data":"       |     K_prime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.472316498,"data":"       |     # N foot from D to EF\n"}
,{"stream_name":"stdout","time":2711.472317696,"data":"       |     D = (c0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472318907,"data":"       |     N = foot_of_perpendicular(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.472320132,"data":"       |     # condition: B,N,K,K' cyclic\n"}
,{"stream_name":"stdout","time":2711.472321344,"data":"       |     O_BKKp = circumcenter(B, K, K_prime)\n"}
,{"stream_name":"stdout","time":2711.472322538,"data":"       |     if O_BKKp is None:\n"}
,{"stream_name":"stdout","time":2711.472324108,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472325367,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472326647,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
,{"stream_name":"stdout","time":2711.472327933,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.472329126,"data":"       |     # line BN vector\n"}
,{"stream_name":"stdout","time":2711.472330349,"data":"       |     BN_vec = (N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472331543,"data":"       |     # direction perpendicular to BN through B\n"}
,{"stream_name":"stdout","time":2711.472332745,"data":"       |     d1 = (-BN_vec[1], BN_vec[0])\n"}
,{"stream_name":"stdout","time":2711.472333968,"data":"       |     # midpoint of BK\n"}
,{"stream_name":"stdout","time":2711.472335163,"data":"       |     M = ((B[0]+K[0])/2.0, (B[1]+K[1])/2.0)\n"}
,{"stream_name":"stdout","time":2711.472336376,"data":"       |     # direction perpendicular to BK\n"}
,{"stream_name":"stdout","time":2711.472337563,"data":"       |     BK_vec = (K[0]-B[0], K[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.47233882,"data":"       |     d2 = (-BK_vec[1], BK_vec[0])\n"}
,{"stream_name":"stdout","time":2711.472340018,"data":"       |     # solve B + u*d1 = M + v*d2\n"}
,{"stream_name":"stdout","time":2711.472341229,"data":"       |     # u*d1 - v*d2 = M - B\n"}
,{"stream_name":"stdout","time":2711.472342428,"data":"       |     A_mat = np.array([[d1[0], -d2[0]], [d1[1], -d2[1]]], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.472343717,"data":"       |     rhs = np.array([M[0]-B[0], M[1]-B[1]], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.47234498,"data":"       |     det = A_mat[0,0]*A_mat[1,1] - A_mat[0,1]*A_mat[1,0]\n"}
,{"stream_name":"stdout","time":2711.472346205,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472347444,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472348657,"data":"       |     u = (rhs[0]*A_mat[1,1] - rhs[1]*A_mat[0,1]) / det\n"}
,{"stream_name":"stdout","time":2711.472349891,"data":"       |     O_T = (B[0] + u*d1[0], B[1] + u*d1[1])\n"}
,{"stream_name":"stdout","time":2711.472352445,"data":"       |     T = (2*O_T[0], 0.0)\n"}
,{"stream_name":"stdout","time":2711.472353667,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.472354838,"data":"       |     CT = math.hypot(C[0]-T[0], C[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.472356052,"data":"       |     BT = math.hypot(B[0]-T[0], B[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.472357286,"data":"       |     NB = math.hypot(N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472358498,"data":"       |     NE = math.hypot(N[0]-E[0], N[1]-E[1])\n"}
,{"stream_name":"stdout","time":2711.472359776,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.472360997,"data":"       |     return cond, ratio, {'A':A,'K':K,'Kp':K_prime,'N':N,'T':T,'O_T':O_T,'O_BKKp':O_BKKp}\n"}
,{"stream_name":"stdout","time":2711.472362324,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472363465,"data":"     [Code]:\n"}
,{"stream_name":"stdout","time":2711.472364637,"data":"       | # re-define functions (since previous cell may not have executed due to errors)\n"}
,{"stream_name":"stdout","time":2711.472365953,"data":"       | import math, numpy as np\n"}
,{"stream_name":"stdout","time":2711.472367156,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472368263,"data":"       | def circumcenter(P1, P2, P3):\n"}
,{"stream_name":"stdout","time":2711.472369498,"data":"       |     x1,y1 = P1\n"}
,{"stream_name":"stdout","time":2711.472370675,"data":"       |     x2,y2 = P2\n"}
,{"stream_name":"stdout","time":2711.472371875,"data":"       |     x3,y3 = P3\n"}
,{"stream_name":"stdout","time":2711.472373074,"data":"       |     d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.472374318,"data":"       |     if abs(d) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472375512,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.47237676,"data":"       |     ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2)) / d\n"}
,{"stream_name":"stdout","time":2711.472378136,"data":"       |     uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1)) / d\n"}
,{"stream_name":"stdout","time":2711.47237949,"data":"       |     return (ux, uy)\n"}
,{"stream_name":"stdout","time":2711.472381,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472382131,"data":"       | def intersect_circles(O1, R1, O2, R2):\n"}
,{"stream_name":"stdout","time":2711.47238337,"data":"       |     x1,y1 = O1\n"}
,{"stream_name":"stdout","time":2711.472384531,"data":"       |     x2,y2 = O2\n"}
,{"stream_name":"stdout","time":2711.472385694,"data":"       |     dx = x2 - x1\n"}
,{"stream_name":"stdout","time":2711.472386842,"data":"       |     dy = y2 - y1\n"}
,{"stream_name":"stdout","time":2711.472388018,"data":"       |     d = math.hypot(dx, dy)\n"}
,{"stream_name":"stdout","time":2711.472389254,"data":"       |     if d == 0:\n"}
,{"stream_name":"stdout","time":2711.47239041,"data":"       |         return []\n"}
,{"stream_name":"stdout","time":2711.472391592,"data":"       |     a = (R1**2 - R2**2 + d**2) / (2*d)\n"}
,{"stream_name":"stdout","time":2711.472392823,"data":"       |     h_sq = R1**2 - a**2\n"}
,{"stream_name":"stdout","time":2711.472394006,"data":"       |     if h_sq \u003c -1e-12:\n"}
,{"stream_name":"stdout","time":2711.472395214,"data":"       |         return []\n"}
,{"stream_name":"stdout","time":2711.472396416,"data":"       |     h = math.sqrt(max(0.0, h_sq))\n"}
,{"stream_name":"stdout","time":2711.472399554,"data":"       |     xm = x1 + a * dx / d\n"}
,{"stream_name":"stdout","time":2711.472400825,"data":"       |     ym = y1 + a * dy / d\n"}
,{"stream_name":"stdout","time":2711.472402049,"data":"       |     rx = -dy * (h / d)\n"}
,{"stream_name":"stdout","time":2711.472403235,"data":"       |     ry = dx * (h / d)\n"}
,{"stream_name":"stdout","time":2711.472404428,"data":"       |     p1 = (xm + rx, ym + ry)\n"}
,{"stream_name":"stdout","time":2711.472405656,"data":"       |     p2 = (xm - rx, ym - ry)\n"}
,{"stream_name":"stdout","time":2711.472406873,"data":"       |     return [p1, p2]\n"}
,{"stream_name":"stdout","time":2711.472408058,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472409211,"data":"       | def reflect_point_across_line(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.472410454,"data":"       |     ax, ay = A\n"}
,{"stream_name":"stdout","time":2711.472411629,"data":"       |     bx, by = B\n"}
,{"stream_name":"stdout","time":2711.472412798,"data":"       |     px, py = P\n"}
,{"stream_name":"stdout","time":2711.472413968,"data":"       |     dx = bx - ax\n"}
,{"stream_name":"stdout","time":2711.472415142,"data":"       |     dy = by - ay\n"}
,{"stream_name":"stdout","time":2711.472416337,"data":"       |     # projection scalar\n"}
,{"stream_name":"stdout","time":2711.472417561,"data":"       |     t = ((px-ax)*dx + (py-ay)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.472418816,"data":"       |     projx = ax + t*dx\n"}
,{"stream_name":"stdout","time":2711.472420008,"data":"       |     projy = ay + t*dy\n"}
,{"stream_name":"stdout","time":2711.472421164,"data":"       |     # reflected point\n"}
,{"stream_name":"stdout","time":2711.472422329,"data":"       |     rx = 2*projx - px\n"}
,{"stream_name":"stdout","time":2711.472423503,"data":"       |     ry = 2*projy - py\n"}
,{"stream_name":"stdout","time":2711.472424664,"data":"       |     return (rx, ry)\n"}
,{"stream_name":"stdout","time":2711.472425835,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472426994,"data":"       | def foot_of_perpendicular(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.472428205,"data":"       |     ax, ay = A\n"}
,{"stream_name":"stdout","time":2711.472429412,"data":"       |     bx, by = B\n"}
,{"stream_name":"stdout","time":2711.472430552,"data":"       |     px, py = P\n"}
,{"stream_name":"stdout","time":2711.472431704,"data":"       |     dx = bx - ax\n"}
,{"stream_name":"stdout","time":2711.472432885,"data":"       |     dy = by - ay\n"}
,{"stream_name":"stdout","time":2711.47243408,"data":"       |     t = ((px-ax)*dx + (py-ay)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.472435311,"data":"       |     projx = ax + t*dx\n"}
,{"stream_name":"stdout","time":2711.472436487,"data":"       |     projy = ay + t*dy\n"}
,{"stream_name":"stdout","time":2711.472437654,"data":"       |     return (projx, projy)\n"}
,{"stream_name":"stdout","time":2711.472438879,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472440027,"data":"       | def compute_ratio_numeric(c0, d0, r):\n"}
,{"stream_name":"stdout","time":2711.472441215,"data":"       |     a = c0 + d0\n"}
,{"stream_name":"stdout","time":2711.472442375,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472443575,"data":"       |     C = (a, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472444761,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.472445905,"data":"       |     x_f = c0 * (c0**2 - r**2) / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472447165,"data":"       |     y_f = 2 * c0**2 * r / (c0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472449579,"data":"       |     F = (x_f, y_f)\n"}
,{"stream_name":"stdout","time":2711.472450788,"data":"       |     # E\n"}
,{"stream_name":"stdout","time":2711.472451967,"data":"       |     x_e = c0 + 2 * d0 * r**2 / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472453204,"data":"       |     y_e = 2 * d0**2 * r / (d0**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.472454416,"data":"       |     E = (x_e, y_e)\n"}
,{"stream_name":"stdout","time":2711.472455606,"data":"       |     # compute A intersection BF and CE\n"}
,{"stream_name":"stdout","time":2711.472456863,"data":"       |     # Solve for t,s\n"}
,{"stream_name":"stdout","time":2711.472458218,"data":"       |     # BF: (t*x_f, t*y_f)\n"}
,{"stream_name":"stdout","time":2711.472459486,"data":"       |     # CE: (a + s*(x_e - a), s*y_e)\n"}
,{"stream_name":"stdout","time":2711.472460985,"data":"       |     # Solve:\n"}
,{"stream_name":"stdout","time":2711.472462188,"data":"       |     # t*x_f = a + s*(x_e - a)\n"}
,{"stream_name":"stdout","time":2711.472463501,"data":"       |     # t*y_f = s*y_e\n"}
,{"stream_name":"stdout","time":2711.472464709,"data":"       |     # if y_f == 0, degenerate (should not happen)\n"}
,{"stream_name":"stdout","time":2711.472465963,"data":"       |     if abs(y_f) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472467191,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472468517,"data":"       |     # from second: t = s*y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.472469751,"data":"       |     # plug into first:\n"}
,{"stream_name":"stdout","time":2711.472470928,"data":"       |     # (s*y_e / y_f) * x_f = a + s*(x_e - a)\n"}
,{"stream_name":"stdout","time":2711.472472158,"data":"       |     # s * (y_e * x_f / y_f - (x_e - a)) = a\n"}
,{"stream_name":"stdout","time":2711.472473482,"data":"       |     denom = (y_e * x_f / y_f - (x_e - a))\n"}
,{"stream_name":"stdout","time":2711.472474695,"data":"       |     if abs(denom) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.47247592,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472477098,"data":"       |     s = a / denom\n"}
,{"stream_name":"stdout","time":2711.472478303,"data":"       |     t = s * y_e / y_f\n"}
,{"stream_name":"stdout","time":2711.472479509,"data":"       |     A = (t * x_f, t * y_f)\n"}
,{"stream_name":"stdout","time":2711.472480685,"data":"       |     # circumcenters\n"}
,{"stream_name":"stdout","time":2711.472481909,"data":"       |     O_ABC = circumcenter(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.472483103,"data":"       |     if O_ABC is None:\n"}
,{"stream_name":"stdout","time":2711.472484257,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472485451,"data":"       |     R_ABC = math.hypot(O_ABC[0]-A[0], O_ABC[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.4724867,"data":"       |     O_AEF = circumcenter(A, E, F)\n"}
,{"stream_name":"stdout","time":2711.472487899,"data":"       |     if O_AEF is None:\n"}
,{"stream_name":"stdout","time":2711.472489085,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472490289,"data":"       |     R_AEF = math.hypot(O_AEF[0]-A[0], O_AEF[1]-A[1])\n"}
,{"stream_name":"stdout","time":2711.472491539,"data":"       |     # intersection points of circles\n"}
,{"stream_name":"stdout","time":2711.472492776,"data":"       |     pts = intersect_circles(O_ABC, R_ABC, O_AEF, R_AEF)\n"}
,{"stream_name":"stdout","time":2711.47249402,"data":"       |     if len(pts) \u003c 2:\n"}
,{"stream_name":"stdout","time":2711.472496472,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.47249768,"data":"       |     # choose K not equal to A\n"}
,{"stream_name":"stdout","time":2711.472498915,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.472500118,"data":"       |     for pt in pts:\n"}
,{"stream_name":"stdout","time":2711.472501303,"data":"       |         if math.hypot(pt[0]-A[0], pt[1]-A[1]) \u003e 1e-6:\n"}
,{"stream_name":"stdout","time":2711.47250261,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.472503768,"data":"       |     if K is None:\n"}
,{"stream_name":"stdout","time":2711.472504933,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472506109,"data":"       |     # K' reflection across EF\n"}
,{"stream_name":"stdout","time":2711.472507329,"data":"       |     K_prime = reflect_point_across_line(K, E, F)\n"}
,{"stream_name":"stdout","time":2711.472508593,"data":"       |     # N foot from D to EF\n"}
,{"stream_name":"stdout","time":2711.472509825,"data":"       |     D = (c0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.472510999,"data":"       |     N = foot_of_perpendicular(D, E, F)\n"}
,{"stream_name":"stdout","time":2711.472512209,"data":"       |     # condition: B,N,K,K' cyclic\n"}
,{"stream_name":"stdout","time":2711.472513398,"data":"       |     O_BKKp = circumcenter(B, K, K_prime)\n"}
,{"stream_name":"stdout","time":2711.472514633,"data":"       |     if O_BKKp is None:\n"}
,{"stream_name":"stdout","time":2711.472515841,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472517018,"data":"       |     R_BKKp = math.hypot(O_BKKp[0]-B[0], O_BKKp[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.47251829,"data":"       |     cond = math.hypot(O_BKKp[0]-N[0], O_BKKp[1]-N[1]) - R_BKKp\n"}
,{"stream_name":"stdout","time":2711.472519571,"data":"       |     # compute T\n"}
,{"stream_name":"stdout","time":2711.472520737,"data":"       |     # line BN vector\n"}
,{"stream_name":"stdout","time":2711.472521898,"data":"       |     BN_vec = (N[0]-B[0], N[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472523096,"data":"       |     # direction perpendicular to BN through B\n"}
,{"stream_name":"stdout","time":2711.472524645,"data":"       |     d1 = (-BN_vec[1], BN_vec[0])\n"}
,{"stream_name":"stdout","time":2711.472525876,"data":"       |     # midpoint of BK\n"}
,{"stream_name":"stdout","time":2711.472527066,"data":"       |     M = ((B[0]+K[0])/2.0, (B[1]+K[1])/2.0)\n"}
,{"stream_name":"stdout","time":2711.472528292,"data":"       |     # direction perpendicular to BK\n"}
,{"stream_name":"stdout","time":2711.472529542,"data":"       |     BK_vec = (K[0]-B[0], K[1]-B[1])\n"}
,{"stream_name":"stdout","time":2711.472530738,"data":"       |     d2 = (-BK_vec[1], BK_vec[0])\n"}
,{"stream_name":"stdout","time":2711.472531934,"data":"       |     # solve B + u*d1 = M + v*d2\n"}
,{"stream_name":"stdout","time":2711.47253312,"data":"       |     # u*d1 - v*d2 = M - B\n"}
,{"stream_name":"stdout","time":2711.472534329,"data":"       |     A_mat = np.array([[d1[0], -d2[0]], [d1[1], -d2[1]]], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.472535631,"data":"       |     rhs = np.array([M[0]-B[0], M[1]-B[1]], dtype=float)\n"}
,{"stream_name":"stdout","time":2711.472536922,"data":"       |     det = A_mat[0,0]*A_mat[1,1] - A_mat[0,1]*A_mat[1,0]\n"}
,{"stream_name":"stdout","time":2711.472538153,"data":"       |     if abs(det) \u003c 1e-12:\n"}
,{"stream_name":"stdout","time":2711.472539396,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":2711.472540589,"data":"       |     u = (rhs[0]*A_mat[1,1] - rhs[1]*A_mat[0,1]) / det\n"}
,{"stream_name":"stdout","time":2711.472561583,"data":"       |     O_T = (B[0] + u*d1[0], B[1] + u*d1[1])\n"}
,{"stream_name":"stdout","time":2711.472563132,"data":"       |     T = (2*O_T[0], 0.0)\n"}
,{"stream_name":"stdout","time":2711.472564348,"data":"       |     # distances\n"}
,{"stream_name":"stdout","time":2711.472565536,"data":"       |     CT = math.hypot(C[0]-T[0], C[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.472566753,"data":"       |     BT = math.hypot(B[0]-T[0], B[1]-T[1])\n"}
,{"stream_name":"stdout","time":2711.472568069,"data":"       |     NB = math.hypot(N[0]-B[0], N[1]-B[1])\n"}
