,{"stream_name":"stdout","time":2711.471354598,"data":"       |     NB = N.distance(B)\n"}
,{"stream_name":"stdout","time":2711.471355826,"data":"       |     NE = N.distance(E)\n"}
,{"stream_name":"stdout","time":2711.471356998,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.47135821,"data":"       |     # simplify ratio\n"}
,{"stream_name":"stdout","time":2711.4713594,"data":"       |     ratio_simplified = sp.simplify(ratio)\n"}
,{"stream_name":"stdout","time":2711.471360612,"data":"       |     # return expression for condition and ratio\n"}
,{"stream_name":"stdout","time":2711.47136184,"data":"       |     return sp.simplify(cond_expr), sp.simplify(ratio_simplified), {\n"}
,{"stream_name":"stdout","time":2711.471363125,"data":"       |         'A': A, 'F': F, 'E': E, 'K': K, 'K_prime': K_prime, 'N': N, 'T': T\n"}
