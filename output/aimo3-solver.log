,{"stream_name":"stdout","time":2711.497239837,"data":"       | import sympy as sp\n"}
,{"stream_name":"stdout","time":2711.497241064,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.497242154,"data":"       | def numeric_solution(n, guess_factor=1.5):\n"}
,{"stream_name":"stdout","time":2711.497243341,"data":"       |     # compute numeric solution for s that satisfies cyclic condition\n"}
,{"stream_name":"stdout","time":2711.497244578,"data":"       |     a = fibonacci(n+2)\n"}
,{"stream_name":"stdout","time":2711.497245725,"data":"       |     d = fibonacci(n)\n"}
,{"stream_name":"stdout","time":2711.497246891,"data":"       |     c_seg = fibonacci(n+1)\n"}
,{"stream_name":"stdout","time":2711.497248041,"data":"       |     s = sp.symbols('s')\n"}
,{"stream_name":"stdout","time":2711.497249157,"data":"       |     # define side lengths\n"}
,{"stream_name":"stdout","time":2711.497250337,"data":"       |     b = s - d\n"}
,{"stream_name":"stdout","time":2711.497251475,"data":"       |     c = s - c_seg\n"}
,{"stream_name":"stdout","time":2711.497252623,"data":"       |     # coordinates\n"}
,{"stream_name":"stdout","time":2711.49725374,"data":"       |     xA = (c**2 - b**2 + a**2) / (2*a)\n"}
,{"stream_name":"stdout","time":2711.497254891,"data":"       |     yA = sp.sqrt(c**2 - xA**2)\n"}
,{"stream_name":"stdout","time":2711.497256058,"data":"       |     # Points\n"}
,{"stream_name":"stdout","time":2711.497257188,"data":"       |     B = sp.Point(0,0)\n"}
,{"stream_name":"stdout","time":2711.497258335,"data":"       |     C = sp.Point(a,0)\n"}
,{"stream_name":"stdout","time":2711.497259507,"data":"       |     A = sp.Point(xA, yA)\n"}
,{"stream_name":"stdout","time":2711.497260647,"data":"       |     # Points F and E\n"}
,{"stream_name":"stdout","time":2711.497265748,"data":"       |     # BF = d\n"}
,{"stream_name":"stdout","time":2711.497267021,"data":"       |     BF = d\n"}
,{"stream_name":"stdout","time":2711.49726814,"data":"       |     # AB length = c\n"}
,{"stream_name":"stdout","time":2711.497269257,"data":"       |     # F coordinates\n"}
,{"stream_name":"stdout","time":2711.497270402,"data":"       |     F = sp.Point(xA * BF / c, yA * BF / c)\n"}
,{"stream_name":"stdout","time":2711.497271597,"data":"       |     # CE = c_seg\n"}
,{"stream_name":"stdout","time":2711.497272781,"data":"       |     CE = c_seg\n"}
,{"stream_name":"stdout","time":2711.497273885,"data":"       |     # E coordinates\n"}
,{"stream_name":"stdout","time":2711.497275067,"data":"       |     E = sp.Point(a + (xA - a) * CE / b, yA * CE / b)\n"}
,{"stream_name":"stdout","time":2711.497276251,"data":"       |     # line EF\n"}
,{"stream_name":"stdout","time":2711.497277382,"data":"       |     line_EF = sp.Line(E, F)\n"}
,{"stream_name":"stdout","time":2711.497278535,"data":"       |     # D point\n"}
,{"stream_name":"stdout","time":2711.497279664,"data":"       |     D = sp.Point(d, 0)\n"}
,{"stream_name":"stdout","time":2711.49728082,"data":"       |     # N foot\n"}
,{"stream_name":"stdout","time":2711.497282191,"data":"       |     N = line_EF.projection(D)\n"}
,{"stream_name":"stdout","time":2711.497283325,"data":"       |     # Circles\n"}
,{"stream_name":"stdout","time":2711.497284467,"data":"       |     Omega = sp.Circle(A, B, C)\n"}
,{"stream_name":"stdout","time":2711.497285621,"data":"       |     circle_AFE = sp.Circle(A, F, E)\n"}
,{"stream_name":"stdout","time":2711.4972868,"data":"       |     inter = Omega.intersection(circle_AFE)\n"}
,{"stream_name":"stdout","time":2711.497287954,"data":"       |     # Determine K (point not equal to A)\n"}
,{"stream_name":"stdout","time":2711.497290854,"data":"       |     K = None\n"}
,{"stream_name":"stdout","time":2711.497292001,"data":"       |     for pt in inter:\n"}
,{"stream_name":"stdout","time":2711.497293155,"data":"       |         if not pt.equals(A):\n"}
,{"stream_name":"stdout","time":2711.497294315,"data":"       |             K = pt\n"}
,{"stream_name":"stdout","time":2711.49729546,"data":"       |     # Kprime\n"}
,{"stream_name":"stdout","time":2711.497296624,"data":"       |     Kprime = K.reflect(line_EF)\n"}
,{"stream_name":"stdout","time":2711.497297797,"data":"       |     # Circle through K,N,B\n"}
,{"stream_name":"stdout","time":2711.497298941,"data":"       |     circle_KNB = sp.Circle(K, N, B)\n"}
,{"stream_name":"stdout","time":2711.497300224,"data":"       |     # cyclic condition: Kprime lies on this circle\n"}
,{"stream_name":"stdout","time":2711.49730144,"data":"       |     eq = sp.simplify(Kprime.distance(circle_KNB.center)**2 - circle_KNB.radius**2)\n"}
,{"stream_name":"stdout","time":2711.497302974,"data":"       |     # eq is expression in s (maybe sqrt terms)\n"}
,{"stream_name":"stdout","time":2711.49730417,"data":"       |     # Use numeric evaluation\n"}
,{"stream_name":"stdout","time":2711.497305314,"data":"       |     eq_func = sp.lambdify(s, eq, 'numpy')\n"}
,{"stream_name":"stdout","time":2711.497306464,"data":"       |     # Solve for s using nsolve\n"}
,{"stream_name":"stdout","time":2711.497307611,"data":"       |     # Provide initial guess \u003e a\n"}
,{"stream_name":"stdout","time":2711.497308777,"data":"       |     guess = a * guess_factor\n"}
,{"stream_name":"stdout","time":2711.497309951,"data":"       |     try:\n"}
,{"stream_name":"stdout","time":2711.497311105,"data":"       |         sol = sp.nsolve(eq, s, guess, tol=1e-14, maxsteps=100)\n"}
,{"stream_name":"stdout","time":2711.49731236,"data":"       |         sol_val = float(sol)\n"}
,{"stream_name":"stdout","time":2711.49731351,"data":"       |         # compute ratio R\n"}
,{"stream_name":"stdout","time":2711.49731464,"data":"       |         # compute all points numerically\n"}
,{"stream_name":"stdout","time":2711.497315787,"data":"       |         # Evaluate coordinates numerically using sol\n"}
,{"stream_name":"stdout","time":2711.497316977,"data":"       |         subs = {s: sol_val}\n"}
,{"stream_name":"stdout","time":2711.49731812,"data":"       |         # Recompute points numerically\n"}
,{"stream_name":"stdout","time":2711.497319264,"data":"       |         xA_val = float(xA.subs(subs))\n"}
,{"stream_name":"stdout","time":2711.497320447,"data":"       |         yA_val = float(yA.subs(subs))\n"}
,{"stream_name":"stdout","time":2711.497321638,"data":"       |         A_val = sp.Point(xA_val, yA_val)\n"}
,{"stream_name":"stdout","time":2711.497322785,"data":"       |         B_val = sp.Point(0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.497323958,"data":"       |         C_val = sp.Point(float(a), 0.0)\n"}
,{"stream_name":"stdout","time":2711.497325115,"data":"       |         # F\n"}
,{"stream_name":"stdout","time":2711.497326254,"data":"       |         c_val = sol_val - c_seg\n"}
,{"stream_name":"stdout","time":2711.497327442,"data":"       |         BF_val = d\n"}
,{"stream_name":"stdout","time":2711.497328597,"data":"       |         F_val = sp.Point(xA_val * BF_val / c_val, yA_val * BF_val / c_val)\n"}
,{"stream_name":"stdout","time":2711.49732984,"data":"       |         # E\n"}
,{"stream_name":"stdout","time":2711.497330991,"data":"       |         b_val = sol_val - d\n"}
,{"stream_name":"stdout","time":2711.497332145,"data":"       |         CE_val = c_seg\n"}
,{"stream_name":"stdout","time":2711.49733332,"data":"       |         E_val = sp.Point(float(a) + (xA_val - float(a)) * CE_val / b_val, yA_val * CE_val / b_val)\n"}
,{"stream_name":"stdout","time":2711.497337044,"data":"       |         # line EF\n"}
,{"stream_name":"stdout","time":2711.497338218,"data":"       |         line_EF_val = sp.Line(E_val, F_val)\n"}
,{"stream_name":"stdout","time":2711.497339381,"data":"       |         D_val = sp.Point(float(d), 0.0)\n"}
,{"stream_name":"stdout","time":2711.497340534,"data":"       |         N_val = line_EF_val.projection(D_val)\n"}
,{"stream_name":"stdout","time":2711.497341727,"data":"       |         # K: recompute intersection of circles\n"}
,{"stream_name":"stdout","time":2711.497342927,"data":"       |         Omega_val = sp.Circle(A_val, B_val, C_val)\n"}
,{"stream_name":"stdout","time":2711.497344137,"data":"       |         circle_AFE_val = sp.Circle(A_val, F_val, E_val)\n"}
,{"stream_name":"stdout","time":2711.497345354,"data":"       |         inter_val = Omega_val.intersection(circle_AFE_val)\n"}
,{"stream_name":"stdout","time":2711.497346584,"data":"       |         # find K\n"}
,{"stream_name":"stdout","time":2711.497347721,"data":"       |         K_val = None\n"}
,{"stream_name":"stdout","time":2711.497348847,"data":"       |         for pt in inter_val:\n"}
,{"stream_name":"stdout","time":2711.497349988,"data":"       |             if not pt.equals(A_val):\n"}
,{"stream_name":"stdout","time":2711.497351141,"data":"       |                 K_val = pt\n"}
,{"stream_name":"stdout","time":2711.497352357,"data":"       |         # Kprime\n"}
,{"stream_name":"stdout","time":2711.497353472,"data":"       |         Kprime_val = K_val.reflect(line_EF_val)\n"}
,{"stream_name":"stdout","time":2711.497354635,"data":"       |         # Circle through K,N,B\n"}
,{"stream_name":"stdout","time":2711.49735581,"data":"       |         circle_KNB_val = sp.Circle(K_val, N_val, B_val)\n"}
,{"stream_name":"stdout","time":2711.497357015,"data":"       |         # verify cyclic condition numeric\n"}
,{"stream_name":"stdout","time":2711.49735848,"data":"       |         # compute T: circle through B,K tangent to BN at B\n"}
,{"stream_name":"stdout","time":2711.497359694,"data":"       |         line_BN_val = sp.Line(B_val, N_val)\n"}
,{"stream_name":"stdout","time":2711.497360897,"data":"       |         perp_B_val = line_BN_val.perpendicular_line(B_val)\n"}
,{"stream_name":"stdout","time":2711.497362135,"data":"       |         # perpendicular bisector of BK\n"}
,{"stream_name":"stdout","time":2711.497363315,"data":"       |         mid_BK_val = sp.Point((B_val.x + K_val.x)/2, (B_val.y + K_val.y)/2)\n"}
,{"stream_name":"stdout","time":2711.497364585,"data":"       |         line_BK_val = sp.Line(B_val, K_val)\n"}
,{"stream_name":"stdout","time":2711.497365777,"data":"       |         perp_BK_val = line_BK_val.perpendicular_line(mid_BK_val)\n"}
,{"stream_name":"stdout","time":2711.497367014,"data":"       |         O_T_val = perp_B_val.intersection(perp_BK_val)[0]\n"}
,{"stream_name":"stdout","time":2711.497368205,"data":"       |         r_T_val = O_T_val.distance(B_val)\n"}
,{"stream_name":"stdout","time":2711.497369377,"data":"       |         # Intersection with BC (y=0)\n"}
,{"stream_name":"stdout","time":2711.497370528,"data":"       |         line_BC_val = sp.Line(B_val, C_val)\n"}
,{"stream_name":"stdout","time":2711.497371734,"data":"       |         circle_T_val = sp.Circle(O_T_val, r_T_val)\n"}
,{"stream_name":"stdout","time":2711.497372924,"data":"       |         inter_T_val = circle_T_val.intersection(line_BC_val)\n"}
,{"stream_name":"stdout","time":2711.497374138,"data":"       |         T_val = None\n"}
,{"stream_name":"stdout","time":2711.497375251,"data":"       |         for pt in inter_T_val:\n"}
,{"stream_name":"stdout","time":2711.497378178,"data":"       |             if not pt.equals(B_val):\n"}
,{"stream_name":"stdout","time":2711.497379371,"data":"       |                 T_val = pt\n"}
,{"stream_name":"stdout","time":2711.497380522,"data":"       |         # compute ratio\n"}
,{"stream_name":"stdout","time":2711.497381637,"data":"       |         CT = C_val.distance(T_val)\n"}
,{"stream_name":"stdout","time":2711.497382811,"data":"       |         NB = N_val.distance(B_val)\n"}
,{"stream_name":"stdout","time":2711.497383971,"data":"       |         BT = B_val.distance(T_val)\n"}
,{"stream_name":"stdout","time":2711.497385124,"data":"       |         NE = N_val.distance(E_val)\n"}
,{"stream_name":"stdout","time":2711.497386281,"data":"       |         R_val = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.497387431,"data":"       |         return sol_val, float(R_val)\n"}
,{"stream_name":"stdout","time":2711.497388575,"data":"       |     except Exception as e:\n"}
,{"stream_name":"stdout","time":2711.497389751,"data":"       |         print(\"Error solving for n\", n, e)\n"}
,{"stream_name":"stdout","time":2711.497390975,"data":"       |         return None, None\n"}
