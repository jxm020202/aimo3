,{"stream_name":"stdout","time":2711.472212534,"data":"       | def reflect_point_across_line(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.472213754,"data":"       |     ax, ay = A\n"}
,{"stream_name":"stdout","time":2711.472214963,"data":"       |     bx, by = B\n"}
,{"stream_name":"stdout","time":2711.472216114,"data":"       |     px, py = P\n"}
,{"stream_name":"stdout","time":2711.472217263,"data":"       |     dx = bx - ax\n"}
,{"stream_name":"stdout","time":2711.472218416,"data":"       |     dy = by - ay\n"}
,{"stream_name":"stdout","time":2711.472219603,"data":"       |     # projection scalar\n"}
,{"stream_name":"stdout","time":2711.472220788,"data":"       |     t = ((px-ax)*dx + (py-ay)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.47222204,"data":"       |     projx = ax + t*dx\n"}
,{"stream_name":"stdout","time":2711.472223192,"data":"       |     projy = ay + t*dy\n"}
,{"stream_name":"stdout","time":2711.472224386,"data":"       |     # reflected point\n"}
,{"stream_name":"stdout","time":2711.472225554,"data":"       |     rx = 2*projx - px\n"}
,{"stream_name":"stdout","time":2711.472226717,"data":"       |     ry = 2*projy - py\n"}
,{"stream_name":"stdout","time":2711.472227883,"data":"       |     return (rx, ry)\n"}
,{"stream_name":"stdout","time":2711.472229063,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.472230197,"data":"       | def foot_of_perpendicular(P, A, B):\n"}
,{"stream_name":"stdout","time":2711.472231418,"data":"       |     ax, ay = A\n"}
,{"stream_name":"stdout","time":2711.472232569,"data":"       |     bx, by = B\n"}
,{"stream_name":"stdout","time":2711.472233743,"data":"       |     px, py = P\n"}
,{"stream_name":"stdout","time":2711.472234885,"data":"       |     dx = bx - ax\n"}
,{"stream_name":"stdout","time":2711.472236065,"data":"       |     dy = by - ay\n"}
,{"stream_name":"stdout","time":2711.472237278,"data":"       |     t = ((px-ax)*dx + (py-ay)*dy) / (dx*dx + dy*dy)\n"}
,{"stream_name":"stdout","time":2711.472238504,"data":"       |     projx = ax + t*dx\n"}
,{"stream_name":"stdout","time":2711.47223965,"data":"       |     projy = ay + t*dy\n"}
,{"stream_name":"stdout","time":2711.472240823,"data":"       |     return (projx, projy)\n"}
