,{"stream_name":"stdout","time":3398.356544439,"data":"       |     # compute intersection points of each chord from family s1 with each chord from family s2\n"}
,{"stream_name":"stdout","time":3398.356545747,"data":"       |     chords_s1 = [ch for ch in chords_quad if s_of(ch)==s1]\n"}
,{"stream_name":"stdout","time":3398.356547128,"data":"       |     chords_s2 = [ch for ch in chords_quad if s_of(ch)==s2]\n"}
,{"stream_name":"stdout","time":3398.356548348,"data":"       |     # compute four intersection points\n"}
,{"stream_name":"stdout","time":3398.356549559,"data":"       |     pts = []\n"}
,{"stream_name":"stdout","time":3398.356550704,"data":"       |     for ch1 in chords_s1:\n"}
,{"stream_name":"stdout","time":3398.356551892,"data":"       |         for ch2 in chords_s2:\n"}
,{"stream_name":"stdout","time":3398.356553403,"data":"       |             p = intersect(line_from_chord(ch1), line_from_chord(ch2))\n"}
,{"stream_name":"stdout","time":3398.356554654,"data":"       |             if p is None:\n"}
,{"stream_name":"stdout","time":3398.356555792,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":3398.356556955,"data":"       |             pts.append(p)\n"}
,{"stream_name":"stdout","time":3398.356558118,"data":"       |     # check distinct points\n"}
,{"stream_name":"stdout","time":3398.3565593,"data":"       |     # Use tolerance\n"}
,{"stream_name":"stdout","time":3398.356560464,"data":"       |     uniq_pts = []\n"}
