,{"stream_name":"stdout","time":2711.470229048,"data":"       |     DE = (D[0] - E[0], D[1] - E[1])\n"}
,{"stream_name":"stdout","time":2711.470230335,"data":"       |     t_param = (DE[0]*vEF[0] + DE[1]*vEF[1]) / (vEF[0]**2 + vEF[1]**2)\n"}
,{"stream_name":"stdout","time":2711.470231651,"data":"       |     N = (E[0] + t_param * vEF[0], E[1] + t_param * vEF[1])\n"}
,{"stream_name":"stdout","time":2711.470232908,"data":"       |     # circumcenter O\n"}
,{"stream_name":"stdout","time":2711.470234219,"data":"       |     O = (L/2.0, (x**2 + y**2 - x*L) / (2*y))\n"}
,{"stream_name":"stdout","time":2711.470235435,"data":"       |     R = mp.sqrt(O[0]**2 + O[1]**2)\n"}
,{"stream_name":"stdout","time":2711.470236638,"data":"       |     # exsimilicenter X external\n"}
,{"stream_name":"stdout","time":2711.470237825,"data":"       |     X = ((R*I[0] - r*O[0])/(R - r), (R*I[1] - r*O[1])/(R - r))\n"}
,{"stream_name":"stdout","time":2711.470239254,"data":"       |     # line AX intersect circumcircle at K\n"}
,{"stream_name":"stdout","time":2711.470240527,"data":"       |     u = (X[0] - x, X[1] - y)\n"}
,{"stream_name":"stdout","time":2711.470241735,"data":"       |     Ax = x - O[0]\n"}
,{"stream_name":"stdout","time":2711.470242937,"data":"       |     Ay = y - O[1]\n"}
,{"stream_name":"stdout","time":2711.470244225,"data":"       |     a_coef = u[0]**2 + u[1]**2\n"}
,{"stream_name":"stdout","time":2711.470245422,"data":"       |     b_coef = 2*(Ax*u[0] + Ay*u[1])\n"}
,{"stream_name":"stdout","time":2711.470246611,"data":"       |     c_coef = Ax**2 + Ay**2 - R**2\n"}
,{"stream_name":"stdout","time":2711.470247785,"data":"       |     disc = b_coef**2 - 4*a_coef*c_coef\n"}
,{"stream_name":"stdout","time":2711.470249114,"data":"       |     sqrt_disc = mp.sqrt(disc)\n"}
,{"stream_name":"stdout","time":2711.470250351,"data":"       |     s1 = (-b_coef + sqrt_disc) / (2*a_coef)\n"}
,{"stream_name":"stdout","time":2711.470251549,"data":"       |     s2 = (-b_coef - sqrt_disc) / (2*a_coef)\n"}
,{"stream_name":"stdout","time":2711.470252754,"data":"       |     sK = s1 if abs(s1) \u003e 1e-12 else s2\n"}
,{"stream_name":"stdout","time":2711.470253969,"data":"       |     K = (x + sK*u[0], y + sK*u[1])\n"}
,{"stream_name":"stdout","time":2711.470256155,"data":"       |     # compute t using formula derived earlier\n"}
,{"stream_name":"stdout","time":2711.470257435,"data":"       |     Nx, Ny = N\n"}
,{"stream_name":"stdout","time":2711.470258628,"data":"       |     Kx, Ky = K\n"}
,{"stream_name":"stdout","time":2711.470259781,"data":"       |     t = (Kx**2 + Ky**2) / (Kx - (Ky * Nx)/Ny)\n"}
,{"stream_name":"stdout","time":2711.470261039,"data":"       |     # compute ratio\n"}
,{"stream_name":"stdout","time":2711.470265955,"data":"       |     NB = mp.sqrt(Nx**2 + Ny**2)\n"}
,{"stream_name":"stdout","time":2711.470267501,"data":"       |     NE = mp.sqrt((Nx - E[0])**2 + (Ny - E[1])**2)\n"}
,{"stream_name":"stdout","time":2711.470268758,"data":"       |     CT = L - t\n"}
,{"stream_name":"stdout","time":2711.470269938,"data":"       |     BT = t\n"}
,{"stream_name":"stdout","time":2711.470271112,"data":"       |     ratio = (CT * NB) / (BT * NE)\n"}
,{"stream_name":"stdout","time":2711.470272331,"data":"       |     return ratio, t\n"}
,{"stream_name":"stdout","time":2711.470273522,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.470274732,"data":"       | for n in [5,6,7,8,9,10,11,12]:\n"}
,{"stream_name":"stdout","time":2711.470275948,"data":"       |     ratio, t = cyclic_ratio_and_t(n)\n"}
,{"stream_name":"stdout","time":2711.470277164,"data":"       |     print(n, ratio, t)\n"}
