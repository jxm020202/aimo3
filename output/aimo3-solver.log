,{"stream_name":"stdout","time":2711.489021431,"data":"       | def distance(P,Q):\n"}
,{"stream_name":"stdout","time":2711.489022641,"data":"       |     return math.hypot(P[0]-Q[0], P[1]-Q[1])\n"}
,{"stream_name":"stdout","time":2711.489023843,"data":"       | \n"}
,{"stream_name":"stdout","time":2711.489024978,"data":"       | def compute_points(p,q,r):\n"}
,{"stream_name":"stdout","time":2711.48902617,"data":"       |     # B, C, I\n"}
,{"stream_name":"stdout","time":2711.489027321,"data":"       |     B = (0.0, 0.0)\n"}
,{"stream_name":"stdout","time":2711.489028496,"data":"       |     C = (p+q, 0.0)\n"}
,{"stream_name":"stdout","time":2711.489029647,"data":"       |     I = (p, r)\n"}
,{"stream_name":"stdout","time":2711.489030865,"data":"       |     # slopes\n"}
,{"stream_name":"stdout","time":2711.489032036,"data":"       |     mB = 2*p*r/(p**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.489033231,"data":"       |     mC = 2*q*r/(q**2 - r**2)\n"}
,{"stream_name":"stdout","time":2711.489035997,"data":"       |     # A\n"}
,{"stream_name":"stdout","time":2711.489037254,"data":"       |     xA = -mC*(p+q)/(mB - mC)\n"}
,{"stream_name":"stdout","time":2711.48903845,"data":"       |     yA = mB*xA\n"}
,{"stream_name":"stdout","time":2711.489039663,"data":"       |     A = (xA, yA)\n"}
,{"stream_name":"stdout","time":2711.489040811,"data":"       |     # F\n"}
,{"stream_name":"stdout","time":2711.489042012,"data":"       |     Fx = p*(p**2 - r**2)/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.489043245,"data":"       |     Fy = 2*p**2*r/(p**2 + r**2)\n"}
,{"stream_name":"stdout","time":2711.489044449,"data":"       |     F = (Fx, Fy)\n"}
,{"stream_name":"stdout","time":2711.489045647,"data":"       |     # line AI: compute reflection of F across line AI to get E\n"}
,{"stream_name":"stdout","time":2711.489046976,"data":"       |     # Represent line AI as point A and direction vector (I-A)\n"}
,{"stream_name":"stdout","time":2711.489048268,"data":"       |     # Compute reflection of point across line defined by point P0 and unit direction u\n"}
,{"stream_name":"stdout","time":2711.48904957,"data":"       |     import numpy as np\n"}
,{"stream_name":"stdout","time":2711.489050725,"data":"       |     A_np = np.array(A)\n"}
,{"stream_name":"stdout","time":2711.489051993,"data":"       |     I_np = np.array(I)\n"}
,{"stream_name":"stdout","time":2711.489053167,"data":"       |     F_np = np.array(F)\n"}
,{"stream_name":"stdout","time":2711.489054315,"data":"       |     u = I_np - A_np\n"}
,{"stream_name":"stdout","time":2711.489055481,"data":"       |     # unit direction\n"}
,{"stream_name":"stdout","time":2711.489056661,"data":"       |     u_norm = u / np.linalg.norm(u)\n"}
,{"stream_name":"stdout","time":2711.489057866,"data":"       |     # projection of vector AF onto u\n"}
,{"stream_name":"stdout","time":2711.489059074,"data":"       |     AF = F_np - A_np\n"}
,{"stream_name":"stdout","time":2711.489060245,"data":"       |     proj = np.dot(AF, u_norm) * u_norm\n"}
,{"stream_name":"stdout","time":2711.48906151,"data":"       |     # perpendicular component\n"}
,{"stream_name":"stdout","time":2711.489062672,"data":"       |     perp = AF - proj\n"}
,{"stream_name":"stdout","time":2711.489063853,"data":"       |     # reflection: F' = F - 2*perp\n"}
,{"stream_name":"stdout","time":2711.489065081,"data":"       |     E_np = F_np - 2*perp\n"}
,{"stream_name":"stdout","time":2711.489066267,"data":"       |     E = tuple(E_np.tolist())\n"}
,{"stream_name":"stdout","time":2711.489067463,"data":"       |     # line EF: compute foot N from D to EF\n"}
,{"stream_name":"stdout","time":2711.489068677,"data":"       |     D = (p, 0.0)\n"}
,{"stream_name":"stdout","time":2711.489069825,"data":"       |     # line EF param: E + t*(F-E)\n"}
,{"stream_name":"stdout","time":2711.489071098,"data":"       |     # foot of D onto line: compute projection onto direction vector\n"}
,{"stream_name":"stdout","time":2711.489072604,"data":"       |     E_np = np.array(E)\n"}
,{"stream_name":"stdout","time":2711.489073797,"data":"       |     F_np = np.array(F)\n"}
,{"stream_name":"stdout","time":2711.489074987,"data":"       |     D_np = np.array(D)\n"}
,{"stream_name":"stdout","time":2711.489076156,"data":"       |     v = F_np - E_np\n"}
,{"stream_name":"stdout","time":2711.489077336,"data":"       |     t = np.dot(D_np - E_np, v) / np.dot(v, v)\n"}
,{"stream_name":"stdout","time":2711.489078547,"data":"       |     N_np = E_np + t * v\n"}
,{"stream_name":"stdout","time":2711.489079704,"data":"       |     N = tuple(N_np.tolist())\n"}
,{"stream_name":"stdout","time":2711.489080967,"data":"       |     # circumcircle of ABC: compute center O1 using perpendicular bisectors\n"}
,{"stream_name":"stdout","time":2711.489085015,"data":"       |     # Use function to compute circle center from three points\n"}
,{"stream_name":"stdout","time":2711.489086328,"data":"       |     def circumcenter(P1,P2,P3):\n"}
,{"stream_name":"stdout","time":2711.489087533,"data":"       |         # using linear algebra\n"}
,{"stream_name":"stdout","time":2711.489088734,"data":"       |         x1,y1=P1; x2,y2=P2; x3,y3=P3\n"}
,{"stream_name":"stdout","time":2711.489089927,"data":"       |         d = 2*(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2))\n"}
,{"stream_name":"stdout","time":2711.48909116,"data":"       |         ux = ((x1**2+y1**2)*(y2-y3)+(x2**2+y2**2)*(y3-y1)+(x3**2+y3**2)*(y1-y2))/d\n"}
,{"stream_name":"stdout","time":2711.48909247,"data":"       |         uy = ((x1**2+y1**2)*(x3-x2)+(x2**2+y2**2)*(x1-x3)+(x3**2+y3**2)*(x2-x1))/d\n"}
,{"stream_name":"stdout","time":2711.489093859,"data":"       |         return (ux, uy)\n"}
,{"stream_name":"stdout","time":2711.489095018,"data":"       |     O1 = circumcenter(A,B,C)\n"}
,{"stream_name":"stdout","time":2711.489096223,"data":"       |     R1 = distance(O1, A)\n"}
,{"stream_name":"stdout","time":2711.489097392,"data":"       |     # circumcircle of AFE\n"}
,{"stream_name":"stdout","time":2711.489098577,"data":"       |     O2 = circumcenter(A,F,E)\n"}
