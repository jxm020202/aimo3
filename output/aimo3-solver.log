,{"stream_name":"stdout","time":2937.175982204,"data":"       | - e=1 (n=2*odd): n = 2,6,10,14,18,30. Degrees: 1,2,4,6,6,8.\n"}
,{"stream_name":"stdout","time":2937.175983467,"data":"       | - e=2 (n=4*odd): n = 4,12,20. Degrees: 2,4,8.\n"}
