,{"stream_name":"stdout","time":2711.47121868,"data":"       |     # center O_T is intersection\n"}
,{"stream_name":"stdout","time":2711.471219872,"data":"       |     O_T = line_perp_BN.intersection(line_perp_BK)[0]\n"}
