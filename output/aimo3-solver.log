,{"stream_name":"stdout","time":3398.361847898,"data":"       |         line_data.append({'pair':pair,'coeff':(a,b,c),'ang':ang})\n"}
,{"stream_name":"stdout","time":3398.36184915,"data":"       |     # helper\n"}
,{"stream_name":"stdout","time":3398.361850304,"data":"       |     def is_parallel(i,j):\n"}
,{"stream_name":"stdout","time":3398.36185149,"data":"       |         return line_data[i]['ang']==line_data[j]['ang']\n"}
,{"stream_name":"stdout","time":3398.3618527,"data":"       |     def is_perpendicular(i,j):\n"}
,{"stream_name":"stdout","time":3398.361853861,"data":"       |         a1=line_data[i]['ang']\n"}
