,{"stream_name":"stdout","time":3398.369342162,"data":"       | import itertools, math\n"}
,{"stream_name":"stdout","time":3398.369343301,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369344362,"data":"       | def line_from_chord(chord):\n"}
,{"stream_name":"stdout","time":3398.369345463,"data":"       |     i,j = chord\n"}
,{"stream_name":"stdout","time":3398.369346533,"data":"       |     x1,y1 = verts[i]\n"}
,{"stream_name":"stdout","time":3398.369347605,"data":"       |     x2,y2 = verts[j]\n"}
,{"stream_name":"stdout","time":3398.36934876,"data":"       |     # return line coefficients (A,B,C) for line Ax + By = C\n"}
,{"stream_name":"stdout","time":3398.369349969,"data":"       |     # using cross product: (y2 - y1)x - (x2 - x1) y = (y2 - y1)x1 - (x2 - x1) y1\n"}
,{"stream_name":"stdout","time":3398.369351166,"data":"       |     A = y2 - y1\n"}
,{"stream_name":"stdout","time":3398.369352242,"data":"       |     B = -(x2 - x1)\n"}
,{"stream_name":"stdout","time":3398.369353371,"data":"       |     C = A*x1 + B*y1\n"}
,{"stream_name":"stdout","time":3398.369354485,"data":"       |     return (A,B,C)\n"}
,{"stream_name":"stdout","time":3398.369355605,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369356672,"data":"       | def intersect(line1, line2):\n"}
,{"stream_name":"stdout","time":3398.369357784,"data":"       |     A1,B1,C1 = line1\n"}
,{"stream_name":"stdout","time":3398.369358858,"data":"       |     A2,B2,C2 = line2\n"}
,{"stream_name":"stdout","time":3398.369359999,"data":"       |     det = A1*B2 - A2*B1\n"}
,{"stream_name":"stdout","time":3398.369361106,"data":"       |     if abs(det) \u003c 1e-9:\n"}
,{"stream_name":"stdout","time":3398.369362261,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.36936335,"data":"       |     x = (C1*B2 - C2*B1)/det\n"}
,{"stream_name":"stdout","time":3398.369364456,"data":"       |     y = (A1*C2 - A2*C1)/det\n"}
,{"stream_name":"stdout","time":3398.369365599,"data":"       |     return (x,y)\n"}
,{"stream_name":"stdout","time":3398.369366716,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.36936924,"data":"       | def is_point_on_segment(p, chord):\n"}
,{"stream_name":"stdout","time":3398.369370419,"data":"       |     i,j = chord\n"}
,{"stream_name":"stdout","time":3398.369371514,"data":"       |     x,y = p\n"}
,{"stream_name":"stdout","time":3398.36937263,"data":"       |     x1,y1 = verts[i]\n"}
,{"stream_name":"stdout","time":3398.369373735,"data":"       |     x2,y2 = verts[j]\n"}
,{"stream_name":"stdout","time":3398.369375048,"data":"       |     # check within bounding box with tolerance\n"}
,{"stream_name":"stdout","time":3398.369376365,"data":"       |     eps = 1e-9\n"}
,{"stream_name":"stdout","time":3398.369377517,"data":"       |     if (min(x1,x2)-eps \u003c= x \u003c= max(x1,x2)+eps) and (min(y1,y2)-eps \u003c= y \u003c= max(y1,y2)+eps):\n"}
,{"stream_name":"stdout","time":3398.369379041,"data":"       |         # also check collinearity\n"}
,{"stream_name":"stdout","time":3398.369380181,"data":"       |         # cross product of (p - v1) and (v2 - v1) should be zero\n"}
,{"stream_name":"stdout","time":3398.369381491,"data":"       |         cross = (x - x1)*(y2 - y1) - (y - y1)*(x2 - x1)\n"}
,{"stream_name":"stdout","time":3398.369382703,"data":"       |         if abs(cross) \u003c 1e-8:\n"}
,{"stream_name":"stdout","time":3398.369384023,"data":"       |             return True\n"}
,{"stream_name":"stdout","time":3398.369385127,"data":"       |     return False\n"}
,{"stream_name":"stdout","time":3398.369386357,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369387403,"data":"       | def rectangle_from_chords(c1,c2,c3,c4):\n"}
,{"stream_name":"stdout","time":3398.369388661,"data":"       |     # c1,c2 parallel (orientation d); c3,c4 parallel (orientation d+6)\n"}
,{"stream_name":"stdout","time":3398.369389837,"data":"       |     # compute intersection points\n"}
,{"stream_name":"stdout","time":3398.369391059,"data":"       |     l1 = line_from_chord(c1)\n"}
,{"stream_name":"stdout","time":3398.369392232,"data":"       |     l2 = line_from_chord(c2)\n"}
,{"stream_name":"stdout","time":3398.369393493,"data":"       |     l3 = line_from_chord(c3)\n"}
,{"stream_name":"stdout","time":3398.369394585,"data":"       |     l4 = line_from_chord(c4)\n"}
,{"stream_name":"stdout","time":3398.369395842,"data":"       |     p13 = intersect(l1,l3)\n"}
,{"stream_name":"stdout","time":3398.369396941,"data":"       |     p14 = intersect(l1,l4)\n"}
,{"stream_name":"stdout","time":3398.369398065,"data":"       |     p23 = intersect(l2,l3)\n"}
,{"stream_name":"stdout","time":3398.369399183,"data":"       |     p24 = intersect(l2,l4)\n"}
,{"stream_name":"stdout","time":3398.369400307,"data":"       |     # ensure points exist and lie on the respective segments\n"}
,{"stream_name":"stdout","time":3398.369401505,"data":"       |     if None in (p13,p14,p23,p24):\n"}
,{"stream_name":"stdout","time":3398.369402655,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.369403775,"data":"       |     # check each point lies on both chords\n"}
,{"stream_name":"stdout","time":3398.369404948,"data":"       |     if not (is_point_on_segment(p13,c1) and is_point_on_segment(p13,c3)):\n"}
,{"stream_name":"stdout","time":3398.369406151,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.369407253,"data":"       |     if not (is_point_on_segment(p14,c1) and is_point_on_segment(p14,c4)):\n"}
,{"stream_name":"stdout","time":3398.369408472,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.3694096,"data":"       |     if not (is_point_on_segment(p23,c2) and is_point_on_segment(p23,c3)):\n"}
,{"stream_name":"stdout","time":3398.369410835,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.369413855,"data":"       |     if not (is_point_on_segment(p24,c2) and is_point_on_segment(p24,c4)):\n"}
,{"stream_name":"stdout","time":3398.369415092,"data":"       |         return None\n"}
,{"stream_name":"stdout","time":3398.369416192,"data":"       |     # return sorted tuple of points\n"}
,{"stream_name":"stdout","time":3398.369417333,"data":"       |     pts = [p13,p14,p23,p24]\n"}
,{"stream_name":"stdout","time":3398.369418437,"data":"       |     # sort by coordinates for canonical representation\n"}
,{"stream_name":"stdout","time":3398.369419615,"data":"       |     pts_sorted = tuple(sorted(pts))\n"}
,{"stream_name":"stdout","time":3398.369420776,"data":"       |     return pts_sorted\n"}
,{"stream_name":"stdout","time":3398.36942196,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369423011,"data":"       | # Precompute orientation for each chord\n"}
,{"stream_name":"stdout","time":3398.369424149,"data":"       | orient = {}\n"}
,{"stream_name":"stdout","time":3398.369425244,"data":"       | for chord in chords:\n"}
,{"stream_name":"stdout","time":3398.369426338,"data":"       |     i,j = chord\n"}
,{"stream_name":"stdout","time":3398.369427441,"data":"       |     d = (i + j) % 12\n"}
,{"stream_name":"stdout","time":3398.369428527,"data":"       |     orient[chord] = d\n"}
,{"stream_name":"stdout","time":3398.369429628,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369430709,"data":"       | # group chords by orientation\n"}
,{"stream_name":"stdout","time":3398.369431813,"data":"       | by_orient = {}\n"}
,{"stream_name":"stdout","time":3398.369433121,"data":"       | for chord in chords:\n"}
,{"stream_name":"stdout","time":3398.369434219,"data":"       |     d = orient[chord]\n"}
,{"stream_name":"stdout","time":3398.369435343,"data":"       |     by_orient.setdefault(d, []).append(chord)\n"}
,{"stream_name":"stdout","time":3398.369436489,"data":"       | \n"}
,{"stream_name":"stdout","time":3398.369437536,"data":"       | # Now enumerate rectangles\n"}
,{"stream_name":"stdout","time":3398.369438646,"data":"       | rectangles = set()\n"}
,{"stream_name":"stdout","time":3398.369439775,"data":"       | for d in range(12):\n"}
,{"stream_name":"stdout","time":3398.369440909,"data":"       |     d_perp = (d + 6) % 12\n"}
,{"stream_name":"stdout","time":3398.369442043,"data":"       |     # to avoid double counting, consider only d \u003c d_perp (i.e., d in 0..5)\n"}
,{"stream_name":"stdout","time":3398.369443293,"data":"       |     if d \u003e= d_perp:\n"}
,{"stream_name":"stdout","time":3398.369444423,"data":"       |         continue\n"}
,{"stream_name":"stdout","time":3398.369445518,"data":"       |     chords_d = by_orient[d]\n"}
,{"stream_name":"stdout","time":3398.369446643,"data":"       |     chords_perp = by_orient[d_perp]\n"}
,{"stream_name":"stdout","time":3398.369447779,"data":"       |     # choose two chords from each\n"}
,{"stream_name":"stdout","time":3398.36944894,"data":"       |     for c1,c2 in itertools.combinations(chords_d,2):\n"}
,{"stream_name":"stdout","time":3398.369450173,"data":"       |         for c3,c4 in itertools.combinations(chords_perp,2):\n"}
,{"stream_name":"stdout","time":3398.369451387,"data":"       |             rect = rectangle_from_chords(c1,c2,c3,c4)\n"}
,{"stream_name":"stdout","time":3398.369452547,"data":"       |             if rect is not None:\n"}
,{"stream_name":"stdout","time":3398.36945365,"data":"       |                 rectangles.add(rect)\n"}
