,{"stream_name":"stdout","time":495.311277041,"data":"\n"}
,{"stream_name":"stdout","time":495.311278128,"data":"Replacements for unavailable optimization/constraint libraries:\n"}
,{"stream_name":"stdout","time":495.311279411,"data":"- Integer/Binary Linear Programming (replaces pulp, mip, ortools):\n"}
,{"stream_name":"stdout","time":495.311280578,"data":"  from scipy.optimize import milp, LinearConstraint, Bounds\n"}
,{"stream_name":"stdout","time":495.311281847,"data":"  import numpy as np\n"}
,{"stream_name":"stdout","time":495.311282963,"data":"  res = milp(c=c_vec, constraints=LinearConstraint(A, lb, ub),\n"}
,{"stream_name":"stdout","time":495.311284167,"data":"             integrality=np.ones(n), bounds=Bounds(0, 1))\n"}
,{"stream_name":"stdout","time":495.311285315,"data":"  # res.success, res.x (solution vector), res.fun (objective value)\n"}
