                # compute T = sum_{i=1}^{p-1} binom(p-1,i) k^{i-1} p^{i-1} (-1)^{p-1-i}
                T = sum(sp.binomial(p-1,i)*(k**(i-1))*(p**(i-1))*((-1)**(p-1-i)) for i in range(1,p))
