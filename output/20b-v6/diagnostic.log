            def find_k_l_solutions(limit_p=50, limit_k=20, limit_l=20):
                sols=[]
                for p in sp.primerange(3, limit_p+1):
                    for k in range(1, limit_k+1):
                        a = k*p - 1
                        # compute A
                        # a^{p-1} = (k*p - 1)^{p-1}
                        # Expand to get A
                        # Use binomial expansion
                        A = 0
                        for i in range(2, p):
                            A += sp.binomial(p-1,i) * (k*p)**i * (-1)**(p-1-i)
                        A //= p**2
                        for l in range(1, limit_l+1):
                            b = l*p - 1
                            B = 0
                            for i in range(2, p):
                                B += sp.binomial(p-1,i) * (l*p)**i * (-1)**(p-1-i)
                            B //= p**2
                            if l - (p-1)*k + p*A == 1 and k - (p-1)*l + p*B == 1:
