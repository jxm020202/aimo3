            def U_p(p,x,y):
                # compute U = y - (p-1)x + p*T
                T=0
                for k in range(2,p):
                    T += math.comb(p-1,k) * (p**(k-2)) * (x**k) * ((-1)**(p-1-k))
                return y - (p-1)*x + p*T
            
            def V_p(p,x,y):
                S=0
                for k in range(2,p):
                    S += math.comb(p-1,k) * (p**(k-2)) * (y**k) * ((-1)**(p-1-k))
                return x - (p-1)*y + p*S
            
            for x in range(1,5):
                for y in range(x,5):
                    print("x",x,"y",y,"U",U_p(5,x,y),"V",V_p(5,x,y))
            
