            def compute_L(p,u):
                # compute L = sum_{i=2}^{p-1} C(p-1,i) p^{i-2} u^i (-1)^{p-1-i}
                L=0
                for i in range(2, p):
                    coeff = sp.binomial(p-1, i)
                    term = coeff * (p**(i-2)) * (u**i) * ((-1)**(p-1-i))
                    L += term
                return L
            
            def find_solutions_general(p, limit_u=10, limit_v=10):
                sols=[]
                for u in range(1, limit_u+1):
                    for v in range(u, limit_v+1):
                        L = compute_L(p,u)
                        M1 = v - (p-1)*u + p*L
                        if M1 <=0:
                            continue
                        # check if M1 power of p
                        # compute exponent
                        exp1 = 0
                        temp = M1
                        while temp % p == 0:
                            temp//=p
                            exp1+=1
                        if temp != 1:
                            continue
                        # similarly for second
                        L2 = compute_L(p,v)
                        M2 = u - (p-1)*v + p*L2
                        if M2 <=0:
                            continue
                        exp2=0
                        temp=M2
                        while temp % p == 0:
                            temp//=p
                            exp2+=1
                        if temp != 1:
                            continue
                        sols.append((u,v,exp1,exp2))
                return sols
            
            for p in [3,5,7,11]:
                sols=find_solutions_general(p, limit_u=10, limit_v=10)
                print(p, sols)
            
