            import math, itertools, sys, sympy as sp
            def find_solutions(limit_p=20, limit_ab=200):
                sols=[]
                for p in list(sp.primerange(3, limit_p+1)):
                    for a in range(1, limit_ab+1):
                        for b in range(a, limit_ab+1):
                            # compute a^(p-1)+b and check if power of p
                            val1 = pow(a, p-1)+b
                            val2 = pow(b, p-1)+a
                            # check if power of p
                            def is_power_of_p(val):
                                if val<=0: return False
                                # compute exponent
                                exp=0
                                while val%p==0:
                                    val//=p
                                    exp+=1
                                return val==1
                            if is_power_of_p(val1) and is_power_of_p(val2):
                                sols.append((p,a,b))
                return sols
            
            sols=find_solutions(20,200)
            sols[:20], len(sols)
            
