            import math, itertools
            
            def compute_S(p, k):
                # compute S from expansion: a^{p-1} = 1 - (p-1)p k + p^2 * S
                # We can compute a^{p-1} exactly and then solve for S
                a = p*k - 1
                val = a**(p-1)
                # compute S = (val - 1 + (p-1)*p*k) // (p**2)
                S = (val - 1 + (p-1)*p*k) // (p**2)
                return S
            
            def find_solutions_caseB(max_p=50, max_k=10):
                sols=[]
                for p in [p for p in range(3,max_p+1) if all(p%q for q in range(2,int(p**0.5)+1))]:
                    for k in range(1,max_k+1):
                        for l in range(k,max_k+1):
                            S=compute_S(p,k)
                            T=compute_S(p,l)
                            left1 = l - (p-1)*k + p*S
                            left2 = k - (p-1)*l + p*T
                            # left1, left2 must be powers of p
                            def is_power_of_p(x):
                                if x<=0:
                                    return False
                                while x%p==0:
                                    x//=p
                                return x==1
                            if is_power_of_p(left1) and is_power_of_p(left2):
                                # compute m-1,n-1 exponents
                                def exponent(x):
                                    e=0
                                    while x%p==0:
                                        x//=p
                                        e+=1
                                    return e
                                m_minus=exponent(left1)
                                n_minus=exponent(left2)
                                # compute a,b
                                a = p*k -1
                                b = p*l -1
                                # verify equations
                                if a**(p-1)+b == p**(m_minus+1) and b**(p-1)+a == p**(n_minus+1):
                                    sols.append((p,a,b))
                return sols
            
