            def find_solutions_p3(limit_A=50, limit_B=50):
                sols=[]
                for A in range(1,limit_A+1):
                    for B in range(A,limit_B+1):
                        # compute k,l such that 3A^2 + B = 3^k-1? Wait k-1 exponent
                        # We need 3A^2 + B = 3^{k-1}
                        # So 3A^2 + B must be a power of 3
                        val1=3*A*A + B
                        val2=3*B*B + A
                        # check if val1, val2 are powers of 3
                        def is_pow3(n):
                            while n%3==0:
                                n//=3
                            return n==1
                        if is_pow3(val1) and is_pow3(val2):
                            # compute exponents
                            k_minus1=0
                            t=val1
                            while t%3==0:
                                t//=3; k_minus1+=1
                            l_minus1=0
                            t=val2
                            while t%3==0:
                                t//=3; l_minus1+=1
                            k=k_minus1+1
                            l=l_minus1+1
                            sols.append((3,3*A,3*B,k,l))
                return sols
            
