                    B = (p-1)*(p-2)//2
                    for m in range(2, max_mn+1):  # m>=2 because m-1 >=1
                        for n in range(2, max_mn+1):
                            if m==n:
                                continue
                            d = abs(n-m)
                            # we need to consider case n>m or m>n separately
                            # We'll just iterate over v,t
                            for v in range(1, max_vt+1):
                                if v % p == 0:
                                    continue
                                for t in range(1, max_vt+1):
                                    # compute left side of Eq*
                                    left = v * (p * B * t - 1)
                                    right = p**d - 1
                                    if left != right:
                                        continue
                                    # compute x,y
                                    # choose sign: assume n>m => y>x
                                    if n > m:
                                        # y - x = p**(m-2) * v
                                        # x + y = p * t
