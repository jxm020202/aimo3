            import math, sympy as sp
            
            def find_solutions(limit_p=50, limit_a=50, limit_b=50):
                sols=[]
                primes=[p for p in sp.primerange(3,limit_p+1)]
                for p in primes:
                    for a in range(1,limit_a+1):
                        for b in range(a,limit_b+1):
                            val1=a**(p-1)+b
                            val2=b**(p-1)+a
                            # check if powers of p
                            def is_power_of_p(n):
                                # n>0
                                # check if n is p^k
                                k=0
                                while p**k < n:
                                    k+=1
                                return p**k==n
                            if is_power_of_p(val1) and is_power_of_p(val2):
                                sols.append((p,a,b))
                return sols
            
            sols=find_solutions(50,50,50)
            sols[:20], len(sols)
            
