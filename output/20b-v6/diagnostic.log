            import math, sympy as sp
            
            def is_power_of_p(n,p):
                # returns exponent if n is power of p, else None
                if n<=0: return None
                exp=0
                while n%p==0:
                    n//=p
                    exp+=1
                if n==1:
                    return exp
                else:
                    return None
            
            def find_solutions(limit_p=13, limit_ab=200):
                sols=[]
                primes=list(sp.primerange(3,limit_p+1))
                for p in primes:
                    for a in range(1,limit_ab+1):
                        for b in range(a,limit_ab+1):  # a <= b
                            A=a**(p-1)+b
                            B=b**(p-1)+a
                            expA=is_power_of_p(A,p)
                            expB=is_power_of_p(B,p)
                            if expA is not None and expB is not None:
                                sols.append((p,a,b,expA,expB))
                return sols
            
