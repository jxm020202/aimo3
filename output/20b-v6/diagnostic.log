            def is_power_of_p(n,p):
                if n<1: return False
                while n%p==0:
                    n//=p
                return n==1
            
            def find_solutions(limit_p=50, limit_a=200, limit_b=200):
                sols=[]
                primes=list(sp.primerange(3,limit_p+1))
                for p in primes:
                    for a in range(1,limit_a+1):
                        for b in range(a,limit_b+1):
                            A = pow(a,p-1)+b
                            B = pow(b,p-1)+a
                            if is_power_of_p(A,p) and is_power_of_p(B,p):
                                # compute exponents
                                def exponent(n,p):
                                    e=0
                                    while n%p==0:
                                        n//=p
                                        e+=1
                                    return e
                                m=exponent(A,p)
                                n=exponent(B,p)
                                sols.append((p,a,b,m,n))
                return sols
            
