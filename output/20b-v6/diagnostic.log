            def compute_Q(p,k):
                # Q = sum_{i=2}^{p-1} C(p-1,i) k^i p^{i-2} (-1)^{p-1-i}
                Q=0
                for i in range(2,p):
                    coeff=sp.binomial(p-1,i)
                    term=coeff * k**i * p**(i-2) * ((-1)**(p-1-i))
                    Q+=term
                return Q
            
            def compute_N(p,k,t):
                l = k + p*t
                Q=compute_Q(p,k)
                N=k + t + Q
                return N
            
