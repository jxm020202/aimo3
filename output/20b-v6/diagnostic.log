                sols=[]
                for k in range(1,limit+1):
                    for l in range(k,limit+1):
                        if (k+l)%3!=0:
                            continue
                        m=(k+l)//3
                        # compute Q = k^2, Q' = l^2
                        left1=m + k*k - k
                        left2=m + l*l - l
                        # check if left1 and left2 are powers of 3
                        def is_pow3(n):
                            if n<=0: return False
                            while n%3==0:
                                n//=3
                            return n==1
                        if is_pow3(left1) and is_pow3(left2):
                            sols.append((k,l,left1,left2))
