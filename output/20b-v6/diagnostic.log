            import math, itertools
            
            def find_solutions(limit_p=20, limit_a=200, limit_b=200):
                sols=[]
                primes=[p for p in range(3,limit_p+1) if all(p%q for q in range(2,int(math.sqrt(p))+1))]
                for p in primes:
                    for a in range(1,limit_a+1):
                        for b in range(a,limit_b+1):
                            # compute a^(p-1)+b
                            val1=pow(a,p-1)+b
                            # check if power of p
                            k=0
                            while p**k<val1:
