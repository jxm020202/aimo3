            import math, sympy as sp
            
            def is_power_of_p(n, p):
                # returns (True, exponent) if n is p^k for some k>=1
                if n < p:
                    return False, None
                # compute exponent by repeated division
                k=0
                temp=n
                while temp%p==0:
                    temp//=p
                    k+=1
                return temp==1, k
            
