            def find_solutions_fast(pmax=50, amax=2000, mmax=12):
                sols=[]
                for p in list(sp.primerange(3,pmax+1)):
                    for a in range(1,amax+1):
                        apow=pow(a,p-1)
                        for m in range(1,mmax+1):
                            b = pow(p,m) - apow
                            if b < a or b <=0:
