            import math, sympy as sp
            
            def compute_B1_B2(p,u,v):
                # compute C for a and b
                # Use binomial expansion
                # a^{p-1} = 1 - (p-1)p*u + sum_{k=2}^{p-1} binom(p-1,k) p^k u^k (-1)^{p-1-k}
                # B1 = v - (p-1)u + p*C
                # C = sum_{k=2}^{p-1} binom(p-1,k) p^{k-2} u^k (-1)^{p-1-k}
                C = 0
                for k in range(2,p):
                    coeff = sp.binomial(p-1,k)
                    term = coeff * (p**(k-2)) * (u**k) * ((-1)**(p-1-k))
                    C += term
                B1 = v - (p-1)*u + p*C
                # Similarly B2
                C2 = 0
                for k in range(2,p):
                    coeff = sp.binomial(p-1,k)
                    term = coeff * (p**(k-2)) * (v**k) * ((-1)**(p-1-k))
                    C2 += term
                B2 = u - (p-1)*v + p*C2
                return B1, B2
            
            def is_power_of_p(x,p):
                if x<1: return False
                while x%p==0:
                    x//=p
                return x==1
            
            def find_solutions_p(p, u_max=10):
                sols=[]
                for u in range(1,u_max+1):
                    for v in range(u,u_max+1):
                        B1,B2 = compute_B1_B2(p,u,v)
                        if is_power_of_p(B1,p) and is_power_of_p(B2,p):
                            m = int(round(math.log(B1,p)))
                            n = int(round(math.log(B2,p)))
                            sols.append((u,v,m,n))
                return sols
            
            for p in [3,5,7,11]:
                print(p, find_solutions_p(p,10))
            
