            import math, sympy as sp
            
            def find_solutions(limit_p=20, limit_ab=200):
                sols=[]
                primes=[q for q in sp.primerange(3, limit_p+1)]
                for p in primes:
                    for a in range(1, limit_ab+1):
                        for b in range(a, limit_ab+1):
                            s1=pow(a, p-1)+b
                            s2=pow(b, p-1)+a
                            # check if power of p
                            def is_power_of_p(n):
                                if n<=0: return False
                                while n%p==0:
