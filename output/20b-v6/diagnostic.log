            import math, itertools, sympy as sp
            
            def find_solutions(limit_p=20, limit_ab=200):
                sols=[]
                primes=[p for p in range(3,limit_p+1) if sp.isprime(p)]
                for p in primes:
                    for a in range(1,limit_ab+1):
                        for b in range(a,limit_ab+1):
                            x=a**(p-1)+b
                            y=b**(p-1)+a
                            # check if both are powers of p
                            def is_power_of_p(n,p):
                                if n<1: return False
                                while n%p==0:
                                    n//=p
                                return n==1
                            if is_power_of_p(x,p) and is_power_of_p(y,p):
                                sols.append((p,a,b))
                return sols
            
            sols=find_solutions(20,200)
            sols[:20], len(sols)
            
