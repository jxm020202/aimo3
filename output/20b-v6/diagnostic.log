            def find_solutions_p3(u_max=100):
                sols=[]
                for u in range(1,u_max+1):
                    for v in range(u,u_max+1):
                        A=3*u*u - 2*u + v
                        B=3*v*v - 2*v + u
                        # check if A and B are powers of 3
                        def is_power_of_3(x):
                            if x<1: return False
                            while x%3==0:
                                x//=3
                            return x==1
                        if is_power_of_3(A) and is_power_of_3(B):
                            m = int(math.log(A,3))
                            n = int(math.log(B,3))
