            def solve_linear(p, maxk=10, maxl=10):
                sols=[]
                for k in range(1,maxk+1):
                    for l in range(1,maxl+1):
                        # Solve n - (p-1)m = p^(k-1)
                        # m - (p-1)n = p^(l-1)
                        # Solve linear system:
                        # n - (p-1)m = A
                        # m - (p-1)n = B
                        A= p**(k-1)
                        B= p**(l-1)
                        # Solve:
                        # n = A + (p-1)m
                        # substitute into second: m - (p-1)(A + (p-1)m) = B
                        # m - (p-1)A - (p-1)^2 m = B
                        # m*(1 - (p-1)^2) = B + (p-1)A
                        denom=1 - (p-1)**2
                        num= B + (p-1)*A
                        if denom==0: continue
                        if num%denom!=0: continue
                        m=num//denom
                        n=A + (p-1)*m
                        if m>0 and n>0:
                            sols.append((k,l,m,n))
                return sols
            
            for p in [5,7,11]:
                print(p, solve_linear(p, maxk=6, maxl=6))
            
