            import sympy as sp
            
            def is_power_of_p(n, p):
                # returns exponent if n is p^k, else None
                if n <= 0:
                    return None
                k = 0
                while n % p == 0:
                    n //= p
                    k += 1
                if n == 1:
                    return k
                else:
                    return None
            
