            def compute_S_T(p,m,n):
                # a = p*m -1, b = p*n -1
                # compute S = n + (p-1) + p*U where U = sum_{i=2}^{p-1} binom(p-1,i) * (-p*m)^{i-1} / p
                # Let's compute directly using formula: S = ( (p*m-1)**(p-1) + (p*n-1) ) // p
