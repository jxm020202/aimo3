            def is_power_of_p(x, p):
                # returns exponent if x is power of p (>=1), else None
                if x < p:
                    return None
                exp = 0
                while x % p == 0:
                    x //= p
                    exp += 1
                return exp if x == 1 else None
            
            def find_solutions(limit_a=200, limit_p=50):
