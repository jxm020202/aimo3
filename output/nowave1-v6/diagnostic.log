            def compute_M(p, alpha):
                # K = ((p*alpha - 1)**(p-1) - 1)//p
                a = p*alpha - 1
                K = (a**(p-1) - 1)//p
                M = (K - (p-1)*alpha)//p
                return M
            
            def compute_N(p, beta):
                b = p*beta - 1
                L = (b**(p-1) - 1)//p
                N = (L - (p-1)*beta)//p
                return N
            
            def search_case(limit_p=31, max_alpha=20, max_k=10):
                sols=[]
                for p in sp.primerange(3, limit_p+1):
                    for alpha in range(1, max_alpha+1):
                        for k in range(0, max_k+1):
                            beta = alpha + k*p
                            # compute M,N
                            M = compute_M(p, alpha)
                            N = compute_N(p, beta)
                            # Now need integers m,n such that:
                            # alpha + k + M = p^{m-2}
                            # alpha + k*(p-1) + N = p^{n-2}
                            lhs1 = alpha + k + M
                            lhs2 = alpha + k*(p-1) + N
                            # check if lhs1 and lhs2 are powers of p (including 1)
                            def is_power_of_p(val):
                                if val<=0:
                                    return False
                                while val%p==0:
                                    val//=p
                                return val==1
                            if is_power_of_p(lhs1) and is_power_of_p(lhs2):
                                # compute m,n
                                m = 2
                                while p**(m-2) < lhs1:
                                    m+=1
                                n = 2
                                while p**(n-2) < lhs2:
