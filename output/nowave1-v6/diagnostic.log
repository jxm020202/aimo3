                    for a in range(1, limit_a+1):
                        for b in range(a, limit_a+1):
                            x = pow(a, p-1) + b
                            y = pow(b, p-1) + a
                            expx = is_power_of_p(x, p)
                            expy = is_power_of_p(y, p)
                            if expx is not None and expy is not None:
                                sols.append((p,a,b,expx,expy))
