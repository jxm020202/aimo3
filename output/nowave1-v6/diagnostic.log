                                # verify original equations
                                a = p*alpha - 1
                                b = p*beta - 1
                                X = a**(p-1) + b
                                Y = b**(p-1) + a
                                if X == p**m and Y == p**n:
                                    sols.append((p, a, b, m, n))
                return sols
            
