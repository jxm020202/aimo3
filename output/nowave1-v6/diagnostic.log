            import sympy as sp
            
            def is_power_of(n, p):
                # return exponent if n is power of p, else None
                if n <= 0:
                    return None
                exp = 0
                while n % p == 0:
                    n //= p
                    exp += 1
                if n == 1:
                    return exp
                else:
                    return None
            
            def find_solutions(limit_p=50, limit_u=20, limit_v=20):
                sols = []
                primes = list(sp.primerange(3, limit_p+1))
                for p in primes:
                    for u in range(1, limit_u+1):
                        a = p*u - 1
                        for v in range(u, limit_v+1):  # ensure a<=b => u<=v
                            b = p*v - 1
                            # compute a^{p-1}+b and b^{p-1}+a
                            val1 = pow(a, p-1) + b
                            val2 = pow(b, p-1) + a
                            e1 = is_power_of(val1, p)
                            e2 = is_power_of(val2, p)
                            if e1 is not None and e2 is not None:
                                sols.append((p, a, b, e1, e2, u, v))
                return sols
            
            sols = find_solutions(limit_p=50, limit_u=10, limit_v=10)
            len(sols), sols[:20]
            
