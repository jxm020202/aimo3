            def solutions_p3(limit_m=50):
                sols=[]
                for m in range(1, limit_m+1):
                    for n in range(m, limit_m+1):
                        U = 3*m*m - 2*m + n
                        V = 3*n*n - 2*n + m
                        # check if U and V are powers of 3
                        def is_pow3(x):
                            if x<=0:
                                return False
                            while x%3==0:
                                x//=3
                            return x==1
                        if is_pow3(U) and is_pow3(V):
                            # compute a,b
                            a = 3*m - 1
                            b = 3*n - 1
                            # compute k,l
                            k = 1 + int(sp.log(U,3))
                            l = 1 + int(sp.log(V,3))
                            sols.append((a,b,m,n,k,l))
