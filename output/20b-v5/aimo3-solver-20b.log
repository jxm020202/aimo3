,{"stream_name":"stdout","time":509.746347526,"data":"Replacements for unavailable optimization/constraint libraries:\n"}
,{"stream_name":"stdout","time":509.746350026,"data":"- Integer/Binary Linear Programming (replaces pulp, mip, ortools):\n"}
,{"stream_name":"stdout","time":509.746352432,"data":"  from scipy.optimize import milp, LinearConstraint, Bounds\n"}
,{"stream_name":"stdout","time":509.746354534,"data":"  import numpy as np\n"}
,{"stream_name":"stdout","time":509.746356356,"data":"  res = milp(c=c_vec, constraints=LinearConstraint(A, lb, ub),\n"}
,{"stream_name":"stdout","time":509.746358382,"data":"             integrality=np.ones(n), bounds=Bounds(0, 1))\n"}
,{"stream_name":"stdout","time":509.746360282,"data":"  # res.success, res.x (solution vector), res.fun (objective value)\n"}
,{"stream_name":"stdout","time":509.746362274,"data":"- Linear Programming: scipy.optimize.linprog(c, A_ub=A, b_ub=b, method=\"highs\")\n"}
