            import math
            
            def is_pretty_fast(m,n,k):
                RHS = k - m
                if n <= RHS:
                    return False
                d = math.gcd(m,n)
                if RHS % d != 0:
                    return False
                m1 = m // d
                n1 = n // d
                RHS1 = RHS // d
                # Find particular solution to m1*b - n1*a = RHS1.
                # Use extended Euclidean to find x,y such that m1*x + n1*y = 1.
                # Then multiply.
                # Actually we need solution for m1*b + (-n1)*a = RHS1.
                # Solve m1*b + (-n1)*a = RHS1.
                # Let g = gcd(m1, n1) = 1.
                # Find u,v such that m1*u + n1*v = 1.
                # Then b0 = u*RHS1, a0 = -v*RHS1 (since m1*u + n1*v = 1 => m1*(u*RHS1) + n1*(v*RHS1) = RHS1)
                # But we need m1*b - n1*a = RHS1 => m1*b + n1*(-a) = RHS1.
                # So set b0 = u*RHS1, -a0 = v*RHS1 => a0 = -v*RHS1.
