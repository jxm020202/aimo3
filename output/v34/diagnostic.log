                for m in range(1, max_m+1):
                    floor_m = math.floor(m*alpha)
                    for n in range(1, max_n+1):
                        ceil_n = math.ceil(n*alpha)
                        if m*ceil_n - n*floor_m == k:
                            pairs.append((m,n))
                return pairs
            
            def cool_pairs(k, alpha, max_m, max_n):
                pretty = set(pretty_pairs(k, alpha, max_m, max_n))
                cool = []
                for (m,n) in pretty:
                    if (m-n, n) not in pretty and (m, n-m) not in pretty:
                        cool.append((m,n))
                return cool
            
