\[
R(y_1,\dots ,y_6)=\frac{(y_1+\dots +y_6)^3}
{\displaystyle\sum_{i=1}^{6}\gcd(y_i,y_{i+1})\,
\operatorname{lcm}(y_{i+1},y_{i+2})},
\]

and records the smallest value found.  
(The indices are taken modulo 6, i.e. \(y_7=y_1,\;y_8=y_2\).)

```python
import math
from itertools import product

def ratio(t):
    y = list(t)
    # overall gcd must be 1
    if math.gcd(math.gcd(math.gcd(math.gcd(math.gcd(y[0], y[1]), y[2]), y[3]), y[4]), y[5]) != 1:
        return None
    S = sum(y)
    T = 0
    for i in range(6):
        a = y[i]
        b = y[(i+1) % 6]
        c = y[(i+2) % 6]
        g1 = math.gcd(a, b)
        g2 = math.gcd(b, c)
        lcm_bc = b * c // g2          # lcm(b,c) = b*c / gcd(b,c)
        T += g1 * lcm_bc
    if T == 0:
        return None
    return (S**3) / T

# search range (you can increase it later)
N = 6          # try numbers 1 … N
min_ratio = float('inf')
min_tuple = None

for tup in product(range(1, N+1), repeat=6):
    r = ratio(tup)
    if r is not None and r < min_ratio:
        min_ratio = r
        min_tuple = tup

print("minimum ratio found:", min_ratio)
print("attained at tuple:", min_tuple)
```

