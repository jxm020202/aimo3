            def ratio(xs):
                S = sum(xs)
                g = functools.reduce(math.gcd, xs)
                # compute sum term
                total = 0
                for i in range(6):
                    a = xs[i]
                    b = xs[(i+1)%6]
                    c = xs[(i+2)%6]
                    term = math.gcd(a,b) * (b*c // math.gcd(b,c))  # gcd * lcm
                    total += term
                # denominator = g * total
                return fractions.Fraction(S**3, g*total)
            
            def min_ratio(limit):
                min_r = None
                min_tuple = None
                for xs in itertools.product(range(1, limit+1), repeat=6):
                    # compute overall gcd
                    g = functools.reduce(math.gcd, xs)
                    if g != 1:
                        continue
                    r = ratio(xs)
                    if min_r is None or r < min_r:
                        min_r = r
                        min_tuple = xs
                return min_r, min_tuple
            
