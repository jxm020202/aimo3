            def count_outstanding(R,C):
                # choose central cell (ceil(R/2), ceil(C/2))
                i0 = (R+1)//2
                j0 = (C+1)//2
                # assign values based on Chebyshev distance
                import numpy as np
                a = np.zeros((R,C), dtype=int)
                for i in range(R):
                    for j in range(C):
                        d = max(abs(i - (i0-1)), abs(j - (j0-1)))  # zero-indexed
                        a[i,j] = -d
                # count outstanding rectangles
                count = 0
                for top in range(R):
                    for bottom in range(top, R):
                        for left in range(C):
                            for right in range(left, C):
                                # rectangle S
                                # compute min inside
                                inside = a[top:bottom+1, left:right+1]
                                min_inside = inside.min()
                                # compute neighboring cells (expanded rectangle)
                                top2 = max(top-1, 0)
                                bottom2 = min(bottom+1, R-1)
                                left2 = max(left-1, 0)
                                right2 = min(right+1, C-1)
