            import numpy as np, math, random, itertools, sys, math, numpy as np
            def f(alpha,beta):
                r = math.sqrt(3)
                x = r*math.sin(alpha)*math.cos(beta)
                y = r*math.sin(alpha)*math.sin(beta)
                z = r*math.cos(alpha)
                return x*y**3 + y*z**3 + z*x**3 - 3
            
            # Let's sample grid for alpha in [0, pi], beta in [0, 2pi]
            def find_grid(step_alpha=0.02, step_beta=0.02, tol=1e-3):
                sols=[]
                alphas = np.arange(0, math.pi+step_alpha, step_alpha)
                betas = np.arange(0, 2*math.pi+step_beta, step_beta)
                for a in alphas:
                    for b in betas:
                        val = f(a,b)
                        if abs(val) < tol:
                            sols.append((a,b,val))
                return sols
            
            sols = find_grid(0.05,0.05,1e-2)
            len(sols)
            
