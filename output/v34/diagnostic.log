            def reachable_values_grid(X, Y):
                # DP over rows
                # Represent a row as tuple of values length X+1
                # Initialize row0 possibilities: need to satisfy adjacency diff condition for row0? Actually L constraints involve row0 and row1, not within row0 alone.
                # However row0 values must satisfy that for each adjacent pair (a,b), there exists c (row1[x]) such that {a,b,c} consecutive.
