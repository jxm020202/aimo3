            def high_bottom_rows(R,C,k):
                # assign low values to top rows, high values to bottom k rows
                N=R*C
                grid=[[0]*C for _ in range(R)]
                low_vals=list(range(R*C - C*k))  # lower numbers
                high_vals=list(range(R*C - C*k, R*C))
                # assign low to top rows
                idx=0
                for i in range(R-k):
                    for j in range(C):
                        grid[i][j]=low_vals[idx]; idx+=1
                idx=0
                for i in range(R-k,R):
                    for j in range(C):
                        grid[i][j]=high_vals[idx]; idx+=1
                return grid
            
