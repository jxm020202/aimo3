                best_xs = xs[:]
                for _ in range(iterations):
                    # propose change: pick index, new random value
                    i = random.randrange(6)
                    new_val = random.randint(1, max_val)
                    old = xs[i]
                    xs[i] = new_val
                    # ensure gcd=1
                    g = xs[0]
