            import sympy as sp
            x=sp.symbols('x')
            poly = x**3 + x**2 + x - 10
            # compute recurrence: r^n expressed as a + b r + c r^2
            def power_vector(n):
                # compute polynomial representation of x^n modulo poly
                # using sympy poly remainder
                poly_mod = sp.rem(x**n, poly, domain=sp.ZZ)  # remainder polynomial degree <3
                # remainder will be a0 + a1*x + a2*x**2
                a0 = sp.expand(poly_mod).coeff(x,0)
                a1 = sp.expand(poly_mod).coeff(x,1)
                a2 = sp.expand(poly_mod).coeff(x,2)
                return (int(a0), int(a1), int(a2))
            
