            def candidate_ns(limit):
                for n in range(866, limit+1):
                    if n % 2 == 0:  # must be odd (since gcd(866,n)=1)
                        continue
                    if n % 433 == 0:
                        continue
                    m = n+1
                    # factor m
                    fac = sp.factorint(m)
                    # squarefree?
                    if any(exp>1 for exp in fac.values()):
                        continue
                    # check gcd condition for each prime
                    good = True
                    for p in fac:
                        if math.gcd(866, p-1) != 1:
                            good = False
                            break
                    if not good:
                        continue
                    yield n, fac
            
            def cycle_type_perm(perm):
                n = len(perm)
                visited = [False]*n
                cycles = []
                for i in range(n):
                    if not visited[i]:
                        j=i
                        length=0
                        while not visited[j]:
                            visited[j]=True
                            j=perm[j]
                            length+=1
                        cycles.append(length)
                cycles.sort()
                return tuple(cycles)
            
            def phi_cycle_type(n):
                # phi permutation on 0..n-1
                perm = [(866*i) % n for i in range(n)]
                return cycle_type_perm(perm)
            
            def psi_cycle_type(n):
                m=n+1
