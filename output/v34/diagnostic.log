            import itertools, math, time, numpy as np, scipy.optimize as opt, scipy.sparse as sp
            
            def max_edges_milp(N):
                # variables for each unordered pair (i,j)
                pairs = [(i,j) for i in range(N) for j in range(i+1,N)]
                m = len(pairs)
                # objective: maximize sum x
                c = -np.ones(m)  # minimize negative
                # constraints: degree_i <= cap_i
                caps = [i+1 for i in range(N-1)] + [N-1]  # vertex indices 0..N-1 correspond to 1..N
                rows = []
                data = []
                col = []
                for idx, (i,j) in enumerate(pairs):
                    # for vertex i
                    rows.append(i)
                    data.append(1)
                    col.append(idx)
                    # for vertex j
                    rows.append(j)
                    data.append(1)
                    col.append(idx)
                A = sp.csr_matrix((data, (rows, col)), shape=(N, m))
                # bounds: 0 <= x <= 1
                bounds = opt.Bounds(0, 1)
                # integrality: all variables integer
                integrality = np.ones(m)
                # constraints: A x <= caps
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A, -np.inf, caps), bounds=bounds,
                               integrality=integrality, options={'disp': False})
                if not res.success:
                    raise RuntimeError("MILP failed")
                return int(-res.fun)
            
            for N in range(2,13):
                edges = max_edges_milp(N)
                print(N, edges)
            
