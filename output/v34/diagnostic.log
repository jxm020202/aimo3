            import math, itertools
            from fractions import Fraction
            
            def ratio(y):
                S = sum(y)
                # compute sum_i T_i
                total = 0
                for i in range(6):
                    a = y[i]
                    b = y[(i+1)%6]
                    c = y[(i+2)%6]
                    g1 = math.gcd(a,b)
                    # lcm of b,c
                    l = b*c // math.gcd(b,c)
                    total += g1 * l
                if total == 0:
                    return None
                return Fraction(S**3, total)
            
