            def labeling_i_plus_j(rows, cols):
                # assign values decreasing with i+j: larger i+j => lower value
                # we need distinct values; we can assign rank based on i+j, then break ties arbitrarily.
                vals=[]
                for i in range(rows):
                    for j in range(cols):
                        vals.append((i+j, i, j))
                # sort descending by i+j (so top-left smallest i+j gets highest value)
                vals.sort(key=lambda x: x[0]) # ascending i+j -> lower sum first (top-left)
                # assign values 0..N-1 in this order (so top-left gets 0)
                # but we need decreasing outward: top-left highest, so assign larger numbers to smaller sum.
                # Let's assign value = N-1 - rank
                N=rows*cols
                grid=[0]*N
                for rank, (_, i, j) in enumerate(vals):
                    grid[i*cols+j]=N-1-rank
                return grid
            
            def count_for_label(rows, cols):
                grid=labeling_i_plus_j(rows, cols)
                return count_outstanding(grid, rows, cols)
            
            for rows, cols in [(3,4),(4,5)]:
                print(rows, cols, count_for_label(rows, cols))
            
