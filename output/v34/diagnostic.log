            import math, itertools, fractions, sys, sympy as sp
            def simplify_A(xval):
                A_val = sp.nsimplify(A_expr.subs(x, sp.Rational(xval)))
                return A_val
            
            def is_rational(expr):
                # check if expr simplifies to rational number
                expr_s = sp.nsimplify(expr)
                return expr_s.is_Rational
            
            def find_solutions(max_den=20):
                solutions = []
                for q in range(1, max_den+1):
                    for p in range(1, q):
                        xval = sp.Rational(p, q)
                        # need 1-2x >=0
                        if 2*xval > 1:
                            continue
                        # compute A
                        try:
                            A_val = simplify_A(xval)
                        except Exception as e:
                            continue
                        # compute y = sqrt(2A) - A
                        # need sqrt of positive
                        # ensure A positive? Let's check numeric
                        if A_val.evalf() <= 0:
                            continue
                        y_expr = sp.sqrt(2*A_val) - A_val
                        # simplify y
                        y_simpl = sp.nsimplify(y_expr)
                        # check if rational
                        if y_simpl.is_Rational:
                            # positive?
                            if y_simpl > 0:
                                # compute minimal k = lcm(denominators)
                                x_frac = sp.Rational(xval)  # already rational
                                y_frac = sp.Rational(y_simpl)
                                k = sp.ilcm(x_frac.q, y_frac.q)
                                solutions.append((k, x_frac, y_frac, A_val))
                return solutions
            
            sols = find_solutions(30)
            len(sols)
            
