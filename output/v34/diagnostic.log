                rects=[]
                for top in range(m):
                    for left in range(n):
                        for bottom in range(top,m):
                            for right in range(left,n):
                                interior_mask=0
                                for i in range(top,bottom+1):
                                    for j in range(left,right+1):
                                        interior_mask |= 1<<index[(i,j)]
                                outer_mask=0
                                # iterate over interior cells to add neighbors not in interior
                                for i in range(top,bottom+1):
                                    for j in range(left,right+1):
                                        for di in (-1,0,1):
