                            # compute K = lcm(denominator(x), denominator(y))
                            den_x = x.denominator
                            den_y = y.denominator
                            K = den_x * den_y // math.gcd(den_x, den_y)
                            sols.append((K, a, b, x, y, (m,n,k)))
                return sols
            
