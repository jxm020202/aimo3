            def neighbors(state, rows, cols):
                # state as integer bitmask of size rows*cols, row-major
                # returns list of next states after applying any allowed operation
                # operation 1: any 2x2 with exactly 3 bits set -> set the missing bit
                # operation 2: any 2x2 with exactly 2 bits set -> flip all four bits
                res = []
                # precompute bits positions
                for r in range(rows-1):
                    for c in range(cols-1):
                        # indices of four cells
                        idx = [r*cols + c, r*cols + (c+1), (r+1)*cols + c, (r+1)*cols + (c+1)]
                        bits = [(state>>i)&1 for i in idx]
                        s = sum(bits)
                        if s == 3:
                            # find zero cell
                            for i,b in zip(idx,bits):
                                if b==0:
                                    new_state = state | (1<<i)
                                    res.append(new_state)
                                    break
                        elif s == 2:
                            # flip all four bits
                            mask = 0
                            for i in idx:
                                mask ^= (1<<i)  # toggle
                            new_state = state ^ mask
                            res.append(new_state)
                return res
            
