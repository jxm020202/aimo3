            def max_S_grid(n):
                N = n*n
                # cell indices: (r,c) -> i = r*n + c
                cells = [(r,c) for r in range(n) for c in range(n)]
                # edges: adjacency (share side)
                edges = []
                for r in range(n):
                    for c in range(n):
                        i = r*n + c
                        if r+1 < n:
                            j = (r+1)*n + c
                            edges.append((i,j))
                        if c+1 < n:
                            j = r*n + (c+1)
                            edges.append((i,j))
                # Precompute neighbor list for edges
                # We'll binary search S
                lo = 2  # minimal possible sum (1+1)
                hi = 2*N  # max possible sum (N + (N-1))
                # binary search for max feasible S
                best = lo
                while lo <= hi:
                    mid = (lo+hi)//2
                    # Build MILP feasibility for S=mid
                    # Variables: x[i,k] binary, flattened index idx = i*N + (k-1)
                    num_vars = N*N
                    # objective zero
                    c = np.zeros(num_vars, dtype=int)
                    # constraints
                    A_eq = []
                    b_eq = []
                    # each cell assigned exactly one number
                    for i in range(N):
                        row = np.zeros(num_vars, dtype=int)
                        for k in range(1,N+1):
                            idx = i*N + (k-1)
                            row[idx] = 1
                        A_eq.append(row)
                        b_eq.append(1)
                    # each number assigned to exactly one cell
                    for k in range(1,N+1):
                        row = np.zeros(num_vars, dtype=int)
                        for i in range(N):
                            idx = i*N + (k-1)
                            row[idx] = 1
                        A_eq.append(row)
                        b_eq.append(1)
                    # edge constraints: sum_k k*x_i_k + sum_l l*x_j_l >= mid
                    A_ub = []
                    b_ub = []
                    for (i,j) in edges:
                        row = np.zeros(num_vars, dtype=int)
                        for k in range(1,N+1):
                            idx = i*N + (k-1)
                            row[idx] = -k  # move to left side: -(k) - (l) <= -mid
                        for l in range(1,N+1):
                            idx = j*N + (l-1)
                            row[idx] = -l
                        A_ub.append(row)
                        b_ub.append(-mid)
                    # bounds: binary 0/1
                    bounds = [(0,1)]*num_vars
                    # Use milp
                    try:
                        res = opt.milp(c, bounds=bounds,
