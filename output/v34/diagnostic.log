            def compute_angle_variant(a,b, variant):
                X=sp.Point(0,0)
                Y=sp.Point(a,0)
                Z=sp.Point(0,b)
                O=sp.Point(a/2,b/2)
                R_radius=sp.sqrt(a**2+b**2)/2
                line_tangent_X=sp.Line(X, X+sp.Point(b,-a))
                line_YZ=sp.Line(Y,Z)
                T=line_tangent_X.intersection(line_YZ)[0]
                N=sp.Point(a/2, (b - sp.sqrt(a**2+b**2))/2)
                circle=sp.Circle(O, R_radius)
                line_TN=sp.Line(T,N)
                pts=circle.intersection(line_TN)
                R = pts[0] if not pts[0].equals(N) else pts[1]
                OR = sp.Point(R) - O
                dir_tangent_R=sp.Matrix([OR.y, -OR.x])
                line_tangent_R=sp.Line(R, sp.Point(R.x+dir_tangent_R[0], R.y+dir_tangent_R[1]))
                line_XZ=sp.Line(sp.Point(0,0), sp.Point(0,b))
                L=line_tangent_R.intersection(line_XZ)[0]
                # define C based on variant
                if variant == 1:
                    # intersection of tangents at X and R
                    C = line_tangent_X.intersection(line_tangent_R)[0]
                elif variant == 2:
                    # second intersection of line XN with circle
                    line_XN = sp.Line(X,N)
                    pts2 = circle.intersection(line_XN)
                    C = pts2[0] if not pts2[0].equals(X) else pts2[1]
                elif variant == 3:
                    # intersection of line LR with XY
                    C = sp.Line(L,R).intersection(sp.Line(X,Y))[0]
                elif variant == 4:
                    # intersection of line LR with YZ
                    C = sp.Line(L,R).intersection(sp.Line(Y,Z))[0]
                elif variant == 5:
                    # intersection of tangent at R with XY
                    C = line_tangent_R.intersection(sp.Line(X,Y))[0]
                elif variant == 6:
                    # intersection of tangent at R with YZ
                    C = line_tangent_R.intersection(sp.Line(Y,Z))[0]
                else:
                    raise ValueError
                # angle at L between LT and LC
                vec_LT = sp.Matrix([T.x - L.x, T.y - L.y])
                vec_LC = sp.Matrix([C.x - L.x, C.y - L.y])
                cos_angle = sp.N(vec_LT.dot(vec_LC) / (sp.sqrt(vec_LT.dot(vec_LT))*sp.sqrt(vec_LC.dot(vec_LC))))
                angle = math.degrees(math.acos(float(cos_angle)))
                return angle
            
            def test_variant(variant):
                angles = []
                for a,b in [(3,4),(5,12),(7,24),(8,15),(9,40)]:
                    angles.append(compute_angle_variant(a,b,variant))
                return angles
            
            for v in range(1,7):
                print(v, test_variant(v))
            
