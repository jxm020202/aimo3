            def count_outstanding_1d(arr):
                n=len(arr)
                cnt=0
                for l in range(n):
                    for r in range(l,n):
                        interior = arr[l:r+1]
                        left = arr[l-1] if l-1>=0 else None
                        right = arr[r+1] if r+1<n else None
                        # condition: each interior > each neighbor outside that shares a vertex (i.e., left/right)
                        # If neighbor doesn't exist (edge), ignore.
                        ok=True
                        for val in interior:
                            if left is not None and not (val>left):
                                ok=False
                                break
                            if right is not None and not (val>right):
                                ok=False
                                break
                        if ok:
                            cnt+=1
                return cnt
            
            def max_outstanding_1d_bruteforce(N):
                maxc=0
                best=None
                for perm in itertools.permutations(range(N)):
                    c=count_outstanding_1d(perm)
                    if c>maxc:
                        maxc=c
                        best=perm
                return maxc,best
            
