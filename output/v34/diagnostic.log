            def search_min_k(max_den):
                min_k = None
                min_data = None
                for q in range(1, max_den+1):
                    for p in range(0, q+1):
                        s = Fraction(p, q)
                        D = 5*s*s - 2*s + 1
                        if D == 0:
                            continue
                        val = Fraction(2,1) / D
                        if not is_square_frac(val):
                            continue
                        sqrt_val = Fraction(int(math.isqrt(val.numerator)), int(math.isqrt(val.denominator)))
                        u = (s + 1) * sqrt_val
                        t = u - 1
                        if t < 0:
                            continue
                        x = Fraction(1,1) - s*s
                        x = x/2
                        y = Fraction(1,1) - t*t
                        y = y/2
                        if x <= 0 or y <= 0:
                            continue
                        # compute k
                        k = lcm(x.denominator, y.denominator)
                        if (min_k is None) or (k < min_k):
                            min_k = k
                            min_data = (s, t, x, y, k)
