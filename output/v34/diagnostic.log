            def max_S_grid(r,c):
                n = r*c
                cells = [(i,j) for i in range(r) for j in range(c)]
                # adjacency list
                adj = {}
                for idx,(i,j) in enumerate(cells):
                    neigh=[]
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<r and 0<=nj<c:
                            neigh.append(cells.index((ni,nj)))
                    adj[idx]=neigh
                maxS=0
                best=None
                for perm in itertools.permutations(range(1,n+1)):
                    # compute min sum across edges (each edge counted twice)
                    minsum=math.inf
                    for u in range(n):
                        for v in adj[u]:
                            s=perm[u]+perm[v]
                            if s<minsum:
                                minsum=s
                    if minsum>maxS:
                        maxS=minsum
                        best=perm
                return maxS, best
            
