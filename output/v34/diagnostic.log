```python
import math
from sympy import crt

def find_a(n, K):
    """
    Find an integer a that makes a_k integer for k=1..K,
    using the congruences:
        a ≡ - Σ_{i=1}^k i!·i^{n-1}   (mod (k+1)!)
    for k = 0,…,K-1.
    Returns the smallest non‑negative solution a and the modulus L = (K+1)!.
    """
    residues = []
    moduli   = []
    S = 0                     # S_k = Σ_{i=1}^k i!·i^{n-1}
    for k in range(K+1):     # k corresponds to the congruence modulo (k+1)!
        if k >= 1:
            S += math.factorial(k) * pow(k, n-1, math.factorial(k+1))
        mod = math.factorial(k+1)
        residues.append((-S) % mod)
        moduli.append(mod)
    # Chinese Remainder Theorem – the moduli are nested, so CRT succeeds.
    a, L = crt(moduli, residues)   # a is given modulo L = (K+1)!
    return int(a), int(L)

def test_sequence(a, n, K):
    """Check that a_k = a_{k-1}/k + k^{n-1} stays integral for k=1..K."""
    ak = a
    for k in range(1, K+1):
        if ak % k != 0:
            return False
        ak = ak // k + pow(k, n-1)
    return True

def works_for_n(n, K=12):
    a, L = find_a(n, K)
    return test_sequence(a, n, K)

# Scan n = 1..30
good = []
for n in range(1, 31):
    if works_for_n(n, K=12):
        good.append(n)

print("n that work (up to 30):", good)
print("remainders mod 3:", sorted({n % 3 for n in good}))
```

