            from functools import lru_cache
            from math import gcd
            def max_steps(n):
                init = tuple(range(1,n+1))
                @lru_cache(None)
                def dfs(state):
                    best = 0
                    m = len(state)
                    for i in range(m):
                        if state[i]==0: continue
                        for j in range(i+1,m):
                            if state[j]==0: continue
                            g = gcd(state[i], state[j])
                            # must be positive (g>=1)
                            new_state = list(state)
                            new_state[i] -= g
                            new_state[j] -= g
                            # ensure non-negative (should be)
                            new_state = tuple(new_state)
                            best = max(best, 1 + dfs(new_state))
