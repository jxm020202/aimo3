            import math
            from itertools import combinations
            
            def f_bruteforce(n):
                min_l = None
                for a in range(1, n-1):
                    for b in range(a+1, n):
                        c = n - a - b
                        if c <= b: continue
                        # distinct a<b<c automatically
                        l = math.lcm(a,b,c)
                        if min_l is None or l < min_l:
                            min_l = l
                return min_l
            
            def min_ratio_bruteforce(n):
                # compute minimal ratio a/b = f(n)/n
                f = f_bruteforce(n)
                # reduce fraction
                from fractions import Fraction
                return Fraction(f, n)
            
            def compute_g(N, M, c):
                n = M + c
                f = f_bruteforce(n)
                k = (N * f) // M  # floor(N * f / M)
                return Fraction(k, N)
            
            def min_ratio_by_divisors(n):
