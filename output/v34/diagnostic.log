            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def min_moves_ilp(N):
                # variables: c_i for i=1..N-1 (edge traversals), integer >=0
                # start s_i binary for i=1..N, end e_i binary for i=1..N
                # total variables count = (N-1) + 2*N
                n_c = N-1
                n_s = N
                n_e = N
                total_vars = n_c + n_s + n_e
                # objective: minimize sum c_i
                c_obj = np.zeros(total_vars)
                c_obj[:n_c] = 1.0
                # constraints:
                # exactly one start, one end
                A_eq = []
                b_eq = []
                # sum s_i = 1
                row = np.zeros(total_vars)
                row[n_c:n_c+n_s] = 1
