            def covering_radius_formula(n):
                max_dist=0
                for k in range(n+1):
                    for l in range(n+1):
                        if (k%2)!=(l%2):
                            continue
                        u=min(k,l)
                        v=max(k,l)
                        dist=min(v, n - u)
                        if dist>max_dist:
                            max_dist=dist
                            best=(k,l)
                return max_dist, best
            
