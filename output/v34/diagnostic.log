            from collections import defaultdict
            
            def functional_components(mapping):
                # mapping is list of length n, 1-indexed values (1..n)
                n = len(mapping)
                visited = [False]*n
                components = []
                # precompute in-neighbors list
                pre = [[] for _ in range(n)]
                for i, img in enumerate(mapping):
                    pre[img-1].append(i+1)  # store source node index (1-indexed)
                # compute tree signature recursively using memoization
                from functools import lru_cache
                @lru_cache(None)
                def tree_sig(node):
                    # node is 1-indexed
                    # children are preimages excluding its image (i.e., nodes that map to this node but are not its predecessor in cycle)
                    # However for tree attached to a node in a cycle, we need to consider only nodes that are not part of the cycle.
                    # We'll compute signature for the rooted tree formed by nodes that eventually map to this node without passing through the node again.
                    # This is essentially the structure of the in-tree of node when ignoring the edge from node to its image.
                    # We'll compute recursively: for each child c in pre[node-1] that is not the node's image (i.e., mapping[c-1] != node), include its tree signature.
                    childs = []
                    for c in pre[node-1]:
                        if mapping[c-1] != node:  # not the forward edge (i.e., not part of cycle)
                            childs.append(tree_sig(c))
                    # sort child signatures to make canonical
                    childs.sort()
                    # represent as tuple
                    return tuple(childs)
                # find cycles
                for i in range(1, n+1):
                    if not visited[i-1]:
                        # follow forward to find cycle
                        path = []
                        cur = i
                        while not visited[cur-1]:
                            visited[cur-1] = True
                            path.append(cur)
                            cur = mapping[cur-1]
                        # cur is now a visited node; need to determine if cur is in current path (forming a cycle) or earlier visited component.
                        if cur in path:
                            # cycle start index
                            idx = path.index(cur)
                            cycle = path[idx:]  # list of nodes in cycle order
                            # compute tree signatures for each node in cycle (excluding the edge to next node)
                            tree_sigs = [tree_sig(node) for node in cycle]
                            # component signature: (cycle length, sorted multiset of tree signatures)
                            # Since order up to rotation, we can sort the list of tree signatures (as they are tuples) to get canonical multiset.
                            comp_sig = (len(cycle), tuple(sorted(tree_sigs)))
                            components.append(comp_sig)
                        # else cur not in path, meaning we entered an already processed component; no new cycle.
                # sort components for overall multiset comparison
                components.sort()
                return components
            
            def are_isomorphic(n):
                sigma = sigma_map(n)
                phi = phi_map(n)
                comp_sigma = functional_components(sigma)
                comp_phi = functional_components(phi)
                return comp_sigma == comp_phi
            
            # test for n up to 10
            for n in range(2,11):
                print(n, are_isomorphic(n))
            
