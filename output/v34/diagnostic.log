            def construct_edges(size):
                # size = number of points per side (grid points)
                # choose heads = even parity vertices
                heads = [(i,j) for i in range(size) for j in range(size) if (i+j)%2==0]
                edges = []
                for (i,j) in heads:
                    # choose tail
                    if i+1 < size and j+1 < size:
                        tail = (i+1,j+1)
                    elif i-1 >=0 and j-1 >=0:
                        tail = (i-1,j-1)
                    elif i+1 < size and j-1 >=0:
                        tail = (i+1,j-1)
                    elif i-1 >=0 and j+1 < size:
                        tail = (i-1,j+1)
                    else:
                        raise ValueError("no neighbor")
                    edges.append((tail,(i,j)))
                return edges
            
            def check_edges(edges):
                # check condition for all pairs
                for a in range(len(edges)):
                    ha = edges[a][1]; ta = edges[a][0]
                    for b in range(a+1,len(edges)):
                        hb = edges[b][1]; tb = edges[b][0]
