            def is_isosceles(p1,p2,p3):
                # check non-collinear
                j1,k1 = p1
                j2,k2 = p2
                j3,k3 = p3
                # collinear if any of j equal, k equal, or i equal
                i1 = 4 - j1 - k1
                i2 = 4 - j2 - k2
                i3 = 4 - j3 - k3
                if j1==j2==j3 or k1==k2==k3 or i1==i2==i3:
                    return False  # degenerate, not a triangle
                # compute squared distances
                def d2(a,b):
                    dj = a[0]-b[0]
                    dk = a[1]-b[1]
