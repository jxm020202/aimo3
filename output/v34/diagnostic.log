            def havel_hakimi(seq):
                # seq is list of non-negative ints
                seq = sorted(seq, reverse=True)
                while seq and seq[0] > 0:
                    d = seq[0]
                    seq = seq[1:]
                    if d > len(seq):
                        return False
                    for i in range(d):
                        seq[i] -= 1
                        if seq[i] < 0:
                            return False
                    seq = sorted(seq, reverse=True)
                return True
            
