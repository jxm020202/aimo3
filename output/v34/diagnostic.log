            from fractions import Fraction
            
            def A(m):
                # sum_{k=1}^{m} 1/(k*(2*k-1))
                s = Fraction(0,1)
                for k in range(1,m+1):
                    s += Fraction(1, k*(2*k-1))
                return s
            
            def B(m):
                # sum_{k=0}^{m-1} 1/((k+m+1)*(2*m - k))
                s = Fraction(0,1)
                for k in range(0,m):
                    s += Fraction(1, (k+m+1)*(2*m - k))
                return s
            
            def ratio(m):
                return Fraction(A(m), B(m))
            
            for m in range(1,11):
                print(m, A(m), B(m), ratio(m))
            
