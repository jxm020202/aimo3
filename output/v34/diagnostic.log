            def max_possible_S(N_rows,N_cols):
                rows, cols = N_rows, N_cols
                N = rows*cols
                # compute degree list for each cell
                degs=[]
                for i in range(rows):
                    for j in range(cols):
                        d=0
                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            if 0<=i+di<rows and 0<=j+dj<cols:
                                d+=1
                        degs.append(d)
                # sort degrees ascending
                degs_sorted=sorted(degs)
                # assign labels 1..N to cells in order of increasing degree
                weighted_sum=sum(d*label for d,label in zip(degs_sorted, range(1,N+1)))
                E = rows*(cols-1)+(rows-1)*cols
                return weighted_sum//E, weighted_sum, E
            
