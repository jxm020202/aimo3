            def greedy_max_edges(N):
                caps = [0] + [i for i in range(1,N+1)]  # 1-indexed caps
                adj = [set() for _ in range(N+1)]
                # list of vertices sorted by remaining capacity descending
                # We'll repeatedly pick vertex with remaining capacity >0 and try to connect to others with capacity >0 not already connected.
                changed = True
                while changed:
                    changed = False
                    # sort vertices by remaining capacity descending
                    order = sorted([i for i in range(1,N+1) if caps[i] > 0], key=lambda x: caps[x], reverse=True)
                    for v in order:
                        if caps[v] == 0:
                            continue
                        # find candidates
                        candidates = [u for u in order if u != v and caps[u] > 0 and u not in adj[v]]
                        # sort candidates by remaining capacity descending
                        candidates.sort(key=lambda x: caps[x], reverse=True)
                        for u in candidates:
                            if caps[v] == 0 or caps[u] == 0:
                                continue
                            # add edge
                            adj[v].add(u)
                            adj[u].add(v)
