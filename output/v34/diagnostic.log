        Below is a short Python program that searches exhaustively (by back‑tracking) for the longest possible sequence of operations for small values of \(N\).  
It respects all the rules of the problem: each unordered pair may be used at most once, a pair can be chosen only while both piles are non‑empty, and after the operation the two piles lose exactly \(\gcd(a,b)\) coins.  

```python
from functools import lru_cache
from math import gcd

def max_ops(N):
    # initial pile sizes 1..N
    init = tuple(range(1, N+1))

    # all unordered pairs (i,j) with i<j
    pairs = [(i, j) for i in range(N) for j in range(i+1, N)]

    @lru_cache(maxsize=None)
    def dfs(state, used_mask):
        """state = tuple of current pile sizes
           used_mask = bitmask of which pairs have already been used
           returns maximal number of further operations possible"""
        best = 0
        for idx, (i, j) in enumerate(pairs):
            if used_mask >> idx & 1:          # pair already used
                continue
            a, b = state[i], state[j]
            if a == 0 or b == 0:              # at least one pile empty
                continue
            g = gcd(a, b)
            # perform the operation
            new_state = list(state)
            new_state[i] -= g
            new_state[j] -= g
            new_state = tuple(new_state)
            cand = 1 + dfs(new_state, used_mask | (1 << idx))
            if cand > best:
                best = cand
        return best

    return dfs(init, 0)

# test the function for small N
for N in range(2, 8):
    print(N, max_ops(N))
```

