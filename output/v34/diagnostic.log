            def construct_grid():
                n = 60
                # create checkerboard pattern: black if (i+j)%2==0
                # We'll assign low numbers to black cells, high numbers to white cells.
                # Determine positions for each color and degree.
                black_positions = []
                white_positions = []
                for i in range(n):
                    for j in range(n):
                        if (i+j)%2==0:
                            black_positions.append((i,j))
                        else:
                            white_positions.append((i,j))
                # compute degree for each position
                def degree(pos):
                    i,j = pos
                    deg = 0
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj = i+di, j+dj
                        if 0 <= ni < n and 0 <= nj < n:
                            deg += 1
                    return deg
                # sort black positions by degree descending (interior first)
                black_positions.sort(key=lambda p: degree(p), reverse=True)
                # sort white positions similarly
                white_positions.sort(key=lambda p: degree(p), reverse=True)
                # assign low numbers 1..1800 to black positions in order
                low_numbers = list(range(1,1801))
                # assign high numbers 1801..3600 to white positions in descending order
                high_numbers = list(range(1801,3601))[::-1]  # descending
                grid = [[0]*n for _ in range(n)]
                for pos, val in zip(black_positions, low_numbers):
                    i,j = pos
                    grid[i][j] = val
                for pos, val in zip(white_positions, high_numbers):
                    i,j = pos
                    grid[i][j] = val
                return grid
            
            grid = construct_grid()
