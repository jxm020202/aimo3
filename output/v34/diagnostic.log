            def generate_assignments(M,N, val_range):
                # val_range: list of possible integer values
                assignments = []
                points = [(x,y) for x in range(M+1) for y in range(N+1)]
                # pre-set (0,0)=0
                # ensure 0 in val_range
                if 0 not in val_range:
                    raise ValueError
                def backtrack(idx, cur):
                    if idx==len(points):
                        assignments.append(cur.copy())
                        return
                    x,y = points[idx]
                    if (x,y)==(0,0):
                        cur[(0,0)]=0
                        backtrack(idx+1, cur)
                        del cur[(0,0)]
                        return
                    for v in val_range:
                        cur[(x,y)]=v
