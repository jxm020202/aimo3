            def state_to_bits(state, n):
                # state is int bitmask length n*n, row-major
                return [(state>>i)&1 for i in range(n*n)]
            
            def bits_to_state(bits):
                s=0
                for i,b in enumerate(bits):
                    if b:
                        s|=1<<i
                return s
            
            def get_neighbors(state, n):
                # forward moves: rule A (3->4) and rule B (toggle 2)
                bits = state_to_bits(state,n)
                neighbors = []
                # iterate over all 2x2 positions
                for i in range(n-1):
                    for j in range(n-1):
                        idx = [i*n+j, i*n+(j+1), (i+1)*n+j, (i+1)*n+(j+1)]
                        s = sum(bits[k] for k in idx)
                        if s==3:
                            # rule A: turn the 0 to 1
                            for k in idx:
                                if bits[k]==0:
                                    newbits = bits.copy()
                                    newbits[k]=1
                                    neighbors.append(bits_to_state(newbits))
                                    break
                        elif s==2:
                            # rule B: toggle all four
                            newbits = bits.copy()
                            for k in idx:
                                newbits[k]=1-newbits[k]
                            neighbors.append(bits_to_state(newbits))
                return neighbors
            
            def bfs_winning(n):
                total = 1<<(n*n)
                all_black = total-1
                # reverse moves: from a state, we can go to predecessors via:
                # - reverse of rule A: if a 2x2 is all black, we can turn any of its 4 cells to white.
                # - rule B is its own inverse: toggle any 2x2 with sum=2.
                # We'll generate predecessors for each visited state.
                from collections import deque
                visited=set([all_black])
                q=deque([all_black])
                while q:
                    s=q.popleft()
                    bits = state_to_bits(s,n)
                    # generate predecessors
                    # reverse rule A:
                    for i in range(n-1):
                        for j in range(n-1):
                            idx = [i*n+j, i*n+(j+1), (i+1)*n+j, (i+1)*n+(j+1)]
                            if all(bits[k]==1 for k in idx):
                                # we can turn any of the four to 0
                                for k in idx:
                                    newbits = bits.copy()
                                    newbits[k]=0
                                    pred = bits_to_state(newbits)
                                    if pred not in visited:
                                        visited.add(pred)
                                        q.append(pred)
                    # rule B reverse (same as forward):
                    for i in range(n-1):
                        for j in range(n-1):
                            idx = [i*n+j, i*n+(j+1), (i+1)*n+j, (i+1)*n+(j+1)]
                            ssum = sum(bits[k] for k in idx)
                            if ssum==2:
                                # toggle all four
                                newbits = bits.copy()
                                for k in idx:
                                    newbits[k]=1-newbits[k]
                                pred = bits_to_state(newbits)
                                if pred not in visited:
                                    visited.add(pred)
                                    q.append(pred)
                return visited
            
            def min_k_all_winning(n):
                winning = bfs_winning(n)
                total = 1<<(n*n)
                # compute for each k, whether all states with k blacks are winning
                max_k_not_all = -1
                for s in range(total):
                    if s not in winning:
                        k = bin(s).count('1')
                        if k>max_k_not_all:
                            max_k_not_all = k
                # minimal k such that all states with that many blacks are winning is max_k_not_all+1
                return max_k_not_all+1
            
