            import itertools
            from collections import defaultdict
            
            def max_points(N):
                points = [(x,y) for x in range(1,N+1) for y in range(1,N+1)]
                # ILP: binary variable for each point
                # constraints: for any two rows y1<y2, for any two pairs (x1,x2) in row y1 and (x3,x4) in row y2, we must avoid x1+x2 == x3+x4
                # That's many constraints. For small N we can brute force search via backtracking.
                best=0
                best_set=None
                # Use simple greedy/backtrack with pruning using sum sets.
                rows_sums=[set() for _ in range(N+1)]
                cols_sums=[set() for _ in range(N+1)]
                selected=set()
                # order points maybe by row
                def backtrack(idx, count):
                    nonlocal best,best_set
                    if idx==len(points):
                        if count>best:
                            best=count
                            best_set=selected.copy()
                        return
                    # prune: max possible remaining points
                    if count + (len(points)-idx) <= best:
                        return
                    x,y = points[idx]
                    # try include
                    ok=True
                    # compute new sums for row y with existing points in that row
                    row_pts = [px for (px,py) in selected if py==y]
                    new_row_sums=set()
                    for px in row_pts:
                        s=px+x
                        if s in rows_sums[y]:
                            ok=False
                            break
                        new_row_sums.add(s)
                    # similarly column
                    col_pts = [py for (px,py) in selected if px==x]
                    new_col_sums=set()
                    for py in col_pts:
                        s=py+y
                        if s in cols_sums[x]:
                            ok=False
                            break
                        new_col_sums.add(s)
                    if ok:
                        # update
                        for s in new_row_sums:
                            rows_sums[y].add(s)
                        for s in new_col_sums:
                            cols_sums[x].add(s)
                        selected.add((x,y))
                        backtrack(idx+1, count+1)
                        # revert
                        selected.remove((x,y))
                        for s in new_row_sums:
                            rows_sums[y].remove(s)
                        for s in new_col_sums:
                            cols_sums[x].remove(s)
                    # try exclude
                    backtrack(idx+1, count)
                backtrack(0,0)
                return best, best_set
            
            for N in range(2,7):
                best,_=max_points(N)
                print(N,best)
            
