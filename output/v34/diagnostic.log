            import mpmath as mp
            
            def find_alpha_for_beta(beta):
                # function of alpha
                def g(alpha):
                    return f(alpha,beta)
                # alpha in [0, pi]
                # find intervals where sign changes
                N=200
                alphas = [i*math.pi/N for i in range(N+1)]
                vals = [g(a) for a in alphas]
                roots=[]
                for i in range(N):
                    if vals[i]==0:
                        roots.append(alphas[i])
                    elif vals[i]*vals[i+1] < 0:
                        try:
                            root = mp.findroot(lambda a: f(a,beta), (alphas[i], alphas[i+1]))
                            roots.append(float(root))
                        except Exception as e:
                            # fallback to brentq
                            try:
                                root = mp.findroot(lambda a: f(a,beta), alphas[i])
                                roots.append(float(root))
                            except:
                                pass
                return roots
            
