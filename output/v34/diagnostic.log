            def holds(y, C):
                S = sum(y)
                total = 0
                for i in range(6):
                    a = y[i]
                    b = y[(i+1)%6]
                    c = y[(i+2)%6]
                    total += math.gcd(a,b) * (b*c // math.gcd(b,c))
                return S**3 >= C * total
            
