                M = n+1
                # primitive root modulo M
                g0 = sp.primitive_root(M)
                # mapping g
                g_map = {}
                for x in range(1, n+1):
                    y = (866 * x) % n
                    if y == 0:
                        y = n
                    g_map[x] = y
                # preimages
                pre = {}
                for x, y in g_map.items():
                    pre.setdefault(y, []).append(x)
                # identify typeA (even with odd preimages) and typeB (even with only even preimages)
                typeA = [y for y in range(1, n+1) if y%2==0 and any(p%2==1 for p in pre[y])]
                typeB = [y for y in range(1, n+1) if y%2==0 and all(p%2==0 for p in pre[y])]
                # exponent assignments modulo n (order of multiplicative group)
                e = {}
                # assign typeB nodes exponent = node value (multiple of 4)
                for i in typeB:
                    e[i] = i % n  # i is multiple of 4, distinct
                # odd residues r less than n/2 (odd numbers 1..n/2-1)
                half = n//2
                odd_r = list(range(1, half, 2))  # odd numbers < half
                # assign for each typeA node
                for y, r in zip(typeA, odd_r):
                    e[y] = (-10 * r) % n
                    odds = [p for p in pre[y] if p%2==1]
                    # assign r to first odd, r+half to second odd
                    e[odds[0]] = r % n
                    e[odds[1]] = (r + half) % n
                # compute a_i = g0^{e_i} mod M
                a = {}
                for i in range(1, n+1):
                    a[i] = pow(g0, e[i], M)
                # check bijection
                if len(set(a.values())) != n:
                    return False, "not bijective"
                # check condition
                for x in range(1, n+1):
                    lhs = a[g_map[x]]
                    rhs = pow(a[x], 866, M)
                    if lhs != rhs:
                        return False, (x, lhs, rhs)
                return True, a
            
            ok, sol = construct_solution_n(876)
            ok
            
