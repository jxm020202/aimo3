                            while not visited[j]:
                                visited[j] = True
                                j = perm[j]-1  # perm values are 1-indexed
                                length += 1
                            cycles.append(length)
                    cycles.sort()
                    return cycles
                sigma_type = cycle_type(sigma)
                phi_type = cycle_type(phi)
