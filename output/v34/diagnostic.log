            def real_cuberoot(z):
                # real cube root for real numbers, handle negative
                if z >= 0:
                    return z**(1/3)
                else:
                    return -((-z)**(1/3))
            
            def real_cuberoot_sym(expr):
                # using sympy real_root?
                return sp.real_root(expr, 3)
            
            # compute using mpmath real cube root manually:
            def real_cuberoot_mp(val):
                if val >= 0:
                    return mp.nthroot(val,3)
                else:
                    return -mp.nthroot(-val,3)
            
