            def max_points_ilp(N):
                import numpy as np, itertools, math, sys, time
                points = [(x,y) for x in range(1,N+1) for y in range(1,N+1)]
                idx = {p:i for i,p in enumerate(points)}
                forb = generate_forbidden(N)
                nvar = len(points)
                c = -np.ones(nvar)
                A = np.zeros((len(forb), nvar), dtype=int)
                for i, quad in enumerate(forb):
                    for p in quad:
                        A[i, idx[p]] = 1
                b = np.full(len(forb), 3)
                from scipy.optimize import milp, LinearConstraint, Bounds
                bounds = Bounds(0,1)
                integrality = np.ones(nvar, dtype=int)
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("MILP failed")
                    return None
                val = -res.fun
                return int(round(val))
            
