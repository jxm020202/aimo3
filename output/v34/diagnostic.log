            def reachable_f(max_i, max_j):
                # returns set of possible f values at (max_i, max_j) for case (alpha,beta) = (1,2)
                # allowed delta pairs (du, dv) = (Δf_right, Δf_down) in {(0,0), (-1,0), (-1,-1)}
                allowed = {(0,0), (-1,0), (-1,-1)}
                cells = [(i,j) for i in range(max_i+1) for j in range(max_j+1)]
                assignments = {(0,0):0}
                results = set()
                # We'll backtrack with pruning; values limited to -min(i,j)..0
                def backtrack(idx):
                    if idx == len(cells):
                        results.add(assignments[(max_i,max_j)])
                        return
                    i,j = cells[idx]
                    if (i,j) in assignments:
                        backtrack(idx+1)
                        return
                    # Determine possible values based on constraints from L-shapes that involve this cell as right or down neighbor?
                    # The constraints that become fully known when we assign (i,j):
                    # L-shape with top-left (i-1,j-1) involves cells (i-1,j-1), (i-1,j), (i,j-1). Those are already assigned before (i,j) (since we fill row-major).
                    # So we need to ensure that the differences at (i-1,j-1) are allowed.
                    # However the allowed condition involves Δf_right at (i-1,j-1) = f(i-1,j) - f(i-1,j-1)
                    # and Δf_down at (i-1,j-1) = f(i,j-1) - f(i-1,j-1)
                    # Both of these cells are already assigned, so we can check now.
