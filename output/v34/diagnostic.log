            import heapq, sys, math, time, itertools, collections, random, os, math, sys, itertools, collections, heapq, time, math
            def max_edges_havel_hakimi(N):
                # caps: degree_i <= i for i=1..N-1, degree_N <= N-1
                caps = [i for i in range(1, N)] + [N-1]  # length N
                # Use max-heap with negative values
                heap = [ -d for d in caps if d>0 ]
                heapq.heapify(heap)
                total_deg = sum(caps)
                edges = 0
                while heap:
                    d = -heapq.heappop(heap)  # largest degree
                    if d == 0:
                        break
                    if d > len(heap):
                        # cannot satisfy, need to reduce this degree
                        # reduce by (d - len(heap))
                        reduction = d - len(heap)
                        d -= reduction
                        total_deg -= reduction
                        # push back reduced degree if >0
                        if d>0:
