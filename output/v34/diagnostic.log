            import sympy as sp
            def find_solutions(max_den=20):
                solutions=[]
                for q in range(1, max_den+1):
                    for p in range(1, q):  # p/q in (0,1)
                        a = sp.Rational(p, q)
                        # compute a^2 rational automatically
                        for s in range(1, max_den+1):
                            for r in range(1, s):
                                b = sp.Rational(r, s)
                                F = (5*a**2 - 2*a + 1)*(b**2 + 2*b - 1) + 8*a**2 - 8*a
                                if sp.simplify(F) == 0:
                                    # compute x,y
                                    x = (1 - a**2)/2
                                    y = (1 - b**2)/2
                                    # ensure positive rational and <= 1/2
                                    if x > 0 and y > 0 and x <= sp.Rational(1,2) and y <= sp.Rational(1,2):
