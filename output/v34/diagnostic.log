            def min_sum_up_to(N, max_sum=50):
                vecs=compute_vectors(N)
                A = np.array([[v[0] for v in vecs],
                              [v[1] for v in vecs],
                              [v[2] for v in vecs]], dtype=object)
                # We'll use MILP to minimize sum, but we can try incremental S.
                for S in range(1, max_sum+1):
                    # objective zero, just feasibility
                    c = np.zeros(N+1, dtype=int)
                    bounds = Bounds(np.zeros(N+1, dtype=int), np.full(N+1, 10**9, dtype=int))
                    # constraints: A @ k = target, sum k_i <= S
                    # We'll add an extra row to A for sum constraint
                    A_aug = np.vstack([A, np.ones(N+1, dtype=int)])
                    b_aug = np.array([2025,0,0,S], dtype=object)
                    lin_con = LinearConstraint(A_aug, b_aug, b_aug)
                    res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=np.ones(N+1, dtype=bool))
                    if res.success:
                        return S, res.x
                return None
            
