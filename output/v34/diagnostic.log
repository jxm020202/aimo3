            import itertools
            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_edges_ilp(n):
                # variables for each unordered pair (i<j)
                pairs = [(i,j) for i in range(1,n+1) for j in range(i+1,n+1)]
                m = len(pairs)
                c = -np.ones(m)  # maximize sum, use -c for minimization
                # constraints: degree caps
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(pairs):
                    A[i-1, idx] = 1
                    A[j-1, idx] = 1
                # upper bounds for degrees
                ub_deg = [min(i, n-1) for i in range(1,n+1)]
                # constraints: A x <= ub_deg
                lc = LinearConstraint(A, lb=np.zeros(n), ub=ub_deg)
                # bounds for variables 0 <= x <=1 integer
                bounds = Bounds(0,1)
                integrality = np.ones(m, dtype=int)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("Failed")
                    return None
                edges = int(-res.fun)
                return edges
            
            print(max_edges_ilp(10))
            
