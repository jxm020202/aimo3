            def construct_r_n(n):
                N = 2**n - 1
                rs = [cmath.exp(2j*math.pi * (2**k % N) / N) for k in range(n)]
                return rs
            
            def test_m_for_n(n, max_e):
                rs = construct_r_n(n)
                for e in range(1, max_e+1):
                    prod = 1
