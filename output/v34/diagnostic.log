            def construct_labeling(n):
                N=n*n
                # compute degree for each cell
                deg = []
                for r in range(n):
                    for c in range(n):
                        d=0
                        if r>0: d+=1
                        if r<n-1: d+=1
                        if c>0: d+=1
                        if c<n-1: d+=1
                        deg.append(d)
                # sort cell indices by degree descending
                cells = list(range(N))
                cells.sort(key=lambda i: deg[i], reverse=True)
                # assign numbers descending to cells in that order
                assign = [0]*N
                for idx, cell in enumerate(cells):
                    assign[cell] = N - idx
                # compute minimal adjacent sum
                min_sum = float('inf')
                for r in range(n):
                    for c in range(n):
                        i = r*n + c
                        val = assign[i]
                        if r+1 < n:
                            j = (r+1)*n + c
                            min_sum = min(min_sum, val + assign[j])
                        if c+1 < n:
                            j = r*n + (c+1)
                            min_sum = min(min_sum, val + assign[j])
                return assign, min_sum
            
