            def max_val(N, steps=10001):
                a = [2*i-1 for i in range(1,N+1)]
                best = 0
                best_x = None
                # brute force grid of probabilities with step 1/steps
                # only for small N
                for xs in itertools.product(range(steps+1), repeat=N):
