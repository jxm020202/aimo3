                    if A < 0: 
                        return -1e9
                    # compute optimal sin theta
                    # handle A=0 case separately: then x=y=0, O=0?
                    if A == 0:
                        # x=y=0, then O=0 (since x=0)
                        return 0.0
                    # compute s
                    D = (k*z)**2 + 8*A**2
                    s = (-k*z + math.sqrt(D)) / (4*A)
                    # ensure within [0,1]
                    if s < 0: s = 0.0
                    if s > 1: s = 1.0
                    c = math.sqrt(max(0.0, 1 - s**2))
                    return 4*A*c*(A*s + k*z)
