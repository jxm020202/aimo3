            import math, itertools
            
            def count_cool(alpha, k, limit):
                pretty = set()
                # compute pretty pairs up to limit
                for m in range(1, limit+1):
                    a_m = math.floor(m*alpha)
                    for n in range(1, limit+1):
                        a_n = math.floor(n*alpha)
                        if m* (a_n+1) - n * a_m == k:  # using ceil = floor+1
                            pretty.add((m,n))
                # filter cool
                cool = set()
                for (m,n) in pretty:
                    cool_flag = True
                    if m>n:
                        if (m-n, n) in pretty:
                            cool_flag=False
                    if n>m:
                        if (m, n-m) in pretty:
                            cool_flag=False
                    # if equal, no subtractions
                    if cool_flag:
                        cool.add((m,n))
                return len(pretty), len(cool), pretty, cool
            
