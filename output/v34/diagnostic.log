            import math
            from fractions import Fraction
            
            def generate_solutions(limit=50):
                sols=[]
                for m in range(1, limit+1):
                    for n in range(1, limit+1):
                        # compute RHS for equation: 5 n^2 - 2 m^2 must be nonnegative? Actually can be negative? k^2 nonnegative.
                        lhs = 5*n*n - 2*m*m
                        if lhs < 0:
                            continue
                        # need lhs to be even: because lhs = 2 k^2 => lhs must be even.
                        if lhs % 2 != 0:
                            continue
                        # compute k^2 = lhs/2
                        k2 = lhs // 2
                        k = int(math.isqrt(k2))
                        if k*k != k2:
                            continue
                        # now we have integer k satisfying equation.
                        # compute a values
                        # plus sign
                        a_plus = Fraction(1,5) * Fraction(1,1) + Fraction(2*k,5*m)  # (1/5)*(1 + 2k/m) = (1 + 2k/m)/5
                        a_minus = Fraction(1,5) * (Fraction(1,1) - Fraction(2*k, m))
                        # Actually compute directly using Fraction
                        a_plus = Fraction(1 + 2*k, 5*m) * m? Wait we need (1/5)*(1 + 2k/m) = (1 + 2k/m)/5 = (m + 2k)/(5m)
                        a_plus = Fraction(m + 2*k, 5*m)
                        a_minus = Fraction(m - 2*k, 5*m)
                        for a in [a_plus, a_minus]:
                            # require 0 < a <= 1
                            if a <= 0 or a > 1:
                                continue
                            # compute b = -1 + (a+1)*(m/n)
                            b = -1 + (a + 1) * Fraction(m, n)
                            if b <= 0 or b > 1:
