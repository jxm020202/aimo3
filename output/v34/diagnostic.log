            def parity_condition(N,wins):
                # returns counts for Manhattan distance parity even/odd
                even=odd=0
                for wx,wy,bx,by in wins:
                    d=abs(wx-bx)+abs(wy-by)
                    if d%2==0:
                        even+=1
                    else:
