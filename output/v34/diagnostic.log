            def min_f_dp(N, start, end):
                V = end  # max value
                INF = 10**9
                # dp[prev][cur] for position i (cur is a_i)
                dp = [[INF]*(V+1) for _ in range(V+1)]
                # initialize for i=2 (a1=start, a2=val)
                for a2 in range(start, end+1):
                    dp[start][a2] = start*start + a2*a2
                # iterate positions i from 2 to N-1 (we will add a_{i+1})
                for i in range(2, N):
                    newdp = [[INF]*(V+1) for _ in range(V+1)]
                    for prev in range(start, end+1):
                        for cur in range(prev, end+1):
                            cost = dp[prev][cur]
                            if cost >= INF: continue
                            # next value nxt from cur to end
                            for nxt in range(cur, end+1):
                                newcost = cost + nxt*nxt - prev * nxt
                                if newcost < newdp[cur][nxt]:
                                    newdp[cur][nxt] = newcost
                    dp = newdp
                # after loop, we have dp[prev][cur] where cur is a_N
                # need cur == end
                best = INF
                for prev in range(start, end+1):
                    if dp[prev][end] < best:
                        best = dp[prev][end]
                return best
            
