                    # connect to next d vertices
                    temp = []
                    for _ in range(d):
                        nd = -heapq.heappop(heap)
                        nd -= 1
                        total_deg -= 2  # each edge reduces total degree sum by 2
                        edges += 1
                        if nd < 0:
