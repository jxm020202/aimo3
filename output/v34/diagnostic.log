            def find_min_k(limit):
                solutions = []
                for b in range(1, limit+1):
                    for a in range(1, b+1):  # a positive, r>0
                        r = Fraction(a,b)
                        # compute numerator N = 5 a^2 - 2 a b + b^2
                        N = 5*a*a - 2*a*b + b*b
                        for d in range(1, limit+1):
                            for c in range(1, limit+1):
                                # check equation c^2 * N = 2 * b^2 * d^2
                                if c*c * N != 2 * b*b * d*d:
                                    continue
                                # inequality 1 < (a+b)*c/(b*d) < 2
                                lhs = Fraction((a+b)*c, b*d)
                                if lhs <= 1 or lhs >= 2:
                                    continue
                                # compute x,y
                                x = Fraction(1,1) - r*r
                                x = x / 2  # (1 - r^2)/2
                                # compute s = c/d
                                s = Fraction(c,d)
                                # compute b_val = (r+1)*s - 1
                                b_val = (r + 1) * s - 1
                                # ensure b_val between 0 and 1
                                if not (0 < b_val < 1):
                                    continue
                                v = b_val * b_val
                                y = Fraction(1,1) - v
                                y = y / 2
                                # ensure positive
                                if y <= 0:
                                    continue
                                # compute k = lcm(denominator of x, denominator of y)
                                from math import gcd
                                def lcm(a,b):
                                    return a*b//gcd(a,b)
                                k = lcm(x.denominator, y.denominator)
                                solutions.append((k, x, y, r, s, b_val))
                return sorted(solutions, key=lambda t: t[0])
