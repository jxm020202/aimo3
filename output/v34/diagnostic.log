            def head(edge):
                x,y,d = edge
                if d == 'NE':
                    return (x+1, y+1)
                else:  # NW
                    return (x-1, y+1)
            
            def tail(edge):
                return (edge[0], edge[1])
            
            heads = [head(e) for e in edges]
            tails = [tail(e) for e in edges]
            
            # compute conflict pairs
            conflict_pairs = []
            for i in range(len(edges)):
                h1 = heads[i]
                s1 = tails[i]
                for j in range(i+1, len(edges)):
                    h2 = heads[j]
                    s2 = tails[j]
                    # check if allowed (head of one equals tail of other)
                    if h1 == s2 or h2 == s1:
                        continue
                    # compute Chebyshev distance
                    dx = abs(h1[0] - h2[0])
                    dy = abs(h1[1] - h2[1])
                    if max(dx, dy) <= 1:  # distance < 2
