            import itertools, math, fractions, mpmath as mp
            
            mp.mp.dps = 50
            
            def check_xy(x_frac, y_frac):
                x = mp.mpf(x_frac.numerator) / x_frac.denominator
                y = mp.mpf(y_frac.numerator) / y_frac.denominator
                # domain check
                if x <= 0 or y <= 0 or x >= 0.5 or y >= 0.5:
                    return False
                # compute lhs
                lhs = 1 + mp.sqrt(1 - 2*y)
                # compute RHS
                term = (4*x - 2 + 2*mp.sqrt(1 - 2*x)) / (3 - 5*x - mp.sqrt(1 - 2*x))
                expr = (1+x**2)/2 + (1/6)*mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                expr2 = (1+x**2)/2 - (1/6)*mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                # real cube roots
                def rc(z):
                    # real cube root
                    if z >= 0:
                        return z**(mp.mpf(1)/3)
                    else:
                        return -((-z)**(mp.mpf(1)/3))
                cube_sum = rc(expr) + rc(expr2)
                rhs = y + term + cube_sum
                # compare within tolerance
                return mp.almosteq(lhs, rhs, rel_eps=mp.mpf('1e-30'), abs_eps=mp.mpf('1e-30'))
            
            def search(max_den):
