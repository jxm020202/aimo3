                vars = sp.symbols('x0:'+str(2*n), real=True)
                rs = [vars[2*i] + sp.I*vars[2*i+1] for i in range(n)]
                eqs = []
                for e in range(1,m+1):
                    prod = 1
                    for r in rs:
                        prod = sp.expand(prod * (r**e + 1))
                    eqs.append(sp.re(prod - 1))
                    eqs.append(sp.im(prod - 1))
                for _ in range(attempts):
                    guess = [random.uniform(-2,2) for _ in range(2*n)]
                    try:
                        sol = sp.nsolve(eqs, vars, guess, tol=1e-12, maxsteps=200, prec=30)
                        vals = [complex(sol[i]) for i in range(2*n)]
                        rs_vals = [vals[2*i] + 1j*vals[2*i+1] for i in range(n)]
                        if any(abs(v)>1e-6 for v in rs_vals):
                            return rs_vals
                    except Exception:
                        continue
                return None
            
