            import math, itertools
            def solve_for_m(m):
                # solve equations numerically: r+s = 10/3, and m*(r**3-5*r**2)+(36-m)*(s**3-5*s**2) = -400
                # Use sympy nsolve
                r,s = sp.symbols('r s')
                eq1 = sp.Eq(r + s, sp.Rational(10,3))
                eq2 = sp.Eq(m*(r**3 - 5*r**2) + (36 - m)*(s**3 - 5*s**2), -400)
                try:
                    sol = sp.nsolve((eq1, eq2), (r, s), (1.5, 1.5))
                    return float(sol[0]), float(sol[1])
                except Exception as e:
