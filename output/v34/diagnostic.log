            def minimal_sum(N):
                # start with list of coefficients, large enough
                max_len = 200  # enough
                k = [0]*max_len
                k[0] = N
                # iterate through positions
                for i in range(max_len-3):
                    if k[i] >= 10:
                        t = k[i] // 10
                        k[i] -= 10*t
                        k[i+1] += t
                        k[i+2] += t
                        k[i+3] += t
                # after one pass, there may be new carries from higher positions due to added t.
                # So we need to repeat until no k[i] >=10.
                # We'll loop until stable.
                changed = True
                while changed:
                    changed = False
                    for i in range(max_len-3):
                        if k[i] >= 10:
                            t = k[i] // 10
                            k[i] -= 10*t
                            k[i+1] += t
                            k[i+2] += t
                            k[i+3] += t
                            changed = True
                # Trim trailing zeros
                while k and k[-1]==0:
                    k.pop()
                return sum(k), k
            
