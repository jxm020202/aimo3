            def enumerate_grid_max(x_max, y_max):
                width = x_max + y_max + 2
                # generate all possible row0 sequences of length width with adjacent diff 1 or 2, start at 0
                def gen_row0(pos, prev, seq):
                    if pos==width:
                        yield seq
                        return
                    for step in [1,2,-1,-2]:
                        val=prev+step
                        if val>=0:
                            yield from gen_row0(pos+1, val, seq+[val])
                row0_list=list(gen_row0(1,0,[0]))
                # DP: for each y, store dict mapping row tuple to True (or just set)
                rows_set=set(tuple(r) for r in row0_list)
                # We'll keep only rows up to needed width.
                for y in range(y_max):
                    next_rows=set()
                    for row in rows_set:
                        # compute possible next row
                        def gen_next(col, new):
                            if col==len(row)-1:
                                next_rows.add(tuple(new))
                                return
                            a=row[col]
                            b=row[col+1]
                            if abs(a-b)==2:
                                c=(a+b)//2
                                if c>=0:
                                    gen_next(col+1, new+[c])
                            else:
