            def max_edges_under_bounds(n):
                # generate bounds sorted descending
                # two copies of n-1, then n-2,...,2,1
                bounds = [n-1, n-1] + list(range(n-2, 0, -1))
                # length should be n
                assert len(bounds) == n
                # prefix sums
                prefix = [0]
                for val in bounds:
                    prefix.append(prefix[-1] + val)
                total = prefix[-1]
                # suffix sums for convenience
                suffix = [0]*(n+2)
                for i in range(n-1, -1, -1):
                    suffix[i] = suffix[i+1] + bounds[i]
                max_excess = 0
                # precompute positions where bound > k using binary search
                import bisect
                # Since bounds decreasing, we can find first index where bounds[idx] <= k
                for k in range(1, n+1):
                    left = prefix[k]
                    # find idx where bounds[idx] <= k, search in bounds list
                    # we need to consider indices > k (0-indexed)
                    # We'll search in bounds[k:] portion
                    # Use bisect_right on reversed? Simpler: iterate but O(n^2). Let's use binary search on whole list.
                    # Since bounds is decreasing, we can find pos = bisect.bisect_right([-x for x in bounds], -k) ??? Not good.
                    # Use custom binary search:
                    lo = k
                    hi = n
                    while lo < hi:
                        mid = (lo+hi)//2
                        if bounds[mid] > k:
                            lo = mid+1
                        else:
                            hi = mid
                    # after loop, lo is first index >=k where bounds[lo] <= k, or n if none
                    pos = lo
                    # number of elements > k among i>k is (pos - k)
                    cnt_gt = max(0, pos - k)
                    # sum of min(k, d_i) = cnt_gt * k + sum_{i=pos}^{n-1} d_i
                    sum_min = cnt_gt * k + suffix[pos]
                    right = k*(k-1) + sum_min
                    excess = left - right
                    if excess > max_excess:
                        max_excess = excess
                # need to reduce total sum by at least max_excess
                adjusted_total = total - max_excess
                # ensure even
                if adjusted_total % 2 == 1:
                    adjusted_total -= 1
                edges = adjusted_total // 2
                return edges, total, max_excess, adjusted_total
            
