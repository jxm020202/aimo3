            def max_black_no3_dp(n):
                popcnt = [bin(m).count('1') for m in range(1<<n)]
                # precompute compatibility matrix
                compat = [[True]*(1<<n) for _ in range(1<<n)]
                for r1 in range(1<<n):
                    for r2 in range(1<<n):
                        ok = True
                        for j in range(n-1):
                            s = ((r1>>j)&1) + ((r1>>(j+1))&1) + ((r2>>j)&1) + ((r2>>(j+1))&1)
                            if s == 3:
                                ok = False
                                break
                        compat[r1][r2] = ok
                # DP: dp[row][prev_row] = max black count up to row (including prev_row)
                # row index from 0..n (number of rows processed)
