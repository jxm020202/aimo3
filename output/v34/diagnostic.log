            import math, itertools
            
            d1=9; d2=5; d3=16
            solutions=[]
            for s1,s2,s3 in itertools.product([1,-1], repeat=3):
                k_u = (s1*d1 + s2*d2)/2
                k_v = (s3*d3 - s2*d2)/2
                k_w = (s1*d1 - s3*d3)/2
                # require k_w > 0
                if k_w <= 0:
                    continue
                # coefficients of quadratic in C = cos^2(alpha)
                A = k_w**2
                B = -(k_w**2 - k_v**2 + k_u**2)  # note sign: we have - (k_w^2 - k_v^2 + k_u^2)
                Cc = k_u**2
                # Actually quadratic: A*C^2 + B*C + Cc = 0 (since B includes negative sign)
                # Let's compute discriminant
                disc = B**2 - 4*A*Cc
                if disc < -1e-9:
                    continue
                disc = max(disc, 0)
                sqrt_disc = math.sqrt(disc)
                for C_candidate in [(-B + sqrt_disc)/(2*A), (-B - sqrt_disc)/(2*A)]:
                    # Check if between 0 and 1
                    if C_candidate <= 0 or C_candidate >= 1:
                        continue
                    S_candidate = 1 - C_candidate
                    # compute p,q
                    p = math.sqrt(C_candidate)
                    q = math.sqrt(S_candidate)
                    # compute side length s = k_w / (p*q)
                    s_len = k_w / (p*q)
                    # Check that U,V,W values consistent with distances? Already built from signs.
                    # Verify distances: compute a = p*s_len, b = q*s_len, then compute distances to lines from Q
                    a = p*s_len
                    b = q*s_len
                    # Compute U,V,W: U = a*y = k_u*s_len, V = b*x = k_v*s_len, W = a*b = k_w*s_len
                    # From these we can compute x,y: x = V / b, y = U / a
                    x = (k_v*s_len) / b
                    y = (k_u*s_len) / a
                    # Check that x^2 + y^2 approx equal (a*b/s_len)^2
                    lhs = x**2 + y**2
                    rhs = (a*b/s_len)**2
                    if abs(lhs - rhs) > 1e-6:
                        continue
                    # compute distances to sides using formulas to verify match 9,5,16
                    # distances: d1 = |a*y + b*x + a*b| / s_len
                    d1_calc = abs(a*y + b*x + a*b) / s_len
                    d2_calc = abs(a*y - b*x - a*b) / s_len
                    d3_calc = abs(a*y + b*x - a*b) / s_len
                    if (abs(d1_calc-9)>1e-6) or (abs(d2_calc-5)>1e-6) or (abs(d3_calc-16)>1e-6):
                        continue
                    perimeter = 4*s_len
                    solutions.append((s1,s2,s3, perimeter, s_len, a,b,x,y))
            solutions[:5], len(solutions)
            
