            def upper_bound(m,n):
                N=m*n
                # degree distribution
                corners=4
                edge=2*(m-2)+2*(n-2)  # non-corner edge cells
                interior=N - corners - edge
                # assign largest to interior, next to edge, smallest to corners
                # compute sums
                total_sum=N*(N+1)//2
                # smallest corners numbers: 1..corners
                corner_sum=corners*(corners+1)//2
                # edge numbers: next edge numbers
                edge_start=corners+1
                edge_end=corners+edge
                edge_sum=(edge_start+edge_end)*edge//2
                interior_sum=total_sum - corner_sum - edge_sum
                weighted_sum=2*corner_sum + 3*edge_sum + 4*interior_sum
                E=m*(n-1)+(m-1)*n
                return weighted_sum//E
            
