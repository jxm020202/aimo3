            import heapq
            
            def max_edges_greedy(n):
                # capacities list
                caps = [min(i, n-1) for i in range(1, n+1)]
                # use max-heap (negative)
                heap = [(-caps[i], i) for i in range(n) if caps[i] > 0]
                heapq.heapify(heap)
                edges = 0
                while len(heap) >= 2:
                    # pop two highest capacities
                    neg_c1, i1 = heapq.heappop(heap)
                    neg_c2, i2 = heapq.heappop(heap)
                    c1 = -neg_c1
                    c2 = -neg_c2
                    # add edge
                    edges += 1
                    c1 -= 1
                    c2 -= 1
                    if c1 > 0:
                        heapq.heappush(heap, (-c1, i1))
                    if c2 > 0:
                        heapq.heappush(heap, (-c2, i2))
                return edges
            
            for n in range(5,21):
                print(n, max_edges_greedy(n))
            
