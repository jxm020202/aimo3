            def is_complete_bipartite(edges, n):
                # try to find bipartition
                # simple check if graph is bipartite and edges count equals a*b
                import networkx as nx
                G=nx.Graph()
                G.add_nodes_from(range(n))
                G.add_edges_from(edges)
                if not nx.is_bipartite(G):
                    return False, None
                left,right=nx.algorithms.bipartite.sets(G)
                a=len(left)
                b=len(right)
                return len(edges)==a*b, (a,b)
            
