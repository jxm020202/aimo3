            def compute_solvable_states(n):
                total = 1 << (n*n)
                # precompute popcount for each state
                popcnt = [bin(s).count('1') for s in range(total)]
                # group states by popcount
                states_by_pop = [[] for _ in range(n*n+1)]
                for s in range(total):
                    states_by_pop[popcnt[s]].append(s)
                solvable = [False]*total
                target = (1 << (n*n)) - 1
                solvable[target] = True
                # Process decreasing popcount
                for cnt in range(n*n, -1, -1):
                    for s in states_by_pop[cnt]:
                        if solvable[s]:
                            continue
                        # generate moves from s
                        # if any move leads to solvable, mark s solvable
                        found = False
                        for i in range(n-1):
                            for j in range(n-1):
                                idx = i*n + j
                                pos = [idx, idx+1, idx+n, idx+n+1]
                                ssum = sum(((s>>p)&1) for p in pos)
