            from functools import lru_cache
            
            def max_min_adj_sum_grid_bruteforce(m,n):
                N=m*n
                cells=[(i,j) for i in range(m) for j in range(n)]
                adj={}
                for idx,(i,j) in enumerate(cells):
                    neigh=[]
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            neigh.append(cells.index((ni,nj)))
                    adj[idx]=neigh
                # backtracking to find max S
                best=0
                best_perm=None
                # order cells maybe by degree descending for pruning
                order=sorted(range(N), key=lambda x: -len(adj[x]))
                # precompute neighbor indices for each cell
                # Use recursion
                used=[False]*(N+1)
                perm=[0]*N
                # maintain current min sum among assigned edges
                def dfs(pos, current_min):
                    nonlocal best,best_perm
                    if pos==N:
                        if current_min>best:
                            best=current_min
                            best_perm=perm.copy()
                        return
                    # upper bound: even if remaining edges have max possible sum (max+max) = (N)+(N-1) maybe, but not needed
                    cell=order[pos]
                    # try numbers in descending order maybe to get high min early
                    for num in range(N,0,-1):
                        if not used[num]:
                            # compute new min sum for edges where both ends assigned
                            new_min=current_min
                            for nb in adj[cell]:
                                if perm[nb]!=0: # neighbor already assigned
                                    s=num+perm[nb]
                                    if s<new_min:
                                        new_min=s
                            # prune if new_min <= best (cannot improve)
                            if new_min<=best:
                                continue
                            used[num]=True
                            perm[cell]=num
                            dfs(pos+1, new_min)
                            used[num]=False
                            perm[cell]=0
                dfs(0, float('inf'))
                return best,best_perm
            
            print(max_min_adj_sum_grid_bruteforce(3,4)[0])
            
