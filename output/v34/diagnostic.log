            def verify_solution(grid_NE, grid_SE):
                N = grid_NE.shape[0]
                # compute incoming count per vertex
                incoming = np.zeros((N+1, N+1), dtype=int)
                for i in range(N):
                    for j in range(N):
                        if grid_NE[i,j]==1:
                            # edge from (i,j) to (i+1,j+1)
                            incoming[i+1, j+1] += 1
                        if grid_SE[i,j]==1:
                            # edge from (i,j+1) to (i+1,j)
                            incoming[i+1, j] += 1
                if np.any(incoming>1):
                    print("Incoming >1")
                    return False
                # check adjacency condition
                # collect heads list
                heads = []
                for i in range(N+1):
                    for j in range(N+1):
                        if incoming[i,j]==1:
                            heads.append((i,j))
                # For each pair of heads
                for a in range(len(heads)):
                    for b in range(a+1, len(heads)):
                        v = heads[a]
                        w = heads[b]
                        dx = w[0]-v[0]
                        dy = w[1]-v[1]
                        dist_sq = dx*dx + dy*dy
                        if dist_sq < 4:  # distance <2
                            # need check if there is edge from v to w or w to v (direction allowed)
                            # Determine if v->w is a possible directed diagonal (NE or SE)
                            ok = False
                            # NE: w = (v[0]+1, v[1]+1)
                            if w[0]==v[0]+1 and w[1]==v[1]+1 and grid_NE[v[0], v[1]]==1:
