            def feasible_S_continuous(m,n,S):
                from scipy.optimize import milp, LinearConstraint, Bounds
                import numpy as np
                V=m*n
                vertices=[(i,j) for i in range(m) for j in range(n)]
                edges=[]
                for i in range(m):
                    for j in range(n):
                        if i+1<m: edges.append(((i,j),(i+1,j)))
                        if j+1<n: edges.append(((i,j),(i,j+1)))
                num_vars=V*V
                c=np.zeros(num_vars)
                A=[]; lb=[]; ub=[]
                for vi in range(V):
                    row=np.zeros(num_vars); row[vi*V:(vi+1)*V]=1
                    A.append(row); lb.append(1); ub.append(1)
                for k in range(V):
                    row=np.zeros(num_vars); row[k::V]=1
                    A.append(row); lb.append(1); ub.append(1)
                for (u_coord,v_coord) in edges:
                    u_idx=vertices.index(u_coord)
                    v_idx=vertices.index(v_coord)
                    row=np.zeros(num_vars)
                    row[u_idx*V:(u_idx+1)*V]=np.arange(1,V+1)
                    row[v_idx*V:(v_idx+1)*V]=np.arange(1,V+1)
                    A.append(row); lb.append(S); ub.append(np.inf)
                A_mat=np.vstack(A)
                lc=LinearConstraint(A_mat, lb, ub)
                bounds=Bounds(np.zeros(num_vars), np.ones(num_vars))
                res=milp(c, constraints=lc, bounds=bounds, integrality=np.zeros(num_vars, dtype=int), options={"disp": False})
                return res.success
            
            print(feasible_S_continuous(2,2,3))
            
