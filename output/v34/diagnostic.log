            from fractions import Fraction
            def is_square(n):
                if n < 0:
                    return False
                r = int(math.isqrt(n))
                return r*r == n
            
            def find_candidates(max_den=20):
                sols = []
                for b in range(1, max_den+1):
                    for a in range(1, b):  # t between 0 and 1
                        t = Fraction(a, b)
                        # compute numerator and denominator of RHS as fractions
                        num = 2 * (t + 1)**2
                        den = 5*t**2 - 2*t + 1
                        # simplify fraction
                        frac = Fraction(num, den)  # automatically reduces
                        # need frac to be perfect square rational
                        # i.e., numerator and denominator both perfect squares
                        if is_square(frac.numerator) and is_square(frac.denominator):
                            k = Fraction(int(math.isqrt(frac.numerator)), int(math.isqrt(frac.denominator)))
                            # compute x,y
                            x = Fraction(1,1) - t*t
                            x = x / 2
                            # compute A
                            A = Fraction((t+1)**2, 5*t*t - 2*t + 1)
                            y = k - A
                            if y > 0:
                                # compute k_min = lcm denominators of x,y
                                k_min = sp.ilcm(x.denominator, y.denominator)
                                sols.append((k_min, x, y, t, k))
                return sols
            
            sols = find_candidates(30)
            len(sols)
            
