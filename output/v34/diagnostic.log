            import random, time, math, numpy as np
            
            def simulated_annealing(initial_grid, target_S, max_time=30):
                n = initial_grid.shape[0]
                grid = initial_grid.copy()
                current_min = min_edge_sum_grid(grid)
                best_grid = grid.copy()
                best_min = current_min
                start = time.time()
                T0 = 1.0
                while time.time() - start < max_time:
                    # temperature schedule
                    t = (time.time() - start) / max_time
                    T = T0 * (1 - t)
                    # pick two random cells to swap
                    (i1,j1), (i2,j2) = random.sample([(i,j) for i in range(n) for j in range(n)], 2)
                    # swap
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    new_min = min_edge_sum_grid(grid)
                    delta = new_min - current_min
                    accept = False
                    if delta >= 0:
                        accept = True
                    else:
                        # accept with probability exp(delta/T) (delta negative)
                        if random.random() < math.exp(delta / max(T, 1e-6)):
                            accept = True
                    if accept:
                        current_min = new_min
                        if new_min > best_min:
                            best_min = new_min
                            best_grid = grid.copy()
                            #print("New best", best_min)
                            if best_min >= target_S:
                                return best_grid, best_min
                    else:
                        # revert swap
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                return best_grid, best_min
            
            # start from random grid
            def random_grid():
                n=60
                vals = list(range(1, n*n+1))
                random.shuffle(vals)
                return np.array(vals).reshape((n,n))
            
