```python
import itertools

def independent_sets_2xn(n):
    # vertices numbered (row, col) -> 0..2*n-1
    verts = [(r,c) for r in (0,1) for c in range(n)]
    # adjacency
    adj = {}
    for v in verts:
        r,c = v
        neigh = []
        # vertical neighbour
        neigh.append((1-r,c))
        # horizontal neighbours
        if c>0:   neigh.append((r,c-1))
        if c<n-1: neigh.append((r,c+1))
        adj[v] = set(neigh)
    count = 0
    for mask in range(1<< (2*n)):
        ok = True
        chosen = [verts[i] for i in range(2*n) if mask>>i & 1]
        for i,v in enumerate(chosen):
            for u in chosen[i+1:]:
                if u in adj[v]:
                    ok = False
                    break
            if not ok: break
        if ok:
            count += 1
    return count

# check n=1..6
for n in range(1,7):
    print(n, independent_sets_2xn(n))
```

