            def max_edges_n(n):
                # edges list
                edges = [(i,j) for i in range(1,n) for j in range(i+1,n+1)]
                m = len(edges)
                # Build incidence matrix: rows per vertex
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(edges):
                    A[i-1, idx] = 1
                    A[j-1, idx] = 1
                # degree bounds
                deg_bounds = [min(k, n-1) for k in range(1,n+1)]
                # constraints: A x <= deg_bounds
                lin_con = LinearConstraint(A, -np.inf, deg_bounds)
                # objective: maximize sum x -> minimize -sum x
                c = -np.ones(m)
                bounds = Bounds(0, 1)  # 0 <= x <= 1
                res = milp(c=c, constraints=[lin_con], bounds=bounds, integrality=np.ones(m, dtype=int), options={'presolve': True, 'disp': False})
                if not res.success:
                    print("failed")
                    return None
                opt = int(round(-res.fun))
                return opt
            
            for n in range(2,13):
                print(n, max_edges_n(n))
            
