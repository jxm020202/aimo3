            def max_edges_greedy(n):
                # capacities = i for i=1..n
                caps = list(range(1, n+1))
                # We'll maintain list of (capacity, index) sorted descending.
                import heapq
                # Use max-heap via negative capacities
                heap = [(-caps[i], i) for i in range(n)]
                heapq.heapify(heap)
                edges = 0
                # adjacency not needed, just count edges
                while heap:
                    cap, v = heapq.heappop(heap)
                    cap = -cap
                    if cap == 0:
                        continue
                    # Need to connect v to cap other vertices with positive capacity
                    # Extract up to cap vertices from heap
                    temp = []
                    for _ in range(cap):
                        if not heap:
                            # not enough vertices, cannot use remaining capacity
                            # break and set cap to len(temp)
                            break
                        c2, u = heapq.heappop(heap)
                        c2 = -c2
                        # connect v-u
                        edges += 1
                        c2 -= 1
                        temp.append((c2, u))
                    # after connections, v's capacity becomes 0 (used all)
                    # push back the other vertices with updated capacities
                    for c2, u in temp:
                        heapq.heappush(heap, (-c2, u))
                return edges
            
