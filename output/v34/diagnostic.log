            def compute_vectors(N):
                # returns list of vectors (A,B,C) for r^i
                vectors = [(1,0,0), (0,1,0), (0,0,1)]
                for n in range(0, N-2):
                    # compute r^{n+3}
                    a_n, b_n, c_n = vectors[n]
                    a_n1, b_n1, c_n1 = vectors[n+1]
                    a_n2, b_n2, c_n2 = vectors[n+2]
                    # r^{n+3} = 10 r^n - r^{n+2} - r^{n+1}
                    a = 10*a_n - a_n2 - a_n1
                    b = 10*b_n - b_n2 - b_n1
                    c = 10*c_n - c_n2 - c_n1
                    vectors.append((a,b,c))
                return vectors
            
