            import random, math, numpy as np
            
            def random_point_on_sphere():
                # generate random direction uniformly
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v - 1)  # not uniform? Actually for sphere radius sqrt(3), but we just need random points
                # Use normal distribution method
                vec = np.random.normal(size=3)
                vec = vec / np.linalg.norm(vec) * math.sqrt(3)
                return vec
            
            def f_val(pt):
                x,y,z = pt
                return x*y**3 + y*z**3 + z*x**3
            
            def find_close(num_samples=100000, tol=1e-3):
                close=[]
                for _ in range(num_samples):
                    pt = random_point_on_sphere()
                    f = f_val(pt)
                    if abs(f-3) < tol:
                        close.append(pt)
                return close
            
