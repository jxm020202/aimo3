            def eg_deficit(seq):
                # returns list of deficits where inequality fails (LHS - RHS)
                n = len(seq)
                seq_desc = sorted(seq, reverse=True)
                prefix = [0]
                for d in seq_desc:
                    prefix.append(prefix[-1]+d)
                max_def = 0
                for k in range(1, n+1):
                    lhs = prefix[k]
                    # RHS = k*(k-1) + sum_{i=k+1}^n min(k, d_i)
                    # compute efficiently
                    # Since seq_desc is sorted descending, for i>k, d_i <= seq_desc[k] maybe.
                    # We'll compute directly.
                    rhs = k*(k-1)
                    for i in range(k, n):
                        rhs += min(k, seq_desc[i])
                    diff = lhs - rhs
                    if diff > max_def:
                        max_def = diff
                return max_def
            
