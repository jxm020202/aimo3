            # Find unmatched left vertices
            matched_left = {u for u in matching if u[0]=='d'}
            unmatched_left = U - matched_left
            # BFS alternating paths
            from collections import deque
            Z = set()
            queue = deque(unmatched_left)
            while queue:
                u = queue.popleft()
                if u in Z:
                    continue
                Z.add(u)
                # if u in left side, follow unmatched edges to right side
                if u[0]=='d':
