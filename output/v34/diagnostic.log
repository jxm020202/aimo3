            import math, numpy as np, random
            
            def arc_points(n, d=10.0, R=20.0):
                # endpoints at (0,0) and (d,0)
                # center at (d/2, h) where h = sqrt(R^2 - (d/2)^2)
                if R < d/2:
                    raise ValueError("Radius too small")
                h = math.sqrt(R*R - (d/2)*(d/2))
                cx = d/2
                cy = h
                # compute angles of endpoints relative to center
                ang1 = math.atan2(-cy, -cx)  # point (0,0) relative to center
                ang2 = math.atan2(-cy, d-cx)  # point (d,0)
                # ensure ang2 > ang1
                if ang2 < ang1:
                    ang2 += 2*math.pi
                # generate n points equally spaced in angle between ang1 and ang2
                angles = np.linspace(ang1, ang2, n)
                pts = [(cx + R*math.cos(a), cy + R*math.sin(a)) for a in angles]
                return pts
            
