            def improve_to_target(grid, target, max_iters=100000):
                n = grid.shape[0]
                # precompute neighbor list for each cell
                neighbors = {}
                for i in range(n):
                    for j in range(n):
                        neigh=[]
                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            ni,nj=i+di,j+dj
                            if 0<=ni<n and 0<=nj<n:
                                neigh.append((ni,nj))
                        neighbors[(i,j)]=neigh
                # function to find a violating edge
                def find_violation():
                    for i in range(n):
                        for j in range(n):
                            for (ni,nj) in neighbors[(i,j)]:
                                if (i,j) < (ni,nj):  # count each edge once
                                    if grid[i,j] + grid[ni,nj] < target:
                                        return (i,j,ni,nj)
                    return None
                for it in range(max_iters):
                    viol = find_violation()
                    if viol is None:
                        return True, it
                    i,j,ni,nj = viol
                    # try to swap one of the two cells with another cell to increase sum
                    # pick a random other cell
                    ii,jj = random.randrange(n), random.randrange(n)
                    # ensure not same as i,j or ni,nj
                    if (ii,jj) in [(i,j),(ni,nj)]:
                        continue
                    # swap values
                    grid[i,j], grid[ii,jj] = grid[ii,jj], grid[i,j]
                    # check if violation resolved (maybe new violations elsewhere)
