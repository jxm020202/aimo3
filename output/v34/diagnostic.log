        Here is a Python script that computes the minimal ratio \(L/s\) for each possible sum \(s\) (with three distinct positive integers) up to a reasonable bound (200). This gives the function \(R(s)=\min\frac{\operatorname{lcm}(x,y,z)}{s}\) which we will later use to determine \(f(n)=n\cdot\min_{s\mid n}R(s)\).

```python
import math
from itertools import combinations

def min_lcm_ratio(limit):
    """
    For each s = 6..limit compute
        R(s) = min_{distinct x,y,z>0, x+y+z=s} lcm(x,y,z)/s .
    Returns a dict {s: (R, (x,y,z))} where R is a rational number
    (stored as a tuple (num, den) reduced) and (x,y,z) is a triple
    achieving the minimum.
    """
    from fractions import Fraction
    R = {}
    for s in range(6, limit+1):
        best = None
        best_trip = None
        # generate triples x<y<z, sum = s
        # we can bound x up to s//3
        for x in range(1, s//3 + 1):
            for y in range(x+1, (s-x)//2 + 1):
                z = s - x - y
                if z <= y:          # ensure distinct and ordered
                    continue
                L = math.lcm(x, y, z)
                ratio = Fraction(L, s)
                if best is None or ratio < best:
                    best = ratio
                    best_trip = (x, y, z)
        if best is not None:
            R[s] = (best, best_trip)
    return R

# compute up to 200 (more than enough for our purposes)
R_dict = min_lcm_ratio(200)

# display a few values
for s in sorted(R_dict)[:20]:
    ratio, trip = R_dict[s]
    print(f"s={s:3d}, min L/s = {ratio}  (triplet {trip})")
```

