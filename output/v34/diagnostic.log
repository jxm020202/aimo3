            def max_edges_monotone(n):
                # caps: degree <= i
                caps = [0] + [i for i in range(1, n+1)]  # 1-indexed
                remaining = caps[:]
                adj = [set() for _ in range(n+1)]
                edges=0
                # Process vertices in increasing order
                for i in range(1, n+1):
                    # Determine how many edges we can still add incident to i
                    need = remaining[i]
                    if need==0:
                        continue
                    # Find candidates j>i with remaining>0 and not already adjacent
                    # We'll iterate j from n down to i+1 (largest indices first)
                    for j in range(n, i, -1):
                        if need==0:
