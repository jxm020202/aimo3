                    if i-1 < n_c:
                        row[i-1] = 1  # c_i
                    # s_i term
                    row[n_c + (i-1)] = 1
                    # e_i term
                    row[n_c + n_s + (i-1)] = 1
                    # r_i term coefficient -4
                    row[total_vars + (i-1)] = -4
                    # RHS = 2*a_i where a_i = 1 for tails (odd positions), 0 for heads (even)
                    a_i = 1 if (i%2==1) else 0  # tails at odd positions
                    rhs = 2*a_i
                    A_eq2.append(row)
                    b_eq2.append(rhs)
                # Combine equality constraints
                A_eq = np.vstack(A_eq + A_eq2)
