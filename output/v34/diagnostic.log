                # assume m,n even? not needed
                grid = np.zeros((m,n), dtype=int)
                # assign numbers via matching: for each cell (i,j) with (i+j)%2==0 (black), match with (i,j+1) if exists else (i+1,j)
                # We'll just use simple matching: if j+1<n, match right; else match down.
                black_positions = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==0]
