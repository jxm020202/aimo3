            def pretty_exists(m,n,k):
                # search for integer A,B satisfying Eq1 and interval intersect
                # A ranges maybe around m*alpha but we don't know alpha; we can bound A between 0 and m*some large? We'll just search plausible range.
                # Since A = floor(m*alpha), B = floor(n*alpha). For any alpha, A/m approx alpha, B/n approx alpha.
                # So A/m and B/n must be close. So we can search A around some value.
                # We'll search A from 0 to m*10 maybe? Not efficient.
                # Instead we can solve Eq1 for B given A: B = (n A + k - m)/m must be integer.
                # So iterate A such that numerator divisible by m.
                for A in range(0, m*10+1):
                    num = n*A + k - m
                    if num % m != 0:
                        continue
                    B = num // m
                    # intervals:
                    a_low = A/m
                    a_high = (A+1)/m
                    b_low = B/n
                    b_high = (B+1)/n
                    # need intersection nonempty
                    low = max(a_low, b_low)
                    high = min(a_high, b_high)
                    if low < high:
                        # also need alpha irrational; we can pick any irrational in (low,high)
                        # ensure interval not a single rational point; but low<high ensures there are irrationals.
                        return True
                return False
            
