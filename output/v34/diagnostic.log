            def syndrome_to_kernel(N, syndrome):
                # Given syndrome (list length d), find kernel element K = p_i + q_j (matrix) that corresponds.
                # We have basis vectors of kernel (size d x N^2). Each basis vector corresponds to a kernel matrix.
                ops = generate_matrices(N)
                H = np.array(nullspace_mod2(ops), dtype=int)  # each row is a kernel basis vector (size N^2)
                # syndrome is linear combination of basis rows: sum s_i * H_i = K vector
                K_vec = np.zeros(N*N, dtype=int)
                for coeff, row in zip(syndrome, H):
                    if coeff:
                        K_vec = (K_vec + row) % 2
                # reshape to matrix
                K = K_vec.reshape(N,N)
                return K
            
