            def find_min_k(limit_q=200):
                min_k = None
                best = None
                for q in range(1, limit_q+1):
                    for p in range(0, q+1):
                        if math.gcd(p,q)!=1:
                            continue
                        s = Fraction(p, q)
                        # s must be <=1 (since sqrt(1-2x) <=1)
                        if s > 1:
                            continue
                        # compute D and Q as before
                        D = Fraction(5*s*s - 2*s + 1)
                        if D <= 0:
                            continue
                        Q = Fraction(2)*(s+1)*(s+1) / D
                        if Q <= 0:
                            continue
                        num, den = Q.numerator, Q.denominator
                        if not (is_perfect_square(num) and is_perfect_square(den)):
                            continue
                        sqrtQ = Fraction(int(math.isqrt(num)), int(math.isqrt(den)))
                        t = sqrtQ - 1
                        if t < 0:
                            continue
                        y = Fraction(1,2) - Fraction(t*t,2)
                        x = Fraction(1,2) - Fraction(s*s,2)
                        if x <= 0 or y <= 0:
                            continue
                        k = math.lcm(x.denominator, y.denominator)
                        if min_k is None or k < min_k:
                            min_k = k
                            best = (x, y, s, sqrtQ, k)
                return min_k, best
            
            min_k, best = find_min_k(200)
            min_k, best
            
