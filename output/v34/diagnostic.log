        ```python
def max_adjacent_sum(grid_rows, grid_cols):
    import itertools, math
    N = grid_rows * grid_cols
    # generate adjacency pairs
    adj = []
    for r in range(grid_rows):
        for c in range(grid_cols):
            idx = r*grid_cols + c
            if r+1 < grid_rows:
                adj.append((idx, (r+1)*grid_cols + c))
            if c+1 < grid_cols:
                adj.append((idx, r*grid_cols + (c+1)))
    best = -1
    best_perm = None
    for perm in itertools.permutations(range(1, N+1)):
        # compute minimal sum across adjacents
        mins = min(perm[a] + perm[b] for a,b in adj)
        if mins > best:
            best = mins
            best_perm = perm
    return best, best_perm

print(max_adjacent_sum(2,2))
