            def real_cuberoot(z):
                # return real cube root of real number, handling negative
                if isinstance(z, complex):
                    raise
                if z >= 0:
                    return z**(1/3)
                else:
                    return -((-z)**(1/3))
            def cube_expr_real(xval):
                a = (1+xval**2)/2
                b = math.sqrt(9*xval**4 + (4*xval**6)/3 + 9 + 18*xval**2)/6
                return real_cuberoot(a+b) + real_cuberoot(a-b)
            for xv in [0.1,0.2,0.25,0.3,0.4,0.5]:
                print(xv, cube_expr_real(xv))
            
