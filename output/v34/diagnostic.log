            def ratio(xs):
                S = sum(xs)
                g = math.gcd(math.gcd(math.gcd(math.gcd(math.gcd(xs[0], xs[1]), xs[2]), xs[3]), xs[4]), xs[5])
                # compute sum term_i
                total = 0
                n = 6
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    d = math.gcd(a,b)
                    l = a*b//math.gcd(a,b)  # not needed
                    # compute lcm(b,c)
                    lcm_bc = b*c // math.gcd(b,c)
                    total += d * lcm_bc
                return (S**3) / (g * total) if total!=0 else float('inf')
            
