            def gf2_basis(vectors, N):
                basis=[]
                lead_pos=[]
                for v in vectors:
                    w=v
                    for i, b in enumerate(basis):
                        if (w >> lead_pos[i]) & 1:
                            w ^= b
                    if w!=0:
                        # find leading position (most significant bit)
                        lp = w.bit_length() - 1
                        # insert into basis maintaining decreasing order of lead pos
                        # ensure no other basis vectors have this lead pos
                        # eliminate this lead from existing basis vectors
                        for i in range(len(basis)):
                            if (basis[i] >> lp) & 1:
                                basis[i] ^= w
                        basis.append(w)
                        lead_pos.append(lp)
                return basis
            
