            def hill_climb(iterations, max_val):
                # start with random tuple with gcd=1
                xs = [random.randint(1, max_val) for _ in range(6)]
                while math.gcd(math.gcd(math.gcd(math.gcd(math.gcd(xs[0], xs[1]), xs[2]), xs[3]), xs[4]), xs[5]) != 1:
                    xs = [random.randint(1, max_val) for _ in range(6)]
