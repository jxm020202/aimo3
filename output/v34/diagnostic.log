                best_set = None
                points = [(x,y) for x in range(1,N+1) for y in range(1,N+1)]
                # order points maybe row-major
                def backtrack(idx, current):
                    nonlocal best, best_set
                    # prune: remaining points count
                    if idx == len(points):
                        if len(current) > best:
                            best = len(current)
                            best_set = current.copy()
                        return
                    # upper bound
                    remaining = len(points) - idx
                    if len(current) + remaining <= best:
                        return
                    # try include point
                    p = points[idx]
                    # quick check if adding p creates forbidden config
                    # we can test with has_isosceles_trapezoid on current+{p}
                    if not has_isosceles_trapezoid(current | {p}):
                        backtrack(idx+1, current | {p})
                    # skip point
                    backtrack(idx+1, current)
                backtrack(0, set())
                return best, best_set
            
