            def enumerate_grid(max_x, max_y):
                width = max_x + max_y + 2  # enough columns
                # generate all possible row0 sequences of length width with adjacent diff 1 or 2, nonnegative, starting at 0.
                def gen_row0(pos, prev, seq):
                    if pos==width:
                        yield seq
                        return
                    # choose value for current position (pos)
                    # we already have prev (value at pos-1)
                    # need |curr - prev| in {1,2}
                    for step in [1,2,-1,-2]:
                        curr = prev + step
                        if curr>=0:
                            yield from gen_row0(pos+1, curr, seq+[curr])
                # start with first element 0
                rows0 = list(gen_row0(1, 0, [0]))
                # Now BFS over rows
                # each state is a tuple of current row values (list)
                # we will propagate up to max_y rows, storing possible values at target cell
                target_vals=set()
                # Use dict mapping row tuple to True (avoid duplicates)
                current_rows = {tuple(r) for r in rows0}
                for y in range(max_y):
                    next_rows=set()
                    for row in current_rows:
                        # row length = width
                        # compute possible next row values for positions 0..width-2 (since need pair)
