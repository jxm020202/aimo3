                        for k,v in coeff.items():
                            row[k] = v
                        rows.append(row)
                        b.append(1)  # <=1
            
            # adjacency constraints for NE neighbor pairs
            for i in range(N):
                for j in range(N):
                    # pair (i,j) and (i+1,j+1)
