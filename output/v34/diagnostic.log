            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_S_grid_milp(m,n):
                N = m*n
                # map cell index to (i,j)
                cells = [(i,j) for i in range(m) for j in range(n)]
                # edges list of pairs of cell indices
                edges = []
                for i in range(m):
                    for j in range(n):
                        idx = i*n + j
                        if i+1<m:
                            edges.append((idx, (i+1)*n + j))
                        if j+1<n:
                            edges.append((idx, i*n + (j+1)))
                # binary variables y_{cell, value} flattened
                # total vars = N * N (value range 1..N)
                var_count = N * N
                # objective: maximize S (we will binary search)
                # We'll implement feasibility check for given S
                def feasible(S):
                    # constraints:
                    # each cell gets exactly one value
                    A_eq = []
                    b_eq = []
                    for cell in range(N):
                        row = np.zeros(var_count)
                        for val in range(N):
                            row[cell*N + val] = 1
                        A_eq.append(row)
                        b_eq.append(1)
                    # each value assigned to exactly one cell
                    for val in range(N):
                        row = np.zeros(var_count)
                        for cell in range(N):
                            row[cell*N + val] = 1
                        A_eq.append(row)
                        b_eq.append(1)
                    # edge constraints: for each edge (i,j), for each pair (k,l) with (k+1)+(l+1) < S (since values start at 1)
                    # we add constraint y_i_k + y_j_l <= 1
                    A_ub = []
                    b_ub = []
                    for (i,j) in edges:
