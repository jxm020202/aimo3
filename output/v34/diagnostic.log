                    rows.append(row); lbs.append(1); ubs.append(1)
                # each number assigned once
                for k in range(1,N+1):
                    row=np.zeros(num_vars, dtype=int)
                    for i in range(N):
                        row[i*N + (k-1)] = 1
                    rows.append(row); lbs.append(1); ubs.append(1)
                # edges
                edges=[]
                for r in range(n):
                    for c in range(n):
                        i=r*n + c
                        if r+1<n:
                            edges.append((i,(r+1)*n + c))
                        if c+1<n:
                            edges.append((i, r*n + (c+1)))
                # we will binary search S
                lo, hi = 2, 2*N
                best=2
                while lo <= hi:
                    mid = (lo+hi)//2
                    # add edge constraints for this mid
                    rows_mid = rows.copy()
                    lbs_mid = lbs.copy()
                    ubs_mid = ubs.copy()
                    for (i,j) in edges:
                        row=np.zeros(num_vars, dtype=int)
                        for k in range(1,N+1):
                            row[i*N + (k-1)] = -k
                        for l in range(1,N+1):
                            row[j*N + (l-1)] = -l
                        rows_mid.append(row); lbs_mid.append(-np.inf); ubs_mid.append(-mid)
                    A = np.vstack(rows_mid)
                    lb_arr = np.array(lbs_mid, dtype=float)
                    ub_arr = np.array(ubs_mid, dtype=float)
                    lin_con = opt.LinearConstraint(A, lb_arr, ub_arr)
                    bounds = opt.Bounds(0,1)
                    integrality = np.ones(num_vars, dtype=int)
                    res = opt.milp(c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'presolve': True, 'time_limit': 30})
                    if res.success:
                        best = mid
                        lo = mid + 1
                    else:
                        hi = mid - 1
                return best
            
