            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np, itertools, math, sys, time
            
            def feasible_grid(r,c,S):
                n=r*c
                cells=[(i,j) for i in range(r) for j in range(c)]
                # adjacency edges (undirected)
                edges=set()
                for idx,(i,j) in enumerate(cells):
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<r and 0<=nj<c:
                            jdx=cells.index((ni,nj))
                            edges.add(tuple(sorted((idx,jdx))))
                edges=list(edges)
                # variables x_{v,k} flattened: v*n + (k-1)
                Nvars=n*n
                # objective dummy zero
                c=np.zeros(Nvars)
                # constraints
                A=[]
                lb=[]
                ub=[]
                # each vertex assigned exactly one number
                for v in range(n):
                    row=np.zeros(Nvars)
                    row[v*n:(v+1)*n]=1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # each number assigned to exactly one vertex
                for k in range(n):
                    row=np.zeros(Nvars)
                    for v in range(n):
                        row[v*n + k]=1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # edge constraints: for each edge (u,v) and each pair (a,b) with a+b < S, forbid
                # i.e., x_{u,a}+x_{v,b} <= 1
                for (u,v) in edges:
                    for a in range(1,n+1):
                        for b in range(1,n+1):
                            if a+b < S:
                                row=np.zeros(Nvars)
                                row[u*n + (a-1)] = 1
                                row[v*n + (b-1)] = 1
                                A.append(row)
                                lb.append(0)
                                ub.append(1)
                A=np.array(A)
                lb=np.array(lb)
                ub=np.array(ub)
                bounds=Bounds(0,1)  # variables binary
                res=milp(c, constraints=LinearConstraint(A,lb,ub), bounds=bounds, integrality=np.ones(Nvars), options={'disp': False})
                return res.success
            
            print(feasible_grid(3,3,9))
            
