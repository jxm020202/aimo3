            import itertools, cmath, math
            
            def roots_of_unity(N):
                return [cmath.exp(2j*math.pi*k/N) for k in range(N)]
            
            def find_solution(m, max_n=6, max_order=9):
                # include zero as option
                candidates = [0]  # zero
                for N in range(1, max_order+1):
                    candidates.extend(roots_of_unity(N))
                # remove duplicates approximate
                # We'll treat as list of complex numbers
                # Search combinations with repetitions up to max_n
                # Use product with replacement (multiset) of size up to max_n
                # But large combinatorial; we can limit to small n.
                for n in range(1, max_n+1):
                    # generate combinations with replacement of candidates of size n
                    # use itertools.combinations_with_replacement
                    for combo in itertools.combinations_with_replacement(candidates, n):
                        ok = True
                        for e in range(1, m+1):
                            prod = 1
                            for r in combo:
                                prod *= (r**e + 1)
                            if abs(prod - 1) > 1e-6:
                                ok = False
                                break
                        if ok:
                            return combo
                return None
            
            for m in range(1,5):
                sol = find_solution(m, max_n=5, max_order=7)
                print("m", m, "sol", sol)
            
