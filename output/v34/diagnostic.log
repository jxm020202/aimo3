            def f_formula2(n):
                S = n-1
                # find smallest divisor >=3
                # iterate over possible divisors
                # we can factor S partially; but for small n just brute
                T = None
                for d in range(3, S+1):
                    if S % d == 0:
                        T = d
                        break
                if T is None:
                    # S has no divisor >=3 (i.e., S is 1,2, or prime 2? but n>=6 => S>=5)
                    # If S is prime and >=3, then T = S (since S divides itself)
                    # Actually smallest divisor >=3 is S itself if S is prime >=3.
                    T = S
