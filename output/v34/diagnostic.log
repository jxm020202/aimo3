            import random, math
            
            def random_point_on_sphere():
                # generate normal distribution and normalize
                while True:
                    x = random.gauss(0,1)
                    y = random.gauss(0,1)
                    z = random.gauss(0,1)
                    norm = math.sqrt(x*x + y*y + z*z)
                    if norm > 0:
                        return (x/norm*math.sqrt(3), y/norm*math.sqrt(3), z/norm*math.sqrt(3))
            
            def f_val(pt):
                x,y,z = pt
                return x*y**3 + y*z**3 + z*x**3
            
