            def compute_vectors(N):
                a = [0]*(N+1)
                b = [0]*(N+1)
                c = [0]*(N+1)
                # base
                a[0], b[0], c[0] = 1,0,0
                if N>=1:
                    a[1], b[1], c[1] = 0,1,0
                if N>=2:
                    a[2], b[2], c[2] = 0,0,1
                for i in range(0,N-2):
                    # compute i+3 using recurrence
                    a[i+3] = 10*a[i] - a[i+2] - a[i+1]
                    b[i+3] = 10*b[i] - b[i+2] - b[i+1]
                    c[i+3] = 10*c[i] - c[i+2] - c[i+1]
                return a,b,c
            
