            def max_edges_milp(N):
                # caps: b_i = i for i=1..N-1, b_N = N-1
                caps = [i for i in range(1,N)] + [N-1]
                # variables for each unordered pair (i,j)
                pairs = [(i,j) for i in range(N) for j in range(i+1,N)]
                m = len(pairs)
                # objective: maximize sum x
                c = np.ones(m, dtype=int)
                # constraints: for each vertex i, sum of x over pairs containing i <= caps[i]
                A = np.zeros((N, m), dtype=int)
                for idx, (i,j) in enumerate(pairs):
                    A[i, idx] = 1
                    A[j, idx] = 1
                # bounds: 0 <= x <= 1, integer
                bounds = opt.Bounds(0, 1)
                integrality = np.ones(m, dtype=int)
                # Use milp
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A, -np.inf, caps), bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    raise RuntimeError("MILP failed")
                return int(res.fun)  # objective value (max)
            
