            import itertools, numpy as np, math, sys, time, warnings, os, json, collections, random, functools, fractions, decimal, heapq, statistics, itertools, math, sympy as sp, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_edges_milp(N):
                # variable index mapping for pairs i<j
                pairs = [(i,j) for i in range(1,N+1) for j in range(i+1,N+1)]
                m = len(pairs)
                c = np.ones(m, dtype=int)  # maximize sum, but milp solves min, so use -c
                # constraints: for each vertex i, sum of edges incident ≤ cap_i
                caps = [i for i in range(1,N)] + [N-1]
                A = np.zeros((N, m), dtype=int)
                for idx, (i,j) in enumerate(pairs):
                    A[i-1, idx] = 1
                    A[j-1, idx] = 1
                # inequality A x ≤ caps
                lc = LinearConstraint(A, -np.inf, caps)
                bounds = Bounds(0, 1)  # binary
                res = milp(c=-c, constraints=lc, bounds=bounds, integrality=np.ones(m, dtype=int))
                if not res.success:
                    raise ValueError("MILP failed")
                x = np.rint(res.x).astype(int)
                return int(x.sum())
            
            for N in range(2,9):
                print(N, max_edges_milp(N))
            
