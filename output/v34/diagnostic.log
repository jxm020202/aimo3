            def compute_triples(N):
                # returns list of (a,b,c) for r^i
                triples = [(1,0,0), (0,1,0), (0,0,1)]
                for i in range(3, N+1):
                    a3,b3,c3 = triples[i-3]
                    a1,b1,c1 = triples[i-1]
                    a2,b2,c2 = triples[i-2]
                    # r^i = 10 r^{i-3} - r^{i-1} - r^{i-2}
