            from math import gcd
            def find_seq(n):
                init = tuple(range(1,n+1))
                seen=set()
                from collections import deque
                q=deque()
                q.append((init, []))
                while q:
                    state, seq = q.popleft()
                    if sum(state)==0:
                        return seq
                    # generate moves
                    m=len(state)
                    for i in range(m):
                        if state[i]==0: continue
                        for j in range(i+1,m):
                            if state[j]==0: continue
                            g=gcd(state[i],state[j])
                            new=list(state)
                            new[i]-=g
                            new[j]-=g
                            newt=tuple(new)
                            if (newt, tuple(sorted(seq+[(i,j)]))) not in seen:
                                q.append((newt, seq+[(i,j)]))
                return None
            
            seq=find_seq(3)
            seq
            
