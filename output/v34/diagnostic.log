outdeg = {s: len(succ[s]) for s in succ}
q = deque(terminal)
while q:
    cur = q.popleft()
    for pre in pred[cur]:
        if pre in win:
            continue
        turn = pre[2]
        if turn == 1:               # Bob's turn – one good move suffices
            win.add(pre)
            q.append(pre)
        else:                        # Alice's turn – all moves must be good
            outdeg[pre] -= 1
            if outdeg[pre] == 0:
                win.add(pre)
                q.append(pre)

# count winning initial states (turn = Alice, a=b=-1)
winning_initial = 0
total_initial = 0
for dx in range(-2024,2025):
    for dy in range(-2024,2025):
        if dx==0 and dy==0:   # pieces cannot start on same cell
            continue
        total_initial += 1
        state = (dx,dy,0,-1,-1)
        if state in win:
            winning_initial += 1
```

