            def max_min_sum(m,n):
                N=m*n
                cells=[(i,j) for i in range(m) for j in range(n)]
                # edges list of pairs of indices
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx, (i+1)*n+j))
                        if j+1<n:
                            edges.append((idx, i*n+(j+1)))
                maxS=0
                best=None
                for perm in itertools.permutations(range(1,N+1)):
                    # assign numbers to cells in order of cells list
