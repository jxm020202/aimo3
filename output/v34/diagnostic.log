            def lp_lower_bound(N):
                vecs = compute_vectors(N)
                A = np.array([[v[0] for v in vecs],
                              [v[1] for v in vecs],
                              [v[2] for v in vecs]], dtype=object)
                target = sp.Matrix([2025,0,0])
                best = None
                best_set = None
                # consider subsets of size 1,2,3
                indices = list(range(N+1))
                # size 1
                for i in indices:
                    M = sp.Matrix(A[:,i])
                    # need M * x = target => only possible if target is multiple of M
                    # M is 3x1, rank 1. So target must be scalar * M, and scalar >=0.
                    # Check if M components are proportional to target.
                    # Since target has only first component nonzero, need M[1]=M[2]=0.
                    if A[1,i]==0 and A[2,i]==0 and A[0,i]!=0:
                        scalar = sp.Rational(2025, A[0,i])
                        if scalar >= 0:
                            total = scalar
                            if best is None or total < best:
                                best = total
                                best_set = (i,)
                # size 2
                for i in range(N+1):
                    for j in range(i+1, N+1):
                        M = sp.Matrix.hstack(sp.Matrix(A[:,i]), sp.Matrix(A[:,j]))
                        # Solve M * x = target
                        try:
                            sol = M.LUsolve(target)
                        except Exception:
                            continue
                        # Check if solution is real nonnegative
                        if all(val.is_real for val in sol):
                            # check nonnegative
                            if all(val >= 0 for val in sol):
                                total = sum(sol)
                                if best is None or total < best:
                                    best = total
                                    best_set = (i,j)
                # size 3
                for i in range(N+1):
                    for j in range(i+1, N+1):
                        for k in range(j+1, N+1):
                            M = sp.Matrix.hstack(sp.Matrix(A[:,i]), sp.Matrix(A[:,j]), sp.Matrix(A[:,k]))
                            # Solve M * x = target
                            try:
                                sol = M.LUsolve(target)
                            except Exception:
                                continue
                            if all(val.is_real for val in sol):
                                if all(val >= 0 for val in sol):
                                    total = sum(sol)
                                    if best is None or total < best:
                                        best = total
                                        best_set = (i,j,k)
                return best, best_set
            
            best, best_set = lp_lower_bound(30)
            best, best_set
            
