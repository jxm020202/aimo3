                # p_i: binary (row parity of A)
                # q_j: binary (col parity of A)
                # u_i: integer 0..9 (since sum a_ij up to 19)
                # w_j: integer 0..9
                # v_ij: integer 0..2
                # b_ij: binary (output bit)
                # We'll flatten variables in order: a (361), p (19), q (19), u (19), w (19), v (361), b (361)
                n_a = size
                n_p = N
                n_q = N
                n_u = N
