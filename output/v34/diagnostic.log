            def min_degree_sum(k, m=60, n=60):
                # assign k smallest numbers to cells with smallest degrees
                corner=4
                edge=2*(m-2)+2*(n-2)
                interior=m*n - corner - edge
                # list of degrees sorted ascending
                degs = [2]*corner + [3]*edge + [4]*interior
                degs.sort()
                return sum(degs[:k])
            
            def find_k_limit(m=60,n=60):
                N=m*n
                for k in range(1,N+1):
                    min_sum = min_degree_sum(k,m,n)
                    if min_sum > 4*(k+1):
                        return k, min_sum, 4*(k+1)
                return None
            
            print(find_k_limit())
            
