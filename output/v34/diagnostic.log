            import random, math, time
            
            def min_edge_sum(arr,m,n):
                mins=10**9
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        v=arr[idx]
                        if i+1<m:
                            mins=min(mins, v+arr[(i+1)*n+j])
                        if j+1<n:
                            mins=min(mins, v+arr[i*n+(j+1)])
                return mins
            
            def simulated_anneal(m,n,target,iterations=200000):
                N=m*n
                arr=list(range(1,N+1))
                random.shuffle(arr)
                cur=min_edge_sum(arr,m,n)
                best=cur
                best_arr=arr[:]
                T=1.0
                for it in range(iterations):
                    i,j=random.sample(range(N),2)
                    arr[i],arr[j]=arr[j],arr[i]
                    new=min_edge_sum(arr,m,n)
                    delta=new - cur
                    if delta>0 or random.random()<math.exp(delta/T):
                        cur=new
                        if cur>best:
                            best=cur
                            best_arr=arr[:]
                            #print("iter",it,"best",best)
                    else:
                        arr[i],arr[j]=arr[j],arr[i]  # revert
                    # cooling
                    T *= 0.99999
                    if best>=target:
                        return best_arr
                return None
            
            def find_target(m,n,target):
                for attempt in range(5):
                    res=simulated_anneal(m,n,target,iterations=200000)
                    if res:
                        print("found")
                        return True
                return False
            
