            from fractions import Fraction
            def generate_solutions(limit_q=10):
                sols = []
                for q in range(1, limit_q+1):
                    for p in range(-q, q+1):
                        t_frac = Fraction(p, q)
                        # compute r,s as Fractions
                        # r = 2*(1 - t^2)/(1 + t^2)
                        num_r = 2*(1 - t_frac**2)
                        den_r = 1 + t_frac**2
                        r = Fraction(num_r, den_r)
                        # s = 4 t / (1 + t^2)
                        s = Fraction(4*t_frac, 1 + t_frac**2)
                        # compute denominator for a expression
                        denom = 5*r**2 - 2
                        if denom == 0:
                            continue
                        # two possibilities
                        for sign in [1, -1]:
                            a = Fraction(r**2 + 2 + sign*2*r*s, denom)
                            # ensure a between 0 and 1 inclusive
                            if a <= 0 or a > 1:
                                continue
                            # compute x = (1 - a^2)/2
                            a2 = a*a
                            x = Fraction(1 - a2, 2)
                            if x <= 0 or x > Fraction(1,2):
                                continue
                            # compute r = b+1, so b = r - 1
                            b = r - 1
                            if b < 0:
                                continue
                            # compute y = (1 - b^2)/2
                            b2 = b*b
                            y = Fraction(1 - b2, 2)
                            if y <= 0 or y > Fraction(1,2):
                                continue
                            # verify original equation numerically
                            # compute original expression numeric to ensure correctness
                            # Use high precision
                            import mpmath as mp
                            mp.mp.dps = 30
                            xv = mp.mpf(x.numerator)/x.denominator
                            yv = mp.mpf(y.numerator)/y.denominator
                            lhs = 1 + mp.sqrt(1 - 2*yv)
                            # compute RHS using original formula
                            def original_rhs(xv):
                                t = mp.sqrt(1-2*xv)
                                term = (4*xv - 2 + 2*t) / (3 - 5*xv - t)
                                # cube sum
                                a1 = (1+xv**2)/2 + mp.sqrt(9*xv**4 + (4*xv**6)/3 + 9 + 18*xv**2)/6
                                b1 = (1+xv**2)/2 - mp.sqrt(9*xv**4 + (4*xv**6)/3 + 9 + 18*xv**2)/6
                                # real cube roots
                                def rc(z):
                                    if z >= 0:
                                        return z**(1/3)
                                    else:
                                        return -((-z)**(1/3))
                                cs = rc(a1) + rc(b1)
                                return term + cs
                            rhs = yv + original_rhs(xv)
                            if abs(lhs - rhs) > 1e-10:
                                continue
                            # compute k = lcm of denominators
                            k = sp.ilcm(x.denominator, y.denominator)
                            sols.append((x, y, k, t_frac, sign))
                return sols
            
            sols = generate_solutions(20)
            len(sols)
            
