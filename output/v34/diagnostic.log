            def bob_can_capture(N, wx,wy,bx,by, max_steps=200):
                # simple greedy strategy for Bob: each turn, move towards white if possible respecting alternation.
                # We'll simulate with deterministic rule: Bob chooses a move that reduces Manhattan distance if possible,
                # respecting required direction; else any allowed move.
                # Alice will try to maximize distance (choose move that increases distance if possible).
                # This is not optimal but we test capture.
                w_req=0
                b_req=0
                turn=0 # 0 Alice, 1 Bob
                for step in range(max_steps):
                    if (wx,wy)==(bx,by):
                        # capture after Bob's move only; if occurs on Alice turn, treat as not captured
                        if turn==1:
                            return True
                        else:
                            # continue
                            pass
                    if turn==0:
                        # Alice move: choose move that maximizes distance, respecting w_req
                        dirs = [(-1,0),(1,0)] if w_req==1 else [(0,-1),(0,1)] if w_req==2 else [(-1,0),(1,0),(0,-1),(0,1)]
                        best=None
                        bestd=-1
                        for dx,dy in dirs:
                            nx,ny=wx+dx,wy+dy
                            if 1<=nx<=N and 1<=ny<=N:
                                d=abs(nx-bx)+abs(ny-by)
                                if d>bestd:
                                    bestd=d; best=(nx,ny,dx,dy)
                        if best is None:
                            return False
                        wx,wy,bestdx,bestdy=best[0],best[1],best[2],best[3]
                        w_req = 2 if (bestdx,bestdy) in [(-1,0),(1,0)] else 1
                    else:
                        # Bob move: try to capture
                        dirs = [(-1,0),(1,0)] if b_req==1 else [(0,-1),(0,1)] if b_req==2 else [(-1,0),(1,0),(0,-1),(0,1)]
                        # first check capture
                        for dx,dy in dirs:
                            nx,ny=bx+dx,by+dy
                            if 1<=nx<=N and 1<=ny<=N and (nx,ny)==(wx,wy):
                                return True
                        # else move to reduce distance
                        best=None
                        bestd=math.inf
                        for dx,dy in dirs:
                            nx,ny=bx+dx,by+dy
