            def compute_vectors(n):
                # returns list of triples for r^i expressed as a + b r + c r^2
                a=[0]*(n+1)
                b=[0]*(n+1)
                c=[0]*(n+1)
                # base
                a[0]=1; b[0]=0; c[0]=0
                a[1]=0; b[1]=1; c[1]=0
                a[2]=0; b[2]=0; c[2]=1
                for i in range(0,n-2):
                    # recurrence: r^{i+3} = 10 r^{i} - r^{i+2} - r^{i+1}
                    a[i+3] = 10*a[i] - a[i+2] - a[i+1]
                    b[i+3] = 10*b[i] - b[i+2] - b[i+1]
                    c[i+3] = 10*c[i] - c[i+2] - c[i+1]
                return list(zip(a,b,c))
            
            vectors = compute_vectors(20)
            vectors[:10]
            
