                            if b_last!=-1 and dir_type==b_last:
                                continue
                            nx,ny = bx+dx, by+dy
                            if 0<=nx<n and 0<=ny<n:
                                allowed.append((nx,ny,dir_type))
                        for nx,ny,dir_type in allowed:
                            if nx==wx and ny==wy:
