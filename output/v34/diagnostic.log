            def smallest_odd_prime_divisor_of_Mminus1_plus_c(c):
                # search odd primes starting from 3
                for p in sp.primerange(3, 100000):  # limit maybe 100k
                    # compute M mod p
                    # exponent = 2025! mod (p-1)
                    mod = p-1
