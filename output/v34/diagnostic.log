        ```python
import itertools
import numpy as np
from math import inf

# Board size
n = 13
# Generate list of squares as (r,c) with 0-indexed for convenience
squares = [(r, c) for r in range(n) for c in range(n)]

# Pre‑compute the two diagonal identifiers for each square
# d1 = r - c  (NW‑SE), range -(n-1) .. (n-1)
# d2 = r + c  (NE‑SW), range 0 .. 2*(n-1)
diag1 = {}
diag2 = {}
for r, c in squares:
    diag1[(r, c)] = r - c
    diag2[(r, c)] = r + c

# For each square, compute the set of squares it *covers* (its two diagonals)
covers = {}
for sq in squares:
    d1 = diag1[sq]
    d2 = diag2[sq]
    covered = [other for other in squares if diag1[other] == d1 or diag2[other] == d2]
    covers[sq] = covered

# Build a binary integer programming model using scipy.optimize.milp
# Variables: x_s ∈ {0,1} for each square s (1 if marked)
# Constraints: for every board square t, sum_{s covering t} x_s ≥ 1
# Objective: minimize sum x_s

# Prepare data for milp
num_vars = len(squares)
c = np.ones(num_vars)                     # objective coefficients (minimize total marks)

# Build constraint matrix A and RHS b
A = np.zeros((len(squares), num_vars), dtype=int)
b = np.ones(len(squares), dtype=int)      # each square must be covered at least once

# Map square index
idx = {sq: i for i, sq in enumerate(squares)}

for t_idx, t in enumerate(squares):
    for s in covers[t]:
        A[t_idx, idx[s]] = 1

# Bounds: each variable between 0 and 1, integer
from scipy.optimize import milp, LinearConstraint, Bounds

lin_con = LinearConstraint(A, lb=b, ub=np.full_like(b, np.inf))
bounds = Bounds(0, 1)

res = milp(c=c,
           constraints=[lin_con],
           bounds=bounds,
           integrality=np.ones(num_vars, dtype=int),
           options={"presolve": True, "disp": False})

print("Optimization success:", res.success)
print("Minimum number of marked squares:", int(res.fun))
# Retrieve a solution (one optimal set)
solution = np.round(res.x).astype(int)
marked = [squares[i] for i, val in enumerate(solution) if val == 1]
print("Marked squares (row, col) 0‑indexed:", marked)
