            def solve_closed(N):
                # N odd
                # x_0 = x_N = 0
                # equations for i=1..N:
                # odd i: x_{i-1}+x_i = 2
                # even i: x_{i-1}+x_i = 4
                # Solve recurrence.
                x = {}
