            def pretty_pairs_via_congruence(alpha,k,limit):
                res=set()
                for m in range(1,limit+1):
                    a=math.floor(m*alpha)
                    g=math.gcd(a,m)
                    if (m - k) % g != 0:
                        continue
                    # solve n a ≡ m - k (mod m)
                    # find one solution n0 modulo m/g
                    mod=m//g
                    # reduce equation: (a/g) n ≡ (m - k)/g (mod m/g)
                    a_red=a//g
                    rhs=(m - k)//g % mod
                    # find modular inverse of a_red modulo mod (if coprime)
                    if math.gcd(a_red, mod)!=1:
                        # should be coprime by construction
                        continue
                    inv=pow(a_red,-1,mod)
                    n0=(inv*rhs)%mod
                    # all solutions: n = n0 + t*mod for t>=0
                    # need n positive and also satisfy other constraints? Let's generate few
                    for t in range(0,10):
                        n=n0 + t*mod
                        if n<=0:
                            continue
                        if m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k:
                            res.add((m,n))
                return res
            
