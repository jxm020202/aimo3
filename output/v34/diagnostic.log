            def minimize_k(initial_k):
                # initial_k is dict index->count
                k = collections.defaultdict(int, initial_k)
                changed = True
                while True:
                    # find any i with k[i] >= 10
                    i = next((idx for idx, cnt in sorted(k.items()) if cnt >= 10), None)
                    if i is None:
                        break
                    # perform replacement
                    times = k[i] // 10  # number of groups of 10 we can replace
                    # we can replace all groups at once
                    k[i] -= times*10
                    k[i+1] += times
                    k[i+2] += times
                    k[i+3] += times
                # convert to normal dict
                return dict(k)
            
