            def construct_grid(m=60,n=60):
                # color cells black/white like chessboard: (i+j)%2==0 black
                black_cells = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==0]
                white_cells = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==1]
                # compute degree (number of neighbors) for each cell
                def degree(cell):
                    i,j = cell
                    deg = 0
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj = i+di, j+dj
                        if 0<=ni<m and 0<=nj<n:
                            deg+=1
                    return deg
                # sort black cells by degree ascending (corners first)
                black_cells_sorted = sorted(black_cells, key=lambda c: degree(c))
                # assign smallest numbers to low-degree cells
                black_values = {}
                for idx,cell in enumerate(black_cells_sorted):
                    black_values[cell] = idx+1  # numbers 1..len(black_cells)
                # compute lower bounds for each white cell
                lower_bounds = {}
                for w in white_cells:
                    i,j = w
                    max_req = -1
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj = i+di, j+dj
                        if 0<=ni<m and 0<=nj<n:
                            if (ni+nj)%2==0: # black neighbor
                                k = black_values[(ni,nj)]
                                req = 3600 - k
                                if req > max_req:
                                    max_req = req
                    lower_bounds[w] = max_req
                # now assign numbers to white cells greedily
                # available numbers 1801..3600
                available = list(range(1801,3601))
                # sort white cells by lower bound descending
                white_sorted = sorted(white_cells, key=lambda c: lower_bounds[c], reverse=True)
                white_values = {}
                for w in white_sorted:
                    lb = lower_bounds[w]
                    # find smallest available number >= lb
                    # Since we are assigning from largest to smallest, we can pop from end
                    # Let's find index using binary search
                    import bisect
                    i = bisect.bisect_left(available, lb)
                    if i == len(available):
                        # no number large enough
                        return False, None
                    # assign the smallest sufficient number (to preserve larger for others)
                    val = available[i]
                    white_values[w] = val
                    del available[i]
                # success
                return True, (black_values, white_values)
            
