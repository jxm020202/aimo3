                edges = []
                # We'll iteratively connect the vertex with highest remaining cap to others with positive caps
                while True:
                    # find vertex with max cap >0
                    max_cap = max(caps)
                    if max_cap == 0:
                        break
                    v = caps.index(max_cap)  # first occurrence
                    # need to connect v to max_cap other vertices with positive caps (excluding itself)
                    # choose vertices with highest caps (excluding v)
                    # sort other vertices by caps descending
                    others = [(c,i) for i,c in enumerate(caps) if i!=v and c>0]
                    others.sort(reverse=True)
                    # need exactly max_cap connections; if not enough others, break
                    if len(others) < max_cap:
                        # cannot fulfill
                        break
                    for _, u in others[:max_cap]:
                        # add edge (v,u)
                        edges.append((v,u))
                        caps[v] -= 1
                        caps[u] -= 1
                    # continue loop
                return caps, edges
            
            def max_edges_greedy(N):
                caps, edges = greedy_complete(N)
                return len(edges)
            
            for N in range(2,11):
                print(N, max_edges_greedy(N))
            
