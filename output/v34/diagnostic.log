            import math, sys, itertools, functools, sympy as sp
            
            def residues(n, K):
                # compute r_k = - sum_{i=1}^{k-1} i! * i^{n-1} mod k!
                res = []
                for k in range(1, K+1):
                    mod = math.factorial(k)
                    s = sum(math.factorial(i) * (i**(n-1)) for i in range(1, k))
                    r = (-s) % mod
                    res.append(r)
                return res
            
            def compute_a(n, K):
                # compute a modulo K! using incremental method
                a = 0
                for k in range(1, K+1):
                    mod = math.factorial(k)
                    # target residue
                    target = (-sum(math.factorial(i) * (i**(n-1)) for i in range(1, k+1))) % mod
                    # we have a currently satisfying modulo (k-1)!
                    # adjust
                    # compute current a modulo mod
                    a_mod = a % mod
                    # need to add t*(k-1)! to reach target
                    step = math.factorial(k-1)
                    # solve a_mod + t*step ≡ target (mod mod)
                    # divide by step: (a_mod//step) + t ≡ target//step (mod k)
                    q = (a_mod // step) % k
                    target_q = (target // step) % k
                    t = (target_q - q) % k
                    a = a + t*step
                return a
            
            for n in range(1,10):
                res = residues(n, 8)
                print(n, res[-1])
            
