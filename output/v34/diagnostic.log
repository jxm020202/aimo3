            def upper_bound(m,n):
                N=m*n
                # compute degree distribution
                deg_counts={2:0,3:0,4:0}
                for i in range(m):
                    for j in range(n):
                        deg=4
                        if i==0 or i==m-1: deg-=1
                        if j==0 or j==n-1: deg-=1
                        deg_counts[deg]+=1
                # assign largest numbers to higher degree
                values= list(range(1,N+1))
                values_desc=sorted(values, reverse=True)
                idx=0
                total=0
                for deg in [4,3,2]:
                    cnt=deg_counts[deg]
                    for _ in range(cnt):
                        total+=values_desc[idx]*deg
                        idx+=1
                E = (m-1)*n + m*(n-1)
                return total/E
            
