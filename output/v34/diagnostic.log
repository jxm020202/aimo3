            def cube_sum_real(x):
                # compute using real cube root of real numbers (mp.nthroot returns principal root, which for negative yields complex? Actually nthroot for negative may give complex)
                # Use mp.sign to get real cube root: mp.sign(z)*abs(z)**(1/3)
                a = (1+x**2)/2 + mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)/6
                b = (1+x**2)/2 - mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)/6
                # real cube root:
                def real_cuberoot(z):
                    if z >= 0:
                        return z**(1/3)
                    else:
                        return -((-z)**(1/3))
                return real_cuberoot(a) + real_cuberoot(b)
            
