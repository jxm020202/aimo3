            import mpmath as mp
            
            def cube_sum(x):
                A = (1 + x**2)/2
                B = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)/6
                # real cube roots: mp.sign? Use mp.nthroot? We'll just use mp.sign to get real root.
                # mp.nthroot returns principal root (complex). For real numbers, we can use mp.sign*abs**(1/3)
                def real_cuberoot(z):
                    if z >= 0:
                        return z**(1/3)
                    else:
                        return -((-z)**(1/3))
                return real_cuberoot(A + B) + real_cuberoot(A - B)
            
            for val in [0, 0.1, 0.2, 0.25, 0.3, 0.4, 0.5]:
                print(val, cube_sum(val))
            
