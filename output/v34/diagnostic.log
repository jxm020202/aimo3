                target = (1<<(rows*cols))-1
                # BFS
                seen = {initial_state}
                q = collections.deque([initial_state])
                while q:
                    s = q.popleft()
                    if s == target:
                        return True
                    for ns in neighbors(s, rows, cols):
                        if ns not in seen:
                            seen.add(ns)
                            q.append(ns)
                return False
            
