            def possible_values_at_target(N,M,target):
                # target is (tx,ty)
                values_set=set()
                max_val= (N+M)*2+5  # rough bound
                # recursion
                assigned={}
                # order of cells to assign: row-major
                cells=[(i,j) for i in range(N+1) for j in range(M+1)]
                # ensure (0,0)=0
                assigned[(0,0)]=0
                # start index after (0,0)
                start_idx=1 if cells[0]==(0,0) else 0
                def is_consecutive(triple):
                    a,b,c=triple
                    s=sorted([a,b,c])
                    return s[0]+1==s[1] and s[1]+1==s[2]
                def check_triangle(x,y):
                    # triangle anchored at (x,y)
                    if (x,y) in assigned and (x,y+1) in assigned and (x+1,y) in assigned:
                        if not is_consecutive([assigned[(x,y)],assigned[(x,y+1)],assigned[(x+1,y)]]):
                            return False
                    return True
                def recurse(idx):
                    if idx==len(cells):
                        # all assigned
                        values_set.add(assigned[target])
                        return
                    cell=cells[idx]
                    if cell in assigned:
                        recurse(idx+1)
                        return
                    # possible values range
                    for val in range(0, max_val+1):
                        # assign
                        assigned[cell]=val
                        # check affected triangles
                        x,y=cell
                        ok=True
                        # triangles anchored at (x,y), (x-1,y), (x,y-1)
                        for (a,b) in [(x,y),(x-1,y),(x,y-1)]:
                            if a>=0 and b>=0 and a<N and b<M:
                                if not check_triangle(a,b):
                                    ok=False
                                    break
                        if ok:
                            recurse(idx+1)
                        del assigned[cell]
                recurse(start_idx)
                return values_set
            
