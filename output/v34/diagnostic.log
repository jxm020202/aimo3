            def random_point_on_sphere():
                # generate random normal vector and normalize to sqrt(3)
                v = np.random.normal(size=3)
                v = v / np.linalg.norm(v) * math.sqrt(3)
                return v
            
            def find_close(num_samples=100000, tol=1e-6):
                close = []
                for _ in range(num_samples):
                    x,y,z = random_point_on_sphere()
                    s2 = x*y**3 + y*z**3 + z*x**3
                    if abs(s2 - 3) < tol:
