            import itertools
            
            def count_outstanding_grid(mat):
                R=len(mat)
                C=len(mat[0])
                cnt=0
                for r1 in range(R):
                    for r2 in range(r1,R):
                        for c1 in range(C):
                            for c2 in range(c1,C):
                                # rectangle rows r1..r2, cols c1..c2
                                # find min inside
                                min_inside = min(mat[i][j] for i in range(r1,r2+1) for j in range(c1,c2+1))
                                ok=True
                                # iterate over cells outside that share a vertex with rectangle
                                # cells (i,j) not in rectangle but such that max(|i - [r1..r2]|, |j - [c1..c2]|) == 1?
                                # Actually share a vertex means they are adjacent orthogonal or diagonal.
                                # So cells with row in [r1-1, r2+1] and col in [c1-1, c2+1] but not inside rectangle.
                                for i in range(r1-1, r2+2):
                                    for j in range(c1-1, c2+2):
                                        if 0 <= i < R and 0 <= j < C:
                                            if not (r1 <= i <= r2 and c1 <= j <= c2):
                                                # shares a vertex if i in [r1-1,r2+1] and j in [c1-1,c2+1] and not inside.
                                                # Already iterating that region.
                                                # Condition: cell must be adjacent (touch) rectangle: any cell in that region qualifies.
                                                # So we check condition.
                                                if mat[i][j] >= min_inside:
                                                    ok=False
                                                    break
                                    if not ok:
                                        break
                                if ok:
                                    cnt+=1
                return cnt
            
            def max_outstanding_grid(R,C):
                n=R*C
                maxc=0
                best=None
                # use numbers 1..n
                for perm in itertools.permutations(range(1,n+1)):
                    mat=[list(perm[i*C:(i+1)*C]) for i in range(R)]
                    c=count_outstanding_grid(mat)
                    if c>maxc:
                        maxc=c
                        best=mat
                return maxc,best
            
