            import math
            
            def f_formula(n):
                if n%2==0:
                    return n+1
                else:
                    m = (n-1)//2
                    return 4*m*(m+1)/(n) + 1
            
            def f_bruteforce(n):
                # brute over all +-1 combos (2^n) only for small n
                best = -1
                from itertools import product
                for bits in product([-1,1], repeat=n):
                    S = sum(bits)
                    total = sum(abs((S - a)/n - a) for a in bits)
                    if total>best:
