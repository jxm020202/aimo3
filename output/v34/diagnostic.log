                norm_LX = sp.sqrt(sp.simplify(LX.dot(LX)))
                cos_angle = sp.simplify(dot/(norm_LT*norm_LX))
                angle = sp.acos(cos_angle)
                # simplify angle in degrees
                angle_deg = sp.N(angle*180/sp.pi)
                return float(angle_deg), sp.simplify(cos_angle), L_pt, T, R_pt
            
