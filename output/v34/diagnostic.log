            def valid(seq):
                # seq is list of positive ints, starting from a1
                L = len(seq)
                for n in range(1, L+1):
                    a_n = seq[n-1]
                    for k in range(1, L - n + 2):  # k from 1 to L-n+1 inclusive
                        s = sum(seq[k-1:k+n-1])
                        if s % a_n != 0:
                            return False
                return True
            
            def max_a_n(L, bound=64):
                # brute force search for sequences length L, a_i <= bound
                max_val = 0
                best_seq = None
                # we can generate recursively to prune early
                def backtrack(prefix):
                    nonlocal max_val, best_seq
                    i = len(prefix)
                    if i == L:
                        # full sequence
                        a_n = prefix[-1]
                        if a_n > max_val:
                            max_val = a_n
                            best_seq = prefix[:]
                        return
                    # Determine possible values for next term a_{i+1}
                    # Must be positive integer
                    # Upper bound maybe bound
                    for val in range(1, bound+1):
                        new_seq = prefix + [val]
                        # check constraints that involve only indices up to i+1
                        # For each n <= i+1, need to check all k where block fully within new_seq
                        ok = True
                        for n in range(1, i+2):
                            a_n = new_seq[n-1]
                            # check blocks where k+n-1 <= i+1
                            for k in range(1, i+2 - n + 1):
                                s = sum(new_seq[k-1:k+n-1])
                                if s % a_n != 0:
                                    ok = False
                                    break
                            if not ok:
                                break
                        if ok:
                            backtrack(new_seq)
                # start with a1=1 forced
                backtrack([1])
                return max_val, best_seq
            
