import math
import numpy as np

# Define the curve points
def d_value(x, branch):
    """
    Compute d for a given x and branch (+1 for upper, -1 for lower)
    """
    # y = |x| + branch * sqrt(1 - x**2)
    y = abs(x) + branch * math.sqrt(max(0.0, 1 - x*x))
    # distances to nearest vertical side (x = +/-2)
    dv = 2 - abs(x)          # distance to nearest vertical side
    # distances to nearest horizontal sides (y = +/- (1+sqrt(2)))
    top = (1 + math.sqrt(2)) - y
    bottom = y + 1 + math.sqrt(2)
    dh = min(top, bottom)    # distance to nearest horizontal side
    return min(dv, dh)

# Sample many points on the curve to see the range of possible d
xs = np.linspace(-1, 1, 20001)
d_vals = []
for x in xs:
    # upper branch
    d_vals.append(d_value(x, +1))
    # lower branch
    d_vals.append(d_value(x, -1))

d_min = min(d_vals)
d_max = max(d_vals)
d_min, d_max
