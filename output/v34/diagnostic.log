            def generate_assignment():
                n=60
                # compute degree for each cell
                deg = np.full((n,n), 4, dtype=int)
                deg[0,:] = 3
                deg[-1,:] = 3
                deg[:,0] = 3
                deg[:,-1] = 3
                deg[0,0] = deg[0,-1] = deg[-1,0] = deg[-1,-1] = 2
                # flatten indices
                indices = [(i,j) for i in range(n) for j in range(n)]
                # sort by degree descending
                indices.sort(key=lambda ij: deg[ij[0], ij[1]], reverse=True)
                # assign numbers descending (largest first) to highest degree
                numbers = list(range(1, n*n+1))
                # assign largest to first in list
                assignment = np.empty((n,n), dtype=int)
                for idx, (i,j) in enumerate(indices):
                    # assign largest remaining number
                    assignment[i,j] = numbers[-1-idx]  # largest first
                return assignment
            
