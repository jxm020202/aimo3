            def generate_assignment():
                m=n=60
                # compute degree for each cell
                deg = np.zeros((m,n), dtype=int)
                for i in range(m):
                    for j in range(n):
                        d=0
                        if i>0: d+=1
                        if i<m-1: d+=1
                        if j>0: d+=1
                        if j<n-1: d+=1
                        deg[i,j]=d
                # flatten cells with degree
                cells = [(deg[i,j], i, j) for i in range(m) for j in range(n)]
                # sort by degree descending (largest degree first)
                cells.sort(key=lambda x: -x[0])
                # assign largest numbers to highest degree
                assignment = np.zeros((m,n), dtype=int)
                for idx, (_, i, j) in enumerate(cells):
                    assignment[i,j] = 3600 - idx  # largest first
                return assignment
            
