            def covering_radius_formula(n):
                # using derived formula
                max_min=0
                best=None
                for a in range(0,n):
                    for b in range(0,n):
                        # a = sum_r (0..n-1)
                        # b = sum_c
                        # compute minimal max over p
                        best_val=n+1
                        for p in [0,1]:
                            rows = a if p==0 else n - a
                            q = (p + a + b) % 2
                            cols = b if q==0 else n - b
                            val = max(rows, cols)
                            if val < best_val:
                                best_val = val
                        if best_val > max_min:
                            max_min = best_val
                            best = (a,b)
