            def cool_minimal(m,n,alpha):
                # reduce until cannot reduce further
                while True:
                    if m>n and is_pretty(m-n,n,alpha):
                        m = m-n
                        continue
                    if n>m and is_pretty(m,n-m,alpha):
                        n = n-m
                        continue
                    break
                return (m,n)
            
            def all_cool(k_val, alpha, bound):
                global k
                k = k_val
                pretty=set()
                for m in range(1,bound+1):
                    floor_m=math.floor(m*alpha)
                    for n in range(1,bound+1):
                        if m*math.ceil(n*alpha)-n*floor_m==k:
                            pretty.add((m,n))
                cool=set()
                for (m,n) in pretty:
                    cool.add(cool_minimal(m,n,alpha))
                return cool
            
