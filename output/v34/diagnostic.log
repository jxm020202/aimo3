            def max_points(n):
                # variables: n*n binary
                N = n*n
                c = -np.ones(N)  # maximize sum -> minimize negative
                # bounds 0/1
                bounds = opt.Bounds(0,1)
                integrality = np.ones(N, dtype=int)
                # constraints: for each pair of rows y1<y2, for each pair of columns (x1,x2) from row y1 and (x3,x4) from row y2 such that x1+x4 == x2+x3
                # we need sum <=3
                A = []
                b = []
                for y1 in range(n):
                    for y2 in range(y1+1,n):
                        # enumerate x1,x2 distinct? Not required; they could be same? For trapezoid need distinct points, so x1!=x2 and x3!=x4, also points distinct.
                        # We'll enforce x1!=x2 and x3!=x4 to avoid degenerate.
                        for x1 in range(n):
                            for x2 in range(n):
                                if x1==x2: continue
                                for x3 in range(n):
                                    for x4 in range(n):
                                        if x3==x4: continue
                                        if x1 + x4 == x2 + x3:
                                            # indices
                                            idx1 = y1*n + x1
                                            idx2 = y1*n + x2
                                            idx3 = y2*n + x3
                                            idx4 = y2*n + x4
                                            row = np.zeros(N)
                                            row[idx1]=1
                                            row[idx2]=1
                                            row[idx3]=1
                                            row[idx4]=1
                                            A.append(row)
                                            b.append(3)
                A = np.array(A)
                b = np.array(b)
                # Use milp
                res = opt.milp(c, constraints=opt.LinearConstraint(A, -np.inf, b), bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    print("failed", res.message)
                    return None
                val = -res.fun
                return int(round(val))
            
