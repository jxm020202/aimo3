            import itertools
            
            def count_outstanding(grid):
                m=len(grid)
                n=len(grid[0])
                count=0
                for r1 in range(m):
                    for r2 in range(r1,m):
                        for c1 in range(n):
                            for c2 in range(c1,n):
                                # rectangle S rows r1..r2, cols c1..c2
                                # collect cells inside
                                inside = [(i,j) for i in range(r1,r2+1) for j in range(c1,c2+1)]
                                # collect outside cells that share a vertex with S
                                outside=set()
                                for i in range(r1-1,r2+2):
                                    for j in range(c1-1,c2+2):
                                        if 0<=i<m and 0<=j<n:
                                            if not (r1<=i<=r2 and c1<=j<=c2):
                                                # check if shares a vertex: distance max(|i - r|, |j - c|) <=1 for some cell in S?
                                                # Actually sharing a vertex means that the cell is adjacent (including diagonal) to some cell in S.
                                                # Equivalent to Chebyshev distance between cell and rectangle <=1
                                                # So any cell outside but within one step of rectangle.
                                                # Our loop already includes those cells.
                                                outside.add((i,j))
                                # condition: each inside cell value > each outside cell value
                                ok=True
                                for (i,j) in inside:
                                    for (p,q) in outside:
                                        if grid[i][j] <= grid[p][q]:
                                            ok=False
                                            break
                                    if not ok:
                                        break
                                if ok:
                                    count+=1
                return count
            
            def max_outstanding(m,n):
                maxc=0
                best=None
                vals=list(range(1,m*n+1))
                for perm in itertools.permutations(vals):
                    grid=[list(perm[i*n:(i+1)*n]) for i in range(m)]
                    c=count_outstanding(grid)
                    if c>maxc:
                        maxc=c
                        best=grid
                return maxc,best
            
