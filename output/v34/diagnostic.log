            def test(k):
                x=sp.symbols('x')
                G=sp.prod([x**2 - i for i in range(1,k+1)])
                B=1 + x + x**2
                A=B + x**2
                P=sp.expand(G*A)
                Q=sp.expand(G*B)
                # check coefficients
                coeffsP=[sp.expand(P).coeff(x,i) for i in range(0,2*k+2+1)] # degree up to 2k+2
                coeffsQ=[sp.expand(Q).coeff(x,i) for i in range(0,2*k+2+1)]
                zeroP=any(c==0 for c in coeffsP)
                zeroQ=any(c==0 for c in coeffsQ)
                return zeroP, zeroQ, G.as_poly().degree(), P.as_poly().degree(), Q.as_poly().degree()
            
