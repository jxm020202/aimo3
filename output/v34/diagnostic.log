            import math
            
            def compute_a0_mod_fact(n, max_k):
                # compute a0 modulo max_k! satisfying conditions up to max_k
                a0_mod = 0
                modulus = 1
                for k in range(1, max_k+1):
                    modulus *= k  # k!
                    # compute sum_{i=1}^{k} i! * i^{n-1}
                    s = sum(math.factorial(i) * (i**(n-1)) for i in range(1, k+1))
                    # need a0 ≡ -s (mod k!)
                    target = (-s) % modulus
                    # a0_mod currently satisfies previous mod (k-1)!; need to adjust to meet new modulus
                    # Since modulus is multiple of previous, we can just set a0_mod = target (as they are consistent)
                    a0_mod = target
                return a0_mod, modulus
            
            def test_sequence(n, a0, max_k):
                a = a0
                for k in range(1, max_k+1):
                    if a % k != 0:
                        return False, k, a
                    a = a // k + k**(n-1)
                return True, None, a
            
            for n in range(1, 11):
                a0_mod, mod = compute_a0_mod_fact(n, 7)
                # take a0 as that residue (non-negative)
                ok, fail_k, _ = test_sequence(n, a0_mod, 10)
                print(n, a0_mod, ok, fail_k)
            
