            import math
            
            def count_cool_fast(alpha, k, m_max):
                total = 0
                for m in range(1, m_max+1):
                    a = math.floor(m*alpha)
                    u = m*alpha - a
                    d = math.gcd(a, m)
                    if k % d != 0:
                        continue
                    step = m // d
                    # find a particular solution n0 to a*n ≡ -k (mod m)
                    # Solve a/d * n ≡ -k/d (mod m/d)
                    a1 = a // d
                    mod = step
                    rhs = (-k//d) % mod
                    # find modular inverse of a1 mod mod
                    # Since gcd(a1, mod)=1
                    inv = pow(a1, -1, mod)  # Python 3.8+ supports
                    n0 = (rhs * inv) % mod
                    # n = n0 + t*step, for integer t
                    # need n > m (since we are in case n>m)
                    # also need n in interval ( m + (k - m)/u , k / u ]
                    lower = m + (k - m)/u
                    upper = k / u
                    # find smallest t such that n >= lower+epsilon
                    # compute minimal n >= lower+epsilon
                    # n = n0 + t*step
                    if step == 0:
                        continue
                    # compute t_min
                    t_min = math.ceil((lower - n0 + 1e-12) / step)  # ensure > lower
                    n_start = n0 + t_min*step
                    if n_start <= upper + 1e-12:
                        count = math.floor((upper - n_start) / step) + 1
                        total += count
                return total
            
            alpha = math.sqrt(2)
            k = 2310
            print(count_cool_fast(alpha, k, 2000))
            
