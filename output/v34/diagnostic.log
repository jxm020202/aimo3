                                    row = np.zeros(var_count)
                                    row[i*N + k] = 1
                                    row[j*N + l] = 1
                                    A_ub.append(row)
                                    b_ub.append(1)
                    # convert to scipy format
                    A_eq = np.array(A_eq)
                    b_eq = np.array(b_eq)
                    A_ub = np.array(A_ub) if A_ub else None
                    b_ub = np.array(b_ub) if b_ub else None
                    bounds = Bounds(0,1)
                    # integer constraints: integrality vector of ones
                    integrality = np.ones(var_count, dtype=int)
                    # solve
                    res = milp(c=np.zeros(var_count), constraints=[
                        LinearConstraint(A_eq, b_eq, b_eq),
                        LinearConstraint(A_ub, -np.inf*np.ones_like(b_ub), b_ub) if A_ub is not None else None
                    ], bounds=bounds, integrality=integrality, options={"presolve": True, "disp": False})
                    return res.success
                # binary search S from 2 to 2N (max possible sum)
                lo, hi = 2, 2*N
                best = 0
                while lo <= hi:
                    mid = (lo+hi)//2
                    print("checking",mid)
                    if feasible(mid):
                        best = mid
                        lo = mid+1
                    else:
                        hi = mid-1
                return best
            
