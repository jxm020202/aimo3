                # returns tuple of residues for each cell in order
                # compute pattern values for (i,j) as (i+2j) mod3 and (2i+j) mod3
                pat1 = {}
                pat2 = {}
                for (i,j),val in assign.items():
                    pat1[(i,j)] = (i + 2*j) % 3
                    pat2[(i,j)] = (2*i + j) % 3
                # compare assign residues
                res = { (i,j): assign[(i,j)]%3 for (i,j) in assign}
                # check if matches pat1 or pat2
                if all(res[(i,j)] == pat1[(i,j)] for (i,j) in assign):
                    return 1
                elif all(res[(i,j)] == pat2[(i,j)] for (i,j) in assign):
                    return 2
                else:
                    return 0
            
