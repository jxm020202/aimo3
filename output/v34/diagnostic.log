                            if ns in idx:
                                ns_idx = idx[ns]
                                successors[s_idx].append(ns_idx)
                                predecessors[ns_idx].append(s_idx)
                # Now compute winning set for Bob using attractor algorithm.
                # We'll maintain status: 0 unknown, 1 winning for Bob, -1 losing for Bob (i.e., Alice can avoid)
                status = [0]*N
                # Queue for propagation
                from collections import deque
                q = deque()
                # Initialize: states where Bob can capture immediately are winning for Bob.
                for s_idx in capture_moves:
                    status[s_idx] = 1
                    q.append(s_idx)
                # Also need to handle that after capture game ends; no further moves needed.
                # Propagation:
                while q:
                    cur = q.popleft()
                    cur_status = status[cur]
                    # For each predecessor
                    for pre in predecessors[cur]:
                        if status[pre]!=0:
                            continue
                        wx,wy,bx,by,turn,w_last,b_last = states[pre]
                        if turn==1:  # Bob's turn: if any successor is winning for Bob, then pre is winning for Bob.
                            # Since cur is a successor that is winning, pre becomes winning.
                            status[pre] = 1
                            q.append(pre)
                        else:  # Alice's turn: if all successors are winning for Bob, then pre is winning for Bob.
                            # Need to check if all successors are already marked winning.
                            all_win = True
                            for succ in successors[pre]:
                                if status[succ]!=1:
                                    all_win = False
                                    break
                            if all_win:
                                status[pre] = 1
                                q.append(pre)
                # After propagation, remaining unknown states are losing for Bob (Alice can avoid capture)
                for i in range(N):
                    if status[i]==0:
                        status[i] = -1
