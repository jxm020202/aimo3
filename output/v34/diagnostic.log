            def path_config(n):
                # simple monotone path from (0,0) to (n-1,n-1) using right and down moves
                cells=[]
                i=j=0
                cells.append((i,j))
                while i < n-1 or j < n-1:
                    if i < n-1:
                        i+=1
                    cells.append((i,j))
                    if j < n-1:
                        j+=1
                    cells.append((i,j))
                # This may duplicate; let's just generate a path with 2n-2 cells: all cells on first row and first column except (0,0) counted once?
                # Actually path: go right across top row (n cells), then down last column (n-1 cells) gives 2n-1 cells, too many.
                # Let's instead take all cells on first row except last, plus all cells on last column except first: that's 2n-2.
                cells = [(0,j) for j in range(n-1)] + [(i,n-1) for i in range(1,n-1)]
                # This is L shape.
                s=0
                for (i,j) in cells:
                    s |= (1 << (i*n + j))
                return s, cells
            
