                # N inclusive max coordinate for both x,y
                points = [(x,y) for x in range(N+1) for y in range(N+1)]
                # order of assignment: maybe row-major
                order = sorted(points, key=lambda p: (p[0]+p[1], p[0], p[1]))
                # but ensure (0,0) first
                # We'll backtrack
                solutions = []
                max_solutions = 1000
                def is_consecutive(triple):
                    a,b,c = triple
                    s = sorted([a,b,c])
                    return s[1]==s[0]+1 and s[2]==s[0]+2
                # Precompute L shapes list
                L_shapes = []
                for x in range(N):
                    for y in range(N):
                        L_shapes.append(((x,y),(x,y+1),(x+1,y)))
                # For faster check, map each point to L shapes it participates in
                point_to_L = collections.defaultdict(list)
                for idx,shape in enumerate(L_shapes):
                    for p in shape:
                        point_to_L[p].append(idx)
                # backtrack
                g = {}
                def backtrack(idx):
                    if idx==len(order):
                        solutions.append(dict(g))
                        return True
                    p = order[idx]
                    if p==(0,0):
                        g[p]=0
                        backtrack(idx+1)
                        del g[p]
