            def is_graphic(seq):
                seq = sorted(seq, reverse=True)
                n = len(seq)
                if sum(seq) % 2 != 0:
                    return False
                prefix = [0]
                for d in seq:
                    prefix.append(prefix[-1] + d)
                for k in range(1, n+1):
                    left = prefix[k]
                    # right = k*(k-1) + sum_{i=k+1}^{n} min(d_i, k)
                    right = k*(k-1)
                    for d in seq[k:]:
                        right += min(d, k)
                    if left > right:
                        return False
                return True
            
