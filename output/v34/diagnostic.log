            import itertools
            
            def max_edges(N):
                # vertices 1..N
                caps = [i for i in range(1,N)] + [N-1]  # list length N
                max_e = 0
                best=None
                # enumerate all subsets of edges (i<j) maybe too many; for N up to 8 edges count = N(N-1)/2 <= 28, 2^28 ~ 268M too many.
                # Use ILP via pulp? Not allowed. We'll use brute force with pruning using recursion.
                edges = [(i,j) for i in range(1,N) for j in range(i+1,N+1)]
                m = len(edges)
                best=0
                # simple backtracking
                deg=[0]* (N+1)
                def backtrack(idx, count):
                    nonlocal best
                    if idx==m:
                        if count>best:
                            best=count
                        return
                    # bound: remaining edges possible at most (m-idx) + count
                    if count + (m-idx) <= best:
                        return
                    i,j=edges[idx]
                    # try include if possible
                    if deg[i] < caps[i-1] and deg[j] < caps[j-1]:
                        deg[i]+=1; deg[j]+=1
                        backtrack(idx+1, count+1)
                        deg[i]-=1; deg[j]-=1
                    # skip
                    backtrack(idx+1, count)
                backtrack(0,0)
                return best
            
            for N in range(2,9):
                print(N, max_edges(N))
            
