            def construct_grid(a,b,T):
                N=a+2  # we need some extra cells for triples outside
                M=b+2
                size=max(N,M)+1
                grid=[[None]*size for _ in range(size)]
                # define for i<=a, j<=b
                for i in range(a+1):
                    for j in range(b+1):
                        grid[i][j]=max(0, T - 2*((a - i)+(b - j)))
                # fill remaining cells arbitrarily, e.g., set to 0
                for i in range(size):
                    for j in range(size):
                        if grid[i][j] is None:
                            grid[i][j]=0
                return grid
            
