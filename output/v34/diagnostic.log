            import itertools
            
            def count_outstanding(grid):
                m=len(grid)
                n=len(grid[0])
                cnt=0
                # include whole grid automatically? We'll count all rectangles that satisfy condition, including whole grid.
                for i1 in range(m):
                    for i2 in range(i1,m):
                        for j1 in range(n):
                            for j2 in range(j1,n):
                                # rectangle interior cells indices
                                interior = [(i,j) for i in range(i1,i2+1) for j in range(j1,j2+1)]
                                # surrounding ring cells: cells (i,j) not in interior but with max(|i - i'|, |j - j'|) == 1 for some interior cell? Equivalent to cells within one Chebyshev distance from rectangle but not inside.
                                # We'll compute bounding box expanded by 1, intersect grid, exclude interior.
                                ring = []
                                for i in range(max(0,i1-1), min(m,i2+2)):
                                    for j in range(max(0,j1-1), min(n,j2+2)):
                                        if (i,j) not in interior:
                                            # check if shares a vertex with rectangle: i in [i1-1,i2+1] and j in [j1-1,j2+1] and not both outside?
                                            # Actually any cell in expanded box that is adjacent via Chebyshev distance <=1 to some interior cell.
                                            # That's exactly the condition.
                                            ring.append((i,j))
                                # condition: each interior > each ring cell
                                interior_vals = [grid[i][j] for i,j in interior]
                                ring_vals = [grid[i][j] for i,j in ring]
                                if all(iv > rv for iv in interior_vals for rv in ring_vals):
                                    cnt+=1
                return cnt
            
            def max_outstanding(m,n):
                maxc=0
                best=None
                cells=[(i,j) for i in range(m) for j in range(n)]
                for perm in itertools.permutations(range(m*n)):
                    # assign values 0..m*n-1 according to perm order
                    grid=[[0]*n for _ in range(m)]
                    for idx, val in enumerate(perm):
                        i,j=cells[idx]
                        grid[i][j]=val
                    c=count_outstanding(grid)
                    if c>maxc:
                        maxc=c
                        best=[row[:] for row in grid]
                return maxc, best
            
