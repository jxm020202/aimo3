                vertices = list(range(n))
                # adjacency matrix
                adj = [[False]*n for _ in range(n)]
                # vertical edges
                for i in range(m):
                    a = i
                    b = m + i
                    adj[a][b] = adj[b][a] = True
                # horizontal lower
                for i in range(m-1):
                    a1 = i
                    a2 = i+1
                    adj[a1][a2] = adj[a2][a1] = True
                # horizontal upper
                for i in range(m-1):
                    b1 = m + i
                    b2 = m + i + 1
                    adj[b1][b2] = adj[b2][b1] = True
                # extra edge a_m - b_1
                adj[m-1][m] = adj[m][m-1] = True
                count = 0
                for mask in range(1<<n):
