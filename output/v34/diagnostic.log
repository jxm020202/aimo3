            import math
            from math import gcd
            
            def pretty_pairs_fast(alpha, k, M, Nmax):
                pretty=set()
                for m in range(1, M+1):
                    p = math.floor(m*alpha)
                    g = math.gcd(p, m)
                    if k % g != 0:
                        continue
                    # Solve p * n ≡ -k (mod m)
                    # Reduce equation: (p/g) * n ≡ -(k/g) (mod m/g)
                    p1 = p // g
                    m1 = m // g
                    rhs = (-k // g) % m1
                    # Find modular inverse of p1 modulo m1
                    try:
                        inv = pow(p1, -1, m1)  # Python 3.8+ modular inverse
                    except ValueError:
                        continue
                    n0 = (inv * rhs) % m1
                    # generate n = n0 + t*m1
                    n = n0
                    while n <= Nmax:
                        if n>0:
                            # check condition
                            if m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k:
                                pretty.add((m,n))
                        n += m1
                return pretty
            
            def cool_pairs_from_pretty(pretty):
                cool=set()
                for m,n in pretty:
                    cond1 = (m-n, n) in pretty if m-n>0 else False
                    cond2 = (m, n-m) in pretty if n-m>0 else False
                    if not cond1 and not cond2:
                        cool.add((m,n))
                return cool
            
            alpha = math.sqrt(2)
            k=2310
            M=50000
            Nmax=50000
            pretty = pretty_pairs_fast(alpha, k, M, Nmax)
            len(pretty)
            
