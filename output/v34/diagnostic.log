            import itertools
            def max_points_bruteforce(N):
                # generate all points
                points = [(x,y) for x in range(1,N+1) for y in range(1,N+1)]
                index = {p:i for i,p in enumerate(points)}
                # generate forbidden quadruples
                forb = []
                # horizontal base
                for y1 in range(1,N+1):
                    for y2 in range(y1+1,N+1):
                        # choose two points on row y1
                        for x1 in range(1,N+1):
                            for x2 in range(1,N+1):
                                if x1==x2: continue
                                # choose two points on row y2
                                for x3 in range(1,N+1):
                                    for x4 in range(1,N+1):
                                        if x3==x4: continue
                                        # ensure four points distinct
                                        pts = [(x1,y1),(x2,y1),(x3,y2),(x4,y2)]
                                        if len(set(pts))<4: continue
                                        # condition
                                        if (x3 - x1 == x4 - x2) or (x3 + x4 == x1 + x2):
                                            forb.append([index[p] for p in pts])
                # vertical base (swap roles)
                for x1 in range(1,N+1):
                    for x2 in range(x1+1,N+1):
                        for y1 in range(1,N+1):
                            for y2 in range(1,N+1):
                                if y1==y2: continue
                                for y3 in range(1,N+1):
                                    for y4 in range(1,N+1):
                                        if y3==y4: continue
                                        pts = [(x1,y1),(x1,y2),(x2,y3),(x2,y4)]
                                        if len(set(pts))<4: continue
                                        # condition for vertical bases: analogous using y coordinates
                                        if (y3 - y1 == y4 - y2) or (y3 + y4 == y1 + y2):
                                            forb.append([index[p] for p in pts])
                # Now solve ILP using MILP from scipy.optimize
                import numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                nvar = len(points)
                c = -np.ones(nvar)  # maximize sum => minimize negative
                A = []
                b = []
                for quad in forb:
                    row = np.zeros(nvar)
                    for i in quad:
                        row[i] = 1
                    A.append(row)
                    b.append(3)  # sum <= 3
                A = np.array(A)
                b = np.array(b)
                # variable bounds 0-1 integer
                bounds = Bounds(0, 1)
                integrality = np.ones(nvar, dtype=int)
                # Use milp
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("MILP failed")
                    return None
                val = -res.fun
                # round to integer
                val = int(round(val))
                return val
            
            for N in range(2,6):
                print(N, max_points_bruteforce(N))
            
