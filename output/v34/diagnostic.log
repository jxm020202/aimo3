            def generate_moves(state, n):
                # state as integer bitmask of n*n bits, row-major
                moves = []
                # iterate over all 2x2 blocks
                for i in range(n-1):
                    for j in range(n-1):
                        # indices of four cells
                        idx = [i*n + j, i*n + (j+1), (i+1)*n + j, (i+1)*n + (j+1)]
                        bits = [(state>>k)&1 for k in idx]
                        s = sum(bits)
                        if s == 3:
                            # find the zero cell
                            for k,b in zip(idx,bits):
                                if b==0:
                                    new_state = state | (1<<k)  # set to 1
                                    moves.append(new_state)
