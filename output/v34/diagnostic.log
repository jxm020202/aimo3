            def construct_checker_grid(rows, cols):
                N=rows*cols
                assign={}
                black_cells=[]
                white_cells=[]
                for i in range(rows):
                    for j in range(cols):
                        if (i+j)%2==0:
                            black_cells.append((i,j))
                        else:
                            white_cells.append((i,j))
                # assign black numbers 1..len(black_cells)
                for idx,cell in enumerate(black_cells):
                    assign[cell]=idx+1
                # assign white numbers N, N-1, ... descending
                for idx,cell in enumerate(white_cells):
                    assign[cell]=N-idx
                return assign
            
