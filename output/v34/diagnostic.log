            def mod_cycle(base, mod, max_exp=100):
                seen = {}
                val = 1
                for e in range(1, max_exp+1):
                    val = (val * base) % mod
                    if val in seen:
                        return e, seen[val], val
                    seen[val] = e
                return None
            
