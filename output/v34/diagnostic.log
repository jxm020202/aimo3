            def construct_bipartite(N, t):
                # left degrees: t of 3, N-t of 2
                left_deg = [3]*t + [2]*(N-t)
                right_deg = [3]*t + [2]*(N-t)
                # Use networkx to attempt to realize? Not available maybe.
                # We'll implement simple greedy: sort right degrees descending, connect.
                left_deg = sorted(left_deg, reverse=True)
                right_deg = sorted(right_deg, reverse=True)
                # Use Havel-Hakimi for bipartite: repeatedly connect highest left degree to highest right degrees.
                # We'll maintain adjacency matrix.
                adj = [[0]*N for _ in range(N)]
                # Represent right degrees as list of (deg, index)
                right = [(right_deg[i], i) for i in range(N)]
                for i, ld in enumerate(left_deg):
                    # sort right descending by remaining degree
                    right.sort(reverse=True)
                    if ld > len(right):
                        return None
                    for j in range(ld):
                        deg, idx = right[j]
                        adj[i][idx] = 1
                        right[j] = (deg-1, idx)
                    # after connecting, continue
                # check degrees
                # compute actual degrees
                left_actual = [sum(row) for row in adj]
                right_actual = [sum(adj[i][j] for i in range(N)) for j in range(N)]
                if left_actual != sorted(left_deg, reverse=True):
                    pass
                return adj
            
