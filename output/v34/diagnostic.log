            import numpy as np, random, math, time
            
            def min_edge_sum_fast(grid):
                # compute min sum across edges efficiently using vectorized operations
                # horizontal edges
                horiz = grid[:, :-1] + grid[:, 1:]
                vert = grid[:-1, :] + grid[1:, :]
                return min(horiz.min(), vert.min())
            
            def simulated_annealing(iterations=200000, time_limit=30):
                N=60
                # initial arrangement: low inc black, high dec white (our best)
                black_coords = [(i,j) for i in range(N) for j in range(N) if (i+j)%2==0]
                white_coords = [(i,j) for i in range(N) for j in range(N) if (i+j)%2==1]
                low_numbers = list(range(1,1801))
                high_numbers = list(range(3600,1800,-1))
                grid = np.empty((N,N), dtype=int)
                for (i,j), val in zip(black_coords, low_numbers):
                    grid[i,j]=val
                for (i,j), val in zip(white_coords, high_numbers):
                    grid[i,j]=val
                best_grid = grid.copy()
                best_min = min_edge_sum_fast(grid)
                cur_min = best_min
                start=time.time()
                T0=5.0
                for it in range(iterations):
                    if time.time()-start>time_limit:
                        break
                    # temperature schedule
                    T = T0 * (1 - it/iterations)
                    # pick two random cells to swap
                    i1,j1 = random.randint(0,N-1), random.randint(0,N-1)
                    i2,j2 = random.randint(0,N-1), random.randint(0,N-1)
                    if (i1,j1)==(i2,j2):
                        continue
                    # swap
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    new_min = min_edge_sum_fast(grid)
                    delta = new_min - cur_min
                    if delta > 0 or random.random() < math.exp(delta / max(T,1e-9)):
                        cur_min = new_min
                        if new_min > best_min:
                            best_min = new_min
                            best_grid = grid.copy()
                            print(f"Iter {it}, new best {best_min}")
                    else:
                        # revert swap
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                return best_min, best_grid
            
            best_min, best_grid = simulated_annealing(iterations=200000, time_limit=25)
            print("Best min found:", best_min)
            
