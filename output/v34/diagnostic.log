                            # also opposite direction: v is tail of edge from w to v
                            if v[0]==w[0]+1 and v[1]==w[1]+1 and grid_NE[w[0], w[1]]==1:
                                ok = True
                            if v[0]==w[0]+1 and v[1]==w[1]-1 and grid_SE[w[0], w[1]-1]==1:
                                ok = True
                            if not ok:
                                print("Violation between", v, w)
                                return False
                return True
            
            print(verify_solution(grid_NE, grid_SE))
            
