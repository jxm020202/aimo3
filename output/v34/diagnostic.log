            def can_schedule_all(N, edges):
                counts = [i+1 for i in range(N)]
                remaining_edges = set(edges)
                while remaining_edges:
                    # find edge with gcd=1
                    found = None
                    for (i,j) in remaining_edges:
                        if math.gcd(counts[i], counts[j]) == 1:
                            found = (i,j)
                            break
                    if not found:
                        return False
                    i,j = found
                    g = math.gcd(counts[i], counts[j])
                    # remove g from each (should be 1)
                    counts[i] -= g
                    counts[j] -= g
                    remaining_edges.remove((i,j))
