            import numpy as np, itertools, math
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def rectangles(m,n):
                rects=[]
                for top in range(m):
                    for bottom in range(top,m):
                        for left in range(n):
                            for right in range(left,n):
                                rects.append((top,bottom,left,right))
                return rects
            
            def interior_cells(rect):
                top,bottom,left,right=rect
                return {(i,j) for i in range(top,bottom+1) for j in range(left,right+1)}
            
            def border_cells(rect,m,n):
                top,bottom,left,right=rect
                cells=set()
                for i in range(top-1,bottom+2):
                    for j in range(left-1,right+2):
                        if 0<=i<m and 0<=j<n:
                            if not (top<=i<=bottom and left<=j<=right):
                                cells.add((i,j))
                return cells
            
            def conflict(rect1, rect2, m, n):
                interior1=interior_cells(rect1)
                border1=border_cells(rect1,m,n)
                interior2=interior_cells(rect2)
                border2=border_cells(rect2,m,n)
                if interior1 & border2 and interior2 & border1:
                    return True
                return False
            
            def max_outstanding_milp(m,n):
                rects=rectangles(m,n)
                R=len(rects)
                c=-np.ones(R)  # maximize sum
                rows=[]
                b=[]
                for i in range(R):
                    for j in range(i+1,R):
                        if conflict(rects[i], rects[j], m, n):
                            row=np.zeros(R)
                            row[i]=1
                            row[j]=1
                            rows.append(row)
                            b.append(1)
                if rows:
                    A=np.array(rows)
                    b=np.array(b)
                    lc=LinearConstraint(A, -np.inf*np.ones_like(b), b)
                else:
                    A=np.zeros((0,R))
                    b=np.zeros(0)
                    lc=LinearConstraint(A, -np.inf*np.ones_like(b), b)
                bounds=Bounds(0,1)
                integrality=np.ones(R)
                res=milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    raise RuntimeError("MILP failed")
                x=res.x
                selected=[i for i in range(R) if x[i]>0.5]
                return len(selected)
            
            print("4x5:", max_outstanding_milp(4,5))
            
