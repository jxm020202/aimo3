            def is_dead(mask, n):
                # BFS over configurations reachable via toggles (only 2-block toggles)
                # Stop if we encounter a configuration with a 3-block (i.e., can increase)
                visited = {mask}
                q = deque([mask])
                while q:
                    cur = q.popleft()
                    # check if any 3-block exists
                    for i in range(n-1):
                        for j in range(n-1):
                            idx = [i*n + j, (i+1)*n + j, i*n + (j+1), (i+1)*n + (j+1)]
                            s = sum((cur>>p)&1 for p in idx)
                            if s == 3:
                                return False  # not dead, can increase
                    # generate toggles for 2-blocks
                    for i in range(n-1):
                        for j in range(n-1):
                            idx = [i*n + j, (i+1)*n + j, i*n + (j+1), (i+1)*n + (j+1)]
                            s = sum((cur>>p)&1 for p in idx)
                            if s == 2:
                                new = cur
                                for p in idx:
                                    new ^= (1 << p)
                                if new not in visited:
                                    visited.add(new)
                                    q.append(new)
                # explored all reachable configs, none had 3-block
