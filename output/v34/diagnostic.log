            def min_terms_for_a_target(target, max_terms=12, max_exp=12):
                # BFS on term count
                from collections import deque
                n = max_exp+1
                # state: (a,b,c,terms)
                visited = set()
                queue = deque()
                queue.append((0,0,0,0))
                visited.add((0,0,0))
                while queue:
                    a,b,c,terms = queue.popleft()
                    if a == target and b==0 and c==0 and terms>0:
                        return terms
                    if terms >= max_terms:
                        continue
                    for i in range(n):
                        ai, bi, ci = vectors[i]
                        na, nb, nc = a+ai, b+bi, c+ci
                        state = (na, nb, nc)
                        if state not in visited:
                            visited.add(state)
                            queue.append((na, nb, nc, terms+1))
                return None
            
