            def is_isosceles_trapezoid(pts):
                # pts: list of 4 (x,y) tuples
                # returns True if they form an isosceles trapezoid with base parallel to x or y axis
                # rectangle counts.
                # Check horizontal base
                # group by y
                from collections import defaultdict
                byy = defaultdict(list)
                for (x,y) in pts:
                    byy[y].append(x)
                if len(byy)==2:
                    # each y must have exactly 2 points
                    ys = list(byy.keys())
                    if all(len(byy[y])==2 for y in ys):
                        y1, y2 = ys
                        xs1 = byy[y1]
                        xs2 = byy[y2]
                        # ensure points distinct
                        # condition: either sum equality or difference equality
                        # compute sums
                        s1 = xs1[0] + xs1[1]
                        s2 = xs2[0] + xs2[1]
                        if s1 == s2:
                            return True
                        # compute differences (ordered)
                        # need to check if there exists ordering such that x3 - x1 = x4 - x2
                        # we can try both permutations of xs1 and xs2
                        for a,b in [(xs1[0], xs1[1]), (xs1[1], xs1[0])]:
                            for c,d in [(xs2[0], xs2[1]), (xs2[1], xs2[0])]:
                                if c - a == d - b:
                                    return True
                # Check vertical base
                byx = defaultdict(list)
                for (x,y) in pts:
                    byx[x].append(y)
                if len(byx)==2:
                    xs = list(byx.keys())
                    if all(len(byx[x])==2 for x in xs):
                        x1, x2 = xs
                        ys1 = byx[x1]
                        ys2 = byx[x2]
                        # sum condition for y's
                        if ys1[0] + ys1[1] == ys2[0] + ys2[1]:
                            return True
                        for a,b in [(ys1[0], ys1[1]), (ys1[1], ys1[0])]:
                            for c,d in [(ys2[0], ys2[1]), (ys2[1], ys2[0])]:
                                if c - a == d - b:
                                    return True
                return False
            
            def generate_forbidden(N):
