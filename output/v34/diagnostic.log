            def checkerboard_low_high(r,c):
                cells = [(i,j) for i in range(r) for j in range(c)]
                black = [(i,j) for i,j in cells if (i+j)%2==0]
                white = [(i,j) for i,j in cells if (i+j)%2==1]
                # assign low numbers to black ascending
                low_vals = list(range(1,len(black)+1))
                high_vals = list(range(r*c, r*c - len(white), -1))
                val={}
                for cell, v in zip(black, low_vals):
                    val[cell]=v
                for cell, v in zip(white, high_vals):
                    val[cell]=v
                # compute min edge sum
                adj_sums=[]
                for i in range(r):
                    for j in range(c):
                        if i+1<r:
                            adj_sums.append(val[(i,j)]+val[(i+1,j)])
                        if j+1<c:
                            adj_sums.append(val[(i,j)]+val[(i,j+1)])
                return min(adj_sums), val
            
