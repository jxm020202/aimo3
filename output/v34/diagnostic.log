                best_seq = None
                # backtrack
                def backtrack(coins, used_pairs, count):
                    nonlocal best, best_seq
                    if count > best:
                        best = count
                        best_seq = used_pairs.copy()
                    # prune: max possible further ops = sum(coin>0)//2 maybe
