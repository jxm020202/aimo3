            def graph_components(S):
                # returns list of components as sets of vertices (rows and columns)
                import collections
                rows = set(y for x,y in S)
                cols = set(x for x,y in S)
                # adjacency
                adj = collections.defaultdict(set)
                for x,y in S:
                    adj[('r',y)].add(('c',x))
                    adj[('c',x)].add(('r',y))
                visited = set()
                comps = []
                for v in list(adj.keys()):
                    if v in visited: continue
                    stack=[v]
                    comp=set()
                    while stack:
                        u=stack.pop()
                        if u in visited: continue
                        visited.add(u)
                        comp.add(u)
                        for w in adj[u]:
                            if w not in visited:
                                stack.append(w)
                    comps.append(comp)
