            def compute_winner(N):
                # encode state as tuple (wx,wy,bx,by,w_req,b_req,turn)
                # w_req,b_req: 0 any, 1 horiz required, 2 vert required
                from collections import defaultdict, deque
                # Build adjacency lists
                horiz = [(-1,0),(1,0)]
                vert = [(0,-1),(0,1)]
                moves = {0: horiz+vert, 1: horiz, 2: vert}
                # All possible states
                states = []
                for wx in range(1,N+1):
                    for wy in range(1,N+1):
                        for bx in range(1,N+1):
                            for by in range(1,N+1):
                                if (wx,wy)==(bx,by):
                                    continue
                                for w_req in (0,1,2):
                                    for b_req in (0,1,2):
                                        for turn in (0,1):
                                            states.append((wx,wy,bx,by,w_req,b_req,turn))
                # Determine terminal winning states for player to move?
                # If turn == 1 (Bob's turn) and there exists a move that captures white, then that move leads to immediate win.
                # We'll handle via move generation.
                # We'll use retrograde: compute outdegree, and track win/lose/draw.
                outdeg = {}
                predecessors = defaultdict(list)
                # Initialize
                for s in states:
                    wx,wy,bx,by,w_req,b_req,turn = s
                    # generate moves for player
                    player = 'Alice' if turn==0 else 'Bob'
                    allowed_dirs = moves[w_req] if turn==0 else moves[b_req]
                    move_list = []
                    for dx,dy in allowed_dirs:
                        if turn==0:
                            nx,ny = wx+dx, wy+dy
                            if 1<=nx<=N and 1<=ny<=N:
                                # if Alice moves onto black piece, it's a special move that results in immediate loss for Bob (Alice win)
                                # We'll treat resulting state as terminal losing for Bob (i.e., winning for Alice)
                                if (nx,ny)==(bx,by):
                                    # terminal state where Alice wins; for our analysis, we can consider this as Bob losing state.
                                    # We'll represent as a special terminal with outcome = loss for player to move (Bob).
                                    # We'll handle later.
                                    continue
                                next_w_req = 2 if (dx,dy) in horiz else 1
                                ns = (nx,ny,bx,by,next_w_req,b_req,1) # Bob's turn
                                move_list.append(ns)
                        else:
                            nx,ny = bx+dx, by+dy
                            if 1<=nx<=N and 1<=ny<=N:
                                # capture?
                                if (nx,ny)==(wx,wy):
                                    # Bob captures: terminal win for Bob (player to move)
                                    # Represent as a terminal winning state for Bob.
                                    # We'll handle as immediate win.
                                    move_list.append('WIN')
                                else:
                                    next_b_req = 2 if (dx,dy) in horiz else 1
                                    ns = (wx,wy,nx,ny,w_req,next_b_req,0) # Alice's turn
                                    move_list.append(ns)
                    outdeg[s]=len(move_list)
                    for ns in move_list:
                        if ns!='WIN':
                            predecessors[ns].append(s)
                # Now retrograde: we need to compute outcome for each state: WIN (Bob can force win), LOSE (Bob cannot win), DRAW (Bob cannot force win but also not lose? Actually Alice can avoid capture forever => Bob loses.)
                # Since we care about Bob's ability to force win from initial state (Alice turn), we can compute from perspective of Bob.
                # We'll treat 'WIN' as a winning terminal for Bob (i.e., state where player to move (Bob) can win immediately).
                # We'll propagate using standard algorithm: 
                # - If a state is Bob's turn and there is a move to WIN, then state is WIN for Bob.
                # - For other states, we propagate.
                from collections import deque
                UNKNOWN=0
                WIN=1
                LOSE=2
                outcome = {s:UNKNOWN for s in states}
                queue=deque()
                # Initialize: any state where turn==1 (Bob) and there is a capture move -> WIN
                for s in states:
                    wx,wy,bx,by,w_req,b_req,turn = s
                    if turn==1:
                        # check capture moves
                        dirs = moves[b_req]
                        win_found=False
                        for dx,dy in dirs:
                            nx,ny=bx+dx,by+dy
                            if 1<=nx<=N and 1<=ny<=N and (nx,ny)==(wx,wy):
                                win_found=True
                                break
                        if win_found:
                            outcome[s]=WIN
                            queue.append(s)
                # Also, any state where it's Alice's turn and she can move onto black piece (immediate Alice win => Bob lose)
                # For those states, we mark as LOSE for Bob (since Alice can force Bob not to win)
                for s in states:
                    wx,wy,bx,by,w_req,b_req,turn = s
                    if turn==0:
                        dirs = moves[w_req]
                        lose=False
                        for dx,dy in dirs:
                            nx,ny=wx+dx,wy+dy
                            if 1<=nx<=N and 1<=ny<=N and (nx,ny)==(bx,by):
                                lose=True
                                break
                        if lose:
                            outcome[s]=LOSE
                            queue.append(s)
                # Now propagate:
                while queue:
                    s = queue.popleft()
                    cur_out = outcome[s]
                    for pred in predecessors[s]:
                        if outcome[pred]!=UNKNOWN:
                            continue
                        wx,wy,bx,by,w_req,b_req,turn = pred
                        if turn==0: # Alice's turn (Bob is opponent)
