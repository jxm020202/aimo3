            def reachable_from_all_black(n):
                N = n*n
                # Represent state as integer bitmask of length N (row-major)
                all_black = (1 << N) - 1
                # BFS
                visited = set([all_black])
                q = collections.deque([all_black])
                # Precompute block indices
                blocks = []
                for i in range(n-1):
                    for j in range(n-1):
                        idx = [ (i)*n + j,
                                (i)*n + (j+1),
                                (i+1)*n + j,
                                (i+1)*n + (j+1) ]
                        blocks.append(idx)
                while q:
                    state = q.popleft()
                    # For each block, examine pattern
                    for idx in blocks:
                        bits = [(state>>k)&1 for k in idx]
                        cnt = sum(bits)
                        if cnt == 3:
                            # find the zero cell
                            zero_pos = idx[bits.index(0)]
                            new_state = state | (1<<zero_pos)  # set to 1
                            if new_state not in visited:
                                visited.add(new_state)
                                q.append(new_state)
                        elif cnt == 4:
                            # reverse of rule A: can turn any one black to white
                            for pos in idx:
                                new_state = state & ~(1<<pos)  # set to 0
                                if new_state not in visited:
                                    visited.add(new_state)
                                    q.append(new_state)
                        elif cnt == 2:
                            # rule B: invert block (swap colors)
                            # flipping all bits in block (since exactly two 1s become 0s and 0s become 1s)
                            # Equivalent to XOR with mask of block
                            mask = 0
                            for pos in idx:
                                mask |= (1<<pos)
                            new_state = state ^ mask
                            if new_state not in visited:
                                visited.add(new_state)
                                q.append(new_state)
                        # cnt 0 or 1: no move
                return visited
            
            def max_unsolvable_black(n):
                all_states = set(range(1 << (n*n)))
                reachable = reachable_from_all_black(n)
                unreachable = all_states - reachable
                max_black = max(bin(s).count('1') for s in unreachable) if unreachable else -1
                return max_black, len(unreachable)
            
            for n in range(2,5):
                maxb, cnt = max_unsolvable_black(n)
                print(n, maxb, cnt)
            
