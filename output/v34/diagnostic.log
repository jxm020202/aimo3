            from functools import lru_cache
            import math, itertools, sys
            
            def max_ops_bruteforce(n):
                # state: tuple of remaining coins per pile (1-indexed)
                init = tuple(range(1,n+1))
                # use memoization
                @lru_cache(None)
                def dfs(state, used_pairs):
                    # state is tuple of ints length n
                    # used_pairs is frozenset of ordered pairs (i,j) with i<j that have been used
                    best = 0
                    # generate possible moves
                    for i in range(n):
                        if state[i]==0: continue
                        for j in range(i+1,n):
                            if state[j]==0: continue
                            if (i,j) in used_pairs: continue
                            g = math.gcd(state[i], state[j])
                            if g==0: continue
                            # remove g from each
                            new_state = list(state)
                            new_state[i] -= g
                            new_state[j] -= g
                            new_used = set(used_pairs)
                            new_used.add((i,j))
                            best = max(best, 1 + dfs(tuple(new_state), frozenset(new_used)))
                    return best
                return dfs(init, frozenset())
            
            for n in range(1,8):
                print(n, max_ops_bruteforce(n))
            
