                                       integrality=np.ones(num_vars, dtype=int),
                                       options={'presolve': True, 'time_limit': 10})
                    except Exception as e:
                        print("MILP error", e)
                        return None
                    feasible = res.success
                    if feasible:
                        best = mid
                        lo = mid + 1
                    else:
                        hi = mid - 1
                return best
            
