            def minimal_pairs(k,limit):
                result=[]
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if m+n <= k:
                            continue
                        if (m - k) % math.gcd(m,n) != 0:
                            continue
                        # check reduced pairs condition (A)
                        cond1=False
                        if m-n>0:
                            if ((m-n)-k) % math.gcd(m-n,n) == 0 and (m-n)+n>k:
