            from fractions import Fraction
            import math, itertools, sys, sympy as sp, mpmath as mp
            
            def is_square_rational(fr):
                # fr is Fraction
                # check if numerator and denominator are perfect squares
                num = fr.numerator
                den = fr.denominator
                # reduce sign
                if num < 0:
                    return False
                sqrt_num = int(math.isqrt(num))
                sqrt_den = int(math.isqrt(den))
                return sqrt_num*sqrt_num == num and sqrt_den*sqrt_den == den
            
            def rational_sqrt(fr):
                # returns sqrt as Fraction if perfect square else None
                if is_square_rational(fr):
                    num = int(math.isqrt(fr.numerator))
                    den = int(math.isqrt(fr.denominator))
                    return Fraction(num, den)
                else:
                    return None
            
            def compute_A_rational(x_frac):
                # x_frac is Fraction
                # compute using sympy rational arithmetic with sqrt rational if possible
                # We'll compute using sympy with Rational and sqrt.
                x = sp.Rational(x_frac.numerator, x_frac.denominator)
                # define sqrt(1-2x)
                expr_sqrt = sp.sqrt(1 - 2*x)
                # fraction term
                frac = (4*x - 2 + 2*expr_sqrt) / (3 - 5*x - expr_sqrt)
                # cube sum term
                inner = sp.sqrt(9*x**4 + sp.Rational(4,3)*x**6 + 9 + 18*x**2)
                cube_sum = sp.real_root((1 + x**2)/2 + inner/6, 3) + sp.real_root((1 + x**2)/2 - inner/6, 3)
                A = sp.simplify(frac + cube_sum)
                return A
            
            def is_rational(expr):
                # check if expression simplifies to rational number (no sqrt)
                return expr.is_Rational
            
            solutions = []
            max_den = 20
            for b in range(1, max_den+1):
                for a in range(1, b+1):
                    x_frac = Fraction(a, b)
                    if x_frac > Fraction(1,2):
                        continue
                    # check sqrt rational
                    s = rational_sqrt(Fraction(b-2*a, b))
                    if s is None:
                        continue
                    # compute A
                    try:
                        A = compute_A_rational(x_frac)
                    except Exception as e:
                        continue
                    # simplify numeric
                    A_simpl = sp.nsimplify(A)
                    if A_simpl.is_Rational:
                        # compute y = sqrt(2A) - A, need sqrt rational
                        # check 2A rational square?
                        twoA = sp.Rational(2)*A_simpl
                        # sqrt rational?
                        sqrt_twoA = sp.sqrt(twoA)
                        if sqrt_twoA.is_Rational:
                            y = sqrt_twoA - A_simpl
                            if y.is_Rational and y>0:
                                solutions.append((x_frac, A_simpl, y))
                                print("found", x_frac, A_simpl, y)
                    # else maybe A rational but sqrt(2A) rational not required? Actually y must be rational, so sqrt(2A) must be rational.
            print("total solutions", len(solutions))
            
