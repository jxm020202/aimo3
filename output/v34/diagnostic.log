                # compute cube root terms: we know they sum to 1, but compute directly using real cube root
                # Use sympy for exact?
                import sympy as sp
                x_sym = sp.Rational(x.numerator, x.denominator)
                y_sym = sp.Rational(y.numerator, y.denominator)
                expr = 1 + sp.sqrt(1 - 2*y_sym)
                # RHS components
                term1 = y_sym
                term2 = (4*x_sym - 2 + 2*sp.sqrt(1 - 2*x_sym)) / (3 - 5*x_sym - sp.sqrt(1 - 2*x_sym))
