            import itertools
            
            def min_f_bruteforce(n, start, end):
                total_inc = end - start
                # generate all sequences of length n with monotone nondecreasing integer values from start to end, start fixed, end fixed
                # we can generate all ways to distribute total_inc across n-1 gaps (d_i) nonnegative integers sum to total_inc
                min_f = None
                best_seq = None
                # Use recursion to generate compositions of total_inc into n-1 parts
                def gen(idx, remaining, current):
                    nonlocal min_f, best_seq
                    if idx == n-1:
                        if remaining == 0:
                            # construct sequence
                            a=[start]
                            for d in current:
                                a.append(a[-1]+d)
                            # ensure last is end
                            if a[-1]==end:
                                f=compute_f(a)
                                if min_f is None or f<min_f:
                                    min_f=f
                                    best_seq=a[:]
                        return
                    # allocate from 0 to remaining
                    for d in range(remaining+1):
                        current.append(d)
                        gen(idx+1, remaining-d, current)
                        current.pop()
                gen(0, total_inc, [])
                return min_f, best_seq
            
            def min_f_bruteforce_small():
                for n in range(3,9):
                    f, seq = min_f_bruteforce(n, 1, 5)
