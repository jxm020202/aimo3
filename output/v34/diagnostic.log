                # Find roots of P and Q, count multiplicities for common real roots
                # Use sympy roots (gives multiplicities)
                rootsP = sp.nroots(P, n=15, maxsteps=100)
                rootsQ = sp.nroots(Q, n=15, maxsteps=100)
                # Use tolerance to group near equal roots
                # But we need exact? For integer coefficients small, roots may be algebraic.
                # We'll approximate numeric and consider real if imag small.
                realP = []
                for r in rootsP:
                    if abs(sp.im(r))<1e-8:
                        realP.append(round(float(sp.re(r)),6))
                realQ = []
                for r in rootsQ:
                    if abs(sp.im(r))<1e-8:
                        realQ.append(round(float(sp.re(r)),6))
                # Count multiplicities: we can use sp.roots to get exact multiplicities (maybe rational)
                # Use sp.roots for exact factorization
                rootsP_exact = sp.roots(P, multiple=False)  # dict root: multiplicity
                rootsQ_exact = sp.roots(Q, multiple=False)
                # For each root that is real, check multiplicities min
                rcount = 0
                for root, multP in rootsP_exact.items():
                    if root.is_real:
                        multQ = rootsQ_exact.get(root,0)
                        rcount += min(multP, multQ)
                return rcount
            
