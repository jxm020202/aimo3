                # simple backtracking with pruning, limit values up to target+5
                max_val=target+5
                assigned={(0,0):0}
                cells=[(i,j) for i in range(N+1) for j in range(M+1)]
                start_idx=1 if cells[0]==(0,0) else 0
                def is_consecutive(triple):
                    s=sorted(triple)
                    return s[0]+1==s[1] and s[1]+1==s[2]
                def check_triangle(x,y):
                    if (x,y) in assigned and (x,y+1) in assigned and (x+1,y) in assigned:
                        return is_consecutive([assigned[(x,y)],assigned[(x,y+1)],assigned[(x+1,y)]])
                    return True
                found=False
                def recurse(idx):
                    nonlocal found
                    if found:
