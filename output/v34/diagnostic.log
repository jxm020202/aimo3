```python
import itertools

def f_bruteforce(n):
    best = 0.0
    for signs in itertools.product([-1,1], repeat=n):
        S = sum(signs)
        total = sum(abs(S - (n+1)*a) for a in signs)
        val = total / n
        if val > best:
            best = val
    return best

for n in range(1,11):
    print(n, f_bruteforce(n))
