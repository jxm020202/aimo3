                # compute D(t) and C(t) for all thresholds t
                # thresholds are possible values of high numbers
                thresholds = set([b for b,_ in high_pairs] + [S - a for a,_ in low_pairs])
                thresholds = sorted(thresholds, reverse=True)
                # precompute cumulative sums
