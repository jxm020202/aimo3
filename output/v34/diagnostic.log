            def is_connected(n, B):
                N = n*n
                # Represent state as integer bitmask of length N (0 white, 1 black)
                # Generate all combos of B bits set
                combos = list(itertools.combinations(range(N), B))
                # Map combo to index
                idx = {c:i for i,c in enumerate(combos)}
                # Build adjacency list using operation 2
                # For each state, iterate over all 2x2 blocks, check if exactly two blacks, then toggle those four bits (swap colors)
                # Equivalent to complement bits in block (since two black become white, two white become black)
                # So new state = state ^ mask where mask is bits of block (since complement)
                # But operation allowed only if block has exactly two blacks in current state.
                # We'll generate adjacency edges.
                adj = [[] for _ in combos]
                # Precompute block masks
                block_masks = []
                for i in range(n-1):
                    for j in range(n-1):
                        cells = [i*n + j, i*n + (j+1), (i+1)*n + j, (i+1)*n + (j+1)]
                        mask = 0
                        for c in cells:
                            mask |= 1 << c
                        block_masks.append((cells, mask))
                # Build adjacency
                for combo in combos:
                    # compute bitmask
                    mask_state = 0
                    for c in combo:
                        mask_state |= 1 << c
                    cur_idx = idx[combo]
                    for cells, block_mask in block_masks:
                        # count blacks in block
                        # popcount of (mask_state & block_mask)
                        cnt = bin(mask_state & block_mask).count("1")
                        if cnt == 2:
                            new_mask = mask_state ^ block_mask  # complement block
                            # ensure new_mask has same number of bits set (should be B)
                            # get new combo
                            new_combo = tuple(sorted([i for i in range(N) if (new_mask>>i)&1]))
                            new_idx = idx[new_combo]
                            adj[cur_idx].append(new_idx)
                # BFS from first state
                visited = [False]*len(combos)
                q = collections.deque([0])
                visited[0]=True
                while q:
                    u = q.popleft()
                    for v in adj[u]:
                        if not visited[v]:
                            visited[v]=True
                            q.append(v)
                return all(visited)
            
