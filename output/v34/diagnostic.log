            import itertools, math, numpy as np, sys, random, time, collections, itertools, math, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def conflict(rect1, rect2, m, n):
                # returns True if they cannot both be selected (i.e., would create cycle)
                interior1=interior_cells(rect1)
                border1=border_cells(rect1,m,n)
                interior2=interior_cells(rect2)
                border2=border_cells(rect2,m,n)
                # check mutual containment
                if interior1 & border2 and interior2 & border1:
                    return True
                # also if one interior intersects border of other (one-way) may still be okay? Actually that creates edges only one direction, no cycle.
                # However there could be indirect cycles via third rectangle, but pairwise condition may be sufficient for laminar families.
                return False
            
            def max_outstanding_milp(m,n):
                rects=rectangles(m,n)
                R=len(rects)
                # binary variables x_i
                c=np.zeros(R)  # objective maximize sum, we set negative for milp (minimize)
                # We'll minimize -sum x_i => maximize sum
                c = -np.ones(R)
                # constraints: for each conflicting pair, x_i + x_j <= 1
                A=[]
                b=[]
                for i in range(R):
                    for j in range(i+1,R):
                        if conflict(rects[i], rects[j], m, n):
                            row=np.zeros(R)
                            row[i]=1
                            row[j]=1
                            A.append(row)
                            b.append(1)
                if not A:
                    A=np.zeros((0,R))
                    b=np.zeros(0)
                else:
                    A=np.array(A)
                    b=np.array(b)
                # milp requires LinearConstraint
                lc = LinearConstraint(A, -np.inf*np.ones_like(b), b)  # only upper bound
                bounds = Bounds(0, 1)
                integrality = np.ones(R)
                res = milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("milp failed")
                    return None
                x=res.x
                selected = [i for i in range(R) if x[i]>0.5]
                return len(selected)
            
            print("2x2 milp:", max_outstanding_milp(2,2))
            
