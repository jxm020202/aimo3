            def find_min_sum(N, max_val=5):
                # Build vectors up to N-1
                vecs = vectors[:N]
                # Build matrix M 3xN
                M = sp.Matrix([[vecs[i][j] for i in range(N)] for j in range(3)])
                # unknowns
                ks = sp.symbols('k0:%d' % N)
                sol = sp.linsolve((M, sp.Matrix([2025,0,0])), *ks)
                # sol is set with one tuple expression
                expr = list(sol)[0]  # tuple of expressions for each k_i
                # free variables are those that appear as themselves (k_i) not expressed.
                # Determine which indices are free: those where expr[i] == ks[i]
                free_indices = [i for i, e in enumerate(expr) if e == ks[i]]
                # others are expressed in terms of free vars.
                # We'll brute force over free vars.
                free_symbols = [ks[i] for i in free_indices]
                best = None
                best_vec = None
                # generate ranges
                ranges = [range(max_val+1) for _ in free_symbols]
                for values in itertools.product(*ranges):
                    subs = dict(zip(free_symbols, values))
                    # compute all k_i
                    ks_vals = [int(expr[i].subs(subs)) for i in range(N)]
                    if any(v < 0 for v in ks_vals):
                        continue
                    total = sum(ks_vals)
                    if best is None or total < best:
                        best = total
                        best_vec = ks_vals
                return best, best_vec, free_indices
            
