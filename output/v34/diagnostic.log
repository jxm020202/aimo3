            def snake_grid(m,n):
                N=m*n
                seq=[]
                low=1
                high=N
                while low<high:
                    seq.append(low)
                    seq.append(high)
                    low+=1
                    high-=1
                if low==high:
                    seq.append(low)
                # fill snake
                grid=[[0]*n for _ in range(m)]
                idx=0
                for i in range(m):
                    if i%2==0:
                        cols=range(n)
                    else:
                        cols=range(n-1,-1,-1)
                    for j in cols:
                        grid[i][j]=seq[idx]
                        idx+=1
                return grid
            
            grid=snake_grid(2,3)
            grid
            
