            from fractions import Fraction
            def find_a(max_den):
                sols = []
                for q in range(1, max_den+1):
                    for p in range(0, q+1):
                        a = Fraction(p, q)
                        if a <= 0 or a >= 1:
                            continue
                        # compute expr = (5 a^2 - 2 a + 1) / 8
                        expr = Fraction(5*a*a - 2*a + 1, 8)
                        # simplify fraction
                        num = expr.numerator
                        den = expr.denominator
                        # check if both num and den are perfect squares
