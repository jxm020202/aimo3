            def count_assignments(max_x, max_y):
                # grid size (max_x+1)*(max_y+1) points
                # a[x][y] in {1,2}
                # condition: for all x<max_x, y<max_y: a[x+1][y] + a[x][y+1] == 2*a[x][y]
                # We'll brute force all possibilities for small size.
                solutions = []
                # We'll fill row by row.
                def backtrack(x, y, grid):
                    if x==max_x+1:
                        # filled all rows
                        solutions.append([row[:] for row in grid])
                        return
                    nx, ny = (x, y+1) if y<max_y else (x+1, 0)
                    # try a=1 or 2
                    for a in (1,2):
                        # assign
                        grid[x][y]=a
                        # check condition for any L shape that is now fully determined
                        # condition involves (x-1,y) and (x,y-1) as lower-left corners?
                        # Actually condition for lower-left (i,j) uses a[i][j], a[i+1][j], a[i][j+1]
                        # So after assigning (x,y), we can check condition for lower-left corners where all three needed are assigned.
                        ok=True
                        # Check lower-left (x-1,y) if x>0 and y<=max_y (needs a[x-1][y], a[x][y], a[x-1][y+1])
                        if x>0 and y<=max_y:
                            i,j=x-1,y
                            if grid[i][j] is not None and grid[i+1][j] is not None and (j+1<=max_y and grid[i][j+1] is not None):
                                if grid[i+1][j] + grid[i][j+1] != 2*grid[i][j]:
                                    ok=False
                        # Check lower-left (x, y-1) if y>0
                        if y>0 and x<=max_x:
                            i,j=x, y-1
                            if grid[i][j] is not None and (i+1<=max_x and grid[i+1][j] is not None) and grid[i][j+1] is not None:
                                if grid[i+1][j] + grid[i][j+1] != 2*grid[i][j]:
                                    ok=False
                        if ok:
                            backtrack(nx, ny, grid)
                        grid[x][y]=None
                # initialize grid with None
                grid=[[None]*(max_y+1) for _ in range(max_x+1)]
                backtrack(0,0,grid)
                return solutions
            
