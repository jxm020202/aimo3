                n_r = N
                total = n_c + n_s + n_e + n_r
                c_obj = np.zeros(total); c_obj[:n_c]=1
                A=[]; b=[]
                # start sum=1
                row=np.zeros(total); row[n_c:n_c+n_s]=1; A.append(row); b.append(1)
