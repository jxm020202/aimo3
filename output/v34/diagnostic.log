            from fractions import Fraction
            def find_solutions(max_den=20):
                sols = []
                for q in range(1, max_den+1):
                    for p in range(0, q+1):
                        a = Fraction(p, q)
                        # a must be <=1
                        # also a >=0
                        # compute A = 5 a^2 - 2 a + 1
                        A = 5*a*a - 2*a + 1
                        # compute RHS = 8*a*(1 - a) / A
                        if A == 0:
                            continue
                        RHS = Fraction(8*a*(1 - a), A)
                        # Now we need b rational such that b^2 + 2b - 1 = RHS
                        # Solve quadratic: b^2 + 2b - (1 + RHS) = 0
                        # discriminant D = 4 + 4*(1 + RHS) = 4*(2 + RHS)
                        D = Fraction(4)*(2 + RHS)
                        # D must be a perfect square rational (i.e., numerator and denominator perfect squares)
                        # Let's compute sqrt of D as rational if possible.
                        # D = n/d. sqrt rational if n and d are perfect squares.
                        n = D.numerator
                        d = D.denominator
                        import math, itertools
                        sqrt_n = int(math.isqrt(n))
                        sqrt_d = int(math.isqrt(d))
                        if sqrt_n*sqrt_n == n and sqrt_d*sqrt_d == d:
                            sqrtD = Fraction(sqrt_n, sqrt_d)
                            # b = -1 ± sqrtD/2? Wait formula: b = -1 ± sqrt(D)/2? Actually earlier we had b = -1 ± sqrt(2 + RHS)
                            # Let's recompute: b = -1 ± sqrt(2 + RHS). Since D = 4*(2 + RHS), sqrt(D) = 2*sqrt(2 + RHS). So sqrt(2 + RHS) = sqrtD/2.
                            # So b = -1 ± sqrt(2 + RHS) = -1 ± sqrtD/2.
                            b1 = Fraction(-1) + sqrtD/2
                            b2 = Fraction(-1) - sqrtD/2
                            for b in (b1, b2):
                                if b >= 0 and b <= 1:
                                    # compute y = (1 - b^2)/2 rational
                                    y = Fraction(1,1) - b*b
                                    y = y/2
                                    x = Fraction(1,1) - a*a
                                    x = x/2
                                    # ensure positive
                                    if x > 0 and y > 0:
                                        sols.append((a,b,x,y))
                return sols
            
            sols = find_solutions(20)
            len(sols)
            
