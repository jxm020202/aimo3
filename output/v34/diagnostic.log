            from collections import deque
            
            def min_moves(N):
                # initial config: 0 for T (tails), 1 for H (heads)
                init = 0
                for i in range(N):
                    if (i%2)==0: # position 1 is index 0, tails
                        init |= 0<<i
                    else:
                        init |= 1<<i
                goal = (1<<N)-1
                # BFS over (pos, config). pos = -1 for before first move (no previous)
                start_states = []
                # first move can be any coin
                for p in range(N):
                    cfg = init ^ (1<<p)  # flip
                    start_states.append((p,cfg))
                visited = set(start_states)
                dq = deque()
                for s in start_states:
                    dq.append((s[0], s[1], 1))  # moves count =1
                while dq:
                    pos, cfg, steps = dq.popleft()
                    if cfg == goal:
                        return steps
                    # next moves: adjacent positions
                    for np in [pos-1, pos+1]:
