            def min_adj_sum(grid):
                m,n=grid.shape
                mins=10**9
                for i in range(m):
                    for j in range(n):
                        if i+1<m:
                            mins=min(mins, grid[i,j]+grid[i+1,j])
                        if j+1<n:
                            mins=min(mins, grid[i,j]+grid[i,j+1])
