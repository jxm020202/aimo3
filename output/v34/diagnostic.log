            def min_weight_for_kernel(p_vec, q_vec):
                N = 19
                size = N*N
                # K matrix entries
                K = np.zeros((N,N), dtype=int)
                for i in range(N):
                    for j in range(N):
                        K[i,j] = (p_vec[i] + q_vec[j]) % 2
