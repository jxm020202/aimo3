            def min_adjacent_sum_grid(grid, n):
                min_sum = 10**9
                for r in range(n):
                    for c in range(n):
                        v = grid[r][c]
                        if r+1 < n:
                            min_sum = min(min_sum, v + grid[r+1][c])
                        if c+1 < n:
                            min_sum = min(min_sum, v + grid[r][c+1])
                return min_sum
            
            def random_initial(n):
                nums = list(range(1, n*n+1))
                random.shuffle(nums)
                grid = [nums[i*n:(i+1)*n] for i in range(n)]
                return grid
            
            def hill_climb(n, iterations=200000):
                grid = random_initial(n)
                best = min_adjacent_sum_grid(grid, n)
                best_grid = [row[:] for row in grid]
                for it in range(iterations):
                    # pick two cells to swap
                    r1,c1 = divmod(random.randrange(n*n), n)
                    r2,c2 = divmod(random.randrange(n*n), n)
                    if (r1,c1)==(r2,c2):
                        continue
                    # swap
                    grid[r1][c1], grid[r2][c2] = grid[r2][c2], grid[r1][c1]
                    cur = min_adjacent_sum_grid(grid, n)
                    if cur > best:
                        best = cur
                        best_grid = [row[:] for row in grid]
                        # print progress
                        #print("Iter", it, "new best", best)
                    if cur >= best:
                        # keep swap
                        pass
                    else:
                        # revert
                        grid[r1][c1], grid[r2][c2] = grid[r2][c2], grid[r1][c1]
                return best, best_grid
            
            best, best_grid = hill_climb(7, iterations=20000)
            print("Best min sum found:", best)
            
