            def is_convex(poly):
                # poly list of points (x,y) in order, closed (first not repeated)
                n = len(poly)
                signs = []
                for i in range(n):
                    x1, y1 = poly[i]
                    x2, y2 = poly[(i+1)%n]
                    x3, y3 = poly[(i+2)%n]
                    # vector (x2-x1, y2-y1) cross (x3-x2, y3-y2)
                    cross = (x2-x1)*(y3-y2) - (y2-y1)*(x3-x2)
                    signs.append(cross)
                # convex if all cross have same sign (non-zero)
                pos = [c for c in signs if c>1e-9]
                neg = [c for c in signs if c<-1e-9]
                return len(pos)==0 or len(neg)==0
            
