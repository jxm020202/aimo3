        ```python
# Compute vectors (a_n, b_n, c_n) for r^n where r satisfies r^3 + r^2 + r - 10 = 0
def compute_vectors(N):
    a = [0]*(N+1)
    b = [0]*(N+1)
    c = [0]*(N+1)
    # base cases
    a[0], b[0], c[0] = 1, 0, 0   # r^0 = 1
    if N>=1:
        a[1], b[1], c[1] = 0, 1, 0   # r^1 = r
    if N>=2:
        a[2], b[2], c[2] = 0, 0, 1   # r^2 = r^2
    for n in range(3, N+1):
        a[n] = 10*a[n-3] - a[n-2] - a[n-1]
        b[n] = 10*b[n-3] - b[n-2] - b[n-1]
        c[n] = 10*c[n-3] - c[n-2] - c[n-1]
    return [(a[i], b[i], c[i]) for i in range(N+1)]

vectors = compute_vectors(20)
for i, vec in enumerate(vectors):
    print(i, vec)
