            def max_edges_havel_hakimi(n):
                caps = [i for i in range(1,n)] + [n-1]  # list length n
                # We'll use list of (remaining, vertex) sorted descending
                import heapq
                # Use max heap (negative)
                heap = [(-c, i) for i,c in enumerate(caps) if c>0]
                heapq.heapify(heap)
                edges = set()
                while len(heap) >= 2:
                    # pop vertex with largest remaining
                    c1, v1 = heapq.heappop(heap)
                    d1 = -c1
                    if d1 == 0:
                        break
                    # Need to connect to d1 other vertices
                    if d1 > len(heap):
                        # not enough vertices left
                        break
                    # pop next d1 vertices
                    temp = []
                    for _ in range(d1):
                        c2, v2 = heapq.heappop(heap)
                        d2 = -c2
                        # add edge
                        edges.add(tuple(sorted((v1, v2))))
                        d2 -= 1
                        temp.append((d2, v2))
                    # push back updated vertices with remaining capacity
                    for d2, v2 in temp:
                        if d2 > 0:
                            heapq.heappush(heap, (-d2, v2))
                    # v1 done (capacity zero)
                total_edges = len(edges)
                return total_edges, caps, edges
            
            max_edges_havel_hakimi(7)
            
