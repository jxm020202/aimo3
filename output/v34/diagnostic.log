            def count_outstanding(R,C,peak):
                # assign values = -L1 distance from peak (r0,c0) (0-index)
                r0,c0 = peak
                grid = [[-(abs(r-r0)+abs(c-c0)) for c in range(C)] for r in range(R)]
                # function to check rectangle (r1,r2 inclusive, c1,c2 inclusive)
                def is_outstanding(r1,r2,c1,c2):
                    # interior cells
                    interior = [(r,c) for r in range(r1,r2+1) for c in range(c1,c2+1)]
                    # outer ring cells: cells not in interior but share a vertex with interior
                    # i.e., cells (r,c) where r in [r1-1, r2+1], c in [c1-1, c2+1] and not interior and within grid
                    outer = []
                    for r in range(r1-1, r2+2):
                        for c in range(c1-1, c2+2):
                            if 0 <= r < R and 0 <= c < C:
                                if not (r1 <= r <= r2 and c1 <= c <= c2):
                                    # shares vertex if adjacent (including diagonal)
                                    # condition: max(|r - interior_r|, |c - interior_c|) == 1 for some interior cell
                                    # Equivalent to being within one step of rectangle.
                                    # Since we iterate over bounding box extended by 1, any such cell qualifies.
                                    outer.append((r,c))
                    # check condition
                    min_interior = min(grid[r][c] for r,c in interior)
                    max_outer = max(grid[r][c] for r,c in outer) if outer else -10**9
                    return min_interior > max_outer
                count=0
                for r1 in range(R):
                    for r2 in range(r1,R):
                        for c1 in range(C):
                            for c2 in range(c1,C):
                                if is_outstanding(r1,r2,c1,c2):
                                    count+=1
                return count
            
            def count_rectangles_containing(R,C,peak):
                r0,c0=peak
                # number of choices for top row <= r0, bottom row >= r0
                top_choices = r0+1
                bottom_choices = R - r0
                left_choices = c0+1
                right_choices = C - c0
                return top_choices*bottom_choices*left_choices*right_choices
            
