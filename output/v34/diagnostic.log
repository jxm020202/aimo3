            def find_solutions(maxv):
                sols = []
                for v in range(1, maxv+1):
                    for u in range(0, v+1):
                        if math.gcd(u, v) != 1:
                            continue
                        s = fractions.Fraction(u, v)
                        if not (0 < s < 1):
                            continue
                        M = fractions.Fraction(5*u*u, v*v) - fractions.Fraction(2*u, v) + 1
                        val = 8 * M
                        num, den = val.numerator, val.denominator
                        if int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den:
                            r = fractions.Fraction(math.isqrt(num), math.isqrt(den))
                            A = 5*s*s - 2*s + 1
                            B = 10*s*s - 4*s + 2
                            sqrtD = (s + 1) * r
                            for sign in [1, -1]:
