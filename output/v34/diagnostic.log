            import random, math, itertools, numpy as np
            
            def sum_a(points, angle_deg=100):
                n = len(points)
                angle_rad = math.radians(angle_deg)
                total = 0
                for i, p in enumerate(points):
                    # compute angles to other points
                    dirs = []
                    for j, q in enumerate(points):
                        if i == j: continue
                        dx = q[0] - p[0]
                        dy = q[1] - p[1]
                        theta = math.atan2(dy, dx)  # -pi to pi
                        dirs.append(theta)
                    # sort angles
                    dirs.sort()
                    # duplicate with +2π for circular wrap
                    dirs2 = dirs + [theta + 2*math.pi for theta in dirs]
                    # sliding window to find max count within angle_rad
                    maxcnt = 0
                    m = len(dirs)
                    j = 0
                    for i_start in range(m):
                        while j < i_start + m and dirs2[j] - dirs2[i_start] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - i_start
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_points(n, radius=1.0):
                pts = []
                for _ in range(n):
                    # uniform in circle
                    r = radius * math.sqrt(random.random())
                    ang = random.random()*2*math.pi
                    pts.append((r*math.cos(ang), r*math.sin(ang)))
                return pts
            
            def max_sum_random(n, trials=2000):
                best = 0
                best_pts = None
                for _ in range(trials):
                    pts = random_points(n, radius=10.0)
                    s = sum_a(pts)
                    if s > best:
                        best = s
                        best_pts = pts
                return best, best_pts
            
            for n in range(3,9):
                best,_ = max_sum_random(n, trials=2000)
                print(n, best)
            
