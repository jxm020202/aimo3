            def compute_upper_bound(m=60,n=60):
                total_cells=m*n
                corners=4
                edge_cells=2*m+2*n-4
                deg2=corners
                deg3=edge_cells-corners
                deg4=total_cells - edge_cells
                # assign numbers 1..total_cells
                # sort numbers ascending, assign smallest to deg2, next to deg3, rest to deg4
                numbers=list(range(1,total_cells+1))
                # assign smallest deg2 numbers to corners
                idx=0
                assign_deg2=numbers[idx:idx+deg2]; idx+=deg2
                assign_deg3=numbers[idx:idx+deg3]; idx+=deg3
                assign_deg4=numbers[idx:]
                D = sum(v*2 for v in assign_deg2) + sum(v*3 for v in assign_deg3) + sum(v*4 for v in assign_deg4)
                # total edges E = (sum degrees)/2
                E = (deg2*2 + deg3*3 + deg4*4)//2
                return D, E, D//E
            D,E,Smax=compute_upper_bound()
