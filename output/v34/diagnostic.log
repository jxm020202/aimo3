            def compute_winning_region(N):
                states = generate_states(N)
                state_index = {s:i for i,s in enumerate(states)}
                # forward adjacency list
                forward = [[] for _ in states]
                reverse = [[] for _ in states]
                for i,s in enumerate(states):
                    for ns in forward_moves(s,N):
                        j = state_index[ns]
                        forward[i].append(j)
                        reverse[j].append(i)
                # initial winning set: states where positions coincide (wx==bx and wy==by)
                winning = [False]*len(states)
                queue = []
                for i,s in enumerate(states):
                    wx,wy,bx,by,turn,_,_ = s
                    if wx==bx and wy==by:
                        winning[i]=True
                        queue.append(i)
                # also maybe we consider that if it's Bob's turn and he can capture immediately (move onto white) that leads to winning state after move; but algorithm will capture via forward edges.
                # Attractor iteration
                while queue:
                    cur = queue.pop()
                    # for each predecessor
                    for pred in reverse[cur]:
                        if winning[pred]:
                            continue
                        wx,wy,bx,by,turn,prev_w,prev_b = states[pred]
                        if turn==1: # Bob's turn: if any move leads to winning, then pred is winning
                            # Since cur is a winning successor, Bob can choose it
                            winning[pred]=True
                            queue.append(pred)
                        else: # Alice's turn: if all moves lead to winning, then pred is winning
                            # need to check if all successors are winning
                            all_win = True
                            for succ in forward[pred]:
                                if not winning[succ]:
                                    all_win=False
                                    break
                            if all_win:
                                winning[pred]=True
                                queue.append(pred)
                # Return set of winning states
                return {states[i] for i,w in enumerate(winning) if w}
            
