            def construct_lower_bound(n):
                state=0
                # first row, columns 0..n-2
                for j in range(n-1):
                    state |= 1 << (0*n + j)
                # first column, rows 0..n-2
                for i in range(n-1):
                    state |= 1 << (i*n + 0)
                # add bottom right corner
                state |= 1 << ((n-1)*n + (n-1))
                return state
            
