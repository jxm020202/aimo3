        import sympy as sp, math, itertools

def compute_PT(QR_angle_deg, turn_R_left):
    # P at (0,0), Q at (2,0)
    P = sp.Point(0,0)
    Q = sp.Point(2,0)
    # QR direction angle from east
    theta_Q = math.radians(QR_angle_deg)
    QR_len = sp.sqrt(2)
    R = sp.Point(Q.x + QR_len*sp.cos(theta_Q), Q.y + QR_len*sp.sin(theta_Q))
    # direction of RS: rotate QR direction by +90 if left turn, -90 if right turn
    theta_RS = theta_Q + (math.radians(90) if turn_R_left else -math.radians(90))
    RS_len = sp.sqrt(2)
    S = sp.Point(R.x + RS_len*sp.cos(theta_RS), R.y + RS_len*sp.sin(theta_RS))
    # Solve for T on x=0 line (vertical) such that distance ST = sqrt(2)
    y = sp.symbols('y', real=True)
    eq = (0 - S.x)**2 + (y - S.y)**2 - 2)  # distance squared = 2
    sol = sp.solve(eq, y)
    # choose solution that gives convex polygon (positive orientation)
    # compute PT length = |y|
    results = []
    for soly in sol:
        PT_len = sp.sqrt((soly)**2)  # absolute value
        # compute orientation cross products to ensure convex CCW
        T = sp.Point(0, soly)
        pts = [P,Q,R,S,T]
        cross_vals = [ (pts[i+1].x-pts[i].x)*(pts[(i+2)%5].y-pts[i+1].y) - (pts[i+1].y-pts[i].y)*(pts[(i+2)%5].x-pts[i+1].x) for i in range(5) ]
        # check all cross have same sign (positive for CCW)
        sign = None
        convex = True
        for c in cross_vals:
            if c == 0:
                convex = False
                break
            if sign is None:
                sign = 1 if c>0 else -1
            elif (c>0) != (sign>0):
                convex = False
                break
        results.append((soly.simplify(), PT_len.simplify(), convex))
    return R, S, results

