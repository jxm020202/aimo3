                import numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                c = -np.ones(N)  # maximize sum => minimize -sum
                # constraints: for each pair conflict, x_a + x_b <= 1
                # Build A matrix rows for each conflict
                rows = []
                lbs = []
                ubs = []
                for a in range(N):
                    for b in range(a+1,N):
