                        if sum_sofar > best:
                            best = sum_sofar
                            best_vec = current[:]
                        return
                    # upper bound for a_i based on product constraint with existing rows:
                    # For each existing a_j, need a_i <= floor((2N-1)/a_j) if a_j>0 else any.
                    # Also sum of squares bound maybe.
                    max_possible = N
                    for aj in current[:i]:
                        if aj > 0:
                            max_possible = min(max_possible, (2*N-1)//aj)
                    # also sum constraint: C(ai,2) + C(aj,2) <= 2N-3 => ai <= floor( (1 + sqrt(1+8*(2N-3 - C(aj,2))))/2 )
                    for aj in current[:i]:
                        # compute max ai from sum constraint
                        max_ai = int(((1 + (1+8*(2*N-3 - (aj*(aj-1)//2)))**0.5)//2) if (2*N-3 - (aj*(aj-1)//2))>=0 else 0)
                        max_possible = min(max_possible, max_ai)
                    # iterate possible ai from 0..max_possible
                    for ai in range(max_possible, -1, -1):
                        # check constraints with previous rows
                        ok = True
                        for aj in current[:i]:
                            if ai * aj > 2*N-1:
                                ok=False; break
                            if (ai*(ai-1)//2) + (aj*(aj-1)//2) > 2*N-3:
                                ok=False; break
                        if not ok:
                            continue
                        current[i]=ai
                        # pruning: upper bound on remaining rows: each remaining row can have at most N (but product constraints will limit)
                        # simple bound: sum_sofar + (N-i-1)*N
                        # but we can compute a rough bound using product constraint with max existing ai.
                        recurse(i+1, current, sum_sofar+ai)
                    current[i]=0
                recurse(0, [0]*N, 0)
                return best, best_vec
            
