            # Build min vertex cover using König's theorem: 
            # Let U be left side (D). Let Z be set of vertices reachable from unmatched left vertices via alternating paths.
            # Then min vertex cover = (U \ Z) ∪ (V ∩ Z)
            U = set([('d',d) for d in D])
