            def max_edges_greedy2(n):
                caps = list(range(1, n+1))
                import heapq
                # store as (-cap, index)
                heap = [(-caps[i], i) for i in range(n)]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    cap, v = heapq.heappop(heap)
                    cap = -cap
                    if cap == 0:
                        continue
                    # collect neighbors with positive capacity
                    neighbors = []
                    while cap > 0 and heap:
                        c2, u = heapq.heappop(heap)
                        c2 = -c2
                        if c2 == 0:
                            # cannot use this vertex, discard
                            continue
                        # connect v-u
                        edges += 1
                        c2 -= 1
                        cap -= 1
                        neighbors.append((c2, u))
                    # after attempting, if cap > 0, cannot fulfill, discard remaining capacity of v (unused)
                    # push back neighbors with updated capacities
                    for c2, u in neighbors:
                        heapq.heappush(heap, (-c2, u))
                    # v's remaining capacity (if any) is discarded (since we cannot use it)
                return edges
            
