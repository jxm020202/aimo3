            def assign_by_degree(r,c):
                N=r*c
                cells = [(i,j) for i in range(r) for j in range(c)]
                # compute degree
                deg={}
                for i,j in cells:
                    d=0
                    if i>0: d+=1
                    if i<r-1: d+=1
                    if j>0: d+=1
                    if j<c-1: d+=1
                    deg[(i,j)]=d
                # sort cells by degree ascending (low degree first) to assign low numbers
                cells_sorted = sorted(cells, key=lambda x: deg[x])
                # assign numbers 1..N in order of cells_sorted
                val={}
                for idx,cell in enumerate(cells_sorted):
                    val[cell]=idx+1
                # compute min edge sum
                adj=[]
