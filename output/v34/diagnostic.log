            def intersect_horizontal_circle(a,b):
                # compute y_T from earlier
                angle_TLX, angle_TLZ, angle_TLY, T, N, R_pt, L = compute_angles_numeric(a,b)
                y_T = T[1]
                # circle center O, radius R
                O = (a/2.0, b/2.0)
                R = math.hypot(a,b)/2.0
                # solve (x - O.x)^2 + (y_T - O.y)^2 = R^2
                # => (x - O.x)^2 = R^2 - (y_T - O.y)^2
                val = R**2 - (y_T - O[1])**2
                if val < 0:
                    return None
                dx = math.sqrt(val)
                x1 = O[0] + dx
                x2 = O[0] - dx
                return (x1, y_T), (x2, y_T)
            
