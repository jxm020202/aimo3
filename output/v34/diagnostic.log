            import itertools, math
            
            def is_valid(seq):
                # seq is list of positive ints, length L
                L = len(seq)
                # check condition for all n (1..L) and all k such that k+n-1 <= L
                for n in range(1, L+1):
                    a_n = seq[n-1]
                    for k in range(1, L - n + 2):
                        s = sum(seq[k-1:k+n-1])
                        if s % a_n != 0:
                            return False
                return True
            
            def search_max_aN(N, max_val=None):
                # brute force using recursion, each a_n must divide sum of previous terms
                # we bound a_n <= sum_{i< n} a_i
                best = 0
                best_seq = None
                def rec(seq):
                    nonlocal best, best_seq
                    n = len(seq)
                    if n == N:
                        if is_valid(seq):
                            if seq[-1] > best:
                                best = seq[-1]
                                best_seq = seq[:]
                        return
                    # compute allowed values for a_{n+1}
                    S = sum(seq)
                    # a_{n+1} must divide S (Equation 1)
                    # also must be positive integer
                    # list divisors of S
                    divisors = [d for d in range(1, S+1) if S % d == 0]
                    # sort descending to try larger first
                    for a_next in sorted(divisors, reverse=True):
                        # optional bound max_val
                        if max_val is not None and a_next > max_val:
                            continue
                        new_seq = seq + [a_next]
                        # early prune: check condition for all n up to len(new_seq) where sums fully within new_seq
                        if is_valid(new_seq):
                            rec(new_seq)
                rec([1])
                return best, best_seq
            
            for N in range(2,7):
                best, seq = search_max_aN(N)
                print(N, best, seq)
            
