            def check_divisor(c, d):
                # returns True if d divides S = M + c -1, using modular reasoning
                # M = 3^T, T huge, but we can use properties:
                # For d not divisible by 3: M ≡ 1 mod d, so S ≡ c mod d
                # For d divisible by 3: let e = v3(d), m = d // 3**e
                # then condition: (c-1) % 3**e == 0 and c % m == 0
                if d % 3 != 0:
                    return (c % d) == 0
                else:
                    e = 0
                    temp = d
                    while temp % 3 == 0:
                        e += 1
                        temp //= 3
                    m = temp
                    if (c - 1) % (3**e) != 0:
                        return False
                    if m == 1:
                        return True
                    return (c % m) == 0
            
            def find_smallest_d(c, max_search=1000000):
                for d in range(3, max_search+1):
                    if check_divisor(c, d):
                        return d
                return None
            
