            def max_nonfull(n):
                total, mat = max_ones_no_2or3(n)
                if total == n*n:
                    # need to find second best? Let's add constraint sum <= n*n - 1
                    N = n*n
                    B = (n-1)*(n-1)
                    total_vars = N + B
                    c = np.zeros(total_vars)
                    c[:N] = -1
                    bounds = Bounds(0, 1)
                    A = []
                    lb = []
                    ub = []
                    def idx(i,j):
                        return i*n + j
                    block_idx = 0
                    for i in range(n-1):
                        for j in range(n-1):
                            coeff = np.zeros(total_vars)
                            coeff[idx(i,j)] = 1
                            coeff[idx(i+1,j)] = 1
                            coeff[idx(i,j+1)] = 1
                            coeff[idx(i+1,j+1)] = 1
                            y_index = N + block_idx
                            coeff1 = coeff.copy()
                            coeff1[y_index] = -3
                            A.append(coeff1); ub.append(1); lb.append(-np.inf)
                            coeff2 = -coeff.copy()
                            coeff2[y_index] = 4
                            A.append(coeff2); ub.append(0); lb.append(-np.inf)
                            block_idx += 1
                    # add constraint sum <= n*n - 1
                    sum_coeff = np.zeros(total_vars)
                    sum_coeff[:N] = 1
                    A.append(sum_coeff); ub.append(n*n - 1); lb.append(-np.inf)
                    A = np.array(A); lb = np.array(lb); ub = np.array(ub)
                    integrality = np.ones(total_vars, dtype=int)
                    res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=integrality, options={'disp': False})
                    if not res.success:
                        print("second MILP failed", res.message)
                        return None
                    x = np.rint(res.x[:N]).astype(int)
                    total2 = x.sum()
                    return total2, x.reshape((n,n))
                else:
                    return total, mat
            
