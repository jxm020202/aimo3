            def compute_qs(n, K=10):
                S = 0
                r_prev = 0
                q_vals = []
                for k in range(1, K+1):
                    # compute r_k
                    S += k**(n-1) * math.factorial(k)
                    r_k = (- (S - k**(n-1) * math.factorial(k))) % math.factorial(k)  # Actually -sum_{i=1}^{k-1} i^{n-1} i! mod k!
                    # but easier: compute T_{k-1}
                    T = sum(i**(n-1) * math.factorial(i) for i in range(1, k))
                    r_k = (-T) % math.factorial(k)
                    # compute q = ( -T - r_k ) / k!
                    q = (-T - r_k) // math.factorial(k)
                    q_vals.append(q)
                    r_prev = r_k
                return q_vals
            
