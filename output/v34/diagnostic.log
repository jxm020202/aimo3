            import math, numpy as np
            def curve_points(num=10000):
                pts=[]
                for u in np.linspace(0,1,num):
                    # upper branch y = u + sqrt(1-u^2)
                    v = u + math.sqrt(1-u*u)
                    pts.append((u, v))
                    # lower branch y = u - sqrt(1-u^2)
                    v2 = u - math.sqrt(1-u*u)
                    pts.append((u, abs(v2))) # store absolute y
                return pts
            
