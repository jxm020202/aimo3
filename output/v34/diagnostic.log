            def max_min_adj_sum(r,c,iterations=200000):
                n=r*c
                cells=[(i,j) for i in range(r) for j in range(c)]
                adj=[]
                for idx,(i,j) in enumerate(cells):
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<r and 0<=nj<c:
                            adj.append((idx,cells.index((ni,nj))))
                # ensure each edge counted once
                adj=set(tuple(sorted(e)) for e in adj)
                adj=list(adj)
                # start with random permutation
                perm=list(range(1,n+1))
                random.shuffle(perm)
                def min_adj_sum(p):
                    m=10**9
                    for u,v in adj:
                        s=p[u]+p[v]
                        if s<m:
                            m=s
                    return m
                best=min_adj_sum(perm)
                best_perm=perm[:]
                cur=best
                cur_perm=perm[:]
                T=5.0
                for it in range(iterations):
                    # swap two random positions
                    i,j=random.sample(range(n),2)
                    cur_perm[i],cur_perm[j]=cur_perm[j],cur_perm[i]
                    new=min_adj_sum(cur_perm)
                    # accept if better or with probability
                    if new>cur or random.random()<math.exp((new-cur)/T):
                        cur=new
                        if new>best:
                            best=new
                            best_perm=cur_perm[:]
                    else:
                        # revert swap
                        cur_perm[i],cur_perm[j]=cur_perm[j],cur_perm[i]
                    # cooling
                    T*=0.9999
                return best, best_perm
            
