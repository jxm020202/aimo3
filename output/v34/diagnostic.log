            def degrees_triangular(N):
                # Build graph edges as described: for each i from 1 to N-1, connect i to the i highest vertices > i (i.e., N, N-1,..., N-i+1)
                deg = [0]*(N+1)
                for i in range(1,N):
                    for k in range(N, N-i, -1):
                        j = k
                        if j<=i: continue
                        deg[i]+=1
                        deg[j]+=1
