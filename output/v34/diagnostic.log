            import itertools
            
            def brute(L, M):
                n = L-1
                total = M-1
                best = None
                best_seq = None
                # generate all compositions of total into n nonnegative ints (small)
                # use recursion
                def rec(idx, remaining, cur):
                    nonlocal best, best_seq
                    if idx == n:
                        if remaining == 0:
                            # compute a
                            a = [1]
                            for b in cur:
                                a.append(a[-1]+b)
                            # compute f
                            f = sum(ai*ai for ai in a) - sum(a[i]*a[i+2] for i in range(len(a)-2))
                            if best is None or f < best:
                                best = f
                                best_seq = (cur[:], a[:])
                        return
                    # bound: each b can be up to remaining
                    for b in range(remaining+1):
                        cur.append(b)
                        rec(idx+1, remaining-b, cur)
                        cur.pop()
                rec(0, total, [])
                return best, best_seq
            
