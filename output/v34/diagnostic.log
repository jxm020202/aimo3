            def is_graphic(seq):
                # Erdos-Gallai theorem
                seq = sorted(seq, reverse=True)
                if sum(seq) % 2 != 0:
                    return False
                n = len(seq)
                prefix = [0]
                for s in seq:
                    prefix.append(prefix[-1]+s)
                for k in range(1,n+1):
                    left = prefix[k]
                    # right = k*(k-1) + sum_{i=k+1}^{n} min(k, seq[i-1])
                    right = k*(k-1)
                    for i in range(k+1, n+1):
                        right += min(k, seq[i-1])
                    if left > right:
                        return False
                return True
            
