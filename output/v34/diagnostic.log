                        idx = [i*n + j, i*n + (j+1), (i+1)*n + j, (i+1)*n + (j+1)]
                        bits = [grid[p] for p in idx]
                        s = sum(bits)
                        if s == 3:
                            # fill missing
                            new_grid = grid[:]
                            for p in idx:
                                new_grid[p] = 1
                            # encode
                            new_state = 0
                            for pos, b in enumerate(new_grid):
                                new_state |= (b << pos)
                            res.append(new_state)
                        elif s == 2:
                            # invert block
                            new_grid = grid[:]
                            for p in idx:
                                new_grid[p] ^= 1
                            new_state = 0
                            for pos, b in enumerate(new_grid):
                                new_state |= (b << pos)
                            res.append(new_state)
                return res
            
            def can_reach_all_black(start, n):
                target = (1 << (n*n)) - 1
                # BFS
                visited = set([start])
                q = collections.deque([start])
                while q:
                    s = q.popleft()
                    if s == target:
                        return True
                    for ns in moves(s, n):
                        if ns not in visited:
                            visited.add(ns)
                            q.append(ns)
                return False
            
            def minimal_k(n):
                total = n*n
                # iterate k from 0 to total
                for k in range(total+1):
                    all_good = True
                    # iterate all configurations with k blacks (choose combos)
                    # may be many; for n=4 total 16 choose k combos; manageable.
                    for cells in itertools.combinations(range(total), k):
                        state = 0
                        for c in cells:
                            state |= (1 << c)
                        if not can_reach_all_black(state, n):
                            all_good = False
                            # print failing example
                            #print("k",k,"fails",cells)
                            break
                    if all_good:
                        return k
                return None
            
            for n in [2,4]:
                print("n",n,"min k",minimal_k(n))
            
