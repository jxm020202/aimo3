            def max_S_by_degree_bound(m,n):
                N=m*n
                # degree list descending (for small numbers)
                interior = (m-2)*(n-2)
                edge = 2*(m-2) + 2*(n-2)
                corner = 4
                deg_desc = [4]*interior + [3]*edge + [2]*corner
                deg_desc.sort(reverse=True)  # already descending
                # degree list ascending (for large numbers)
                deg_asc = [2]*corner + [3]*edge + [4]*interior
                deg_asc.sort()
                # prefix sums
                prefix_desc = [0]
                for d in deg_desc:
                    prefix_desc.append(prefix_desc[-1]+d)
                prefix_asc = [0]
                for d in deg_asc:
                    prefix_asc.append(prefix_asc[-1]+d)
                # function to test S
                def feasible(S):
                    # for k from 1..N
                    for k in range(1,N+1):
                        Dk = prefix_desc[k]  # sum of degrees of k smallest numbers (assigned to high-degree cells)
                        t = S - k
                        if t <= 0:
                            # numbers >= t includes all numbers, capacity = total degree sum
                            C = prefix_asc[N]
                        elif t > N:
                            # need numbers >= >N none, capacity 0
                            C = 0
                        else:
                            count_large = N - t + 1
                            C = prefix_asc[count_large]
                        if Dk > C:
                            return False
                    return True
                # binary search S
                lo=0
                hi=2*N  # upper bound maybe
                best=0
                while lo<=hi:
                    mid=(lo+hi)//2
                    if feasible(mid):
                        best=mid
                        lo=mid+1
                    else:
                        hi=mid-1
                return best
            
            print(max_S_by_degree_bound(4,5))
            
