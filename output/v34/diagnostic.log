                # Precompute prefix sums each iteration maybe O(n^2) but n=7k fine.
                for k in range(n,0,-1):
                    # compute LHS sum of top k
                    L = sum(caps[:k])
                    # compute RHS
                    # find position p where caps[i] >= k for i>=k
                    # Since caps sorted descending, we can find first index > k after k.
                    # We'll just compute directly O(n) for simplicity.
                    R = k*(k-1) + sum(min(d,k) for d in caps[k:])
                    if L > R:
                        excess = L - R
                        # Reduce excess from caps[0..k-1] starting from smallest (index k-1 downwards)
                        i = k-1
                        while excess>0 and i>=0:
                            reducible = caps[i] - (caps[i+1] if i+1<k else 0)  # amount we can reduce without breaking order?
                            # Actually we can reduce caps[i] down to caps[i+1] (or 0 if i+1 out of range)
                            # But we can also reduce further if needed.
                            max_reduce = caps[i] - (caps[i+1] if i+1<k else 0)
                            # we can reduce at most max_reduce without violating nonincreasing order.
                            # If still need more, we may need to reduce further (allowing order break) but we can just reduce caps[i] directly.
