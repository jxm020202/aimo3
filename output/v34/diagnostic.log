            def multiplicative_order(a, mod):
                # compute smallest k>0 such that a^k ≡ 1 mod mod, assuming gcd(a,mod)=1
                if math.gcd(a, mod) != 1:
                    return None
                k=1
                cur = a % mod
                while cur != 1:
                    cur = (cur * a) % mod
                    k+=1
                    if k>10000:
                        return None
                return k
            
