            def reduce_pair(m,n):
                # Euclidean reduction: while both >0 and not equal?
                while True:
                    if m>n:
                        m2=m-n
                        if m2<=0: break
                        m,n=m2,n
                    elif n>m:
                        n2=n-m
                        if n2<=0: break
                        m,n=m,n2
                    else:
                        # m==n, cannot reduce further (subtract would give zero)
                        break
                    # continue
                return (m,n)
            
            def cool_via_reduction(limit):
                pretty=set()
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if m*math.ceil(n*alpha)-n*math.floor(m*alpha)==K:
                            pretty.add((m,n))
                # map each pretty to its reduced pair
                reduced=set()
                for (m,n) in pretty:
