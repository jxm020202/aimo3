            def board_to_int(board):
                # board is list of ints 0/1 length n*n
                # convert to int bitmask
                n = int(math.isqrt(len(board)))
                mask = 0
                for i, b in enumerate(board):
                    if b:
                        mask |= 1 << i
                return mask
            
            def int_to_board(mask, n):
                board = [(mask >> i) & 1 for i in range(n*n)]
                return board
            
            def get_moves(mask, n):
                moves = []
                # iterate over all 2x2 blocks top-left at (r,c) where r<n-1, c<n-1
                for r in range(n-1):
                    for c in range(n-1):
                        # indices of four cells
                        idx = [r*n + c, r*n + (c+1), (r+1)*n + c, (r+1)*n + (c+1)]
                        bits = [(mask >> i) & 1 for i in idx]
                        cnt = sum(bits)
                        if cnt == 3:
                            # rule 1: fill missing cell (turn it to 1)
                            missing = idx[bits.index(0)]
                            newmask = mask | (1 << missing)
                            moves.append(newmask)
                        elif cnt == 2:
                            # rule 2: flip all four cells
                            # compute xor with mask of these four bits (i.e., toggle each)
                            toggle = 0
                            for i in idx:
                                toggle ^= (1 << i)
                            newmask = mask ^ toggle
                            moves.append(newmask)
                return moves
            
            def can_reach_all_black(start_mask, n, max_states=100000):
                target = (1 << (n*n)) - 1
                # BFS/DFS
                seen = set([start_mask])
                stack = [start_mask]
                while stack:
                    mask = stack.pop()
                    if mask == target:
                        return True
                    for nxt in get_moves(mask, n):
                        if nxt not in seen:
                            seen.add(nxt)
                            stack.append(nxt)
                            if len(seen) > max_states:
                                # give up
                                return None
                return False
            
            def minimal_k_bruteforce(n):
                N = n*n
                for k in range(N+1):
                    all_ok = True
                    # iterate all subsets of size k (maybe huge)
                    # for small n we can do exhaustive
                    for comb in itertools.combinations(range(N), k):
                        mask = 0
                        for i in comb:
                            mask |= 1 << i
                        res = can_reach_all_black(mask, n)
                        if not res:
                            all_ok = False
                            break
                    if all_ok:
                        return k
                return None
            
            for n in [2,4]:
                print("n", n, "minimal k", minimal_k_bruteforce(n))
            
