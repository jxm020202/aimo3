            def compute_rank():
                n=19
                size=n*n
                # Build matrix rows = operation vectors (size x size)
                # Represent as binary numpy array of shape (size,size) dtype uint8
                mat = np.zeros((size, size), dtype=np.uint8)
                # map (i,j) to index idx = i*n + j
                for i in range(n):
                    for j in range(n):
                        op_idx = i*n + j
                        # row i: cells (i, k) for k in 0..n-1
                        for k in range(n):
                            cell_idx = i*n + k
                            mat[op_idx, cell_idx] ^= 1
                        # column j: cells (k, j)
                        for k in range(n):
                            cell_idx = k*n + j
                            mat[op_idx, cell_idx] ^= 1
                        # intersection (i,j) added twice; we need flip once: currently we flipped row and column each toggling (i,j) twice -> 0, need toggle once more.
                        cell_idx = i*n + j
                        mat[op_idx, cell_idx] ^= 1
                # Compute rank over GF(2) using row reduction
                A = mat.copy()
                rank = 0
                rows, cols = A.shape
                r = 0
                for c in range(cols):
                    # find pivot row with 1 in column c at or below r
                    pivot = None
                    for i in range(r, rows):
                        if A[i,c]:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap rows r and pivot
                    if pivot != r:
                        A[[r, pivot]] = A[[pivot, r]]
                    # eliminate other rows
                    for i in range(rows):
                        if i != r and A[i,c]:
                            A[i] ^= A[r]
                    r += 1
                    rank += 1
                    if r == rows:
                        break
                return rank
            
            print(compute_rank())
            
