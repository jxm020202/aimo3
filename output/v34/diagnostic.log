            import numpy as np
            
            n=2024
            # Build M matrix (tridiagonal)
            M = np.zeros((n,n))
            for i in range(n):
                M[i,i]=2
                if i>0:
                    M[i,i-1]=1
                if i<n-1:
                    M[i,i+1]=1
            # We'll solve (2M) d = 398 e_last - λ 1
            # Actually gradient condition: 2 M d - 398 e_last + λ 1 = 0 => 2M d = 398 e_last - λ 1
            # Let A = 2M
            A = 2*M
            # We'll treat λ as variable; we can solve d = A^{-1} (398 e_last - λ 1)
            # Compute A^{-1} * 1 and A^{-1} * e_last
            e_last = np.zeros(n)
            e_last[-1]=1
            ones = np.ones(n)
            # Solve linear systems
            invA_one = np.linalg.solve(A, ones)
