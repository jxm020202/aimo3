            def construct_grid(m,n,S):
                # cells list sorted by degree descending (interior first)
                cells = [(i,j) for i in range(m) for j in range(n)]
                deg = {}
                for i,j in cells:
                    d = 0
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        if 0<=i+di<m and 0<=j+dj<n:
                            d+=1
                    deg[(i,j)] = d
                cells_sorted = sorted(cells, key=lambda c: -deg[c])  # interior first
                # adjacency dict
                adj = {}
                for i,j in cells:
                    neighbors=[]
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            neighbors.append((ni,nj))
                    adj[(i,j)] = neighbors
                # assign numbers
                remaining = list(range(1,m*n+1))
                # We'll assign largest possible each step that doesn't violate constraints with already assigned neighbors.
                assign={}
                for cell in cells_sorted:
                    # Determine minimal allowed value for this cell given assigned neighbors:
                    # For each assigned neighbor with value v, we need x + v >= S => x >= S - v
                    min_allowed = 1
                    for nb in adj[cell]:
                        if nb in assign:
                            min_allowed = max(min_allowed, S - assign[nb])
                    # Choose the largest remaining number >= min_allowed
                    # Find candidate from remaining list
                    candidates = [x for x in remaining if x >= min_allowed]
                    if not candidates:
                        return None
                    x = max(candidates)  # largest possible
                    assign[cell]=x
                    remaining.remove(x)
                # after assignment, verify
                for cell in cells:
                    for nb in adj[cell]:
                        if assign[cell]+assign[nb] < S:
                            return None
                return assign
            
