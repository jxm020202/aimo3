            def reduce_random(k):
                # apply reductions randomly until none left
                import random
                while True:
                    candidates = [i for i in range(0,101) if k[i] >= 10]
                    if not candidates:
                        break
                    i = random.choice(candidates)
                    k[i] -= 10
                    k[i+1] += 1
                    k[i+2] += 1
                    k[i+3] += 1
                return k
            
            def canonical(k):
                # deterministic reduction
                changed=True
                while changed:
                    changed=False
                    for i in range(0,101):
                        while k[i]>=10:
                            k[i]-=10
                            k[i+1]+=1
                            k[i+2]+=1
                            k[i+3]+=1
                            changed=True
