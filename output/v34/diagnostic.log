            def find_best_triple(N):
                vecs=compute_vectors(N)
                A = np.array([[v[0] for v in vecs],
                              [v[1] for v in vecs],
                              [v[2] for v in vecs]], dtype=object)
                best = None
                best_tuple = None
                for i in range(N+1):
                    for j in range(i+1, N+1):
                        for k in range(j+1, N+1):
                            M = np.column_stack([A[:,i], A[:,j], A[:,k]])
                            # Solve M * x = target
                            # Use sympy rational solve
                            M_mat = sp.Matrix(M.tolist())
                            target = sp.Matrix([2025,0,0])
                            try:
                                sol = M_mat.LUsolve(target)  # returns rational matrix
                            except Exception as e:
                                continue
                            # Check if solution entries are non-negative integers
                            if all(val.is_integer and val >= 0 for val in sol):
                                total = sum(int(val) for val in sol)
                                if best is None or total < best:
                                    best = total
                                    best_tuple = (i,j,k, [int(val) for val in sol])
                return best, best_tuple
            
