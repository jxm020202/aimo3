            def max_product(a_vals, step=0.01):
                n=len(a_vals)
                best=0
                best_vec=None
                # generate all combinations of probabilities with step grid that sum to 1 approx.
                # For n=3, we can iterate p1 from 0 to 1 step, p2 from 0 to 1-p1 step, p3=1-p1-p2
                # For n>3, we can use random sampling.
                if n==2:
                    # analytic: max at p=0.5
                    p=0.5
                    A = p*a_vals[0]+(1-p)*a_vals[1]
                    B = p*(1/a_vals[0])+(1-p)*(1/a_vals[1])
                    return A*B, [p,1-p]
                elif n==3:
                    best=0
                    for p1 in np.arange(0,1+step,step):
                        for p2 in np.arange(0,1-p1+step,step):
                            p3=1-p1-p2
                            if p3< -1e-9: continue
                            A = p1*a_vals[0]+p2*a_vals[1]+p3*a_vals[2]
                            B = p1*(1/a_vals[0])+p2*(1/a_vals[1])+p3*(1/a_vals[2])
                            val=A*B
                            if val>best:
                                best=val
                                best_vec=[p1,p2,p3]
                    return best,best_vec
                else:
                    # random sampling
                    best=0
                    best_vec=None
                    for _ in range(200000):
                        probs=np.random.rand(n)
                        probs/=probs.sum()
                        A = np.dot(probs,a_vals)
                        B = np.dot(probs,1/np.array(a_vals))
                        val=A*B
                        if val>best:
                            best=val
                            best_vec=probs
                    return best,best_vec
            
