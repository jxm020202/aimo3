            def spiral_fill():
                m=n=60
                grid = np.zeros((m,n), dtype=int)
                num=1
                layer=0
                while layer < m//2:
                    # top row left->right
                    for j in range(layer, n-layer):
                        grid[layer,j]=num; num+=1
                    # right column top+1 -> bottom-1
                    for i in range(layer+1, m-layer):
                        grid[i, n-layer-1]=num; num+=1
                    # bottom row right-1 -> left (if bottom != top)
                    if m-layer-1 != layer:
                        for j in range(n-layer-2, layer-1, -1):
                            grid[m-layer-1, j]=num; num+=1
                    # left column bottom-1 -> top+1 (if left != right)
                    if n-layer-1 != layer:
                        for i in range(m-layer-2, layer, -1):
                            grid[i, layer]=num; num+=1
                    layer+=1
                return grid
            
