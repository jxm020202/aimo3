            def ratio(y):
                Y = sum(y)
                s = 0
                n = len(y)
                for i in range(n):
                    a = y[i]
                    b = y[(i+1)%n]
                    c = y[(i+2)%n]
                    g = math.gcd(a,b)
                    l = (b*c)//math.gcd(b,c)  # lcm
                    s += g*l
                return fractions.Fraction(Y**3, s)
            
            def min_ratio(limit):
                min_r = None
                min_tuple = None
                for y in itertools.product(range(1, limit+1), repeat=6):
                    if math.gcd(math.gcd(math.gcd(math.gcd(math.gcd(y[0], y[1]), y[2]), y[3]), y[4]), y[5]) != 1:
                        continue
                    r = ratio(y)
                    if min_r is None or r < min_r:
                        min_r = r
                        min_tuple = y
                return min_r, min_tuple
            
