            import sympy as sp, math
            
            def non3_part(c):
                n = c+1
                e = 0
                while n % 3 == 0:
                    n //= 3
                    e += 1
                return n, e
            
            def divisors(n):
                # returns sorted list of divisors
                fac = sp.factorint(n)
                divs = [1]
                for p,exp in fac.items():
                    current = list(divs)
                    for e in range(1, exp+1):
                        for d in current:
                            divs.append(d * (p**e))
                return sorted(divs)
            
            def h_bruteforce(m):
                best = None
                for a in range(1, m-1):
                    for b in range(a+1, m):
                        c = m - a - b
                        if c <= b:
                            continue
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                return best
            
            prime_ratio_cache = {}
            def ratio_of_number(m):
                # compute minimal ratio h(m)/m using divisor recursion
                # If m small compute directly
                if m <= 5000:
                    h_val = h_bruteforce(m)
                    return h_val / m
                # else compute via smallest prime factor with known ratio
                fac = sp.factorint(m)
                min_ratio = 1
                for p,exp in fac.items():
                    if p >= 6:
                        if p not in prime_ratio_cache:
