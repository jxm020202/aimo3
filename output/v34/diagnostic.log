            import itertools
            
            def count_outstanding(grid):
                R=len(grid)
                C=len(grid[0])
                count=0
                for r1 in range(R):
                    for r2 in range(r1, R):
                        for c1 in range(C):
                            for c2 in range(c1, C):
                                # rectangle S rows r1..r2, cols c1..c2
                                # find cells inside S
                                inside = [(i,j) for i in range(r1, r2+1) for j in range(c1, c2+1)]
                                # find outside cells that share a vertex with S
                                # cells not in S but adjacent (including diagonal) to any cell in S
                                outside=set()
                                for i,j in inside:
                                    for di in (-1,0,1):
                                        for dj in (-1,0,1):
                                            if di==0 and dj==0: continue
                                            ni=i+di; nj=j+dj
                                            if 0<=ni<R and 0<=nj<C and not (r1<=ni<=r2 and c1<=nj<=c2):
                                                outside.add((ni,nj))
                                # condition: every inside cell > every outside cell
                                if not outside:
                                    # no outside neighbor cells (only possible if grid is 1x1)
                                    cond=True
                                else:
                                    min_inside=min(grid[i][j] for i,j in inside)
                                    max_outside=max(grid[i][j] for i,j in outside)
                                    cond=min_inside>max_outside
                                if cond:
                                    count+=1
                return count
            
            def max_count_bruteforce(R,C,vals):
                maxc=0
                best=None
                for assignment in itertools.product(vals, repeat=R*C):
                    grid=[list(assignment[i*C:(i+1)*C]) for i in range(R)]
                    c=count_outstanding(grid)
                    if c>maxc:
                        maxc=c; best=grid
                return maxc,best
            
