            K = sp.factorial(2025)  # huge, but we won't use directly
            # We'll compute factorial modulo phi as needed.
            
            def factorial_mod(limit, mod):
                # compute product 1..limit modulo mod
                res = 1 % mod
                for i in range(2, limit+1):
                    res = (res * i) % mod
                return res
            
            def M_mod(d):
                # compute 3^{2025!} mod d
                # factor d
                fac = sp.factorint(d)
                residues = []
                moduli = []
                for p, a in fac.items():
                    mod = p**a
                    if p == 3:
                        # 3^{K} mod 3^a = 0 (since K >= a)
                        val = 0
                    else:
                        phi = (p-1) * p**(a-1)
                        e = factorial_mod(2025, phi)
                        # pow with exponent e
                        val = pow(3, e, mod)
                    residues.append(val)
                    moduli.append(mod)
                # combine using CRT
                if len(residues) == 1:
                    return residues[0] % moduli[0]
                else:
                    # use sympy.crt
                    x, lcm = sp.ntheory.modular.crt(moduli, residues)
                    return int(x % lcm)
            
