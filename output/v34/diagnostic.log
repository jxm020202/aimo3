            def generate_tuple(M_range=1000):
                M = random.randint(2, M_range)
                u = random.randint(1,5)
                v = random.randint(1,5)
                a = M*u
                b = M*v
                # choose c relatively prime to M
                while True:
                    c = random.randint(1, M_range)
                    if math.gcd(c, M) == 1:
                        break
                # others small
                others = [random.randint(1,5) for _ in range(3)]
                xs = [a,b,c] + others
                random.shuffle(xs)  # shuffle positions
                # ensure gcd overall =1
                g = xs[0]
                for v in xs[1:]:
                    g = math.gcd(g, v)
                if g != 1:
                    # divide by g maybe? but we want gcd=1
                    # we can just return None
                    return None
                return xs
            
