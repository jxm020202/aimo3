            def angle_TLC_with_C_XN(a_val,b_val):
                X=sp.Point(0,0)
                Y=sp.Point(a_val,0)
                Z=sp.Point(0,b_val)
                O=sp.Point(a_val/2,b_val/2)
                R_radius=sp.sqrt(a_val**2+b_val**2)/2
                line_tangent_X=sp.Line(X, X+sp.Point(b_val,-a_val))
                line_YZ=sp.Line(Y,Z)
                T=line_tangent_X.intersection(line_YZ)[0]
                N=sp.Point(a_val/2, (b_val - sp.sqrt(a_val**2+b_val**2))/2)
                circle=sp.Circle(O,R_radius)
                line_TN=sp.Line(T,N)
                pts=circle.intersection(line_TN)
                R = pts[0] if not pts[0].equals(N) else pts[1]
                # tangent at R
                OR = sp.Point(R) - O
                dir_tangent_R=sp.Matrix([OR.y, -OR.x])
                line_tangent_R=sp.Line(R, sp.Point(R.x+dir_tangent_R[0], R.y+dir_tangent_R[1]))
                # L intersection with XZ
                line_XZ=sp.Line(sp.Point(0,0), sp.Point(0,b_val))
                L=line_tangent_R.intersection(line_XZ)[0]
                # C: second intersection of line XN with circle
                line_XN=sp.Line(X,N)
                pts_XN = circle.intersection(line_XN)
                C = pts_XN[0] if not pts_XN[0].equals(X) else pts_XN[1]
                # angle at L between LT and LC
                vec_LT=sp.Matrix([T.x - L.x, T.y - L.y])
                vec_LC=sp.Matrix([C.x - L.x, C.y - L.y])
