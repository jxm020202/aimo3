            import sympy as sp, numpy as np, math, random, itertools, sys, time, warnings, sympy
            x_val = sp.symbols('x_val')
            y,z = sp.symbols('y z')
            def find_solutions_for_x(x0):
                sols = []
                # define equations
                eq1 = sp.Eq(y**2 + z**2, 3 - x0**2)
                eq2 = sp.Eq(x0*y**3 + y*z**3 + z*x0**3, 3)
                # solve using nsolve from multiple initial guesses
                for guess in [(random.uniform(-2,2), random.uniform(-2,2)) for _ in range(20)]:
                    try:
                        sol = sp.nsolve((eq1, eq2), (y,z), guess, tol=1e-14, maxsteps=100)
                        yv, zv = [float(sol[0]), float(sol[1])]
