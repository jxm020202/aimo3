            def snake_label(m,n):
                # generate order of cells along snake path
                order=[]
                for i in range(m):
                    row = [(i,j) for j in range(n)] if i%2==0 else [(i,j) for j in reversed(range(n))]
                    order.extend(row)
                # assign labels 1..N in this order
                label={}
                for idx,cell in enumerate(order):
                    label[cell]=idx+1
                return label
            
            def min_adj_sum(m,n,label):
                edges=[]
                for i in range(m):
                    for j in range(n):
                        if i+1<m: edges.append(((i,j),(i+1,j)))
                        if j+1<n: edges.append(((i,j),(i,j+1)))
                return min(label[u]+label[v] for u,v in edges)
            
            def test_grid(m,n):
                label=snake_label(m,n)
                return min_adj_sum(m,n,label)
            
            print(test_grid(4,6))
            
