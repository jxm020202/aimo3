            def max_angle_spread(alpha_deg=100, n=20):
                R=1.0
                alpha=math.radians(alpha_deg)
                # points on arc from -alpha/2 to alpha/2
                angles = np.linspace(-alpha/2, alpha/2, n)
                points = np.column_stack((np.cos(angles), np.sin(angles)))
                max_spread = 0
                for i, p in enumerate(points):
                    # compute direction angles from p to other points
                    vecs = points - p
                    # compute atan2
                    dirs = np.arctan2(vecs[:,1], vecs[:,0])
                    # exclude self (zero vector)
                    dirs = np.delete(dirs, i)
                    # normalize to [0, 2π)
                    dirs = np.mod(dirs, 2*math.pi)
                    # compute minimal angular interval covering all dirs (circular)
                    # sort
                    sorted_dirs = np.sort(dirs)
                    # compute gaps
                    gaps = np.diff(np.concatenate((sorted_dirs, [sorted_dirs[0]+2*math.pi])))
                    max_gap = np.max(gaps)
                    # minimal covering interval length = 2π - max_gap
                    spread = 2*math.pi - max_gap
                    max_spread = max(max_spread, spread)
                return max_spread
            
            print(max_angle_spread(100, n=20))
            
