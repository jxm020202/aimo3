            from scipy.optimize import milp, LinearConstraint, Bounds
            def feasible_grid(m,n,S):
                N=m*n
                # variable order: for each cell i (0..N-1), for each number k (1..N) -> index i*N + (k-1)
                var_count = N*N
                # constraints:
                A_eq = []
                b_eq = []
                # each cell assigned exactly one number
                for i in range(N):
                    row = np.zeros(var_count)
                    for k in range(N):
                        row[i*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each number assigned to exactly one cell
                for k in range(N):
                    row = np.zeros(var_count)
                    for i in range(N):
                        row[i*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # edge constraints
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx, (i+1)*n+j))
                        if j+1<n:
                            edges.append((idx, i*n+(j+1)))
                A_ub=[]
                b_ub=[]
                for (a,b) in edges:
                    row = np.zeros(var_count)
                    # -sum k*x_a_k - sum l*x_b_l <= -S
                    for k in range(N):
                        row[a*N + k] = -(k+1)
                        row[b*N + k] = -(k+1)
                    A_ub.append(row)
                    b_ub.append(-S)
                # convert to arrays
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                A_ub = np.array(A_ub)
                b_ub = np.array(b_ub)
                # bounds: binary variables 0/1
                bounds = Bounds(0,1)
                integrality = np.ones(var_count, dtype=int)
                # objective dummy zero
                c = np.zeros(var_count)
                res = milp(c=c, constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                                             LinearConstraint(A_ub, -np.inf, b_ub)],
                           bounds=bounds, integrality=integrality, options={'disp': False})
                return res.success
            
            print(feasible_grid(2,2,4))
            
