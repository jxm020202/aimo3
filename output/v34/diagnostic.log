            def compute_PT_length(sign):
                # sign = +1 for CCW left turn, -1 for CW right turn
                # angles in radians
                deg = sp.pi/180
                # direction angles
                angle_PQ = 0
                angle_QR = sign*105*deg
                angle_RS = sign*195*deg  # 105+90
                # compute coordinates
                Q = sp.Point(2,0)
                R = Q + sp.Point(sp.sqrt(2)*sp.cos(angle_QR), sp.sqrt(2)*sp.sin(angle_QR))
                S = R + sp.Point(sp.sqrt(2)*sp.cos(angle_RS), sp.sqrt(2)*sp.sin(angle_RS))
                # unknown phi for ST direction
                phi = sp.symbols('phi')
                T = S + sp.Point(sp.sqrt(2)*sp.cos(phi), sp.sqrt(2)*sp.sin(phi))
                # condition: T_x = 0 (vertical line through P)
                eq = sp.Eq(T.x, 0)
                # solve for cos(phi) maybe
                sol_cos = sp.solve(eq, sp.cos(phi))[0]
                # compute sin(phi) using identity, choose sign such that PT length positive (y coordinate sign)
                cos_phi = sol_cos
                sin_phi_sq = 1 - cos_phi**2
                # sin_phi = ±sqrt(...)
                sin_phi_pos = sp.sqrt(sin_phi_sq)
                sin_phi_neg = -sp.sqrt(sin_phi_sq)
                # compute PT length for both possibilities: PT = |T_y| (since P at (0,0))
