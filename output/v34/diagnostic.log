            def max_ones_no_2or3(n):
                N = n*n
                # variable order: first N x variables, then B y variables
                B = (n-1)*(n-1)
                total_vars = N + B
                # objective: maximize sum of x variables
                c = np.zeros(total_vars)
                c[:N] = -1  # milp minimizes, so negative for maximize
                
                # bounds: all variables binary 0/1
                bounds = Bounds(0, 1)
                
                # constraints: for each block, linear constraints
                A = []
                lb = []
                ub = []
                # mapping from (i,j) to index
                def idx(i,j):
                    return i*n + j
                block_idx = 0
                for i in range(n-1):
                    for j in range(n-1):
                        # sum of four x's
                        coeff = np.zeros(total_vars)
                        coeff[idx(i,j)] = 1
                        coeff[idx(i+1,j)] = 1
                        coeff[idx(i,j+1)] = 1
                        coeff[idx(i+1,j+1)] = 1
                        # y variable index
                        y_index = N + block_idx
                        # constraint s <= 1 + 3*y
                        coeff1 = coeff.copy()
                        coeff1[y_index] = -3  # bring to left: s - 3*y <= 1
                        A.append(coeff1)
                        ub.append(1)
                        lb.append(-np.inf)
                        # constraint s >= 4*y  => -s + 4*y <= 0
                        coeff2 = -coeff.copy()
                        coeff2[y_index] = 4
                        A.append(coeff2)
                        ub.append(0)
                        lb.append(-np.inf)
                        block_idx += 1
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                # variable integrality: all binary
                integrality = np.ones(total_vars, dtype=int)
                # Use milp
                res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("MILP failed", res.message)
                    return None
                x = res.x[:N]
                # round to nearest integer
                x_int = np.rint(x).astype(int)
                total = x_int.sum()
                return total, x_int.reshape((n,n))
                
            print(max_ones_no_2or3(4))
