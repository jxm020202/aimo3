            from fractions import Fraction
            def rational_solutions(limit):
                sols=[]
                for q in range(1,limit+1):
                    for p in range(0,q+1):
                        u=Fraction(p,q)
                        if u==0:
                            continue
                        val=10*u*u - 4
                        if val < 0:
                            continue
                        # check perfect square rational
                        num=val.numerator
                        den=val.denominator
                        if int(math.isqrt(num))**2!=num or int(math.isqrt(den))**2!=den:
                            continue
                        v=Fraction(math.isqrt(num), math.isqrt(den))
                        # two possible a
                        for sign in [1,-1]:
                            a = Fraction(1,5) + sign*v/5  # (1 ± v)/5
                            if a < 0 or a > 1:
                                continue
                            # compute b
                            b = Fraction(a+1, u) - 1
                            if b < 0 or b > 1:
                                continue
                            # compute x,y
                            x = Fraction(1,2) - a*a/2
                            y = Fraction(1,2) - b*b/2
                            # ensure positive rational
                            if x <= 0 or y <= 0:
                                continue
                            # compute denominators
                            denx = x.denominator
                            deny = y.denominator
                            k = sp.ilcm(denx, deny)  # lcm
                            sols.append((k, (x,y), (a,b), (u,v)))
                return sols
            
            sols = rational_solutions(30)
            len(sols)
            
