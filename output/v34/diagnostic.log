            def simulated_annealing(grid, initial_temp=1000, cooling=0.995, time_limit=30):
                n = grid.shape[0]
                best_grid = grid.copy()
                best_val = min_adjacent_sum_grid(grid)
                cur_grid = grid.copy()
                cur_val = best_val
                start = time.time()
                T = initial_temp
                it=0
                while time.time() - start < time_limit:
                    # random swap
                    i1,j1 = random.randrange(n), random.randrange(n)
                    i2,j2 = random.randrange(n), random.randrange(n)
                    if (i1,j1)==(i2,j2):
                        continue
                    # swap
                    cur_grid[i1,j1], cur_grid[i2,j2] = cur_grid[i2,j2], cur_grid[i1,j1]
                    new_val = min_adjacent_sum_grid(cur_grid)
                    delta = new_val - cur_val
                    if delta >= 0 or random.random() < math.exp(delta / T):
                        cur_val = new_val
                        if new_val > best_val:
                            best_val = new_val
                            best_grid = cur_grid.copy()
                    else:
                        # revert swap
                        cur_grid[i1,j1], cur_grid[i2,j2] = cur_grid[i2,j2], cur_grid[i1,j1]
                    # cool
                    T *= cooling
                    it+=1
                return best_grid, best_val, it
            
