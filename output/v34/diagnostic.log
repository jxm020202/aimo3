        ```python
import math

def pretty_pairs(alpha, k, max_m):
    """Return list of pretty pairs (m,n) with 1<=m,n<=max_m for given irrational alpha."""
    pretty = []
    for m in range(1, max_m+1):
        ceil_n_alpha = None
        # n must satisfy m+n > k, otherwise equation impossible
        for n in range(1, max_m+1):
            if m + n <= k:
                continue
            lhs = m * math.ceil(n * alpha) - n * math.floor(m * alpha)
            if lhs == k:
                pretty.append((m, n))
    return pretty

def cool_pairs(pretty):
    """Return the subset of pretty pairs that are cool."""
    pretty_set = set(pretty)
    cool = []
    for m, n in pretty:
        # check (m-n,n) and (m,n-m) are not pretty (must stay positive)
        if m-n > 0 and (m-n, n) in pretty_set:
            continue
        if n-m > 0 and (m, n-m) in pretty_set:
            continue
        cool.append((m, n))
    return cool

# Example with a concrete irrational alpha (sqrt(2))
alpha = math.sqrt(2)
k = 2310
max_m = 5000   # search up to this bound

pretty = pretty_pairs(alpha, k, max_m)
cool = cool_pairs(pretty)

print("Number of pretty pairs (up to", max_m, "):", len(pretty))
print("Number of cool pairs (up to", max_m, "):", len(cool))
