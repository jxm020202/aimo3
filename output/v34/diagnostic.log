            from fractions import Fraction
            x = Fraction(112,225)
            y = Fraction(8,25)
            def original_eq(x,y):
                import math
                # compute left side
                L = 1 + math.sqrt(1 - 2*float(y))
                # compute cube root sum
                A = (1 + float(x)**2)/2
                B = math.sqrt(9*float(x)**4 + (4*float(x)**6)/3 + 9 + 18*float(x)**2)/6
                def rcbrt(z):
                    return math.copysign(abs(z)**(1/3), z)
                cube = rcbrt(A+B) + rcbrt(A-B)
                # compute fraction term
                term = (4*float(x) - 2 + 2*math.sqrt(1 - 2*float(x))) / (3 - 5*float(x) - math.sqrt(1 - 2*float(x)))
                R = y + term + cube
                return L, R
            
            L,R = original_eq(x,y)
            L,R, L-R
            
