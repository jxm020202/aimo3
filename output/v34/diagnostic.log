            import math, itertools
            
            def f_bruteforce(n):
                best = None
                for k in range(1, 1000):  # search up to some bound
                    # get divisors
                    divs = [d for d in range(1, k+1) if k % d == 0]
                    # need three distinct divisors
                    for a,b,c in itertools.combinations(divs,3):
                        if a+b+c == n:
                            if best is None or k < best:
                                best = k
                                break
                    if best is not None and k>best:
                        break
                return best
            
            def f_formula(n):
                S = n-1
                # find largest divisor d < S/2, d>1, distinct from S-d
                # compute all divisors
                divs = [d for d in range(2, S) if S % d == 0]
                # filter d < S-d (i.e., d < S/2)
                cand = [d for d in divs if d < S - d]
                if not cand:
                    return None
                d_max = max(cand)
                return S - d_max
            
            for n in range(6, 30):
                bf = f_bruteforce(n)
                fm = f_formula(n)
                print(n, bf, fm, bf==fm)
            
