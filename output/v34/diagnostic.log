            def find_min_k(max_den=50):
                min_k = None
                best = None
                for b in range(1, max_den+1):
                    for a in range(1, b):
                        t = Fraction(a,b)
                        # compute RHS fraction for k^2
                        num = 2 * (t + 1)**2
                        den = 5*t**2 - 2*t + 1
                        if den == 0:
                            continue
                        frac = Fraction(num, den)
                        # check perfect square rational
                        if is_square(frac.numerator) and is_square(frac.denominator):
                            k = Fraction(int(math.isqrt(frac.numerator)), int(math.isqrt(frac.denominator)))
                            # compute x,y
                            x = Fraction(1,1) - t*t
                            x = x // 2 if False else Fraction(1,2)*(Fraction(1,1) - t*t)  # careful: (1 - t^2)/2
                            # Actually (1 - t^2)/2
                            x = Fraction(1 - t*t, 2)  # using Fraction arithmetic
                            A = Fraction((t+1)**2, 5*t*t - 2*t + 1)
                            y = k - A
                            if y <= 0:
                                continue
                            # compute k_min
                            k_min = sp.ilcm(x.denominator, y.denominator)
                            if min_k is None or k_min < min_k:
                                min_k = k_min
                                best = (k_min, x, y, t, k)
                return best
            
