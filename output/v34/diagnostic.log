            def factorial_mod(n, mod):
                res = 1
                for i in range(2, n+1):
                    res = (res * i) % mod
                return res
            
            def smallest_odd_prime_factor_of_5M_minus_1(limit_search=100000):
                # search primes > 2025
                for p in sp.primerange(2027, limit_search):
                    if p == 3:
