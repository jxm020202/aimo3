            def bfs_path(N):
                init = 0
                for i in range(N):
                    if i%2==0:  # odd position (1-index) tail
                        bit=0
                    else:
                        bit=1
                    init |= (bit<<i)
                target = (1<<N)-1
                from collections import deque
                visited = {}
                q = deque()
                # first move any position
                for pos in range(N):
                    state = init ^ (1<<pos)
                    steps = 1
                    key = (state,pos)
                    visited[key]=None
                    q.append((state,pos,steps))
                    if state==target:
                        return [pos+1]
                while q:
                    state,pos,steps = q.popleft()
                    for np in (pos-1,pos+1):
                        if 0<=np<N:
                            new_state = state ^ (1<<np)
                            key = (new_state,np)
                            if key not in visited:
