            import math
            
            def pretty_pairs(alpha, k, limit):
                pretty = set()
                for m in range(1, limit+1):
                    for n in range(1, limit+1):
                        if m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k:
                            pretty.add((m,n))
                return pretty
            
            def cool_pairs(alpha, k, limit):
                pretty = pretty_pairs(alpha, k, limit)
                cool = set()
                for (m,n) in pretty:
                    # check (m-n,n) and (m,n-m) not pretty
                    cond1 = (m-n, n) in pretty if m-n>0 else False
                    cond2 = (m, n-m) in pretty if n-m>0 else False
                    if not cond1 and not cond2:
                        cool.add((m,n))
                return cool
            
            def count_cool(alpha, k, limit):
                return len(cool_pairs(alpha, k, limit))
            
            def brute_counts(alpha, maxk, limit):
                res = {}
                for k in range(1, maxk+1):
                    res[k] = count_cool(alpha, k, limit)
                return res
            
