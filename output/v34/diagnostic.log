                # generate all compositions of Y into 6 positive ints (order matters)
                # Use recursion
                def rec(remaining, k, current):
                    nonlocal max_S, max_tuple
                    if k == 1:
                        if remaining >= 1:
                            y = current + [remaining]
                            S = sum(y[i] * y[(i+1)%6] * y[(i+2)%6] for i in range(6))
