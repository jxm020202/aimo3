            import random, math, numpy as np, itertools, sys, math, time, collections, sympy as sp, warnings, itertools, math, random, sys, numpy as np
            def random_point_on_sphere():
                # uniform on sphere radius sqrt(3)
                while True:
                    x = random.uniform(-2,2)
                    y = random.uniform(-2,2)
                    z = random.uniform(-2,2)
                    if x*x+y*y+z*z>0:
                        # scale to radius sqrt(3)
                        norm = math.sqrt(x*x+y*y+z*z)
                        factor = math.sqrt(3)/norm
                        return (x*factor, y*factor, z*factor)
            def f2_val(pt):
                x,y,z = pt
                return x*y**3 + y*z**3 + z*x**3
            # sample many points
