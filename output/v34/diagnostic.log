            import itertools, math
            
            def max_n(m):
                # m = number of squares per side (i.e., m x m squares)
                # grid points size = m+1
                size = m+1
                # generate all directed diagonals: each unit square (i,j) 0<=i<m,0<=j<m
                # four directions: (i,j)->(i+1,j+1), (i+1,j+1)->(i,j), (i+1,j)->(i,j+1), (i,j+1)->(i+1,j)
                diags = []
                for i in range(m):
                    for j in range(m):
                        # NE
                        diags.append(((i,j),(i+1,j+1)))
                        # SW opposite
                        diags.append(((i+1,j+1),(i,j)))
                        # SE (top-left to bottom-right)
                        diags.append(((i+1,j),(i,j+1)))
                        # NW opposite
                        diags.append(((i,j+1),(i+1,j)))
                # total
                N = len(diags)
                # compute pairwise constraints
                # We'll brute force for small m using backtracking
                best = 0
                best_set = None
                # sort maybe
                # Use simple recursive search with pruning based on heads conflict
                heads = [d[1] for d in diags]
                tails = [d[0] for d in diags]
                # Precompute conflict matrix: conflict if two edges cannot both be selected
                conflict = [[False]*N for _ in range(N)]
                for a in range(N):
                    for b in range(a+1,N):
                        # condition: allowed if heads distance >=2 OR head_a == tail_b OR head_b == tail_a
                        ha = heads[a]; hb = heads[b]; ta = tails[a]; tb = tails[b]
                        # compute Euclidean distance between heads
                        dist = math.hypot(ha[0]-hb[0], ha[1]-hb[1])
                        allowed = (dist >= 2 - 1e-9) or (ha == tb) or (hb == ta)
                        if not allowed:
                            conflict[a][b] = conflict[b][a] = True
                # backtracking
                order = list(range(N))
                # sort by maybe degree descending for pruning
                deg = [sum(conflict[i]) for i in range(N)]
                order.sort(key=lambda i: -deg[i])
                # map index to position in order
                # Use recursion
                best = 0
                best_set = []
                selected = [False]*N
                def dfs(idx, count):
                    nonlocal best, best_set
                    if idx == N:
                        if count > best:
                            best = count
                            best_set = [i for i in range(N) if selected[i]]
                        return
                    # upper bound: remaining possible = N-idx
                    if count + (N - idx) <= best:
                        return
                    i = order[idx]
                    # try include i if no conflict with already selected
                    can = True
                    for j in range(N):
                        if selected[j] and conflict[i][j]:
                            can = False
                            break
                    if can:
                        selected[i] = True
                        dfs(idx+1, count+1)
                        selected[i] = False
                    # skip i
                    dfs(idx+1, count)
                dfs(0,0)
                return best, best_set
            
            for m in range(1,5):
                best,_ = max_n(m)
                print(m, best)
            
