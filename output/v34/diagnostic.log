            def feasible_S(n, S):
                N = n*n
                # Build constraints
                num_vars = N*N
                # Build A matrix rows
                rows = []
                lbs = []
                ubs = []
                # cell assignment constraints (equality)
                for i in range(N):
                    row = np.zeros(num_vars, dtype=int)
                    for k in range(1,N+1):
                        idx = i*N + (k-1)
                        row[idx] = 1
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(1)
                # number assignment constraints (equality)
                for k in range(1,N+1):
                    row = np.zeros(num_vars, dtype=int)
                    for i in range(N):
                        idx = i*N + (k-1)
                        row[idx] = 1
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(1)
                # edge constraints: sum >= S -> -sum <= -S
                edges = []
                for r in range(n):
                    for c in range(n):
                        i = r*n + c
                        if r+1 < n:
                            edges.append((i, (r+1)*n + c))
                        if c+1 < n:
                            edges.append((i, r*n + (c+1)))
                for (i,j) in edges:
                    row = np.zeros(num_vars, dtype=int)
                    for k in range(1,N+1):
                        idx = i*N + (k-1)
                        row[idx] = -k
                    for l in range(1,N+1):
                        idx = j*N + (l-1)
                        row[idx] = -l
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(-S)
                A = np.vstack(rows)
                lbs = np.array(lbs, dtype=float)
                ubs = np.array(ubs, dtype=float)
                lin_con = opt.LinearConstraint(A, lbs, ubs)
                c = np.zeros(num_vars, dtype=int)
                bounds = opt.Bounds(0,1)
                integrality = np.ones(num_vars, dtype=int)
                res = opt.milp(c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'presolve': True, 'time_limit': 5})
                return res.success
            
            def max_S_grid_bruteforce(n):
                lo, hi = 2, 2*n*n
                best = lo
                while lo <= hi:
                    mid = (lo+hi)//2
                    feas = feasible_S(n, mid)
                    if feas:
                        best = mid
                        lo = mid+1
                    else:
                        hi = mid-1
                return best
            
