            def base_shift(N,d):
                points=set()
                for y in range(1,N+1):
                    x1=y
                    x2 = ((y + d -1) % N) + 1
                    points.add((x1,y))
                    points.add((x2,y))
                return points
            
            def row_sums(points,N):
                rows={}
                for x,y in points:
                    rows.setdefault(y,[]).append(x)
                sums=set()
                for y,xs in rows.items():
                    for a,b in itertools.combinations(xs,2):
                        sums.add(a+b)
                return sums
            
            def sum_parities(N,d):
                pts=base_shift(N,d)
                sums=row_sums(pts,N)
                odds=[s for s in sums if s%2==1]
                evens=[s for s in sums if s%2==0]
