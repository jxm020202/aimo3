            import itertools
            
            def count_outstanding(grid, rows, cols):
                # grid is list of values length rows*cols, row-major
                # compute outstanding rectangles count
                count=0
                # precompute neighbor sets for each rectangle
                for r1 in range(rows):
                    for r2 in range(r1, rows):
                        for c1 in range(cols):
                            for c2 in range(c1, cols):
                                # rectangle cells indices
                                inside = [(i,j) for i in range(r1, r2+1) for j in range(c1, c2+1)]
                                # outside cells that share a vertex with rectangle
                                outside=set()
                                for i in range(r1-1, r2+2):
                                    for j in range(c1-1, c2+2):
                                        if i<0 or i>=rows or j<0 or j>=cols:
                                            continue
                                        if r1<=i<=r2 and c1<=j<=c2:
                                            continue
                                        # check if shares a vertex: i in [r1-1, r2+1] and j in [c1-1, c2+1] and not both outside range? Actually any cell within one cell distance.
                                        # Already iterating over expanded box, so any cell not inside but within one cell distance qualifies.
                                        outside.add((i,j))
                                # compute min inside, max outside
                                min_inside = min(grid[i*cols+j] for i,j in inside)
                                max_outside = max(grid[i*cols+j] for i,j in outside) if outside else -float('inf')
                                if min_inside > max_outside:
                                    count+=1
                return count
            
