                ub[-1] = n-1
                # constraints: A x <= ub
                lin_con = LinearConstraint(A, -np.inf, ub)
                # integrality: all variables integer (0 or 1)
                integrality = np.ones(m, dtype=int)
                bounds = Bounds(0, 1)
                res = milp(c=c, constraints=lin_con, integrality=integrality, bounds=bounds, options={"presolve": True})
