            def max_black_no23(n):
                # rows are bitmask of n bits
                max_black = 0
                best_rows = None
                # Precompute popcount for masks
                popcnt = [bin(m).count('1') for m in range(1<<n)]
                # Precompute for each pair of rows (r1,r2) whether they are compatible (no 2/3 in any 2x2)
                compatible = {}
                for r1 in range(1<<n):
                    for r2 in range(1<<n):
                        ok = True
                        for j in range(n-1):
                            # bits: r1 at j, j+1; r2 at j, j+1
                            s = ((r1>>j)&1) + ((r1>>(j+1))&1) + ((r2>>j)&1) + ((r2>>(j+1))&1)
                            if s in (2,3):
                                ok = False
                                break
                        compatible[(r1,r2)] = ok
                # DFS
                def dfs(row_idx, prev_row, black_sofar, rows):
                    nonlocal max_black, best_rows
                    if row_idx == n:
                        # finished
                        if black_sofar > max_black:
                            max_black = black_sofar
                            best_rows = rows[:]
                        return
                    # iterate over possible current rows
                    for cur in range(1<<n):
                        # if row_idx>0 need compatibility with prev_row
                        if row_idx>0 and not compatible[(prev_row, cur)]:
                            continue
                        # also need to ensure that the 2x2 blocks formed with row above (prev_row) are okay; already checked.
                        # No need to check future rows yet.
                        # But also need to consider that we cannot have all black final board? We'll handle later.
                        dfs(row_idx+1, cur, black_sofar + popcnt[cur], rows+[cur])
                dfs(0, 0, 0, [])
                return max_black, best_rows
            
            for n in range(2,7):
                mb, rows = max_black_no23(n)
                print(n, mb)
            
