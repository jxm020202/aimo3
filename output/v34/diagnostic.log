            def max_edges_greedy(n):
                caps = [min(i, n-1) for i in range(1, n+1)]  # i from 1..n
                # Use list of (capacity, vertex) sorted descending
                total_edges = 0
                # We'll use a simple loop
                import heapq
                # Use max-heap (negative capacities)
                heap = [(-caps[i], i) for i in range(n)]
                heapq.heapify(heap)
                while heap:
                    cap, v = heapq.heappop(heap)
                    cap = -cap
                    if cap == 0:
                        break
                    # Need to connect v to cap other vertices with highest caps
                    # Extract next cap vertices
                    temp = []
                    for _ in range(cap):
                        if not heap:
                            # Not enough vertices to connect, break
                            break
                        c2, v2 = heapq.heappop(heap)
                        c2 = -c2
                        # connect v-v2
                        total_edges += 1
                        c2 -= 1
                        temp.append((c2, v2))
                    # after connecting, v's cap becomes 0
                    # push back the updated vertices
                    for c2, v2 in temp:
                        heapq.heappush(heap, (-c2, v2))
                    # v not pushed back (its cap now 0)
                return total_edges
            
            for n in range(2, 15):
                print(n, max_edges_greedy(n))
            
