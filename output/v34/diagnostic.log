            import itertools, math
            
            def domination_number(m,n):
                # brute force for small m,n
                cells = [(i,j) for i in range(m) for j in range(n)]
                # adjacency list
                adj = {}
                for i,j in cells:
                    neigh=[]
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            neigh.append((ni,nj))
                    adj[(i,j)]=neigh
                # we need a set D of cells such that every cell not in D is adjacent to some cell in D
                # but we need D to be subset of white cells? For domination of black cells by white cells, we restrict D to white cells.
                # Let's compute min size of white dominating set covering all black cells.
                white=[c for c in cells if (c[0]+c[1])%2==1]
                black=[c for c in cells if (c[0]+c[1])%2==0]
                for k in range(1,len(white)+1):
                    for combo in itertools.combinations(white,k):
                        covered=set()
                        for w in combo:
                            for nb in adj[w]:
                                if (nb[0]+nb[1])%2==0:
