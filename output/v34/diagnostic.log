            def bob_wins(W, B, N=5):
                # W and B are tuples (x,y) 0-indexed within N x N board
                # Return True if Bob has winning strategy (i.e., Alice cannot avoid)
                # Determine neighbors of W within board
                neighbors = []
                xw, yw = W
                for dx, dy in [(1,0),(-1,0),(0,1),(0,-1)]:
                    nx, ny = xw+dx, yw+dy
                    if 0 <= nx < N and 0 <= ny < N:
                        neighbors.append((nx,ny))
                # For each neighbor, check if B is adjacent to it
                for n in neighbors:
                    # Check if Manhattan distance between n and B is 1
                    if abs(n[0]-B[0]) + abs(n[1]-B[1]) != 1:
                        return False
                return True
            
