            import math
            
            def compute_angles_numeric(a,b):
                X = (0.0,0.0)
                Y = (a,0.0)
                Z = (0.0,b)
                O = (a/2.0, b/2.0)
                # tangent at X slope -a/b
                # line YZ: points Y (a,0) to Z (0,b)
                # Intersection T:
                # Solve y = -a/b x and y = -b/a x + b
                # compute as earlier
                denom = b*b - a*a
                T = (a*b*b/denom, -a*a*b/denom)
                # N: (a/2, (b - sqrt(a^2+b^2))/2)
                N = (a/2.0, (b - math.hypot(a,b))/2.0)
                # line TN param: T + t*(N-T)
                # find intersection with circle (center O radius R)
                R = math.hypot(a,b)/2.0
                # Solve quadratic for t where point P = T + t*(N-T) lies on circle
                dx = N[0] - T[0]
                dy = N[1] - T[1]
                # point P = (T.x + t*dx, T.y + t*dy)
                # distance squared to O = R^2
                # (T.x + t*dx - O.x)^2 + (T.y + t*dy - O.y)^2 = R^2
                # Expand quadratic At^2 + Bt + C = 0
                A = dx*dx + dy*dy
                B = 2*((T[0]-O[0])*dx + (T[1]-O[1])*dy)
                C = (T[0]-O[0])**2 + (T[1]-O[1])**2 - R*R
                # Solve
                disc = B*B - 4*A*C
                t1 = (-B + math.sqrt(disc)) / (2*A)
                t2 = (-B - math.sqrt(disc)) / (2*A)
                # t corresponding to N should be t=1 (since N = T + 1*(N-T)). Let's check.
                # Choose the other root for R.
                tR = t1 if abs(t1-1)>1e-6 else t2
                R_pt = (T[0] + tR*dx, T[1] + tR*dy)
                # tangent at R: direction perpendicular to radius OR
                # radius vector = R_pt - O
                rvx = R_pt[0] - O[0]
                rvy = R_pt[1] - O[1]
                # tangent direction = (-rvy, rvx)
                # line param: R_pt + s*(-rvy, rvx)
                # intersect with line XZ (x=0)
                # XZ line: points (0,0) to (0,b) => x=0
                # Solve for s where x-coordinate = 0: R_pt[0] + s*(-rvy) = 0 => s = -R_pt[0]/(-rvy) = R_pt[0]/rvy
                if abs(rvy) < 1e-12:
                    # vertical tangent? unlikely
                    s = 0
                else:
                    s = R_pt[0]/rvy
                L = (0.0, R_pt[1] + s*rvx)
                # compute angle TLC? we need point C. Not defined.
                # Let's compute angle T L X (TLX) and T L Z (TLZ) etc.
                def angle(p,q,r):
                    # angle at q formed by p-q-r
                    v1 = (p[0]-q[0], p[1]-q[1])
                    v2 = (r[0]-q[0], r[1]-q[1])
                    dot = v1[0]*v2[0] + v1[1]*v2[1]
                    norm1 = math.hypot(v1[0], v1[1])
                    norm2 = math.hypot(v2[0], v2[1])
                    return math.degrees(math.acos(dot/(norm1*norm2)))
                angle_TLX = angle(T, L, X)
                angle_TLZ = angle(T, L, Z)
                angle_TLY = angle(T, L, Y)
                return angle_TLX, angle_TLZ, angle_TLY, T, N, R_pt, L
            
