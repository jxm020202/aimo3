                                mask = np.ones_like(expanded, dtype=bool)
                                # compute indices offset
                                off_top = top - top2
                                off_left = left - left2
                                mask[off_top:off_top+ (bottom-top+1), off_left:off_left+(right-left+1)] = False
                                neighbor_vals = expanded[mask]
                                if neighbor_vals.size == 0:
                                    # whole grid
                                    count += 1
                                else:
