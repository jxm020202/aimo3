                # a[i][j] in {1,2}
                from itertools import product
                for vals in product([1,2], repeat=n*n):
                    a=[[None]*n for _ in range(n)]
                    it=iter(vals)
                    for i in range(n):
                        for j in range(n):
                            a[i][j]=next(it)
                    ok=True
                    for i in range(n):
                        for j in range(n):
                            # condition using modulo
                            lhs = a[(i+1)%n][j] + a[i][(j+1)%n]
                            rhs = 2*a[i][j]
                            if lhs!=rhs:
                                ok=False
                                break
                        if not ok:
                            break
                    if ok:
                        return a
                return None
            
            print(check_periodic(2))
            
