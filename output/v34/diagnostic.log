            def min_flips(N, delta_rows, delta_cols):
                # brute force over all matrices (2^(N*N) may be huge). For small N only.
                best = N*N+1
                for mask in range(1 << (N*N)):
                    # compute row and col parity
                    rows = [0]*N
                    cols = [0]*N
                    for i in range(N):
                        for j in range(N):
                            if (mask >> (i*N + j)) & 1:
                                rows[i] ^= 1
                                cols[j] ^= 1
                    if rows == delta_rows and cols == delta_cols:
                        weight = bin(mask).count('1')
                        if weight < best:
                            best = weight
                return best if best <= N*N else None
            
            def test_small(N):
                import itertools
                results=set()
                for dr in itertools.product([0,1], repeat=N):
                    for dc in itertools.product([0,1], repeat=N):
                        # need parity consistency: sum dr == sum dc (mod2)
                        if sum(dr)%2 != sum(dc)%2:
                            continue
                        minw = min_flips(N, list(dr), list(dc))
                        results.add((sum(dr), sum(dc), minw))
                return results
            
            print(test_small(2))
            
