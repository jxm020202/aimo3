                    else:
                        a=random.choice(white_cells)
                        b=random.choice(black_cells)
                    # swap
                    ai,aj=a; bi,bj=b
                    grid[ai][aj],grid[bi][bj]=grid[bi][bj],grid[ai][aj]
                    cur=compute_min(grid)
                    if cur>best:
                        best=cur
                        best_grid=[row[:] for row in grid]
                        # print progress
                        if best%10==0:
