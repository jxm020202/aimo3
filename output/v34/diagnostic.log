            def compute_vectors(N):
                # vectors as tuple (a,b,c) integers
                v = [(0,0,0)]*(N+1)
                v[0]=(1,0,0)
                if N>=1:
                    v[1]=(0,1,0)
                if N>=2:
                    v[2]=(0,0,1)
                for i in range(3,N+1):
                    a3,b3,c3 = v[i-3]
                    a1,b1,c1 = v[i-1]
                    a2,b2,c2 = v[i-2]
                    # v_i = 10 v_{i-3} - v_{i-1} - v_{i-2}
                    v[i] = (10*a3 - a1 - a2,
                            10*b3 - b1 - b2,
                            10*c3 - c1 - c2)
                return v
            
