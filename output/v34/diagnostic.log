            import numpy as np, math, itertools, sys, time, collections, random, math, itertools, functools, fractions, decimal, heapq, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_edges_ilp(N):
                # variables x_{i,j} for 0<=i<j<N
                m = N*(N-1)//2
                # map (i,j) to index
                idx = {}
                var_idx = 0
                for i in range(N):
                    for j in range(i+1,N):
                        idx[(i,j)] = var_idx
                        var_idx += 1
                c = np.ones(m, dtype=int)  # maximize sum of edges
                # constraints: for each vertex i, sum_{j != i} x_{i,j} <= i (or N-1 for last)
                A = []
                lb = []
                ub = []
                for i in range(N):
                    row = np.zeros(m, dtype=int)
                    for j in range(N):
                        if i==j: continue
                        a,b = (i,j) if i<j else (j,i)
                        row[idx[(a,b)]] = 1
                    A.append(row)
                    lb.append(-np.inf)
                    ub.append(i if i < N-1 else N-1)  # but i is 0-index; degree cap = i+1? Actually vertex number = i+1, cap = i+1 (except last vertex cap N-1)
                    # adjust: vertex number = i+1, cap = i+1 for i<N-1, cap = N-1 for i=N-1
                    cap = (i+1) if i < N-1 else N-1
                    ub[-1] = cap
                A = np.array(A)
                # bounds for variables: 0 <= x <= 1 integer
                bounds = Bounds(0, 1)
                # linear constraints
                lin_con = LinearConstraint(A, -np.inf*np.ones(N), np.array([ (i+1) if i<N-1 else N-1 for i in range(N) ]))
                # Use milp to maximize c^T x, but milp solves minimization; we can minimize -c^T x
                res = milp(c=-c, constraints=lin_con, bounds=bounds, integrality=np.ones(m, dtype=bool))
                if not res.success:
                    print("MILP failed")
                    return None
                edges = int(round(-res.fun))
                return edges
            
            print(max_edges_ilp(6))
            
