            def max_S_grid_milp_limit(m,n, time_limit=60):
                from scipy.optimize import milp, LinearConstraint, Bounds
                import numpy as np, math, itertools, sys, time
                V=m*n
                vertices=[(i,j) for i in range(m) for j in range(n)]
                edges=[]
                for i in range(m):
                    for j in range(n):
                        if i+1<m: edges.append(((i,j),(i+1,j)))
                        if j+1<n: edges.append(((i,j),(i,j+1)))
                num_vars=V*V+1
                c=np.zeros(num_vars)
                c[-1]=-1
                A=[]
                lb=[]
                ub=[]
                # vertex constraints
                for vi in range(V):
                    row=np.zeros(num_vars)
                    row[vi*V:(vi+1)*V]=1
                    A.append(row); lb.append(1); ub.append(1)
                # label constraints
                for k in range(V):
                    row=np.zeros(num_vars)
                    row[k::V]=1
                    A.append(row); lb.append(1); ub.append(1)
                # edge constraints
                for (u_coord,v_coord) in edges:
                    u_idx=vertices.index(u_coord)
                    v_idx=vertices.index(v_coord)
                    row=np.zeros(num_vars)
                    row[u_idx*V:(u_idx+1)*V] = np.arange(1,V+1)
                    row[v_idx*V:(v_idx+1)*V] = np.arange(1,V+1)
                    row[-1] = -1
                    A.append(row); lb.append(0); ub.append(np.inf)
                A_mat=np.vstack(A)
                lc=LinearConstraint(A_mat, lb, ub)
                lower=np.concatenate([np.zeros(V*V), [0]])
                upper=np.concatenate([np.ones(V*V), [2*V]])
                bounds=Bounds(lower, upper)
                integrality=np.ones(num_vars, dtype=int)
                start=time.time()
                res=milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={"disp": False, "maxiter": 1000000, "time_limit": time_limit})
                print("elapsed", time.time()-start)
                if not res.success:
                    return None
                return int(round(res.x[-1]))
            
            print(max_S_grid_milp_limit(4,6, time_limit=120))
            
