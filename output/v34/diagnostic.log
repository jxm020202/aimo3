            from fractions import Fraction
            solutions=[]
            max_den=20
            for b in range(1,max_den+1):
                for a in range(0,b+1):
                    p=Fraction(a,b)
                    if p>=1: continue
                    # compute D = 5p^2 - 2p + 1
                    D = Fraction(5*a*a, b*b) - Fraction(2*a, b) + 1
                    # check if D is twice a square rational: D/2 is square
                    # i.e., D*? Actually need D = 2 * r^2 => D/2 must be perfect square rational
                    if D <= 0: continue
                    val = D * Fraction(1,2)
                    # check if val is a perfect square rational: numerator and denominator perfect squares
                    num = val.numerator
                    den = val.denominator
                    import math, itertools
                    if int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den:
                        r = Fraction(math.isqrt(num), math.isqrt(den))
                        # compute q = (p+1)/r - 1
                        q = (p + 1) / r - 1
                        if q >= 0 and q < 1:
                            # compute x,y
                            x = Fraction(1,1) - p*p
                            x = x / 2
                            y = Fraction(1,1) - q*q
                            y = y / 2
                            if x > 0 and y > 0:
                                # compute minimal k = lcm(denominators of x and y)
                                from math import gcd
                                den_x = x.denominator
                                den_y = y.denominator
                                lcm = den_x * den_y // gcd(den_x, den_y)
                                solutions.append((lcm, p, q, x, y, r))
            solutions[:10]
            
