            def find_a(n, K=8):
                # compute residues modulo k!
                residues = []
                moduli = []
                S = 0
                for k in range(1, K+1):
                    S += k**(n-1) * math.factorial(k)
                    r = (-S) % math.factorial(k)
                    residues.append(r)
                    moduli.append(math.factorial(k))
                # Use CRT for nested moduli: we can just take the last modulus and residue, because they are compatible.
                a = residues[-1]  # modulo moduli[-1]
                # verify compatibility
                for k in range(1, K+1):
                    if a % math.factorial(k) != residues[k-1]:
                        print("incompatible at k", k)
                        return None
                return a
            
