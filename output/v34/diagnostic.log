            def count_cool_general(k,limit):
                cool = []
                for m in range(1, limit+1):
                    for n in range(1, limit+1):
                        if m + n <= k:
                            continue
                        g = math.gcd(m,n)
                        if (m - k) % g != 0:
                            continue
                        # condition for (m-n,n)
                        if m-n > 0:
                            g1 = math.gcd(m-n, n)
                            if ((m-n) - k) % g1 == 0:
                                continue
                        # condition for (m,n-m)
                        if n-m > 0:
                            g2 = math.gcd(m, n-m)
                            if (m - k) % g2 == 0:
                                continue
                        # also need to ensure (m-n,n) and (m,n-m) are positive pairs
                        # if m-n <=0 or n-m <=0, the condition automatically satisfied because pair not positive.
                        cool.append((m,n))
                return cool
            
            def count_cool_up_to(k,limit):
                return len(count_cool_general(k,limit))
            
            for k in range(1,11):
                print(k, count_cool_up_to(k,200))
            
