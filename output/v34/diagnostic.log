            def max_points_target(N, target):
                # backtrack to find set of size target satisfying constraints
                cells = [(x,y) for y in range(1,N+1) for x in range(1,N+1)]
                rows = {y: [] for y in range(1,N+1)}
                cols = {x: [] for x in range(1,N+1)}
                row_sum = {y: set() for y in range(1,N+1)}
                col_sum = {x: set() for x in range(1,N+1)}
                used_row_sums=set()
                used_col_sums=set()
                solution=None
                def backtrack(idx, selected):
                    nonlocal solution
                    if solution is not None:
                        return
                    if len(selected) == target:
                        solution = selected.copy()
                        return
                    # prune: remaining cells insufficient
                    if len(selected) + (len(cells)-idx) < target:
                        return
                    if idx==len(cells):
                        return
                    x,y = cells[idx]
                    # try include
                    can=True
                    new_row_sums=[]
                    for x2 in rows[y]:
                        s=x+x2
                        if s in used_row_sums and s not in row_sum[y]:
                            can=False
                            break
                        new_row_sums.append(s)
                    if can:
                        new_col_sums=[]
                        for y2 in cols[x]:
                            s=y+y2
                            if s in used_col_sums and s not in col_sum[x]:
                                can=False
                                break
                            new_col_sums.append(s)
                    if can:
                        # add
                        rows[y].append(x)
                        cols[x].append(y)
                        saved_row_set=row_sum[y].copy()
                        saved_col_set=col_sum[x].copy()
                        saved_used_row=used_row_sums.copy()
                        saved_used_col=used_col_sums.copy()
                        for s in new_row_sums:
                            row_sum[y].add(s)
                            used_row_sums.add(s)
                        for s in new_col_sums:
                            col_sum[x].add(s)
                            used_col_sums.add(s)
                        selected.add((x,y))
                        backtrack(idx+1, selected)
                        # revert
                        selected.remove((x,y))
                        rows[y].pop()
                        cols[x].pop()
                        row_sum[y]=saved_row_set
                        col_sum[x]=saved_col_set
                        used_row_sums.clear()
                        used_row_sums.update(saved_used_row)
                        used_col_sums.clear()
                        used_col_sums.update(saved_used_col)
                    # skip
                    backtrack(idx+1, selected)
                backtrack(0, set())
                return solution
            
