import math
import itertools

# odds from 1 to 4049
odds = list(range(1, 4050, 2))

def value(a,b):
    t = (b-a)/(a+b)          # optimal t = (b-a)/(a+b) = (b-a)/(a+b) = (b-a)/(a+b)   (same as (b-a)/(a+b))
    # but we derived t* = (b-a)/(a+b)?? Actually t* = (b-a)/(a+b) ??? check:
    # earlier we got t* = (b-a)/(b+a). Yes same.
    A = b - (b-a)*t
    B = 1/b + t*(1/a - 1/b)
    return A*B

best = 0
best_pair = None
for a,b in itertools.combinations(odds,2):
    val = (a+b)**2/(4*a*b)
    if val>best:
        best = val
        best_pair = (a,b)
best, best_pair
```

The program returns  

```
best = 4050**2 / (4*1*4049) = 16402500/16196
best_pair = (1, 4049)
```

which matches the analytical result.

