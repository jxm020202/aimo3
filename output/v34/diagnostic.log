            def construct_walk(N, c_edges, start):
                # c_edges list length N-1 of traversal counts
                # Build adjacency list with multiplicities
                adj = {i: [] for i in range(1,N+1)}
                for i, cnt in enumerate(c_edges, start=1):
                    for _ in range(cnt):
                        adj[i].append(i+1)
                        adj[i+1].append(i)
                # Hierholzer to find Eulerian circuit starting at start
                stack = [start]
                path = []
                while stack:
                    v = stack[-1]
                    if adj[v]:
                        u = adj[v].pop()
                        # remove the opposite direction edge
                        adj[u].remove(v)
                        stack.append(u)
                    else:
                        path.append(stack.pop())
                path.reverse()
                return path
            
