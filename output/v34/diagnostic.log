                # So row0 must be a sequence where adjacent differences are 1 or 2.
                # Also g(0,0)=0.
                # We'll generate all possible row0 sequences satisfying that and values non-negative up to max_val=2*(X+Y).
                max_val = 2*(X+Y)
                # generate all sequences recursively
                rows0 = []
                def gen_row(pos, seq):
                    if pos==X+1:
                        rows0.append(tuple(seq))
                        return
                    if pos==0:
                        seq.append(0)
                        gen_row(pos+1, seq)
                        seq.pop()
                    else:
                        prev = seq[-1]
                        # possible next values: prev+1, prev-1, prev+2, prev-2, but must be non-negative and <=max_val
                        for delta in (1, -1, 2, -2):
                            nxt = prev + delta
                            if 0 <= nxt <= max_val:
                                # also need that |prev - nxt| is 1 or 2 (by construction)
                                seq.append(nxt)
                                gen_row(pos+1, seq)
                                seq.pop()
                gen_row(0, [])
                # Now DP over rows
                # For each row tuple, we keep it as possible.
