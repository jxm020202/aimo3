            def feasible_with_limit(limit, max_i=30):
                v = compute_vectors(max_i)
                A = np.array([[vec[0] for vec in v],
                              [vec[1] for vec in v],
                              [vec[2] for vec in v]], dtype=np.int64)
                b = np.array([2025,0,0], dtype=np.int64)
                c = np.ones(max_i+1, dtype=np.int64)
                # Add constraint sum <= limit
                # We'll add as extra linear constraint: sum k_i <= limit
                # Use LinearConstraint with Aeq and Aineq? SciPy's LinearConstraint can handle bounds only; we can add extra row to A with inequality.
                # But LinearConstraint only handles bounds (lb <= Ax <= ub). So we can set lb = -inf, ub = limit for the sum row.
                sum_row = np.ones(max_i+1, dtype=np.int64)
                A2 = np.vstack([A, sum_row])
                b_low = np.array([2025,0,0,-np.inf])  # lower bounds for each row
                b_up = np.array([2025,0,0,limit])    # upper bounds
                lincon = LinearConstraint(A2, b_low, b_up)
                bounds = Bounds(0, np.inf)
                integrality = np.ones_like(c, dtype=int)
                res = milp(c=c, integrality=integrality, bounds=bounds, constraints=[lincon])
                return res.success, res.fun if res.success else None
            
            for limit in range(30,45):
                success, fun = feasible_with_limit(limit, max_i=30)
                print(limit, success, fun)
            
