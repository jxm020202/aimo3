            def construct_max_edges(n):
                # caps: degree upper bounds
                caps = [i for i in range(1,n)] + [n-1]  # length n
                # sort descending with vertex ids
                # We'll use list of (remaining_cap, vertex_id)
                import heapq
                # Use max-heap
                heap = [(-c, i) for i,c in enumerate(caps)]
                heapq.heapify(heap)
                edges = 0
                # adjacency not needed, just count edges
                while heap:
                    c, v = heapq.heappop(heap)
                    d = -c
                    if d == 0:
                        continue
                    # need to connect to d other vertices with highest caps
                    # pop next d vertices
                    temp = []
                    for _ in range(d):
                        if not heap:
                            # cannot satisfy, break
                            break
                        c2, v2 = heapq.heappop(heap)
                        d2 = -c2
                        # connect v with v2
                        edges += 1
                        d2 -= 1
                        temp.append(( -d2, v2))
                    # after connecting, v's degree satisfied (reduced to 0)
                    # push back modified vertices
                    for item in temp:
                        heapq.heappush(heap, item)
                return edges
            
