            def max_edges_given_caps(caps):
                # caps list of capacities for vertices indexed 0..n-1
                # Use greedy algorithm: sort vertices by remaining caps descending each iteration
                # We'll use a priority queue (max-heap) of (remaining_cap, vertex)
                import heapq
                # Use negative for max-heap
                heap = [(-c, i) for i, c in enumerate(caps) if c > 0]
                heapq.heapify(heap)
                edges = 0
                while len(heap) >= 2:
                    # pop vertex with largest cap
                    c1, v1 = heapq.heappop(heap)
                    c1 = -c1
                    if c1 == 0:
                        break
                    # Need to connect v1 to c1 other vertices with highest caps
                    # If not enough vertices, connect to all remaining
                    partners = []
                    for _ in range(min(c1, len(heap))):
                        c2, v2 = heapq.heappop(heap)
                        c2 = -c2
                        # create edge v1-v2
                        edges += 1
                        c2 -= 1
                        if c2 > 0:
                            partners.append((-c2, v2))
                    # after connecting, v1's remaining cap becomes 0 (since we used all its capacity)
                    # push back remaining partners
                    for item in partners:
                        heapq.heappush(heap, item)
                    # v1 may still have leftover capacity if not enough partners (should not happen if caps are feasible)
                    # but we ignore leftover because cannot be satisfied
                return edges
            
            n=7671
            caps = [min(i, n-1) for i in range(1, n+1)]
            edges = max_edges_given_caps(caps)
            edges
            
