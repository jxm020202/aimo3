            def backtrack(cells, adj, values, S, assign, idx):
                if idx==len(cells):
                    return assign
                cell=cells[idx]
                # compute min allowed based on assigned neighbors
                min_allowed=1
                for nb in adj[cell]:
                    if nb in assign:
                        min_allowed = max(min_allowed, S - assign[nb])
                # iterate over remaining values >= min_allowed, maybe try larger first
