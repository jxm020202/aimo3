            for _ in range(200000):
                pt = random_point_on_sphere()
                val = f2_val(pt)
                if abs(val-3) < 1e-4:
                    close.append(pt)
                vals.append(val)
            min_val = min(vals)
            max_val = max(vals)
            min_val, max_val
            
