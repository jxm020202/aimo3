            def max_edges_ilp(n):
                # variable ordering: edges (i,j) for i<j
                edge_idx = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1,n):
                        edge_idx[(i,j)] = idx
                        idx += 1
                m = idx
                # variables: x edges (binary), y private edge (binary) for each edge, and z for each triple (i,j,w) where i<j, w != i,j
                # We'll create variable list and constraints.
                # Use MILP (scipy) which expects c vector and constraints.
                # We'll build matrices in dense format for simplicity for small n.
                # variable order: first x (m), then y (m), then z (for each (i,j,w) with i<j, w!=i,j)
                triples = []
