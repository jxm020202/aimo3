                        coeff[var_index_NE(ii-1, jj-1)] = coeff.get(var_index_NE(ii-1, jj-1),0) + 1
                    if ii>0 and jj< N:
                        coeff[var_index_SE(ii-1, jj)] = coeff.get(var_index_SE(ii-1, jj),0) + 1
                    # subtract x_NE[i,j] on RHS: we want incoming(i,j)+incoming(i+1,j+1) - x_NE[i,j] <= 1
