            import itertools, math
            
            def count_outstanding(grid, n, m):
                # grid is list of length n*m values
                # reshape as matrix
                mat = [grid[i*m:(i+1)*m] for i in range(n)]
                # precompute neighbor adjacency for each rectangle
                count = 0
                # iterate over all rectangles: top row r1, bottom row r2 inclusive, left c1, right c2 inclusive
                for r1 in range(n):
                    for r2 in range(r1, n):
                        for c1 in range(m):
                            for c2 in range(c1, m):
                                # compute min inside
                                min_inside = min(mat[i][j] for i in range(r1, r2+1) for j in range(c1, c2+1))
                                # compute max of adjacent outside cells that share a vertex
                                max_out = -math.inf
                                # iterate over cells outside rectangle that are adjacent (share a vertex)
                                # cells (i,j) such that i in [r1-1, r2+1], j in [c1-1, c2+1] and not inside rectangle
                                for i in range(max(0, r1-1), min(n, r2+2)):
                                    for j in range(max(0, c1-1), min(m, c2+2)):
                                        if r1 <= i <= r2 and c1 <= j <= c2:
                                            continue
                                        # check if cell shares a vertex: i is adjacent row (difference <=1) and j adjacent col (<=1)
                                        # Already limited to those ranges, so they are adjacent
                                        # But need to ensure they are actually adjacent to rectangle (i.e., distance 1 from rectangle)
                                        # Since we limited to one layer around rectangle, all are adjacent.
                                        max_out = max(max_out, mat[i][j])
                                # For rectangles that touch border, some neighbor cells may be missing; then max_out stays -inf?
                                # In that case, condition trivially holds? Actually condition says "each cell outside S that shares a common vertex with S". If none, then vacuously true.
                                if max_out == -math.inf:
                                    # no adjacent outside cells (only possible if rectangle is whole grid)
                                    count += 1
                                else:
                                    if min_inside > max_out:
                                        count += 1
                return count
            
            def max_outstanding_for_size(n,m):
                N = n*m
                maxc = -1
                best = None
                for perm in itertools.permutations(range(N)):
                    c = count_outstanding(perm, n, m)
