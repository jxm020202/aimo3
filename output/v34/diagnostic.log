            def greedy_representation(target, r, max_power=30):
                powers = [r**i for i in range(max_power, -1, -1)]
                coeffs = [0]*(max_power+1)
                remaining = target
                for idx, p in enumerate(powers):
                    i = max_power - idx
                    coeff = int(math.floor(remaining / p))
                    coeffs[i] = coeff
                    remaining -= coeff * p
                return coeffs, remaining
            
