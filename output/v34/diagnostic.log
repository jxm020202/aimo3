            def max_steps_seq(n):
                init = tuple(range(1,n+1))
                from functools import lru_cache
                @lru_cache(None)
                def dfs(state):
                    best = (0, [])
                    m=len(state)
                    for i in range(m):
                        if state[i]==0: continue
                        for j in range(i+1,m):
                            if state[j]==0: continue
                            g=gcd(state[i],state[j])
                            new=list(state)
                            new[i]-=g
                            new[j]-=g
                            newt=tuple(new)
                            steps, seq = dfs(newt)
                            if 1+steps > best[0]:
                                best = (1+steps, [(i,j)]+seq)
                    return best
                return dfs(init)
            
