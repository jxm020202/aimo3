            import math
            
            def is_pretty_fast(m,n,k):
                RHS = k - m
                if n <= RHS:
                    return False
                d = math.gcd(m,n)
                if RHS % d != 0:
                    return False
                m1 = m // d
                n1 = n // d
                RHS1 = RHS // d
                # extended Euclid
                def egcd(a,b):
                    if b==0:
                        return (1,0,a)
                    x1,y1,g = egcd(b, a%b)
                    return (y1, x1 - (a//b)*y1, g)
                u,v,g = egcd(m1, n1)  # u*m1 + v*n1 = 1
                b0 = u * RHS1
                a0 = -v * RHS1
                # t range
                t_min = math.ceil(max((-a0)/m1, (-b0)/n1))
                t_max = math.floor(min((m - 1 - a0)/m1, (n - 1 - b0)/n1))
                return t_min <= t_max
            
