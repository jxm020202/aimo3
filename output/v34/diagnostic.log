            def find_solutions_grid(num_steps=401):
                sols = set()
                xs = np.linspace(-math.sqrt(3), math.sqrt(3), num_steps)
                for x in xs:
                    # define function f(y) = xy^3 + y*z^3 + z*x^3 -3, where z = sqrt(3 - x^2 - y^2)
                    def f(y):
                        if y*y > 3 - x*x:  # then z^2 negative
                            return None
                        z = math.sqrt(max(0.0, 3 - x*x - y*y))
                        return x*y**3 + y*z**3 + z*x**3 - 3
                    # search for y in [-sqrt(3 - x^2), sqrt(3 - x^2)]
                    y_max = math.sqrt(max(0.0, 3 - x*x))
                    # sample y grid
                    ys = np.linspace(-y_max, y_max, num_steps)
                    # find sign changes
                    prev_val = None
                    prev_y = None
                    for y in ys:
                        val = f(y)
                        if val is None:
                            continue
                        if prev_val is not None and val*prev_val <= 0:
