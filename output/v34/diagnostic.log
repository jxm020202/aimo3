            def construct_graph_edges(n):
                caps = [i for i in range(1,n)] + [n-1]
                # adjacency list
                adj = [[] for _ in range(n)]
                import heapq
                # max-heap of (remaining_cap, vertex)
                heap = [(-c, v) for v,c in enumerate(caps) if c>0]
                heapq.heapify(heap)
                while heap:
                    c, v = heapq.heappop(heap)
                    d = -c
                    if d == 0:
                        continue
                    # collect up to d other vertices with positive degree
                    temp = []
                    connections = 0
                    for _ in range(d):
                        if not heap:
                            break
                        c2, v2 = heapq.heappop(heap)
                        d2 = -c2
                        if d2 == 0:
                            continue
                        # connect v with v2
                        adj[v].append(v2)
                        adj[v2].append(v)
                        connections += 1
                        d2 -= 1
                        if d2 > 0:
                            temp.append((-d2, v2))
                    # leftover degree of v not used
                    for item in temp:
                        heapq.heappush(heap, item)
                # convert adjacency to edge list (i<j)
                edges = []
                for i in range(n):
                    for j in adj[i]:
                        if i<j:
                            edges.append((i,j))
                return edges
            
            def schedule_ops(n, edges):
                # counts start as i+1 (since vertices 0..n-1 correspond to piles 1..n)
                counts = [i+1 for i in range(n)]
                # adjacency list for remaining edges
                remaining = {e: True for e in edges}
                ops = 0
                # simple greedy: while any edge with gcd=1 exists
                while True:
                    found=False
                    for (i,j) in list(remaining.keys()):
                        if counts[i]==0 or counts[j]==0:
                            del remaining[(i,j)]
                            continue
                        if math.gcd(counts[i], counts[j])==1:
                            # perform operation
                            counts[i]-=1
                            counts[j]-=1
                            del remaining[(i,j)]
                            ops+=1
                            found=True
                            break
                    if not found:
                        break
                return ops, counts, remaining
            
            import math
            for n in range(5,13):
                edges = construct_graph_edges(n)
                ops, counts, rem = schedule_ops(n, edges)
                print(n, len(edges), ops)
            
