            def rank_mod2(mat):
                A=mat.copy()
                rows, cols = A.shape
                rank=0
                col=0
                while col<cols and rank<rows:
                    # find pivot row with 1 in column col at or below rank
                    pivot = None
                    for r in range(rank, rows):
                        if A[r,col]==1:
                            pivot=r
                            break
                    if pivot is None:
                        col+=1
                        continue
                    # swap pivot row with current rank row
                    if pivot!=rank:
                        A[[pivot, rank]]=A[[rank, pivot]]
                    # eliminate below
                    for r in range(rows):
                        if r!=rank and A[r,col]==1:
                            A[r,:]^=A[rank,:]  # xor
                    rank+=1
                    col+=1
