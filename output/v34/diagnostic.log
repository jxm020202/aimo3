            def max_edges_greedy(n):
                caps = [i for i in range(1,n)] + [n-1]
                # list of remaining degrees
                # We'll maintain a list of vertices with remaining degree >0
                import heapq
                heap = [(-c, i) for i,c in enumerate(caps) if c>0]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    c, v = heapq.heappop(heap)
                    d = -c
                    if d == 0:
                        continue
                    # collect up to d other vertices with positive degree
                    temp = []
                    connections = 0
                    for _ in range(d):
                        if not heap:
                            break
                        c2, v2 = heapq.heappop(heap)
                        d2 = -c2
                        if d2 == 0:
                            continue
                        # connect v with v2
                        edges += 1
                        connections += 1
                        d2 -= 1
                        if d2 > 0:
                            temp.append((-d2, v2))
                    # after trying to connect, v may have leftover degree (d - connections) unused
                    # we discard leftover (cannot be used)
                    # push back modified vertices
                    for item in temp:
                        heapq.heappush(heap, item)
                return edges
            
            for n in range(2,15):
                print(n, max_edges_greedy(n))
            
