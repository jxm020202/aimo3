            import math, itertools
            
            def pretty_pairs(alpha, k, limit):
                pairs = []
                for m in range(1, limit+1):
                    ceil_nalpha = lambda n: math.ceil(n*alpha)
                    floor_malpha = math.floor(m*alpha)
                    # compute floor(m*alpha) once
                    fm = floor_malpha
                    for n in range(1, limit+1):
                        if m*math.ceil(n*alpha) - n*fm == k:
                            pairs.append((m,n))
                return pairs
            
            def pretty_pairs_fast(alpha, k, limit):
                # Use derived formula: m*ceil(nα) - n*floor(mα) = k
                # Since α irrational, ceil = floor+1
                # So condition: m*(floor(nα)+1) - n*floor(mα) = k
                # => m*floor(nα) - n*floor(mα) = k - m
                pairs=[]
                floor_malpha = {}
                for m in range(1, limit+1):
                    floor_malpha[m]=math.floor(m*alpha)
                for m in range(1, limit+1):
                    fm = floor_malpha[m]
                    for n in range(1, limit+1):
                        fn = math.floor(n*alpha)
                        if m*fn - n*fm == k - m:
                            pairs.append((m,n))
                return pairs
            
            def cool_pairs(alpha, k, limit):
                pretty = set(pretty_pairs_fast(alpha,k,limit))
                cool=[]
                for (m,n) in pretty:
                    cond1 = (m-n, n) in pretty
                    cond2 = (m, n-m) in pretty
                    if not cond1 and not cond2:
                        cool.append((m,n))
                return cool
            
            alpha = math.sqrt(2)
            k=2310
            pairs = pretty_pairs_fast(alpha,k,2000)
            len(pairs)
            
