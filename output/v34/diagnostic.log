                random.shuffle(high_numbers)
                grid=[[0]*n for _ in range(m)]
                for (i,j),num in zip(black_cells, low_numbers):
                    grid[i][j]=num
                for (i,j),num in zip(white_cells, high_numbers):
                    grid[i][j]=num
                # compute min adjacent sum
                def compute_min(grid):
                    m=len(grid); n=len(grid[0])
                    min_s=10**9
                    for i in range(m):
                        for j in range(n):
                            v=grid[i][j]
                            if i+1<m:
                                min_s=min(min_s, v+grid[i+1][j])
                            if j+1<n:
                                min_s=min(min_s, v+grid[i][j+1])
                    return min_s
                best=compute_min(grid)
                best_grid=[row[:] for row in grid]
                start=time.time()
                for it in range(iterations):
                    # pick two cells of opposite colors to swap
                    if random.random()<0.5:
