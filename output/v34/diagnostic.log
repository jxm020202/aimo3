            import math
            from fractions import Fraction
            def find_solutions(limit):
                sols = []
                for b in range(1, limit+1):
                    for a in range(1, b):  # a<b
                        # compute fraction F = 2*(a+b)^2 / (5 a^2 - 2 a b + b^2)
                        num = 2*(a+b)**2
                        den = 5*a*a - 2*a*b + b*b
                        if den <= 0:
                            continue
                        g = math.gcd(num, den)
                        N = num//g
                        D = den//g
                        # check if N and D are perfect squares
                        sqrtN = int(math.isqrt(N))
                        sqrtD = int(math.isqrt(D))
                        if sqrtN*sqrtN == N and sqrtD*sqrtD == D:
                            # then sqrt(2A) = sqrt(N/D) = sqrtN/sqrtD
                            p = sqrtN
                            q = sqrtD
                            # compute x, y rational
                            x = Fraction(b*b - a*a, 2*b*b)  # simplify automatically
                            A = Fraction(a*a + 2*a*b + b*b, 5*a*a - 2*a*b + b*b)
                            r = Fraction(p, q)  # sqrt(2A)
                            y = r - A
                            if y > 0:
                                # compute k = lcm(denominator of x, denominator of y)
                                den_x = x.denominator
                                den_y = y.denominator
                                k = den_x * den_y // math.gcd(den_x, den_y)
                                sols.append((k, a, b, x, y, r))
                return sols
            
            sols = find_solutions(50)
            len(sols)
            
