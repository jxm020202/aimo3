            from fractions import Fraction
            import math
            
            def is_perfect_square(n):
                if n < 0:
                    return False
                r = int(math.isqrt(n))
                return r*r == n
            
            def find_min_k(limit_q=30):
                min_k = None
                best = None
                for q in range(1, limit_q+1):
                    for p in range(0, q+1):  # s between 0 and 1 inclusive
                        # s = p/q
                        # ensure reduced fraction
                        if math.gcd(p,q)!=1:
                            continue
                        s = Fraction(p, q)
                        # compute D = 5 s^2 - 2 s + 1
                        D = Fraction(5*s*s - 2*s + 1)
                        # compute Q = 2*(s+1)^2 / D
                        Q = Fraction(2)*(s+1)*(s+1) / D
                        # Q must be positive rational
                        if Q <= 0:
                            continue
                        # check if Q is a perfect square rational: numerator and denominator perfect squares
                        num = Q.numerator
                        den = Q.denominator
                        if is_perfect_square(num) and is_perfect_square(den):
                            # then sqrt(Q) rational
                            sqrtQ = Fraction(int(math.isqrt(num)), int(math.isqrt(den)))
                            # compute t = sqrtQ - 1
                            t = sqrtQ - 1
                            # t must be >=0 (since sqrt(1-2y) nonnegative)
                            if t < 0:
                                continue
                            # compute y = (1 - t^2)/2
