            import random, itertools, math, time
            
            def count_outstanding_fast(grid):
                R=len(grid); C=len(grid[0])
                cnt=0
                for r1 in range(R):
                    for r2 in range(r1,R):
                        for c1 in range(C):
                            for c2 in range(c1,C):
                                min_inside = min(grid[i][j] for i in range(r1,r2+1) for j in range(c1,c2+1))
                                max_border = -1
                                for i in range(r1-1, r2+2):
                                    for j in range(c1-1, c2+2):
                                        if 0<=i<R and 0<=j<C:
                                            if not (r1<=i<=r2 and c1<=j<=c2):
                                                max_border = max(max_border, grid[i][j])
                                if min_inside > max_border:
                                    cnt+=1
                return cnt
            
            def hill_climb(R,C,steps=2000):
                N=R*C
                perm=list(range(N))
                random.shuffle(perm)
                grid=[perm[i*C:(i+1)*C] for i in range(R)]
                bestcnt=count_outstanding_fast(grid)
                bestgrid=[row[:] for row in grid]
                for step in range(steps):
                    i1,j1 = random.randrange(R), random.randrange(C)
                    i2,j2 = random.randrange(R), random.randrange(C)
                    if i1==i2 and j1==j2: continue
                    # swap
                    grid[i1][j1], grid[i2][j2] = grid[i2][j2], grid[i1][j1]
                    cnt=count_outstanding_fast(grid)
                    if cnt>bestcnt:
                        bestcnt=cnt
                        bestgrid=[row[:] for row in grid]
                    else:
                        # revert
                        grid[i1][j1], grid[i2][j2] = grid[i2][j2], grid[i1][j1]
                return bestcnt, bestgrid
            
            def estimate_best(R,C,iterations=3,steps=3000):
                best=0
                for _ in range(iterations):
                    cnt,_=hill_climb(R,C,steps=steps)
                    best=max(best,cnt)
                return best
            
