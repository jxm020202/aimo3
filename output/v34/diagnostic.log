            def compatible(a, b, length=17):
                # ensure bits within length
                mask = (1 << length) - 1
                # shift b left and right, mask to length bits
                b_left = (b << 1) & mask
                b_right = b >> 1
                return (a & b) == 0 and (a & b_left) == 0 and (a & b_right) == 0
            
