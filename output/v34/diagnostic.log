            def find_a_mod_factorial(n, K):
                # compute a modulo K! that satisfies conditions up to K
                a_mod = 0
                for k in range(1, K+1):
                    S = sum(math.factorial(i) * (i**(n-1)) for i in range(1, k+1))
                    r = (-S) % math.factorial(k)
                    # check consistency
                    if k > 1:
                        if r % math.factorial(k-1) != a_mod % math.factorial(k-1):
                            raise ValueError("inconsistent")
                    a_mod = r
                return a_mod
            
