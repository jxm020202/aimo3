            def t_min_real(d):
                # minimal non-zero coefficients for a degree-d real-rooted polynomial with non-zero constant term
                if d % 2 == 0:
                    return d//2 + 1
                else:
                    return d//2 + 2  # floor(d/2)+2
            
            def t_min_cover(d):
                L = 4047 - d
                # need L >=1
                if L <= 0:
                    return float('inf')
                return (d + 1 + L - 1)//L  # ceil((d+1)/L)
            
            def max_r_plus_s():
                best = -1
                best_d = None
                best_t = None
                for d in range(0, 4047):
