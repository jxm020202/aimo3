            def feasible_S(S, m=60, n=60):
                # assign high numbers to white cells descending (any order)
                white_cells=[(i,j) for i in range(m) for j in range(n) if (i+j)%2==1]
                # assign high numbers descending to white cells in row-major order
                high_numbers=list(range((m*n)//2 + 1, m*n+1))  # 1801..3600
                high_numbers.sort(reverse=True)
                grid=[[None]*n for _ in range(m)]
                for (i,j),h in zip(white_cells, high_numbers):
                    grid[i][j]=h
                # compute requirement for each black cell
                black_cells=[(i,j) for i in range(m) for j in range(n) if (i+j)%2==0]
                req=[]
                for (i,j) in black_cells:
                    max_req=1
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            h=grid[ni][nj]
                            # need low >= S - h
                            thr=S - h
                            if thr>max_req:
                                max_req=thr
                    if max_req<1: max_req=1
                    req.append(max_req)
                req.sort()
                # check feasibility: for i from 1..len(req), need req[i-1] <= i
                for idx, r in enumerate(req, start=1):
                    if r > idx:
                        return False, idx, r
                return True, None, None
            
