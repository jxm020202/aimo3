            def max_zeros_general(N):
                max_overall = -1
                best = None
                coeffs = [-2,-1,0,1,2]
                for d in range(N+1):
                    Lg = d+1
                    Ld = N-d+1
                    for g in itertools.product(coeffs, repeat=Lg):
                        if all(c==0 for c in g):
                            continue
                        for h in itertools.product(coeffs, repeat=Ld):
                            if all(c==0 for c in h):
                                continue
                            # compute convolution
                            prod = [0]*(N+1)
                            for i,gi in enumerate(g):
                                for j,hj in enumerate(h):
                                    prod[i+j] += gi*hj
                            zeros = sum(1 for c in prod if c==0)
                            if zeros > max_overall:
                                max_overall = zeros
                                best = (d,g,h,prod)
                return max_overall, best
            
