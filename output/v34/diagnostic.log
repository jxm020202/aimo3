            def feasible_S(S):
                m=n=60
                # Determine black squares (i+j)%2==0
                black = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==0]
                white = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==1]
                # We'll store assignments in grid, 0 means unassigned
                grid = np.zeros((m,n), dtype=int)
                # Unassigned numbers sets
                remaining = set(range(1, 3601))
                # Process black squares in order of increasing degree (corners first)
                # compute degree
                def degree(i,j):
                    d=0
                    if i>0: d+=1
                    if i<m-1: d+=1
                    if j>0: d+=1
                    if j<n-1: d+=1
                    return d
                black.sort(key=lambda pos: degree(*pos))  # corners first (degree 2), then edges (3), then interior (4)
                # We'll also need to know white neighbors of each black
                # We'll assign black squares smallest possible numbers first
                for (i,j) in black:
                    # assign smallest remaining number to this black square
                    a = min(remaining)
                    grid[i,j] = a
                    remaining.remove(a)
                    # For each white neighbor, ensure it will be >= S - a
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni, nj = i+di, j+dj
                        if 0 <= ni < m and 0 <= nj < n:
                            if (ni+nj)%2==1:  # white neighbor
                                if grid[ni,nj]==0:
                                    # need to assign a number >= S - a
                                    min_needed = S - a
                                    # find smallest remaining number that is >= min_needed
                                    candidates = [x for x in remaining if x >= min_needed]
                                    if not candidates:
                                        return False
                                    b = max(candidates)  # maybe assign largest to keep flexibility? Let's assign largest.
                                    # Actually assign the smallest that satisfies? Let's assign the smallest to preserve large numbers for later.
                                    b = min(candidates)
                                    grid[ni,nj] = b
                                    remaining.remove(b)
                                else:
                                    # already assigned, check constraint
                                    if grid[ni,nj] + a < S:
                                        return False
                # After assigning all black squares and some white squares, we may have unassigned white squares left.
                # Assign remaining numbers arbitrarily to them.
                for (i,j) in white:
                    if grid[i,j]==0:
                        # assign any remaining number
                        b = max(remaining)  # assign largest remaining
