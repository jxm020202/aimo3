            def max_ops_bruteforce(N):
                init_counts = tuple(range(1,N+1))
                pairs = [(i,j) for i in range(N) for j in range(i+1,N)]
                total_pairs = len(pairs)
                @lru_cache(None)
                def dfs(counts, used_mask):
                    best = 0
                    # iterate over pairs not used
                    for idx, (i,j) in enumerate(pairs):
                        if (used_mask>>idx)&1:
                            continue
                        a = counts[i]
                        b = counts[j]
                        if a==0 or b==0:
                            continue
                        g = math.gcd(a,b)
                        # remove g from both
                        new_counts = list(counts)
                        new_counts[i] -= g
                        new_counts[j] -= g
                        new_counts = tuple(new_counts)
                        new_mask = used_mask | (1<<idx)
                        best = max(best, 1 + dfs(new_counts, new_mask))
                    return best
                return dfs(init_counts,0)
            
