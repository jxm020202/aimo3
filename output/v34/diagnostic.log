            def max_edges_given_bounds(n):
                # bounds: i for i=1..n, but cap at n-1
                bounds = [min(i, n-1) for i in range(1, n+1)]
                # Use greedy: start with degrees = bounds, then apply Havel-Hakimi to adjust if not graphic.
                # We'll implement algorithm to find max graphic sequence <= bounds.
                # Approach: start with zero degrees, then add edges greedily while respecting bounds.
                # Equivalent to constructing graph with vertices sorted by remaining capacity.
                import heapq
                # Use max-heap of (remaining capacity, vertex)
                heap = [(-c, i) for i,c in enumerate(bounds)]
                heapq.heapify(heap)
                edges = 0
                while heap:
                    cap, v = heapq.heappop(heap)
                    cap = -cap
                    if cap == 0:
                        continue
                    # need to connect v to cap other vertices with highest remaining capacity
                    # pop next cap vertices
                    temp = []
                    for _ in range(cap):
                        if not heap:
                            # cannot satisfy, break
                            return edges
                        c2, u = heapq.heappop(heap)
                        c2 = -c2
                        # add edge (v,u)
                        edges += 1
                        c2 -= 1
                        temp.append((c2, u))
                    # after connecting, v's capacity becomes 0, we don't push back
                    # push back updated vertices
                    for c2, u in temp:
                        heapq.heappush(heap, (-c2, u))
                return edges
            
