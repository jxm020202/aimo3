            def compute_a_d(n):
                a = {2:1}
                d = {2:3}
                for m in range(3,n+1):
                    if m%2==1: # odd
                        a[m] = a[m-1] + m
                        d[m] = d[m-1] + 2*m
                    else:
                        a[m] = a[m-1] + (m-1)
                        d[m] = d[m-1] + 2*(m-1)
                return a[n], d[n]
            
