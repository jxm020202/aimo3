            def angle_TLC_with_foot(a,b):
                a,b = sp.nsimplify(a), sp.nsimplify(b)
                X = sp.Point(0,0)
                Y = sp.Point(a,0)
                Z = sp.Point(0,b)
                O = sp.Point(a/2,b/2)
                Rrad = sp.sqrt(a**2+b**2)/2
                line_tangent_X = sp.Line(X, sp.Point(1, -a/b))
                T = line_tangent_X.intersection(sp.Line(Y,Z))[0]
                N = sp.Point(a/2, b/2 - Rrad)
                line_TN = sp.Line(T,N)
                circle = sp.Circle(O,Rrad)
                inter_TN = line_TN.intersection(circle)
                R_pt = inter_TN[0] if not inter_TN[0].equals(N) else inter_TN[1]
                dir_perp = sp.Point(-(R_pt.y - O.y), R_pt.x - O.x)
                line_tangent_R = sp.Line(R_pt, R_pt + dir_perp)
                L = line_tangent_R.intersection(sp.Line(X,Z))[0]
                C = sp.Line(Y,Z).projection(X)
                # angle at L between LT and LC
                LT = sp.Matrix(T - L)
                LC = sp.Matrix(C - L)
                angle = sp.acos( (LT.dot(LC)) / (sp.sqrt(LT.dot(LT))*sp.sqrt(LC.dot(LC))) )
                return float(sp.N(angle*180/sp.pi)), (T,L,C,R_pt,N)
            print(angle_TLC_with_foot(3,4))
            
