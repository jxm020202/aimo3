            def feasible_S(S, n=60, verbose=False):
                total=n*n
                low_pool = list(range(1, total//2 + 1))  # 1..1800
                high_pool = list(range(total//2 + 1, total+1))  # 1801..3600
                # compute degree
                deg = np.full((n,n),4)
                deg[0,:]=3; deg[-1,:]=3; deg[:,0]=3; deg[:,-1]=3
                deg[0,0]=deg[0,-1]=deg[-1,0]=deg[-1,-1]=2
                black_cells = [(i,j) for i in range(n) for j in range(n) if (i+j)%2==0]
                white_cells = [(i,j) for i in range(n) for j in range(n) if (i+j)%2==1]
                # sort black cells by degree descending
                black_cells.sort(key=lambda ij: deg[ij], reverse=True)
                # assign low numbers to blacks (smallest to highest degree)
                grid = np.empty((n,n), dtype=int)
                for (i,j), num in zip(black_cells, low_pool):
                    grid[i,j]=num
                # compute lower bound for each white cell
                lower_bounds = {}
                for (i,j) in white_cells:
                    # neighbors are blacks
                    max_req = -1
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<n and 0<=nj<n:
                            a_b = grid[ni,nj]
                            req = S - a_b
                            if req > max_req:
                                max_req = req
                    lower_bounds[(i,j)] = max_req
                # Now we need to assign distinct numbers from high_pool (size 1800) to whites such that each >= its lower bound.
                # Sort whites by lower bound descending, assign the smallest possible number that satisfies.
                whites_sorted = sorted(white_cells, key=lambda ij: lower_bounds[ij], reverse=True)
                # Use a multiset of available numbers (high_pool). We'll assign greedily largest numbers to highest bounds.
                available = high_pool.copy()
                # We'll assign from largest to smallest to meet bounds.
                # For each white in order of decreasing bound, pick the smallest available number that >= bound.
                # Since we have many numbers, we can binary search.
                import bisect
                for ij in whites_sorted:
                    bound = lower_bounds[ij]
                    # find index in available where number >= bound
                    idx = bisect.bisect_left(available, bound)
                    if idx == len(available):
                        # no number large enough
                        if verbose:
                            print("Failed for cell", ij, "bound", bound)
                        return False
                    # assign that number (could also assign the smallest that satisfies)
                    chosen = available.pop(idx)
                    grid[ij]=chosen
                # all assigned
                # verify min sum
                min_sum = min_adjacent_sum_grid(grid)
                if min_sum < S:
                    if verbose:
                        print("Constructed grid min sum", min_sum, "less than S")
                    return False
                return True
            
            for S in [3600, 3650, 3658]:
                print(S, feasible_S(S, verbose=True))
            
