            def is_solvable(mask,n,m):
                # BFS forward from mask to see if all_black reachable
                total = n*m
                all_black = (1<<total)-1
                visited = set([mask])
                queue = collections.deque([mask])
                while queue:
                    cur = queue.popleft()
                    if cur == all_black:
                        return True
                    # generate moves
                    for i in range(n-1):
                        for j in range(m-1):
                            idx = [i*m + j, i*m + (j+1), (i+1)*m + j, (i+1)*m + (j+1)]
                            bits = [(cur>>k)&1 for k in idx]
                            s = sum(bits)
                            if s == 3:
                                # fill missing
                                for k,b in zip(idx,bits):
                                    if b==0:
                                        new = cur | (1<<k)
                                        if new not in visited:
                                            visited.add(new)
                                            queue.append(new)
                                        break
                            elif s == 2:
                                # toggle all four
                                new = cur
                                for k in idx:
                                    new ^= (1<<k)
                                if new not in visited:
                                    visited.add(new)
                                    queue.append(new)
                return False
            
