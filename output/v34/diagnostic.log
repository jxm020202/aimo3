            from fractions import Fraction
            def find_solutions(limit):
                sols=[]
                for b in range(1,limit+1):
                    for a in range(0,b+1):  # r between 0 and 1 inclusive
                        r = Fraction(a,b)
                        D = 5*r*r - 2*r + 1
                        # D positive?
                        if D <= 0:
                            continue
                        # compute 2/D
                        val = Fraction(2,1) / D
                        # check if val is a perfect square rational
                        # i.e., numerator and denominator are perfect squares
                        num = val.numerator
                        den = val.denominator
                        # check perfect squares
                        import math
                        if int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den:
                            s = Fraction(math.isqrt(num), math.isqrt(den))
                            # store solution
                            sols.append((r, D, s))
                return sols
            
