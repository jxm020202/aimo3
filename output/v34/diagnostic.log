            from scipy.optimize import milp, LinearConstraint, Bounds
            def max_edges_milp(n):
                # variables for each unordered pair (i,j) with i<j
                pairs = [(i,j) for i in range(1,n+1) for j in range(i+1,n+1)]
                m = len(pairs)
                # objective: maximize sum x
                c = -np.ones(m)  # minimize negative to maximize
                # constraints: degree caps
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(pairs):
                    A[i-1, idx] = 1
                    A[j-1, idx] = 1
                # degree caps: sum <= i for vertex i
                lb = np.full(n, -np.inf)
                ub = np.array([i for i in range(1,n+1)], dtype=int)
                # variable bounds 0 <= x <=1 integer
                var_bounds = Bounds(0, 1)
                # integrality
                integrality = np.ones(m, dtype=int)
                # linear constraints: A x <= ub
                lin_con = LinearConstraint(A, -np.inf, ub)
                res = milp(c=c, constraints=lin_con, bounds=var_bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("MILP failed")
                    return None
                x = np.round(res.x).astype(int)
                total_edges = int(x.sum())
                return total_edges
            
            for n in range(2,13):
                opt = max_edges_milp(n)
                print(n, opt, (n*n)//4)
            
