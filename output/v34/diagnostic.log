            def assign_by_degree(N=60):
                # compute degree for each cell
                deg = {}
                for i in range(N):
                    for j in range(N):
                        d=0
                        if i>0: d+=1
                        if i<N-1: d+=1
                        if j>0: d+=1
                        if j<N-1: d+=1
                        deg[(i,j)]=d
                # separate black and white
                black = [(i,j) for i in range(N) for j in range(N) if (i+j)%2==0]
                white = [(i,j) for i in range(N) for j in range(N) if (i+j)%2==1]
                # sort black by degree descending (interior first) for low numbers ascending
                black_sorted_desc = sorted(black, key=lambda x: -deg[x])
                # assign low numbers ascending to black_desc (small numbers to interior)
