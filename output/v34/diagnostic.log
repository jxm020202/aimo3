            def feasible_grid(r,c,S):
                N=r*c
                cells = [(i,j) for i in range(r) for j in range(c)]
                # map cell index
                idx = {cell:k for k,cell in enumerate(cells)}
                # edges list of pairs of indices
                edges=[]
                for i in range(r):
                    for j in range(c):
                        if i+1<r:
                            edges.append((idx[(i,j)], idx[(i+1,j)]))
                        if j+1<c:
                            edges.append((idx[(i,j)], idx[(i,j+1)]))
                # variables: X[i,v] binary, flattened order i*N+v
                nvar = N*N
                # constraints matrices
                A_eq = []
                b_eq = []
                # each cell assigned exactly one value
                for i in range(N):
                    row = np.zeros(nvar, dtype=int)
                    row[i*N:(i+1)*N] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each value assigned to exactly one cell
                for v in range(N):
                    row = np.zeros(nvar, dtype=int)
                    row[v::N] = 1  # indices i*N+v for all i
                    A_eq.append(row)
                    b_eq.append(1)
                # inequality constraints for edges: sum v*X[i,v] + sum w*X[j,w] >= S
                A_ub = []
                b_ub = []
                # We'll convert to - (sum ...) <= -S
                for (i,j) in edges:
                    row = np.zeros(nvar, dtype=int)
                    # add coefficients v for X[i,v]
                    for v in range(N):
                        row[i*N+v] = -(v+1)  # negative for <=
                        row[j*N+v] = -(v+1)
                    A_ub.append(row)
                    b_ub.append(-S)
                # Convert to scipy LinearConstraint
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                A_ub = np.array(A_ub)
                b_ub = np.array(b_ub)
                # objective zero
                c = np.zeros(nvar)
                # bounds binary
                bounds = Bounds(0,1)
                # integrality
                integrality = np.ones(nvar, dtype=int)
                # Solve
                res = milp(c=c,
                           constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                                        LinearConstraint(A_ub, -np.inf, b_ub)],
                           bounds=bounds,
                           integrality=integrality,
                           options={'disp': False})
                return res.success, res
            
            success, res = feasible_grid(4,4,16)
            print("feasible:", success)
            
