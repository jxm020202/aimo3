            def optimal_edge_multiplicities(N):
                # N odd
                # variables x_i for i=1..N-1
                # constraints as described, start=1, end=N
                # We'll solve using linear programming (LP) with integer constraints via brute force for small N.
                # Use simple DP: we can compute minimal sum given recurrence.
                # Since constraints are linear, we can solve using DP: choose x_1 =1 (from start constraint)
                # Then for i=2..N-1, we have equation for vertex i (i corresponds to coin i)
                # For vertex i, we have x_{i-1}+x_i = target_i where target_i = 2 if i odd else 4.
                # This gives x_i = target_i - x_{i-1}. So uniquely determined!
                # Indeed, given x_{i-1}, we can compute x_i.
                # Need to ensure x_i >=0 integer.
                # Let's compute.
                target = {}
                for i in range(1, N+1):
                    if i%2==1: # odd
                        if i==1 or i==N:
                            target[i]=1
                        else:
                            target[i]=2
                    else:
                        target[i]=4
                x = {}
                # x_0 = 0
                prev = 0
                # compute x_1 from vertex 1 equation: prev + x_1 = target[1] => x_1 = target[1] - prev = 1
                x[1] = target[1] - prev
                prev = x[1]
                # iterate i=2..N-1
                for i in range(2, N):
                    # vertex i equation: x_{i-1} + x_i = target[i]
                    xi = target[i] - prev
                    if xi < 0:
                        return None  # infeasible
                    x[i] = xi
                    prev = xi
                # check final vertex N constraint: x_{N-1} + 0 = target[N] => x_{N-1} must equal target[N]
                if x[N-1] != target[N]:
                    # maybe start/end not at ends? but we assumed.
                    return None
                return x
            
