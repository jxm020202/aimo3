            import itertools, math
            
            def outstanding_rectangles(grid):
                # grid is 2D list of numbers
                R=len(grid)
                C=len(grid[0])
                count=0
                for i1 in range(R):
                    for i2 in range(i1,R):
                        for j1 in range(C):
                            for j2 in range(j1,C):
                                # rectangle cells
                                inside = [(i,j) for i in range(i1,i2+1) for j in range(j1,j2+1)]
                                # outer ring cells: any cell not in inside but with max distance <=1 to any inside cell
                                # Equivalent: cells (i,j) such that i in [i1-1,i2+1], j in [j1-1,j2+1] and not inside, and within grid bounds
                                outer = [(i,j) for i in range(i1-1,i2+2) for j in range(j1-1,j2+2)
                                         if 0<=i<R and 0<=j<C and (i,j) not in inside]
                                # condition: all inside values > all outer values
                                inside_vals=[grid[i][j] for i,j in inside]
                                outer_vals=[grid[i][j] for i,j in outer]
                                if not outer_vals: # whole grid case
                                    count+=1
                                else:
                                    if min(inside_vals) > max(outer_vals):
                                        count+=1
                return count
            
            def max_outstanding(R,C):
                n=R*C
                maxc=0
                best=None
                for perm in itertools.permutations(range(n)):
                    # assign numbers 0..n-1 (distinct)
                    grid=[[0]*C for _ in range(R)]
                    idx=0
                    for i in range(R):
                        for j in range(C):
                            grid[i][j]=perm[idx]
                            idx+=1
                    c=outstanding_rectangles(grid)
                    if c>maxc:
                        maxc=c
                        best=[row[:] for row in grid]
                return maxc, best
            
            print(max_outstanding(1,1))
            
