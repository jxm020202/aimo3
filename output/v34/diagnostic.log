            import math, numpy as np
            
            def d_of_point(x, y):
                # compute min distance to any side among 4 rectangles
                mins = []
                for n in range(2,6):
                    y0 = 1 + 6*math.sqrt(2) - math.sqrt(2)*n
                    # distances to sides
                    left = x + n
                    right = n - x
                    bottom = y + y0
                    top = y0 - y
                    mins.append(min(left, right, bottom, top))
                return min(mins)
            
            def max_d_on_curve(num=20001):
                xs = np.linspace(-1,1,num)
                maxd = -1
                maxpt = None
                for x in xs:
                    # compute sqrt term
                    rad = 1 - x**2
                    if rad < 0: continue
                    sqrt = math.sqrt(rad)
                    for sign in [1, -1]:
                        y = abs(x) + sign*sqrt
                        d = d_of_point(x, y)
                        if d > maxd:
                            maxd = d
                            maxpt = (x,y)
                return maxd, maxpt
            
            maxd, maxpt = max_d_on_curve()
            maxd, maxpt
            
