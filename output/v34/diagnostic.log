            def construct_grid(r,c):
                n=r*c
                cells=[(i,j) for i in range(r) for j in range(c)]
                # compute degree
                deg={}
                for idx,(i,j) in enumerate(cells):
                    d=0
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        if 0<=i+di<r and 0<=j+dj<c:
                            d+=1
                    deg[idx]=d
                # sort cells by degree ascending (corners first)
                sorted_cells=sorted(range(n), key=lambda idx: deg[idx])
                # assign numbers 1..n to cells in that order
                assignment=[0]*n
                for num, idx in enumerate(sorted_cells, start=1):
                    assignment[idx]=num
                # now fill remaining numbers? Actually we assigned all numbers.
                # This assignment uses low numbers on low-degree cells, high numbers on high-degree cells.
