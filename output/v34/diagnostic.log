            import itertools, math
            
            def max_ops_bruteforce(N):
                max_edges=0
                best=None
                pairs=[(i,j) for i in range(1,N+1) for j in range(i+1,N+1)]
                m=len(pairs)
                for mask in range(1<<m):
                    deg=[0]* (N+1)
                    edges=0
                    ok=True
                    for idx,(i,j) in enumerate(pairs):
                        if mask>>idx &1:
                            deg[i]+=1
                            deg[j]+=1
                            if deg[i]>i or deg[j]>j:
                                ok=False
                                break
                            edges+=1
                    if ok and edges>max_edges:
                        max_edges=edges
                        best=mask
                return max_edges
            
