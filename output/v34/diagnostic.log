            def covering_radius_n(n):
                N=n*n
                # Build column vectors (syndrome) for each cell (i,j)
                # We'll represent syndrome as integer of length 2n-2 bits (or we can use tuple)
                # We'll use basis representation: r_i (i=0..n-1) and c_j (j=0..n-1) with constraints sum r = sum c = 0.
                # For simplicity, we can represent syndrome as vector of length 2n (r_i and c_j) but we will treat constraints later.
                # We'll compute syndrome as (r_vec, c_vec) where each is n-bit vector.
                # For each edge (i,j), syndrome is r_i + c_j (i.e., toggle r_i and c_j).
                # We'll encode as tuple of two ints: r_mask (n bits), c_mask (n bits)
                col_syndromes = []
                for i in range(n):
                    for j in range(n):
                        r_mask = 1 << i
                        c_mask = 1 << j
                        col_syndromes.append((r_mask, c_mask))
                # Enumerate all subsets of columns (edges) and compute resulting syndrome and weight
                from collections import defaultdict
                min_weight = {}
                # We'll iterate over all subsets (2^N) maybe large for n=5 (2^25) not feasible, but for n=4 it's 2^16=65536 fine.
                total_subsets = 1 << N
                for subset in range(total_subsets):
                    r = 0
                    c = 0
                    w = 0
                    s = subset
                    idx = 0
                    while s:
                        if s & 1:
                            r ^= col_syndromes[idx][0]
                            c ^= col_syndromes[idx][1]
                            w += 1
                        s >>= 1
                        idx += 1
                    # Reduce r and c to satisfy parity constraints? Actually any combination will automatically satisfy parity condition because total number of edges parity equals sum bits of r and c.
                    # We'll store minimal weight for this syndrome (r,c)
                    key = (r, c)
                    if key not in min_weight or w < min_weight[key]:
                        min_weight[key] = w
                # Now covering radius is max over all possible syndromes (r,c) with even parity condition of min_weight.
                # Determine which (r,c) are allowed: sum bits of r must be even, sum bits of c even.
                max_min = 0
                for (r,c), w in min_weight.items():
                    if bin(r).count('1') % 2 == 0 and bin(c).count('1') % 2 == 0:
                        if w > max_min:
                            max_min = w
                return max_min
            
            print(covering_radius_n(4))
            
