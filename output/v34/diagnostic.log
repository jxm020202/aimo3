            def max_S_grid(r,c):
                N=r*c
                cells=[(i,j) for i in range(r) for j in range(c)]
                # compute edges
                edges=set()
                for i in range(r):
                    for j in range(c):
                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            ni,nj=i+di,j+dj
                            if 0<=ni<r and 0<=nj<c:
                                a=(i,j); b=(ni,nj)
                                if a<b:
                                    edges.add((a,b))
                edges=list(edges)
                # adjacency list for quick
                # We'll binary search S
                low=2  # min possible sum
                high=N+N  # max possible sum
                best=0
                while low<=high:
                    mid=(low+high)//2
                    # build MILP feasibility for S=mid
                    # variables: N cells * N numbers = N^2 binary
                    # Use scipy.optimize milp
                    num_vars=N*N
                    # objective dummy zero
                    c=np.zeros(num_vars)
                    # constraints:
                    A=[]
                    b=[]
                    # each cell gets exactly one number
                    for vi in range(N):
                        row=np.zeros(num_vars)
                        for k in range(N):
                            row[vi*N + k]=1
                        A.append(row)
                        b.append(1)
                    # each number assigned to exactly one cell
                    for k in range(N):
                        row=np.zeros(num_vars)
                        for vi in range(N):
                            row[vi*N + k]=1
                        A.append(row)
                        b.append(1)
                    # edge constraints: for each edge (u,v) and each (k,l) with k+l < mid, forbid both
                    # This adds many constraints; for N=12, manageable.
                    for (u,v) in edges:
                        ui = cells.index(u)
                        vi = cells.index(v)
                        for k in range(N):
                            for l in range(N):
                                if (k+1)+(l+1) < mid:  # numbers are 1-indexed
                                    row=np.zeros(num_vars)
                                    row[ui*N + k]=1
                                    row[vi*N + l]=1
                                    A.append(row)
                                    b.append(1)  # at most 1 of them can be selected
                    A=np.array(A)
                    b=np.array(b)
                    # bounds 0-1
                    bounds=[(0,1)]*num_vars
                    # integrality
                    integrality=np.ones(num_vars, dtype=int)
                    # Use milp
                    res=opt.milp(c, constraints=opt.LinearConstraint(A,b,b), bounds=opt.Bounds(0,1), integrality=integrality, options={'presolve':True, 'disp':False})
                    feasible=res.success
                    if feasible:
                        best=mid
                        low=mid+1
                    else:
                        high=mid-1
                return best
            
            print(max_S_grid(3,4))
            
