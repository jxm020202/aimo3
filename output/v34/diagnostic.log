            def is_square_rational(fr):
                # fr is Fraction, check if numerator and denominator are perfect squares
                num = fr.numerator
                den = fr.denominator
                sqrt_num = int(math.isqrt(num))
                sqrt_den = int(math.isqrt(den))
                return sqrt_num*sqrt_num == num and sqrt_den*sqrt_den == den
            
