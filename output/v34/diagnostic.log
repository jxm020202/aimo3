            import math, itertools, sympy as sp
            
            def ratio(xs):
                S = sum(xs)
                g = math.gcd(math.gcd(math.gcd(math.gcd(math.gcd(xs[0], xs[1]), xs[2]), xs[3]), xs[4]), xs[5])
                # compute sum term
                total = 0
                n = len(xs)
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    term = math.gcd(a,b) * (b*c // math.gcd(b,c))  # lcm(b,c) = b*c/gcd(b,c)
                    total += term
                return (S**3) / (g * total)
            
            def ratio_frac(xs):
                # using sympy rational for exact
                S = sum(xs)
                g = math.gcd(math.gcd(math.gcd(math.gcd(math.gcd(xs[0], xs[1]), xs[2]), xs[3]), xs[4]), xs[5])
                total = 0
                n = len(xs)
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    term = math.gcd(a,b) * (b*c // math.gcd(b,c))
                    total += term
                return sp.Rational(S**3, g*total)
            
            def test_tuple(xs):
                r = ratio(xs)
                return r
            
            print(test_tuple([1,2,1,2,1,2]))
            
