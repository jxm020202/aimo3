            def digit_coeff(k, n):
                # compute d_k = sum_{i=1}^{k} i^{n-1} * (k! / i!) mod (k+1)
                mod = k+1
                total = 0
                fact_k = math.factorial(k)
                for i in range(1, k+1):
                    term = pow(i, n-1, mod) * (fact_k // math.factorial(i) % mod)
                    total = (total + term) % mod
                return total
            
