                a = [0]*(N+1)
                a[1]=1
                S = [0]*(N+1)
                S[1]=1
                def backtrack(n):
                    nonlocal best, best_seq
                    if n > N:
                        # evaluate a_N
                        if a[N] > best:
                            best = a[N]
                            best_seq = a.copy()
                        return
                    # compute constraints for a_n
                    # must be divisor of n
                    possible = divisors(n)
                    # also must be multiple of L = lcm of a[d] for d|n, d<n
                    L = 1
                    for d in range(1,n):
                        if n % d == 0:
                            L = (L * a[d]) // math.gcd(L, a[d])
                    # also must divide S[n-1]
                    G = math.gcd(n, S[n-1])  # actually need a_n | S[n-1] and a_n | n, so a_n | gcd(n, S[n-1])
                    # also must satisfy a_{n-1} | (a_n - 1)
                    # also must be multiple of L
                    for cand in possible:
                        if cand % L != 0:
