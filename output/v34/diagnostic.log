            def count_cool_fast(k):
                count = 0
                for m in range(1, k+1):
                    t = k - m
                    lower = k - m + 1
                    # iterate over divisors d of m
                    # For each divisor d of m, if d divides t, then any n in range with gcd(m,n)=d qualifies.
                    # Count n in [lower, k] such that gcd(m,n)=d.
                    # This is equivalent to count numbers n' in [ceil(lower/d), floor(k/d)] that are coprime to m/d.
                    # Let m1 = m//d.
                    # Count of integers x in [L,R] with gcd(x,m1)=1.
                    # Use inclusion-exclusion via mobius? Since k is small, we can brute force.
                    # We'll just brute force for verification.
                    for n in range(lower, k+1):
                        if math.gcd(m,n) == math.gcd(m, n):
                            if (k - m) % math.gcd(m,n) == 0:
                                count += 1
                return count
            
