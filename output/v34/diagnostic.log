                x[1] = 2
                for i in range(2, N):
                    target = 2 if i%2==1 else 4
                    xi = target - x[i-1]
                    if xi < 0:
                        return None
                    x[i] = xi
                # check final condition for i=N (odd): x_{N-1}+x_N = 2 => x_{N-1} must be 2
                if x[N-1] != 2:
