            def max_edges(N):
                caps = [i for i in range(1, N)] + [N-1]  # length N
                # Use Havel-Hakimi with reduction when needed
                # Represent as list of remaining degrees
                degrees = caps[:]
                # We'll use a multiset sorted descending
                import heapq
                # Use max-heap by storing negative values
                heap = [-d for d in degrees if d>0]
                heapq.heapify(heap)
                total_edges = 0
                while heap:
                    d = -heapq.heappop(heap)
                    if d == 0:
                        continue
                    # need to connect to d highest-degree vertices
                    if len(heap) < d:
                        # cannot connect to all, so we can only connect to len(heap) vertices
                        d = len(heap)
                    # pop d vertices
                    temp = []
                    for _ in range(d):
                        nd = -heapq.heappop(heap)
                        nd -= 1
                        temp.append(nd)
                    total_edges += d
                    # push back updated degrees if >0
                    for nd in temp:
                        if nd > 0:
                            heapq.heappush(heap, -nd)
                return total_edges
            
