            def generate_possible(N):
                # grid size (N+1)*(N+1) inclusive indices 0..N
                # Use backtracking row-major order.
                grid = [[None]*(N+1) for _ in range(N+1)]
                grid[0][0] = 0
                triples = []  # list of triples of coordinates (x,y), (x,y+1), (x+1,y)
                for x in range(N):
                    for y in range(N):
                        triples.append(((x,y),(x,y+1),(x+1,y)))
                # Precompute for each cell which triples involve it.
                cell_to_triples = collections.defaultdict(list)
                for idx, tri in enumerate(triples):
                    for coord in tri:
                        cell_to_triples[coord].append(idx)
                # For each triple, we will check when all three assigned.
                possible_vals_at_target = set()
                target = (N,N)  # we may look at far corner (N,N) but not necessarily reachable by condition?
                # Actually target (N,N) may not be in any triple (needs N+1 index). We'll still collect.
                order = [(i,j) for i in range(N+1) for j in range(N+1) if not (i==0 and j==0)]
                # Use recursion
                sys.setrecursionlimit(10000)
                count=0
                def backtrack(idx):
                    nonlocal count
                    if idx==len(order):
                        # all assigned
                        possible_vals_at_target.add(grid[target[0]][target[1]])
                        return
                    i,j = order[idx]
                    # Determine possible values for this cell based on constraints with already assigned neighbors.
                    # For each triple that includes (i,j), if the other two cells are assigned, we can restrict value.
                    # We'll collect allowed values set.
                    allowed = None
                    for tri_idx in cell_to_triples[(i,j)]:
                        a_coord,b_coord,c_coord = triples[tri_idx]
                        # Get values if assigned
                        vals = []
                        unknowns = 0
                        for coord in (a_coord,b_coord,c_coord):
                            v = grid[coord[0]][coord[1]]
                            if v is None:
                                unknowns += 1
                            else:
                                vals.append(v)
                        if unknowns==0:
                            # triple already satisfied earlier, should hold
                            if not (max(vals)-min(vals)==2 and len(set(vals))==3):
                                return  # invalid
                        elif unknowns==1:
                            # we can compute allowed values for the unknown cell
                            # let known values be a,b
                            a,b = vals
                            # unknown must be distinct from a,b and max-min=2 overall
                            # Let min_known = min(a,b), max_known = max(a,b)
                            # The three values must be consecutive, so the set must be {n,n+1,n+2}
                            # Determine possible n such that a,b are subset.
                            # There are limited possibilities.
                            possible_vals = set()
                            # Enumerate n from min_known-2 to max_known (since n <= min_known <= n+2)
                            for n in range(min(a,b)-2, max(a,b)+1):
                                triple = {n, n+1, n+2}
                                if a in triple and b in triple:
                                    # unknown is the remaining element
                                    missing = (triple - {a,b}).pop()
                                    possible_vals.add(missing)
                            if allowed is None:
                                allowed = possible_vals
                            else:
                                allowed &= possible_vals
                            if not allowed:
