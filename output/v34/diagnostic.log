            def max_min_sum(iterations=200000, time_limit=25):
                N=60
                # create checkerboard pattern: black if (i+j)%2==0
                black_coords = [(i,j) for i in range(N) for j in range(N) if (i+j)%2==0]
                white_coords = [(i,j) for i in range(N) for j in range(N) if (i+j)%2==1]
                assert len(black_coords)==len(white_coords)==1800
                # initial assignment: random permutation within each color
                low_numbers = list(range(1,1801))
                high_numbers = list(range(1801,3601))
                random.shuffle(low_numbers)
                random.shuffle(high_numbers)
                grid = np.empty((N,N), dtype=int)
                for (i,j), val in zip(black_coords, low_numbers):
                    grid[i,j]=val
