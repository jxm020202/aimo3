            def is_pretty(m,n,k):
                if m<=0 or n<=0:
                    return False
                d = math.gcd(m,n)
                if k % d != 0:
                    return False
                kp = k // d
                m1 = m // d
                n1 = n // d
                if abs(kp - m1) < min(m1, n1):
                    return True
                return False
            
            def brute_check(alpha,k,limit):
                pretty=set()
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if m*math.ceil(n*alpha)-n*math.floor(m*alpha)==k:
                            pretty.add((m,n))
                return pretty
            
            def check_match(alpha,k,limit):
                pretty1=brute_check(alpha,k,limit)
                pretty2=set()
                for m in range(1,limit+1):
                    for n in range(1,limit+1):
                        if is_pretty(m,n,k):
                            pretty2.add((m,n))
                return pretty1==pretty2
            
