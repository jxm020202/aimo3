            def max_edges_havel_hakimi(n):
                # bounds: b_i = min(i, n-1) for i=1..n
                caps = [min(i, n-1) for i in range(1, n+1)]
                # sort descending
                caps.sort(reverse=True)
                edges = 0
                while caps and caps[0] > 0:
                    d = caps[0]
                    caps = caps[1:]  # remove first
                    if d > len(caps):
                        # cannot satisfy, break
                        break
                    # subtract 1 from next d entries
                    for i in range(d):
                        caps[i] -= 1
                    edges += d
                    # re-sort descending
                    caps.sort(reverse=True)
                return edges
            
            for n in range(2,11):
                print(n, max_edges_havel_hakimi(n))
            
