                    for j in range(i+1,n):
                        for w in range(n):
                            if w!=i and w!=j:
                                triples.append((i,j,w))
                z_start = 2*m
                z_len = len(triples)
                total_vars = 2*m + z_len
                # objective maximize sum x
                c = np.zeros(total_vars)
