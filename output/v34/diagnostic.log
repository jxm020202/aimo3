                D = sp.sqrt(9*x_sym**4 + sp.Rational(4,3)*x_sym**6 + 9 + 18*x_sym**2)/6
                term3 = sp.real_root(C + D, 3) + sp.real_root(C - D, 3)
                rhs = term1 + term2 + term3
                return sp.nsimplify(expr), sp.nsimplify(rhs)
