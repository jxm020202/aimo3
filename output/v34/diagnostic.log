            def max_outstanding(m,n):
                # generate rectangles
                rects = []
                for r1 in range(m):
                    for r2 in range(r1, m):
                        for c1 in range(n):
                            for c2 in range(c1, n):
                                rects.append((r1,r2,c1,c2))
                R = len(rects)
                # variable indices
                # continuous variables: cell values (m*n)
                # binary variables: selection for each rectangle (R)
                total_vars = m*n + R
                # variable bounds
                # cell values between 0 and 100
                lb = np.zeros(total_vars)
                ub = np.full(total_vars, 100.0)
                # binary variables bounds 0,1
                for i in range(m*n, total_vars):
                    lb[i] = 0
                    ub[i] = 1
                # constraints list
                A = []
                b = []
                # big M
                M = 200.0
                # For each rectangle, add constraints for each interior-exterior pair
                for idx, (r1,r2,c1,c2) in enumerate(rects):
                    sel_idx = m*n + idx
                    # list interior cells
                    interior = [(i,j) for i in range(r1, r2+1) for j in range(c1, c2+1)]
                    # neighbor cells: cells not interior but within Chebyshev distance 1
                    neighbor = []
                    for i in range(max(0, r1-1), min(m, r2+2)):
                        for j in range(max(0, c1-1), min(n, c2+2)):
                            if not (r1 <= i <= r2 and c1 <= j <= c2):
                                neighbor.append((i,j))
                    # For each interior a and neighbor b, add constraint:
                    for (i1,j1) in interior:
                        var_a = i1*n + j1
                        for (i2,j2) in neighbor:
                            var_b = i2*n + j2
                            row = np.zeros(total_vars)
                            row[var_a] = 1
                            row[var_b] = -1
                            row[sel_idx] = -M  # value_a - value_b - M*(1 - sel) >= 1? Wait we need: if sel=1 then value_a >= value_b + 1
                            # constraint: value_a - value_b - M*(1 - sel) >= 1
                            # => value_a - value_b - M + M*sel >= 1
                            # => value_a - value_b + M*sel >= 1 + M
                            # but easier: value_a - value_b + M*sel >= 1
                            # Actually when sel=0, we want no constraint: value_a - value_b >= -inf. So we can use:
                            # value_a - value_b + M*sel >= 1
                            # when sel=0: value_a - value_b >= 1? That's still constraint. Not good.
                            # Let's use: value_a - value_b + M*sel >= 1
                            # For sel=0: value_a - value_b >= 1 - M*0 = 1, still constraint.
                            # Need big-M on opposite side: value_a - value_b + M*(1 - sel) >= 1
                            # When sel=1: value_a - value_b >= 1
                            # When sel=0: value_a - value_b + M >= 1 => always true because M large.
                            # So row: coeff for sel is -M (since term is + M*(1 - sel) = M - M*sel)
                            # inequality: value_a - value_b + M - M*sel >= 1 => value_a - value_b - M*sel >= 1 - M
                            # Rearranged: value_a - value_b - M*sel >= 1 - M
                            # So we set row[var_a]=1, row[var_b]=-1, row[sel_idx]=-M, and RHS = 1 - M
                            row[sel_idx] = -M
                            A.append(row)
                            b.append(1 - M)
                A = np.array(A)
                b = np.array(b)
                # linear constraint: A @ x >= b
                lincon = LinearConstraint(A, b, np.full_like(b, np.inf))
                # objective: maximize sum of sel variables
                c = np.zeros(total_vars)
                c[m*n:] = -1  # minimize negative sum => maximize sum
                # bounds
                bounds = Bounds(lb, ub)
                res = milp(c=c, constraints=lincon, bounds=bounds, integrality=np.concatenate([np.zeros(m*n, dtype=int), np.ones(R, dtype=int)]))
                if not res.success:
                    print("MILP failed")
                    return None
                sel = res.x[m*n:]
                max_count = int(round(np.sum(sel)))
                return max_count
            
            print(max_outstanding(2,2))
            
