            def neighbor_coords(r,c,i,j):
                for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                    ni,nj=i+di,j+dj
                    if 0<=ni<r and 0<=nj<c:
                        yield ni,nj
            
            def min_adj_sum_grid_np(grid):
