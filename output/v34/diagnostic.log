                # In algorithm earlier, we only added edges when processing i, connecting to higher j. So we never duplicate.
                edges=0
                for i in range(1,n+1):
                    need = remaining[i]
                    if need==0:
                        continue
                    # connect to highest j>i with remaining>0
                    j = n
                    while need>0 and j>i:
                        if remaining[j]>0:
                            # add edge
                            remaining[i]-=1
                            remaining[j]-=1
                            need-=1
                            edges+=1
                        j-=1
                    # after loop, continue
