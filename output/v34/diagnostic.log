            def valid_grid(max_x, max_y, bound):
                # returns list of assignments dict (x,y)->value
                assignments = []
                # We'll generate values row by row
                # Use backtracking
                grid = {}
                def backtrack(x, y):
                    if x > max_x:
                        assignments.append(grid.copy())
                        return
                    nx, ny = (x, y+1) if y < max_y else (x+1, 0)
                    # Determine possible values for (x,y)
                    # Must be non-negative integer <= bound
                    for val in range(bound+1):
                        # assign
                        grid[(x,y)] = val
                        # Check constraints that involve this cell and already assigned neighbors
                        ok = True
                        # For each (i,j) such that (x,y) is part of its L-set and all three cells assigned
                        # L-set for (i,j): (i,j), (i+1,j), (i,j+1)
                        for i,j in [(x,y), (x-1,y), (x,y-1)]:
                            if i<0 or j<0 or i>max_x or j>max_y:
                                continue
                            cells = [(i,j), (i+1,j), (i,j+1)]
                            if all(c in grid for c in cells):
                                vals = [grid[c] for c in cells]
                                # check if they are three consecutive distinct ints
                                s = sorted(vals)
                                if not (s[0]+1==s[1] and s[1]+1==s[2]):
                                    ok=False
                                    break
                        if ok:
                            backtrack(nx, ny)
                        # undo
                        del grid[(x,y)]
                backtrack(0,0)
                return assignments
            
