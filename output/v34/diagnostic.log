* `turn` = 0 for Alice (white to move), 1 for Bob (black to move).  
* `last‑axis` ∈ {None, 0, 1} where 0 = horizontal, 1 = vertical.  

The rules are enforced: a piece may move one cell horizontally or vertically, and its next move must be on the opposite axis from its previous move (if any).  

The algorithm builds the set **W** of states from which Bob can force a capture:

* Initialise **W** with all states where it is Bob’s turn and he can move onto the white piece in one legal step.  
* Repeatedly add:
  * any Bob‑turn state that has a move into **W**,
  * any Alice‑turn state all of whose moves go into **W**.

When the process stabilises, a state is winning for Bob iff it lies in **W**.  
The script then counts, for a board of size `N`, how many initial placements (different cells, both pieces have no previous move) are winning for Bob.

```python
import itertools
from collections import deque

def bob_winning_initial_positions(N):
    """
    Returns the number of ordered pairs (white,black) with white!=black
    for which Bob has a forced win on an N×N board.
    """
    # Directions: (dx,dy,axis) where axis 0=horizontal,1=vertical
    moves = [ (1,0,0), (-1,0,0), (0,1,1), (0,-1,1) ]

    # Helper: all legal moves for a piece given its last axis
    def legal_moves(pos, last_axis):
        x,y = pos
        res = []
        for dx,dy,axis in moves:
            if last_axis is not None and axis == last_axis:
                continue                # must alternate axis
            nx,ny = x+dx, y+dy
            if 0 <= nx < N and 0 <= ny < N:
                res.append( ((nx,ny), axis) )
        return res

    # State encoding for memoisation:
    # (wx,wy,bx,by,turn,last_axis_white,last_axis_black)
    # turn: 0 = Alice (white to move), 1 = Bob (black to move)
    # last_axis_* : None,0,1  (None -> no previous move)
    # We'll store states in a dictionary: 0 = not known, 1 = winning for Bob, -1 = losing for Bob
    from functools import lru_cache

    @lru_cache(maxsize=None)
    def is_winning(state):
        wx,wy,bx,by,turn,lw,lb = state
        # Immediate capture check (Bob just moved onto white)
        if turn == 0 and (wx,wy) == (bx,by):
            # This situation can only arise after Bob's move;
            # it means Bob has already won.
            return True

        if turn == 0:   # Alice to move (white)
            # generate all legal white moves
            for (nwx,nwy), n_axis in legal_moves((wx,wy), lw):
                # If white moves onto black, that is allowed (the rules do not forbid it)
                # but the win condition is only checked after Bob's move,
                # so the game continues.
                nxt = (nwx,nwy,bx,by,1,n_axis,lb)
                if not is_winning(nxt):
                    # Alice can move to a state where Bob cannot force a win
                    return False
            # All Alice's moves lead to Bob‑winning states
            return True

        else:   # Bob to move (black)
            # generate all legal black moves
            for (nbx,nby), n_axis in legal_moves((bx,by), lb):
                # If Bob moves onto white, he wins immediately.
                if (nbx,nby) == (wx,wy):
                    return True
                nxt = (wx,wy,nbx,nby,0,lw,n_axis)
                if is_winning(nxt):
                    # Bob can move to a state that is winning for him
                    return True
            # No winning move for Bob
            return False

    # Count initial positions (both pieces have no previous move, Alice to move)
    win_cnt = 0
    total = 0
    for wx,wy in itertools.product(range(N), repeat=2):
        for bx,by in itertools.product(range(N), repeat=2):
            if (wx,wy) == (bx,by):
                continue
            total += 1
            init_state = (wx,wy,bx,by,0,None,None)   # Alice moves first
            if is_winning(init_state):
                win_cnt += 1
    return win_cnt, total

# ----------------------------------------------------------------------
# Test on a few small boards to see the pattern
for N in range(2,7):
    w,total = bob_winning_initial_positions(N)
    print(N, w, total, f"fraction = {w}/{total}")
```

