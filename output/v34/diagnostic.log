                            s=vi+perm[nb]
                            if s<min_sum:
                                min_sum=s
                return min_sum
            
            def simulated_anneal(time_limit=20):
                perm=list(range(1,N+1))
                random.shuffle(perm)
                best=perm[:]
                best_score=min_adj_sum(best)
                current_score=best_score
                start=time.time()
                T0=5.0
                while time.time()-start < time_limit:
                    # temperature schedule
                    t = (time.time()-start)/time_limit
                    T = T0*(1 - t)
                    # propose swap
                    i,j = random.sample(range(N),2)
                    perm[i],perm[j]=perm[j],perm[i]
                    new_score=min_adj_sum(perm)
                    delta = new_score - current_score
                    if delta >= 0 or random.random() < math.exp(delta / T if T>0 else 0):
                        current_score = new_score
                        if new_score > best_score:
                            best_score = new_score
                            best = perm[:]
                    else:
                        # revert
                        perm[i],perm[j]=perm[j],perm[i]
                return best_score, best
            
            best_score, best_perm = simulated_anneal(30)
            best_score
            
