                        a[i]=(-a[i-1])%4
                    else:
                        a[i]=(2 - a[i-1])%4
                edges = a[1:]  # length N-1
                # Build adjacency list with multiplicities
                # We'll use Hierholzer's algorithm for Eulerian trail
                from collections import defaultdict, deque
                adj = defaultdict(list)
                for i, mult in enumerate(edges, start=1):
                    for _ in range(mult):
                        adj[i].append(i+1)
                        adj[i+1].append(i)
                # Hierholzer
                stack=[1]
                path=[]
                while stack:
                    v=stack[-1]
                    if adj[v]:
                        u=adj[v].pop()
                        # remove opposite edge
                        adj[u].remove(v)
                        stack.append(u)
                    else:
