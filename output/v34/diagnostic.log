            def f_bruteforce(N):
                min_m = None
                for a in range(1, N-1):
                    for b in range(a+1, N):
                        c = N - a - b
                        if c <= b or c <= 0:
                            continue
                        # distinct a<b<c automatically
                        m = sp.ilcm(a,b,c)
                        if min_m is None or m < min_m:
                            min_m = m
                return min_m
            
            def f_formula(N):
                # compute smallest odd prime factor of N-1, ignoring 2
                n1 = N-1
                # find smallest odd prime factor
                p = None
                # handle 3 case
                if n1 % 3 == 0:
                    p = 3
                else:
                    # find smallest odd divisor >1
                    # iterate primes
                    for prime in sp.primerange(5, int(math.sqrt(n1))+2):
                        if n1 % prime == 0:
                            p = prime
                            break
                    if p is None:
                        # n1 may be prime or power of 2
                        # if n1 even, need smallest odd prime factor >2? none, set p = n1 (odd) maybe
                        # but if n1 is prime odd, p = n1
                        if n1 % 2 == 1:
                            p = n1
                        else:
                            # n1 even, need smallest odd prime factor of n1 (maybe >2)
                            # find any odd divisor
                            for prime in sp.primerange(3, int(math.sqrt(n1))+2):
                                if n1 % prime == 0:
                                    p = prime
                                    break
                            if p is None:
                                p = n1  # maybe power of 2? then no odd prime factor
                # compute candidate
                if p == 2:
                    # not allowed, use next odd prime factor
                    # but for now just return large
                    return None
                # compute lcm candidate using p
                # we need to ensure p != 2
                # compute l = (N-1)*(p-1)//p
                return (N-1)*(p-1)//p
            
            for N in range(6, 101):
                bf = f_bruteforce(N)
                fm = f_formula(N)
                if bf != fm:
                    print(N, bf, fm)
            
