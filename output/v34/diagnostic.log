            def nullspace_gf2(matrix):
                # matrix: list of rows (list of ints)
                m = len(matrix)
                n = len(matrix[0]) if m>0 else 0
                A = [row[:] for row in matrix]
                # Perform Gaussian elimination to row-echelon form, track pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot
                    pivot = None
                    for r in range(row, m):
                        if A[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r][col]:
                            A[r] = [(a ^ b) for a,b in zip(A[r], A[row])]
                    row += 1
                # Now matrix is in reduced row echelon form.
                # Determine free variables (non-pivot columns)
                free_cols = [c for c in range(n) if c not in pivot_cols]
                # For each free variable, construct a basis vector of nullspace
                basis = []
                for free in free_cols:
                    vec = [0]*n
                    vec[free] = 1
                    # For each pivot row, set pivot variable to satisfy equation
                    for r, piv in enumerate(pivot_cols):
                        # equation: pivot + sum_{free cols with 1} = 0 (since homogeneous)
                        # So pivot = sum_{free cols with 1} (mod 2)
                        if A[r][free]:
                            vec[piv] = 1
                    basis.append(vec)
                return basis
            
            basis = nullspace_gf2(vectors)
            len(basis)
