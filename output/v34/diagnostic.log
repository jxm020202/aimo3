            import sympy as sp
            x=sp.symbols('x')
            A = (4*x - 2 + 2*sp.sqrt(1-2*x)) / (3 - 5*x - sp.sqrt(1-2*x))
            u = (1+x**2)/2 + sp.Rational(1,6)*sp.sqrt(9*x**4 + sp.Rational(4,3)*x**6 + 9 + 18*x**2)
            v = (1+x**2)/2 - sp.Rational(1,6)*sp.sqrt(9*x**4 + sp.Rational(4,3)*x**6 + 9 + 18*x**2)
            # Use real_root for principal real cube root
            cube_sum = sp.real_root(u,3) + sp.real_root(v,3)
