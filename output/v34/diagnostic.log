            sqrt2 = math.sqrt(2)
            def d_for_u_branch(u, branch):
                # branch 0: upper (y = u + sqrt(1-u^2) >=0)
                # branch 1: lower (y = u - sqrt(1-u^2))
                if branch==0:
                    y = u + math.sqrt(max(0,1-u*u))
                else:
