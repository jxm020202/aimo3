```python
import sympy as sp

def f_bruteforce(n, limit=5000):
    """Return the smallest n‑Norwegian integer, or None if not found up to limit."""
    for x in range(1, limit+1):
        divs = sp.divisors(x)
        # need three distinct positive divisors whose sum is n
        for i in range(len(divs)):
            for j in range(i+1, len(divs)):
                for k in range(j+1, len(divs)):
                    if divs[i] + divs[j] + divs[k] == n:
                        return x
    return None

def spf(m):
    """smallest prime factor of m (m>1)"""
    return sp.factorint(m, limit=1000).popitem()[0]   # works for small m

def f_formula(n):
    if n <= 5:
        return None
    m = n-1
    if sp.isprime(m):
        # fallback – brute force (should not happen for our huge n)
        return f_bruteforce(n, limit=2000)
    p = sp.factorint(m, limit=1000).popitem()[0]   # smallest prime factor
    return (n-1)*(p-1)//p

# test for n = 6 … 100
for n in range(6, 101):
    bf = f_bruteforce(n, limit=5000)
    fm = f_formula(n)
    if bf != fm:
        print("mismatch at", n, bf, fm)
        break
else:
    print("All values up to 100 match the formula.")
```

