            from collections import deque
            
            def can_fill_full(n, init_mask):
                # mask is integer with n*n bits, 1=black
                target = (1 << (n*n)) - 1
                visited = set([init_mask])
                q = deque([init_mask])
                while q:
                    mask = q.popleft()
                    if mask == target:
                        return True
                    # generate moves
                    # iterate over all 2x2 blocks
                    for i in range(n-1):
                        for j in range(n-1):
                            # indices of four cells
                            idx = [i*n + j, (i+1)*n + j, i*n + (j+1), (i+1)*n + (j+1)]
                            bits = [(mask>>p)&1 for p in idx]
                            s = sum(bits)
                            if s == 3:
                                # turn the zero to 1
                                zero_idx = idx[bits.index(0)]
                                new_mask = mask | (1 << zero_idx)
                                if new_mask not in visited:
                                    visited.add(new_mask)
                                    q.append(new_mask)
                            elif s == 2:
                                # toggle all four bits
                                new_mask = mask
                                for p in idx:
                                    new_mask ^= (1 << p)
                                if new_mask not in visited:
                                    visited.add(new_mask)
                                    q.append(new_mask)
                return False
            
