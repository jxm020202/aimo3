            def count_outstanding(m,n,vals):
                # vals is list of length m*n, assign row-major order
                grid = [vals[i*n:(i+1)*n] for i in range(m)]
                # Precompute neighbor sets maybe
                count=0
                # iterate over all rectangles: choose top,bottom,left,right inclusive
                for top in range(m):
                    for bottom in range(top, m):
                        for left in range(n):
                            for right in range(left, n):
                                # interior cells indices
                                interior = [(i,j) for i in range(top,bottom+1) for j in range(left,right+1)]
                                # border cells that share a vertex with rectangle but not interior
                                # rows from top-1 to bottom+1, cols left-1 to right+1, exclude interior
                                border = []
                                for i in range(top-1, bottom+2):
                                    for j in range(left-1, right+2):
                                        if 0 <= i < m and 0 <= j < n:
                                            if not (top <= i <= bottom and left <= j <= right):
                                                # cell shares a vertex if it's within 1 Chebyshev distance
                                                # Actually any cell in that expanded rectangle touches S by at least a vertex
                                                # So border set is exactly that expanded rectangle minus interior
                                                border.append((i,j))
                                # Condition: each interior cell > each border cell
                                interior_vals = [grid[i][j] for i,j in interior]
                                border_vals = [grid[i][j] for i,j in border]
                                if all(iv > bv for iv in interior_vals for bv in border_vals):
                                    count+=1
                return count
            
