                # Use max-heap with negative remaining capacity
                heap = [(-caps[i], i) for i in range(1, N+1)]
                heapq.heapify(heap)
                while heap:
                    # pop vertex with largest remaining capacity
                    cap_neg, v = heapq.heappop(heap)
                    cap = -cap_neg
