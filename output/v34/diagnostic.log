            def has_nonneg_solution(m,n,k):
                d = math.gcd(m,n)
                if k % d != 0:
                    return False
                # Solve m b - n a = k - m
                # Use extended Euclidean to find one solution.
                # Solve m b + n (-a) = k - m.
                # Let x0, y0 be solution to m x + n y = g where g = gcd(m,n) = d.
                g, x0, y0 = sp.gcdex(m, n)  # returns (g, x, y) such that m*x + n*y = g
                # Multiply to get RHS = k - m
                rhs = k - m
                if rhs % d != 0:
                    return False
                mult = rhs // d
                b0 = x0 * mult
                a0 = -y0 * mult  # because we have m*b + n*(-a) = rhs
                # General solution: b = b0 + (n/d) * t, a = a0 + (m/d) * t
                step_b = n // d
                step_a = m // d
                # Need a >=0, b >=0. Find t integer such that both nonnegative.
                # Solve inequalities:
                # a0 + step_a * t >= 0 => t >= (-a0)/step_a
                # b0 + step_b * t >= 0 => t >= (-b0)/step_b
                # So t >= max(ceil(-a0/step_a), ceil(-b0/step_b))
                t_min = max(math.ceil(-a0/step_a), math.ceil(-b0/step_b))
                # Any t >= t_min works.
                # So solution exists.
                return True
            
