            def construct_S_N(r,c):
                N=r*c
                assign={}
                # list cells sorted by degree ascending (corner, edge, interior)
                cells=[]
                for i in range(r):
                    for j in range(c):
                        d=0
                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            if 0<=i+di<r and 0<=j+dj<c:
                                d+=1
                        cells.append(((i,j),d))
                # sort by degree ascending, then maybe by position
                cells.sort(key=lambda x: x[1])
                # assign labels 1..N in that order
                for idx, (cell, d) in enumerate(cells):
                    assign[cell]=idx+1
                return assign
            
