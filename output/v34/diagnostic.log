            def construct_grid(m,n):
                N=m*n
                low_vals = list(range(1, (N//2)+1))
                high_vals = list(range(N, (N//2), -1))  # descending from N to N//2+1
                grid = np.zeros((m,n), dtype=int)
                low_idx=0
                high_idx=0
                for i in range(m):
                    for j in range(n):
                        if (i+j)%2==0:
                            grid[i,j]=low_vals[low_idx]
                            low_idx+=1
                        else:
                            grid[i,j]=high_vals[high_idx]
                            high_idx+=1
                return grid
            
            def min_edge_sum_grid(grid):
                m,n=grid.shape
                mins=10**9
