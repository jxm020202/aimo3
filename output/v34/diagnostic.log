            def covering_radius(m):
                N=m*m
                # generate parity-check constraints: uniform row parity and column parity
                # We'll compute minimal weight for each syndrome via ILP using brute force for small m
                from itertools import product
                max_min=0
                worst=None
                # enumerate all vectors s (0/1) length N
                for bits in range(1<<N):
                    # compute syndrome: row parity differences and column parity differences
                    # compute row parity vector
                    row_par=[0]*m
                    col_par=[0]*m
                    for i in range(m):
                        for j in range(m):
                            if bits>> (i*m+j) &1:
                                row_par[i]^=1
                                col_par[j]^=1
                    # compute if vector is in subspace S: all rows equal and all cols equal and equal each other
                    if len(set(row_par))==1 and len(set(col_par))==1 and row_par[0]==col_par[0]:
                        # distance to S is 0
                        min_dist=0
                    else:
                        # need to find minimal weight vector in same coset? Actually we need distance to S.
                        # Compute min distance to any vector in S (i.e., min weight of bits + c where c in S)
                        # Equivalent to min weight of bits + c where c in S = min weight of bits + s where s in S
                        # That's same as min weight of bits xor s where s in S.
                        # We'll brute force over all s in S (size maybe 2^{dim}) but for small m we can enumerate all vectors and test membership.
                        min_dist=m*m+1
                        for y in range(1<<N):
