                    if i>0 and j>0:
                        coeff[var_index_NE(i-1, j-1)] = coeff.get(var_index_NE(i-1, j-1),0) + 1
                    if i>0 and j< N:
                        coeff[var_index_SE(i-1, j)] = coeff.get(var_index_SE(i-1, j),0) + 1
                    # incoming at (i+1,j+1)
