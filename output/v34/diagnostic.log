            # recursion with memoization
            @lru_cache(None)
            def dfs(idx, rem_const, rem_b, rem_c, rem_coins):
                # idx: current index (starting from len-1 down to 0)
                if idx < 0:
                    # all variables processed
                    if rem_const == 0 and rem_b == 0 and rem_c == 0 and rem_coins >= 0:
                        return True
                    else:
                        return False
                # prune if remaining coins negative
                if rem_coins < 0:
                    return False
                # compute bounds for remaining variables (0..idx)
                # max possible constant using remaining coins: rem_coins * max_a among 0..idx
                max_a_rem = max(a_vals[:idx+1])
                min_a_rem = min(a_vals[:idx+1])
                if rem_const > rem_coins * max_a_rem or rem_const < rem_coins * min_a_rem:
                    return False
                max_b_rem = max(b_vals[:idx+1])
                min_b_rem = min(b_vals[:idx+1])
                if rem_b > rem_coins * max_b_rem or rem_b < rem_coins * min_b_rem:
