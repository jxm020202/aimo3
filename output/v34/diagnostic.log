            import itertools, math, numpy as np, scipy.optimize as opt, scipy.sparse as sp
            
            def max_ops_milp(n):
                # variables for each unordered pair (i,j) with i<j
                pairs = [(i,j) for i in range(1,n+1) for j in range(i+1,n+1)]
                m = len(pairs)
                # objective: maximize sum x
                c = np.ones(m, dtype=int)
                # constraints: for each vertex i, sum_{j} x_{i,j} <= i
                # Build matrix A (n x m)
                rows = []
                cols = []
                data = []
                for idx, (i,j) in enumerate(pairs):
                    # vertex i
                    rows.append(i-1); cols.append(idx); data.append(1)
                    # vertex j
                    rows.append(j-1); cols.append(idx); data.append(1)
                A = sp.csr_matrix((data, (rows, cols)), shape=(n, m))
                # bounds for variables 0<=x<=1 integer
                bounds = opt.Bounds(0, 1)
                integrality = np.ones(m, dtype=int)
                # constraints: A x <= caps (i)
                caps = np.arange(1, n+1)
                lin_con = opt.LinearConstraint(A, -np.inf, caps)
                res = opt.milp(c=c, constraints=[lin_con], bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    raise Exception("MILP failed")
                return int(res.fun)
            
            for n in range(2,9):
