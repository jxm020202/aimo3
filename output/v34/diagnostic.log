            def max_black_count(board):
                # board: binary numpy array shape (n,n)
                n=board.shape[0]
                row_par = board.sum(axis=1)%2
                col_par = board.sum(axis=0)%2
                k=int(row_par.sum())
                l=int(col_par.sum())
                dist = min(max(k,l), max(n-k, n-l))
                return n*n - dist
            
