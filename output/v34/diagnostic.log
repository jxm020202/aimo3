            def fibonacci_word(n):
                # generate first n terms of Fibonacci word (0,1) using substitution
                s = "0"
                while len(s) < n:
                    s = s.replace("0","x").replace("1","y")
                    s = s.replace("x","01").replace("y","0")
                return s[:n]
            
            def distinct_blocks(s, L):
                return set(s[i:i+L] for i in range(len(s)-L+1))
            
