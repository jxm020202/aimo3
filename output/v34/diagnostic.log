                    # assign
                    assign[cell]=v
                    values.remove(v)
                    # check constraints with already assigned neighbors (already ensured)
                    # proceed
                    res=backtrack(cells, adj, values, S, assign, idx+1)
                    if res is not None:
                        return res
                    # backtrack
                    values.add(v)
                    del assign[cell]
                return None
            
