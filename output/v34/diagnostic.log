            def find_ordering(n, edges):
                used = {k:0 for k in range(1,n+1)}
                remaining = set(edges)
                order = []
                # simple DFS with recursion limit
                def dfs():
                    if not remaining:
                        return True
                    # heuristic: try edges where gcd is 1 first
                    for e in list(remaining):
                        i,j = e
                        a = i - used[i]
                        b = j - used[j]
                        if math.gcd(a,b)==1:
                            # choose
                            used[i]+=1
                            used[j]+=1
                            remaining.remove(e)
                            order.append(e)
                            if dfs():
                                return True
                            # backtrack
                            order.pop()
                            remaining.add(e)
                            used[i]-=1
                            used[j]-=1
                    return False
                if dfs():
                    return order
                else:
                    return None
            
