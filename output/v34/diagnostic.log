            def bfs_reachable(n):
                total = n*n
                start = (1 << total) - 1  # all black bits = 1
                # Precompute list of 2x2 block cell indices
                blocks = []
                for i in range(n-1):
                    for j in range(n-1):
                        idx = i*n + j
                        block = [idx, idx+1, idx+n, idx+n+1]
                        blocks.append(block)
                # BFS
                visited = set([start])
                q = collections.deque([start])
                while q:
                    state = q.popleft()
                    # reverse rule 1: find any 2x2 block with 4 blacks; turn any one cell to white (i.e., clear bit)
                    for block in blocks:
                        # count bits in block
                        bits = [(state >> pos) & 1 for pos in block]
                        s = sum(bits)
                        if s == 4:
                            # can turn any of the 4 cells to white
                            for pos in block:
                                new_state = state & ~(1 << pos)  # clear bit
                                if new_state not in visited:
                                    visited.add(new_state)
                                    q.append(new_state)
                    # reverse rule 2 (same as forward): flip any block with exactly 2 blacks
                    for block in blocks:
                        bits = [(state >> pos) & 1 for pos in block]
                        s = sum(bits)
                        if s == 2:
                            # flip all four bits
                            new_state = state
                            for pos in block:
                                new_state ^= (1 << pos)
                            if new_state not in visited:
                                visited.add(new_state)
                                q.append(new_state)
                return visited
            
            def minimal_k(n):
                reachable = bfs_reachable(n)
                total = n*n
                # For each k, check if all configurations with exactly k blacks are reachable
                # Count reachable per k
                count_by_k = [0]*(total+1)
                total_by_k = [0]*(total+1)
                for bits in range(1<< (n*n)):
                    k = bin(bits).count('1')
                    total_by_k[k] += 1
                    if bits in reachable:
                        count_by_k[k] += 1
                # Find minimal k such that for all >=k, count_by_k == total_by_k
                for k in range(total+1):
                    ok = True
                    for kk in range(k, total+1):
                        if count_by_k[kk] != total_by_k[kk]:
                            ok = False
                            break
                    if ok:
                        return k
                return None
            
            for n in range(2,5):
                print(n, minimal_k(n))
            
