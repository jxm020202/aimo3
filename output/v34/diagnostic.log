            import math
            from fractions import Fraction
            import sympy as sp
            
            def compute_A_numeric(x_frac):
                # x_frac is Fraction
                x = sp.Rational(x_frac.numerator, x_frac.denominator)
                # compute A with real cube roots
                num = 4*x - 2 + 2*sp.sqrt(1 - 2*x)
                den = 3 - 5*x - sp.sqrt(1 - 2*x)
                frac = sp.nsimplify(num/den)  # rational expression with sqrt
                term = (1 + x**2)/2
                rad = sp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                c1 = sp.real_root(term + rad/6, 3)
                c2 = sp.real_root(term - rad/6, 3)
                A = sp.N(frac + c1 + c2, 30)
                return A
            
            def is_rational_close(val, max_den=200):
                # try to approximate rational with denominator <= max_den
                try:
                    rat = Fraction(val).limit_denominator(max_den)
                    if abs(val - rat) < 1e-12:
                        return rat
                except Exception:
                    return None
                return None
            
            solutions = []
            max_den = 30
            for q in range(1, 31):
                for p in range(1, q+1):
                    x_val = Fraction(p, q)
                    if x_val <= 0 or x_val > Fraction(1,2):
                        continue
                    # compute A numeric
                    A_val = compute_A_numeric(x_val)
                    # check if A rational
                    A_rat = is_rational_close(float(A_val), max_den=200)
                    if A_rat is None:
                        continue
                    # compute y = sqrt(2A) - A
                    # need sqrt(2A) rational? compute numeric
                    y_val = math.sqrt(2*float(A_val)) - float(A_val)
                    y_rat = is_rational_close(y_val, max_den=200)
                    if y_rat is None:
                        continue
                    # check positivity
                    if y_rat <= 0:
                        continue
                    # compute k = lcm of denominators of x and y in lowest terms
                    den_x = x_val.denominator
                    den_y = y_rat.denominator
                    from math import gcd
                    def lcm(a,b): return a*b//gcd(a,b)
                    k = lcm(den_x, den_y)
                    solutions.append((k, x_val, y_rat, A_rat))
            solutions[:10], len(solutions)
            
