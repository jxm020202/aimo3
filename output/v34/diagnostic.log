                rP = count_common_real_roots_numpy(P)
                rQ = count_common_real_roots_numpy(Q)
                # count multiplicities? We'll treat distinct only
                common = set(rP).intersection(rQ)
                return len(common)
            
            def random_search_numpy(n, trials=2000):
                x=sp.Symbol('x')
                max_val=-1
                best=None
                coeff_vals=[-3,-2,-1,1,2,3]
                for _ in range(trials):
                    coeffsP = tuple(random.choice(coeff_vals) for _ in range(n+1))
                    if 0 in coeffsP: continue
                    coeffsQ = tuple(random.choice(coeff_vals) for _ in range(n+1))
                    if 0 in coeffsQ: continue
                    if coeffsP==coeffsQ: continue
                    P = sum(coeffsP[i]*x**i for i in range(n+1))
                    Q = sum(coeffsQ[i]*x**i for i in range(n+1))
                    s = sum(1 for i in range(n+1) if coeffsP[i]==coeffsQ[i])
                    r = common_real_roots_count(P,Q)
                    val = r + s
                    if val > max_val:
                        max_val = val
                        best = (coeffsP, coeffsQ, r, s)
                return max_val, best
            
