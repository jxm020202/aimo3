            def max_edges_milp(n):
                # create list of edges
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # objective: maximize sum x
                c = -np.ones(m)  # minimize negative to maximize
                # constraints: degree <= cap
                caps = [i+1 for i in range(n-1)] + [n-1]
                A = np.zeros((n, m), dtype=int)
                for idx, (i,j) in enumerate(edges):
                    A[i, idx] = 1
                    A[j, idx] = 1
                # upper bounds caps
                ub = np.array(caps)
                # bounds for variables 0<=x<=1
                bounds = opt.Bounds(0, 1)
                # integrality: all variables integer
                integrality = np.ones(m, dtype=int)
                # Use milp
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A, np.zeros(n), ub), bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    print("MILP failed")
                    return None
                edges_selected = [edges[i] for i, val in enumerate(res.x) if round(val) == 1]
                return len(edges_selected), edges_selected
            
            max_edges_milp(9)
            
