            def find_solution_m(m, n):
                # n variables (non-zero)
                # variables: real and imag for each
                vars = sp.symbols('x0:'+str(2*n), real=True)
                rs = []
                for i in range(n):
                    rs.append(vars[2*i] + sp.I*vars[2*i+1])
                eqs = []
                for e in range(1,m+1):
                    prod = 1
                    for r in rs:
                        prod = sp.expand(prod * (r**e + 1))
                    eqs.append(sp.re(prod - 1))
                    eqs.append(sp.im(prod - 1))
                # solve numerically with random guess
                for attempt in range(5):
                    guess = [random.uniform(-2,2) for _ in range(2*n)]
