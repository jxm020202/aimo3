            def max_S_grid_milp(m,n):
                V=m*n
                vertices=[(i,j) for i in range(m) for j in range(n)]
                edges=[]
                for i in range(m):
                    for j in range(n):
                        if i+1<m:
                            edges.append(((i,j),(i+1,j)))
                        if j+1<n:
                            edges.append(((i,j),(i,j+1)))
                # variable ordering: for each vertex v (0..V-1) and label k (1..V) binary variable x_{v,k}
                # plus variable S (continuous integer)
                num_vars=V*V+1
                # objective: maximize S -> minimize -S
                c=np.zeros(num_vars)
                c[-1]=-1  # minimize -S
                
                # constraints list
                A=[]
                lb=[]
                ub=[]
                # each vertex gets exactly one label
                for vi in range(V):
                    row=np.zeros(num_vars)
                    for k in range(V):
                        row[vi*V + k]=1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # each label assigned to exactly one vertex
                for k in range(V):
                    row=np.zeros(num_vars)
                    for vi in range(V):
                        row[vi*V + k]=1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # edge sum constraints: sum_{k} k x_{u,k} + sum_{l} l x_{v,l} - S >= 0
                for (u_coord,v_coord) in edges:
                    u_idx=vertices.index(u_coord)
                    v_idx=vertices.index(v_coord)
                    row=np.zeros(num_vars)
                    # contribution of u
                    for k in range(V):
                        row[u_idx*V + k] = (k+1)  # label value
                    # contribution of v
                    for k in range(V):
                        row[v_idx*V + k] = (k+1)
                    # subtract S
                    row[-1] = -1
                    A.append(row)
                    lb.append(0)
                    ub.append(np.inf)
                # variable bounds: binary for x, integer for S (>=0)
                var_bounds=Bounds(0,1)  # for all variables initially
                # but S can be up to 2*V maybe. We'll set bounds later.
                # Need to set integrality: all variables integer
                integrality=np.ones(num_vars, dtype=int)
                # Build LinearConstraint
                A_mat=np.vstack(A)
                lc=LinearConstraint(A_mat, lb, ub)
                # bounds for variables
                # For x variables: 0-1; for S: 0-2*V
                lower=np.concatenate([np.zeros(V*V), [0]])
                upper=np.concatenate([np.ones(V*V), [2*V]])
                var_bounds=Bounds(lower, upper)
                res=milp(c, constraints=lc, bounds=var_bounds, integrality=integrality, options={"disp": False})
                if not res.success:
                    print("MILP failed")
                    return None
                S_opt=int(round(res.x[-1]))
                return S_opt
            
