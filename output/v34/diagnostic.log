            def nullspace_mod2(A):
                m = len(A)
                n = len(A[0]) if m>0 else 0
                M = [row[:] for row in A]
                row = 0
                pivot_cols = []
                for col in range(n):
                    sel = None
                    for i in range(row, m):
                        if M[i][col] == 1:
                            sel = i
                            break
                    if sel is None:
                        continue
                    M[row], M[sel] = M[sel], M[row]
                    pivot_cols.append(col)
                    for i in range(m):
                        if i != row and M[i][col] == 1:
                            M[i] = [(M[i][j] ^ M[row][j]) for j in range(n)]
                    row += 1
                    if row == m:
                        break
                free_cols = [c for c in range(n) if c not in pivot_cols]
                basis = []
                for free in free_cols:
                    vec = [0]*n
                    vec[free] = 1
                    for i, p in enumerate(pivot_cols):
                        # compute value for pivot column p
                        s = 0
                        for j in range(n):
                            if j != p and M[i][j] == 1 and vec[j] == 1:
                                s ^= 1
                        vec[p] = s
                    basis.append(vec)
                return basis
            
