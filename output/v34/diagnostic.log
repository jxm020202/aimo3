                # Actually we need to set integrality for v and u and w as integer (not necessarily binary). We'll set integrality=1 for all binary, and for integer we also set integrality=1? In milp, integrality vector indicates which variables are integer (including binary). So we set integrality=1 for all variables that must be integer (including binary). So we set all to 1.
                integrality = np.ones(total_vars, dtype=int)
                # Now constraints:
                constraints = []
                # Row parity constraints: sum_j a_ij - 2*u_i = p_i
                A_rows = []
                l_rows = []
                u_rows = []
                for i in range(N):
                    row = np.zeros(total_vars)
                    # a_ij indices
                    for j in range(N):
                        idx_a = i*N + j
                        row[idx_a] = 1
                    # u_i index
                    idx_u = n_a + n_p + n_q + i  # after a,p,q
                    row[idx_u] = -2
                    # p_i index
                    idx_p = n_a + i
                    row[idx_p] = -1
                    # equation: sum a - 2*u - p = 0
                    A_rows.append(row)
                    l_rows.append(0)
                    u_rows.append(0)
                # Column parity constraints: sum_i a_ij - 2*w_j = q_j
                for j in range(N):
                    row = np.zeros(total_vars)
                    for i in range(N):
                        idx_a = i*N + j
                        row[idx_a] = 1
                    idx_w = n_a + n_p + n_q + n_u + j  # after a,p,q,u
                    row[idx_w] = -2
                    idx_q = n_a + n_p + j
                    row[idx_q] = -1
                    A_rows.append(row)
                    l_rows.append(0)
                    u_rows.append(0)
                # Output bit constraints: K_ij + a_ij + p_i + q_j - 2*v_ij = b_ij
                for i in range(N):
                    for j in range(N):
                        row = np.zeros(total_vars)
                        idx_a = i*N + j
                        idx_p = n_a + i
                        idx_q = n_a + n_p + j
                        idx_v = n_a + n_p + n_q + n_u + n_w + i*N + j
                        idx_b = n_a + n_p + n_q + n_u + n_w + n_v + i*N + j
                        row[idx_a] = 1
                        row[idx_p] = 1
                        row[idx_q] = 1
                        row[idx_v] = -2
                        row[idx_b] = -1
                        # constant term K_ij moves to RHS
                        const = K[i,j]
                        # Equation: a + p + q - 2v - b = -K => a + p + q - 2v - b + K = 0
                        # We'll move K to left side: a + p + q - 2v - b = -K
                        # So we set row coefficients as above, and set RHS = -K
                        A_rows.append(row)
                        l_rows.append(-const)
                        u_rows.append(-const)
                # Bounds for integer variables u,w,v:
