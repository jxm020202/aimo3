            def feasible_S(S, seed=0):
                n=60
                deg = np.full((n,n), 4, dtype=int)
                deg[0,:]=3; deg[-1,:]=3; deg[:,0]=3; deg[:,-1]=3
                deg[0,0]=deg[0,-1]=deg[-1,0]=deg[-1,-1]=2
                cells = [(i,j) for i in range(n) for j in range(n)]
                cells.sort(key=lambda ij: deg[ij[0], ij[1]])  # ascending degree
                # remaining numbers set
                remaining = list(range(1, n*n+1))
                # We'll use a simple heuristic: try numbers from smallest to largest that satisfy constraints
                grid = np.zeros((n,n), dtype=int)
                for (i,j) in cells:
                    # find a number that works
                    found=False
                    for idx, val in enumerate(remaining):
                        ok=True
                        # check neighbors already assigned
                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            ni, nj = i+di, j+dj
                            if 0 <= ni < n and 0 <= nj < n and grid[ni,nj]!=0:
                                if val + grid[ni,nj] < S:
                                    ok=False
                                    break
                        if ok:
                            grid[i,j]=val
                            remaining.pop(idx)
                            found=True
                            break
                    if not found:
                        return False, None
                return True, grid
            
            # test for small S
            print(feasible_S(1802)[0])
            
