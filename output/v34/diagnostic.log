            def solvable_to_all_black(n,m):
                total_cells = n*m
                all_black = (1<<total_cells)-1
                # Precompute neighbor moves for each mask? We'll BFS from each configuration? That's many.
                # Instead compute reachable from each configuration via BFS forward until either all_black reached or no new states.
                # But we can compute reverse BFS from all_black using inverse moves? Moves are not necessarily reversible because rule A is not invertible (increase count).
                # However we can compute forward BFS from each configuration individually; for small n,m it's okay.
                solvable = {}
                # generate all masks
                for mask in range(1<<total_cells):
                    # BFS
                    visited = set([mask])
                    queue = collections.deque([mask])
                    found = False
                    while queue:
                        cur = queue.popleft()
                        if cur == all_black:
                            found = True
                            break
                        # generate moves
                        # iterate over 2x2 blocks
                        for i in range(n-1):
