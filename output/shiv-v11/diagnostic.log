            def max_spread_on_arc(phi, steps_i=200, steps_theta=200):
                # phi in radians, arc from angle 0 to phi on unit circle.
                # For each point i on the arc (parameter t_i), compute angular spread of other points on the arc.
                # Return the maximum spread over i.
                thetas = np.linspace(0, phi, steps_theta)
                max_spread = 0.0
                for ti in np.linspace(0, phi, steps_i):
                    # position of i
                    xi = np.array([math.cos(ti), math.sin(ti)])
                    # direction vectors to other points (excluding i)
                    angles = []
                    for t in thetas:
                        if abs(t - ti) < 1e-12:
                            continue
                        v = np.array([math.cos(t), math.sin(t)]) - xi
                        ang = math.atan2(v[1], v[0])
                        angles.append(ang)
                    # unwrap
                    angles = np.unwrap(np.array(angles))
                    spread = angles.max() - angles.min()
                    if spread > max_spread:
                        max_spread = spread
                return max_spread
            
            for deg in [10,20,30,40,50,60,70,80,90]:
                phi=math.radians(deg)
                spread=max_spread_on_arc(phi)
