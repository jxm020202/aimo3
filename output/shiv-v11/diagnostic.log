            def max_visible_on_circle(n=100, angle_deg=100):
                # points uniformly spaced on circle, observer at index 0
                R=1
                pts=[(math.cos(2*math.pi*i/n), math.sin(2*math.pi*i/n)) for i in range(n)]
                obs=pts[0]
                # compute angles of vectors from obs to others
                angles=[]
                for j in range(1,n):
                    dx=pts[j][0]-obs[0]
                    dy=pts[j][1]-obs[1]
                    ang=math.atan2(dy,dx) # -pi to pi
                    angles.append(ang)
