            import math, itertools
            
            def max_visible_on_circle(n, angle_deg=100):
                angle_rad = math.radians(angle_deg)
                # points on unit circle at angles 2π*k/n
                pts = [(math.cos(2*math.pi*k/n), math.sin(2*math.pi*k/n)) for k in range(n)]
                total = 0
                for i in range(n):
                    # compute direction angles from i to others
                    angles = []
                    xi, yi = pts[i]
                    for j in range(n):
                        if i==j: continue
                        xj, yj = pts[j]
                        dx, dy = xj-xi, yj-yi
                        ang = math.atan2(dy, dx)  # -π to π
                        angles.append(ang)
                    # sort angles
                    angles.sort()
                    # duplicate with +2π for wrap-around
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window
                    maxcnt = 0
                    m = len(angles)
                    j = 0
                    for i2 in range(m):
                        while j < i2+m and angles2[j] - angles2[i2] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - i2
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            print(max_visible_on_circle(100))
            
