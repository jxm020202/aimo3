                # Simpler approach: compute minimal count by scanning all possible start indices j in range N and checking if interval [angles[j], angles[j]+L] contains i.
                # This is O(N^2) but N=100, fine.
                N = len(angles_deg)
                m = [N+1]*N
                for i in range(N):
                    ai = angles_deg[i]
                    best = N+1
                    for j in range(N):
                        start = angles_deg[j]
                        # interval [start, start+L] mod 360
                        # check if ai is in this interval (consider wrap)
                        if start <= ai <= start+L:
                            cnt = counts[j]
                            if cnt < best:
