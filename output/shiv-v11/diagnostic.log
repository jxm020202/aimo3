            import random, math
            def max_angle_from_point_on_circle(N=100, trials=1000):
                max_angle = 0
                for _ in range(trials):
                    # generate N points on unit circle
                    pts = [(math.cos(2*math.pi*i/N), math.sin(2*math.pi*i/N)) for i in range(N)]
                    # pick a point i
                    i = random.randrange(N)
                    pi = pts[i]
                    # compute angles between vectors to other points
                    others = pts[:i] + pts[i+1:]
                    # compute angles of vectors
                    vecs = [(p[0]-pi[0], p[1]-pi[1]) for p in others]
                    # compute max angle between any two vectors
                    for a in range(len(vecs)):
                        for b in range(a+1, len(vecs)):
                            v1 = vecs[a]
                            v2 = vecs[b]
                            dot = v1[0]*v2[0] + v1[1]*v2[1]
                            norm1 = math.hypot(v1[0], v1[1])
                            norm2 = math.hypot(v2[0], v2[1])
                            cosang = dot/(norm1*norm2)
                            cosang = max(-1,min(1,cosang))
                            ang = math.degrees(math.acos(cosang))
                            if ang > max_angle:
                                max_angle = ang
                return max_angle
            
