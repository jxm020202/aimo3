            def generate_two_circles_cluster(N_out, N_in, r_out=1.0, r_in=0.2):
                pts=[]
                for i in range(N_out):
                    theta=2*math.pi*i/N_out
                    pts.append((r_out*math.cos(theta), r_out*math.sin(theta)))
                # inner cluster points randomly within small disk radius r_in
                for i in range(N_in):
                    r=math.sqrt(random.random())*r_in
                    theta=random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def test_two(N_out,N_in):
                pts=generate_two_circles_cluster(N_out,N_in)
                return total_sum_points(pts)
            
