            def angular_spread_min_interval(theta_deg, phi_deg):
                phi = math.radians(phi_deg)
                theta = math.radians(theta_deg)
                angles = []
                for psi_deg in np.linspace(0, theta_deg, 2001):
                    psi = math.radians(psi_deg)
                    dx = math.cos(psi) - math.cos(phi)
                    dy = math.sin(psi) - math.sin(phi)
                    ang = math.atan2(dy, dx)
                    # normalize to [0, 2π)
                    if ang < 0:
                        ang += 2*math.pi
                    angles.append(ang)
                angles.sort()
                # compute max gap
                max_gap = 0
                for i in range(len(angles)):
                    j = (i+1) % len(angles)
                    diff = (angles[j] - angles[i]) % (2*math.pi)
                    if diff > max_gap:
                        max_gap = diff
                # minimal covering interval length = 2π - max_gap
                spread = 2*math.pi - max_gap
                return spread
            
            def max_spread_for_theta(theta_deg):
                max_spread = 0
                best_phi = None
                for phi_deg in np.linspace(0, theta_deg, 1001):
                    spread = angular_spread_min_interval(theta_deg, phi_deg)
                    if spread > max_spread:
                        max_spread = spread
                        best_phi = phi_deg
                return max_spread, best_phi
            
