            def min_angular_interval(angles):
                # angles in radians, normalized to [0,2π)
                angles = np.mod(angles, 2*math.pi)
                angles = np.sort(angles)
                # compute gaps
                gaps = np.diff(np.concatenate([angles, angles[:1] + 2*math.pi]))
                max_gap = np.max(gaps)
                return 2*math.pi - max_gap
            
