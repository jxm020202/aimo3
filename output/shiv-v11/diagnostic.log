            import numpy as np, math, random, time
            
            def compute_a_i_numpy(points, width_deg=100):
                pts = np.array(points)  # shape (N,2)
                N = pts.shape[0]
                a = np.zeros(N, dtype=int)
                width = width_deg + 1e-9
                for i in range(N):
                    diffs = pts - pts[i]  # shape (N,2)
                    # exclude i
                    diffs[i] = np.array([0.0,0.0])
                    angles = np.degrees(np.arctan2(diffs[:,1], diffs[:,0]))
                    angles = np.mod(angles, 360)
                    # remove i's angle (0)
                    mask = np.arange(N)!=i
                    angs = np.sort(angles[mask])
                    # duplicate
                    angs2 = np.concatenate([angs, angs+360])
                    # sliding window
                    j = 0
                    maxc = 0
                    n = len(angs)
                    for i2 in range(n):
                        while j < i2+n and angs2[j] - angs2[i2] <= width:
                            j += 1
                        cnt = j - i2
                        if cnt > maxc:
                            maxc = cnt
                    a[i] = maxc
                return a
            
            def total_sum_numpy(points):
                return int(compute_a_i_numpy(points).sum())
            
            def random_move_numpy(pt, R=1.0, step=0.2):
                ang = random.random()*2*math.pi
                dx = step*math.cos(ang)
                dy = step*math.sin(ang)
                nx, ny = pt[0]+dx, pt[1]+dy
                if nx*nx+ny*ny > R*R:
                    factor = R / math.sqrt(nx*nx+ny*ny)
                    nx, ny = nx*factor, ny*factor
                return (nx, ny)
            
            def simulated_anneal_fast(N=100, R=1.0, iterations=20000):
                pts = [(R*math.cos(2*math.pi*i/N), R*math.sin(2*math.pi*i/N)) for i in range(N)]
                cur_score = total_sum_numpy(pts)
                best = cur_score
                best_pts = pts[:]
                T0 = 1.0
                for it in range(iterations):
                    T = T0 * (1 - it/iterations)
                    idx = random.randrange(N)
                    new_pt = random_move_numpy(pts[idx], R, step=0.2)
                    old_pt = pts[idx]
                    pts[idx] = new_pt
                    new_score = total_sum_numpy(pts)
                    delta = new_score - cur_score
                    if delta > 0 or random.random() < math.exp(delta/(T+1e-9)):
                        cur_score = new_score
                        if cur_score > best:
                            best = cur_score
                            best_pts = pts[:]
                            if best > 7900:
                                print("Iter", it, "best", best)
                    else:
                        pts[idx] = old_pt  # revert
                return best, best_pts
            
            best, best_pts = simulated_anneal_fast(iterations=5000)
            best
            
