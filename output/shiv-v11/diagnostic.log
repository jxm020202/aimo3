            import math, random, copy
            
            def max_in_wedge(points, i, angle_deg=100):
                ox, oy = points[i]
                dirs = []
                for j, (x,y) in enumerate(points):
                    if j==i: continue
                    dx, dy = x-ox, y-oy
                    theta = math.atan2(dy, dx)
                    dirs.append(theta)
                dirs.sort()
                dirs2 = dirs + [d+2*math.pi for d in dirs]
                maxcnt = 0
                n = len(dirs)
                j = 0
                for k in range(n):
                    while j < k+n and dirs2[j] - dirs2[k] <= math.radians(angle_deg) + 1e-12:
                        j+=1
                    cnt = j - k
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_sum(points):
                return sum(max_in_wedge(points,i) for i in range(len(points)))
            
            def random_points_inside_circle(n, radius=1.0):
                pts = []
                for _ in range(n):
                    r = radius * math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def hill_climb_random(start_pts, iterations=1500, step=0.3):
