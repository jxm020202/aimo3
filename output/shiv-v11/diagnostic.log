            import math, random, numpy as np
            
            def visible_region_area(num_samples=2000000):
                # Monte Carlo estimate of area of region visible from point on unit circle with 100° sector
                # Place observer at (1,0). Sector angle = 100°, i.e., +/-50° from direction towards interior (i.e., leftwards)
                # We'll define direction vector from observer to center: (-1,0). The sector is centered on that direction.
                # So rays at angles -50° and +50° relative to direction to center.
                # Compute unit vectors for the two boundary rays.
                theta_center = math.pi  # direction from (1,0) to (0,0) is pi radians (pointing left)
                half_angle = math.radians(50)
                # define two direction angles:
                dir1 = theta_center - half_angle
                dir2 = theta_center + half_angle
                # For each random point in unit disk, check if angle between vector from observer to point and direction to center <= half_angle
                count = 0
                total = 0
                for _ in range(num_samples):
                    # random point in unit disk
                    r = math.sqrt(random.random())
                    phi = random.random()*2*math.pi
                    x = r*math.cos(phi)
                    y = r*math.sin(phi)
                    # vector from observer to point
                    vx = x - 1.0
                    vy = y - 0.0
                    # compute angle between vector and direction to center (which is (-1,0))
                    # Use dot product
                    dot = vx*(-1) + vy*0
                    norm_v = math.hypot(vx, vy)
                    if norm_v == 0:
                        # point is observer itself, ignore
                        continue
                    cos_angle = dot/(norm_v*1.0)  # direction to center is unit vector (-1,0)
                    # angle = arccos(cos_angle)
                    # check if angle <= half_angle
                    if cos_angle >= math.cos(half_angle):
                        count += 1
                    total += 1
                # area of unit disk = pi
                area_est = (count/total) * math.pi
                return area_est
            
            area_est = visible_region_area(200000)
            area_est
            
