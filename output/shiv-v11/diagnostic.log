            def compute_sum_fast(points, alpha=math.radians(100)):
                n = len(points)
                total = 0
                for i in range(n):
                    xi, yi = points[i]
                    # compute angles to others
                    angles = np.empty(n-1)
                    idx = 0
                    for j in range(n):
                        if i == j: continue
                        xj, yj = points[j]
                        angles[idx] = math.atan2(yj-yi, xj-xi)
                        idx += 1
                    angles.sort()
                    # duplicate for wrap-around
                    m = n-1
                    angles2 = np.concatenate([angles, angles + 2*math.pi])
                    # sliding window
                    best = 0
                    left = 0
                    for right in range(m*2):
                        while angles2[right] - angles2[left] > alpha + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > best:
                            best = cnt
                    total += best
                return total
            
