                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        dx = xj - xi
                        dy = yj - yi
                        ang = math.degrees(math.atan2(dy, dx))
                        dirs.append(ang)
                    dirs.sort()
                    dirs2 = dirs + [a+360 for a in dirs]
