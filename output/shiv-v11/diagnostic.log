            def max_visible_from_point(p, others, angle=100.0):
                # p: (x,y)
                # others: list of (x,y)
                # compute angles of vectors from p to each other point
                angles = []
                for q in others:
                    dx = q[0]-p[0]
                    dy = q[1]-p[1]
                    ang = math.degrees(math.atan2(dy,dx)) % 360.0
                    angles.append(ang)
                angles.sort()
