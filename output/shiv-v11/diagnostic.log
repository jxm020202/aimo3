            import random, math, numpy as np
            
            def max_visible_from_point(p_i, points, angle=math.radians(100)):
                dirs = []
                for p in points:
                    if p is p_i:
                        continue
                    dx = p[0] - p_i[0]
                    dy = p[1] - p_i[1]
                    ang = math.atan2(dy, dx)
                    dirs.append(ang)
                dirs = np.mod(dirs, 2*math.pi)
                dirs = np.sort(dirs)
                dirs_ext = np.concatenate([dirs, dirs+2*math.pi])
                maxcnt = 0
                left = 0
                for right in range(len(dirs_ext)):
                    while dirs_ext[right] - dirs_ext[left] > angle + 1e-12:
                        left += 1
                    cnt = right - left + 1
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_visibility(points):
                return sum(max_visible_from_point(p, points) for p in points)
            
