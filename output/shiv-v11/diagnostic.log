            import math, random
            
            def compute_a_i(angles):
                # angles in radians, points on unit circle
                n = len(angles)
                a = []
                for i, theta_i in enumerate(angles):
                    # compute direction angles relative to inward normal (pointing to center)
                    # Inward normal direction is angle theta_i + pi (pointing to center)
                    # For each other point j, compute vector v = (cosθj - cosθi, sinθj - sinθi)
                    # Compute angle of v relative to inward normal direction.
                    # Equivalent to compute angle difference between direction to center and direction to point.
                    # Use formula: ψ = atan2(dy, dx) - (theta_i + math.pi)
                    # Normalize to [-pi, pi]
                    diffs = []
                    for j, theta_j in enumerate(angles):
                        if i == j: continue
                        dx = math.cos(theta_j) - math.cos(theta_i)
                        dy = math.sin(theta_j) - math.sin(theta_i)
                        angle = math.atan2(dy, dx)  # direction of vector from i to j
                        # inward normal direction:
                        norm = theta_i + math.pi
                        psi = angle - norm
                        # normalize to [-pi, pi]
                        while psi <= -math.pi: psi += 2*math.pi
                        while psi > math.pi: psi -= 2*math.pi
                        # convert to degrees for convenience
                        diffs.append(math.degrees(psi))
                    # Now we have direction angles in degrees in range [-180,180]
                    # We need to find max number within any interval of length 100 degrees.
                    diffs.sort()
                    # duplicate with +360 to handle wrap
                    extended = diffs + [d+360 for d in diffs]
                    max_count = 0
                    L = 100.0
                    j = 0
                    for k in range(len(diffs)):
                        while extended[j] - extended[k] <= L + 1e-9:
                            j += 1
                        count = j - k
                        if count > max_count:
                            max_count = count
                    a.append(max_count)
                return a
            
            def test_cluster(n=100, arc_deg=200):
                # generate n angles uniformly within arc [0, arc_deg]
                start = random.random()*360
                # ensure arc doesn't wrap beyond 360
                # choose start such that start+arc_deg <= 360
                start = random.uniform(0, 360-arc_deg)
                angles = [math.radians(start + i*arc_deg/(n-1)) for i in range(n)]
                a = compute_a_i(angles)
                return sum(a), a[:5]
            
            sum_a, sample_a = test_cluster()
            sum_a, sample_a[:5]
            
