            import math, numpy as np
            
            def max_angle_spread(theta):
                # theta: total arc angle (radians) of points on unit circle from -theta/2 to +theta/2
                # compute angular spread of direction vectors from endpoint at angle -theta/2 to all points on arc
                endpoint = -theta/2
                # sample many points on arc
                phis = np.linspace(-theta/2, theta/2, 10001)
                # direction vectors from endpoint to each phi
                vx = np.cos(phis) - np.cos(endpoint)
                vy = np.sin(phis) - np.sin(endpoint)
                # compute angles of vectors relative to some reference, e.g., x-axis
                angles = np.arctan2(vy, vx)
                # compute spread (max - min) after adjusting for wrap-around
                # ensure continuity: shift angles to be within [0, 2π)
                # but we need the minimal angular interval covering all angles
                # we can compute max difference after sorting and considering wrap-around
                ang = np.sort(angles)
                diffs = np.diff(np.concatenate([ang, ang[:1]+2*math.pi]))
                # The maximal gap is max(diffs); the minimal covering interval length = 2π - max_gap
                max_gap = np.max(diffs)
                spread = 2*math.pi - max_gap
                return spread
            
