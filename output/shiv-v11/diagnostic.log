            def direction_angles_from_point(p, others):
                angs=[]
                for q in others:
                    dx=q[0]-p[0]; dy=q[1]-p[1]
                    ang=math.atan2(dy,dx)
                    angs.append(ang)
                return sorted(angs)
            
            def min_covering_arc_length(angles):
                # angles sorted in [0,2π)
                n=len(angles)
                # duplicate with +2π
                ang2=angles+[a+2*math.pi for a in angles]
                max_gap=0
                for i in range(n):
                    gap=ang2[i+n-1]-ang2[i] # length of interval covering n points
                    # Actually we want minimal covering interval length = 2π - max_gap
                # compute max gap between consecutive angles
                max_gap=0
                for i in range(n):
                    nxt = angles[(i+1)%n] + (2*math.pi if i==n-1 else 0)
                    gap = nxt - angles[i]
                    if gap>max_gap:
                        max_gap=gap
                return 2*math.pi - max_gap
            
            def test_arc(L_deg, n=10):
                # points on circle radius 1, arc from -L/2 to L/2
                L=math.radians(L_deg)
                angles=np.linspace(-L/2, L/2, n)
                pts=[(math.cos(a), math.sin(a)) for a in angles]
                # pick a point not at endpoint, say middle index
                i=n//2
                p=pts[i]
                others=pts[:i]+pts[i+1:]
                angs=direction_angles_from_point(p, others)
                # normalize to [0,2π)
                angs=[a%(2*math.pi) for a in angs]
                angs.sort()
                length=min_covering_arc_length(angs)
                return length
            
