            import random, math, itertools, time, sys, numpy as np
            
            def sum_visibility(pts, angle_deg=100):
                n = len(pts)
                total = 0
                angle_rad = math.radians(angle_deg)
                for i in range(n):
                    angles = []
                    xi, yi = pts[i]
                    for j in range(n):
                        if i == j: continue
                        xj, yj = pts[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                    # sort angles
                    angles = sorted(angles)
                    # duplicate with +2π for circular wrap
                    angles2 = angles + [a + 2*math.pi for a in angles]
                    # sliding window
                    maxcnt = 0
                    m = len(angles)
                    j = 0
                    for i_ang in range(m):
                        while j < i_ang + m and angles2[j] - angles2[i_ang] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - i_ang
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_points_in_circle(n, radius=1.0):
                pts = []
                for _ in range(n):
                    # uniform in circle
                    r = radius * math.sqrt(random.random())
                    theta = random.random() * 2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def hill_climb(n, iter=2000):
                # start with random points
                pts = random_points_in_circle(n)
                best = sum_visibility(pts)
                best_pts = pts[:]
                for it in range(iter):
                    # perturb one point slightly
                    i = random.randrange(n)
                    # small move
                    dx = (random.random()*2-1)*0.1
                    dy = (random.random()*2-1)*0.1
                    new_pt = (pts[i][0]+dx, pts[i][1]+dy)
                    # keep inside unit circle
                    if new_pt[0]**2 + new_pt[1]**2 > 1.0:
                        continue
                    old = pts[i]
                    pts[i] = new_pt
                    val = sum_visibility(pts)
                    if val > best:
                        best = val
                        best_pts = pts[:]
                    else:
                        # revert
                        pts[i] = old
                return best, best_pts
            
            def random_search(n, trials=200):
                best = -1
                best_pts = None
                for t in range(trials):
                    pts = random_points_in_circle(n)
                    val = sum_visibility(pts)
                    if val > best:
                        best = val
                        best_pts = pts
                return best, best_pts
            
