            import math, random, time
            
            def total_visibility_angles(thetas, angle_deg=100):
                # thetas in radians
                N = len(thetas)
                total = 0
                L = math.radians(angle_deg)
                for i in range(N):
                    xi, yi = math.cos(thetas[i]), math.sin(thetas[i])
                    angles = []
                    for j in range(N):
                        if i == j: continue
                        xj, yj = math.cos(thetas[j]), math.sin(thetas[j])
                        ang = math.atan2(yj-yi, xj-xi)
                        if ang < 0: ang += 2*math.pi
                        angles.append(ang)
                    angles.sort()
                    angles2 = angles + [a+2*math.pi for a in angles]
                    best = 0
                    left = 0
                    for right in range(len(angles)):
                        while angles2[right] - angles2[left] > L + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > best:
                            best = cnt
                    total += best
                return total
            
            def simulated_annealing(N=100, iterations=20000, init_spread=180):
                # initialize angles uniformly random
                thetas = [random.random()*2*math.pi for _ in range(N)]
                # ensure distinct (unlikely to be equal)
                best_val = total_visibility_angles(thetas)
                best_thetas = thetas[:]
                val = best_val
                T0 = 1.0
                T_end = 0.001
                start = time.time()
                for it in range(iterations):
                    # temperature schedule
                    t = it/iterations
                    T = T0 * (1 - t) + T_end * t
                    # propose move: pick random index and perturb angle
                    i = random.randrange(N)
                    old_theta = thetas[i]
                    # perturb by small amount
                    delta = (random.random()*2-1) * 0.1  # +/-0.1 rad ~5.7°
                    new_theta = (old_theta + delta) % (2*math.pi)
                    thetas[i] = new_theta
                    new_val = total_visibility_angles(thetas)
                    delta_val = new_val - val
                    if delta_val > 0 or random.random() < math.exp(delta_val / T):
                        val = new_val
                        if val > best_val:
                            best_val = val
                            best_thetas = thetas[:]
                            # print progress
                            if it % 1000 == 0:
                                print(it, best_val)
                    else:
                        # revert
                        thetas[i] = old_theta
                return best_val, best_thetas
            
            best_val, best_thetas = simulated_annealing(N=50, iterations=5000)
            best_val
            
