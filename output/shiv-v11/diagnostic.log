            import random, math, time
            
            def random_point_in_circle():
                r = math.sqrt(random.random())
                theta = random.random()*2*math.pi
                return (r*math.cos(theta), r*math.sin(theta))
            
            def hill_climb_random_moves(iterations=20000):
                # start with random points
                pts = [random_point_in_circle() for _ in range(100)]
                best_pts = pts[:]
                best_val = total_visibility_fast(pts)
                print("initial", best_val)
                start_time = time.time()
                for it in range(iterations):
                    idx = random.randrange(100)
                    old = pts[idx]
                    new_pt = random_point_in_circle()
                    pts[idx] = new_pt
                    val = total_visibility_fast(pts)
                    if val > best_val:
                        best_val = val
                        best_pts = pts[:]
                        #print("new best", best_val, "iter", it)
                    else:
                        pts[idx] = old
                    # optional early stop if time
                    if time.time() - start_time > 25:
