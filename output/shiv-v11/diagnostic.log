                        i,j = random.sample(range(100),2)
                        child_angles[i], child_angles[j] = child_angles[j], child_angles[i]
                    child_sum = compute_sum_angles(child_angles)
                    # replace worst if child better than worst
                    if child_sum > population[-1][0]:
                        population[-1] = (child_sum, child_angles)
                        population.sort(reverse=True, key=lambda x: x[0])
                        if child_sum > best_sum:
                            best_sum, best_angles = child_sum, child_angles
                return best_sum, best_angles
            
