            def psi_formula(theta_i, theta_j):
                # delta = (theta_j - theta_i) in degrees modulo 360
                delta = (math.degrees(theta_j - theta_i)) % 360
                psi = 90 - delta/2
                # normalize to [-180,180]
                while psi <= -180: psi += 360
                while psi > 180: psi -= 360
                return psi
            
            def psi_actual(theta_i, theta_j):
                xi, yi = math.cos(theta_i), math.sin(theta_i)
                xj, yj = math.cos(theta_j), math.sin(theta_j)
                dx, dy = xj - xi, yj - yi
                # inward normal direction angle = theta_i + pi (pointing to center)
                norm_angle = math.degrees(theta_i + math.pi) % 360
                v_angle = math.degrees(math.atan2(dy, dx)) % 360
                psi = (v_angle - norm_angle + 180) % 360 - 180  # difference in [-180,180]
                return psi
            
