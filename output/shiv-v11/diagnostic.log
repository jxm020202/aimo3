                # hill climbing
                for it in range(iterations):
                    # pick a point to move
                    i = random.randrange(100)
                    old = pts[i]
                    # propose new point near old
                    # random small move
                    dx = (random.random()*2-1)*0.05
                    dy = (random.random()*2-1)*0.05
                    new = (old[0]+dx, old[1]+dy)
                    # ensure inside circle
                    if new[0]**2 + new[1]**2 > R**2:
                        # project back to circle
                        norm = math.sqrt(new[0]**2 + new[1]**2)
