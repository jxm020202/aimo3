            def anneal_points(iterations=20000, start_temp=1.0, end_temp=0.001):
                pts=[random_point_in_circle() for _ in range(100)]
                best_pts=pts[:]
                best_sum=total_sum_points(pts)
                cur_pts=pts[:]
                cur_sum=best_sum
                start=time.time()
                for it in range(iterations):
                    t = start_temp * ((end_temp/start_temp) ** (it/iterations))
                    # propose move: pick a point and move to new random location
                    idx=random.randrange(100)
                    old_pt=cur_pts[idx]
                    new_pt=random_point_in_circle()
                    cur_pts[idx]=new_pt
                    new_sum=total_sum_points(cur_pts)
                    delta=new_sum - cur_sum
                    if delta>0 or random.random()<math.exp(delta/t):
                        cur_sum=new_sum
                        if new_sum>best_sum:
                            best_sum=new_sum
                            best_pts=cur_pts[:]
                            if best_sum%10==0:
                                print(f"Iter {it}, best sum {best_sum}")
                    else:
                        cur_pts[idx]=old_pt
                    if time.time()-start>28:
                        break
                return best_sum, best_pts
            
            best_sum, best_pts = anneal_points(20000)
            print("final best sum", best_sum)
            
