                    dirs = []
                    for j in range(n):
                        if i == j:
                            continue
                        dx = points[j][0] - pi[0]
                        dy = points[j][1] - pi[1]
                        dirs.append(math.atan2(dy, dx))
                    dirs = np.mod(dirs, 2*math.pi)
                    dirs.sort()
                    dirs_ext = np.concatenate([dirs, dirs + 2*math.pi])
                    left = 0
                    maxcnt = 0
                    for right in range(len(dirs_ext)):
                        while dirs_ext[right] - dirs_ext[left] > angle + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def simulated_annealing(initial_pts, steps=2000, init_step=0.2):
                pts = [list(p) for p in initial_pts]
                n = len(pts)
                current_val = total_visibility_fast(pts)
                best_val = current_val
                best_pts = [p[:] for p in pts]
                step_size = init_step
                for it in range(steps):
                    # temperature decreasing linearly
                    T = 1.0 - it/steps
                    # propose move
                    idx = random.randrange(n)
                    angle = random.random()*2*math.pi
                    radius = step_size * random.random()
                    newx = pts[idx][0] + radius*math.cos(angle)
                    newy = pts[idx][1] + radius*math.sin(angle)
                    if newx**2 + newy**2 > 1.0:
