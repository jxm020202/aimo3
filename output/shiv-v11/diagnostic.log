            def hill_climb(num_points=100, iterations=20000, step=0.05):
                # initialize points randomly in unit circle
                points = np.array([random_point_in_circle() for _ in range(num_points)])
                best = total_sum(points)
                best_points = points.copy()
                for it in range(iterations):
                    # pick a random point to move
                    idx = random.randrange(num_points)
                    old = points[idx].copy()
                    # propose new location by small random displacement within circle
                    # generate new point uniformly in circle of radius step around old
                    angle = random.random()*2*math.pi
                    dr = (random.random()*2-1)*step
                    new = old + dr*np.array([math.cos(angle), math.sin(angle)])
                    # ensure inside unit circle
                    if np.linalg.norm(new) > 1.0:
                        new = new / np.linalg.norm(new) * 0.999
                    points[idx] = new
                    cur = total_sum(points)
                    if cur > best:
                        best = cur
                        best_points = points.copy()
                        #print("new best", best, "it", it)
                    else:
                        # revert
                        points[idx] = old
                return best, best_points
            
