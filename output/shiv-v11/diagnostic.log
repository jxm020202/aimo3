            def evolve(pop_size=20, generations=2000, mutation_rate=0.2, time_limit=15.0):
                start = time.time()
                # initialize population
                population = []
                for _ in range(pop_size):
                    angles = [random.random()*2*math.pi for _ in range(100)]
                    s = compute_sum_angles(angles)
                    population.append((s, angles))
                # sort
                population.sort(reverse=True, key=lambda x: x[0])
                best_sum, best_angles = population[0]
                while time.time() - start < time_limit:
                    # select parent (best)
                    parent_sum, parent_angles = population[0]
                    # create child by mutating parent
                    child_angles = parent_angles[:]
                    # apply mutations: for each angle, with prob mutation_rate, perturb
                    for i in range(100):
                        if random.random() < mutation_rate:
                            # perturb by small random delta
                            delta = (random.random()*2-1) * 0.2  # rad ~ 11 deg
                            child_angles[i] = (child_angles[i] + delta) % (2*math.pi)
