            import math, random
            
            def max_in_wedge(points, wedge_deg=100):
                n = len(points)
                max_counts = []
                for i, (xi, yi) in enumerate(points):
                    # compute angles from i to others
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        ang = math.atan2(yj-yi, xj-xi)
                        # convert to degrees 0-360
                        deg = math.degrees(ang) % 360
                        angles.append(deg)
                    angles.sort()
                    # duplicate angles +360 for wraparound
                    angles2 = angles + [a+360 for a in angles]
                    # sliding window to count max within wedge_deg
                    maxc = 0
                    left = 0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > wedge_deg + 1e-9:
                            left += 1
                        maxc = max(maxc, right-left+1)
                    max_counts.append(maxc)
                return max_counts
            
            def generate_arc_points(n, arc_deg=100, radius=1):
                # center at (0,0)
                start = 0
                points = []
                for k in range(n):
                    theta = math.radians(start + arc_deg * k/(n-1))
                    points.append((radius*math.cos(theta), radius*math.sin(theta)))
                return points
            
