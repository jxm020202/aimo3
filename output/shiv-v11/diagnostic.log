                    for j in range(n):
                        if i==j: continue
                        xj, yj = pts[j]
                        dx, dy = xj-xi, yj-yi
                        ang = math.atan2(dy, dx)
                        angles.append(ang)
                    angles.sort()
                    angles2 = angles + [a+2*math.pi for a in angles]
