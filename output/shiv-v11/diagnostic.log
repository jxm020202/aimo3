            import time, math, random
            
            def total_visible_fast(pts, angle_rad=math.radians(100)):
                n = len(pts)
                total = 0
                for i in range(n):
                    xi, yi = pts[i]
                    angles = []
                    for j in range(n):
                        if i==j: continue
                        xj, yj = pts[j]
                        dx, dy = xj-xi, yj-yi
                        ang = math.atan2(dy, dx)
                        angles.append(ang)
                    angles.sort()
                    angles2 = angles + [a+2*math.pi for a in angles]
                    m = len(angles)
                    maxcnt = 0
                    j = 0
                    for ii in range(m):
                        while j < ii+m and angles2[j] - angles2[ii] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - ii
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def simulated_annealing_iters(iterations=15000):
                pts = [random_point_in_circle() for _ in range(100)]
                cur_val = total_visible_fast(pts)
                best_val = cur_val
                best_pts = pts[:]
                start_T = 5.0
                end_T = 0.001
                for it in range(iterations):
                    T = start_T * (1 - it/iterations) + end_T * (it/iterations)
                    i = random.randrange(100)
                    old = pts[i]
                    new = random_point_in_circle()
                    pts[i] = new
                    new_val = total_visible_fast(pts)
                    delta = new_val - cur_val
                    if delta > 0 or random.random() < math.exp(delta / T):
                        cur_val = new_val
                        if new_val > best_val:
                            best_val = new_val
                            best_pts = pts[:]
                    else:
                        pts[i] = old
                return best_val, best_pts
            
            t0 = time.time()
            best_val, best_pts = simulated_annealing_iters(8000)
            t1 = time.time()
            print("time", t1-t0, "best", best_val)
            
