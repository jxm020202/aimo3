            import random, math, numpy as np, time
            
            def random_point_in_circle(R=1.0):
                r = math.sqrt(random.random())*R
                theta = random.random()*2*math.pi
                return (r*math.cos(theta), r*math.sin(theta))
            
            def total_sum_fast(pts, angle_deg=100):
                # compute a_i for each point using sliding window O(n^2 log n) maybe
                n=len(pts)
                angle_rad = math.radians(angle_deg)
                total=0
                for i,p in enumerate(pts):
                    # compute angles to others
                    angs=[]
                    for j,q in enumerate(pts):
                        if i==j: continue
                        dx=q[0]-p[0]; dy=q[1]-p[1]
                        ang=math.atan2(dy,dx)
                        angs.append(ang)
                    angs.sort()
                    # duplicate
                    angs2=angs+[a+2*math.pi for a in angs]
                    # sliding window
                    maxcnt=0
                    j=0
                    m=len(angs)
                    for i2 in range(m):
                        while j < i2+m and angs2[j]-angs2[i2] <= angle_rad + 1e-12:
                            j+=1
                        cnt=j-i2
                        if cnt>maxcnt:
                            maxcnt=cnt
                    total+=maxcnt
                return total
            
            def hill_climb(n=100, iterations=20000, step=0.05):
                # start with uniform points on circle radius 0.99
                pts=uniform_circle_points(n, R=0.99)
                best=total_sum_fast(pts)
                best_pts=pts[:]
                print("initial sum",best)
                for it in range(iterations):
                    # pick random point to move
                    idx=random.randrange(n)
                    old=pts[idx]
                    # propose new point: random small move
                    angle=random.random()*2*math.pi
                    dr=(random.random()*2-1)*step
                    new=(old[0]+dr*math.cos(angle), old[1]+dr*math.sin(angle))
                    # ensure inside unit circle
                    if new[0]**2+new[1]**2 > 1.0:
                        continue
                    pts[idx]=new
                    s=total_sum_fast(pts)
                    if s>=best:
                        best=s
                        best_pts=pts[:]
                        # print progress
                        if it%1000==0:
                            print(it, best)
                    else:
                        # revert
                        pts[idx]=old
                return best, best_pts
            
            best, best_pts = hill_climb(n=30, iterations=2000, step=0.1)
            print("best sum for n=30:", best)
            
