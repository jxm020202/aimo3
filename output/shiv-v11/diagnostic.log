            import random, math, itertools, numpy as np
            
            def max_visible(points, angle=100):
                # points: list of (x,y)
                n = len(points)
                a = [0]*n
                half = angle/2.0
                for i, (xi, yi) in enumerate(points):
                    # compute angles to other points
                    dirs = []
                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        dx = xj - xi
                        dy = yj - yi
                        ang = math.degrees(math.atan2(dy, dx))  # angle from x-axis
                        dirs.append(ang)
                    # sort angles
                    dirs = sorted(dirs)
                    # duplicate with +360 for wrap-around
                    dirs2 = dirs + [a+360 for a in dirs]
                    # sliding window to find max count within angle
                    maxc = 0
                    m = len(dirs)
                    j = 0
                    for i0 in range(m):
                        while j < i0+m and dirs2[j] - dirs2[i0] <= angle + 1e-9:
                            j += 1
                        cnt = j - i0
                        if cnt > maxc:
                            maxc = cnt
                    a[i] = maxc
                return sum(a)
            
            def random_points(n, radius=1.0):
                pts = []
                for _ in range(n):
                    # uniform in circle
                    r = radius*math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def search_max(n, trials=2000):
                best = 0
                best_pts = None
                for t in range(trials):
                    pts = random_points(n)
                    s = max_visible(pts)
                    if s > best:
                        best = s
                        best_pts = pts
                return best, best_pts
            
            for n in range(5, 13):
                best,_ = search_max(n, trials=2000)
                print(n, best, best/(n*(n-1)))
            
