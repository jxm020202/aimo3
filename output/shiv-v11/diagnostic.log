            import random, math, numpy as np
            
            def sum_visibility_np(points, angle_rad=math.radians(100)):
                n = len(points)
                total = 0
                for i in range(n):
                    xi, yi = points[i]
                    angles = np.arctan2(points[:,1] - yi, points[:,0] - xi)
                    # adjust to [0, 2π)
                    angles = np.mod(angles, 2*math.pi)
                    # exclude self
                    angles = np.delete(angles, i)
                    angles = np.sort(angles)
                    m = len(angles)
                    angles2 = np.concatenate([angles, angles + 2*math.pi])
                    # sliding window using two pointers
                    maxcnt = 0
                    j = 0
                    for k in range(m):
                        while j < k + m and angles2[j] - angles2[k] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - k
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_point_in_circle(radius=1.0):
                r = radius * math.sqrt(random.random())
                theta = random.random() * 2*math.pi
                return np.array([r*math.cos(theta), r*math.sin(theta)])
            
            def simulated_annealing(n, iterations=20000, radius=1.0):
                # start with random points
                pts = np.array([random_point_in_circle(radius) for _ in range(n)])
                best_pts = pts.copy()
                best_score = sum_visibility_np(pts)
                current_score = best_score
                T0 = 1.0
                for it in range(iterations):
                    T = T0 * (1 - it/iterations)
                    # pick a random point to move
                    idx = random.randrange(n)
                    old = pts[idx].copy()
                    # propose new position: small random move
                    delta = np.random.normal(scale=0.1*radius, size=2)
                    new_pos = old + delta
                    # ensure inside circle
                    if np.linalg.norm(new_pos) > radius:
                        # project back onto circle
                        new_pos = new_pos / np.linalg.norm(new_pos) * radius * random.random()
                    pts[idx] = new_pos
                    new_score = sum_visibility_np(pts)
                    delta_score = new_score - current_score
                    if delta_score > 0 or random.random() < math.exp(delta_score / (T+1e-12)):
                        current_score = new_score
                        if new_score > best_score:
                            best_score = new_score
                            best_pts = pts.copy()
                    else:
                        pts[idx] = old
                return best_score, best_pts
            
            best, _ = simulated_annealing(10, iterations=5000)
            print("best sum for n=10:", best)
            
