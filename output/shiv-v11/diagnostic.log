            import math
            R = 1.0
            theta_center = math.pi  # direction from O to center
            half = math.radians(50)
            # direction angles:
            dir1 = theta_center - half
            dir2 = theta_center + half
            # parametric line from O: O + t * (cos(dir), sin(dir)), t>=0
            def intersect(dir_angle):
                dx = math.cos(dir_angle)
                dy = math.sin(dir_angle)
                # Solve (O_x + t*dx)^2 + (O_y + t*dy)^2 = R^2
                # O = (1,0)
                # (1 + t*dx)^2 + (t*dy)^2 = 1
                # Expand: 1 + 2t*dx + t^2*(dx^2+dy^2) = 1
                # Since dx^2+dy^2 = 1
                # => 2t*dx + t^2 = 0 => t(2dx + t) = 0
                # t=0 gives O itself, we need t>0 solution: t = -2dx
                t = -2*dx
                x = 1 + t*dx
                y = 0 + t*dy
                return (x,y)
            p1 = intersect(dir1)
            p2 = intersect(dir2)
            p1, p2
            
