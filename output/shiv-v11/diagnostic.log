            import math, numpy as np
            
            def max_visible_from_point(i, points, angle=math.radians(100)):
                # points: array shape (n,2)
                # compute direction angles from point i to all others
                pi = points[i]
                dirs = []
                for j,pj in enumerate(points):
                    if j==i: continue
                    v = pj - pi
                    ang = math.atan2(v[1], v[0])
                    dirs.append(ang)
                dirs = np.array(dirs)
                # sort angles
                dirs = np.mod(dirs, 2*math.pi)
                dirs = np.sort(dirs)
                # duplicate with +2π for wrap-around
                dirs_ext = np.concatenate([dirs, dirs+2*math.pi])
                # sliding window to count max within angle
                maxcnt = 0
                left = 0
                for right in range(len(dirs_ext)):
                    while dirs_ext[right] - dirs_ext[left] > angle + 1e-9:
                        left += 1
                    cnt = right - left + 1
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_visibility(n):
                angles = np.linspace(0, 2*math.pi, n, endpoint=False)
                points = np.column_stack([np.cos(angles), np.sin(angles)])
                total = 0
                for i in range(n):
                    total += max_visible_from_point(i, points)
                return total
            
            print(total_visibility(100))
            
