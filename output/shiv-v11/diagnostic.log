            def max_spread_inside(radius=1.0, eps=0.01, n=100):
                # place points on a circle of radius (radius - eps)
                R = radius - eps
                # choose points equally spaced on full circle
                angles = np.linspace(0, 2*math.pi, n, endpoint=False)
                xs = R*np.cos(angles)
                ys = R*np.sin(angles)
                # compute for each point the angular spread to all others
                max_spread = 0
                for i in range(n):
                    xi, yi = xs[i], ys[i]
                    # vectors to others
                    dx = xs - xi
                    dy = ys - yi
                    # exclude self
                    # compute angles
                    ang = np.arctan2(dy, dx)
                    # compute spread (max-min)
                    # need to handle wrap-around: find minimal covering interval
                    # sort angles
                    ang_sorted = np.sort(ang)
                    # compute gaps
                    gaps = np.diff(np.concatenate([ang_sorted, ang_sorted[:1]+2*math.pi]))
                    max_gap = np.max(gaps)
                    spread = 2*math.pi - max_gap
                    max_spread = max(max_spread, spread)
                return max_spread
            
