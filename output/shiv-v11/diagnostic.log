            import random, math, numpy as np
            
            def compute_sum(n=100, theta_deg=20):
                theta = math.radians(theta_deg)
                # place points on unit circle at angles uniformly in [0, theta]
                angles = np.linspace(0, theta, n)
                points = np.column_stack((np.cos(angles), np.sin(angles)))
                total = 0
                for i in range(n):
                    # compute direction angles from point i to others
                    dx = points[:,0] - points[i,0]
                    dy = points[:,1] - points[i,1]
                    # exclude self
                    mask = np.arange(n)!=i
                    ang = np.arctan2(dy[mask], dx[mask])
                    # convert to [0,2pi)
                    ang = np.mod(ang, 2*math.pi)
                    # sort angles
                    ang_sorted = np.sort(ang)
                    # duplicate with +2π for wrap-around
                    ang_extended = np.concatenate((ang_sorted, ang_sorted+2*math.pi))
                    # sliding window of size 100° (in radians)
                    window = math.radians(100)
                    max_count = 0
                    j = 0
                    for k in range(len(ang_sorted)):
                        while j < len(ang_extended) and ang_extended[j] - ang_sorted[k] <= window + 1e-12:
                            j += 1
                        count = j - k
                        if count > max_count:
                            max_count = count
                    total += max_count
                return total
            
            for th in [5,10,15,20,25]:
                print(th, compute_sum(100, th))
            
