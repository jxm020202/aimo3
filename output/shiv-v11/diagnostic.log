            import random, math, copy, time, numpy as np
            
            def total_visibility_fast(points, angle_deg=100):
                # compute total visibility sum for list of points (list of (x,y))
                n = len(points)
                total = 0
                angle_rad = math.radians(angle_deg)
                for i in range(n):
                    px, py = points[i]
                    # compute angles to others
                    angles = []
                    for j in range(n):
                        if i==j: continue
                        dx = points[j][0]-px
                        dy = points[j][1]-py
                        ang = math.atan2(dy, dx)
                        if ang < 0:
                            ang += 2*math.pi
                        angles.append(ang)
                    angles.sort()
                    m = len(angles)
                    # duplicate for wrap
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window
                    j = 0
                    maxcnt = 0
                    for i2 in range(m):
                        while j < i2+m and angles2[j] - angles2[i2] <= angle_rad + 1e-12:
                            j += 1
                        cnt = j - i2
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_point_in_circle(radius=1.0):
                r = radius * math.sqrt(random.random())
                theta = random.random()*2*math.pi
                return (r*math.cos(theta), r*math.sin(theta))
            
            def points_on_arc(n, start_deg, arc_deg, radius=1.0):
                pts = []
                for _ in range(n):
                    theta = math.radians(start_deg + random.random()*arc_deg)
                    pts.append((radius*math.cos(theta), radius*math.sin(theta)))
                return pts
            
            def hill_climb(n=100, iterations=20000, arc_deg=200):
                # start with points on arc
                pts = points_on_arc(n, 0, arc_deg)
                best = pts[:]
                best_val = total_visibility_fast(best)
                print("initial", best_val)
                for it in range(iterations):
                    # pick random point to move
                    idx = random.randrange(n)
                    old = pts[idx]
                    # propose new location: small random perturbation within circle
                    # Use random point in circle of radius step
                    step = 0.1
                    # propose new point by random displacement
                    angle = random.random()*2*math.pi
                    dx = step*math.cos(angle)
                    dy = step*math.sin(angle)
                    new_pt = (old[0]+dx, old[1]+dy)
                    # ensure inside unit circle
                    if new_pt[0]**2 + new_pt[1]**2 > 1.0:
                        # project back inside
                        norm = math.sqrt(new_pt[0]**2 + new_pt[1]**2)
                        new_pt = (new_pt[0]/norm*0.99, new_pt[1]/norm*0.99)
                    pts[idx] = new_pt
                    val = total_visibility_fast(pts)
                    if val > best_val:
                        best_val = val
                        best = pts[:]
                        #print("iter", it, "new best", best_val)
                    else:
                        # revert
                        pts[idx] = old
                return best_val, best
            
            best_val, best_pts = hill_climb(iterations=5000, arc_deg=200)
            print("best_val", best_val)
            
