            import random, math, itertools, time
            
            def can_all_see(points, alpha=100):
                # points: list of (x,y)
                # returns True if for each point i, there exists a sector of angle alpha containing all other points
                rad = math.radians(alpha)
                for i, (xi, yi) in enumerate(points):
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i == j: continue
                        ang = math.atan2(yj-yi, xj-xi)  # range -pi to pi
                        angles.append(ang)
                    # sort angles
                    angles.sort()
                    # duplicate with +2π for circular wrap
                    angles2 = angles + [a + 2*math.pi for a in angles]
                    # check if there is an interval of length rad covering all angles
                    # Equivalent: max gap between consecutive angles (including wrap) >= 2π - rad
                    max_gap = max(angles2[k+len(angles)-1] - angles2[k] for k in range(len(angles)))
                    # Actually we need to find minimal covering interval length:
                    # For each start angle, consider interval covering len(angles) points: interval length = angles2[start+len-1] - angles2[start]
                    # We need min interval length <= rad
                    min_len = min(angles2[start+len(angles)-1] - angles2[start] for start in range(len(angles)))
                    if min_len > rad + 1e-9:
                        return False
                return True
            
            def random_points_in_circle(n, R=1.0):
                pts = []
                for _ in range(n):
                    # uniform random in circle
                    r = math.sqrt(random.random()) * R
                    theta = random.random() * 2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def find_config(n, trials=20000):
                for t in range(trials):
                    pts = random_points_in_circle(n)
                    if can_all_see(pts):
                        return pts
                return None
            
