            def points_on_arc(n, theta_start_deg, arc_deg, radius=1.0):
                # generate n points uniformly on arc
                points = []
                for _ in range(n):
                    theta = math.radians(theta_start_deg + random.random()*arc_deg)
                    points.append((radius*math.cos(theta), radius*math.sin(theta)))
                return points
            
            def max_visible_from_point(p, others, angle_deg=100):
                # compute directions of vectors from p to others
                # compute angles in [0, 2π)
                angles = []
                px, py = p
                for q in others:
                    dx = q[0]-px
                    dy = q[1]-py
                    ang = math.atan2(dy, dx)
                    if ang < 0:
                        ang += 2*math.pi
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate list with +2π for circular wrap
                angles2 = angles + [a+2*math.pi for a in angles]
                # sliding window to find max count within angle window
                maxcnt = 0
                j = 0
                window = math.radians(angle_deg)
                for i in range(len(angles)):
                    while j < i+len(angles) and angles2[j] - angles2[i] <= window + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_visibility(points):
                total = 0
                for i, p in enumerate(points):
                    others = points[:i] + points[i+1:]
                    total += max_visible_from_point(p, others)
                return total
            
            def test(n=100, arc_deg=200, trials=5):
                for t in range(trials):
                    pts = points_on_arc(n, 0, arc_deg)
                    total = total_visibility(pts)
                    print(total)
            test()
            
