            def arc_points(n, start_angle=0, arc_angle=math.radians(120)):
                # points on unit circle from start_angle to start_angle+arc_angle
                pts = []
                for k in range(n):
                    theta = start_angle + arc_angle * k/(n-1)  # inclusive endpoints
                    pts.append((math.cos(theta), math.sin(theta)))
                return pts
            
