            import math, random, itertools, time
            
            def sum_a(angles):
                a = compute_a_i(angles)
                return sum(a), a
            
            def random_initial(n):
                # random angles uniform
                return [random.random()*2*math.pi for _ in range(n)]
            
            def perturb(angles, step=0.01):
                # randomly move one point
                i = random.randrange(len(angles))
                new_angle = (angles[i] + random.uniform(-step, step)) % (2*math.pi)
                new_angles = angles.copy()
                new_angles[i] = new_angle
                return new_angles
            
            def hill_climb(n=100, iterations=20000):
                angles = random_initial(n)
                best_sum, best_a = sum_a(angles)
                best_angles = angles[:]
                for it in range(iterations):
                    new_angles = perturb(angles, step=0.05)
                    s, a = sum_a(new_angles)
                    if s > best_sum:
                        best_sum, best_a, best_angles = s, a, new_angles
                        angles = new_angles
                        # print progress
                        if it % 1000 == 0:
                            print(it, best_sum)
                    else:
                        # occasional accept if better than current
                        if s > sum_a(angles)[0]:
                            angles = new_angles
                return best_sum, best_a, best_angles
            
