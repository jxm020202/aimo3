            def simulated_annealing(n=100, time_limit=15.0):
                start = time.time()
                # start with random points
                pts = random_points_in_circle_n(n)
                best_pts = pts[:]
                best_val = compute_sum(pts)
                cur_val = best_val
                cur_pts = pts[:]
                T0 = 1.0
                while time.time() - start < time_limit:
                    # temperature schedule
                    t = (time.time() - start) / time_limit
                    T = T0 * (1 - t)  # linear cooling
                    # propose move: pick random point and move slightly
                    i = random.randrange(n)
                    old = cur_pts[i]
