            def max_visible_from_point(p, points, angle_deg=100):
                # p is a tuple (x,y). points is list of other points (x,y)
                # returns max number of points that can be covered by a sector of given angle (including boundaries)
                if not points:
                    return 0
                # compute angles of vectors from p to each point
                angles = []
                for q in points:
                    dx = q[0] - p[0]
                    dy = q[1] - p[1]
                    ang = math.atan2(dy, dx)  # range -pi to pi
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate angles + 2π for circular wrap
                ang2 = angles + [a + 2*math.pi for a in angles]
                maxcnt = 0
                # sliding window
                j = 0
                a = math.radians(angle_deg)
                n = len(angles)
                for i in range(n):
                    # advance j while within angle a
                    while j < i + n and ang2[j] - ang2[i] <= a + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_visibility(points, angle_deg=100):
                total = 0
                n = len(points)
                for i in range(n):
                    p = points[i]
                    others = points[:i] + points[i+1:]
                    total += max_visible_from_point(p, others, angle_deg)
                return total
            
            def random_points_in_circle(N, R=1.0):
                pts = []
                for _ in range(N):
                    # uniform in circle
                    r = R * math.sqrt(random.random())
                    theta = random.random() * 2*math.pi
                    x = r * math.cos(theta)
                    y = r * math.sin(theta)
                    pts.append((x,y))
                return pts
            
            # test
            pts = random_points_in_circle(10)
            print(total_visibility(pts))
            
