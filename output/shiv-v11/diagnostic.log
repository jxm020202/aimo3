            import math, itertools
            
            def max_in_wedge(points, i, angle_deg=100):
                # points: list of (x,y)
                # i: index of observer
                # returns max number of other points within some wedge of angle_deg centered at i
                # we can rotate wedge arbitrarily; wedge defined by direction theta and width angle_deg
                # For each other point, compute direction angle relative to observer
                ox, oy = points[i]
                dirs = []
                for j, (x,y) in enumerate(points):
                    if j==i: continue
                    dx, dy = x-ox, y-oy
                    theta = math.atan2(dy, dx)  # -pi to pi
                    dirs.append(theta)
                # sort angles
                dirs.sort()
                # duplicate with +2pi for wrap
                dirs2 = dirs + [d+2*math.pi for d in dirs]
                maxcnt = 0
                n = len(dirs)
                j=0
                for k in range(n):
                    while j < k+n and dirs2[j] - dirs2[k] <= math.radians(angle_deg) + 1e-12:
                        j+=1
                    cnt = j - k
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def uniform_circle(n):
                pts = [(math.cos(2*math.pi*i/n), math.sin(2*math.pi*i/n)) for i in range(n)]
                return pts
            
