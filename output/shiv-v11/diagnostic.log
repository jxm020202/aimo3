            def spread_from_point_to_arc(point_angle_deg, arc_center_deg, arc_width_deg, n=100):
                # point on unit circle at point_angle_deg
                pa = math.radians(point_angle_deg)
                point = np.array([math.cos(pa), math.sin(pa)])
                # arc from center- width/2 to center+ width/2
                start = math.radians(arc_center_deg - arc_width_deg/2)
                end = math.radians(arc_center_deg + arc_width_deg/2)
