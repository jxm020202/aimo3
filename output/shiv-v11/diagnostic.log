            import itertools, cmath, math
            def find_solution(n, m, max_order=15):
                # search over roots of unity of order up to max_order (including 0)
                roots = [0]  # include zero
                for order in range(2, max_order+1):
                    for k in range(1, order):
                        roots.append(cmath.exp(2j*math.pi*k/order))
                # remove duplicates approx
                # Use tolerance for equality
                # We'll try combinations with repetition? Actually r_i can be equal? Possibly.
                # We'll try combinations (allow repeats) of length n from roots list.
                # That's huge. We'll limit to small set.
                for combo in itertools.combinations_with_replacement(roots, n):
                    # check not all zero
                    if all(abs(x) < 1e-9 for x in combo):
                        continue
                    ok = True
                    for j in range(1, m+1):
