            import random, math, time
            
            def compute_sum_angles(angles, alpha=100):
                # angles: list of angles (0 to 2π) for points on circle
                n = len(angles)
                rad = math.radians(alpha)
                total = 0
                # precompute sorted angles for each point? We'll compute per point.
                for i, theta_i in enumerate(angles):
                    # compute relative angles to other points from point i
                    rel = []
                    for j, theta_j in enumerate(angles):
                        if i == j: continue
                        # direction from point i to point j: vector difference
                        # coordinates on unit circle
                        xi, yi = math.cos(theta_i), math.sin(theta_i)
                        xj, yj = math.cos(theta_j), math.sin(theta_j)
                        ang = math.atan2(yj-yi, xj-xi)  # direction from i to j
                        rel.append(ang)
                    rel.sort()
                    # duplicate for wrap
                    rel2 = rel + [a + 2*math.pi for a in rel]
                    # sliding window to find max count within rad
                    maxcnt = 0
                    m = len(rel)
                    j = 0
                    for i_start in range(m):
                        # move j as far as within rad
                        while j < i_start + m and rel2[j] - rel2[i_start] <= rad + 1e-12:
                            j += 1
                        cnt = j - i_start
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_angles(n):
                return [random.random()*2*math.pi for _ in range(n)]
            
            def hill_climb(n, iterations=10000, step=0.1):
                # start with random angles
                angles = random_angles(n)
                best = compute_sum_angles(angles)
                best_angles = angles[:]
                for it in range(iterations):
                    # pick a random point and perturb its angle
                    i = random.randrange(n)
                    old = angles[i]
                    # propose new angle
                    new_angle = (old + random.uniform(-step, step)) % (2*math.pi)
                    angles[i] = new_angle
                    val = compute_sum_angles(angles)
                    if val >= best:
                        best = val
                        best_angles = angles[:]
                    else:
                        # revert
                        angles[i] = old
                return best, best_angles
            
