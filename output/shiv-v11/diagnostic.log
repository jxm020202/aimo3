            import random, math, itertools, time, sys, numpy as np
            
            def max_visible_from_point(p, points, angle_deg=100):
                # compute angles of vectors from p to other points
                angles = []
                for q in points:
                    if np.allclose(p, q):
                        continue
                    v = q - p
                    ang = math.atan2(v[1], v[0])
                    angles.append(ang)
                # sort angles
                angles = sorted(angles)
                # duplicate with +2π for circular wrap
                angles2 = angles + [a + 2*math.pi for a in angles]
                # sliding window to find max points within angle window
                maxcnt = 0
                j = 0
                window = math.radians(angle_deg)
                for i in range(len(angles)):
                    while j < len(angles2) and angles2[j] - angles[i] <= window + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_visibility(points):
                total = 0
                for p in points:
                    total += max_visible_from_point(p, points)
                return total
            
            def random_points_in_circle(n, radius=1.0):
                pts = []
                for _ in range(n):
                    r = radius * math.sqrt(random.random())
                    theta = random.random() * 2*math.pi
                    pts.append(np.array([r*math.cos(theta), r*math.sin(theta)]))
                return pts
            
            def improve(points, iterations=1000, step=0.01):
                best = points[:]
                best_score = total_visibility(best)
                for it in range(iterations):
                    # pick random point to move
                    i = random.randrange(len(points))
                    old = best[i].copy()
                    # propose new location within small step
                    angle = random.random()*2*math.pi
                    dr = (random.random()*2-1)*step
                    new = old + np.array([dr*math.cos(angle), dr*math.sin(angle)])
                    # ensure inside unit circle
                    if np.linalg.norm(new) > 1.0:
                        continue
                    best[i] = new
                    score = total_visibility(best)
                    if score >= best_score:
                        best_score = score
                        # keep change
                    else:
                        # revert
                        best[i] = old
                return best, best_score
            
            # quick test
            pts = random_points_in_circle(100)
            print(total_visibility(pts))
            
