            import random, math, copy
            
            def total_visibility_fast(points, angle=100.0):
                # compute a_i for each point using angular sorting O(N^2 log N)
                n = len(points)
                total = 0
                for i in range(n):
                    p = points[i]
                    angles = []
                    for j in range(n):
                        if i==j: continue
                        q = points[j]
                        dx = q[0]-p[0]
                        dy = q[1]-p[1]
                        ang = math.degrees(math.atan2(dy,dx)) % 360.0
                        angles.append(ang)
                    angles.sort()
                    angles2 = angles + [a+360 for a in angles]
                    maxcnt = 0
                    jptr = 0
                    m = len(angles)
                    for iptr in range(m):
                        while jptr < iptr+m and angles2[jptr] - angles2[iptr] <= angle + 1e-9:
                            jptr += 1
                        cnt = jptr - iptr
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def simulated_annealing(N, iter=5000, step=0.1):
                # start with random points
                pts = random_points_in_circle(N)
                best = total_visibility_fast(pts)
                best_pts = pts[:]
                cur = best
                cur_pts = pts[:]
                T0 = 1.0
                for it in range(iter):
                    T = T0 * (1 - it/iter)
                    # propose move: randomly select a point and move slightly
                    new_pts = [list(p) for p in cur_pts]
                    idx = random.randrange(N)
                    # random displacement within circle radius step
                    r = random.uniform(-step, step)
                    theta = random.uniform(0, 2*math.pi)
                    new_pts[idx][0] += r*math.cos(theta)
                    new_pts[idx][1] += r*math.sin(theta)
                    # if outside unit circle, reflect back
                    if new_pts[idx][0]**2 + new_pts[idx][1]**2 > 1.0:
                        # project back onto circle
                        d = math.sqrt(new_pts[idx][0]**2 + new_pts[idx][1]**2)
                        new_pts[idx][0] *= 1.0/d
                        new_pts[idx][1] *= 1.0/d
                    new_val = total_visibility_fast([tuple(p) for p in new_pts])
                    delta = new_val - cur
                    if delta > 0 or random.random() < math.exp(delta / (T+1e-9)):
                        cur = new_val
                        cur_pts = [tuple(p) for p in new_pts]
                        if cur > best:
                            best = cur
                            best_pts = cur_pts[:]
                return best, best_pts
            
            best_val, best_pts = simulated_annealing(10, iter=2000, step=0.2)
            best_val
            
