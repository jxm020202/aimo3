            def max_visible_sum(num_points=100, arc_deg=80):
                # generate points uniformly spaced within an arc of given central angle (in degrees)
                # arc from -arc/2 to +arc/2
                arc_rad = math.radians(arc_deg)
                angles = np.linspace(-arc_rad/2, arc_rad/2, num_points, endpoint=False)
                # points on unit circle
                pts = np.column_stack((np.cos(angles), np.sin(angles)))
                total = 0
                wedge = math.radians(100)
                for i in range(num_points):
                    # compute angles from point i to others
                    dx = pts[:,0] - pts[i,0]
                    dy = pts[:,1] - pts[i,1]
                    # exclude self
                    mask = np.arange(num_points)!=i
                    angles_i = np.arctan2(dy[mask], dx[mask])
                    # normalize to [0, 2π)
                    angles_i = np.mod(angles_i, 2*math.pi)
                    # sort
                    angles_sorted = np.sort(angles_i)
                    # duplicate with +2π for circular sliding
                    angles_ext = np.concatenate((angles_sorted, angles_sorted + 2*math.pi))
                    # sliding window
                    max_count = 0
                    j = 0
                    n = len(angles_sorted)
                    for k in range(n):
                        while j < k+n and angles_ext[j] - angles_ext[k] <= wedge + 1e-12:
                            j += 1
                        count = j - k
                        if count > max_count:
                            max_count = count
                    total += max_count
                return total
            
            print(max_visible_sum(100, 80))
            
