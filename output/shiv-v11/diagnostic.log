            def max_in_interval(angles, width):
                # angles in radians, wrap around 2π
                # sort
                a = sorted(angles)
                n = len(a)
                # duplicate with +2π for wrap
                a2 = a + [x+2*math.pi for x in a]
                maxcnt = 0
                j = 0
                for i in range(n):
                    while j < i+n and a2[j] - a2[i] <= width + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def sum_M(n=100, phi_deg=100):
                phi = math.radians(phi_deg)
                # place points uniformly on unit circle within [0, phi]
                thetas = np.linspace(0, phi, n)
                points = [(math.cos(t), math.sin(t)) for t in thetas]
                total = 0
                for i, (xi, yi) in enumerate(points):
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        ang = math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                    # compute max in interval of width 100° (in radians)
                    width = math.radians(100)
                    total += max_in_interval(angles, width)
                return total
            
