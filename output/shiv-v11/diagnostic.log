            import math, numpy as np
            
            def angle_at_A(theta):
                # point A at (1,0)
                B = np.array([math.cos(theta), math.sin(theta)])
                A = np.array([1.0, 0.0])
                v = B - A
                # direction angle of v
                return math.atan2(v[1], v[0])
            
            def angular_spread(phi, steps=1000):
                # compute max difference in direction angles for points on arc from 0 to phi
                thetas = np.linspace(0, phi, steps)
                angles = np.array([angle_at_A(t) for t in thetas])
                # unwrap to avoid discontinuities
                angles = np.unwrap(angles)
                return angles.max() - angles.min()
            
            for phi in [math.radians(d) for d in [30,60,90,120,150,180]]:
                print(math.degrees(phi), angular_spread(phi))
            
