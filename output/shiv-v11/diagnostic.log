                cur_val = sum_visibility(pts)
                best_val = cur_val
                best_pts = pts[:]
                T0 = 1.0
                for step in range(steps):
                    T = T0 * (1 - step/steps)
                    i = random.randrange(n)
                    # propose move
                    dx = (random.random()*2-1)*0.2
                    dy = (random.random()*2-1)*0.2
                    new_pt = (pts[i][0]+dx, pts[i][1]+dy)
                    if new_pt[0]**2 + new_pt[1]**2 > radius**2:
                        continue
                    old_pt = pts[i]
                    pts[i] = new_pt
                    new_val = sum_visibility(pts)
                    delta = new_val - cur_val
                    if delta > 0 or random.random() < math.exp(delta / (T+1e-9)):
                        cur_val = new_val
                        if new_val > best_val:
                            best_val = new_val
                            best_pts = pts[:]
                    else:
                        pts[i] = old_pt
                return best_val, best_pts
            
            best100, pts100 = simulated_annealing_n(100, steps=2000)
            print("best100:", best100)
            
