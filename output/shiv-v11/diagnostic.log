            import math, numpy as np
            
            def angle_at_A(A, B, C):
                # compute angle between vectors AB and AC at A
                AB = np.array([B[0]-A[0], B[1]-A[1]])
                AC = np.array([C[0]-A[0], C[1]-A[1]])
                dot = np.dot(AB, AC)
                norm = np.linalg.norm(AB)*np.linalg.norm(AC)
                return math.degrees(math.acos(dot/norm))
            
