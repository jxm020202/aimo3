            import math, numpy as np
            
            def max_angle_spread(theta_deg, n=1000):
                # points on unit circle from 0 to theta_deg (in radians)
                theta = math.radians(theta_deg)
                phi = np.linspace(0, theta, n)
                # point i at phi=0
                xi, yi = math.cos(0), math.sin(0)
                angles = np.arctan2(np.sin(phi)-yi, np.cos(phi)-xi)
                # normalize to [0,2pi)
                angles = np.mod(angles, 2*math.pi)
                # compute spread = max - min (circular)
                # Since angles are increasing monotonic? let's just compute max-min
                spread = max(angles)-min(angles)
                return math.degrees(spread)
            
