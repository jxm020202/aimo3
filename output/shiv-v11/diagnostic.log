            import numpy as np, math
            
            def points_on_arc(num_points=100, arc_deg=80):
                arc_rad = math.radians(arc_deg)
                angles = np.linspace(-arc_rad/2, arc_rad/2, num_points, endpoint=False)
                pts = np.column_stack((np.cos(angles), np.sin(angles)))
                return pts
            
            def sum_and_min_max(pts):
                n = len(pts)
                wedge = math.radians(100)
                counts = []
                for i in range(n):
                    dx = pts[:,0] - pts[i,0]
                    dy = pts[:,1] - pts[i,1]
                    mask = np.arange(n)!=i
                    angles_i = np.arctan2(dy[mask], dx[mask])
                    angles_i = np.mod(angles_i, 2*math.pi)
                    angles_sorted = np.sort(angles_i)
                    angles_ext = np.concatenate((angles_sorted, angles_sorted + 2*math.pi))
                    max_count = 0
                    j = 0
                    m = len(angles_sorted)
                    for k in range(m):
                        while j < k+m and angles_ext[j] - angles_ext[k] <= wedge + 1e-12:
                            j += 1
                        count = j - k
                        if count > max_count:
                            max_count = count
                    counts.append(max_count)
                return sum(counts), min(counts), max(counts)
            
            def compute_sum(pts):
                return sum_and_min_max(pts)[0]
            
