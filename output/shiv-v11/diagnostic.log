            import math, random
            
            def compute_sum(angles, alpha_deg=100):
                n = len(angles)
                alpha = math.radians(alpha_deg)
                total = 0
                for i in range(n):
                    # compute direction angles from point i to all other points
                    dirs = []
                    xi = math.cos(angles[i])
                    yi = math.sin(angles[i])
                    for j in range(n):
                        if i==j: continue
                        xj = math.cos(angles[j])
                        yj = math.sin(angles[j])
                        dx = xj - xi
                        dy = yj - yi
                        theta = math.atan2(dy, dx)  # direction angle
                        dirs.append(theta)
                    # sort angles
                    dirs.sort()
                    # duplicate with +2π for circular wrap
                    dirs2 = dirs + [d+2*math.pi for d in dirs]
                    # sliding window to find max count within alpha
                    maxcnt = 0
                    left = 0
                    for right in range(len(dirs)):
                        while dirs2[right] - dirs2[left] > alpha + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def test_config(angles):
                s = compute_sum(angles)
                return s
            
            # uniform spacing
            n=100
            angles = [2*math.pi*i/n for i in range(n)]
            print(test_config(angles))
            
