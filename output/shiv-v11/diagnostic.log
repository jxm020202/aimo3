            def compute_a_i(points, angle_deg=100):
                n=len(points)
                angle_rad=math.radians(angle_deg)
                a=[0]*n
                for i in range(n):
                    xi,yi=points[i]
                    angles=[]
                    for j in range(n):
                        if i==j: continue
                        xj,yj=points[j]
                        ang=math.atan2(yj-yi, xj-xi)
                        if ang<0: ang+=2*math.pi
                        angles.append(ang)
                    angles.sort()
                    # duplicate for wrap
                    m=len(angles)
                    angles2=angles+[a+2*math.pi for a in angles]
                    maxcnt=0
                    k=0
                    for l in range(m):
                        while k < len(angles2) and angles2[k]-angles2[l] <= angle_rad+1e-12:
                            k+=1
                        cnt=k-l
                        if cnt>maxcnt: maxcnt=cnt
                    a[i]=maxcnt
                return a
            
