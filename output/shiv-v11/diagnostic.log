            import math, random
            def max_visible(points, i, angle_deg=100):
                # points: list of (x,y)
                xi, yi = points[i]
                angles = []
                for j, (xj, yj) in enumerate(points):
                    if j == i: continue
                    ang = math.atan2(yj-yi, xj-xi)  # angle in radians
                    angles.append(ang)
                # normalize to [0, 2π)
                angles = [(a if a>=0 else a+2*math.pi) for a in angles]
                angles.sort()
                # duplicate with +2π for wrap-around
                angles2 = angles + [a+2*math.pi for a in angles]
                maxcnt = 0
                L = math.radians(angle_deg)
                n = len(angles)
                j = 0
                for i_start in range(n):
                    while j < i_start + n and angles2[j] - angles2[i_start] <= L + 1e-12:
                        j += 1
                    cnt = j - i_start
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def test_arc(N=100, arc_deg=200):
                # place N points on unit circle within arc of length arc_deg
                start = random.random()*2*math.pi
                arc_rad = math.radians(arc_deg)
                points = []
                for k in range(N):
                    theta = start + (k/(N-1))*arc_rad  # equally spaced
                    points.append((math.cos(theta), math.sin(theta)))
                # compute sum of max visible
                total = sum(max_visible(points, i) for i in range(N))
                return total
            
