            import math, random, itertools, sys, time, numpy as np
            
            def compute_sum(angles):
                # angles: list of angles (radians) on unit circle
                n = len(angles)
                alpha = math.radians(100)  # 100 degrees in radians
                total = 0
                for i, theta_i in enumerate(angles):
                    # tangent direction at point i (counterclockwise 90 deg from radius)
                    tangent = theta_i + math.pi/2
                    # compute relative angles of vectors to other points
                    rel_angles = []
                    xi = math.cos(theta_i)
                    yi = math.sin(theta_i)
                    for j, theta_j in enumerate(angles):
                        if i == j: continue
                        xj = math.cos(theta_j)
                        yj = math.sin(theta_j)
                        # vector from i to j
                        vx = xj - xi
                        vy = yj - yi
                        # direction angle of vector
                        dir_angle = math.atan2(vy, vx)
                        # relative angle to tangent
                        rel = dir_angle - tangent
                        # normalize to [-pi, pi]
                        while rel <= -math.pi:
                            rel += 2*math.pi
                        while rel > math.pi:
                            rel -= 2*math.pi
                        # we expect rel in [-pi/2, pi/2] (half-plane)
                        # map to [0, 2pi) for sliding window
                        rel_angles.append(rel)
                    # sort rel_angles
                    rel_angles.sort()
                    # duplicate with +2π for wrap-around
                    rel_extended = rel_angles + [x + 2*math.pi for x in rel_angles]
                    # sliding window to find max count within interval length alpha
                    max_count = 0
                    m = len(rel_angles)
                    left = 0
                    for right in range(len(rel_extended)):
                        # ensure window length <= alpha
                        while rel_extended[right] - rel_extended[left] > alpha + 1e-12:
                            left += 1
                        # count points in window = right-left+1
                        cnt = right - left + 1
                        if cnt > max_count:
                            max_count = cnt
                    total += max_count
                return total
            
            def random_angles(n):
                return [random.random()*2*math.pi for _ in range(n)]
            
            # test uniform spacing
            n=100
            angles = [2*math.pi*i/n for i in range(n)]
            print("uniform sum:", compute_sum(angles))
            
