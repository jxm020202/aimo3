            import math, random
            
            def max_visible(points):
                # points: list of (x,y)
                n = len(points)
                a = []
                for i, (xi, yi) in enumerate(points):
                    # compute angles to other points
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i == j: continue
                        ang = math.atan2(yj-yi, xj-xi)  # -pi to pi
                        angles.append(ang)
                    # normalize to [0, 2pi)
                    angles = [a if a>=0 else a+2*math.pi for a in angles]
                    angles.sort()
                    # duplicate with +2pi for wrap-around
                    angles2 = angles + [a+2*math.pi for a in angles]
                    maxcnt = 0
                    L = math.radians(100)
                    # sliding window
                    j = 0
                    for k in range(len(angles)):
                        while j < len(angles2) and angles2[j] - angles2[k] <= L + 1e-12:
                            j += 1
                        cnt = j - k
                        if cnt > maxcnt:
                            maxcnt = cnt
                    a.append(maxcnt)
                return a
            
            def avg_a(L):
                # L total angular span (radians) for points placed on unit circle
                n=100
                # place points uniformly within [0, L]
                angles = [i*L/(n-1) for i in range(n)]
                points = [(math.cos(a), math.sin(a)) for a in angles]
                a_vals = max_visible(points)
                return sum(a_vals)/len(a_vals), max(a_vals), min(a_vals)
            
