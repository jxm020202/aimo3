            def compute_m_counts(angles_deg, L=160.0):
                # angles_deg: list of angles in degrees, sorted ascending, values in [0,360)
                N = len(angles_deg)
                # duplicate list with +360 to handle wrap-around
                angles = angles_deg + [a+360.0 for a in angles_deg]
                # sliding window: for each start index j (0..N-1), find end index e where angles[e] <= angles[j] + L
                # count = e - j + 1 (since inclusive)
                # We'll compute for each start j the count and also store interval end index
                counts = [0]*N
                end = 0
                for j in range(N):
                    # ensure end at least j
                    if end < j:
                        end = j
                    while end+1 < j+N and angles[end+1] <= angles[j] + L + 1e-9:  # include endpoint
                        end += 1
                    counts[j] = end - j + 1
                # Now for each point i, we need minimal count among intervals that contain i.
                # For each i (0..N-1), consider intervals starting at j where j <= i <= end_j (mod N)
                # Since we have duplicate list, we can treat i in range N, and intervals start j in [i-L_range, i] maybe.
                # Simpler: for each i, we can slide a window of length L that contains i and compute count.
                # We can compute using two-pointer: for each i, find leftmost start j such that angles[i] - angles[j] <= L (i.e., interval [angles[j], angles[j]+L] contains i)
                # Actually we need intervals of length L that contain i. The start can be any angle s such that s <= angles[i] <= s+L.
                # The minimal count will be achieved when start s aligns with some point's angle (maybe j) or when end aligns with some point.
                # We'll compute by scanning possible start indices j where angles[j] <= angles[i] <= angles[j]+L.
                # For each i, we can consider start j ranging from i downwards while angles[i] - angles[j] <= L.
