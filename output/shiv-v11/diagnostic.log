            def max_spread_on_arc(beta, R=1.0, n=100):
                # points on circle of radius R, placed uniformly on arc from -beta/2 to +beta/2
                angles = np.linspace(-beta/2, beta/2, n)
                xs = R*np.cos(angles)
                ys = R*np.sin(angles)
                max_spread = 0
                for i in range(n):
                    xi, yi = xs[i], ys[i]
                    dx = xs - xi
                    dy = ys - yi
                    # exclude self
                    # compute angles
                    ang = np.arctan2(dy, dx)
                    # compute minimal covering interval length
                    ang_sorted = np.sort(ang)
                    gaps = np.diff(np.concatenate([ang_sorted, ang_sorted[:1]+2*math.pi]))
                    max_gap = np.max(gaps)
                    spread = 2*math.pi - max_gap
                    max_spread = max(max_spread, spread)
                return max_spread
            
            def find_beta_for_alpha(alpha_deg, R=1.0, n=200):
                # binary search for smallest beta such that max_spread_on_arc(beta) <= alpha
                target = math.radians(alpha_deg)
                lo, hi = 0.0, 2*math.pi
                for _ in range(30):
                    mid = (lo+hi)/2
                    spread = max_spread_on_arc(mid, R=R, n=n)
                    if spread <= target:
