            def crt(a1,m1,a2,m2):
                # solve x = a1 mod m1, x = a2 mod m2
                # assume m1,m2 coprime
                import math
                M = m1*m2
                # find inv of m1 mod m2
                inv = pow(m1, -1, m2)
                x = (a2 - a1) * inv % m2
                return (a1 + m1*x) % M
            
