            def random_point_in_circle(radius=1.0):
                # uniform distribution in circle
                r = radius * math.sqrt(random.random())
                theta = random.random() * 2*math.pi
                return (r*math.cos(theta), r*math.sin(theta))
            
            def compute_sum(points, angle_deg=100):
                n = len(points)
                alpha = math.radians(angle_deg)
                total = 0
                for i, (xi, yi) in enumerate(points):
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i == j: continue
                        ang = math.atan2(yj-yi, xj-xi)  # angle in [-pi, pi]
                        angles.append(ang)
                    angles.sort()
                    # duplicate with +2π for wrap-around
                    m = len(angles)
                    angles2 = angles + [a + 2*math.pi for a in angles]
                    # sliding window
                    best = 0
                    k = 0
                    for l in range(m):
                        # increase k while within window
                        while k < l + m and angles2[k] - angles2[l] <= alpha + 1e-12:
                            k += 1
                        # count points in window
                        cnt = k - l
                        if cnt > best:
                            best = cnt
                    total += best
                return total
            
