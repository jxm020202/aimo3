            import random, math, time
            
            def compute_sum(points):
                # compute sum of a_i
                n = len(points)
                total = 0
                width = math.radians(100)
                for i in range(n):
                    xi, yi = points[i]
                    angles = []
                    for j in range(n):
                        if i==j: continue
                        xj, yj = points[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                    angles.sort()
                    # duplicate
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window
                    left = 0
                    maxcnt = 0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > width + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_move(point, radius=1.0, step=0.1):
                # random small move within circle
                x,y = point
                # propose new point by adding small delta in random direction
                angle = random.random()*2*math.pi
                dx = step*math.cos(angle)
                dy = step*math.sin(angle)
                nx, ny = x+dx, y+dy
                # if outside circle, reflect or reject
                if nx*nx + ny*ny > radius*radius:
                    # project back onto circle boundary
                    # scale to radius
                    norm = math.sqrt(nx*nx + ny*ny)
                    nx, ny = nx*radius/norm, ny*radius/norm
                return (nx, ny)
            
            def optimize(n=100, radius=1.0, iterations=20000, step=0.02):
                points = random_points_in_circle(n, radius)
                best = compute_sum(points)
                best_pts = points[:]
                cur = best
                for it in range(iterations):
                    # pick random point to move
                    idx = random.randrange(n)
                    old = points[idx]
                    new_pt = random_move(old, radius, step)
                    points[idx] = new_pt
                    new_sum = compute_sum(points)
                    if new_sum >= cur:
                        cur = new_sum
                        if new_sum > best:
                            best = new_sum
                            best_pts = points[:]
                    else:
                        # revert
                        points[idx] = old
                    if it % 1000 == 0:
                        print(it, best)
                return best, best_pts
            
            best_val, best_pts = optimize(iterations=5000, step=0.05)
            print("Best sum:", best_val)
            
