            import random, math, itertools, numpy as np
            
            def total_visibility(points):
                n = len(points)
                total = 0
                # compute angles from each point to others
                for i, (xi, yi) in enumerate(points):
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i == j: continue
                        ang = math.atan2(yj-yi, xj-xi)  # -pi to pi
                        angles.append(ang)
                    # sort angles
                    angles = sorted(angles)
                    # duplicate with +2pi for circular wrap
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window of width 100 degrees = 100*pi/180 rad
                    width = math.radians(100)
                    maxcnt = 0
                    k = 0
                    m = len(angles)
                    for s in range(m):
                        # move k as far as within width
                        while k < s+m and angles2[k] - angles2[s] <= width + 1e-12:
                            k += 1
                        cnt = k - s
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
