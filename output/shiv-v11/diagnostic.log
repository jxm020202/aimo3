            def chord_angle(theta_i, theta_j):
                # compute angle between chord i->j and tangent at i (counterclockwise from tangent)
                xi, yi = math.cos(theta_i), math.sin(theta_i)
                xj, yj = math.cos(theta_j), math.sin(theta_j)
                # chord vector
                vx, vy = xj - xi, yj - yi
                # tangent direction at i: rotate radius by +90° (counterclockwise)
                tx, ty = -yi, xi  # tangent vector (unit length)
                # angle between chord and tangent: atan2(cross, dot)
                cross = tx*vy - ty*vx
                dot = tx*vx + ty*vy
                angle = math.atan2(cross, dot)  # signed angle from tangent to chord
                # normalize to (-pi, pi)
                return angle
            
