            def check_M(N, M):
                steps = N-1
                # compute U using recurrence
                U = [0]*(steps+1)
                U[0]=1
                if steps>=1:
                    U[1]=M
                for i in range(2, steps+1):
                    U[i]=M*U[i-1]-U[i-2]
                n=steps
                val = U[n]*M**2 - (U[n] + 2*U[n-1])*M + (U[n-1] + (U[n-2] if n-2>=0 else 0))
                return val
            
            print(check_M(2025, M_form))
            
