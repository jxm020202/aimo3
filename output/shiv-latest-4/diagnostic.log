            def find_coloring(n,k):
                # backtracking
                colors = [-1]*n
                def backtrack(i):
                    if i==n:
                        return colors[:]
                    for c in range(k):
                        # assign c to i (value i+1)
                        ok=True
                        # check any a,b such that a+b = i+1 and both already colored with same c
