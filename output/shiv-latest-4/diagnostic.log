            def is_convex(poly):
                n=len(poly)
                signs=[]
                for i in range(n):
                    a=sp.Matrix(poly[i])
                    b=sp.Matrix(poly[(i+1)%n])
                    c=sp.Matrix(poly[(i+2)%n])
                    # compute z-component of cross product (b-a) x (c-b)
                    v1=b-a
                    v2=c-b
                    cross = v1[0]*v2[1]-v1[1]*v2[0]
