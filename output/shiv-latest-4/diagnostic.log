                guesses = [(0.5,0.5), (1.5,0.5), (0.5,1.5), (-0.5,0.5), (0.5,-0.5), (2,0), (0,2), (1,-0.5), (-1,1)]
                for g in guesses:
                    sol = solve_J(th, ph, g)
                    if sol:
                        if not any(math.hypot(sol[0]-s[0], sol[1]-s[1])<1e-6 for s in sols):
                            sols.append(sol)
                return sols
            
            def angle_GJH(th, ph, J):
                xj, yj = J
                G = (1.0, 0.0)
                H = (1+math.cos(th), math.sin(th))
                vJG = (G[0]-xj, G[1]-yj)
                vJH = (H[0]-xj, H[1]-yj)
                dot = vJG[0]*vJH[0] + vJG[1]*vJH[1]
                n1 = math.hypot(*vJG)
                n2 = math.hypot(*vJH)
                if n1==0 or n2==0:
                    return None
                cosang = max(-1, min(1, dot/(n1*n2)))
                return math.degrees(math.acos(cosang))
            
