                # M > 1
                L = 1/(M-1)
                if L >= M:
                    return False
                for _ in range(n-1):
                    denom = M - L
                    if denom <= 0:
                        return False
                    L = 1/denom
                    if L >= M:
                        # if lower bound exceeds M, infeasible (cannot pick x_i <= M)
                        # but we may still continue? Actually if L > M, then x_i must be >= L > M, impossible.
                        return False
