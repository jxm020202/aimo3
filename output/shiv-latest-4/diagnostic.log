            def find_min_sparse(max_i=20, max_terms=4):
                coeffs = coeffs_up_to(max_i)
                target = (2025,0,0)
                best = None
                best_solution = None
                # try number of non-zero terms from 1 to max_terms
                for t in range(1, max_terms+1):
                    # choose t indices with repetition allowed? Since we can have multiple of same index, but that would be counted as coefficient >1.
                    # For sparsity we can consider distinct indices, but coefficient may be >1.
                    # We'll allow coefficient >1 later.
                    from itertools import combinations
                    for indices in combinations(range(max_i+1), t):
                        # Build matrix columns
                        import numpy as np
                        M = np.array([coeffs[i] for i in indices]).T  # 3 x t
                        # Solve linear least squares integer? Need integer solution.
                        # Since t <=3, we can solve exactly if t==3.
                        if t==3:
                            try:
                                sol = np.linalg.solve(M, np.array(target))
                            except np.linalg.LinAlgError:
                                continue
                            # check integer and nonnegative
                            if all(abs(sol - np.round(sol))<1e-9):
                                sol_int = tuple(int(round(x)) for x in sol)
                                if all(x>=0 for x in sol_int):
                                    total = sum(sol_int)
                                    if best is None or total < best:
                                        best = total
                                        best_solution = (indices, sol_int)
                        elif t==2:
                            # underdetermined: need to find integer nonnegative solutions to M * [x,y] = target
                            # Solve for x,y using two equations, third must be satisfied automatically.
                            # Use brute force for small ranges.
                            # We'll bound x,y up to maybe 2025.
                            for x in range(0,2026):
                                # compute residual after using x of first index
                                residual = (target[0]-coeffs[indices[0]][0]*x,
                                            target[1]-coeffs[indices[0]][1]*x,
                                            target[2]-coeffs[indices[0]][2]*x)
                                # need residual = y * coeffs[indices[1]]
                                a2,b2,c2 = coeffs[indices[1]]
                                if a2==0 and b2==0 and c2==0:
                                    continue
                                # Check if residual is multiple of vector
                                if a2!=0:
                                    if residual[0]%a2!=0:
                                        continue
                                    y = residual[0]//a2
                                elif b2!=0:
                                    if residual[1]%b2!=0:
                                        continue
                                    y = residual[1]//b2
                                elif c2!=0:
                                    if residual[2]%c2!=0:
                                        continue
                                    y = residual[2]//c2
                                else:
                                    continue
                                if y<0:
                                    continue
                                if (coeffs[indices[1]][0]*y, coeffs[indices[1]][1]*y, coeffs[indices[1]][2]*y)==residual:
                                    total = x+y
                                    if best is None or total < best:
                                        best = total
                                        best_solution = (indices, (x,y))
                        elif t==1:
                            # single index must match target directly
                            a,b,c = coeffs[indices[0]]
                            if b==0 and c==0 and a!=0 and 2025%a==0:
                                k = 2025//a
                                if k>=0:
                                    total=k
                                    if best is None or total<best:
                                        best=total
                                        best_solution=(indices,(k,))
                return best,best_solution
            
            best, sol = find_min_sparse(30,3)
            best, sol
            
