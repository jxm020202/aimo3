            def find_min_sum(max_i=12, max_total=6):
                coeffs = coeffs_up_to(max_i)
                best = None
                best_vec = None
                # enumerate combinations of counts up to max_total
                # Use recursion generating nonnegative integer vectors with sum <= max_total
                # We'll brute force by generating all ways to distribute total count among indices
                for total in range(1, max_total+1):
                    # generate compositions of total into (max_i+1) parts
                    # Use product of ranges 0..total for each index, but prune by sum.
                    # Use recursion
                    def rec(idx, remaining, current):
                        nonlocal best,best_vec
                        if idx==max_i+1:
                            if remaining==0:
                                # evaluate
                                a=sum(current[i]*coeffs[i][0] for i in range(max_i+1))
                                b=sum(current[i]*coeffs[i][1] for i in range(max_i+1))
                                c=sum(current[i]*coeffs[i][2] for i in range(max_i+1))
                                if a==2025 and b==0 and c==0:
                                    best=total
                                    best_vec=current.copy()
                                    raise StopIteration
                            return
                        # assign 0..remaining to this index
                        for val in range(remaining+1):
                            current.append(val)
                            rec(idx+1, remaining-val, current)
                            current.pop()
                    try:
                        rec(0,total,[])
                    except StopIteration:
                        return best,best_vec
                return None,None
            
