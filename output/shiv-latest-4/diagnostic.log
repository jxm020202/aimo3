            def angle_between(u, v):
                dot = u[0]*v[0] + u[1]*v[1]
                nu = math.hypot(u[0], u[1])
                nv = math.hypot(v[0], v[1])
                if nu*nv == 0:
                    return 0.0
                cosang = max(-1.0, min(1.0, dot/(nu*nv)))
                return math.acos(cosang)
            
