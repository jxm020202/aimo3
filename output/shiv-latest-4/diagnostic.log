                                placed=True
                                break
                        if not placed:
                            # fallback assign any existing color (should be possible)
                            col=random.choice(list(used))
                            board[i][j]=col
                    distinct=len(set(c for row in board for c in row))
                    if distinct>best:
                        best=distinct
