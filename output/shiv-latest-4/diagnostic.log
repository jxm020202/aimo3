            def compute_J(alpha, theta, sign1, sign2):
                # sign1: +1 for rotate +30°, -1 for -30°
                # sign2: +1 for rotate +30°, -1 for -30°
                F = (math.cos(alpha), math.sin(alpha))
                G = (0.0, 0.0)
                H = (1.0, 0.0)
                I = (1+math.cos(theta), math.sin(theta))
                IG = (G[0]-I[0], G[1]-I[1])
                FH = (H[0]-F[0], H[1]-F[1])
                phi = math.radians(30)
                c = math.cos(sign1*phi); s = math.sin(sign1*phi)
                d1 = (c*IG[0] - s*IG[1], s*IG[0] + c*IG[1])
                c2 = math.cos(sign2*phi); s2 = math.sin(sign2*phi)
                d2 = (c2*FH[0] - s2*FH[1], s2*FH[0] + c2*FH[1])
                # solve linear system
                A = [[d1[0], -d2[0]],
                     [d1[1], -d2[1]]]
                b = [F[0]-I[0], F[1]-I[1]]
                det = A[0][0]*A[1][1] - A[0][1]*A[1][0]
                if abs(det) < 1e-12:
                    return None
                t = (b[0]*A[1][1] - b[1]*A[0][1]) / det
                J = (I[0] + t*d1[0], I[1] + t*d1[1])
                return J
            
