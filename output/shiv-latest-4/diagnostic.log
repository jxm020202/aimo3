            import itertools
            
            def max_colors_n(n):
                cells = [(i,j) for i in range(n) for j in range(n)]
                # backtracking assign colors incrementally, track used colors count
                best = 0
                best_assign = None
                # order cells row-major
                order = cells
                # constraint check function
                def check_partial(assign):
                    # assign dict (i,j)->color
                    # check any fully assigned 2x2 squares for rainbow
                    for i in range(n-1):
                        for j in range(n-1):
                            coords = [(i,j),(i+1,j),(i,j+1),(i+1,j+1)]
                            if all(c in assign for c in coords):
                                colors = [assign[c] for c in coords]
                                if len(set(colors))==4:
                                    return False
                    return True
            
                def backtrack(idx, assign, used):
                    nonlocal best, best_assign
                    if idx==len(order):
                        if len(used)>best:
                            best=len(used)
                            best_assign=assign.copy()
                        return
                    # prune: even if we use new color each remaining cell, max possible = len(used)+(len(order)-idx)
                    if len(used)+(len(order)-idx) <= best:
                        return
                    i,j = order[idx]
                    # try existing colors first
                    for col in list(used):
                        assign[(i,j)]=col
                        if check_partial(assign):
                            backtrack(idx+1, assign, used)
                        del assign[(i,j)]
                    # try new color
                    newcol = max(used)+1 if used else 1
                    assign[(i,j)]=newcol
                    used.add(newcol)
                    if check_partial(assign):
                        backtrack(idx+1, assign, used)
                    used.remove(newcol)
                    del assign[(i,j)]
            
                backtrack(0, {}, set())
                return best, best_assign
            
