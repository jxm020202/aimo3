            @lru_cache(None)
            def solve(state):
                # state is sorted tuple of nonnegative ints
                # check terminal condition
                if not state:
                    return 0
                S = sum(state)
                if S==0:
                    return len(state)  # all zeros
                maxv = max(state)
                if maxv > S - maxv:  # max > sum others
                    return len(state)
                # otherwise game continues. A chooses pair (i<j)
                best = -1  # A wants maximize final len
                n = len(state)
                for i in range(n):
                    for j in range(i+1,n):
                        x = state[i]; y = state[j]
                        # remove i,j
                        remaining = list(state)
                        # remove higher index first
                        del remaining[j]; del remaining[i]
                        # B can choose sum or diff
                        # sum
                        new_sum = remaining + [x+y]
                        val_sum = solve(canonical(new_sum))
                        # diff
                        new_diff = remaining + [abs(x-y)]
                        val_diff = solve(canonical(new_diff))
                        # B will choose operation that minimizes final len
                        val = min(val_sum, val_diff)
                        # A wants to maximize over choice of pair
                        if val > best:
                            best = val
                return best
            
