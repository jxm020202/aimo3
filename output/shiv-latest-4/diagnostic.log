            import sympy as sp
            α, θ = sp.symbols('α θ', real=True)
            # define points as before
            F = sp.Matrix([sp.cos(α), sp.sin(α)])
            G = sp.Matrix([0,0])
            H = sp.Matrix([1,0])
            I = sp.Matrix([1+sp.cos(θ), sp.sin(θ)])
            
            # vectors
            IG = G - I
            FH = H - F
            
            # rotation matrix for angle φ
            def rot(vec, phi):
                c = sp.cos(phi)
                s = sp.sin(phi)
                R = sp.Matrix([[c, -s],[s, c]])
                return R*vec
            
            phi = sp.pi/6  # 30 degrees
            
            # define direction possibilities
            d1_plus = rot(IG, phi)
            d1_minus = rot(IG, -phi)
            d2_plus = rot(FH, phi)
            d2_minus = rot(FH, -phi)
            
            # solve for intersection for each combination
            def intersect(d1, d2):
                t, s = sp.symbols('t s')
                eq = I + t*d1 - (F + s*d2)
                sol = sp.solve(eq, (t,s), dict=True)
                return sol
            
            sols = {}
            for sign1, d1 in [('+' , d1_plus), ('-', d1_minus)]:
                for sign2, d2 in [('+' , d2_plus), ('-', d2_minus)]:
                    sol = intersect(d1, d2)
                    sols[(sign1,sign2)] = sol
            sols
            
