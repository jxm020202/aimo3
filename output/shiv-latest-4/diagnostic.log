            import math, numpy as np
            
            def rotate(vec, deg):
                rad=math.radians(deg)
                x,y=vec
                return (x*math.cos(rad)-y*math.sin(rad), x*math.sin(rad)+y*math.cos(rad))
            
            def compute_J_candidates(theta_deg, phi_deg):
                th=math.radians(theta_deg)
                ph=math.radians(phi_deg)
                G=(0.0,0.0)
                H=(1.0,0.0)
                F=(math.cos(th), math.sin(th))
                I=(1-math.cos(ph), math.sin(ph))
                IG=(G[0]-I[0], G[1]-I[1])
                FH=(H[0]-F[0], H[1]-F[1])
                candidates=[]
                for deg1 in [30, -30]:
                    for deg2 in [30, -30]:
                        d1=rotate(IG, deg1)
                        d2=rotate(FH, deg2)
                        M=np.array([[d1[0], -d2[0]],[d1[1], -d2[1]] )
                        det=np.linalg.det(M)
                        if abs(det)<1e-9:
                            continue
                        rhs=np.array([F[0]-I[0], F[1]-I[1]])
                        t,s=np.linalg.solve(M, rhs)
                        if t>0 and s>0:
                            J=(I[0]+t*d1[0], I[1]+t*d1[1])
                            candidates.append((J,deg1,deg2))
                return candidates, F,G,H,I
            
            def is_convex(F,G,H,I,J):
                pts=[F,G,H,I,J]
                sign=None
                n=5
                for i in range(n):
                    p0=pts[i]
                    p1=pts[(i+1)%n]
                    p2=pts[(i+2)%n]
                    v1=(p1[0]-p0[0], p1[1]-p0[1])
                    v2=(p2[0]-p1[0], p2[1]-p1[1])
                    cross=v1[0]*v2[1]-v1[1]*v2[0]
                    if abs(cross)<1e-9:
                        return False
                    if sign is None:
                        sign = cross>0
                    elif (cross>0)!=sign:
                        return False
                return True
            
            def angle_between(v1,v2):
                dot=v1[0]*v2[0]+v1[1]*v2[1]
                n1=math.hypot(v1[0],v1[1])
                n2=math.hypot(v2[0],v2[1])
                return math.degrees(math.acos(max(-1,min(1,dot/(n1*n2)))))
            
            def angle_GJH(theta_deg, phi_deg):
                candidates, F,G,H,I = compute_J_candidates(theta_deg, phi_deg)
                for J,deg1,deg2 in candidates:
                    if is_convex(F,G,H,I,J):
                        vJG=(G[0]-J[0], G[1]-J[1])
                        vJH=(H[0]-J[0], H[1]-J[1])
                        return angle_between(vJG, vJH)
                return None
            
