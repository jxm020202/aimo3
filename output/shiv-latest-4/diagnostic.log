            import random, math, numpy as np
            
            def angle(v1, v2):
                dot = np.dot(v1, v2)
                n1 = np.linalg.norm(v1)
                n2 = np.linalg.norm(v2)
                if n1==0 or n2==0:
                    return None
                cos = dot/(n1*n2)
                # clamp
                cos = max(-1, min(1, cos))
                return math.degrees(math.acos(cos))
            
            def compute_angle():
                # random a,b vectors
                a = np.random.randn(2)
                b = np.random.randn(2)
                # ensure not collinear
                while abs(np.linalg.det(np.stack([a,b])))<1e-3:
                    a = np.random.randn(2)
                    b = np.random.randn(2)
                # choose λ, μ random non-zero
                lam = random.uniform(-2,2)
                mu = random.uniform(-2,2)
                # enforce equal diagonal lengths: |lam-1|*|a| = |mu-1|*|b|
                # adjust mu accordingly
                # compute required mu magnitude sign maybe
                # choose sign for mu-1 same as lam-1? Not necessary.
                # Let mu = 1 + s * (|lam-1|*|a|/|b|) where s = +/-1
                s = random.choice([1,-1])
                mu = 1 + s * (abs(lam-1)*np.linalg.norm(a)/np.linalg.norm(b))
                # compute points
                c = lam * a
                d = mu * b
                # define functions to compute intersection of perpendicular bisectors
                # Solve linear equations for N: unknown vector N = x
                # equations: (N - (a+b)/2)·(b-a)=0, (N - (c+d)/2)·(d-c)=0
                # Write as linear system: N·(b-a) = ((a+b)/2)·(b-a)
                # similarly N·(d-c) = ((c+d)/2)·(d-c)
                # Solve for N in basis of a,b
                # Represent N = p*a + q*b
                # Build matrix M where rows are dot products with (b-a) and (d-c)
                # Compute RHS.
                BA = b - a
                DC = d - c
                # RHS1
                rhs1 = np.dot((a+b)/2, BA)
                rhs2 = np.dot((c+d)/2, DC)
                # Build coefficients: N·BA = p*(a·BA) + q*(b·BA)
                coeff11 = np.dot(a, BA)
                coeff12 = np.dot(b, BA)
                coeff21 = np.dot(a, DC)
                coeff22 = np.dot(b, DC)
                M = np.array([[coeff11, coeff12],[coeff21, coeff22]])
                rhs = np.array([rhs1, rhs2])
                try:
                    p,q = np.linalg.solve(M, rhs)
                except np.linalg.LinAlgError:
                    return None
                N = p*a + q*b
                # O similarly using equations with (c-b) and (d-a)
                CB = c - b
                DA = d - a
                rhs1 = np.dot((b+c)/2, CB)
                rhs2 = np.dot((a+d)/2, DA)
                coeff11 = np.dot(a, CB)
                coeff12 = np.dot(b, CB)
                coeff21 = np.dot(a, DA)
                coeff22 = np.dot(b, DA)
                M = np.array([[coeff11, coeff12],[coeff21, coeff22]])
                rhs = np.array([rhs1, rhs2])
                try:
                    p,q = np.linalg.solve(M, rhs)
                except np.linalg.LinAlgError:
                    return None
                O = p*a + q*b
                ang = angle(N, O)
                return ang
            
