                B = dy
                C = -(dx*mid[0] + dy*mid[1])
                # perpendicular line: A_perp = -B, B_perp = A, C_perp = -( -B*mid.x + A*mid.y )
                Ap = -dy
                Bp = dx
                Cp = -(Ap*mid[0] + Bp*mid[1])
                return (Ap, Bp, Cp)
            
            def intersect_line(l1,l2):
                A1,B1,C1 = l1
                A2,B2,C2 = l2
                det = A1*B2 - A2*B1
                if abs(det) < 1e-9:
                    return None
                x = (B1*C2 - B2*C1)/det
                y = (C1*A2 - C2*A1)/det
                return (x,y)
            
            def angle_between(v1,v2):
                dot = v1[0]*v2[0]+v1[1]*v2[1]
                n1 = math.hypot(*v1)
                n2 = math.hypot(*v2)
                if n1==0 or n2==0:
                    return None
                cos = max(-1,min(1,dot/(n1*n2)))
                return math.degrees(math.acos(cos))
            
            def compute_angle():
                for _ in range(1000):
                    quad = random_quad()
                    if quad is None:
                        continue
                    W,X,Y,Z = quad
                    # compute N from perp bisectors of WX and YZ
                    lWX = perp_bisector_point(W,X)
                    lYZ = perp_bisector_point(Y,Z)
                    N = intersect_line(lWX,lYZ)
                    if N is None:
