            import random, math, sympy as sp
            
            def compute_angle(a,b,c,s):
                # compute u,v,t using second solution (positive sqrt) maybe
                # choose the plus sqrt solution
                sqrt_term = sp.sqrt((-a*c + (b**2 + c**2)*s)*(a*c + (b**2 + c**2)*s))
                t = a*b/(b**2 + c**2) + sqrt_term/(b**2 + c**2)
                u = (a*b**2*s + a*c**2*s - a*c**2 + b*sqrt_term)/(s*(b**2 + c**2))
                v = c*(a*b + sqrt_term)/(s*(b**2 + c**2))
                # convert to float
                a_f,b_f,c_f,s_f = map(float, (a,b,c,s))
                t_f = float(t.subs({a:a_f,b:b_f,c:c_f,s:s_f}))
                u_f = float(u.subs({a:a_f,b:b_f,c:c_f,s:s_f}))
                v_f = float(v.subs({a:a_f,b:b_f,c:c_f,s:s_f}))
                # points
                W = sp.Point(0,0)
                X = sp.Point(a_f,0)
                Y = sp.Point(b_f,c_f)
                Z = sp.Point(u_f,v_f)
                # M intersection (should be t along WY)
                M = sp.Point(t_f*b_f, t_f*c_f)  # from w + t*(y-w)
                # N: x = a/2 vertical line intersect perp bisector of YZ
                # line YZ perp: direction perpendicular to (u-b, v-c)
                # equation: (x - (b+u)/2)*(u-b) + (y - (c+v)/2)*(v-c) = 0
                # plug x = a/2 solve for y
                xN = a_f/2
                # compute yN
                # (xN - (b+u)/2)*(u-b) + (yN - (c+v)/2)*(v-c) = 0 => solve for yN
                yN = ((b+u_f)/2)*(u_f-b_f) + ((c+v_f)/2)*(v_f-c_f)
                yN = yN/(v_f - c_f)  # because term with yN*(v-c)
                N = sp.Point(xN, yN)
                # O: intersection of two lines
                # line1: perp bisector of XY: (x - (a+b)/2)*(b-a) + (y - c/2)*c = 0
                # line2: perp bisector of WZ: (x - u/2)*u + (y - v/2)*v = 0
                x,y = sp.symbols('x y')
                eq1 = sp.Eq((x - (a_f+b_f)/2)*(b_f-a_f) + (y - c_f/2)*c_f, 0)
                eq2 = sp.Eq((x - u_f/2)*u_f + (y - v_f/2)*v_f, 0)
                solO = sp.solve([eq1,eq2],[x,y])
                O = sp.Point(solO[x], solO[y])
                # vectors
                v1 = sp.Matrix(N - M)
                v2 = sp.Matrix(O - M)
                # angle
                dot = float(v1.dot(v2))
                norm1 = float(sp.sqrt(v1.dot(v1)))
                norm2 = float(sp.sqrt(v2.dot(v2)))
                angle = math.degrees(math.acos(dot/(norm1*norm2)))
                return angle
            
