            def optimal_M(num_vars):
                # num_vars = n (number of x_i)
                # there are n+1 expressions: x1, 1/x1 + x2, ..., 1/x_n + 1
                # We'll solve using root-finding on M as before
                def G_n(M):
                    if M <= 1:
                        return mp.inf
                    x = M
                    for i in range(num_vars-1):
                        x = M - 1/x
                    # after num_vars-1 steps, we have x_{num_vars}
                    # final condition: 1/x_{num_vars} + 1 = M
                    return 1/x + 1 - M
                # find root near maybe 2
                try:
                    root = mp.findroot(G_n, (1.5, 2.5))
                except Exception as e:
                    root = None
                return root
            
            for n in range(1,6):
                print(n, optimal_M(n))
            
