            import itertools
            
            def min_dominoes(n):
                # generate domino list: each domino is tuple of cell indices (r,c)
                dominoes = []
                for r in range(n):
                    for c in range(n-1):
                        dominoes.append(((r,c),(r,c+1)))  # horizontal
                for r in range(n-1):
                    for c in range(n):
                        dominoes.append(((r,c),(r+1,c)))  # vertical
                # map each 2x2 square to list of domino indices covering it
                squares = []
                for r in range(n-1):
                    for c in range(n-1):
                        # cells in square
                        cells = [(r,c),(r,c+1),(r+1,c),(r+1,c+1)]
                        covering = []
                        for idx,d in enumerate(dominoes):
                            # if domino's both cells are within the square
                            if d[0] in cells and d[1] in cells:
                                covering.append(idx)
                        squares.append(covering)
                # brute force search increasing size
                for k in range(1, len(dominoes)+1):
                    # iterate combos of size k
                    for combo in itertools.combinations(range(len(dominoes)), k):
                        ok = True
                        combo_set = set(combo)
                        for cov in squares:
                            if not any(idx in combo_set for idx in cov):
                                ok=False
                                break
                        if ok:
                            return k, combo
                return None
            
