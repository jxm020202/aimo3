            def minimal_M(n): # n is number of x variables, chain length n, with start x1 and end 1/x_n+1
                # we will solve equality recurrence as above and find M such that after n-1 steps we reach 1/(M-1)
                # n variables => n-1 interior constraints plus start and end.
