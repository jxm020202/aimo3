            import math, numpy as np, random
            
            def circle_center_and_radius(p1, p2, side=1):
                p1 = np.array(p1, dtype=float)
                p2 = np.array(p2, dtype=float)
                mid = (p1 + p2)/2.0
                d = np.linalg.norm(p2 - p1)
                R = d  # radius for 30 deg
                v = p2 - p1
                perp = np.array([-v[1], v[0]])
                perp_norm = np.linalg.norm(perp)
                if perp_norm == 0:
                    return None, None
                perp_unit = perp / perp_norm
                h = math.sqrt(R**2 - (d/2.0)**2)  # should be sqrt(3)/2 * d
                O = mid + side * h * perp_unit
                return O, R
            
            def circle_intersections(O1,R1,O2,R2):
                d = np.linalg.norm(O2 - O1)
                if d > R1 + R2 + 1e-9 or d < abs(R1 - R2) - 1e-9:
                    return []
                a = (R1**2 - R2**2 + d**2) / (2*d) if d != 0 else 0
                h_sq = R1**2 - a**2
                if h_sq < -1e-9:
                    return []
                h = math.sqrt(max(h_sq, 0.0))
                P2 = O1 + a * (O2 - O1) / d if d != 0 else O1
                offset = h * np.array([-(O2[1]-O1[1])/d, (O2[0]-O1[0])/d]) if d != 0 else np.array([0.0,0.0])
                inter1 = P2 + offset
                inter2 = P2 - offset
                if np.allclose(inter1, inter2):
