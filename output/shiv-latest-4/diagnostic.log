                return 3*(u*u+v*v) - (u*u)*(v*v) - 8*u*v - 1 >= -1e-12  # tolerance
            def can_add(new, arr):
                return all(ok(new, x) for x in arr)
            
            def construct(n_max=20):
                arr=[1.0]
                while len(arr)<n_max:
                    # try to find a new number >0 distinct
                    # start from large value
                    cand=arr[-1]*2+1  # simple
                    while not can_add(cand, arr):
