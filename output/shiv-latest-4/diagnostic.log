            import sympy as sp
            
            def condition_eq(n):
                M = sp.symbols('M')
                # compute p_n sequence
                p = [sp.Integer(1), M]  # p0=1, p1=M
                for k in range(2, n+2):  # need up to p_{n+1}
                    p.append(M * p[-1] - p[-2])
                # p[k] corresponds to p_k
                p_n = p[n]      # p_n
                p_n1 = p[n-1]   # p_{n-1}
                p_n2 = p[n-2]   # p_{n-2}
                # equation: (p_n M - p_{n-1})/(p_{n-1} M - p_{n-2}) = 1/(M-1)
                expr = sp.simplify((p_n*M - p_n1)*(M-1) - (p_n1*M - p_n2))
                # expr = 0 is condition
                return sp.expand(expr)
            
            for n in range(1,7):
                expr = condition_eq(n)
                print("n=", n, "degree:", sp.degree(expr, sp.Symbol('M')), "factor:", sp.factor(expr))
            
