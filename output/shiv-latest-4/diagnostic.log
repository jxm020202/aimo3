            import random, math
            
            def angle_NMO(lam, mu, theta):
                c = (1+lam)/(1+mu)
                a = sp.Matrix([1,0])
                b = sp.Matrix([c*math.cos(theta), c*math.sin(theta)])
                # compute N via solving linear equations numerically
                # using formulas derived earlier
                Nx = (-c**2*mu**2 + c**2*mu + lam**2 - mu)/(2*(lam - mu))
                Ny = (c**3*mu**2*math.cos(theta) - c**3*mu*math.cos(theta) + c**2*lam - c**2*mu**2 - c*lam**2*math.cos(theta) + c*mu*math.cos(theta) + lam**2 - lam)/(2*c*(lam - mu)*math.sin(theta))
                Ox = (c**2*mu**2 + c**2*mu - lam**2*mu - 1)/(2*(lam*mu - 1))
                Oy = (-c**3*mu**2*math.cos(theta) - c**3*mu*math.cos(theta) - c**2*lam*mu**2 - c**2 + c*lam**2*mu*math.cos(theta) + c*math.cos(theta) + lam**2 + lam)/(2*c*(lam*mu - 1)*math.sin(theta))
                # vectors
                N = sp.Matrix([Nx, Ny])
                O = sp.Matrix([Ox, Oy])
                # angle
                dot = float(N.dot(O))
                normN = float(sp.sqrt(N.dot(N)))
                normO = float(sp.sqrt(O.dot(O)))
                cosang = dot/(normN*normO)
                # clamp
                cosang = max(-1, min(1, cosang))
                ang = math.degrees(math.acos(cosang))
                return ang
            
