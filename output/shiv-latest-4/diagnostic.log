            import math, random
            
            def compute_angle(a,u,v,s,t):
                # points
                W = (-a,0)
                X = (a,0)
                Y = (u,v)
                Z = (s,t)
                # compute intersection M of WY and XZ
                # line WY: W + λ (Y-W)
                # line XZ: X + μ (Z-X)
                # solve for λ, μ
                # using linear equations
                # Solve for λ, μ: W + λ*(Y-W) = X + μ*(Z-X)
                # components:
                # -a + λ*(u + a) = a + μ*(s - a)
                # 0 + λ*v = μ*t
                # solve
                # from second: μ = λ*v / t if t !=0 else handle
                if abs(t) < 1e-9:
                    return None
                mu = None
                lam = None
                # solve linear system
                # Use sympy for reliability
                lam, mu = sp.symbols('lam mu')
                sol = sp.solve([
                    -a + lam*(u + a) - (a + mu*(s - a)),
                    lam*v - mu*t
                ], (lam, mu), dict=True)
                if not sol:
                    return None
                sol = sol[0]
                lam_val = float(sol[lam])
                mu_val = float(sol[mu])
                Mx = -a + lam_val*(u + a)
                My = lam_val*v
                M = (Mx, My)
                # N: x=0 intersect perp bisector of YZ
                # compute y_N
                if abs(t - v) < 1e-9:
                    return None
                yN = (v + t)/2 + ((s - u)*(u + s)) / (2*(t - v))
                N = (0.0, yN)
                # O: solve intersection of two perp bisectors
                # line1: perp bisector of XY
                # slope1 = -(u - a)/v
                if abs(v) < 1e-9:
                    return None
                slope1 = -(u - a)/v
                x1mid = (a + u)/2
                y1mid = v/2
                # line2: perp bisector of WZ
                if abs(t) < 1e-9:
                    return None
                slope2 = -(s + a)/t
                x2mid = (-a + s)/2
                y2mid = t/2
                # solve for intersection
                # y = slope1*(x - x1mid) + y1mid
                # y = slope2*(x - x2mid) + y2mid
                # set equal
                if abs(slope1 - slope2) < 1e-9:
                    return None
                xO = (slope1*x1mid - slope2*x2mid + y2mid - y1mid) / (slope1 - slope2)
                yO = slope1*(xO - x1mid) + y1mid
                O = (xO, yO)
                # compute angle NMO
                import numpy as np
                v1 = np.array(N) - np.array(M)
                v2 = np.array(O) - np.array(M)
                dot = np.dot(v1, v2)
                norm1 = np.linalg.norm(v1)
                norm2 = np.linalg.norm(v2)
                if norm1*norm2 == 0:
                    return None
                cosang = dot/(norm1*norm2)
                # clamp
                cosang = max(-1,min(1,cosang))
                ang = math.degrees(math.acos(cosang))
                return ang
            
            def random_quad():
