            import math, itertools, numpy as np
            
            def compute_J_candidates(A, B):
                # points
                G = np.array([0.0, 0.0])
                F = np.array([1.0, 0.0])
                H = np.array([math.cos(math.radians(A)), math.sin(math.radians(A))])
                I = np.array([math.cos(math.radians(A)) - math.cos(math.radians(A+B)),
                             math.sin(math.radians(A)) - math.sin(math.radians(A+B))])
                # chord FH
                P = F
                Q = H
                c1 = np.linalg.norm(Q-P)
                M1 = (P+Q)/2
                # perp vector (rotate (Q-P) by +90 deg)
                v1 = Q-P
                perp1 = np.array([-v1[1], v1[0]])  # length = c1
                O1 = M1 + (math.sqrt(3)/2) * perp1  # center
                # chord GI
                P2 = G
                Q2 = I
                c2 = np.linalg.norm(Q2-P2)
                M2 = (P2+Q2)/2
                v2 = Q2-P2
                perp2 = np.array([-v2[1], v2[0]])  # length = c2
                O2 = M2 + (math.sqrt(3)/2) * perp2
                # radii
                R1 = c1
                R2 = c2
                # intersect circles O1,R1 and O2,R2
                # compute distance between centers
                d = np.linalg.norm(O2-O1)
                if d > R1+R2+1e-9 or d < abs(R1-R2)-1e-9:
                    return []  # no intersection
                # find intersection points
                # using circle-circle intersection formula
                # a = (R1^2 - R2^2 + d^2) / (2d)
                a = (R1**2 - R2**2 + d**2) / (2*d)
                h = math.sqrt(max(R1**2 - a**2, 0.0))
                # point P3 = O1 + a*(O2-O1)/d
                P3 = O1 + a*(O2-O1)/d
                # offset vector perpendicular to line O1O2
                offset = h * np.array([-(O2[1]-O1[1])/d, (O2[0]-O1[0])/d]
                J1 = P3 + offset
                J2 = P3 - offset
                return [J1, J2]
            
            def angle_between(v1, v2):
                dot = np.dot(v1, v2)
                n1 = np.linalg.norm(v1)
                n2 = np.linalg.norm(v2)
                if n1*n2 == 0:
                    return None
                cosang = dot/(n1*n2)
                cosang = max(min(cosang,1),-1)
                return math.degrees(math.acos(cosang))
            
            def is_convex(F,G,H,I,J):
                # order: F,G,H,I,J (but earlier we used G,F,H,I,J? Actually polygon order is F-G-H-I-J)
                # We'll test order F->G->H->I->J
