            def construct(n):
                # colors: rows 1..n, columns n+1..2n, extra 2n+1
                extra = 2*n+1
                board = [[None]*n for _ in range(n)]
                # assign row colors at first column
                for i in range(n):
                    board[i][0]=i+1
                # assign column colors at first row (except (0,0) already row color)
                for j in range(1,n):
                    board[0][j]=n+1+j
                # fill rest with extra
                for i in range(1,n):
                    for j in range(1,n):
                        board[i][j]=extra
