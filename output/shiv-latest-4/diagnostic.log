            def find_multi(limit_prime=13, max_exp=10):
                sols=[]
                primes = list(sp.primerange(2, limit_prime+1))
                # recursive search
                def rec(i, current_sum, current_n):
                    if i==len(primes):
                        if current_sum==Fraction(1,1):
                            sols.append(current_n)
                        return
                    p=primes[i]
                    # try exponent from 0 up to max_exp
                    for k in range(0, max_exp+1):
                        new_sum = current_sum + Fraction(k, p)
                        if new_sum > 1:
                            break
                        new_n = current_n * (p**k)
                        rec(i+1, new_sum, new_n)
                rec(0, Fraction(0,1), 1)
                return sorted(set(sols))
            
