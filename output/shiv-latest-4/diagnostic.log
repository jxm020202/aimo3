                        squares.append(sq)
                # backtrack with pruning: keep set of used colors count.
                def backtrack(idx, assign, used):
                    nonlocal maxc, best
                    if idx == len(order):
                        c = len(used)
                        if c > maxc:
                            maxc = c
                            best = assign.copy()
                        return
                    # optimistic bound: remaining cells could each be new color
