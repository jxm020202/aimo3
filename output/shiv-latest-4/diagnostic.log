            def min_walk_sum(n):
                # walk length n-1 steps, positions for i=1..n (R_1=0)
                # compute min over all sequences of +/-1
                from itertools import product
                best=10**9
                for steps in product([1,-1], repeat=n-1):
                    pos=0
                    positions=[0]
                    for s in steps:
                        pos+=s
                        positions.append(pos)
                    minpos=min(positions)
                    shifted=[p - minpos for p in positions]
                    total=sum(shifted)
                    if total<best:
                        best=total
                return best
            
