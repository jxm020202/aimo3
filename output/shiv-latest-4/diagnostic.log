            def min_sum_n(n):
                # brute force over all sequences of steps +/-1? That's 2^{n-1} possibilities, manageable for n up to maybe 6.
                min_total = None
                # generate row seq x_i values with steps +/-1, start at 0 (we can shift later)
                # We'll generate all sequences of length n with steps +/-1, starting at 0.
                def gen_seq(n):
                    seqs = []
                    for steps in itertools.product([1,-1], repeat=n-1):
                        vals = [0]
                        for s in steps:
                            vals.append(vals[-1]+s)
                        seqs.append(vals)
