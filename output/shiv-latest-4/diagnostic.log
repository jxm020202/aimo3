                    # try new color
                    assign[idx] = distinct
                    ok = True
                    for b in cell_blocks[idx]:
                        if not check_block_fully(b):
                            ok = False
                            break
                    if ok:
                        dfs(idx+1, distinct+1)
                    assign[idx] = -1
                
                try:
                    dfs(0,0)
                except TimeoutError:
                    print("timeout, best so far", best)
                return best, best_assign
            
