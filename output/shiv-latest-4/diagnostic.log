            import math, random, itertools, numpy as np
            
            def rotate(vec, angle):
                c = math.cos(angle)
                s = math.sin(angle)
                x,y = vec
                return (c*x - s*y, s*x + c*y)
            
            def intersect_lines(p1, d1, p2, d2):
                # solve p1 + t*d1 = p2 + s*d2
                # 2x2 linear system for t,s
                # d1*t - d2*s = p2 - p1
                a = np.array([[d1[0], -d2[0]],[d1[1], -d2[1]]], dtype=float)
                b = np.array([p2[0]-p1[0], p2[1]-p1[1]], dtype=float)
                det = np.linalg.det(a)
                if abs(det) < 1e-9:
                    return None
                sol = np.linalg.solve(a,b)
                t = sol[0]
                s = sol[1]
                if t < -1e-9 or s < -1e-9:
                    # intersection not in forward direction (negative parameter)
                    return None
                return (p1[0] + t*d1[0], p1[1] + t*d1[1])
            
            def compute_J_candidates(alpha, beta):
                # compute points
                F = (0.0,0.0)
                G = (1.0,0.0)
                H = (1+math.cos(alpha), math.sin(alpha))
                # compute I
                u = (-math.cos(alpha), -math.sin(alpha))
                v = rotate(u, beta)  # rotate by +beta
                I = (H[0]+v[0], H[1]+v[1])
                # FH vector
                FH = (H[0]-F[0], H[1]-F[1])
                # GI vector
                GI = (G[0]-I[0], G[1]-I[1])
                # unit vectors
                def unit(vec):
                    norm = math.hypot(vec[0], vec[1])
                    return (vec[0]/norm, vec[1]/norm)
                u_FH = unit(FH)
                u_GI = unit(GI)
                # directions from F: rotate by +/-30°
                ang30 = math.radians(30)
                dirs_F = [rotate(u_FH, ang30), rotate(u_FH, -ang30)]
                # directions from I: rotate GI unit by +/-30°
                dirs_I = [rotate(u_GI, ang30), rotate(u_GI, -ang30)]
                candidates = []
                for dF in dirs_F:
                    for dI in dirs_I:
                        J = intersect_lines(F, dF, I, dI)
                        if J is not None:
                            candidates.append(J)
                return J, candidates, (F,G,H,I)
            
            def angle_GJH(F,G,H,J):
                v1 = (G[0]-J[0], G[1]-J[1])
                v2 = (H[0]-J[0], H[1]-J[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                n1 = math.hypot(v1[0], v1[1])
                n2 = math.hypot(v2[0], v2[1])
                cosang = max(-1, min(1, dot/(n1*n2)))
                return math.degrees(math.acos(cosang))
            
            def is_convex(F,G,H,I,J):
                # compute cross signs
                pts = [F,G,H,I,J]
                signs = []
                n = len(pts)
                for i in range(n):
                    p0 = pts[i]
                    p1 = pts[(i+1)%n]
                    p2 = pts[(i+2)%n]
                    v1 = (p1[0]-p0[0], p1[1]-p0[1])
                    v2 = (p2[0]-p1[0], p2[1]-p1[1])
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    signs.append(cross)
                # all same sign (allow small tolerance)
                pos = sum(1 for c in signs if c > 1e-8)
                neg = sum(1 for c in signs if c < -1e-8)
                return (pos==0 or neg==0) and all(abs(c)>1e-8 for c in signs)
            
