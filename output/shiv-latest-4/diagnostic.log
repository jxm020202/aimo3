                I = sp.Point(H.x + sp.cos(beta), H.y + sp.sin(beta))
                # vectors
                IG = sp.Matrix([G.x - I.x, G.y - I.y])
                IJ = sp.Matrix([xj - I.x, yj - I.y])
                JF = sp.Matrix([F.x - xj, F.y - yj])  # F - J
                FH = sp.Matrix([H.x - F.x, H.y - F.y])
