            import math, numpy as np
            
            def allowed_interval(a):
                A=3 - a*a
                B=-8*a
                C=3*a*a -1
                D=12*(a*a+1)**2
                sqrtD=math.sqrt(D)
                b1 = (-B - sqrtD)/(2*A)  # note using formula -B +/- sqrtD over 2A? Actually roots of A b^2 + B b + C =0: b = (-B ± sqrtD)/(2A)
                b2 = (-B + sqrtD)/(2*A)
                # ensure b1 <= b2
                if b1>b2:
                    b1,b2=b2,b1
                if A>0:
                    # solution set: (-inf, b1] ∪ [b2, inf)
                    return [(-math.inf, b1), (b2, math.inf)]
                else:
                    # solution set: [b1, b2]
                    return [(b1,b2)]
            
