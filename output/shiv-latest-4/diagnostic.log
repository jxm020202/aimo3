            import sympy as sp
            
            # variables
            b, h, s = sp.symbols('b h s', positive=True, real=True)
            
            a = 1  # base length
            
            # relations
            eq1 = sp.Eq(b**2, (a/2)**2 + h**2)  # b^2 = (1/2)^2 + h^2
            
            Qx = (b - a)/(2*b)  # (b-1)/(2b)
            Qy = h*(b - a)/b    # h*(b-1)/b
            
            Px = (b + s)/(2*b)   # (b+s)/(2b)
            Py = h*(1 - s/b)    # h*(b - s)/b
            
            # distance squared QP
            dist_QP2 = (Px - Qx)**2 + (Py - Qy)**2
            dist_PY2 = (Px - 0)**2 + (Py - 0)**2
            
            eq2 = sp.Eq(dist_QP2, a**2)
            eq3 = sp.Eq(dist_PY2, a**2)
            
