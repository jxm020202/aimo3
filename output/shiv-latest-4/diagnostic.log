                    f_hi = f(hi_candidate)
                    if f_lo*f_hi < 0:
                        hi = hi_candidate
                        break
                    f_lo = f_hi
                if hi is None:
                    return None
                # use bisection
                import mpmath as mp
                root = mp.findroot(lambda x: f(x), (lo, hi))
                return float(root)
            
            def angle_GJH(alpha,beta,b,case):
