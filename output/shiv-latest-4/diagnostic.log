                uncolored_edges = [e for e,c in zip(edges,assigned) if c is None]
                k = len(uncolored_edges)
                # Cases
                if k==0:
                    # check condition
                    cols = assigned
                    cnt = {}
                    for col in cols:
                        cnt[col]=cnt.get(col,0)+1
                    if sorted(cnt.values())==[1,2]:
                        return [dict()]  # no new assignments
                    else:
                        return []
                if k==3:
                    # generate all 18 assignments
                    res=[]
                    colors=[0,1,2]
                    for a in colors:
                        for b in colors:
                            if b==a: continue
                            for pos in range(3):
                                col_assign = [a,a,a]
                                col_assign[pos]=b
                                # map edges to colors
                                mapping = {edges[i]:col_assign[i] for i in range(3)}
                                res.append(mapping)
                    return res
                if k==2:
                    # one precolored edge
                    e_fixed = assigned_edges[0]
                    c_fixed = precolored[e_fixed]
                    # two uncolored edges e2,e3
                    e2,e3 = uncolored_edges
                    res=[]
                    # case: fixed edge is majority
                    a = c_fixed
                    for b in [c for c in [0,1,2] if c!=a]:
                        # choose which of the two uncolored edges is minority
                        # pos among the two: we can assign minority to e2 or e3
                        # For each choice, set other edge to a
                        mapping = {}
                        mapping[e_fixed]=a
                        mapping[e2]=b
                        mapping[e3]=a
                        res.append(mapping)
                        mapping2 = {}
                        mapping2[e_fixed]=a
                        mapping2[e2]=a
                        mapping2[e3]=b
                        res.append(mapping2)
                    # case: fixed edge is minority
                    b = c_fixed
                    for a in [c for c in [0,1,2] if c!=b]:
                        # both uncolored edges get a
                        mapping = {e_fixed:b, e2:a, e3:a}
                        res.append(mapping)
                    # Remove duplicates (possible same mapping)
                    # Use tuple of sorted items to deduplicate
                    uniq = {}
                    for m in res:
                        key = tuple(sorted(m.items()))
                        uniq[key]=m
                    return list(uniq.values())
                if k==1:
                    # two precolored edges
                    e1,e2 = assigned_edges
                    c1 = precolored[e1]
                    c2 = precolored[e2]
                    e3 = uncolored_edges[0]
                    res=[]
                    if c1==c2:
                        # they are majority, third edge minority with color != c1
                        a = c1
                        for b in [c for c in [0,1,2] if c!=a]:
                            mapping = {e1:a, e2:a, e3:b}
                            res.append(mapping)
                    else:
