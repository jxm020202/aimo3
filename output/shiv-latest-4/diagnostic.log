            import random, math
            def random_point():
                # generate random direction uniformly on sphere
                import random, math
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v-1)
                x = math.sin(phi)*math.cos(theta)
                y = math.sin(phi)*math.sin(theta)
                z = math.cos(phi)
                # scale to sqrt(3)
                scale = math.sqrt(3)
                return (scale*x, scale*y, scale*z)
            
