            import math, random
            
            def compute_J(alpha, theta, sign1, sign2):
                # sign1: +1 for rotate +30°, -1 for -30° for IG
                # sign2: +1 for rotate +30°, -1 for -30° for FH
                # points
                F = (math.cos(alpha), math.sin(alpha))
                G = (0.0, 0.0)
                H = (1.0, 0.0)
                I = (1+math.cos(theta), math.sin(theta))
                # vectors
                IG = (G[0]-I[0], G[1]-I[1])
                FH = (H[0]-F[0], H[1]-F[1])
                # rotate
                phi = math.radians(30)
                c = math.cos(sign1*phi)
                s = math.sin(sign1*phi)
                d1 = (c*IG[0] - s*IG[1], s*IG[0] + c*IG[1])
                c2 = math.cos(sign2*phi)
                s2 = math.sin(sign2*phi)
                d2 = (c2*FH[0] - s2*FH[1], s2*FH[0] + c2*FH[1])
                # solve I + t*d1 = F + u*d2
                # two equations:
                # I_x + t*d1x = F_x + u*d2x
                # I_y + t*d1y = F_y + u*d2y
                # solve linear system for t,u
                A = [[d1[0], -d2[0]],
                     [d1[1], -d2[1]]]
                b = [F[0]-I[0], F[1]-I[1]]
                # compute determinant
                det = A[0][0]*A[1][1] - A[0][1]*A[1][0]
                if abs(det) < 1e-9:
                    return None
                t = (b[0]*A[1][1] - b[1]*A[0][1]) / det
                # u = (A[0][0]*b[1] - A[1][0]*b[0]) / det
                J = (I[0] + t*d1[0], I[1] + t*d1[1])
                return J
            
            def angle(p,q,r):
                # angle pqr at q
                v1 = (p[0]-q[0], p[1]-q[1])
                v2 = (r[0]-q[0], r[1]-q[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                if norm1*norm2 == 0:
                    return None
                cosang = max(-1,min(1,dot/(norm1*norm2)))
                return math.degrees(math.acos(cosang))
            
            def is_convex(F,G,H,I,J):
                # check orientation of consecutive triples (F,G,H), (G,H,I), (H,I,J), (I,J,F), (J,F,G)
                # compute cross product z of vectors (B-A) x (C-B)
                def cross(A,B,C):
                    return (B[0]-A[0])*(C[1]-B[1]) - (B[1]-A[1])*(C[0]-B[0])
                pts = [F,G,H,I,J]
                signs = []
                n = len(pts)
                for i in range(n):
                    A = pts[i]
                    B = pts[(i+1)%n]
                    C = pts[(i+2)%n]
                    cp = cross(A,B,C)
                    signs.append(cp)
                # convex if all cross products have same sign (non-zero)
                pos = [s for s in signs if s>1e-9]
                neg = [s for s in signs if s<-1e-9]
                return (len(pos)==0 or len(neg)==0)
            
            def sample_random():
                # random alpha,theta in (0,pi)
                alpha = random.uniform(0.1, math.pi-0.1)
                theta = random.uniform(0.1, math.pi-0.1)
                F = (math.cos(alpha), math.sin(alpha))
                I = (1+math.cos(theta), math.sin(theta))
                # ensure convex orientation maybe
                return alpha,theta
            
            def compute_possible_angles(num_samples=2000):
                results = set()
                for _ in range(num_samples):
                    alpha,theta = sample_random()
                    for s1 in [+1,-1]:
                        for s2 in [+1,-1]:
                            J = compute_J(alpha,theta,s1,s2)
                            if J is None:
                                continue
                            F = (math.cos(alpha), math.sin(alpha))
                            G = (0.0,0.0)
                            H = (1.0,0.0)
                            I = (1+math.cos(theta), math.sin(theta))
                            # check convex
                            if not is_convex(F,G,H,I,J):
                                continue
                            # compute angle GJH
                            ang = angle(G,J,H)
                            if ang is None:
                                continue
                            # round to near integer maybe
                            results.add(round(ang,6))
                return results
            
            angles = compute_possible_angles(2000)
            len(angles), list(sorted(angles))[:20]
            
