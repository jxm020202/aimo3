                A = []
                b = []
                # adjacency constraints
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        # right neighbor
                        if j+1 < n:
                            idx2 = i*n + (j+1)
                            # x - y <= 1
                            row = np.zeros(N, dtype=int)
                            row[idx]=1
                            row[idx2]=-1
                            A.append(row)
                            b.append(1)
