            def elimination_ordering(G):
                Gc = G.copy()
                ordering = []
                while Gc.nodes():
                    # pick node with smallest degree
                    v = min(Gc.nodes, key=lambda x: Gc.degree[x])
                    ordering.append(v)
                    Gc.remove_node(v)
                return ordering
            
