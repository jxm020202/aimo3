            import random, math, cmath, itertools, sys, numpy as np
            
            def compute_angle():
                # random equal length vectors
                theta = random.random()*2*math.pi
                length = 1.0
                d1 = np.array([math.cos(theta), math.sin(theta)])*length
                phi = random.random()*2*math.pi
                d2 = np.array([math.cos(phi), math.sin(phi)])*length  # same length
                # random division ratios
                a = random.random()
                b = 1-a
                c = random.random()
                d = 1-c
                # points
                W = -a * d1
                Y = b * d1
                X = -c * d2
                Z = d * d2
                M = np.array([0.0,0.0])
                # function to get perpendicular bisector intersection of two segments
                def perp_bisector(p1,p2):
                    mid = (p1+p2)/2
                    # direction vector of segment
                    v = p2-p1
                    # perpendicular direction
                    perp = np.array([-v[1], v[0]])
                    return (mid, perp)
                # line represented as point + t*dir
                def intersect(line1, line2):
                    p1, d1 = line1
                    p2, d2 = line2
                    # solve p1 + t*d1 = p2 + s*d2
                    # 2 equations
                    A = np.column_stack((d1, -d2))
                    b = p2 - p1
                    # solve for t,s
                    try:
                        sol = np.linalg.lstsq(A, b, rcond=None)[0]
                    except np.linalg.LinAlgError:
                        return None
                    t = sol[0]
                    return p1 + t*d1
                # N from WX and YZ
                line_WX = perp_bisector(W,X)
                line_YZ = perp_bisector(Y,Z)
                N = intersect(line_WX, line_YZ)
                # O from XY and WZ
                line_XY = perp_bisector(X,Y)
                line_WZ = perp_bisector(W,Z)
                O = intersect(line_XY, line_WZ)
                # angle NMO
                v1 = N - M
                v2 = O - M
                # compute angle
                dot = np.dot(v1,v2)
                ang = math.degrees(math.acos(dot / (np.linalg.norm(v1)*np.linalg.norm(v2))))
                return ang
            
