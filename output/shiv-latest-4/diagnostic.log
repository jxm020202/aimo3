            import random, sympy as sp, math
            def real_root_count(p,q,r,s):
                z=sp.symbols('z')
                f = p*z**3+q*z**2+r*z+s
                h = sp.diff(f,z)**2 - f*sp.diff(f,z,2)
                # get real roots numerically
                roots = sp.nroots(h)
                real = [root for root in roots if abs(sp.im(root))<1e-8]
                # distinct within tolerance
                vals = sorted([float(sp.re(r)) for r in real])
                # deduplicate
                distinct=[]
                for v in vals:
                    if not distinct or abs(v-distinct[-1])>1e-6:
                        distinct.append(v)
                return len(distinct)
            
            def random_cubic():
                while True:
                    p = random.randint(1,5)
                    q = random.randint(-5,5)
                    r = random.randint(-5,5)
                    s = random.randint(-5,5)
                    # check discriminant >0 for three distinct real roots
                    y=sp.symbols('y')
                    disc = sp.discriminant(p*y**3+q*y**2+r*y+s, y)
                    if disc>0:
                        return p,q,r,s
            
            counts=set()
            for _ in range(30):
                p,q,r,s = random_cubic()
                cnt=real_root_count(p,q,r,s)
                counts.add(cnt)
                print(p,q,r,s,cnt)
