                # t*dy1 - s*dy2 = y2 - y1
                # matrix [[dx1, -dx2],[dy1, -dy2]] * [t,s]^T = [x2-x1, y2-y1]^T
                det = dx1*(-dy2) - (-dx2)*dy1  # dx1*(-dy2) + dx2*dy1
