                    neighbor_edges[v].append((u, idx))
                count = 0
                # recursion
                def recurse(domains):
                    nonlocal count
                    # check if all assigned (domain size 1)
                    if all(len(domains[v])==1 for v in G.nodes()):
                        count = (count+1) % mod
                        return
                    # select vertex with smallest domain >1
                    v = min((v for v in G.nodes() if len(domains[v])>1), key=lambda x: len(domains[x]))
                    # try each possible state
                    for state in domains[v]:
                        # copy domains
                        new_domains = {u: list(domains[u]) for u in G.nodes()}
                        new_domains[v] = [state]
                        # propagate constraints to neighbors
                        stack = [v]
