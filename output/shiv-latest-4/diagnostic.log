            import math, itertools
            from fractions import Fraction
            
            def rational_roots(poly_coeffs, lead, const):
                # poly_coeffs list from highest degree to constant term (including const)
                roots=[]
                # get divisors of const and lead
                def divisors(num):
                    num=abs(num)
                    divs=set()
                    for i in range(1,int(math.isqrt(num))+1):
                        if num%i==0:
                            divs.add(i)
                            divs.add(num//i)
                    return divs
                p_div=divisors(const)
                q_div=divisors(lead)
                for p in p_div:
                    for q in q_div:
                        for sign in [1,-1]:
                            r=Fraction(sign*p, q)
                            # evaluate polynomial
                            val=Fraction(0,1)
                            deg=len(poly_coeffs)-1
                            for coeff in poly_coeffs:
                                val = val * r + coeff
                            if val==0:
                                roots.append(r)
                return set(roots)
            
            def find_solutions(N):
                sols=[]
                for n in range(2,N+1):
                    # build polynomial f_n(r)-1
                    # coefficients for degree n-1 down to 0
                    coeffs=[0]*(n)  # length n (degree n-1)
                    for m in range((n-1)//2+1):
                        k=2*m+1
                        coeff = sp.binomial(n,k)*(2**m)
                        power = n - k
                        coeffs[ (n-1)-power ] += int(coeff)  # index from highest degree
                    # subtract 1 from constant term
                    coeffs[-1] -= 1
                    # leading coefficient is coeffs[0] which should be n
                    lead = coeffs[0]
                    const = coeffs[-1]
                    roots = rational_roots(coeffs, lead, const)
                    for r in roots:
                        sols.append((n, r))
                return sols
            
            sols=find_solutions(30)
            sols[:20], len(sols)
            
