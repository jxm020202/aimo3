            def is_convex_polygon(points):
                # points list of (x,y) in order, closed polygon (first not repeated)
                n = len(points)
                # compute cross product sign of each edge pair
                sign = 0
                for i in range(n):
                    p0 = np.array(points[i])
                    p1 = np.array(points[(i+1)%n])
                    p2 = np.array(points[(i+2)%n])
                    v1 = p1 - p0
                    v2 = p2 - p1
                    cross = np.cross(v1, v2)  # scalar in 2D
                    if abs(cross) < 1e-9:
                        continue
                    if sign == 0:
                        sign = 1 if cross > 0 else -1
                    else:
                        if (cross > 0 and sign < 0) or (cross < 0 and sign > 0):
                            return False
                # also ensure polygon is simple (no self-intersection). For convex, cross sign uniform ensures simple.
                return True
            
            def test_convex(theta_val, alpha_val, Jcoords):
                F = (0.0,0.0)
                G = (1.0,0.0)
                H = (1+math.cos(theta_val), math.sin(theta_val))
                I = (1+math.cos(theta_val)+math.cos(alpha_val), math.sin(theta_val)+math.sin(alpha_val))
                J = Jcoords
                return is_convex_polygon([F,G,H,I,J])
            
