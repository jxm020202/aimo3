            import numpy as np, math, random
            
            def compute_N_O(p,q,r,s,theta):
                a = np.array([1.0,0.0])
                b = np.array([math.cos(theta), math.sin(theta)])
                W = -p*a
                Y = q*a
                X = -r*b
                Z = s*b
                # N
                M1 = (W+X)/2
                M2 = (Y+Z)/2
                d1 = np.array([-(X-W)[1], (X-W)[0]])  # perp
                d2 = np.array([-(Z-Y)[1], (Z-Y)[0]])
                # Solve M1 + t1 d1 = M2 + t2 d2
                A = np.column_stack((d1, -d2))
                bvec = M2 - M1
                t = np.linalg.solve(A, bvec)
                N = M1 + t[0]*d1
                # O
                M3 = (X+Y)/2
                M4 = (W+Z)/2
                d3 = np.array([-(Y-X)[1], (Y-X)[0]])
                d4 = np.array([-(Z-W)[1], (Z-W)[0]])
