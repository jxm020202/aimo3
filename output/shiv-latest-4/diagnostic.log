            def count_colorings_forward_checking2(mod=1000):
                n_edges = len(edge_list)
                # initial domains: all 3 colors possible (bits 0b111)
                domains = [0b111]*n_edges
                # face edges list
                faces = faces_edges_idx
                # edge to faces mapping already have edge_to_faces
                # For each face, we will need to know positions of edges
                # Precompute for each face the three edges
                # We'll also need neighbor positions for odd edge logic later? Not needed for counting because we already encoded constraints in factor approach.
                # We'll use backtracking with MRV heuristic
                count = 0
                
                # Helper functions
                def bits_to_states(mask):
                    # return list of colors (0,1,2) where bit set
                    return [c for c in range(3) if mask & (1<<c)]
                
                def domain_size(mask):
                    return (mask & 1) + ((mask>>1)&1) + ((mask>>2)&1)
                
                # Propagation function: enforce triangle constraints
                def propagate(stack):
                    # stack contains edges whose domain changed (edge index)
                    # We'll process queue
                    while stack:
                        e = stack.pop()
                        # For each face containing e
                        for fi in edge_to_faces[e]:
                            e1,e2,e3 = faces[fi]
                            # get current domains
                            d1,d2,d3 = domains[e1], domains[e2], domains[e3]
                            # Count assigned edges (domain size 1)
                            assigned = [(e1,d1),(e2,d2),(e3,d3)]
                            # Determine if we can reduce any domain
                            # Cases:
                            # If two edges have domain size 1 (assigned colors)
                            #   If colors equal: third edge cannot be that color
                            #   If colors different: third edge must be either of those two colors
                            # If one edge assigned and another edge domain size 1? Already covered.
                            # If one edge assigned and another edge domain size >1, no immediate restriction.
                            # Implement reduction when two edges have size 1
                            singles = [(ei, bits_to_states(di)[0]) for ei,di in assigned if domain_size(di)==1]
                            if len(singles)==2:
                                (e_a, col_a), (e_b, col_b) = singles
                                # third edge
                                e_c = {e1,e2,e3} - {e_a, e_b}
                                e_c = e_c.pop()
                                old_mask = domains[e_c]
                                if col_a == col_b:
                                    # third edge cannot be col_a
                                    new_mask = old_mask & (~(1<<col_a))
                                else:
                                    # third edge must be col_a or col_b
                                    allowed = (1<<col_a) | (1<<col_b)
                                    new_mask = old_mask & allowed
                                if new_mask != old_mask:
                                    if new_mask == 0:
                                        return False
                                    domains[e_c] = new_mask
                                    stack.append(e_c)
                            # Additionally, if one edge assigned (size1) and another edge domain size 1? Already handled.
                            # Also, if one edge assigned and another edge domain size 1? that's same as two assigned.
                            # If one edge assigned and another edge domain size >1, we cannot reduce yet.
                            # However, we can also reduce when two edges have domain size 1 and third already assigned (size1) we need to check consistency; but that will be caught later when checking full face.
                            # Also, if all three edges assigned (size1), we need to verify condition; we can check later.
                    return True
                
                # Recursive search
                def backtrack():
                    nonlocal count
                    # Check if all edges assigned
                    if all(domain_size(domains[e]) == 1 for e in range(n_edges)):
                        # Verify all faces condition
                        for fi in range(len(faces)):
                            e1,e2,e3 = faces[fi]
                            c1 = bits_to_states(domains[e1])[0]
                            c2 = bits_to_states(domains[e2])[0]
                            c3 = bits_to_states(domains[e3])[0]
                            if len({c1,c2,c3}) != 2:
                                return
                        count = (count + 1) % mod
                        return
                    # select edge with smallest domain >1 (MRV)
                    # also could use degree heuristic
                    min_size = 4
                    sel = None
                    for e in range(n_edges):
                        sz = domain_size(domains[e])
                        if 1 < sz < min_size:
                            min_size = sz
                            sel = e
                            if sz == 2:
                                break
                    if sel is None:
                        return
                    # try each possible color
                    possible = bits_to_states(domains[sel])
                    for col in possible:
                        # save snapshot of domains changes
                        saved = []
                        # assign sel to col
                        old_mask = domains[sel]
                        if old_mask == (1<<col):
                            # already assigned
                            continue
                        domains[sel] = (1<<col)
                        saved.append((sel, old_mask))
                        # propagate
                        stack = [sel]
                        ok = propagate(stack)
                        if ok:
                            backtrack()
                        # revert changes
                        for e_idx, old in reversed(saved):
