                w = (math.cos(theta2), math.sin(theta2))
                # choose positive scalars s,t,p,q
                s = random.uniform(0.5,2)
                t = random.uniform(0.5,2)
                p = random.uniform(0.5,2)
                q = random.uniform(0.5,2)
                # enforce equal diagonal lengths: (s+t)*|v| = (p+q)*|w|
                # adjust q to satisfy
                lenv = math.hypot(*v)
                lenw = math.hypot(*w)
                target = (s+t)*lenv
                q = target/lenw - p
                if q <= 0:
                    return None
                # define points
                W = (M[0] + s*v[0], M[1] + s*v[1])
                Y = (M[0] - t*v[0], M[1] - t*v[1])
                X = (M[0] + p*w[0], M[1] + p*w[1])
                Z = (M[0] - q*w[0], M[1] - q*w[1])
