            def angle_numeric(p,q,r):
                v1=(p[0]-q[0], p[1]-q[1])
                v2=(r[0]-q[0], r[1]-q[1])
                dot=v1[0]*v2[0]+v1[1]*v2[1]
                n1=math.hypot(v1[0],v1[1])
                n2=math.hypot(v2[0],v2[1])
                if n1*n2==0:
                    return None
                cosang=max(-1,min(1,dot/(n1*n2)))
                return math.degrees(math.acos(cosang))
            
