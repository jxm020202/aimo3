        Below is a short Python script that enumerates all edge‑colourings of a few small cubic graphs (the complete graph K₄ and the triangular prism) and counts those satisfying the “two edges same colour, one different” condition at every vertex.  The script also prints the numbers obtained, which can be used to look for patterns that might help with the icosahedron case.

```python
import itertools

def count_colorings(edges, adj):
    """
    edges : list of (u,v) tuples, each edge appears once
    adj   : dict mapping vertex -> list of incident edge indices
    Returns the number of 3‑colourings of the edges such that
    at every vertex the three incident edges have exactly two of one colour
    and the third a different colour.
    """
    m = len(edges)
    count = 0
    # iterate over all 3^m colourings (m is small for the test graphs)
    for col in itertools.product(range(3), repeat=m):
        ok = True
        for v, inc in adj.items():
            c = [col[i] for i in inc]          # colours of the three incident edges
            # condition: exactly two equal, one different
            if not ( (c[0]==c[1]!=c[2]) or
                     (c[0]==c[2]!=c[1]) or
                     (c[1]==c[2]!=c[0]) ):
                ok = False
                break
        if ok:
            count += 1
    return count

# ---- K4 (complete graph on 4 vertices) ----
# vertices 0..3, edges 0-1,0-2,0-3,1-2,1-3,2-3
K4_edges = [(0,1),(0,2),(0,3),(1,2),(1,3),(2,3)]
K4_adj = {v: [] for v in range(4)}
for idx,(u,v) in enumerate(K4_edges):
    K4_adj[u].append(idx)
    K4_adj[v].append(idx)

print("K4:", count_colorings(K4_edges, K4_adj))   # should be small enough to compute quickly

# ---- Triangular prism (6 vertices, 9 edges) ----
# vertices: top triangle 0,1,2 ; bottom triangle 3,4,5 ; vertical edges (0,3),(1,4),(2,5)
prism_edges = [(0,1),(1,2),(2,0),   # top triangle
               (3,4),(4,5),(5,3),   # bottom triangle
               (0,3),(1,4),(2,5)]   # vertical edges
prism_adj = {v: [] for v in range(6)}
for idx,(u,v) in enumerate(prism_edges):
    prism_adj[u].append(idx)
    prism_adj[v].append(idx)

print("Triangular prism:", count_colorings(prism_edges, prism_adj))
```

