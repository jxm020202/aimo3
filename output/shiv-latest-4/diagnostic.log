            def face_possible(colors):
                # colors list length 3 with -1 for unassigned
                # returns True if there exists assignment to -1 making exactly two same, one different.
                # brute over possibilities of -1 values (max 3^2=9)
                # colors values 0,1,2
                # if all assigned, just check condition.
                # else try all combos.
                # Use recursion simple.
                vals = [0,1,2]
                # generate all completions
                def helper(i, cur):
                    if i==3:
                        a,b,c = cur
                        # check condition
                        # exactly two equal
                        if a==b==c:
                            return False
                        # count equal pairs
                        # condition: there exists a color appearing twice, another appearing once.
                        # Equivalent: len(set([a,b,c]))==2
                        return len({a,b,c})==2
                    if colors[i]!=-1:
                        cur.append(colors[i])
                        return helper(i+1, cur)
                    else:
                        for v in vals:
                            cur.append(v)
                            if helper(i+1, cur):
                                return True
                            cur.pop()
                        return False
                return helper(0, [])
            
