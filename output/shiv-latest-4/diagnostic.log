            import sympy as sp
            def integer_nullspace(B):
                M = sp.Matrix(B)
                null = M.nullspace()
                # each vector rational; convert to integer by lcm of denominators
                int_basis = []
                for v in null:
                    lcm = sp.ilcm(*[sp.denom(x) for x in v])
                    int_vec = [int(x*lcm) for x in v]
                    int_basis.append(sp.Matrix(int_vec))
