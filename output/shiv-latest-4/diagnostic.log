            from scipy.optimize import LinearConstraint, milp, Bounds
            import numpy as np, scipy.sparse as sp
            
            def find_feasible_milp():
                n_edges = len(edges)
                n_vertices = G.number_of_nodes()
                n_vars = n_edges*3
                total_vars = n_vars + n_vertices*3*2  # x + M + N
                # objective zero
                c = np.zeros(total_vars)
                
                # list of constraints
                constraints = []
                # edge color sum =1
                for e_idx in range(n_edges):
                    coeff = np.zeros(total_vars)
                    for c_idx in range(3):
                        coeff[e_idx*3 + c_idx] = 1
                    constraints.append(LinearConstraint(coeff, 1, 1))
                # y = 2M + 1N
                for v in range(n_vertices):
                    inc_edges = list(G.edges(v))
                    inc_edge_idxs = [edge_index[e] for e in inc_edges]
                    for col in range(3):
                        coeff = np.zeros(total_vars)
                        for e_idx in inc_edge_idxs:
                            coeff[e_idx*3 + col] = 1
                        M_idx = n_vars + v*3 + col
                        N_idx = n_vars + n_vertices*3 + v*3 + col
                        coeff[M_idx] = -2
                        coeff[N_idx] = -1
                        constraints.append(LinearConstraint(coeff, 0, 0))
                # sum M =1 per vertex
                for v in range(n_vertices):
                    coeff = np.zeros(total_vars)
                    for col in range(3):
                        coeff[n_vars + v*3 + col] = 1
                    constraints.append(LinearConstraint(coeff, 1, 1))
                # sum N =1 per vertex
                for v in range(n_vertices):
                    coeff = np.zeros(total_vars)
                    for col in range(3):
                        coeff[n_vars + n_vertices*3 + v*3 + col] = 1
                    constraints.append(LinearConstraint(coeff, 1, 1))
                # M+N <=1 per v,col
                for v in range(n_vertices):
                    for col in range(3):
                        coeff = np.zeros(total_vars)
                        coeff[n_vars + v*3 + col] = 1
                        coeff[n_vars + n_vertices*3 + v*3 + col] = 1
                        constraints.append(LinearConstraint(coeff, -np.inf, 1))
                # variable bounds: binary 0-1
                bounds = Bounds(0, 1)
                integrality = np.ones(total_vars, dtype=int)
                # Solve
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            start = time.time()
            res = find_feasible_milp()
            print("Success:", res.success, "time", time.time()-start)
            
