            import math, random, itertools, sys, numpy as np
            
            def angle_between(v1, v2):
                dot = v1[0]*v2[0]+v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                return math.degrees(math.acos(max(-1,min(1,dot/(norm1*norm2)))))
            
            def compute(theta, phi):
                # points
                F = np.array([0.0,0.0])
                G = np.array([1.0,0.0])
                H = np.array([1+math.cos(theta), math.sin(theta)])
                I = H + np.array([math.cos(phi), math.sin(phi)])
                # direction FH
                FH = H - F
                # ray from F making 30 deg with FH (counterclockwise direction? need both possibilities)
                # We'll compute unit direction of FH, then rotate by +/-30 deg.
                def rotate(v, deg):
                    rad = math.radians(deg)
                    c,s = math.cos(rad), math.sin(rad)
                    return np.array([c*v[0]-s*v[1], s*v[0]+c*v[1]])
                # two possible rays
                dir1 = rotate(FH/np.linalg.norm(FH), 30)
                dir2 = rotate(FH/np.linalg.norm(FH), -30)
                # direction IG
                IG = G - I
                dirI1 = rotate(IG/np.linalg.norm(IG), 30)
                dirI2 = rotate(IG/np.linalg.norm(IG), -30)
                # Intersection of lines F + t*dirF and I + s*dirI
                solutions = []
                for dF in [dir1, dir2]:
                    for dI in [dirI1, dirI2]:
                        # solve F + t dF = I + s dI
                        A = np.column_stack((dF, -dI))  # 2x2
                        b = I - F
                        try:
                            t_s = np.linalg.solve(A, b)
                        except np.linalg.LinAlgError:
                            continue
                        t, s = t_s
                        if t>=0 and s>=0:  # rays forward
                            J = F + t*dF
                            # compute convexity maybe later
                            solutions.append(J)
                return F,G,H,I,solutions
            
            def angle_GJH(F,G,J,H):
                # angle at J between JG and JH
                v1 = G - J
                v2 = H - J
                return angle_between(v1, v2)
            
            def is_convex_polygon(points):
                # points ordered list
                n = len(points)
                sign = None
                for i in range(n):
                    a = np.array(points[i])
                    b = np.array(points[(i+1)%n])
                    c = np.array(points[(i+2)%n])
                    cross = np.cross(b-a, c-b)
                    if cross==0:
                        continue
                    cur = cross>0
                    if sign is None:
                        sign = cur
                    elif sign!=cur:
                        return False
                return True
            
            def test_random(samples=2000):
                angles = []
                for _ in range(samples):
                    theta = random.uniform(0.1, math.pi-0.1)  # avoid degenerate
                    phi = random.uniform(0.1, math.pi-0.1)
                    F,G,H,I,Js = compute(theta, phi)
                    for J in Js:
                        # check convex pentagon order F,G,H,I,J
                        pts = [F,G,H,I,J]
                        if not is_convex_polygon(pts):
                            continue
                        # also need angle JF H =30 (by construction) and GIJ=30 (by construction)
                        # compute angle GJH
                        ang = angle_GJH(F,G,J,H)
                        angles.append(ang)
                return angles
            
            angles = test_random(2000)
            len(angles)
            
