                # recursion with copying domains
                def backtrack(domains):
                    # check for empty domain
                    for v, dom in domains.items():
                        if not dom:
                            return 0
                    # if all assigned (size 1)
                    if all(len(dom)==1 for dom in domains.values()):
                        return 1
                    # select vertex with smallest domain >1
                    v = min((v for v in G.nodes() if len(domains[v])>1), key=lambda x: len(domains[x]))
                    total = 0
                    for val in list(domains[v]):
                        # copy domains
                        new_domains = {u: set(domains[u]) for u in domains}
                        # assign v=val
                        new_domains[v] = {val}
                        # propagate constraints via queue
                        queue = [(v, val)]
                        consistent = True
                        while queue and consistent:
