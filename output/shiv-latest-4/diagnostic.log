            def triangle_angles(p, q, r):
                # returns angles at p,q,r in triangle pqr
                # angle at p = angle q-p-r
                def angle_at(a,b,c):
                    v1 = b - a
                    v2 = c - a
                    dot = np.dot(v1,v2)
                    n1 = np.linalg.norm(v1)
                    n2 = np.linalg.norm(v2)
                    cosang = dot/(n1*n2)
                    cosang = max(-1.0, min(1.0, cosang))
                    return math.degrees(math.acos(cosang))
                A = angle_at(p,q,r)
                B = angle_at(q,p,r)
                C = angle_at(r,p,q)
                return A,B,C
            
