            import networkx as nx, itertools, time, math
            
            G = nx.dodecahedral_graph()
            edges = list(G.edges())
            edge_index = {}
            for i,(u,v) in enumerate(edges):
                edge_index[(u,v)] = i
                edge_index[(v,u)] = i
            
            # enumerate 2-factors
            def enumerate_2factors():
                results = []
                n_edges = len(edges)
                def recurse(idx, deg, selected):
                    if idx == n_edges:
                        if all(d==2 for d in deg.values()):
                            results.append(set(selected))
                        return
                    # prune bound
                    remaining_needed = sum(2 - d for d in deg.values())
                    if remaining_needed > 2*(n_edges - idx):
                        return
                    u,v = edges[idx]
                    # include if possible
                    if deg[u] < 2 and deg[v] < 2:
                        deg[u] +=1
                        deg[v] +=1
                        selected.append(idx)
                        recurse(idx+1, deg, selected)
                        selected.pop()
                        deg[u] -=1
                        deg[v] -=1
                    # exclude
                    recurse(idx+1, deg, selected)
                recurse(0, {v:0 for v in G.nodes()}, [])
                return results
            
            two_factors = enumerate_2factors()
            print("num 2-factors:", len(two_factors))
            
            # mapping for P/O indices
            index = {}
            cnt=0
            for v in G.nodes():
                index[(v,0)] = cnt; cnt+=1
                index[(v,1)] = cnt; cnt+=1
            Nnodes = cnt
            
            class UF:
                def __init__(self,N):
                    self.parent=list(range(N))
                    self.rank=[0]*N
                    self.components=N
                def find(self,x):
                    while self.parent[x]!=x:
                        x=self.parent[x]
                    return x
                def union(self,x,y):
                    x=self.find(x); y=self.find(y)
                    if x==y: return
                    if self.rank[x]<self.rank[y]:
                        x,y=y,x
                    self.parent[y]=x
                    if self.rank[x]==self.rank[y]:
                        self.rank[x]+=1
                    self.components-=1
            
            def odd_neighbors_from_factor(factor_set):
                odd={}
                for v in G.nodes():
                    for nb in G.neighbors(v):
                        idx=edge_index[(v,nb)]
                        if idx not in factor_set:
                            odd[v]=nb
                            break
                return odd
            
            def component_count_for_factor(factor_set):
                odd = odd_neighbors_from_factor(factor_set)
                uf = UF(Nnodes)
                for u,v in G.edges():
                    a_uv = 1 if odd[u]==v else 0
                    a_vu = 1 if odd[v]==u else 0
                    if a_uv==0 and a_vu==0:
                        uf.union(index[(u,0)], index[(v,0)])  # P-P
                    elif a_uv==1 and a_vu==1:
                        uf.union(index[(u,1)], index[(v,1)])  # O-O
                    elif a_uv==1 and a_vu==0:
                        uf.union(index[(u,1)], index[(v,0)])  # O-P
                    else:
                        uf.union(index[(u,0)], index[(v,1)])  # P-O
                return uf.components
            
            mod=1000
            pow3=[1]
            for i in range(1,41):
                pow3.append((pow3[-1]*3)%mod)
            
            total_mod=0
            dist={}
            for fset in two_factors:
                c=component_count_for_factor(fset)
                dist[c]=dist.get(c,0)+1
                total_mod=(total_mod+pow3[c])%mod
            print("component distribution:", dist)
            print("total sum mod 1000:", total_mod)
            
