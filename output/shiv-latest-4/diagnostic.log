            def find_theta_for_phi(phi):
                # find roots of F(phi,theta) in [0,2π)
                roots=[]
                # sample intervals
                thetas = np.linspace(0, 2*math.pi, 1001)
                vals = [F(phi, th) for th in thetas]
                for i in range(len(thetas)-1):
                    if vals[i]==0:
                        roots.append(thetas[i])
                    elif vals[i]*vals[i+1] < 0:
                        # bracket root, use bisection
