            import random, math, cmath, itertools, sys, numpy as np, math, sympy as sp
            def angle(p,q,r):
                # angle pqr (at q) between qp and qr
                v1 = np.array(p)-np.array(q)
                v2 = np.array(r)-np.array(q)
                dot = np.dot(v1,v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                if norm==0: return 0
                cosang = dot/norm
                # clamp
                cosang = max(-1,min(1,cosang))
                return math.degrees(math.acos(cosang))
            
            def compute_angle(W,X,Y,Z):
                # compute intersection M of WY and XZ
                # solve linear equations
                W = np.array(W); X=np.array(X); Y=np.array(Y); Z=np.array(Z)
                # param t for WY: W + t*(Y-W)
                # param s for XZ: X + s*(Z-X)
                A = np.column_stack((Y-W, -(Z-X)))  # W + t*(Y-W) = X + s*(Z-X) => t*(Y-W) - s*(Z-X) = X-W
                b = X - W
                try:
                    t,s = np.linalg.solve(A,b)
                except np.linalg.LinAlgError:
                    return None
                M = W + t*(Y-W)
                # N: perp bisector of WX (vertical line x = (W_x+X_x)/2) intersect perp bisector of YZ
                mid_WX = (W+X)/2
                # line1: x = mid_WX[0]
                # line2: perp bisector of YZ
                mid_YZ = (Y+Z)/2
                # direction vector of YZ
                dYZ = Z - Y
                # perpendicular direction vector
                perp = np.array([-dYZ[1], dYZ[0]])  # rotate 90 deg
                # param u: N = mid_YZ + u*perp
                # need x coordinate = mid_WX[0]
                if perp[0]==0:
                    # line vertical, cannot intersect unless same x
                    return None
                u = (mid_WX[0] - mid_YZ[0]) / perp[0]
                N = mid_YZ + u*perp
                # O: intersection of perp bisectors of XY and WZ
                mid_XY = (X+Y)/2
                dXY = Y - X
                perpXY = np.array([-dXY[1], dXY[0]])
                mid_WZ = (W+Z)/2
                dWZ = Z - W
                perpWZ = np.array([-dWZ[1], dWZ[0]])
                # solve mid_XY + a*perpXY = mid_WZ + b*perpWZ
                A2 = np.column_stack((perpXY, -perpWZ))
                b2 = mid_WZ - mid_XY
                try:
                    a,b = np.linalg.solve(A2,b2)
                except np.linalg.LinAlgError:
                    return None
                O = mid_XY + a*perpXY
                # compute angle NMO at M
                ang = angle(N, M, O)
                return ang
            
            def random_quad():
