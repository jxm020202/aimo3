            import numpy as np
            # map vertices to indices
            verts = list(G.nodes())
            v_index = {v:i for i,v in enumerate(verts)}
            m = len(verts)
            e_list = edges
            e_index = {e:i for i,e in enumerate(e_list)}
            p = len(e_list)
            
            # variables order: x0..x_{m-1}, y0..y_{p-1}
            num_vars = m + p
            
            # Objective: maximize sum x_i
            c = np.zeros(num_vars)
            c[:m] = -1  # milp minimizes, so use -1 to maximize
            
            # Constraints list
            A = []
            lb = []
            ub = []
            
            # (1) For each vertex: sum incident y = x
            for v in verts:
                row = np.zeros(num_vars)
                row[v_index[v]] = -1  # -x_v
                # incident edges
                for e in G.edges(v):
                    ei = e_index[tuple(sorted(e))]
                    row[m + ei] = 1
                A.append(row)
                lb.append(0)
                ub.append(0)
            
            # (2) For each edge: y_e >= x_u + x_v -1  => -x_u -x_v + y_e >= -1
            for e in e_list:
                u,v = e
                row = np.zeros(num_vars)
                row[v_index[u]] = -1
                row[v_index[v]] = -1
                row[m + e_index[e]] = 1
                A.append(row)
                lb.append(-1)
                ub.append(np.inf)
            
            A = np.array(A)
            lb = np.array(lb)
            ub = np.array(ub)
            
            # bounds for variables: binary 0-1
            bounds = Bounds(0,1)
            
            # Use milp
            res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=np.ones(num_vars))
            print(res.success)
            
