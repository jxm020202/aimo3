            def max_colors_ilp_time(n, K, time_limit=30):
                import time, numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                num_cells = n*n
                blocks = []
                for i in range(n-1):
                    for j in range(n-1):
                        blocks.append([i*n+j, i*n+j+1, (i+1)*n+j, (i+1)*n+j+1])
                B=len(blocks)
                total_vars = num_cells*K + K + B*K
                c = np.zeros(total_vars)
                y_offset = num_cells*K
                c[y_offset:y_offset+K] = -1
                A_rows=[]; lb=[]; ub=[]
                # each cell exactly one color
                for i in range(num_cells):
                    row=np.zeros(total_vars)
                    row[i*K:(i+1)*K]=1
                    A_rows.append(row); lb.append(1); ub.append(1)
                # x <= y
                for i in range(num_cells):
                    for col in range(K):
                        row=np.zeros(total_vars)
                        row[i*K+col]=1
                        row[y_offset+col]=-1
                        A_rows.append(row); lb.append(-np.inf); ub.append(0)
                # y <= sum x
                for col in range(K):
                    row=np.zeros(total_vars)
                    row[y_offset+col]=1
                    row[col:num_cells*K:K] = -1  # subtract each x_i,col
                    A_rows.append(row); lb.append(-np.inf); ub.append(0)
                # block constraints
                z_offset = num_cells*K + K
                for b_idx, block in enumerate(blocks):
                    for col in range(K):
                        # -s + 2*z <=0
                        row=np.zeros(total_vars)
                        for cell in block:
                            row[cell*K+col] = -1
                        row[z_offset + b_idx*K + col] = 2
                        A_rows.append(row); lb.append(-np.inf); ub.append(0)
                        # s -3*z <=1
                        row2=np.zeros(total_vars)
                        for cell in block:
                            row2[cell*K+col]=1
                        row2[z_offset + b_idx*K + col] = -3
                        A_rows.append(row2); lb.append(-np.inf); ub.append(1)
                # each block sum z >=1
                for b_idx in range(B):
                    row=np.zeros(total_vars)
                    row[z_offset + b_idx*K : z_offset + (b_idx+1)*K] = 1
                    A_rows.append(row); lb.append(1); ub.append(np.inf)
                A=np.array(A_rows); lb=np.array(lb); ub=np.array(ub)
                bounds=Bounds(0,1)
                integrality=np.ones(total_vars,dtype=int)
                res=milp(c=c, constraints=LinearConstraint(A,lb,ub), bounds=bounds, integrality=integrality, options={'time_limit': time_limit})
                if not res.success:
                    print("no success", res.message)
                    return None
                y_vals=res.x[y_offset:y_offset+K]
                used=int(round(sum(y_vals)))
                return used
            
            print(max_colors_ilp_time(5,15, time_limit=20))
            
