            def degree_minpoly(n):
                M=sp.symbols('M')
                expr=sp.expand((M-1)*sp.chebyshevu(n, M/2) - sp.chebyshevu(n-1, M/2))
                # factor rationally
                fac=sp.factor(expr)
                # get degree after removing factor (M-1) if present
                if fac.is_Mul:
                    # multiply out? just compute degree of expr minus 1 if (M-1) factor
                    if fac.has(M-1):
                        deg=sp.degree(expr) - 1
                    else:
                        deg=sp.degree(expr)
                else:
