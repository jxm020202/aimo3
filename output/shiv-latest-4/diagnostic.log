            def gray_code(n):
                # standard binary reflected Gray code list of integers 0..2^n-1
                res=[0]
                for i in range(n):
                    res += [x + (1<<i) for x in reversed(res)]
                return res
            
            def reverse_bits(x,n):
                rev=0
                for i in range(n):
                    if x>>i &1:
                        rev |= 1<<(n-1-i)
                return rev
            
            def reversed_gray_path(n):
                g=gray_code(n)
                # map each vertex via bit reversal
                return [reverse_bits(v,n) for v in g]
            
