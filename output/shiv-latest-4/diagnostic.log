            def angle_between(v1, v2):
                # returns angle in radians between vectors
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                n1 = math.hypot(v1[0], v1[1])
                n2 = math.hypot(v2[0], v2[1])
                return math.acos(max(-1,min(1,dot/(n1*n2))))
            
            def polygon_area(points):
                area = 0
                n=len(points)
                for i in range(n):
                    x1,y1 = points[i]
                    x2,y2 = points[(i+1)%n]
                    area += x1*y2 - x2*y1
