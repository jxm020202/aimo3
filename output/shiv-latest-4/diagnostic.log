            from scipy.optimize import milp, LinearConstraint, Bounds
            n=10
            num=n*n
            def idx(i,j): return i*n+j
            neighbors = [[] for _ in range(num)]
            for i in range(n):
                for j in range(n):
                    v=idx(i,j)
                    for di in (-1,0,1):
                        for dj in (-1,0,1):
                            if di==0 and dj==0: continue
                            ni, nj = i+di, j+dj
                            if 0<=ni<n and 0<=nj<n:
                                neighbors[v].append(idx(ni,nj))
            # Build A matrix
            A = np.zeros((num, num), dtype=int)
            for v in range(num):
                for u in neighbors[v]:
                    A[v,u]=1
                A[v,v] = -1
            b = np.zeros(num)
            lincon = LinearConstraint(A, b, b)  # equality
            c = -np.ones(num)  # minimize -sum
            bounds = Bounds(0,1)
            integrality = np.ones(num, dtype=int)
