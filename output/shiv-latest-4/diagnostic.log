            import numpy as np, mpmath as mp, time, math
            mp.mp.dps = 80
            
            def f_float(M):
                x = M
                for i in range(1,2025):
                    x = M - 1/x
                return x - 1/(M-1)
            
            def find_brackets(a,b,step):
                xs = np.arange(a, b+step, step)
                vals = [f_float(x) for x in xs]
                brackets = []
                for i in range(len(xs)-1):
                    if vals[i]==0: continue
                    if vals[i]*vals[i+1] < 0:
                        brackets.append((xs[i], xs[i+1]))
                return brackets
            
            def f_mp(M):
                x = M
                for i in range(1,2025):
                    x = M - 1/x
                return x - 1/(M-1)
            
            def root_bisect(a,b,eps=mp.mpf('1e-30')):
                a_mp = mp.mpf(a)
                b_mp = mp.mpf(b)
                fa = f_mp(a_mp)
                fb = f_mp(b_mp)
                if fa*fb > 0:
                    return None
                while b_mp - a_mp > eps:
                    m = (a_mp + b_mp) / 2
                    fm = f_mp(m)
                    if fa*fm <= 0:
                        b_mp = m
                        fb = fm
                    else:
                        a_mp = m
                        fa = fm
                return (a_mp + b_mp) / 2
            
            def sequence_positive_mp(M):
                x = M
                for i in range(1,2025):
                    x = M - 1/x
                    if x <= 0:
                        return False
                return True
            
            def find_min_positive_root(step=0.005):
                brackets = find_brackets(1.001, 3.0, step)
                for a,b in brackets:
                    root = root_bisect(a,b)
                    if root is None:
                        continue
                    if sequence_positive_mp(root):
                        return root, (a,b)
                return None, None
            
            start = time.time()
            root, interval = find_min_positive_root(0.005)
            print("root:", root, "interval:", interval)
            print("time:", time.time()-start)
            
