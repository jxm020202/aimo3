            def rational_roots_candidates(n):
                from math import isqrt
                # compute polynomial coefficients list from highest degree n-1 down to 0
                coeffs=[]
                from math import comb
                for power in range(n-1, -1, -1):
                    # power = n-2j-1 => j = (n-1-power)/2 must be integer >=0
                    j = (n-1-power)//2
                    if (n-1-power) %2==0 and j>=0:
                        coeff = comb(n, 2*j+1) * (2**j)
                    else:
                        coeff = 0
                    coeffs.append(coeff)
                # polynomial f(p) = sum coeff_i * p^{power} - 1
                # constant term adjust:
                coeffs[-1] -= 1
                # leading coeff is coeffs[0]
                lead = coeffs[0]
                const = coeffs[-1]
                # candidates a/b where a|const, b|lead
                cand=set()
                for a in range(-abs(const),abs(const)+1):
                    if a==0: continue
                    if const % a ==0:
                        for b in range(1,abs(lead)+1):
                            if lead % b ==0:
                                cand.add(Fraction(a,b))
                                cand.add(Fraction(-a,b))
                # also include zero if constant term zero? not here.
                return cand, coeffs
            
            def find_all_n(limit_n=12):
                sols=[]
                for n in range(2,limit_n+1):
                    cand, coeffs = rational_roots_candidates(n)
                    for p in cand:
                        # evaluate polynomial
                        val=Fraction(0,1)
                        for i,coeff in enumerate(coeffs):
                            power = n-1 - i
                            val += coeff * (p**power)
                        if val==0:
                            # compute y
                            A,_=compute_A_B(p,n)
                            sols.append((n,p,A))
                return sols
            
