            import random, math
            def random_point():
                # random direction uniform on sphere
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v-1)
                r = math.sqrt(3)
                x = r*math.sin(phi)*math.cos(theta)
                y = r*math.sin(phi)*math.sin(theta)
                z = r*math.cos(phi)
                return x,y,z
            
            def check(pt):
                x,y,z=pt
                return abs(x*y**3 + y*z**3 + z*x**3 - 3) < 1e-6
            
