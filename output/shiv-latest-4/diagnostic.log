        def reconstruct_solution(target, coin_vals, coin_costs):
    dp=[INF]*(target+1)
    dp[0]=0
    prev=[None]*(target+1)
    for amt in range(1,target+1):
        for val,cost in zip(coin_vals, coin_costs):
            if val<=amt and dp[amt-val]+cost < dp[amt]:
                dp[amt]=dp[amt-val]+cost
                prev[amt]=(val,cost)
    # reconstruct
    amt=target
    counts={}
    while amt>0:
        val,cost = prev[amt]
        counts[val]=counts.get(val,0)+1
        amt-=val
    return dp[target], counts

