            def angle_sym(A,B,C):
                BA = sp.Matrix([A.x-B.x, A.y-B.y])
                BC = sp.Matrix([C.x-B.x, C.y-B.y])
                dot = BA.dot(BC)
                cross = sp.det(sp.Matrix([[BA[0], BA[1]],[BC[0], BC[1]]]))
                # use atan2
                return sp.atan2(sp.sqrt(cross**2), dot)  # returns angle 0..pi
            
