            import math, itertools, random, sys, numpy as np, sympy as sp, mpmath as mp
            
            def feasible(M, n):
                # attempt to find positive x_i satisfying constraints with equality maybe
                # We'll try to propagate using recurrence: set x1 = M (optimal)
                # Then compute x_{i+1} = M - 1/x_i, ensure positivity.
                x = M
                for i in range(1, n):
                    # compute next
                    if M - 1/x <= 0:
                        return False
                    x = M - 1/x
                # after n steps we have x_n = x
                # final condition: 1/x + 1 <= M
                return 1/x + 1 <= M + 1e-12  # tolerance
            
            def minimal_M(n):
                lo = 1.0
                hi = 5.0
                for _ in range(60):
                    mid = (lo+hi)/2
                    if feasible(mid, n):
                        hi = mid
                    else:
                        lo = mid
                return hi
            
            for n in range(1,6):
                print(n, minimal_M(n))
            
