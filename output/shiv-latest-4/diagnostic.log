            import random, copy, math, time, itertools, sys, collections, functools, collections
            
            def random_coloring(n, colors):
                # assign each cell random color from 1..colors
                board=[[random.randint(1,colors) for _ in range(n)] for _ in range(n)]
                return board
            
            def violates(board):
                n=len(board)
                for i in range(n-1):
                    for j in range(n-1):
                        s={board[i][j],board[i+1][j],board[i][j+1],board[i+1][j+1]}
                        if len(s)==4:
                            return (i,j)
                return None
            
            def hill_climb(n, max_colors, iterations=10000):
                board=random_coloring(n, max_colors)
                for it in range(iterations):
                    viol=violates(board)
                    if not viol:
                        return board
                    i,j=viol
                    # pick one of the four cells to recolor to reduce violation
                    cells=[(i,j),(i+1,j),(i,j+1),(i+1,j+1)]
                    # try assign a color that already appears among them
                    colors=set()
                    for (x,y) in cells:
                        colors.add(board[x][y])
                    # try new color from existing set to create repeat
                    # pick a cell and set its color to another cell's color
                    a,b=random.choice(cells), random.choice(cells)
                    board[a[0]][a[1]]=board[b[0]][b[1]]
                return None
            
