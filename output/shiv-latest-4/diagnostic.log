            # We'll compute exact rational representation using Fraction.
            # Represent r as symbolic root? We'll use recurrence with integer coefficients.
            # Represent vector as tuple of integers (a,b,c) for coefficient of 1, r, r^2.
            def power_vectors(n):
                # base: r^0 = 1 => (1,0,0)
                # r^1 = r => (0,1,0)
                # r^2 = r^2 => (0,0,1)
                vecs = [(1,0,0),(0,1,0),(0,0,1)]
                for i in range(3, n+1):
                    # r^{i} = 10 r^{i-3} - r^{i-1} - r^{i-2}
                    a3,b3,c3 = vecs[i-3]
                    a1,b1,c1 = vecs[i-1]
                    a2,b2,c2 = vecs[i-2]
                    ai = (10*a3 - a1 - a2,
                          10*b3 - b1 - b2,
                          10*c3 - c1 - c2)
                    vecs.append(ai)
                return vecs
            
            vecs = power_vectors(13)
            vecs
            
