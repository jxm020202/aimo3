            def is_convex_polygon(points):
                # points list in order, assume polygon simple
                n = len(points)
                # compute cross product z for each consecutive edge pair
                sign = None
                for i in range(n):
                    p0 = points[i]
                    p1 = points[(i+1)%n]
                    p2 = points[(i+2)%n]
                    # vectors p0->p1 and p1->p2
                    v1 = (p1[0]-p0[0], p1[1]-p0[1])
                    v2 = (p2[0]-p1[0], p2[1]-p1[1])
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    if cross == 0:
                        continue
                    cur_sign = cross > 0
                    if sign is None:
                        sign = cur_sign
                    elif sign != cur_sign:
                        return False
                return True
            
