            import sympy as sp, math, random, itertools, sys, numpy as np
            
            def compute_angle_GJH(phi_val, psi_val):
                # define symbols
                phi, psi, x, y = sp.symbols('phi psi x y', real=True)
                cos30 = sp.sqrt(3)/2
                # coordinates
                xH = 1 + sp.cos(phi)
                yH = sp.sin(phi)
                xI = 1 + sp.cos(phi) + sp.cos(psi)
                yI = sp.sin(phi) + sp.sin(psi)
                FH = sp.Matrix([xH, yH])
                FJ = sp.Matrix([x, y])
                IG = sp.Matrix([1 - xI, -yI])
                IJ = sp.Matrix([x - xI, y - yI])
                eq1 = FH.dot(FJ) - cos30*sp.sqrt(FH.dot(FH))*sp.sqrt(FJ.dot(FJ))
                eq2 = IG.dot(IJ) - cos30*sp.sqrt(IG.dot(IG))*sp.sqrt(IJ.dot(IJ))
                # numeric solve
                eqs = [eq1.subs({phi:phi_val, psi:psi_val}), eq2.subs({phi:phi_val, psi:psi_val})]
                # try several initial guesses
                guesses = [(0.5,0.5),(0.5,-0.5),(2,0.5),(2,-0.5),(-0.5,0.5),(-0.5,-0.5),(1,1),(1,-1),(-1,1),(-1,-1),(3,0),(0,3)]
                sol = None
                for g in guesses:
                    try:
                        s = sp.nsolve(eqs, [x, y], g, tol=1e-14, maxsteps=100, prec=30)
                        sol_candidate = (float(s[0]), float(s[1]))
                        # deduplicate
                        if sol is None or math.hypot(sol_candidate[0]-sol[0], sol_candidate[1]-sol[1])>1e-6:
                            sol = sol_candidate
                            # break after first? keep first
                            break
                    except Exception:
                        continue
                if sol is None:
                    return None
                # convex check
                F = (0.0,0.0)
                G = (1.0,0.0)
                H = (1+math.cos(phi_val), math.sin(phi_val))
                I = (1+math.cos(phi_val)+math.cos(psi_val), math.sin(phi_val)+math.sin(psi_val))
                J = sol
                # convex orientation check
                def convex_check(pts):
                    sign = None
                    n = len(pts)
                    for i in range(n):
                        p0 = pts[i]
                        p1 = pts[(i+1)%n]
                        p2 = pts[(i+2)%n]
                        v1 = (p1[0]-p0[0], p1[1]-p0[1])
                        v2 = (p2[0]-p1[0], p2[1]-p1[1])
                        cross = v1[0]*v2[1] - v1[1]*v2[0]
                        if abs(cross) < 1e-9:
                            continue
                        if sign is None:
                            sign = cross > 0
                        else:
                            if (cross > 0) != sign:
                                return False
                    return True
                if not convex_check([F,G,H,I,J]):
                    return None
                # compute angle GJH
                JG = (G[0]-J[0], G[1]-J[1])
                JH = (H[0]-J[0], H[1]-J[1])
                dot = JG[0]*JH[0] + JG[1]*JH[1]
                ang = math.degrees(math.acos(max(-1,min(1, dot/(math.hypot(*JG)*math.hypot(*JH))))))
                return ang
            
            # test
            print(compute_angle_GJH(math.radians(60), math.radians(60)))
            
