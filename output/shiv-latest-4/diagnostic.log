            from collections import defaultdict
            
            class UnionFind:
                def __init__(self, n):
                    self.parent = list(range(n))
                    self.rank = [0]*n
                def find(self, x):
                    while self.parent[x]!=x:
                        self.parent[x]=self.parent[self.parent[x]]
                        x=self.parent[x]
                    return x
                def union(self, x, y):
                    xr=self.find(x); yr=self.find(y)
                    if xr==yr: return
                    if self.rank[xr]<self.rank[yr]:
                        self.parent[xr]=yr
                    elif self.rank[xr]>self.rank[yr]:
                        self.parent[yr]=xr
                    else:
                        self.parent[yr]=xr
                        self.rank[xr]+=1
                def copy(self):
                    uf=UnionFind(0)
                    uf.parent=self.parent[:]
                    uf.rank=self.rank[:]
