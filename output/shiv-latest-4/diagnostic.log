            def is_convex_polygon(points):
                # points list in order
                n = len(points)
                # compute cross product sign for each consecutive triple
                sign = None
                for i in range(n):
                    p0 = np.array(points[i])
                    p1 = np.array(points[(i+1)%n])
                    p2 = np.array(points[(i+2)%n])
                    v1 = p1-p0
                    v2 = p2-p1
                    cross = np.cross(v1, v2)  # scalar in 2D
                    if cross == 0:
                        continue
                    cur_sign = np.sign(cross)
                    if sign is None:
                        sign = cur_sign
                    elif cur_sign != sign:
                        return False
                return True
            
