            def minimal_poly_M(n):
                M=sp.symbols('M')
                a = a_seq_list(n)
                a_n = a[n]
                a_nm1 = a[n-1]
                a_nm2 = a[n-2] if n>=2 else sp.Integer(1) # for n=1, a_{-1} not used
