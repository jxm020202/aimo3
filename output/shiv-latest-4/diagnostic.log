            def M_polynomial(N):
                t=sp.symbols('t')
                # Build recurrence
                x = t
                for i in range(1, N-1):  # we need to generate up to x_{N-1}
                    x = t - 1/x
                # final condition: 1/x + 1 = t => 1/x = t-1 => x = 1/(t-1)
                eq = sp.simplify(x - 1/(t-1))
                # bring to numerator
                num = sp.together(eq).as_numer_denom()[0]
                return sp.expand(num)
            
            for N in range(2,6):
                poly = M_polynomial(N)
                print(N, poly)
            
