            def compute_all(theta, phi):
                F = np.array([0.0,0.0])
                G = np.array([1.0,0.0])
                H = np.array([1+math.cos(theta), math.sin(theta)])
                I = H + np.array([math.cos(phi), math.sin(phi)])
                FH = H - F
                IG = G - I
                def rotate(v, deg):
                    rad = math.radians(deg)
                    c,s = math.cos(rad), math.sin(rad)
                    return np.array([c*v[0]-s*v[1], s*v[0]+c*v[1]])
                dirFs = [rotate(FH/np.linalg.norm(FH), 30), rotate(FH/np.linalg.norm(FH), -30)]
                dirIs = [rotate(IG/np.linalg.norm(IG), 30), rotate(IG/np.linalg.norm(IG), -30)]
                solutions = []
                for dF in dirFs:
                    for dI in dirIs:
                        A = np.column_stack((dF, -dI))
                        b = I - F
                        if abs(np.linalg.det(A))<1e-9:
                            continue
                        t_s = np.linalg.solve(A,b)
                        t,s = t_s
                        J = F + t*dF
                        solutions.append((J,t,s))
                return F,G,H,I,solutions
            
            def test_random_all(samples=2000):
                angles=set()
                for _ in range(samples):
                    theta = random.uniform(0, 2*math.pi)
                    phi = random.uniform(0, 2*math.pi)
                    F,G,H,I,sols = compute_all(theta, phi)
                    for J,t,s in sols:
                        pts = [F,G,H,I,J]
                        if not is_convex_polygon(pts):
                            continue
                        ang = round(angle_GJH(F,G,J,H),6)
                        angles.add(ang)
                return sorted(angles)
            
