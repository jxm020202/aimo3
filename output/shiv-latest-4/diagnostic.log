            def angle_between(v1, v2):
                # returns angle in radians between vectors
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                # clamp
                cosang = max(-1,min(1,dot/(norm1*norm2)))
                return math.acos(cosang)
            
            def compute_angle_GJH(phi_val, psi_val):
                sol = solve_J(phi_val, psi_val)
                if sol is None:
                    return None
                xj, yj = sol
                # points
                G = (1.0, 0.0)
                H = (1+math.cos(phi_val), math.sin(phi_val))
                # vectors
                JG = (G[0]-xj, G[1]-yj)
                JH = (H[0]-xj, H[1]-yj)
                ang = angle_between(JG, JH)
                return math.degrees(ang)
            
