            S = sp.Point(7*sp.cos(theta), 7*sp.sin(theta))
            R = sp.Point(xR, yR)
            
            # midpoint M of QR
            M_mid = sp.Point((2 + xR)/2, (0 + yR)/2)
            
            # direction of angle bisector at P
            u_PQ = sp.Matrix([1,0])  # unit
            u_PS = sp.Matrix([sp.cos(theta), sp.sin(theta)])  # already unit because length 7 but direction unit is cos, sin
            vP = u_PQ + u_PS
            M_on_Pbis = sp.Point(t*vP[0], t*vP[1])
            
            # direction of bisector at S
            u_SP = sp.Matrix([-sp.cos(theta), -sp.sin(theta)])  # unit
            # vector SR
            vec_SR = sp.Matrix([xR - 7*sp.cos(theta), yR - 7*sp.sin(theta)])
            # length constraint
