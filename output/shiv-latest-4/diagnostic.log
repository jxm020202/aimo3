            import heapq
            
            def merges_until_condition(N):
                total = N
                heap = [1]*N
                heapq.heapify(heap)
                steps = 0
                while True:
                    # check condition
                    max_val = max(heap)
                    if max_val > total/2:
                        return steps, len(heap)
                    # merge two smallest
                    a = heapq.heappop(heap)
                    b = heapq.heappop(heap)
                    heapq.heappush(heap, a+b)
                    steps += 1
            
