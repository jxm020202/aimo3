            def max_a_n(N, max_val=30):
                # brute force search for sequences up to length N, maximizing a_N
                best = 0
                best_seq = None
                # We'll generate recursively.
                seq = [None]*(N+1)  # 1-indexed
                seq[1]=1
                def check(k,n):
                    # check condition for given n and all k up to current length - n +1
                    for start in range(1, k-n+2):
                        s=sum(seq[start:start+n])
                        if s % seq[n]!=0:
                            return False
                    return True
                # Actually we need to ensure condition holds for all n up to current length for all applicable k.
                def valid_up_to(curr):
                    # verify all conditions for n <= curr where there is at least one block
                    for n in range(1,curr+1):
                        for k in range(1, curr - n +2):
                            s=sum(seq[k:k+n])
                            if s % seq[n]!=0:
                                return False
                    return True
                best=0
                best_seq=None
                def dfs(pos):
                    nonlocal best,best_seq
                    if pos> N:
                        if seq[N]>best:
                            best=seq[N]
                            best_seq=seq[1:].copy()
                        return
                    # try values for a_pos from 1 to max_val
                    for val in range(1, max_val+1):
                        seq[pos]=val
                        if valid_up_to(pos):
                            dfs(pos+1)
                    seq[pos]=None
                dfs(2)
                return best,best_seq
            
