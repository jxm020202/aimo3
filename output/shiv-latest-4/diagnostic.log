            import random, itertools, math
            
            def random_configuration(n):
                # generate random signs for edges
                # We'll construct f via BFS: start at (0,0) with value 0
                f = [[None]*n for _ in range(n)]
                f[0][0]=0
                # assign random signs for right and down edges
                # we will fill using BFS
                from collections import deque
                q=deque([(0,0)])
                while q:
                    i,j = q.popleft()
                    val = f[i][j]
                    # right neighbor
                    if j+1<n and f[i][j+1] is None:
                        sign = random.choice([1,-1])
                        f[i][j+1]=val+sign
                        q.append((i,j+1))
                    # down neighbor
                    if i+1<n and f[i+1][j] is None:
                        sign = random.choice([1,-1])
                        f[i+1][j]=val+sign
                        q.append((i+1,j))
                # shift to make all nonnegative
                minv = min(min(row) for row in f)
                if minv<0:
                    shift = -minv
                    for i in range(n):
                        for j in range(n):
                            f[i][j]+=shift
                total = sum(sum(row) for row in f)
                return total, f
            
            def reachable_sums(n, trials=20000):
                s=set()
                for _ in range(trials):
                    total,_=random_configuration(n)
                    s.add(total)
                return s
            
            for n in range(2,6):
