            import math, itertools, collections
            
            def compute_angle_GJH(alpha, beta, eps1, eps2):
                # points
                F = (0.0, 0.0)
                G = (1.0, 0.0)
                H = (1+math.cos(alpha), math.sin(alpha))
                I = (1+math.cos(alpha)+math.cos(beta), math.sin(alpha)+math.sin(beta))
                # angles
                theta_H = math.atan2(H[1], H[0])  # angle of FH
                phi = theta_H + eps1*math.pi/6  # direction of J from F
                # vector IG
                IG = (G[0]-I[0], G[1]-I[1])
                theta_IG = math.atan2(IG[1], IG[0])
                psi = theta_IG + eps2*math.pi/6  # direction of J from I
                
                # solve for r,s
                cos_phi, sin_phi = math.cos(phi), math.sin(phi)
                cos_psi, sin_psi = math.cos(psi), math.sin(psi)
                D = sin_psi - sin_phi*0  # placeholder
            
                # determinant sin(psi-phi)
                D = math.sin(psi - phi)
                if abs(D) < 1e-9:
                    return None
                # compute r, s using formulas derived
                # r = (-I_x sin ψ + I_y cos ψ)/D
                r = (-I[0]*sin_psi + I[1]*cos_psi)/D
                # s = (cos φ * I_y - sin φ * I_x)/D
                s = (cos_phi * I[1] - sin_phi * I[0])/D
                if r <= 0 or s <= 0:
                    return None
                J = (r*cos_phi, r*sin_phi)
                # compute convexity orientation signs
                # cross products
                def cross(a,b):
                    return a[0]*b[1]-a[1]*b[0]
                # edges
                v1 = (G[0]-F[0], G[1]-F[1])
                v2 = (H[0]-G[0], H[1]-G[1])
                v3 = (I[0]-H[0], I[1]-H[1])
                v4 = (J[0]-I[0], J[1]-I[1])
                v5 = (F[0]-J[0], F[1]-J[1])
                # orientation should be consistent (all cross >0 for CCW)
                cross_vals = [cross(v1,v2), cross(v2,v3), cross(v3,v4), cross(v4,v5), cross(v5,v1)]
                if not all(c>1e-6 for c in cross_vals):
                    return None
                # compute angle GJH
                JG = (G[0]-J[0], G[1]-J[1])
                JH = (H[0]-J[0], H[1]-J[1])
                dot = JG[0]*JH[0]+JG[1]*JH[1]
                normJG = math.hypot(*JG)
                normJH = math.hypot(*JH)
                if normJG*normJH == 0:
                    return None
                cos_angle = dot/(normJG*normJH)
                # clamp
                cos_angle = max(-1,min(1,cos_angle))
                angle = math.degrees(math.acos(cos_angle))
                return angle
            
