            import random, math
            
            def min_max_k(k):
                # k variables x1..xk
                # terms: x1, 1/x1 + x2, ..., 1/x_{k-1}+x_k, 1/x_k + 1
                # We'll use simple gradient-free random search to approximate minimal max.
                best=1e9
                bestM=None
                for _ in range(20000):
                    xs=[10**random.uniform(-2,2) for _ in range(k)]
                    terms=[xs[0]]
                    for i in range(k-1):
                        terms.append(1/xs[i]+xs[i+1])
                    terms.append(1/xs[-1]+1)
                    M=max(terms)
                    if M<best:
                        best=M
                        bestM=M
                return bestM
            
            for k in range(2,6):
                print(k, min_max_k(k))
            
