            def is_convex(F,G,H,I,J):
                # Check polygon F->G->H->I->J convex (counterclockwise)
                pts = [F,G,H,I,J]
                # compute cross product sign for each consecutive edge
                n = len(pts)
                signs = []
                for i in range(n):
                    a = pts[i]
                    b = pts[(i+1)%n]
                    c = pts[(i+2)%n]
                    # vectors ab, bc
                    ab = (b[0]-a[0], b[1]-a[1])
                    bc = (c[0]-b[0], c[1]-b[1])
                    cross = ab[0]*bc[1] - ab[1]*bc[0]
                    signs.append(cross)
                # convex if all cross have same sign (positive for CCW)
                # allow small tolerance
                pos = [c for c in signs if c > 1e-6]
