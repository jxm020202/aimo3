                    t = a*b/(b**2 + c**2) + ( -1 if branch==0 else 1)*math.sqrt((( -a*c + (b**2 + c**2)*s)*(a*c + (b**2 + c**2)*s)))/(b**2 + c**2)
                    if not (0 < t < 1):
                        continue
                    ang = angle_NMO(a,b,c,s,branch)
                    if ang is not None:
