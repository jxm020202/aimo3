            def minimal_poly_M(n):
                M=sp.symbols('M')
                # compute numerator polynomial for equation
                p = [sp.Integer(0), sp.Integer(1)]
                for k in range(2, n+2):
                    p.append(M*p[-1] - p[-2])
                pn = p[n+1]
                pn_minus1 = p[n]
                pn_minus2 = p[n-1]
                expr = sp.together((pn*M - pn_minus1)/(pn_minus1*M - pn_minus2) - 1/(M-1))
                num = sp.factor(expr.as_numer_denom()[0])
                # remove factor (M-1) if present
                num = sp.simplify(num)
                # factor out (M-1) if present
                if sp.gcd(num, M-1) != 1:
                    num = sp.simplify(num/(M-1))
                # also factor out any extraneous factors that correspond to smaller n? Hard.
                # Let's just factor fully and see degree
                fac = sp.factor(num)
                return fac, sp.degree(num, M)
            
            for n in range(1,7):
                fac, deg = minimal_poly_M(n)
                print(n, deg, fac)
            
