            def construct_grid_rule(n):
                # 1-indexed logic
                grid=[[None]*n for _ in range(n)]
                # assign distinct colors to first row and first column
                cur=0
                for j in range(n):
                    grid[0][j]=cur; cur+=1
                for i in range(1,n):
                    grid[i][0]=cur; cur+=1
                # assign distinct colors to second row (i=1) except first column
                for j in range(1,n):
                    grid[1][j]=cur; cur+=1
                # assign distinct colors to second column (j=1) except first two rows
                for i in range(2,n):
                    grid[i][1]=cur; cur+=1
                # make (1,1) same as (0,0) to reduce one color
                grid[1][1]=grid[0][0]
