            def feasible_a_range(r):
                B = 3*r**2 -8*r +3
                # solve u*(B - r**2*u) >=1, with 0<u<B/r**2
                # quadratic: -r**2 u**2 + B u -1 >=0
                a = -r**2
                b = B
                c = -1
                # solve equality
                disc = b**2 - 4*a*c
                if disc < 0:
                    return None
                sqrtD = math.sqrt(disc)
                u1 = (-b - sqrtD)/(2*a)
                u2 = (-b + sqrtD)/(2*a)
                # because a negative, interval where quadratic >=0 is between roots
                lower = min(u1,u2)
                upper = max(u1,u2)
                # intersect with (0, B/r**2)
                lo = max(lower, 0)
                hi = min(upper, B/r**2)
                return lo, hi
            
            for r in [3,4,5,6,10]:
                print(r, feasible_a_range(r))
            
