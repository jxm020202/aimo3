            def max_kings():
                n=10
                G=nx.Graph()
                # add nodes as (i,j)
                for i in range(n):
                    for j in range(n):
                        G.add_node((i,j))
                # edges if king move (max(|dx|,|dy|)=1 and not same)
                for i in range(n):
                    for j in range(n):
                        for di in [-1,0,1]:
                            for dj in [-1,0,1]:
