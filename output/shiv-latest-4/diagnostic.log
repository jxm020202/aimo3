                    if deg[u] <2 and deg[v] <2:
                        deg_inc = deg.copy()
                        deg_inc[u] +=1
                        deg_inc[v] +=1
                        selected.append(idx)
                        recurse(idx+1, deg_inc, selected)
                        selected.pop()
                    # exclude
                    recurse(idx+1, deg, selected)
                recurse(0, {v:0 for v in G.nodes()}, [])
