        ```python
import math

def perp_bisector_intersection(A,B,C,D):
    mx1 = (A[0]+B[0])/2
    my1 = (A[1]+B[1])/2
    dx1 = B[0]-A[0]
    dy1 = B[1]-A[1]
    px1, py1 = -dy1, dx1
    mx2 = (C[0]+D[0])/2
    my2 = (C[1]+D[1])/2
    dx2 = D[0]-C[0]
    dy2 = D[1]-C[1]
    px2, py2 = -dy2, dx2
    det = px1*(-py2) - (-px2)*py1
    t1 = ((mx2-mx1)*(-py2) - (my2-my1)*(-px2)) / det
    ix = mx1 + t1*px1
    iy = my1 + t1*py1
    return (ix, iy)

def angle_between(v1,v2):
    dot = v1[0]*v2[0] + v1[1]*v2[1]
    n1 = math.hypot(v1[0],v1[1])
    n2 = math.hypot(v2[0],v2[1])
    return math.degrees(math.acos(dot/(n1*n2)))

def compute_angle(theta):
    L = 2.0
    W = (-L/2, 0)
    Y = ( L/2, 0)
    X = ( (L/2)*math.cos(theta), (L/2)*math.sin(theta) )
    Z = (-(L/2)*math.cos(theta), -(L/2)*math.sin(theta))
    N = perp_bisector_intersection(W,X,Y,Z)
    O = perp_bisector_intersection(X,Y,W,Z)
    return angle_between(N, O)

for deg in [20,30,45,60,80,100]:
    print(deg, compute_angle(math.radians(deg)))
