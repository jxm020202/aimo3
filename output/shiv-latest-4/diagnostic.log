            def is_pow2_5(n):
                # check if n is of form 2^i *5^j with i,j >=0
                i=j=0
                while n%2==0:
                    n//=2
                    i+=1
                while n%5==0:
                    n//=5
                    j+=1
                return n==1, i, j
            
