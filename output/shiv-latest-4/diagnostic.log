            def build_path(n, start=0):
                # returns list of vertices (integers) for n-dim hypercube covering all 2^n vertices,
                # starting at start (which should be 0 for top level)
                if n==0:
                    return [0]
                # subcube even (bit0=0)
                sub_even = build_path(n-1)  # vertices of size 2^{n-1} with bits 1..n-1
                # map to original by shifting left 1 (add 0 LSB)
                even_mapped = [v<<1 for v in sub_even]
                # entry point for odd subcube is even_mapped[-1] + 1
                entry = even_mapped[-1] + 1
                # odd subcube path starting at entry: we can take build_path(n-1) and map with LSB=1
                sub_odd = build_path(n-1)
                odd_mapped = [(v<<1) | 1 for v in sub_odd]
                # need to rotate odd_mapped so that it starts with entry
                # find index of entry in odd_mapped
                idx = odd_mapped.index(entry)
                odd_ordered = odd_mapped[idx:] + odd_mapped[:idx]
