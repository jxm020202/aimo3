            def poly_shift(poly):
                # multiply by t: shift coefficients up by 1
                return [0]+poly
            
            def poly_sub(a,b):
                # a - b
                n = max(len(a), len(b))
                res = [0]*n
                for i in range(len(a)):
                    res[i] += a[i]
                for i in range(len(b)):
                    res[i] -= b[i]
                # trim
                while len(res)>0 and res[-1]==0:
                    res.pop()
                return res
            
            def poly_mul_scalar(poly, scalar):
                return [c*scalar for c in poly]
            
            def compute_degree(N):
                steps = N-2
                P = [0,1]  # t
                Q = [1]    # 1
                for _ in range(steps):
                    newP = poly_sub(poly_shift(poly_mul_scalar(P,1)), Q)  # t*P - Q
                    newQ = P[:]  # P
                    P, Q = newP, newQ
                # compute R = (t-1)*P - Q = t*P - P - Q
                R = poly_sub(poly_sub(poly_shift(P), P), Q)
                return len(R)-1  # degree
            
            for N in range(2,11):
                print(N, compute_degree(N))
            
