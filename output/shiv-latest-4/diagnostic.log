            def equality_components(G, orient):
                # nodes are (v, 'P') and (v, 'O')
                parent = {}
                def find(x):
                    while parent[x]!=x:
                        parent[x]=parent[parent[x]]
                        x=parent[x]
                    return x
                def union(x,y):
                    rx, ry = find(x), find(y)
                    if rx!=ry:
                        parent[ry]=rx
                # init
                for v in G.nodes():
                    parent[(v,'P')] = (v,'P')
                    parent[(v,'O')] = (v,'O')
                # for each edge uv, add equality edge based on orientation
                for u,v in G.edges():
                    a_uv = 1 if orient[u]==v else 0
                    a_vu = 1 if orient[v]==u else 0
                    if a_uv==0 and a_vu==0:
                        # pair for both: connect P_u with P_v
                        union((u,'P'), (v,'P'))
                    elif a_uv==1 and a_vu==1:
                        # odd for both: connect O_u with O_v
                        union((u,'O'), (v,'O'))
                    elif a_uv==1 and a_vu==0:
                        # odd u, pair v: connect O_u with P_v
                        union((u,'O'), (v,'P'))
                    elif a_uv==0 and a_vu==1:
                        union((u,'P'), (v,'O'))
                # count components
                comps = {}
                for node in parent:
                    root = find(node)
                    comps.setdefault(root, []).append(node)
                return comps
            
