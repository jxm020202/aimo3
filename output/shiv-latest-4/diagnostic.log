            import sympy as sp
            M = sp.symbols('M')
            def U(n):
                # compute polynomial using recurrence
                if n==0:
                    return sp.Integer(1)
                if n==1:
                    return M
                u0 = sp.Integer(1)
                u1 = M
                for k in range(2, n+1):
                    u2 = M*u1 - u0
                    u0, u1 = u1, u2
                return u1
            
            def poly_eq(N):
                UN = U(N)
                UN1 = U(N-1)
                UN2 = U(N-2)
                expr = UN*M**2 - (UN + 2*UN1)*M + (UN1 + UN2)
                return sp.expand(expr)
            
            for N in range(2,6):
                print(N, sp.degree(poly_eq(N), M))
                # factor maybe
                print(sp.factor(poly_eq(N)))
            
