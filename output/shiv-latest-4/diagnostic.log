            def cycles_from_matching(matching):
                # matching is list of pairs (v,u)
                matched_edges = set()
                for a,b in matching:
                    matched_edges.add(tuple(sorted((a,b))))
                # build graph of remaining edges
                rem_edges = [e for e in G.edges() if tuple(sorted(e)) not in matched_edges]
                # compute connected components (cycles) in rem graph
                H = nx.Graph()
                H.add_nodes_from(G.nodes())
                H.add_edges_from(rem_edges)
                comps = list(nx.connected_components(H))
                # each component should be a cycle
                return comps, rem_edges
            
            def adjacency_graph_H(comps, matching):
                # map vertex to component index
                comp_index = {}
                for idx,comp in enumerate(comps):
                    for v in comp:
                        comp_index[v]=idx
                # build graph where vertices are components
                Hc = nx.Graph()
                Hc.add_nodes_from(range(len(comps)))
                for a,b in matching:
                    ca = comp_index[a]
                    cb = comp_index[b]
                    if ca==cb:
                        # shouldn't happen
                        pass
                    else:
                        Hc.add_edge(ca,cb)
                return Hc
            
            def count_colorings_graph(Gc):
                # count proper 3-colorings
                n = Gc.number_of_nodes()
                colors = [None]*n
