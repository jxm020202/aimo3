            def minimal_degree_n(n):
                M=sp.symbols('M')
                # compute p sequence up to n+1
                p = [sp.Integer(0), sp.Integer(1)]
                for k in range(2, n+2):
                    p.append(M*p[-1] - p[-2])
                pn = p[n+1]
                pn_minus1 = p[n]
                pn_minus2 = p[n-1]
                # polynomial equation numerator
                expr = (pn*M - pn_minus1)/(pn_minus1*M - pn_minus2) - 1/(M-1)
                num = sp.together(expr).as_numer_denom()[0]
                # factor out (M-1) if present
                num = sp.simplify(num)
                # minimal polynomial for M is num after removing factor (M-1) if any
                # compute degree
                degM = sp.degree(num, M)
                # Now compute polynomial for x using substitution M = (x**2 + 1)/x
                x = sp.symbols('x')
                M_expr = (x**2 + 1)/x
                poly_x = sp.together(num.subs(M, M_expr))
                numx = sp.simplify(poly_x.as_numer_denom()[0])
                # multiply by appropriate denominator to clear fractions: denominator is x**degM maybe
                degx = sp.degree(numx, x)
                return degM, degx
            
