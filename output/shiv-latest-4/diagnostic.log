            import mpmath as mp
            
            mp.mp.dps = 80
            
            def pos(M):
                x = M
                for i in range(2025):
                    x = M - 1/x
                    if x <= 0:
                        return False
                return True
            
            def h_val(M):
                x = M
                for i in range(2025):
                    x = M - 1/x
                return x - 1  # f^{2025}(M) - 1
            
            def feasible(M):
                return pos(M) and h_val(M) >= 0
            
