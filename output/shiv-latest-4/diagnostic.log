            def solve_for_s(alpha, beta, sign):
                v = (1 + math.cos(alpha), math.sin(alpha))
                delta = sign * math.pi/6
                w = rotate(v, delta)
                # define function for angle at I
                H = (1 + math.cos(alpha), math.sin(alpha))
                I = (1 + math.cos(alpha) + math.cos(beta), math.sin(alpha) + math.sin(beta))
                G = (1.0, 0.0)
                def f(s):
                    J = (s*w[0], s*w[1])
                    IG = (G[0] - I[0], G[1] - I[1])
                    IJ = (J[0] - I[0], J[1] - I[1])
                    ang = angle_between(IG, IJ)
                    return ang - math.pi/6
                lo, hi = 1e-6, 1000.0
                f_lo = f(lo)
                f_hi = f(hi)
                if f_lo*f_hi > 0:
                    # try expand hi
                    for hi_candidate in [10,100,1000,1e4]:
                        f_hi = f(hi_candidate)
                        if f_lo*f_hi <= 0:
                            hi = hi_candidate
                            break
                    else:
                        return None
                for _ in range(60):
                    mid = (lo+hi)/2
                    f_mid = f(mid)
                    if f_mid == 0:
