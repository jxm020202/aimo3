            import mpmath as mp
            
            def find_M(n):
                # n variables, terms length n+1
                # recurrence: x1 = M, x_{i+1} = M - 1/x_i for i=1..n-1, final condition 1/x_n + 1 = M
                # So we need after n-1 steps we have x_n, then condition.
                # We'll solve for M > 1 using root find.
                def f(M):
                    x = M
                    for i in range(1, n):
                        x = M - 1/x
                    # after n-1 steps, we have x_n
                    return 1/x + 1 - M
                # find root >1
                # Use mp.findroot with initial guess maybe 2
                try:
                    root = mp.findroot(f, 2)
                except Exception as e:
                    # try other guesses
                    for guess in [1.2,1.5,2,3,5]:
                        try:
                            root = mp.findroot(f, guess)
                            break
                        except: pass
                    else:
                        return None
                return root
            
            for n in range(1,6):
                print(n, find_M(n))
            
