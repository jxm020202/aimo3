            def feasible_n_exact(n, max_val=30):
                N=n*n
                # variables x_i integer 0..max_val
                # binary variables for each edge: count edges
                edges=[]
                for i in range(n):
                    for j in range(n):
                        idx=i*n+j
                        if j+1<n:
                            idx2=i*n+(j+1)
                            edges.append((idx, idx2))
                        if i+1<n:
                            idx2=(i+1)*n+j
                            edges.append((idx, idx2))
                E=len(edges)
                total_vars = N + E  # first N are x, next E are b
                bounds = opt.Bounds([0]*total_vars, [max_val]*N + [1]*E)
                c = np.zeros(total_vars)
                rows=[]
                lower=[]
                upper=[]
                # edge constraints: x_i - x_j = 1 - 2*b
                for e_idx,(i_idx,j_idx) in enumerate(edges):
                    row = np.zeros(total_vars)
                    row[i_idx]=1
                    row[j_idx]=-1
                    row[N+e_idx]=2  # coefficient of b
                    rows.append(row); lower.append(1); upper.append(1)  # equality to 1
                # sum constraint
                row = np.zeros(total_vars)
                row[:N]=1
                rows.append(row); lower.append(471); upper.append(471)
                A = np.vstack(rows)
                lc = opt.LinearConstraint(A, lower, upper)
                integrality = np.ones(total_vars, dtype=int)
                res = opt.milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False, 'time_limit':20})
                return res.success, res
            
            for n in range(1,6):
                ok,_=feasible_n_exact(n, max_val=20)
                print(n, ok)
            
