            def subset_sum_target(weights, target):
                # simple DP using set of reachable sums
                reachable = {0: []}
                for w in weights:
                    new = {}
                    for s, path in list(reachable.items()):
                        ns = s + w
                        if ns <= target and ns not in reachable and ns not in new:
