                # points
                G = (0.0,0.0)
                H = (1.0,0.0)
                F = (math.cos(th), math.sin(th))
                I = (1 - math.cos(ph), math.sin(ph))
                # vectors
                IG = (G[0]-I[0], G[1]-I[1])
                FH = (H[0]-F[0], H[1]-F[1])
                # possible rotations
                dirs = []
                for deg1 in [30, -30]:
                    for deg2 in [30, -30]:
                        d1 = rotate(IG, deg1)
                        d2 = rotate(FH, deg2)
                        # solve I + t*d1 = F + s*d2
                        # two equations
                        a1,b1 = d1
                        a2,b2 = d2
                        # solve for t,s
                        det = a1*(-b2) - (-a2)*b1  # actually matrix [[a1,-a2],[b1,-b2]]
                        det = a1*(-b2) - (-a2)*b1
                        # better solve linear system
                        # I + t*d1 = F + s*d2 => t*d1 - s*d2 = F - I
                        # [d1, -d2] * [t,s]^T = F - I
                        import numpy as np
                        M = np.array([[a1, -a2],[b1, -b2]], dtype=float)
                        rhs = np.array([F[0]-I[0], F[1]-I[1]])
                        if abs(np.linalg.det(M))<1e-8:
