            def cross(o, a, b):
                # cross product of OA x OB (z component)
                return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
            
            def is_convex_polygon(points):
                # points list in order
                n = len(points)
                # compute cross signs
                signs = []
                for i in range(n):
                    o = points[i]
                    a = points[(i+1)%n]
                    b = points[(i+2)%n]
                    cp = cross(o,a,b)
                    signs.append(cp)
                # all should be same sign (positive for CCW)
                # allow small tolerance for near zero
                pos = [s for s in signs if s > 1e-8]
                neg = [s for s in signs if s < -1e-8]
                return (len(pos)==len(signs)) or (len(neg)==len(signs))
            
            def check_configuration(theta_val, phi_val):
                # compute points
                F = np.array([0.0,0.0])
                G = np.array([1.0,0.0])
                H = np.array([1.0 + math.cos(theta_val), math.sin(theta_val)])
                I = np.array([H[0] + math.cos(theta_val+phi_val), H[1] + math.sin(theta_val+phi_val)])
                # solve J
                ang, J = compute_angle(theta_val, phi_val)
                if J is None:
