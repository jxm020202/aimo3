            def sieve_spf(n):
                spf=list(range(n+1))
                for i in range(2,int(n**0.5)+1):
                    if spf[i]==i:
                        for j in range(i*i,n+1,i):
                            if spf[j]==j:
                                spf[j]=i
                return spf
            
            N=2000000
