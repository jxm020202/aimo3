            import math, itertools, numpy as np
            
            def compute_J_candidates(A, B):
                G = np.array([0.0, 0.0])
                F = np.array([1.0, 0.0])
                H = np.array([math.cos(math.radians(A)), math.sin(math.radians(A))])
                I = np.array([math.cos(math.radians(A)) - math.cos(math.radians(A+B)),
                             math.sin(math.radians(A)) - math.sin(math.radians(A+B))])
                # chord FH
                P = F; Q = H
                c1 = np.linalg.norm(Q-P)
                M1 = (P+Q)/2
                v1 = Q-P
                perp1 = np.array([-v1[1], v1[0]])  # length = c1
                O1 = M1 + (math.sqrt(3)/2) * perp1
                # chord GI
                P2 = G; Q2 = I
                c2 = np.linalg.norm(Q2-P2)
                M2 = (P2+Q2)/2
                v2 = Q2-P2
                perp2 = np.array([-v2[1], v2[0]])  # length = c2
                O2 = M2 + (math.sqrt(3)/2) * perp2
                R1 = c1; R2 = c2
                d = np.linalg.norm(O2-O1)
                if d > R1+R2+1e-9 or d < abs(R1-R2)-1e-9:
                    return []
                a = (R1**2 - R2**2 + d**2) / (2*d)
                h_sq = R1**2 - a**2
                if h_sq < -1e-9:
                    return []
                h = math.sqrt(max(h_sq,0.0))
                P3 = O1 + a*(O2-O1)/d
                offset = h * np.array([-(O2[1]-O1[1])/d, (O2[0]-O1[0])/d])
                J1 = P3 + offset
                J2 = P3 - offset
                return [J1, J2]
            
            def angle_between(v1, v2):
                dot = np.dot(v1, v2)
                n1 = np.linalg.norm(v1)
                n2 = np.linalg.norm(v2)
                if n1*n2 == 0:
                    return None
                cosang = dot/(n1*n2)
                cosang = max(min(cosang,1),-1)
                return math.degrees(math.acos(cosang))
            
            def is_convex(F,G,H,I,J):
                pts = [F,G,H,I,J]
                n = len(pts)
                sign = None
                for i in range(n):
                    p0 = np.array(pts[i])
                    p1 = np.array(pts[(i+1)%n])
                    p2 = np.array(pts[(i+2)%n])
                    v1 = p1-p0
                    v2 = p2-p1
                    cross = np.cross(v1, v2)
                    if abs(cross) < 1e-8:
                        return False
                    s = np.sign(cross)
                    if sign is None:
                        sign = s
                    elif s != sign:
                        return False
                return True
            
            def compute_angle_GJH(F,G,H,J):
                return angle_between(G-J, H-J)
            
