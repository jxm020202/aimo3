            def condition_v1_theory(u):
                # compute using derived conditions
                if u%2==1: # odd
                    if u%8==1:
                        return True
                    if u%8==5:
                        return False
                    # u%4==3 case
                    t = (u+1)//4
                    # odd part of t
                    while t%2==0:
                        t//=2
                    return t%4==3
                else:
                    # even
                    # find a = v2(u)
