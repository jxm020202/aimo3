            def rank_mod3(rows):
                # rows: list of numpy arrays length 30 with entries 0/1
                # Gaussian elimination mod 3
                m = len(rows)
                if m==0:
                    return 0
                A = [row.copy() for row in rows]  # list of lists
                rank = 0
                col = 0
                while col < 30 and rank < m:
                    # find pivot row with non-zero in this column
                    pivot = None
                    for i in range(rank, m):
                        if A[i][col] % 3 != 0:
                            pivot = i
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap
                    A[rank], A[pivot] = A[pivot], A[rank]
                    # normalize pivot to 1 (multiply by inverse mod3)
                    inv = {1:1, 2:2}[A[rank][col] % 3]  # since 2*2=1 mod3
                    if inv != 1:
                        A[rank] = (A[rank] * inv) % 3
                    # eliminate other rows
                    for i in range(m):
                        if i != rank and A[i][col] % 3 != 0:
                            factor = A[i][col] % 3
                            A[i] = (A[i] - factor * A[rank]) % 3
                    rank += 1
                    col += 1
                return rank
            
            # test rank of full matrix
            full_rows = [M[i] for i in range(20)]
            print(rank_mod3(full_rows))
            
