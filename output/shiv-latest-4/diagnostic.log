            import sympy as sp, math, random, itertools, sys, numpy as np
            
            # define symbols
            theta, xi, yi, xj, yj = sp.symbols('theta xi yi xj yj', real=True)
            
            # constants
            cos30 = sp.sqrt(3)/2
            
            # equations
            eq1 = (xi - sp.cos(theta))**2 + (yi - sp.sin(theta))**2 - 1  # HI=1
            
            # angle GIJ at I
            vecGI = sp.Matrix([-xi, -yi])
            vecIJ = sp.Matrix([xj - xi, yj - yi])
            dot1 = vecGI.dot(vecIJ)
            normGI = sp.sqrt(xi**2 + yi**2)
            normIJ = sp.sqrt((xj - xi)**2 + (yj - yi)**2)
            eq2 = dot1/(normGI*normIJ) - cos30
            
            # angle JFH at F
            vecJF = sp.Matrix([xj - 1, yj])
            vecFH = sp.Matrix([sp.cos(theta)-1, sp.sin(theta)])
            dot2 = vecJF.dot(vecFH)
            normJF = sp.sqrt((xj-1)**2 + yj**2)
            normFH = sp.sqrt((sp.cos(theta)-1)**2 + sp.sin(theta)**2)
            eq3 = dot2/(normJF*normFH) - cos30
            
            eqs = [eq1, eq2, eq3]
            
            def solve_for_theta(val):
                # numeric solve
                sol = sp.nsolve([eq.subs(theta,val) for eq in eqs],
                                [xi, yi, xj, yj],
                                [0.5, 0.5, 0.5, 0.5],
                                tol=1e-14, maxsteps=100)
