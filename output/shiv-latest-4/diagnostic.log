            import random, math, cmath, itertools, sys, numpy as np, math, sympy as sp
            def angle(p,q,r):
                # angle pqr at q
                v1 = np.array(p)-np.array(q)
                v2 = np.array(r)-np.array(q)
                dot = np.dot(v1,v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                if norm==0: return 0
                cos = dot/norm
                cos = max(-1,min(1,cos))
                return math.degrees(math.acos(cos))
            
            def compute_angle():
                # random direction vectors
                theta1 = random.random()*2*math.pi
                theta2 = random.random()*2*math.pi
                d1 = np.array([math.cos(theta1), math.sin(theta1)])
                d2 = np.array([math.cos(theta2), math.sin(theta2)])
                # random scalars for points along each diagonal
                p = random.uniform(-5,5)
                q = random.uniform(-5,5)
                # ensure not equal to avoid zero length
                while abs(p-q)<1e-6:
                    p = random.uniform(-5,5)
                    q = random.uniform(-5,5)
                # length of diagonal1
                L = abs(p - q)
                # choose r,s such that |r - s| = L
                r = random.uniform(-5,5)
                # set s = r +/- L
                if random.random()<0.5:
                    s = r + L
                else:
                    s = r - L
                # points
                W = p*d1
                Y = q*d1
                X = r*d2
                Z = s*d2
                # compute perpendicular bisector intersection N of WX and YZ
                # line defined by two points: we can compute as intersection of two lines each defined by point+direction (perp to segment)
                def perp_bisector(P,Q):
                    mid = (P+Q)/2
                    # direction vector of segment
                    seg = Q-P
                    # perpendicular direction (rotate 90 deg)
                    perp = np.array([-seg[1], seg[0]])
                    return (mid, perp)
                mid_WX, dir_WX = perp_bisector(W,X)
                mid_YZ, dir_YZ = perp_bisector(Y,Z)
                # solve for intersection N: mid_WX + t*dir_WX = mid_YZ + s*dir_YZ
                A = np.column_stack((dir_WX, -dir_YZ))
                b = mid_YZ - mid_WX
                try:
                    t_s = np.linalg.lstsq(A,b,rcond=None)[0]
                except Exception as e:
                    return None
                N = mid_WX + t_s[0]*dir_WX
                # O from bisectors of XY and WZ
                mid_XY, dir_XY = perp_bisector(X,Y)
                mid_WZ, dir_WZ = perp_bisector(W,Z)
                A2 = np.column_stack((dir_XY, -dir_WZ))
                b2 = mid_WZ - mid_XY
                t_s2 = np.linalg.lstsq(A2,b2,rcond=None)[0]
                O = mid_XY + t_s2[0]*dir_XY
                # compute angle NMO at M (origin)
                ang = angle(N, np.array([0.0,0.0]), O)
                return ang
            
            # test many random configurations
