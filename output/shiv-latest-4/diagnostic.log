            def min_fill_elimination_order(G):
                # G is a graph (networkx)
                # copy adjacency dict
                graph = {n: set(G[n]) - {n} for n in G}
                order = []
                while graph:
                    # compute fill-in for each node
                    best_node = None
                    best_fill = None
                    # compute fill-in for each node
                    for node, nbrs in graph.items():
                        # compute number of missing edges among nbrs
                        missing = 0
                        nbrs_list = list(nbrs)
                        for i in range(len(nbrs_list)):
                            u = nbrs_list[i]
                            for j in range(i+1, len(nbrs_list)):
                                v = nbrs_list[j]
                                if v not in graph[u]:
                                    missing += 1
                        if best_fill is None or missing < best_fill:
                            best_fill = missing
                            best_node = node
                            if missing == 0:
                                break
                    # eliminate best_node
                    order.append(best_node)
                    # make its neighbors a clique
                    nbrs = graph[best_node]
                    for u in nbrs:
                        for v in nbrs:
                            if u != v:
                                graph[u].add(v)
                    # remove node
                    for u in nbrs:
                        graph[u].discard(best_node)
                    del graph[best_node]
                return order
            
