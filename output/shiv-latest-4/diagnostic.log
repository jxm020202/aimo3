            def sieve_spf(n):
                spf = list(range(n+1))
                for i in range(2, int(n**0.5)+1):
                    if spf[i]==i:
                        for j in range(i*i, n+1, i):
                            if spf[j]==j:
                                spf[j]=i
                return spf
            
            def factor_using_spf(x, spf):
                fac={}
                while x>1:
                    p=spf[x]
                    cnt=0
                    while x%p==0:
                        x//=p
                        cnt+=1
                    fac[p]=cnt
                return fac
            
            def tau_2k3_fast(k, spf):
                fac = factor_using_spf(k, spf)
                exp2 = fac.get(2,0)*3 + 1
                tau = exp2+1
                for p,e in fac.items():
                    if p==2: continue
                    tau *= (3*e+1)
                return tau
            
