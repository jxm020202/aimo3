            def rank_mod_p(M, p):
                # Gaussian elimination mod p
                M = [row[:] for row in M]
                m = len(M)
                n = len(M[0]) if M else 0
                rank = 0
                row = 0
                for col in range(n):
                    # find pivot
                    pivot = None
                    for r in range(row, m):
                        if M[r][col] % p != 0:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap rows
                    M[row], M[pivot] = M[pivot], M[row]
                    inv = pow(M[row][col] % p, -1, p)
                    # normalize pivot row
                    M[row] = [(val * inv) % p for val in M[row]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and M[r][col] % p != 0:
                            factor = M[r][col] % p
                            M[r] = [ (M[r][c] - factor * M[row][c]) % p for c in range(n) ]
                    row += 1
                    rank += 1
                    if row == m:
                        break
                return rank
            
            rank_mod3 = rank_mod_p(rows, 3)
