            def feasible(M, n=2025):
                if M <= 1:
                    return False
                L = 1/(M-1)  # L_n
                if L >= M:  # need L < M for next step denominator positive
                    return False
                for _ in range(n-1):
                    # compute next lower bound
                    denom = M - L
                    if denom <= 0:
                        return False
                    L = 1/denom
                    if L >= M and _ != n-2:  # if not last maybe still okay? Actually need L < M for next step as well
                        # but after final iteration we just need L <= M, not necessarily < M?
                        pass
                # after loop, L is L1
                return L <= M
            
            def find_min_M(n=2025, low=1.0, high=5.0):
                # binary search
                for _ in range(100):
                    mid = (low+high)/2
                    if feasible(mid, n):
                        high = mid
                    else:
                        low = mid
                return high
            
