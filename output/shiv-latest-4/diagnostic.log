                B = len(blocks)
                # variable ordering: x (num_cells*K), y (K), z (B*K)
                total_vars = num_cells*K + K + B*K
                # objective: maximize sum y_c
                c = np.zeros(total_vars)
                # y variables start at offset num_cells*K
                y_offset = num_cells*K
                for c_idx in range(K):
