            def find_positive_root_bruteforce(n, start=1.01, end=5, steps=10000):
                xs = [start + (end-start)*i/steps for i in range(steps+1)]
                vals = [g(x,n) for x in xs]
                # find sign changes
                roots = []
                for i in range(steps):
                    if vals[i]==0:
                        roots.append(xs[i])
                    elif vals[i]*vals[i+1] < 0:
                        # bracket
                        a,b = xs[i], xs[i+1]
                        # bisection
                        for _ in range(50):
                            m = (a+b)/2
                            if g(a,n)*g(m,n) <= 0:
                                b = m
                            else:
                                a = m
                        roots.append((a+b)/2)
                return roots
            
