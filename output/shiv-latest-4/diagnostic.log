import random, math
def angle(p,q,r):
    # angle pqr
    ux,uy = p[0]-q[0], p[1]-q[1]
    vx,vy = r[0]-q[0], r[1]-q[1]
    dot = ux*vx+uy*vy
    nu = math.hypot(ux,uy)
    nv = math.hypot(vx,vy)
    return math.degrees(math.acos(dot/(nu*nv)))

def test():
    for _ in range(10):
        b = random.uniform(1,5)
        c = random.uniform(-3,3)
        d = random.uniform(1,5)
        # choose e,f so that diagonals are equal:
        # c^2+d^2 = (e-b)^2+f^2  -> pick f, solve for e
        f = random.uniform(-4,4)
        e = b + math.copysign(math.sqrt(c*c+d*d-f*f),1)  # choose sign
        W = (0,0); X = (b,0); Y = (c,d); Z = (e,f)

        # intersection M of WY and XZ
        # solve linear system
        import numpy as np
        A = np.array([[c, -(e-b)],[d,-f]],float)
        bvec = np.array([b,0],float)
        t,s = np.linalg.solve(A,bvec)
        M = (c*t, d*t)

        # N
        xN = b/2
        yN = (d+f)/2 - (b-(c+e))/2 * (e-c)/(f-d)
        N = (xN,yN)

        # O (solve two bisector equations)
        # using sympy would be easier, but we do linear solve directly
        # equations: (x-(b+c)/2)*(c-b)+(y-d/2)*d = 0
        #            (x-e/2)*e + (y-f/2)*f = 0
        A2 = np.array([[c-b, d],[e, f]],float)
        B2 = np.array([ (b+c)/2*(c-b) + d*d/2,
                       e*e/2 + f*f/2 ],float)
        xO,yO = np.linalg.solve(A2,B2)
        O = (xO,yO)

        ang = angle(N,M,O)
        print(round(ang,6))
test()
```

