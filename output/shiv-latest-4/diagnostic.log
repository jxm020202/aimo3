import itertools
import sys
from functools import lru_cache

# Build dodecahedral graph using networkx
import networkx as nx

G = nx.dodecahedral_graph()
# Verify number of vertices and edges
assert G.number_of_nodes() == 20
assert G.number_of_edges() == 30

# Assign an index to each edge
edge_list = list(G.edges())
edge_index = {e: i for i, e in enumerate(edge_list)}
# Since edges are undirected, also map reversed tuple
edge_index.update({(v,u): i for (u,v), i in edge_index.items()})

# Build incidence matrix: rows = vertices, columns = edges
num_vertices = 20
num_edges = 30
A = [[0]*num_edges for _ in range(num_vertices)]
for v in G.nodes():
    for u in G.neighbors(v):
        e_idx = edge_index[(v,u)]
        A[v][e_idx] = 1  # entry 1 (mod 3)

# Helper functions for mod 3 arithmetic
def mod3(x):
    return x % 3

def row_copy(row):
    return [x for x in row]

def rank_mod3(matrix):
    """Return rank of matrix over GF(3). matrix is list of rows (list of ints)."""
    m = [row_copy(r) for r in matrix]
    rows = len(m)
    cols = len(m[0]) if rows else 0
    rank = 0
    col = 0
    while rank < rows and col < cols:
        # find pivot row with non-zero entry in column col
        pivot = None
        for r in range(rank, rows):
            if m[r][col] % 3 != 0:
                pivot = r
                break
        if pivot is None:
            col += 1
            continue
        # swap pivot row into position 'rank'
        m[rank], m[pivot] = m[pivot], m[rank]
        # normalize pivot row to have leading 1
        inv = {1:1, 2:2}[m[rank][col] % 3]  # 2 inverse is 2 because 2*2=4≡1
        if inv != 1:
            for c in range(col, cols):
                m[rank][c] = (m[rank][c] * inv) % 3
        # eliminate column col from other rows
        for r in range(rows):
            if r != rank and m[r][col] % 3 != 0:
                factor = m[r][col] % 3
                for c in range(col, cols):
                    m[r][c] = (m[r][c] - factor * m[rank][c]) % 3
        rank += 1
        col += 1
    return rank

# Compute rank of full matrix
r0 = rank_mod3(A)
