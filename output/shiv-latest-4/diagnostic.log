            def collision_count(selected):
                # compute signatures for all states
                sigs = {}
                coll = 0
                for idx in range(len(states)):
                    t = tuple(int(resp[idx,q]) for q in selected)
                    if t in sigs:
                        coll += 1
                    else:
                        sigs[t]=idx
                return coll
            
            def improve(k, iterations=20000):
                # start with random set
                selected = random.sample(range(nq), k)
                best = selected[:]
                best_coll = collision_count(best)
                if best_coll==0:
                    return best
                for it in range(iterations):
                    # propose swap: replace one query with another not in set
                    i = random.randrange(k)
                    new_q = random.choice([q for q in range(nq) if q not in selected])
                    cand = selected[:]
                    cand[i] = new_q
                    coll = collision_count(cand)
                    if coll < best_coll:
                        best = cand[:]
                        best_coll = coll
                        selected = cand[:]
                        if best_coll == 0:
                            return best
                    # occasionally accept equal?
                return None
            
            for k in range(8,13):
                sol = improve(k, iterations=50000)
                print("k", k, "solution", sol)
            
