            def intersect(F, v1, I, v2):
                # Solve F + t1*v1 = I + t2*v2
                # 2x2 linear system for t1,t2
                # v1*t1 - v2*t2 = I - F
                A = np.array([[v1[0], -v2[0]],
                              [v1[1], -v2[1]]], dtype=float)
                b = np.array([I[0]-F[0], I[1]-F[1]], dtype=float)
                try:
                    t1, t2 = np.linalg.solve(A, b)
                    J = (F[0] + t1*v1[0], F[1] + t1*v1[1])
                    return J, t1, t2
                except np.linalg.LinAlgError:
                    return None, None, None
            
