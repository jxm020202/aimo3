            def coeffs_up_to(n):
                # returns list of (a,b,c) for r^i
                a=[0]*(n+1)
                b=[0]*(n+1)
                c=[0]*(n+1)
                # base
                a[0]=1; b[0]=0; c[0]=0
                a[1]=0; b[1]=1; c[1]=0
                a[2]=0; b[2]=0; c[2]=1
                for i in range(3,n+1):
                    # r^i = 10 r^{i-3} - r^{i-2} - r^{i-1}
                    a[i]=10*a[i-3] - a[i-2] - a[i-1]
                    b[i]=10*b[i-3] - b[i-2] - b[i-1]
                    c[i]=10*c[i-3] - c[i-2] - c[i-1]
                return list(zip(a,b,c))
            
            coeffs = coeffs_up_to(20)
            coeffs[:10]
            
