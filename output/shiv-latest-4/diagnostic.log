            def max_colors(n):
                best = 0
                best_grid = None
                # order cells row-major
                cells = [(i,j) for i in range(n) for j in range(n)]
                # We'll assign colors incrementally, using numbers starting from 0.
                # Keep track of used colors set.
                # Prune: remaining cells count + current distinct <= best -> cannot beat.
                # Also need to enforce 2x2 constraints as soon as a 2x2 is fully assigned.
                N = n
                best = 0
                best_grid = None
                
                # Precompute which 2x2 squares each cell belongs to (list of top-left corners)
                squares = {}
                for i in range(N):
                    for j in range(N):
                        sq = []
                        for ti in (i-1,i):
                            for tj in (j-1,j):
                                if 0 <= ti < N-1 and 0 <= tj < N-1:
                                    sq.append((ti,tj))
                        squares[(i,j)] = sq
                
                grid = [[None]*N for _ in range(N)]
                
                def backtrack(idx, used):
                    nonlocal best, best_grid
                    if idx == N*N:
                        # full assignment
                        cnt = len(used)
                        if cnt > best:
                            best = cnt
                            best_grid = [row[:] for row in grid]
                            #print("New best", best)
                        return
                    # pruning
                    remaining = N*N - idx
                    if len(used) + remaining <= best:
                        return
                    i,j = cells[idx]
                    # try existing colors first maybe to keep distinct low? but we want max distinct, so we also try new color.
                    # order: try new color then existing.
                    # new color
                    new_color = len(used)  # assign next unused integer
