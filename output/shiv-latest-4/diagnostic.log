            def min_steps_to_half(total, n):
                # start multiset of n ones
                start = tuple([1]*n)
                from collections import deque
                seen = {start:0}
                q = deque([start])
                while q:
                    state = q.popleft()
                    steps = seen[state]
                    # check condition
                    maxv = max(state)
                    if maxv > total/2:
