            def exists_coloring(n,k):
                # return True if there exists a coloring of [1..n] with k colors avoiding monochrome a+b=c
                colors = range(k)
                # brute force all assignments? exponential; for small n only
                for assign in itertools.product(colors, repeat=n):
                    ok=True
                    # check all triples a,b,c with a+b=c
                    for a in range(1,n+1):
                        for b in range(1,n+1):
