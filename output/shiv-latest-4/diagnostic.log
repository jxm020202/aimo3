            import math, random, itertools, sys, numpy as np
            
            def angle_between(v1, v2):
                # return angle in radians between vectors v1 and v2 (0 to pi)
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                if norm1==0 or norm2==0:
                    return 0
                cosang = max(-1,min(1,dot/(norm1*norm2)))
                return math.acos(cosang)
            
            def rotate(v, ang):
                c=math.cos(ang); s=math.sin(ang)
                return (c*v[0]-s*v[1], s*v[0]+c*v[1])
            
            def add(p,q):
                return (p[0]+q[0], p[1]+q[1])
            def sub(p,q):
                return (p[0]-q[0], p[1]-q[1])
            
            def cross(o,a,b):
                # cross product of OA x OB
                return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
            
            def is_convex(poly):
                # poly list of points in order
                n=len(poly)
                # compute sign of cross for each consecutive triple
                signs=[]
                for i in range(n):
                    o=poly[i]
                    a=poly[(i+1)%n]
                    b=poly[(i+2)%n]
                    cr=cross(o,a,b)
                    signs.append(cr)
                # convex if all cross have same sign (non-zero) and polygon not self-intersecting
                # allow small tolerance
                # check all same sign
                pos=sum(1 for c in signs if c>1e-6)
                neg=sum(1 for c in signs if c<-1e-6)
                return (pos==0 or neg==0) and all(abs(c)>1e-6 for c in signs)
            
            def compute_J(F,G,H,I):
                # compute J as intersection of two rays:
                # Ray from F making angle 30° with FH (line FH)
                # Ray from I making angle 30° with IG (line IG)
                # There are two possible orientations for each (clockwise or counterclockwise)
                # We'll return both possible intersections (if they exist)
                # Use direction vectors.
                FH = sub(H,F)
                # unit vector of FH
                norm = math.hypot(FH[0], FH[1])
                u_FH = (FH[0]/norm, FH[1]/norm)
                # direction for ray from F: rotate u_FH by +/-30 degrees (but need orientation such that J lies outward)
                # We'll generate both possibilities.
                dirs_F = [rotate(u_FH, math.radians(30)), rotate(u_FH, -math.radians(30))]
                IG = sub(G,I)
                norm2 = math.hypot(IG[0], IG[1])
                u_IG = (IG[0]/norm2, IG[1]/norm2)
                dirs_I = [rotate(u_IG, math.radians(30)), rotate(u_IG, -math.radians(30))]
                # For each combination, solve intersection of lines: F + t*dirF = I + s*dirI
                solutions=[]
                for dF in dirs_F:
                    for dI in dirs_I:
                        # Solve for t,s: F + t dF = I + s dI => t dF - s dI = I - F
                        # 2 equations
                        A = np.array([[dF[0], -dI[0]],[dF[1], -dI[1]]], dtype=float)
                        b = np.array([I[0]-F[0], I[1]-F[1]], dtype=float)
                        # Solve linear system
                        det = np.linalg.det(A)
                        if abs(det) < 1e-9:
                            continue
                        t_s = np.linalg.solve(A,b)
                        t = t_s[0]; s = t_s[1]
                        # Intersection point
                        J = (F[0] + t*dF[0], F[1] + t*dF[1])
                        # Check that t>0 and s>0 (rays forward)
                        if t>1e-6 and s>1e-6:
                            solutions.append((J, dF, dI))
                return solutions
            
            def angle_GJH(J,G,H):
                # angle at J between GJ and HJ
                v1 = sub(G,J)
                v2 = sub(H,J)
                return math.degrees(angle_between(v1,v2))
            
            def generate_random():
                # random parameters for theta and beta
                # ensure convex shape maybe
                theta = random.uniform(0.1, math.pi-0.1) # direction of GH from G
                beta = random.uniform(0.1, math.pi-0.1) # turn at H
                # define points
                F = (0.0,0.0)
                G = (1.0,0.0)
                H = (1+math.cos(theta), math.sin(theta))
                I = (H[0]+math.cos(theta+beta), H[1]+math.sin(theta+beta))
                # compute J possibilities
                sols = compute_J(F,G,H,I)
                # For each solution, check convexity of polygon F,G,H,I,J
                results=[]
                for J,_,_ in sols:
                    poly = [F,G,H,I,J]
                    if is_convex(poly):
                        ang = angle_GJH(J,G,H)
                        results.append(ang)
                return results
            
            # test random sampling
            samples=[]
            for _ in range(2000):
                angs = generate_random()
                if angs:
                    samples.extend(angs)
            len(samples)
            
