            import random, math
            def simulate(n, trials=10000):
                total=0
                for _ in range(trials):
                    board=[1]*n
                    while True:
                        total_sum=sum(board)
                        # check termination
                        if all(x==0 for x in board):
                            total+=len(board)
                            break
                        if any(x> total_sum - x for x in board):
                            total+=len(board)
                            break
                        # choose two smallest
                        board.sort()
                        x=board.pop(0)
                        y=board.pop(0)
                        if random.random()<0.5:
                            new=x+y
                        else:
                            new=abs(x-y)
                        board.append(new)
                    # end while
                return total/trials
            
