            import random, math, cmath, itertools, sys, numpy as np
            
            def angle(p,q,r):
                # angle pqr (at q) between qp and qr
                v1 = np.array(p)-np.array(q)
                v2 = np.array(r)-np.array(q)
                dot = np.dot(v1,v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                if norm==0:
                    return 0
                ang = math.acos(max(-1,min(1,dot/norm)))
                return ang
            
