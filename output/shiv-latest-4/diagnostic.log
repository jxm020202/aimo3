            def max_induced_matching(n=10):
                # build graph
                G=nx.Graph()
                for i in range(n):
                    for j in range(n):
                        G.add_node((i,j))
                for i in range(n):
                    for j in range(n):
                        for di in [-1,0,1]:
                            for dj in [-1,0,1]:
                                if di==0 and dj==0: continue
                                ni=i+di; nj=j+dj
                                if 0<=ni<n and 0<=nj<n:
                                    G.add_edge((i,j),(ni,nj))
                edges=list(G.edges())
                m=len(edges)
                # map edge to index
                e_index={e:i for i,e in enumerate(edges)}
                # Build adjacency between edges: if they share a vertex or any endpoint adjacent
                adj_pairs=[]
                for i in range(m):
                    u1,v1=edges[i]
                    for j in range(i+1,m):
                        u2,v2=edges[j]
                        # if share vertex
                        if len({u1,v1,u2,v2})<4:
                            adj_pairs.append((i,j))
                            continue
                        # check if any endpoint adjacent (king move) i.e., there is edge in G between endpoint of e1 and endpoint of e2
                        # iterate endpoints
                        adjacent=False
                        for a in (u1,v1):
                            for b in (u2,v2):
                                if G.has_edge(a,b):
                                    adjacent=True
                                    break
                            if adjacent: break
                        if adjacent:
                            adj_pairs.append((i,j))
                # MILP variables: z_i binary for each edge
                c = -np.ones(m)  # minimize -sum z => maximize sum
                # constraints: for each vertex, sum incident edges <=1
                A=[]
                lb=[]
                ub=[]
                # vertex constraints
                for v in G.nodes():
                    row=np.zeros(m)
                    for e_idx, (a,b) in enumerate(edges):
                        if v==a or v==b:
                            row[e_idx]=1
                    A.append(row); lb.append(-np.inf); ub.append(1)
                # adjacency constraints
                for (i,j) in adj_pairs:
                    row=np.zeros(m)
                    row[i]=1; row[j]=1
                    A.append(row); lb.append(-np.inf); ub.append(1)
                A=np.array(A); lb=np.array(lb); ub=np.array(ub)
                bounds=Bounds(0,1)
                res=milp(c=c, constraints=LinearConstraint(A,lb,ub), bounds=bounds, integrality=np.ones(m))
                if not res.success:
                    print("no success")
                    return None
                z=res.x
                selected_edges=[edges[i] for i in range(m) if round(z[i])==1]
                return selected_edges
            
            selected = max_induced_matching(10)
            len(selected)
            
