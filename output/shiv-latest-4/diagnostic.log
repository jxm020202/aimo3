            from fractions import Fraction
            
            # compute coefficients for r^i expressed as a + b r + c r^2
            # using recurrence: r^3 = 10 - r^2 - r
            # So we can represent powers as tuple (a,b,c) integers.
            def coeffs_upto(n):
                coeffs = []
                # base
                coeffs.append((1,0,0))  # r^0 = 1
                coeffs.append((0,1,0))  # r^1 = r
                coeffs.append((0,0,1))  # r^2 = r^2
                for i in range(3, n+1):
                    # r^i = 10 * r^{i-3} - r^{i-1} - r^{i-2}
                    a3,b3,c3 = coeffs[i-3]
                    a1,b1,c1 = coeffs[i-1]
                    a2,b2,c2 = coeffs[i-2]
                    a = 10*a3 - a1 - a2
                    b = 10*b3 - b1 - b2
                    c = 10*c3 - c1 - c2
                    coeffs.append((a,b,c))
                return coeffs
            
