eq2 = sp.Eq(IG.dot(IJ), sp.sqrt(IG.dot(IG))*sp.sqrt(IJ.dot(IJ))*sp.sqrt(3)/2)

def solve_J_numerical(th, ph, guess):
    try:
        sol = sp.nsolve([eq1.subs({theta:th, phi:ph}), eq2.subs({theta:th, phi:ph})], [xJ, yJ], guess, tol=1e-14, maxsteps=100, prec=50)
        return (float(sol[0]), float(sol[1]))
    except Exception:
        return None

def find_J_solutions(th, ph):
    sols = []
    guesses = [(0.5,0.5), (1.5,0.5), (0.5,1.5), (-0.5,0.5), (0.5,-0.5), (2,0), (0,2), (1,-0.5), (-1,1)]
    for g in guesses:
        sol = solve_J_numerical(th, ph, g)
        if sol and not any(math.hypot(sol[0]-s[0], sol[1]-s[1])<1e-6 for s in sols):
            sols.append(sol)
    return sols

def is_convex_polygon(pts):
    n = len(pts)
    sign = None
    for i in range(n):
        p0 = pts[i]
        p1 = pts[(i+1)%n]
        p2 = pts[(i+2)%n]
        v1 = (p1[0]-p0[0], p1[1]-p0[1])
        v2 = (p2[0]-p1[0], p2[1]-p1[1])
        cross = v1[0]*v2[1] - v1[1]*v2[0]
        if abs(cross) < 1e-9:
            continue
        if sign is None:
            sign = cross > 0
        else:
            if (cross > 0) != sign:
                return False
    return True

def convex_check(th, ph, J):
    F = (0.0,0.0)
    G = (1.0,0.0)
    H = (1+math.cos(th), math.sin(th))
    I = (1+math.cos(th)+math.cos(ph), math.sin(th)+math.sin(ph))
    return is_convex_polygon([F,G,H,I,J])

def angle_GJH(th, ph, J):
    xj,yj = J
    G = (1.0,0.0)
    H = (1+math.cos(th), math.sin(th))
    vJG = (G[0]-xj, G[1]-yj)
    vJH = (H[0]-xj, H[1]-yj)
    dot = vJG[0]*vJH[0] + vJG[1]*vJH[1]
    n1 = math.hypot(*vJG)
    n2 = math.hypot(*vJH)
    if n1==0 or n2==0:
        return None
    cosang = max(-1, min(1, dot/(n1*n2)))
    return math.degrees(math.acos(cosang))

def get_convex_example():
    for _ in range(200):
        th = random.uniform(0.05, math.pi-0.05)
        ph = random.uniform(0.05, math.pi-0.05)
        sols = find_J_solutions(th, ph)
        for J in sols:
            if convex_check(th, ph, J):
                return th, ph, J
    return None

