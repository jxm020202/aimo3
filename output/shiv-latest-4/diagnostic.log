            def find_possible_lengths(q,w,limit):
                poss=[]
                for m in range(w,limit+1):
                    # brute force all assignments? exponential huge. limit small.
                    # Use backtracking maybe.
                    found=False
                    def backtrack(pos,seq):
                        nonlocal found
                        if found: return
                        if pos==m:
                            if is_colorful(seq,q,w):
                                found=True
                            return
                        for col in range(q):
                            seq.append(col)
                            # early pruning: check any completed window of size w that is fully assigned (i.e., when pos>=w-1)
                            if pos>=w-1:
                                # check window ending at pos
                                window=seq[pos-w+1:pos+1]
                                if set(window)!=set(range(q)):
