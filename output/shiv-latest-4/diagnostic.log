            import math, random
            
            def compute_angle(p, q, r):
                # angle pqr at q between qp and qr
                v1 = (p[0]-q[0], p[1]-q[1])
                v2 = (r[0]-q[0], r[1]-q[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                if norm1*norm2 == 0:
                    return None
                cosang = dot/(norm1*norm2)
                # clamp
                cosang = max(-1, min(1, cosang))
                ang = math.degrees(math.acos(cosang))
                return ang
            
            def intersect_lines(p1, d1, p2, d2):
                # lines p1 + t*d1, p2 + s*d2
                # solve for t,s where they intersect (if not parallel)
                # 2D: cross product approach
                # d1 x d2 = 0 => parallel
                cross = d1[0]*d2[1] - d1[1]*d2[0]
                if abs(cross) < 1e-9:
                    return None
                # solve t = (p2-p1) x d2 / (d1 x d2)
                t = ((p2[0]-p1[0])*d2[1] - (p2[1]-p1[1])*d2[0]) / cross
                return (p1[0] + t*d1[0], p1[1] + t*d1[1])
            
