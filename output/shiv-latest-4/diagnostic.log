            def poly_eq(n):
                M=sp.symbols('M')
                # compute p sequence up to n+1
                p = [sp.Integer(0), sp.Integer(1)]  # p0=0, p1=1
                for k in range(2, n+2):  # need up to p_{n+1}
                    p.append(M*p[-1] - p[-2])
                # p list index matches
                pn = p[n+1]  # p_{n+1}
                pn_minus1 = p[n]  # p_n
                pn_minus2 = p[n-1]  # p_{n-1}
                # T^n(M) = (p_{n+1} M - p_n)/(p_n M - p_{n-1})
                expr = (pn*M - pn_minus1)/(pn_minus1*M - pn_minus2) - 1/(M-1)
                expr_simpl = sp.simplify(sp.together(expr))
                # numerator
                num = sp.simplify(sp.factor(sp.together(expr).as_numer_denom()[0]))
                den = sp.simplify(sp.together(expr).as_numer_denom()[1])
                return sp.factor(num), sp.factor(den)
            
            for n in range(1,6):
                num, den = poly_eq(n)
                print(n, num)
            
