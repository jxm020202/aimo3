            def min_total_4subset(indices):
                M = sp.Matrix([[A[i] for i in indices],
                               [B[i] for i in indices],
                               [C[i] for i in indices]])
                if M.rank() < 3:
                    return None
                sol, params = M.gauss_jordan_solve(sp.Matrix([2025,0,0]))
                # should have one parameter
                t = list(params)[0]
                exprs = [sp.expand(e) for e in sol]
                # each expr = a + b*t
                a_vals = []
                b_vals = []
                for e in exprs:
                    a = sp.expand(e.subs(t,0))
                    b = sp.expand(e.subs(t,1)) - a
                    a_vals.append(int(a))
                    b_vals.append(int(b))
                # constraints: a + b*t >=0
                # Determine feasible integer t range
                t_min = -10**9
                t_max = 10**9
                for a,b in zip(a_vals,b_vals):
                    if b==0:
                        if a<0:
                            return None
                        else:
                            continue
                    if b>0:
                        # t >= ceil(-a/b)
                        t_needed = math.ceil((-a)/b)
                        t_min = max(t_min, t_needed)
                    else: # b<0
                        # t <= floor(-a/b)
                        t_needed = math.floor((-a)/b)
                        t_max = min(t_max, t_needed)
                if t_min > t_max:
                    return None
                # total sum = sum a + t*sum b
                sum_a = sum(a_vals)
                sum_b = sum(b_vals)
                # Since we want minimal total, if sum_b<0, increase t to max feasible; if sum_b>0, decrease t to min feasible.
                if sum_b>0:
                    t_opt = t_min
                elif sum_b<0:
                    t_opt = t_max
                else:
                    # any t gives same total
                    t_opt = t_min
                total = sum_a + sum_b * t_opt
                ks = [a_vals[i] + b_vals[i]*t_opt for i in range(4)]
                return total, ks, t_opt
            
