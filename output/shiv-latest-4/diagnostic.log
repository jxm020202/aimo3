            def minimal_poly_n(n):
                M = sp.symbols('M')
                # Chebyshev of second kind: sympy has chebyshevu
                U_n = sp.chebyshevu(n, M/2)
                U_nm1 = sp.chebyshevu(n-1, M/2)
                P = (M-1)*U_n - U_nm1
                P = sp.expand(P)
                return sp.factor(P)
            
