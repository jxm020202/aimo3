            import math, itertools, numpy as np
            
            def rotate(vec, angle):
                c = math.cos(angle)
                s = math.sin(angle)
                x, y = vec
                return (c*x - s*y, s*x + c*y)
            
            def intersection(F, d1, I, d2):
                # Solve F + t1*d1 = I + t2*d2
                # 2 equations 2 unknowns
                # Solve for t1, t2
                a = np.array([[d1[0], -d2[0]],
                              [d1[1], -d2[1]]], dtype=float)
                b = np.array([I[0]-F[0], I[1]-F[1]], dtype=float)
                try:
                    t = np.linalg.solve(a, b)
                except np.linalg.LinAlgError:
                    return None
                t1, t2 = t
                if t1 <= 0 or t2 <= 0:
                    return None
                J = (F[0] + t1*d1[0], F[1] + t1*d1[1])
                return J
            
            def angle(p, q, r):
                # angle pqr at q (vectors qp and qr)
                v1 = np.array([p[0]-q[0], p[1]-q[1]])
                v2 = np.array([r[0]-q[0], r[1]-q[1]])
                dot = np.dot(v1, v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                if norm == 0:
                    return None
                cosang = dot/norm
                # clamp
                cosang = max(-1, min(1, cosang))
                return math.degrees(math.acos(cosang))
            
            def convex_polygon(points):
                # points list in order, check all cross products have same sign (positive for CCW)
                n = len(points)
                sign = None
                for i in range(n):
                    p0 = np.array(points[i])
                    p1 = np.array(points[(i+1)%n])
                    p2 = np.array(points[(i+2)%n])
                    cross = np.cross(p1-p0, p2-p1)
                    if cross == 0:
                        continue
                    cur_sign = cross > 0
                    if sign is None:
                        sign = cur_sign
                    elif sign != cur_sign:
                        return False
                return True
            
            def compute_possible(phi, psi):
                # compute points
                F = (0.0, 0.0)
                G = (1.0, 0.0)
                H = (1+math.cos(phi), math.sin(phi))
                I = (1+math.cos(phi)+math.cos(psi), math.sin(phi)+math.sin(psi))
                FH = (H[0]-F[0], H[1]-F[1])
                GI = (I[0]-G[0], I[1]-G[1])
                results = []
                for s1 in [+1, -1]:
                    d1 = rotate(FH, s1*math.radians(30))
                    for s2 in [+1, -1]:
                        d2 = rotate(GI, s2*math.radians(30))
                        J = intersection(F, d1, I, d2)
                        if J is None:
                            continue
                        # check convex pentagon order F,G,H,I,J
                        pts = [F, G, H, I, J]
                        if not convex_polygon(pts):
                            continue
                        # compute angle GJH
                        ang = angle(G, J, H)
                        results.append((s1, s2, J, ang))
                return results
            
