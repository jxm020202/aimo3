            import networkx as nx
            
            def king_graph(n,m):
                G=nx.Graph()
                for i in range(n):
                    for j in range(m):
                        G.add_node((i,j))
                for i in range(n):
                    for j in range(m):
                        for di in [-1,0,1]:
                            for dj in [-1,0,1]:
                                if di==0 and dj==0: continue
                                ni=i+di; nj=j+dj
                                if 0<=ni<n and 0<=nj<m:
                                    G.add_edge((i,j),(ni,nj))
                return G
            
