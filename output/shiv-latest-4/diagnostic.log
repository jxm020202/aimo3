                num = 1 + b*b + math.cos(alpha-beta) + b*math.cos(alpha-gamma) + 2*b*math.cos(beta-gamma)
                den = math.sqrt(1 + b*b + 2*b*math.cos(beta-gamma)) * math.sqrt(2 + b*b + 2*math.cos(alpha-beta) + 2*b*math.cos(alpha-gamma) + 2*b*math.cos(beta-gamma))
                cos_val = num/den
                cos_val = max(-1.0, min(1.0, cos_val))
                return math.acos(cos_val)
            
