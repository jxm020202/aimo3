            def construct_path(n):
                if n==0:
                    return [0]
                if n==1:
                    return [0,1]
                # Build path recursively
                # Take path for n-1 bits (size 2^{n-1})
                sub = construct_path(n-1)
                # shift sub by 2^{n-1} (add MSB=1) and reverse order
                shifted = [x + (1<<(n-1)) for x in reversed(sub)]
