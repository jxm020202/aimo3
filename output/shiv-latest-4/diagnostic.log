            def max_colors_grid(n):
                # cells indexed row-major
                total_cells = n*n
                best = 0
                best_assign = None
                
                # Precompute list of 2x2 blocks: each block is list of cell indices
                blocks = []
                for i in range(n-1):
                    for j in range(n-1):
                        cells = [i*n + j, i*n + (j+1), (i+1)*n + j, (i+1)*n + (j+1)]
                        blocks.append(cells)
                
                # For each block, we will check condition when all its cells assigned.
                # We'll maintain assignment list with -1 for unassigned.
                assign = [-1]*total_cells
                
                # For pruning: maximum possible colors remaining = current distinct + remaining cells
                # but each new cell could be new color, so upper bound = distinct + (total_cells - idx)
                
                def check_block(block):
                    colors = [assign[idx] for idx in block]
                    if -1 in colors:
                        return True  # not fully assigned yet
                    # condition: at least two same among four
                    # i.e., not all four distinct
                    return len(set(colors)) <= 3
                
                # also can early detect if a block already has three distinct colors and the fourth unassigned must repeat one of them.
                # That's okay.
                
                def dfs(idx, distinct):
                    nonlocal best, best_assign
                    if idx == total_cells:
                        if distinct > best:
                            best = distinct
                            best_assign = assign.copy()
                        return
                    # prune
                    if distinct + (total_cells - idx) <= best:
                        return
                    # try existing colors first
                    for color in range(distinct):
                        assign[idx] = color
                        # check any block that becomes fully assigned now
                        ok = True
                        for block in blocks:
                            if idx in block:
                                if not check_block(block):
                                    ok = False
                                    break
                        if ok:
                            dfs(idx+1, distinct)
                    # try new color
                    assign[idx] = distinct
                    # check blocks
                    ok = True
                    for block in blocks:
                        if idx in block:
                            if not check_block(block):
                                ok = False
                                break
                    if ok:
                        dfs(idx+1, distinct+1)
                    assign[idx] = -1
                
                dfs(0,0)
                return best, best_assign
            
            for n in range(2,5):
                best,_ = max_colors_grid(n)
                print(n, best)
            
