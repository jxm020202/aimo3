            def count_csp_backtrack():
                D = len(assignments)
                # domains per vertex
                domains = {v: set(range(D)) for v in G.nodes()}
                total = 0
                
                # adjacency list
                adj = {v: list(G.neighbors(v)) for v in G.nodes()}
                
                def propagate(domains, v, val):
                    # assign v=val, update neighbor domains
                    new_domains = {u: set(domains[u]) for u in domains}
                    new_domains[v] = {val}
                    # queue for propagation
                    queue = [(v, val)]
                    while queue:
                        cur, cur_val = queue.pop()
                        for nb in adj[cur]:
                            # allowed set for nb given cur_val
                            allowed_set = allowed[(cur, nb)][cur_val]
                            intersect = new_domains[nb] & allowed_set
                            if not intersect:
                                return None  # inconsistency
                            if intersect != new_domains[nb]:
                                new_domains[nb] = intersect
                                if len(intersect) == 1:
                                    # propagate further
                                    queue.append((nb, next(iter(intersect))))
                    return new_domains
                
                def backtrack(domains):
                    nonlocal total
                    # check if any domain empty
                    for d in domains.values():
                        if not d:
                            return
                    # if all assigned
                    if all(len(d)==1 for d in domains.values()):
                        total += 1
                        return
                    # select vertex with smallest domain >1
                    v = min((u for u in domains if len(domains[u])>1), key=lambda x: len(domains[x]))
                    for val in list(domains[v]):
                        new_domains = propagate(domains, v, val)
                        if new_domains is not None:
                            backtrack(new_domains)
                backtrack(domains)
                return total
            
