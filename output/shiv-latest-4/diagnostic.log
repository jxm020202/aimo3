            import networkx as nx, itertools, collections, time, sys, math, random, copy
            
            # Build structures
            G = nx.icosahedral_graph()
            triangles = [tuple(sorted(c)) for c in nx.enumerate_all_cliques(G) if len(c)==3]
            edge_list = list(G.edges())
            edge_index = {tuple(sorted(e)): i for i,e in enumerate(edge_list)}
            tri_edges = []
            for tri in triangles:
                a,b,c = tri
                tri_edges.append([edge_index[tuple(sorted((a,b)))],
                                 [edge_index[tuple(sorted((a,c)))],
                                 [edge_index[tuple(sorted((b,c)))]])
            # flatten inner lists
            tri_edges = [list(map(int, e)) for e in tri_edges]
            tri_count = len(tri_edges)
            configs = [(c1,c2,c3) for c1 in range(3) for c2 in range(3) for c3 in range(3) if len({c1,c2,c3})==2]
            
            # map edge to its two incident triangles
            edge_to_tri = collections.defaultdict(list)
            for i, edges in enumerate(tri_edges):
                for e in edges:
                    edge_to_tri[e].append(i)
            
            # adjacency for ordering (optional)
            adj = [[] for _ in range(tri_count)]
            for e, tris in edge_to_tri.items():
                a,b = tris
                adj[a].append(b)
                adj[b].append(a)
            
            # Precompute for each triangle the list of configs
            tri_configs = configs
            
            # We'll use recursion with memoization on (processed_set, boundary tuple)
            from functools import lru_cache
            
            # Represent processed set as bitmask of length tri_count (<=20 fits in int)
            # boundary: dict edge->color for edges that have exactly one incident triangle processed.
            # We'll encode boundary as tuple of (edge, color) sorted.
            
            @lru_cache(maxsize=None)
            def dp(processed_mask, boundary_tuple):
                # boundary_tuple is a tuple of (edge, color) pairs sorted
                if processed_mask == (1<<tri_count)-1:
                    # all triangles processed, need to ensure boundary empty (should be)
                    return 1 if not boundary_tuple else 0
                # reconstruct boundary dict
                boundary = dict(boundary_tuple)
                # choose a triangle not yet processed
                # heuristic: pick triangle that shares most edges with boundary (to reduce)
                best = None
                best_shared = -1
                for t in range(tri_count):
                    if not (processed_mask>>t)&1:
                        # count how many of its edges are in boundary
                        shared = sum(1 for e in tri_edges[t] if e in boundary)
                        if shared > best_shared:
                            best_shared = shared
                            best = t
                t = best
                total = 0
                # iterate configs
                for cfg in tri_configs:
                    # check compatibility with boundary edges
                    ok = True
                    for e, col in zip(tri_edges[t], cfg):
                        if e in boundary and boundary[e] != col:
                            ok = False
                            break
                    if not ok:
                        continue
                    # new boundary after processing t
                    new_boundary = dict(boundary)  # copy
                    # for each edge of t
                    for e, col in zip(tri_edges[t], cfg):
                        other_tri = [tri for tri in edge_to_tri[e] if tri != t][0]  # the other triangle
                        if (processed_mask>>other_tri)&1:
                            # other already processed, edge should have been in boundary before (or not)
                            # after both processed, edge no longer needed; ensure consistency already checked
                            if e in new_boundary:
                                del new_boundary[e]
                        else:
                            # other not processed yet, edge becomes part of boundary with this color
                            new_boundary[e] = col
                    # recurse
                    new_mask = processed_mask | (1<<t)
                    # convert boundary dict to sorted tuple
                    new_boundary_tuple = tuple(sorted(new_boundary.items()))
                    total += dp(new_mask, new_boundary_tuple)
                return total
            
            start = time.time()
            result = dp(0, tuple())
            elapsed = time.time() - start
            result, elapsed
            
