            def cross(o, a, b):
                # cross product (a-o) x (b-o) z-component
                return (a.x - o.x)*(b.y - o.y) - (a.y - o.y)*(b.x - o.x)
            
            def is_convex(F,G,H,I,J):
                # order F,G,H,I,J
                pts = [F,G,H,I,J]
                # compute cross for each consecutive triple
                signs = []
                n = 5
                for i in range(n):
                    o = pts[i]
                    a = pts[(i+1)%n]
                    b = pts[(i+2)%n]
                    cp = cross(o,a,b)
                    signs.append(cp)
                # all same sign and non-zero
                # allow small tolerance for numeric
                # Determine sign of first non-zero
                first = None
                for s in signs:
                    if abs(s) > 1e-6:
                        first = s
                        break
                if first is None:
                    return False
                for s in signs:
                    if s*first < -1e-6:
                        return False
                return True
            
            def angle(p,q,r):
                # angle pqr at q
                v1 = sp.Matrix([p.x - q.x, p.y - q.y])
                v2 = sp.Matrix([r.x - q.x, r.y - q.y])
                dot = v1.dot(v2)
                norm1 = sp.sqrt(v1.dot(v1))
                norm2 = sp.sqrt(v2.dot(v2))
                # return in radians
                return sp.acos(dot/(norm1*norm2))
            
            def angle_numeric(p,q,r):
                # numeric using math
                v1 = (p[0]-q[0], p[1]-q[1])
                v2 = (r[0]-q[0], r[1]-q[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                if norm1*norm2 == 0:
                    return None
                cosang = max(-1,min(1,dot/(norm1*norm2)))
                return math.degrees(math.acos(cosang))
            
