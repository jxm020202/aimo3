            def histogram(data, bins):
                minv = min(data)
                maxv = max(data)
                width = (maxv-minv)/bins
                counts = [0]*bins
                for d in data:
                    idx = int((d-minv)//width)
                    if idx==bins: idx = bins-1
                    counts[idx] += 1
                return minv, maxv, width, counts
            
