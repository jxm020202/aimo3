```python
import math, random

def rotate(v, deg):
    rad = math.radians(deg)
    c, s = math.cos(rad), math.sin(rad)
    x, y = v
    return (c*x - s*y, s*x + c*y)

def intersect(F, uF, I, uI):
    # solve F + t1*uF = I + t2*uI
    a1, b1 = uF
    a2, b2 = (-uI[0], -uI[1])          # move to left side
    c1 = I[0] - F[0]
    c2 = I[1] - F[1]
    det = a1*b2 - a2*b1
    if abs(det) < 1e-9:
        return None
    t1 = (c1*b2 - c2*a2) / det
    t2 = (a1*c2 - b1*c1) / det
    if t1 <= 0 or t2 <= 0:
        return None
    return (F[0] + t1*uF[0], F[1] + t1*uF[1])

def angle(p, q, r):
    # angle pqr (vertex q)
    v1 = (p[0]-q[0], p[1]-q[1])
    v2 = (r[0]-q[0], r[1]-q[1])
    dot = v1[0]*v2[0] + v1[1]*v2[1]
    cross = v1[0]*v2[1] - v1[1]*v2[0]
    ang = math.degrees(math.atan2(abs(cross), dot))
    return ang

def trial():
    # random theta, phi
    theta = random.uniform(0.2, math.pi-0.2)
    phi   = random.uniform(0.2, math.pi-0.2)

    G = (0.0, 0.0)
    F = (1.0, 0.0)
    H = (math.cos(theta), math.sin(theta))
    I = (H[0]+math.cos(phi), H[1]+math.sin(phi))

    FH = (H[0]-F[0], H[1]-F[1])
    IG = (G[0]-I[0], G[1]-I[1])

    results = []
    for eps1 in (+1,-1):
        uF = rotate(FH, eps1*30)
        uF = (uF[0]/math.hypot(*uF), uF[1]/math.hypot(*uF))
        for eps2 in (+1,-1):
            uI = rotate(IG, eps2*30)
            uI = (uI[0]/math.hypot(*uI), uI[1]/math.hypot(*uI))
            J = intersect(F, uF, I, uI)
            if J is None: 
                continue
            # convexity test (simple orientation test)
            # polygon order F,G,H,I,J must have same signed area
            pts = [F,G,H,I,J]
            area = 0.0
            for a,b in zip(pts, pts[1:]+pts[:1]):
                area += a[0]*b[1] - a[1]*b[0]
            if area <= 0:   # not counter‑clockwise
                continue
            alpha = angle(G, J, H)
            results.append(alpha)
    return results

vals = set()
for _ in range(2000):
    for a in trial():
        vals.add(round(a,6))
print(sorted(vals))
