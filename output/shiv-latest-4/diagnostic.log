            def is_convex(F,G,H,I,J):
                def cross(A,B,C):
                    return (B[0]-A[0])*(C[1]-B[1]) - (B[1]-A[1])*(C[0]-B[0])
                pts = [F,G,H,I,J]
                signs = []
                n = len(pts)
                for i in range(n):
                    A = pts[i]
                    B = pts[(i+1)%n]
                    C = pts[(i+2)%n]
                    cp = cross(A,B,C)
                    signs.append(cp)
                pos = [s for s in signs if s>1e-9]
                neg = [s for s in signs if s<-1e-9]
                return (len(pos)==0 or len(neg)==0)
            
            def angle(p,q,r):
                v1 = (p[0]-q[0], p[1]-q[1])
                v2 = (r[0]-q[0], r[1]-q[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                if norm1*norm2 == 0:
                    return None
                cosang = max(-1,min(1,dot/(norm1*norm2)))
                return math.degrees(math.acos(cosang))
            
