            import mpmath as mp
            
            def minimal_M(n):
                # n is number of x's
                # recurrence: x1 = M, x_{i+1}=M-1/x_i, need final condition 1/x_n + 1 = M
                # Solve equation f(M)=0 where f(M) = 1/(x_n) + 1 - M
                def f(M):
                    x = M
                    for i in range(1, n):
                        x = M - 1/x
                    return 1/x + 1 - M
                # find root > 1 (since M>1)
                # Use findroot starting near 2
                try:
                    root = mp.findroot(f, 2)
                except Exception as e:
                    # try other initial guesses
                    for guess in [1.5, 1.7, 2.5, 3]:
                        try:
                            root = mp.findroot(f, guess)
                            break
                        except: 
                            continue
                    else:
                        raise e
                return root
            
            for n in range(1,6):
                print(n, minimal_M(n))
            
