            def angle_GJH(theta1_val, theta2_val, s_val):
                # compute points
                Hx = 1 + math.cos(theta1_val)
                Hy = math.sin(theta1_val)
                Ix = Hx + math.cos(theta2_val)
                Iy = Hy + math.sin(theta2_val)
                cos30 = math.sqrt(3)/2
                sin30 = 0.5
                Jx = s_val*(Hx*cos30 - Hy*sin30)
                Jy = s_val*(Hx*sin30 + Hy*cos30)
                # vectors
                v1 = (1 - Jx, 0 - Jy)  # JG = G - J
                v2 = (Hx - Jx, Hy - Jy)  # JH = H - J
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                ang = math.degrees(math.acos(dot/(norm1*norm2)))
                return ang
            
            for _ in range(5):
                th1 = random.uniform(0.1, math.pi-0.1)
                th2 = random.uniform(0.1, math.pi-0.1)
                s_val = find_s(th1, th2)
