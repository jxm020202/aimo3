            def construct_path(n):
                if n==0:
                    return [0]
                # recursively construct path for n-1
                lower = construct_path(n-1)
                # lower vertices have bits 0..n-2
                # first part: lower with bit n-1 =0
                part1 = lower
                # then flip bit n-1 (add 1<<(n-1))
                part2 = [v | (1<<(n-1)) for v in lower[::-1]]  # reversed lower with MSB set
                return part1 + part2
            
            def check_path(path, n):
                N = 1<<n
                if len(path)!=N:
                    return False
                if path[0]!=0:
                    return False
                visited=set(path)
                if len(visited)!=N:
