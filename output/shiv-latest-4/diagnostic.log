            import random, math, itertools, numpy as np
            
            def random_quadrilateral():
                # generate random vectors v,u and scalars p,q,r,s such that (p+q)*|v| = (r+s)*|u|
                # choose v,u random non-collinear
                while True:
                    v = np.random.randn(2)
                    u = np.random.randn(2)
                    if abs(np.cross(v,u))>1e-3:
                        break
                # choose scalars p,q,r,s positive
                p,q,r,s = [random.uniform(0.5,2) for _ in range(4)]
                # adjust to satisfy equal diagonal lengths
                len_v = np.linalg.norm(v)
                len_u = np.linalg.norm(u)
                # set condition: (p+q)*len_v = (r+s)*len_u
                # we can scale u to satisfy
                scale = (p+q)*len_v/(r+s)/len_u
                u = u*scale
                # define points
                W = p*v
                Y = -q*v
                X = r*u
                Z = -s*u
                return W,X,Y,Z
            
            def compute_N(W,X,Y,Z):
                # solve for N as intersection of perp bisectors of WX and YZ
                # use linear equations from distances squared
                # unknown N (2D)
                # equation: (N-W)·(N-W) = (N-X)·(N-X)
                # => N·N -2N·W + W·W = N·N -2N·X + X·X
                # => -2N·W + W·W = -2N·X + X·X
                # => 2N·(X-W) = X·X - W·W
                # Similarly for YZ
                A = np.vstack([2*(X-W), 2*(Z-Y)])  # each row is vector coefficient for N
                b = np.array([np.dot(X,X)-np.dot(W,W), np.dot(Z,Z)-np.dot(Y,Y)])
                N = np.linalg.solve(A, b)
                return N
            
            def compute_O(W,X,Y,Z):
                A = np.vstack([2*(Y-X), 2*(Z-W)])  # from XY and WZ
                b = np.array([np.dot(Y,Y)-np.dot(X,X), np.dot(Z,Z)-np.dot(W,W)])
                O = np.linalg.solve(A, b)
                return O
            
            def angle_between(a,b):
                dot = np.dot(a,b)
                na = np.linalg.norm(a)
