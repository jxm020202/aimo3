            def prime_sieve(limit):
                sieve = [True]*(limit+1)
                sieve[0]=sieve[1]=False
                for i in range(2,int(limit**0.5)+1):
                    if sieve[i]:
                        step = i
                        start = i*i
                        sieve[start:limit+1:step]=[False]*(((limit - start)//step)+1)
                return [i for i, isprime in enumerate(sieve) if isprime]
            
