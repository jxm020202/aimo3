            import numpy as np
            from math import cos, sin, pi, sqrt, atan2
            
            def rotate(v, angle):
                c = math.cos(angle)
                s = math.sin(angle)
                return (c*v[0] - s*v[1], s*v[0] + c*v[1])
            
            def angle_between(u, v):
                # returns angle in radians between vectors u and v (0 to pi)
                dot = u[0]*v[0] + u[1]*v[1]
                nu = math.hypot(u[0], u[1])
                nv = math.hypot(v[0], v[1])
                if nu*nv == 0:
                    return 0
                cosang = max(-1, min(1, dot/(nu*nv)))
                return math.acos(cosang)
            
            def solve_for_s(alpha, beta, sign):
                # sign = +1 for +30°, -1 for -30°
                # define vectors
                v = (1 + cos(alpha), sin(alpha))  # FH
                # rotate v by sign*30°
                delta = sign * pi/6
                w = rotate(v, delta)  # direction vector (same length as v)
                # unknown scalar s >0 such that J = s * w
                # define function f(s) = angle between IG and IJ - 30°
                # compute I, G
                H = (1 + cos(alpha), sin(alpha))
