            import math, numpy as np, random
            
            def circle_center_and_radius(p1, p2, side=1):
                # side = +1 or -1 determines which side of chord (perpendicular direction)
                p1 = np.array(p1, dtype=float)
                p2 = np.array(p2, dtype=float)
                mid = (p1 + p2)/2
                d = np.linalg.norm(p2 - p1)
                # radius = d (since angle 30°)
                R = d
                # unit perpendicular vector to chord (rotate by 90 deg)
                v = p2 - p1
                # perpendicular (CCW)
                perp = np.array([-v[1], v[0]])
                perp_norm = np.linalg.norm(perp)
                if perp_norm == 0:
                    raise ValueError("zero length")
                perp_unit = perp / perp_norm
                # distance from midpoint to center
                h = math.sqrt(R**2 - (d/2)**2)  # should be sqrt(3)/2 * d
                # but due to floating errors, ensure non-negative
                O = mid + side * h * perp_unit
                return O, R
            
            def circle_intersections(O1,R1,O2,R2):
                # returns list of intersection points (0,1,2)
                d = np.linalg.norm(O2 - O1)
                if d > R1 + R2 + 1e-9 or d < abs(R1 - R2) - 1e-9:
                    return []  # no intersection
                # handle near coincident
