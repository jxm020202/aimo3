            def is_convex(F, G, H, I, J):
                # compute cross product z for each consecutive triple (P_i, P_{i+1}, P_{i+2})
                pts = [F, G, H, I, J]
                n = 5
                cross_signs = []
                for i in range(n):
                    P = pts[i]
                    Q = pts[(i+1)%n]
                    R = pts[(i+2)%n]
                    # vectors Q-P, R-Q
                    v1 = (Q.x - P.x, Q.y - P.y)
                    v2 = (R.x - Q.x, R.y - Q.y)
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    cross_signs.append(cross)
                # All should be same sign and non-zero
                # Determine sign of first non-zero
                first = None
                for c in cross_signs:
                    if abs(c) > 1e-9:
                        first = c
                        break
                if first is None:
                    return False
                sign = 1 if first > 0 else -1
                for c in cross_signs:
                    if c*sign < -1e-9:  # opposite sign
                        return False
                return True
            
