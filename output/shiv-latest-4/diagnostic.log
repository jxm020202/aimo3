            def solve_J(theta, phi):
                # define symbols
                x, y = sp.symbols('x y', real=True)
                # points
                F = sp.Point(0,0)
                G = sp.Point(1,0)
                H = sp.Point(1+sp.cos(theta), sp.sin(theta))
                I = sp.Point(1+sp.cos(theta)+sp.cos(phi), sp.sin(theta)+sp.sin(phi))
                # vectors
                FH = sp.Matrix([H.x - F.x, H.y - F.y])
                FJ = sp.Matrix([x, y])
                IG = sp.Matrix([G.x - I.x, G.y - I.y])
                IJ = sp.Matrix([x - I.x, y - I.y])
                # cos30
                c30 = sp.sqrt(3)/2
                eq1 = (FH.dot(FJ))/(sp.sqrt(FH.dot(FH))*sp.sqrt(FJ.dot(FJ))) - c30
                eq2 = (IG.dot(IJ))/(sp.sqrt(IG.dot(IG))*sp.sqrt(IJ.dot(IJ))) - c30
                # solve
                sol = sp.nsolve([eq1, eq2], [x, y], [0.5, 0.5])  # need initial guess
                return sol
            
