            import math, itertools, random
            def rotate(vec, angle):
                # vec is tuple (x,y)
                x,y = vec
                ca = math.cos(angle)
                sa = math.sin(angle)
                return (ca*x - sa*y, sa*x + ca*y)
            
            def compute_J(theta1, phi, sign1, sign2):
                # points
                F = (0.0, 0.0)
                G = (1.0, 0.0)
                H = (1+math.cos(theta1), math.sin(theta1))
                I = (H[0]+math.cos(phi), H[1]+math.sin(phi))
                # vectors
                FH = (H[0]-F[0], H[1]-F[1])  # same as H
                IG = (G[0]-I[0], G[1]-I[1])
                # directions
                d1 = rotate(FH, sign1*math.radians(30))
                d2 = rotate(IG, sign2*math.radians(30))
                # solve F + s*d1 = I + t*d2
                # two equations: s*d1x - t*d2x = I.x - F.x, s*d1y - t*d2y = I.y - F.y
                a11 = d1[0]; a12 = -d2[0]
                a21 = d1[1]; a22 = -d2[1]
                b1 = I[0] - F[0]
                b2 = I[1] - F[1]
                det = a11*a22 - a12*a21
                if abs(det) < 1e-9:
                    return None
                s = (b1*a22 - b2*a12)/det
                t = (a11*b2 - a21*b1)/det
                # require s>0, t>0 for rays outward
                if s <= 1e-9 or t <= 1e-9:
                    return None
                J = (F[0] + s*d1[0], F[1] + s*d1[1])
                return J, s, t, H, I
            
            def angle_between(v1, v2):
                # return angle in radians between vectors
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                if norm1*norm2 == 0:
                    return None
                cosang = max(-1.0, min(1.0, dot/(norm1*norm2)))
                return math.acos(cosang)
            
            def polygon_convex(F,G,H,I,J):
                # check CCW orientation and convex (cross products same sign)
                pts = [F,G,H,I,J]
                # compute signed area
                area = 0
                for i in range(5):
                    x1,y1 = pts[i]
                    x2,y2 = pts[(i+1)%5]
                    area += (x1*y2 - x2*y1)
                if area <= 0:
                    return False
                # cross product signs
                sign = None
                for i in range(5):
                    x0,y0 = pts[i]
                    x1,y1 = pts[(i+1)%5]
                    x2,y2 = pts[(i+2)%5]
                    # vectors
                    v1 = (x1-x0, y1-y0)
                    v2 = (x2-x1, y2-y1)
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    if cross <= 0:
                        return False
                return True
            
            def compute_angle_GJH(J, G, H):
                v1 = (G[0]-J[0], G[1]-J[1])
                v2 = (H[0]-J[0], H[1]-J[1])
                ang = angle_between(v1, v2)
                return ang
            
            def sample_random(num=10000):
                results = []
                for _ in range(num):
                    theta1 = random.uniform(0.1, math.pi-0.1)  # avoid degenerate
                    phi = random.uniform(0.1, math.pi-0.1)
                    for sign1 in [1,-1]:
                        for sign2 in [1,-1]:
                            out = compute_J(theta1, phi, sign1, sign2)
                            if out is None:
                                continue
                            J, s, t, H, I = out
                            F = (0.0,0.0)
                            G = (1.0,0.0)
                            if not polygon_convex(F,G,H,I,J):
                                continue
                            ang = compute_angle_GJH(J, G, H)
                            if ang is None:
