            def max_induced_matching_edges(n,m):
                G=king_graph(n,m)
                edges=[tuple(sorted(e)) for e in G.edges()]
                e_index={e:i for i,e in enumerate(edges)}
                num_e=len(edges)
                # build conflict list
                conflict=[]
                # precompute adjacency set for quick check
                adj=set()
                for e in edges:
                    adj.add(e)
                # also need adjacency between endpoints of different edges
                # For each pair of edges, check if they share a vertex or any endpoint adjacent
                verts= list(G.nodes())
                neighbor = {v:set(G.neighbors(v)) for v in verts}
                for i in range(num_e):
                    e1=edges[i]
                    a1,b1=e1
                    for j in range(i+1,num_e):
                        e2=edges[j]
                        a2,b2=e2
                        # share vertex
                        if len({a1,b1,a2,b2})<4:
                            conflict.append((i,j))
                            continue
                        # check adjacency between any endpoint
                        if (a2 in neighbor[a1]) or (b2 in neighbor[a1]) or (a2 in neighbor[b1]) or (b2 in neighbor[b1]):
                            conflict.append((i,j))
                # MILP
                c = -2*np.ones(num_e)  # maximize 2*sum z
                A=[]
                b=[]
                for (i,j) in conflict:
                    row=np.zeros(num_e)
                    row[i]=1; row[j]=1
                    A.append(row); b.append(1)
                A=np.array(A)
                lin_con=opt.LinearConstraint(A, -np.inf*np.ones(len(b)), b)  # <=1
                bounds=opt.Bounds(np.zeros(num_e), np.ones(num_e))
                integrality=np.ones(num_e)
                res=opt.milp(c, constraints=[lin_con], bounds=bounds, integrality=integrality, options={'disp': False})
                return res, edges
            
