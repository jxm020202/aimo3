            def min_rounds_to_dominant(n):
                # state: tuple sorted multiset
                start = tuple([1]*n)
                visited = {start:0}
                q = deque([start])
                while q:
                    state = q.popleft()
                    steps = visited[state]
                    S = sum(state)
                    # check condition
                    if any(x > S - x for x in state):
                        return steps
                    # generate moves: pick i<j, replace with sum
                    L = len(state)
