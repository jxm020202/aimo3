            def find_path_with_counts(n):
                N=1<<n
                lengths = [1<<k for k in range(n)]
                target_counts = {l: l for l in lengths}  # count = length
                adj = {v:[v^ (1<<k) for k in range(n)] for v in range(N)}
                visited=[False]*N
                visited[0]=True
                path=[0]
                counts={l:0 for l in lengths}
                best_path=None
                def dfs(v, depth):
                    nonlocal best_path
                    if depth==N-1:
                        if all(counts[l]==target_counts[l] for l in lengths):
                            best_path=path.copy()
                            return True
                        return False
                    for u in adj[v]:
