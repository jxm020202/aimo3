            def order_mod(a, m):
                # compute multiplicative order of a modulo m (assuming gcd=1)
                phi = sp.totient(m)
                # get divisors of phi
                divs = sp.divisors(phi)
                for d in sorted(divs):
                    if pow(a, d, m) == 1:
