            import sympy as sp
            t, n = sp.symbols('t n', integer=True, positive=True)
            U = sp.chebyshevu  # second kind
            # define expression for general n using formula
            def condition_general(k):  # k steps = n
                # A^k = U_{k-1}(t/2) * A - U_{k-2}(t/2) * I
                k_int = k
                A = sp.Matrix([[t,-1],[1,0]])
                I = sp.eye(2)
                Uk1 = sp.chebyshevu(k_int-1, t/2)
                Uk2 = sp.chebyshevu(k_int-2, t/2) if k_int-2>=0 else 0
                Ak = Uk1*A - Uk2*I
                v1 = sp.Matrix([t,1])
                v = Ak*v1
                expr = (t-1)*v[0] - v[1]
                return sp.simplify(sp.together(expr).as_numer_denom()[0])
            
            expr5 = condition_general(2)  # for N=3? steps=2
