            def concyc_det(P,Q,R,S):
                mat = sp.Matrix([
                    [P[0], P[1], P[0]**2+P[1]**2, 1],
                    [Q[0], Q[1], Q[0]**2+Q[1]**2, 1],
                    [R[0], R[1], R[0]**2+R[1]**2, 1],
                    [S[0], S[1], S[0]**2+S[1]**2, 1],
                ])
                return mat.det()
