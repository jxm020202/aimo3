            def max_frontier(order, adj):
                added=set()
                max_front=0
                for v in reversed(order):  # adding in reverse elimination
                    # count edges from v to already added vertices
                    front = sum(1 for nb in adj[v] if nb in added)
                    # after adding v, frontier edges are those between added vertices and not yet added.
                    # we can approximate by counting edges with exactly one endpoint in added after addition.
                    added.add(v)
                    # compute current frontier size
                    cur_front = 0
                    for u in added:
                        for nb in adj[u]:
                            if nb not in added:
                                cur_front +=1
                    max_front = max(max_front, cur_front)
                return max_front
            
