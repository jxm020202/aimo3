            def possible_extensions(precolored, edges):
                assigned = [precolored.get(e, None) for e in edges]
                uncolored_edges = [e for e,c in zip(edges,assigned) if c is None]
                k = len(uncolored_edges)
                colors = [0,1,2]
                res=[]
                if k==0:
                    cnt={}
                    for col in assigned:
                        cnt[col]=cnt.get(col,0)+1
                    if sorted(cnt.values())==[1,2]:
                        return [dict()]
                    else:
                        return []
                if k==3:
                    for a in colors:
                        for b in colors:
                            if b==a: continue
                            for pos in range(3):
                                col_assign = [a,a,a]
                                col_assign[pos]=b
                                mapping = {edges[i]:col_assign[i] for i in range(3)}
                                res.append(mapping)
                    return res
                if k==2:
                    e_fixed = [e for e in edges if e in precolored][0]
                    c_fixed = precolored[e_fixed]
                    e2,e3 = uncolored_edges
                    # fixed edge majority
                    a = c_fixed
                    for b in [c for c in colors if c!=a]:
                        # minority on e2
                        mapping = {e_fixed:a, e2:b, e3:a}
                        res.append(mapping)
                        # minority on e3
                        mapping = {e_fixed:a, e2:a, e3:b}
                        res.append(mapping)
                    # fixed edge minority
                    b = c_fixed
                    for a in [c for c in colors if c!=b]:
                        mapping = {e_fixed:b, e2:a, e3:a}
                        res.append(mapping)
                    # dedup
                    uniq={}
                    for m in res:
                        key=tuple(sorted(m.items()))
                        uniq[key]=m
                    return list(uniq.values())
                if k==1:
                    # two precolored edges
                    pre_edges = [e for e in edges if e in precolored]
                    e1,e2 = pre_edges
                    c1 = precolored[e1]
                    c2 = precolored[e2]
                    e3 = uncolored_edges[0]
                    if c1==c2:
                        a=c1
                        for b in [c for c in colors if c!=a]:
                            mapping={e1:a, e2:a, e3:b}
                            res.append(mapping)
                    else:
                        # option 1: e1 majority, e2 minority
                        a=c1; b=c2
                        mapping={e1:a, e2:b, e3:a}
                        res.append(mapping)
                        # option 2: e2 majority, e1 minority
                        a=c2; b=c1
                        mapping={e1:b, e2:a, e3:a}
                        res.append(mapping)
                    uniq={}
                    for m in res:
                        key=tuple(sorted(m.items()))
                        uniq[key]=m
                    return list(uniq.values())
                return []
            
            
