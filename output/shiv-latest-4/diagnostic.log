            def is_convex_polygon(points):
                # points list in order
                n = len(points)
                # compute cross product z of edge i and i+1
                cross_sign = None
                for i in range(n):
                    p0 = points[i]
                    p1 = points[(i+1)%n]
                    p2 = points[(i+2)%n]
                    # vectors p0->p1 and p1->p2
                    v1 = np.array([p1[0]-p0[0], p1[1]-p0[1]])
                    v2 = np.array([p2[0]-p1[0], p2[1]-p1[1]])
                    cross = np.cross(v1, v2)  # scalar in 2D
                    if abs(cross) < 1e-8:
                        return False
                    sign = np.sign(cross)
                    if cross_sign is None:
                        cross_sign = sign
                    else:
                        if sign != cross_sign:
                            return False
                return True
            
            def angle_between(v1, v2):
                # returns angle in radians between vectors (0, pi)
                dot = np.dot(v1, v2)
                norm1 = np.linalg.norm(v1)
                norm2 = np.linalg.norm(v2)
                if norm1*norm2 == 0:
                    return None
                cosang = dot/(norm1*norm2)
                # clamp
                cosang = max(min(cosang,1),-1)
                return math.acos(cosang)
            
            def compute_angle_GJH(F,G,H,J):
                # angle at J between JG and JH
                v1 = np.array([G[0]-J[0], G[1]-J[1]])
                v2 = np.array([H[0]-J[0], H[1]-J[1]])
                return angle_between(v1, v2)
            
