            import math, random, itertools, sys, numpy as np
            
            def rotate(vec, deg):
                rad = math.radians(deg)
                c, s = math.cos(rad), math.sin(rad)
                x, y = vec
                return (c*x - s*y, s*x + c*y)
            
            def intersect(p1, d1, p2, d2):
                # solve p1 + t*d1 = p2 + u*d2
                x1,y1 = p1; dx1,dy1 = d1
                x2,y2 = p2; dx2,dy2 = d2
                # solve linear equations for t,u
                det = dx1*dy2 - dy1*dx2
                if abs(det) < 1e-9:
                    return None
                t = ((x2 - x1)*dy2 - (y2 - y1)*dx2)/det
                return (x1 + t*dx1, y1 + t*dy1)
            
            def angle(p, q, r):
                # angle pqr at q
                v1 = (p[0]-q[0], p[1]-q[1])
                v2 = (r[0]-q[0], r[1]-q[1])
                dot = v1[0]*v2[0]+v1[1]*v2[1]
                norm1 = math.hypot(*v1)
                norm2 = math.hypot(*v2)
                if norm1*norm2==0:
                    return None
                cos = max(-1,min(1,dot/(norm1*norm2)))
                return math.degrees(math.acos(cos))
            
            def compute_angle_GJH(theta, phi):
                # F at (0,0), G at (1,0)
                F = (0.0,0.0)
                G = (1.0,0.0)
                H = (1+math.cos(theta), math.sin(theta))
                I = (H[0]+math.cos(theta+phi), H[1]+math.sin(theta+phi))
                # direction IG
                IG = (G[0]-I[0], G[1]-I[1])
                FH = (H[0]-F[0], H[1]-F[1])
                # try both rotations signs
                results=[]
                for s1 in (+1,-1):
                    dIJ = rotate(IG, s1*30)
                    for s2 in (+1,-1):
                        dFJ = rotate(FH, s2*30)
                        J = intersect(I, dIJ, F, dFJ)
                        if J is None:
                            continue
                        # check convex? ignore for now
                        ang = angle(G, J, H)
                        if ang is not None:
                            results.append(ang)
                return results
            
            def sample():
                vals=set()
                for _ in range(2000):
                    theta = random.uniform(0.2, math.pi-0.2)  # ensure convex shape maybe
                    phi = random.uniform(0.2, math.pi-0.2)
                    angles = compute_angle_GJH(theta, phi)
                    for a in angles:
                        if a>0 and a<180:
                            vals.add(round(a,5))
                return vals
            
            vals = sample()
            len(vals), list(vals)[:20]
            
