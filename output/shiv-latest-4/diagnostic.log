            def angle_between(v1, v2):
                # v1, v2 as tuples
                a = np.array(v1, dtype=float)
                b = np.array(v2, dtype=float)
                dot = np.dot(a,b)
                norm = np.linalg.norm(a)*np.linalg.norm(b)
                if norm==0:
                    return None
                cosang = dot/norm
                # clamp
                cosang = max(-1,min(1,cosang))
                ang = math.degrees(math.acos(cosang))
                return ang
            
