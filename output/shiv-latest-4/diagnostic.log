            def greedy_queries(max_iters=10):
                selected = []
                # current signatures for each triple
                sig = [()] * len(triples)
                while True:
                    # group by current signature
                    groups = {}
                    for idx, s in enumerate(sig):
                        groups.setdefault(s, []).append(idx)
                    # check if all groups size 1
                    if all(len(lst)==1 for lst in groups.values()):
                        break
                    # find query that maximally splits groups
                    best_q = None
                    best_score = -1
                    for q in queries:
                        if q in selected: continue
                        # compute new signatures after adding this query
                        # we can compute for each group the distribution of response values
                        score = 0
                        # we will count total number of pairs that become distinguished
                        # Equivalent to sum over groups of (size - number of collisions after adding)
                        # We'll compute number of distinct values within each group
                        for lst in groups.values():
                            if len(lst)<=1: continue
                            # compute response values for this group
                            vals = {}
                            for idx in lst:
                                val = distance(triples[idx], q)
                                vals.setdefault(val,0)
                                vals[val]+=1
                            # after adding, collisions count = sum over val C(cnt,2)
                            # reduction = original C(len,2) - sum C(cnt,2)
                            orig = len(lst)*(len(lst)-1)//2
                            after = sum(c*(c-1)//2 for c in vals.values())
                            score += (orig - after)
                        if score > best_score:
