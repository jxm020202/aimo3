            adj = {i:set() for i in range(100)}
            for u,v in edges:
                adj[u].add(v); adj[v].add(u)
            # conflict detection
            conflicts = []
            for i in range(len(edges)):
                u1,v1 = edges[i]
                # set of vertices involved
                verts1 = {u1,v1}
                # also neighboring vertices of these (including themselves?) we need adjacency between any endpoint of edge1 and any endpoint of edge2.
                # So edge2's endpoints must not be adjacent to any in verts1, and also not share vertices.
                for j in range(i+1, len(edges)):
                    u2,v2 = edges[j]
                    verts2 = {u2,v2}
                    # check share vertex
                    if verts1 & verts2:
                        conflicts.append((i,j))
