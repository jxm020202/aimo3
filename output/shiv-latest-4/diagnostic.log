            import random, math
            def angle_GJH_numeric(alpha, beta, sign):
                # compute using linear solve approach
                # vectors
                a = np.array([1 + math.cos(alpha), math.sin(alpha)])  # FH
                # rotate a by +30° (sign=+1) or -30°? We'll use sign for rotation of FH (same as before)
                delta = sign * math.pi/6
                c = math.cos(delta); s = math.sin(delta)
                u = np.array([c*a[0] - s*a[1], s*a[0] + c*a[1]])  # direction of FJ
                # b = IG
                I = np.array([1 + math.cos(alpha) + math.cos(beta), math.sin(alpha) + math.sin(beta)])
                G = np.array([1.0, 0.0])
                b = G - I
                # rotate b by -30° (sign maybe opposite) to get direction of IJ
                delta2 = -math.pi/6  # rotate by -30° (as earlier)
                c2 = math.cos(delta2); s2 = math.sin(delta2)
                w = np.array([c2*b[0] - s2*b[1], s2*b[0] + c2*b[1]])  # direction of IJ
                # Solve linear equations λ*u = I + μ*w
                # 2x2 system: λ*u - μ*w = I
                A = np.column_stack((u, -w))  # shape (2,2)
                try:
                    lam, mu = np.linalg.solve(A, I)
                except np.linalg.LinAlgError:
                    return None
                J = lam * u
                # compute angle GJH
                JG = G - J
                JH = np.array([1 + math.cos(alpha), math.sin(alpha)]) - J
                # angle between
                dot = JG.dot(JH)
                ang = math.acos(dot / (np.linalg.norm(JG)*np.linalg.norm(JH)))
                return ang
            
