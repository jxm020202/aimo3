                vi=vectors[i]; vj=vectors[j]; vk=vectors[k]
                # Solve 3x3 linear system using fractions
                from fractions import Fraction
                # matrix rows
                A = [[vi[0], vj[0], vk[0]],
                     [vi[1], vj[1], vk[1]],
                     [vi[2], vj[2], vk[2]]]
                # compute determinant
                def det3(m):
                    return (m[0][0]*(m[1][1]*m[2][2]-m[1][2]*m[2][1])
                            -m[0][1]*(m[1][0]*m[2][2]-m[1][2]*m[2][0])
                            +m[0][2]*(m[1][0]*m[2][1]-m[1][1]*m[2][0]))
                D = det3(A)
                if D == 0:
                    return None
                # Cramer's rule
                A1 = [[target[0], vj[0], vk[0]],
                      [target[1], vj[1], vk[1]],
                      [target[2], vj[2], vk[2]]]
                A2 = [[vi[0], target[0], vk[0]],
                      [vi[1], target[1], vk[1]],
                      [vi[2], target[2], vk[2]]]
                A3 = [[vi[0], vj[0], target[0]],
                      [vi[1], vj[1], target[1]],
                      [vi[2], vj[2], target[2]]]
                a = Fraction(det3(A1), D)
                b = Fraction(det3(A2), D)
                c = Fraction(det3(A3), D)
                if a>=0 and b>=0 and c>=0 and a.denominator==1 and b.denominator==1 and c.denominator==1:
                    return int(a),int(b),int(c)
                return None
            
