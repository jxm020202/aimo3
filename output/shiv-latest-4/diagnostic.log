            def count_colorings_variable_elimination():
                # domain size
                D = len(assignments)  # 18
                # initial binary factors: for each edge (u,v), store allowed set as dict mapping (a,b) -> 1
                # We'll store as dict keyed by frozenset({u,v}) with orientation? We'll store both directions for easy access.
                binary_factors = {}
                for u,v in edges:
                    # store factor as dict with keys (a,b) where a assignment index for u, b for v
                    factor = {}
                    for a in range(D):
                        for b in allowed[(u,v)][a]:
                            factor[(a,b)] = 1
                    binary_factors[frozenset({u,v})] = (u, v, factor)  # store orientation for later
                # elimination order (reverse of min-degree ordering)
                elim_order = ordering[::-1]  # eliminate last first? Actually typical elimination uses order, we eliminate in that order.
                # We'll process vertices in elim_order
                # Keep a list of factors (each factor is tuple (vars, table)) where vars is tuple of vertex ids in order
                factors = []
                # initialize with binary factors
                for key, (u,v,factor_dict) in binary_factors.items():
                    factors.append(((u,v), factor_dict))
                # No unary factors needed (all ones)
                
                for v in elim_order:
                    # find factors that involve v
                    involved = [i for i, (vars_, _) in enumerate(factors) if v in vars_]
                    # combine them
                    if not involved:
                        continue
                    # gather all variables in these factors
                    vars_set = set()
                    for i in involved:
                        vars_set.update(factors[i][0])
                    vars_set.discard(v)
                    new_vars = tuple(sorted(vars_set))  # order for consistency
                    # Build combined factor table: mapping assignments for vars in (v plus new_vars) to count
                    # We'll iterate over assignments of all involved variables.
                    # Since each factor is binary and values 0/1, product is 1 iff all pairwise compatibilities satisfied.
                    # We'll compute by iterating over assignments of v and other vars, checking each factor.
                    # Use dict for counts.
                    combined = collections.Counter()
                    # We'll generate all possible assignments for variables in involved set + v
                    # The number of variables could be up to degree+1 = 4 maybe.
                    vars_all = tuple(sorted(set().union(*[factors[i][0] for i in involved]))  # includes v
                    # Map variable to position index
                    var_pos = {var: idx for idx,var in enumerate(vars_all)}
                    # Precompute list of factor data for quick access
                    factor_data = []
                    for i in involved:
                        vars_f, table = factors[i]
                        # orientation: we need to know which variable corresponds to which index in tuple
                        # We'll store mapping from variable to position in vars_f
                        factor_data.append((vars_f, table))
                    # iterate over all assignments
                    # total combos = D^{len(vars_all)}; worst case maybe D^4 = 18^4 ≈ 104k, manageable.
                    for assign_vals in itertools.product(range(D), repeat=len(vars_all)):
                        # check each factor
                        ok = True
                        for vars_f, table in factor_data:
                            # get assignments for the two variables in this factor
                            a = assign_vals[var_pos[vars_f[0]]
                            b = assign_vals[var_pos[vars_f[1]]
                            if (a,b) not in table:
                                ok = False
                                break
                        if ok:
                            # record assignment for new_vars (excluding v)
                            key = tuple(assign_vals[var_pos[var]] for var in new_vars)
                            combined[key] += 1
                    # remove old factors
                    for i in sorted(involved, reverse=True):
                        del factors[i]
                    # add new factor if any variables left, else accumulate to total
                    if new_vars:
                        # store as dict mapping tuple -> count
                        factors.append((new_vars, dict(combined)))
                    else:
                        # no remaining vars: total count is sum of combined values
                        total = sum(combined.values())
                        return total
                # after loop, if any factors left (should be none)
                # multiply them (they should be independent)
                total = 1
                for vars_, table in factors:
                    total *= sum(table.values())
                return total
            
            start = time.time()
            total = count_colorings_variable_elimination()
            print("Total count:", total, "time", time.time()-start)
            
