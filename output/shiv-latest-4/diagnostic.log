                # initial domains: all states for each vertex
                domains = {v: list(vertex_states) for v in G.nodes()}
                # adjacency edges list per vertex for quick neighbor edges
                neighbor_edges = {v: [] for v in G.nodes()}
                for idx,(u,v) in enumerate(edges):
