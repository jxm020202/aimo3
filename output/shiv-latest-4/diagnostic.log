            def seq_equal(M, n):
                xs = [M]
                for i in range(1, n):
                    xs.append(M - 1/xs[-1])
                return xs
            
            def check_M(M):
                xs = seq_equal(M, 2025)
                # check positivity
                if any(x <= 0 for x in xs):
                    return False, "nonpositive"
                # check final inequality (1/x_{2025})+1 <= M
                if 1/xs[-1] + 1 > M + 1e-12:
                    return False, "last term too large"
                # also check each term <= M
                max_term = max([xs[0]] + [1/xs[i-1]+xs[i] for i in range(1,2025)] + [1/xs[-1]+1])
                return max_term <= M + 1e-12, max_term
            
            for M in [1.9,1.95,1.99,1.999,1.9995,1.9999]:
