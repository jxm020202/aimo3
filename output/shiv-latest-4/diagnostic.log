            def max_induced_matching_king(board_size=10):
                n=board_size
                # map square to index
                idx=lambda r,c: r*n + c
                vertices = [(r,c) for r in range(n) for c in range(n)]
                # edges list (u,v) where u<v
                edges=[]
                for r,c in vertices:
                    for dr in [-1,0,1]:
                        for dc in [-1,0,1]:
                            if dr==0 and dc==0: continue
                            nr,nc=r+dr,c+dc
                            if 0<=nr<n and 0<=nc<n:
                                u=idx(r,c); v=idx(nr,nc)
                                if u<v:
                                    edges.append((u,v))
                # deduplicate (already)
                m=len(edges)
                # Build adjacency between edges: if they share a vertex or any endpoint adjacent
                # precompute neighbor sets for each vertex (including itself?) we need adjacency between edges if any vertex of edge1 is adjacent (king move) to any vertex of edge2, and they are not the same edge.
                # compute neighbor set (including itself) for each vertex
                neighbor_sets=[set() for _ in range(n*n)]
                for r,c in vertices:
                    u=idx(r,c)
                    neighbor_sets[u].add(u)
                    for dr in [-1,0,1]:
                        for dc in [-1,0,1]:
                            if dr==0 and dc==0: continue
                            nr,nc=r+dr,c+dc
                            if 0<=nr<n and 0<=nc<n:
                                neighbor_sets[u].add(idx(nr,nc))
                # conflict pairs
                conflict_pairs=[]
                for i in range(m):
                    u1,v1=edges[i]
                    set1 = neighbor_sets[u1] | neighbor_sets[v1]
                    for j in range(i+1,m):
                        u2,v2=edges[j]
                        # if any endpoint of edge2 is in set1 -> conflict
                        if u2 in set1 or v2 in set1:
                            conflict_pairs.append((i,j))
                # formulate MILP
                import numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                c = -np.ones(m)  # maximize sum => minimize negative
                # constraints: each conflict pair x_i + x_j <=1
                A = np.zeros((len(conflict_pairs), m), dtype=int)
                for row,(i,j) in enumerate(conflict_pairs):
                    A[row,i]=1
                    A[row,j]=1
                # also matching constraint: each vertex incident to at most 1 selected edge
                # but this is already covered by conflict when edges share a vertex? Yes sharing vertex leads to conflict pair because neighbor includes itself. So already covered.
                # Build LinearConstraint
                lc = LinearConstraint(A, -np.inf, np.ones(A.shape[0]))
                bounds = Bounds(0,1)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=np.ones(m))
                if not res.success:
                    print("failed")
                    return None
                x = np.rint(res.x).astype(int)
                max_edges = int(-res.fun)  # since minimized negative sum
                return max_edges, x, edges
            
