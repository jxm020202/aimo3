            def is_convex(phi_val, psi_val, J):
                # check convexity orientation CCW
                # points list in order F,G,H,I,J
                F = (0.0,0.0)
                G = (1.0,0.0)
                H = (1+math.cos(phi_val), math.sin(phi_val))
                I = (1+math.cos(phi_val)+math.cos(psi_val), math.sin(phi_val)+math.sin(psi_val))
                Jpt = J
                pts = [F,G,H,I,Jpt]
                # compute cross product of successive edges
                n = len(pts)
                sign = None
                for i in range(n):
                    p0 = pts[i]
                    p1 = pts[(i+1)%n]
                    p2 = pts[(i+2)%n]
                    # vectors
                    v1 = (p1[0]-p0[0], p1[1]-p0[1])
                    v2 = (p2[0]-p1[0], p2[1]-p1[1])
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    if cross == 0:
                        continue
                    if sign is None:
                        sign = cross > 0
                    else:
                        if (cross > 0) != sign:
                            return False
                return True
            
