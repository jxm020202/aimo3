            def solve_J(alpha_val, delta_val, guess=(0.5,0.5)):
                # numeric values
                subs = {alpha: alpha_val, delta: delta_val}
                # define numeric equations
                eq1_num = sp.N(eq1.subs(subs))
                eq2_num = sp.N(eq2.subs(subs))
                # Use nsolve
                try:
                    sol = sp.nsolve([eq1_num, eq2_num], [xj, yj], guess, tol=1e-14, maxsteps=100)
                    return float(sol[0]), float(sol[1])
                except Exception as e:
                    # print("nsolve error", e)
                    return None
            
            def angle_GJH(alpha_val, delta_val, J):
                # compute angle at J between vectors G-J and H-J
                G_pt = np.array([1.0, 0.0])
                H_pt = np.array([1+math.cos(alpha_val), math.sin(alpha_val)])
                J_pt = np.array(J)
                v1 = G_pt - J_pt
                v2 = H_pt - J_pt
                # angle between v1 and v2
                dot = np.dot(v1, v2)
                norm1 = np.linalg.norm(v1)
                norm2 = np.linalg.norm(v2)
                ang = math.degrees(math.acos(dot/(norm1*norm2)))
                return ang
            
            def points_polygon(alpha_val, delta_val, J):
                # return list of points in order F,G,H,I,J
                F_pt = np.array([0.0,0.0])
                G_pt = np.array([1.0,0.0])
                H_pt = np.array([1+math.cos(alpha_val), math.sin(alpha_val)])
                I_pt = H_pt + np.array([math.cos(alpha_val+delta_val), math.sin(alpha_val+delta_val)])
                J_pt = np.array(J)
                return [F_pt, G_pt, H_pt, I_pt, J_pt]
            
            def is_convex(poly):
                # poly list of points in order, assume closed (no repeat)
                n = len(poly)
                # compute cross product z of edges (i->i+1) and (i+1->i+2)
                sign = None
                for i in range(n):
                    p0 = poly[i]
                    p1 = poly[(i+1)%n]
                    p2 = poly[(i+2)%n]
                    v1 = p1 - p0
                    v2 = p2 - p1
                    cross = np.cross(v1, v2)  # scalar in 2D
                    if cross == 0:
                        continue
                    if sign is None:
                        sign = np.sign(cross)
                    else:
                        if np.sign(cross) != sign:
                            return False
                return True
            
