                # compute cross products of edges
                n = len(pts)
                sign = None
                for i in range(n):
                    p0 = np.array(pts[i])
                    p1 = np.array(pts[(i+1)%n])
                    p2 = np.array(pts[(i+2)%n])
                    v1 = p1-p0
                    v2 = p2-p1
                    cross = np.cross(v1, v2)
                    if abs(cross) < 1e-8:
