        def count_colorings():
    import networkx as nx
    g = nx.dodecahedral_graph()
    # map edges to indices
    edge_list = list(g.edges())
    edge_index = {e:i for i,e in enumerate(edge_list)}
    # ensure each edge as (u,v) with u<v for consistency
    edge_list = [(min(u,v), max(u,v)) for u,v in edge_list]
    # adjacency of vertices to incident edge indices
    incident = {v: [] for v in g.nodes()}
    for idx,(u,v) in enumerate(edge_list):
        incident[u].append(idx)
        incident[v].append(idx)
    # backtracking
    colors = [None]*len(edge_list)
    count = 0
    # order edges maybe by adjacency
    order = list(range(len(edge_list)))
    # Precompute for each vertex the list of its incident edges
    verts = list(g.nodes())
    # Helper to check vertex constraint when all three incident edges assigned
    def check_vertex(v):
        e_idxs = incident[v]
        vals = [colors[i] for i in e_idxs]
        if None in vals:
            return True
        # check exactly two equal and one different
        a,b,c = vals
        # condition
        return (a==b!=c) or (a==c!=b) or (b==c!=a)
    # recursive
    def dfs(pos):
        nonlocal count
        if pos==len(order):
            count+=1
            return
        e = order[pos]
        for col in range(3):
            colors[e]=col
            u,v = edge_list[e]
            if not (check_vertex(u) and check_vertex(v)):
                colors[e]=None
                continue
            dfs(pos+1)
            colors[e]=None
    dfs(0)
    return count

