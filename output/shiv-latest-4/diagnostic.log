            def feasible_n(n, max_val=30):
                N=n*n
                # variable bounds 0..max_val
                bounds = opt.Bounds([0]*N, [max_val]*N)
                # objective dummy zero
                c = np.zeros(N)
                rows = []
                lower = []
                upper = []
                # adjacency constraints
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        if j+1 < n:
                            idx2 = i*n + (j+1)
                            # diff = x - y
                            row = np.zeros(N)
                            row[idx]=1
                            row[idx2]=-1
                            rows.append(row); lower.append(-1); upper.append(1)
                            # opposite diff y - x
                            row = np.zeros(N)
                            row[idx]=-1
                            row[idx2]=1
                            rows.append(row); lower.append(-1); upper.append(1)
                        if i+1 < n:
                            idx2 = (i+1)*n + j
                            row = np.zeros(N)
                            row[idx]=1
                            row[idx2]=-1
                            rows.append(row); lower.append(-1); upper.append(1)
                            row = np.zeros(N)
                            row[idx]=-1
                            row[idx2]=1
                            rows.append(row); lower.append(-1); upper.append(1)
                # sum constraint equality
                row = np.ones(N)
                rows.append(row); lower.append(471); upper.append(471)
                A = np.vstack(rows)
                lc = opt.LinearConstraint(A, lower, upper)
                integrality = np.ones(N, dtype=int)
                res = opt.milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False, 'time_limit':10})
