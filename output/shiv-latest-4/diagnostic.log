            def feasible_M(M):
                # try to find x1,x2 satisfying constraints
                # we can treat as: x1 in (0,M], then x2 <= M - 1/x1, also need 1/x2 + 1 <= M => x2 >= 1/(M-1)
                # So need interval for x2: [1/(M-1), M - 1/x1] non-empty
                # So need M - 1/x1 >= 1/(M-1)
                # For some x1 in (0,M].
                # So we need max_{x1 in (0,M]} (M - 1/x1) >= 1/(M-1)
                # Since M - 1/x1 is increasing in x1, its max at x1 = M gives M - 1/M.
                # So condition reduces to M - 1/M >= 1/(M-1)
                # That's same as earlier equality condition? Let's solve.
                return M - 1/M >= 1/(M-1)
            
