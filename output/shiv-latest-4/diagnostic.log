            def compute_A_B(p,n):
                from math import comb
                A=Fraction(0,1)
                B=Fraction(0,1)
                for k in range(0,n+1):
                    C=comb(n,k)
                    term = C * (p**(n-k))
                    if k%2==0:
                        # even
                        A += term * (2**(k//2))
                    else:
                        # odd, coefficient of sqrt2
                        B += term * (2**((k-1)//2))
                # note sign: (-√2)^k = (-1)^k * 2^{k/2} * sqrt2^{k%2}
                # For even k, (-1)^k = 1, ok.
                # For odd k, (-1)^k = -1, so coefficient of sqrt2 is -B
                return A, -B
            
