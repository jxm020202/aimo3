            # union-find with rollback
            class UF:
                def __init__(self, N):
                    self.parent = list(range(N))
                    self.rank = [0]*N
                    self.changes = []  # stack of (type, data)
                    self.components = N
                def find(self, x):
                    while self.parent[x]!=x:
                        x=self.parent[x]
                    return x
                def union(self, x, y):
                    x=self.find(x); y=self.find(y)
                    if x==y:
                        self.changes.append(('none', None))
                        return
                    # union by rank
                    if self.rank[x] < self.rank[y]:
                        x, y = y, x
                    # now rank[x] >= rank[y]
                    self.changes.append(('union', (y, self.parent[y], x, self.rank[x])))
                    self.parent[y]=x
                    if self.rank[x]==self.rank[y]:
                        self.rank[x]+=1
                    self.components -=1
                def snapshot(self):
                    return len(self.changes)
                def rollback(self, snap):
                    while len(self.changes) > snap:
                        typ, data = self.changes.pop()
                        if typ=='none':
                            continue
                        y, old_parent, x, old_rank = data
                        self.parent[y]=old_parent
                        self.rank[x]=old_rank
                        self.components +=1
            
