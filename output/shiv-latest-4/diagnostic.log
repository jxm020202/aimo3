            def solve_b(alpha, beta, case):
                gamma = (alpha+beta)/2 + (30 if case==1 else 150)*deg
                def f(b):
                    A = math.cos(alpha/2)
                    left = 4*A*A + math.cos(beta) + math.cos(alpha-beta) + b*(math.cos(gamma) + math.cos(alpha-gamma))
                    L2 = 4*A*A + 1 + b*b + 2*b*math.cos(beta-gamma) + 2*math.cos(beta) + 2*math.cos(alpha-beta) + 2*b*math.cos(gamma) + 2*b*math.cos(alpha-gamma)
                    return left*left - 3*A*A * L2
                # search for root using brentq if sign change
                # We'll sample b from small to large to find sign change
                lo = 1e-6
                f_lo = f(lo)
                # try increasing b
