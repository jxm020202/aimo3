            import random, math, sympy as sp
            
            def construct_angle():
                a = 1.0
                # choose Y
                b = random.uniform(0.2,0.8)
                c = random.uniform(0.5,2.0)
                W = sp.Point(0,0)
                X = sp.Point(a,0)
                Y = sp.Point(b,c)
                # choose t in (0,1)
                t = random.uniform(0.2,0.8)
                M = sp.Point(t*b, t*c)  # on WY
                # length of diagonal WY
                lenWY = float(Y.distance(W))
                # vector from X to M
                vecXM = sp.Matrix(M - X)
                distXM = float(sp.sqrt(vecXM.dot(vecXM)))
                # scaling factor s such that |XZ| = lenWY and XZ passes through M
                # we have M = X + s*(Z - X) where s = |M-X|/|Z-X|
                # => |Z-X| = lenWY, and s = |M-X|/lenWY
                s = distXM / lenWY
                # Z = X + (M - X)/s
                Z = sp.Point( X.x + (M.x - X.x)/s , X.y + (M.y - X.y)/s )
                # Now compute N and O as before
                # N: intersection of perp bisectors of WX and YZ
                # WX: points (0,0)-(a,0) -> perpendicular bisector x = a/2
                xN = a/2
                # YZ perp bisector line: (x - (b+Zx)/2)*(Zx-b) + (y - (c+Zy)/2)*(Zy-c) = 0
                Zx, Zy = float(Z.x), float(Z.y)
                # solve for yN
                yN = (((b+Zx)/2)*(Zx-b) + ((c+Zy)/2)*(Zy-c)) / (Zy - c) if abs(Zy - c) > 1e-9 else None
                if yN is None:
                    return None
                N = sp.Point(xN, yN)
                # O: intersection of perp bisectors of XY and WZ
                # Solve linear equations
                x,y = sp.symbols('x y')
                eq1 = sp.Eq((x - (a+b)/2)*(b-a) + (y - c/2)*c, 0)
                eq2 = sp.Eq((x - Zx/2)*Zx + (y - Zy/2)*Zy, 0)
                solO = sp.solve([eq1,eq2],[x,y])
                O = sp.Point(solO[x], solO[y])
                # angle NMO
                v1 = sp.Matrix(N - M)
                v2 = sp.Matrix(O - M)
                dot = float(v1.dot(v2))
                n1 = float(sp.sqrt(v1.dot(v1)))
                n2 = float(sp.sqrt(v2.dot(v2)))
                angle = math.degrees(math.acos(dot/(n1*n2)))
                return angle
            
            angles = [construct_angle() for _ in range(20)]
            print(angles)
            
