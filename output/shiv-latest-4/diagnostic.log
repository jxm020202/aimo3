            from functools import lru_cache
            
            all_indices = tuple(range(n))
            
            max_responses = 55  # possible response values 0..54
            
            def possible_responses(q, subset):
                # returns mapping from response value to list of indices in subset
                groups = {}
                for idx in subset:
                    r = responses_matrix[q][idx]
                    groups.setdefault(r, []).append(idx)
                return groups
            
            @lru_cache(maxsize=None)
            def can_solve(subset, depth):
                # subset is frozenset of indices
                size = len(subset)
                if size <= 1:
                    return True, []
                if depth == 0:
                    return False, None
                # prune: maximum distinct responses per query = max_responses
                if size > (max_responses ** depth):
                    return False, None
                # try queries
                for q in queries:
                    groups = possible_responses(q, subset)
                    # if any group size == size (no split) continue maybe still okay if later? but need progress
                    # we need each group solvable with depth-1
                    ok=True
                    subplans={}
                    for grp in groups.values():
                        ok_sub, plan = can_solve(frozenset(grp), depth-1)
                        if not ok_sub:
                            ok=False
                            break
                        subplans[frozenset(grp)] = plan
                    if ok:
                        return True, (q, subplans)
                return False, None
            
            # try depth 3
            start=time.time()
            res, plan = can_solve(frozenset(all_indices), 3)
            print("depth3 solvable?", res, "time", time.time()-start)
            
