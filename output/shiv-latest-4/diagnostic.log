            def circle_intersections(c1, r1, c2, r2):
                # returns list of intersection points (x,y)
                (x0,y0) = c1
                (x1,y1) = c2
                dx = x1 - x0
                dy = y1 - y0
                d = math.hypot(dx, dy)
                if d > r1 + r2 + 1e-9:
                    return []  # separate
                if d < abs(r1 - r2) - 1e-9:
                    return []  # one inside another
                if d == 0 and abs(r1 - r2) < 1e-9:
                    return []  # coincident circles infinite intersections
                # distance from c1 to point2 along line between centers
                a = (r1**2 - r2**2 + d**2) / (2*d)
                h_sq = r1**2 - a**2
                if h_sq < -1e-9:
                    return []
                h = math.sqrt(max(h_sq,0))
                # point P2 = c1 + a*(c2-c1)/d
                xm = x0 + a * dx / d
                ym = y0 + a * dy / d
                # intersection points
                rx = -dy * (h / d)
                ry = dx * (h / d)
                p1 = (xm + rx, ym + ry)
                p2 = (xm - rx, ym - ry)
                if h < 1e-9:
                    return [p1]
                else:
                    return [p1, p2]
            
