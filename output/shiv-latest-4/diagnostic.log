            import itertools, math
            
            def max_a_n(limit_n, max_val=50):
                best = {}
                # backtrack
                seq = [None]*(limit_n+1)  # 1-indexed
                seq[1]=1
                best[1]=1
                def check(seq, length):
                    # verify condition for all k,n where n<=length and k+n-1<=length
                    for n in range(1,length+1):
                        a_n=seq[n]
                        for k in range(1,length-n+2):
                            s=sum(seq[k:k+n])
                            if s % a_n !=0:
                                return False
                    return True
                def dfs(pos, limit):
                    if pos>limit:
                        # record a_n
                        best[pos-1]=max(best.get(pos-1,0), seq[pos-1])
                        return
                    # try values up to some bound
                    for val in range(1, max_val+1):
                        seq[pos]=val
                        if check(seq[:pos+1], pos):
                            dfs(pos+1, limit)
                    seq[pos]=None
                dfs(2, limit_n)
                return best
            
