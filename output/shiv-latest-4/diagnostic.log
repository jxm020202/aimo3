                fa = h_prec(a, prec=80)
                fb = h_prec(b, prec=80)
                if fa*fb>0:
                    return None
                while b-a>eps:
                    m=(a+b)/2
                    fm=h_prec(m, prec=80)
                    if fa*fm<=0:
                        b=m
                        fb=fm
                    else:
                        a=m
                        fa=fm
