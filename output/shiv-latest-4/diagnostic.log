        >>> Code:
            def compute_vectors(N):
                A = [0]*(N+1)
                B = [0]*(N+1)
                C = [0]*(N+1)
                A[0], B[0], C[0] = 1,0,0
                A[1], B[1], C[1] = 0,1,0
                A[2], B[2], C[2] = 0,0,1
                for i in range(3, N+1):
                    A[i] = 10*A[i-3] - A[i-1] - A[i-2]
                    B[i] = 10*B[i-3] - B[i-1] - B[i-2]
                    C[i] = 10*C[i-3] - C[i-1] - C[i-2]
                return A,B,C
            
            A,B,C = compute_vectors(20)
            list(zip(range(10), A[:10], B[:10], C[:10]))
            
