            def same_side(p1, p2, a, b):
                # returns True if p1 and p2 are on same side of line AB (or both on line)
                v = np.array(b) - np.array(a)
                cp1 = np.cross(v, np.array(p1) - np.array(a))
                cp2 = np.cross(v, np.array(p2) - np.array(a))
                # allow small tolerance
                return cp1*cp2 >= -1e-8
            
            def is_valid_configuration(F,G,H,I,J):
                if not is_convex(F,G,H,I,J):
                    return False
                # diagonal FH interior side: G and I same side of FH
                if not same_side(G, I, F, H):
                    return False
                # diagonal GI interior side: H and J same side of GI
                if not same_side(H, J, G, I):
                    return False
                return True
            
