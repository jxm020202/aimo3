            def count_mod(mod=1000):
                @lru_cache(maxsize=None)
                def dp(idx, active_tuple):
                    # idx: next vertex index to process in order
                    if idx==len(order):
                        # all vertices processed, active should be empty
                        return 1 if not active_tuple else 0
                    v = order[idx]
                    # active dict from edge to color
                    active = dict(active_tuple)
                    # Determine edges of v
                    edges = vertex_edges[v]
                    # Determine which edges already have color (if both ends processed)
                    # For each edge, check if other endpoint already processed (pos < idx)
                    fixed = {}
                    to_assign = []  # edges that are not yet assigned color (active new)
                    for e in edges:
                        other = edge_vertices[e][0] if edge_vertices[e][1]==v else edge_vertices[e][1]
                        if pos_in_order[other] < idx:
                            # other already processed, so edge must have been assigned when that vertex processed and stored in active dict, then should have been removed? Actually when other processed, edge became active (since v not processed yet). It should be in active dict now.
                            if e not in active:
                                # should be active
                                return 0
                            fixed[e]=active[e]
                            # after processing v, this edge will become closed, so will be removed from active later
                        else:
                            # other not processed yet, edge not yet in active dict
                            to_assign.append(e)
                    # Now we need to assign colors to edges in to_assign (new active) and ensure that together with fixed edges, the vertex condition (exactly two same, one different) holds.
                    # We'll iterate over all possible color assignments for to_assign (each 0..2) and check condition.
                    total=0
                    # generate all combos
                    for colors_assign in itertools.product(range(3), repeat=len(to_assign)):
                        # Build list of colors for three edges
                        edge_colors = {}
                        ok=True
                        # assign fixed
                        for e,c in fixed.items():
                            edge_colors[e]=c
                        # assign new
                        for e,c in zip(to_assign, colors_assign):
                            edge_colors[e]=c
                        # check condition at vertex v
                        vals = list(edge_colors.values())
                        if len(set(vals))!=2:
                            continue
                        # Now update active dict for next state:
                        new_active = dict(active)
                        # For edges that become closed (fixed edges), remove them from active
                        for e in fixed:
                            # edge was active, now both ends processed, remove
                            del new_active[e]
                        # For newly assigned edges, add to active with chosen color
                        for e,c in zip(to_assign, colors_assign):
                            new_active[e]=c
                        # recurse
                        total = (total + dp(idx+1, tuple(sorted(new_active.items())))) % mod
                    return total
                return dp(0, tuple())
            print(count_mod(1000))
            
