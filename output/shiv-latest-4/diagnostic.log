            def find_path_with_T(m, target_T):
                n=2**m
                start=0
                # precompute neighbors with length and reciprocal
                neighbors = {v: [] for v in range(n)}
                for v in range(n):
                    for k in range(m):
                        u = v ^ (1<<k)
                        if u!=v:
                            neighbors[v].append((u, 1/(1<<k)))
                best_path=None
                visited=set([start])
                path=[start]
                total=0.0
                target=target_T+1e-9
                def dfs(v,total):
                    nonlocal best_path
                    if len(path)==n:
                        if abs(total-target_T)<1e-9:
                            best_path=path.copy()
                            return True
                        return False
                    # order neighbors maybe by larger length first (smaller reciprocal)
                    for u,rec in sorted(neighbors[v], key=lambda x: x[1]): # smallest reciprocal first
                        if u not in visited:
                            if total+rec > target_T+1e-9:
