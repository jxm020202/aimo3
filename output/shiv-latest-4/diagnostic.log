            def hill_climb_max_distinct(n, iterations=5000):
                best=0
                best_board=None
                cells=[(i,j) for i in range(n) for j in range(n)]
                for _ in range(iterations):
                    board=[[0]*n for _ in range(n)]
                    used=set()
                    for (i,j) in cells:
                        # try assign new color first
                        newcol = max(used)+1 if used else 1
                        candidates=[newcol]
                        # also try existing colors
                        candidates+=list(used)
                        random.shuffle(candidates)
                        placed=False
                        for col in candidates:
                            board[i][j]=col
                            # check any completed 2x2
                            ok=True
                            for a in range(max(0,i-1), min(i, n-1)):
                                for b in range(max(0,j-1), min(j, n-1)):
                                    sq=[board[a][b],board[a+1][b],board[a][b+1],board[a+1][b+1]]
