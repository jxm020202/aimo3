            def is_convex_polygon(F,G,H,I,J):
                pts = [F,G,H,I,J]
                # compute cross product signs
                n = len(pts)
                signs = []
                for i in range(n):
                    a = pts[i]
                    b = pts[(i+1)%n]
                    c = pts[(i+2)%n]
                    ab = (b[0]-a[0], b[1]-a[1])
                    bc = (c[0]-b[0], c[1]-b[1])
                    cross = ab[0]*bc[1] - ab[1]*bc[0]
                    signs.append(cross)
                # convex if all cross have same sign (non-zero)
                pos = [c for c in signs if c > 1e-6]
                neg = [c for c in signs if c < -1e-6]
                return (len(pos)==0 or len(neg)==0) and (len(pos)+len(neg)==len(signs))
            
            def angle_GJH_numeric_full(alpha,beta, sign_f, sign_ig):
                # sign_f for FH rotation (+/-30)
                # sign_ig for IG rotation (+/-30) but we will use -30 for earlier; we can param
                # compute J as intersection of two rays
                a_vec = np.array([1 + math.cos(alpha), math.sin(alpha)])  # FH
                delta_f = sign_f * math.pi/6
                c = math.cos(delta_f); s = math.sin(delta_f)
                u = np.array([c*a_vec[0] - s*a_vec[1], s*a_vec[0] + c*a_vec[1]])  # direction from F
                # IG vector
                I = np.array([1 + math.cos(alpha) + math.cos(beta), math.sin(alpha) + math.sin(beta)])
                G = np.array([1.0, 0.0])
                b_vec = G - I
                delta_ig = sign_ig * math.pi/6
                c2 = math.cos(delta_ig); s2 = math.sin(delta_ig)
                w = np.array([c2*b_vec[0] - s2*b_vec[1], s2*b_vec[0] + c2*b_vec[1]])  # direction from I
                # solve λ*u = I + μ*w
                A = np.column_stack((u, -w))
                try:
                    lam, mu = np.linalg.solve(A, I)
                except np.linalg.LinAlgError:
                    return None
                J = lam * u
                # compute angle GJH
                JG = G - J
                JH = np.array([1 + math.cos(alpha), math.sin(alpha)]) - J
                dot = JG.dot(JH)
                ang = math.acos(dot / (np.linalg.norm(JG)*np.linalg.norm(JH)))
                # convex check
                F = np.array([0.0,0.0])
                convex = is_convex_polygon(F,G, (1+math.cos(alpha), math.sin(alpha)), I, J)
                return ang, convex
            
