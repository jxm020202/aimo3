            import math, itertools, numpy as np
            
            def rotate(vec, deg):
                rad = math.radians(deg)
                c,s = math.cos(rad), math.sin(rad)
                x,y = vec
                return (c*x - s*y, s*x + c*y)
            
            def intersect(p1, d1, p2, d2):
                # solve p1 + t*d1 = p2 + u*d2
                # 2x2 linear
                x1,y1 = p1
                x2,y2 = p2
                dx1,dy1 = d1
                dx2,dy2 = d2
                # solve for t,u
                det = dx1*(-dy2) - (-dx2)*dy1  # actually matrix [[dx1, -dx2],[dy1, -dy2]]
                det = dx1*(-dy2) - (-dx2)*dy1
                # compute using numpy linear solve
                A = np.array([[dx1, -dx2],[dy1, -dy2]], float)
                b = np.array([x2 - x1, y2 - y1], float)
                if abs(np.linalg.det(A))<1e-9:
                    return None
                t,u = np.linalg.solve(A,b)
                return (x1 + t*dx1, y1 + t*dy1)
            
            def angle(p, q, r):
                # angle pqr at q
                v1 = np.array([p[0]-q[0], p[1]-q[1]])
                v2 = np.array([r[0]-q[0], r[1]-q[1]])
                dot = v1.dot(v2)
                n1 = np.linalg.norm(v1)
                n2 = np.linalg.norm(v2)
                if n1*n2==0: return None
                cosang = dot/(n1*n2)
                cosang = max(-1,min(1,cosang))
                return math.degrees(math.acos(cosang))
            
            def compute(alpha, gamma):
                a=1.0
                G = (0.0,0.0)
                F = (a,0.0)
                H = (a*math.cos(math.radians(alpha)), a*math.sin(math.radians(alpha)))  # wait GH direction angle = alpha from x-axis
                # Actually GH length a, direction angle = alpha
                H = (math.cos(math.radians(alpha)), math.sin(math.radians(alpha)))
                I = (H[0] + math.cos(math.radians(alpha+gamma)), H[1] + math.sin(math.radians(alpha+gamma)))
                # vectors
                FH = (H[0]-F[0], H[1]-F[1])
                IG = (G[0]-I[0], G[1]-I[1])
                results=[]
                for signF in [1,-1]:
                    dirF = rotate(FH, signF*30)  # rotate FH by +/-30
                    for signI in [1,-1]:
                        dirI = rotate(IG, signI*30)
                        J = intersect(F, dirF, I, dirI)
                        if J is None: continue
                        # check convexity: compute signed area of polygon F,G,H,I,J
                        poly = [F,G,H,I,J]
                        area = 0
                        for i in range(len(poly)):
                            x1,y1 = poly[i]
                            x2,y2 = poly[(i+1)%len(poly)]
                            area += x1*y2 - x2*y1
                        if area <= 0: # assume CCW positive
                            continue
                        # compute angle GJH
                        ang = angle(G, J, H)
                        results.append((signF,signI,J,ang))
                return results
            
            # sample grid
            vals=set()
            samples=[]
            for alpha in np.linspace(20,140,13):  # plausible range
                for gamma in np.linspace(20,140,13):
                    res=compute(alpha,gamma)
                    for _,_,J,ang in res:
                        vals.add(round(ang,6))
                        samples.append((alpha,gamma,ang))
            len(vals)
            
