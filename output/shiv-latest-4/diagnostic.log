            import math, itertools, numpy as np, sympy as sp
            
            def circle_centers(A, B, alpha_deg=30):
                # returns two possible centers of circle where chord AB subtends angle alpha at circumference
                # radius R = |AB| / (2 sin(alpha))
                # compute midpoint M, vector perpendicular unit
                ax, ay = A
                bx, by = B
                c = math.hypot(bx-ax, by-ay)
                alpha = math.radians(alpha_deg)
                R = c / (2*math.sin(alpha))
                # midpoint
                mx, my = (ax+bx)/2, (ay+by)/2
                # vector from A to B
                vx, vy = bx-ax, by-ay
                # perpendicular unit vector (rotate 90 deg)
                # choose orientation: ( -vy, vx ) normalized
                perp_len = math.hypot(vx, vy)
                ux, uy = -vy/perp_len, vx/perp_len
                # distance from midpoint to center
                d = math.sqrt(max(R*R - (c/2)**2, 0))
                O1 = (mx + ux*d, my + uy*d)
                O2 = (mx - ux*d, my - uy*d)
                return O1, O2, R
            
