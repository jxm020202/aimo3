            from scipy.optimize import fsolve
            
            def solve_J_fsolve(theta, phi, guess):
                # unknowns x,y
                def equations(vars):
                    x, y = vars
                    # vectors
                    FHx, FHy = 1+cos(theta), sin(theta)
                    # FJ
                    FJx, FJy = x, y
                    # IG
                    IGx = 1 - (1+cos(theta)+cos(phi))
                    IGy = - (sin(theta)+sin(phi))
                    # IJ
                    IJx = x - (1+cos(theta)+cos(phi))
                    IJy = y - (sin(theta)+sin(phi))
                    # cos30
                    c30 = sqrt(3)/2
                    # eq1
                    dot1 = FHx*FJx + FHy*FJy
                    normFH = sqrt(FHx**2 + FHy**2)
                    normFJ = sqrt(FJx**2 + FJy**2)
                    eq1 = dot1/(normFH*normFJ) - c30
                    # eq2
                    dot2 = IGx*IJx + IGy*IJy
                    normIG = sqrt(IGx**2 + IGy**2)
                    normIJ = sqrt(IJx**2 + IJy**2)
                    eq2 = dot2/(normIG*normIJ) - c30
                    return (eq1, eq2)
                sol, info, ier, mesg = fsolve(equations, guess, full_output=True)
                if ier == 1:
                    return sol
                else:
                    return None
            
