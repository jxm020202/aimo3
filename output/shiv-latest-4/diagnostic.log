            def coeffs_up_to(N):
                # return list of tuples (a,b,c) for r^i = a + b r + c r^2
                coeffs = [(1,0,0), (0,1,0), (0,0,1)]
                for n in range(0, N-2):
                    a_n,b_n,c_n = coeffs[n]
                    a_n1,b_n1,c_n1 = coeffs[n+1]
                    a_n2,b_n2,c_n2 = coeffs[n+2]
