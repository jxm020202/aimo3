            def solve_J(theta, psi):
                # define symbols
                x, y = sp.symbols('x y', real=True)
                # coordinates
                a = 1.0
                F = sp.Point(0,0)
                G = sp.Point(1,0)
                H = sp.Point(1+sp.cos(theta), sp.sin(theta))
                I = sp.Point(1+sp.cos(theta)+sp.cos(psi), sp.sin(theta)+sp.sin(psi))
                # vectors
                IG = sp.Matrix([G.x - I.x, G.y - I.y])
                IJ = sp.Matrix([x - I.x, y - I.y])
                JF = sp.Matrix([x - F.x, y - F.y])  # J - F
                FH = sp.Matrix([H.x - F.x, H.y - F.y])
                # angle cosines
                cos30 = sp.sqrt(3)/2
                eq1 = (IG.dot(IJ)) / (sp.sqrt(IG.dot(IG))*sp.sqrt(IJ.dot(IJ))) - cos30
                eq2 = (JF.dot(FH)) / (sp.sqrt(JF.dot(JF))*sp.sqrt(FH.dot(FH))) - cos30
                # Use nsolve with initial guess
                solutions = []
                # try multiple initial guesses
                for guess in [(0.5,0.5), (1,1), (-0.5,0.5), (0.5,-0.5), (2,0.5), (0.5,2)]:
                    try:
                        sol = sp.nsolve([eq1, eq2], [x, y], guess, tol=1e-14, maxsteps=100)
                        sol = (float(sol[0]), float(sol[1]))
                        # round to avoid duplicates
                        if not any(np.allclose(sol, s, atol=1e-6) for s in solutions):
                            solutions.append(sol)
                    except Exception as e:
                        pass
                return solutions
            
