            def compute_angle_prec(phi_val, psi_val, prec=50):
                phi, psi, x, y = sp.symbols('phi psi x y', real=True)
                cos30 = sp.sqrt(3)/2
                xH = 1 + sp.cos(phi)
                yH = sp.sin(phi)
                xI = 1 + sp.cos(phi) + sp.cos(psi)
                yI = sp.sin(phi) + sp.sin(psi)
                FH = sp.Matrix([xH, yH])
                FJ = sp.Matrix([x, y])
                IG = sp.Matrix([1 - xI, -yI])
                IJ = sp.Matrix([x - xI, y - yI])
                eq1 = FH.dot(FJ) - cos30*sp.sqrt(FH.dot(FH))*sp.sqrt(FJ.dot(FJ))
                eq2 = IG.dot(IJ) - cos30*sp.sqrt(IG.dot(IG))*sp.sqrt(IJ.dot(IJ))
                # numeric solve
                eqs = [eq1.subs({phi:phi_val, psi:psi_val}), eq2.subs({phi:phi_val, psi:psi_val})]
                guess = (0.5,0.5)
                sol = sp.nsolve(eqs, [x, y], guess, tol=1e-30, maxsteps=200, prec=prec)
                xj = sp.N(sol[0], prec)
                yj = sp.N(sol[1], prec)
                # compute angle
                G = sp.Point(1,0)
                H = sp.Point(1+sp.cos(phi_val), sp.sin(phi_val))
                J = sp.Point(xj, yj)
                # vector JG, JH
                JG = sp.Matrix([G.x - J.x, G.y - J.y])
                JH = sp.Matrix([H.x - J.x, H.y - J.y])
                dot = JG.dot(JH)
                ang = sp.acos(dot/(sp.sqrt(JG.dot(JG))*sp.sqrt(JH.dot(JH))))
                return sp.N(ang*180/sp.pi, prec)
            
            phi_val = math.radians(60)
            psi_val = math.radians(120)
            print(compute_angle_prec(phi_val, psi_val, prec=80))
            
