            def small_interval_for_large(L):
                # solve quadratic for s given L as larger (a)
                a=L
                # coefficients for quadratic in s: (3 - a^2)s^2 -8 a s + (3 a^2 -1) >=0
                A=3 - a*a
                B=-8*a
                C=3*a*a -1
