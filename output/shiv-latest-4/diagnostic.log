            from fractions import Fraction
            
            def coeffs(n):
                # return tuple (c0,c1,c2) integers
                if n==0:
                    return (1,0,0)
                if n==1:
                    return (0,1,0)
                if n==2:
                    return (0,0,1)
                # use recurrence
                c = {}
                c[0]=(1,0,0)
                c[1]=(0,1,0)
                c[2]=(0,0,1)
                for i in range(3,n+1):
                    a0,a1,a2 = c[i-1]
                    b0,b1,b2 = c[i-2]
                    d0,d1,d2 = c[i-3]
                    # r^i = -r^{i-1} - r^{i-2} + 10 r^{i-3}
                    c[i] = ( -a0 - b0 + 10*d0,
                             -a1 - b1 + 10*d1,
                             -a2 - b2 + 10*d2 )
                return c[n]
            
