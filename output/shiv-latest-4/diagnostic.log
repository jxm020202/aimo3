            def gray_cycle(n):
                # returns list of 2^n vertices forming Hamiltonian cycle (last to first also edge)
                if n==0:
                    return [0]
                # recursion: G = 0 G(n-1) , 1 reverse(G(n-1))
                prev = gray_cycle(n-1)
                first = [v for v in prev]
                second = [(v | (1<<(n-1)) ) for v in reversed(prev)]
                return first + second
            
            def build_opt_path(n):
                # recursive construction using Gray cycles
                if n==0:
                    return [0]
                # even subcube path: need Hamiltonian path from 0 to some vertex a (choose a = 0? we need end a such that we can connect)
                # We'll use Gray cycle of n-1 to get a path that starts at 0 and ends at vertex with only highest bit set (2^{n-2})
                # Actually Gray cycle list length 2^{n-1}; we can take it as path (cut edge between last and first)
                cycle = gray_cycle(n-1)
                # path_even = cycle as is (starting at 0)
                even_path = [v<<1 for v in cycle]  # prepend 0 LSB
                # end vertex of even_path
                a = even_path[-1]
                # crossing edge length 1 to odd start
                odd_start = a | 1
                # need odd subcube path starting at odd_start covering all odd vertices.
                # Use same gray_cycle, rotate so that it starts at 0 (mapped) then shift and add 1.
                # Actually we can take cycle and rotate so that it starts at 0 (which maps to odd_start after adding 1)
                # Since cycle starts at 0, mapping gives start = 1, not odd_start unless a==0.
                # So we need to rotate cycle to start at (odd_start>>1) which is a>>1 (since odd_start = (a)+1, and a is even)
                start_idx = cycle.index(a>>1)  # a>>1 is the vertex in subcube corresponding to a
                rotated = cycle[start_idx:] + cycle[:start_idx]
                odd_path = [(v<<1)|1 for v in rotated]
                # combine
                return even_path + odd_path
            
