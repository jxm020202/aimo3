            def is_convex(poly):
                # poly list of points in order
                n=len(poly)
                sign=None
                for i in range(n):
                    p0=poly[i]
                    p1=poly[(i+1)%n]
                    p2=poly[(i+2)%n]
                    # vectors
                    v1 = sp.Matrix([p1.x-p0.x, p1.y-p0.y])
                    v2 = sp.Matrix([p2.x-p1.x, p2.y-p1.y])
                    cross = v1[0]*v2[1]-v1[1]*v2[0]
                    if cross!=0:
                        cur = sp.sign(cross)
                        if sign is None:
                            sign=cur
                        elif cur!=sign:
                            return False
                return True
            
