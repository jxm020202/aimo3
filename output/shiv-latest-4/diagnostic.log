                # Helper functions
                def domain_size(mask):
                    return (mask & 1) + ((mask>>1)&1) + ((mask>>2)&1)
                
                def get_single_color(mask):
                    # assumes size 1
                    for c in range(3):
                        if mask == (1<<c):
                            return c
                    # if mask has single bit
                    for c in range(3):
                        if mask & (1<<c):
                            return c
                    return None
                
