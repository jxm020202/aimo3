            def max_colors_upper(N, required):
                maxC=0
                for C in range(1,N+1):
                    a = N//C
                    r = N - a*C
                    # a = floor(N/C)
                    # sizes: r colors size a+1, rest size a
                    P = r * ((a+1)*a)//2 + (C - r) * (a*(a-1))//2
                    if P >= required:
                        maxC = C
                return maxC
            
