            def find_path_target_counts(n):
                N=1<<n
                target=[2**k for k in range(n)]  # counts per k
                adj=[[] for _ in range(N)]
                for i in range(N):
                    for k in range(n):
                        adj[i].append(i^(1<<k))
                visited=[False]*N
                visited[0]=True
                path=[0]
                counts=[0]*n
                def dfs(v):
                    if len(path)==N:
                        return True
                    # order neighbors by larger jump first maybe
                    # sort by k descending
                    neighbors=sorted(adj[v], key=lambda nb: -(v^nb).bit_length())
                    for nb in neighbors:
                        if not visited[nb]:
                            diff=v^nb
                            k=diff.bit_length()-1
                            if counts[k]>=target[k]:
                                continue
                            visited[nb]=True
                            path.append(nb)
                            counts[k]+=1
                            if dfs(nb):
                                return True
                            counts[k]-=1
                            path.pop()
                            visited[nb]=False
                    return False
                success=dfs(0)
                return success, path, counts
            
