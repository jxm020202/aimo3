            def circle_center_and_radius(p1, p2, side=1):
                p1 = np.array(p1, dtype=float)
                p2 = np.array(p2, dtype=float)
                mid = (p1 + p2)/2.0
                d = np.linalg.norm(p2 - p1)
                R = d
                v = p2 - p1
                perp = np.array([-v[1], v[0]])
                perp_norm = np.linalg.norm(perp)
                if perp_norm == 0:
                    return None, None
                perp_unit = perp / perp_norm
                h = math.sqrt(R**2 - (d/2.0)**2)
                O = mid + side * h * perp_unit
                return O, R
            
            def circle_intersections(O1,R1,O2,R2):
                d = np.linalg.norm(O2 - O1)
                if d > R1 + R2 + 1e-9 or d < abs(R1 - R2) - 1e-9:
                    return []
                if d == 0:
                    return []
                a = (R1**2 - R2**2 + d**2) / (2*d)
                h_sq = R1**2 - a**2
                if h_sq < -1e-9:
                    return []
                h = math.sqrt(max(h_sq, 0.0))
                P2 = O1 + a * (O2 - O1) / d
                offset = h * np.array([-(O2[1]-O1[1])/d, (O2[0]-O1[0])/d])
                inter1 = P2 + offset
                inter2 = P2 - offset
                if np.allclose(inter1, inter2):
                    return [inter1]
                else:
                    return [inter1, inter2]
            
            def cross(o,a,b):
                return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
            
            def is_convex_polygon(pts):
                n = len(pts)
                signs = []
                for i in range(n):
                    cp = cross(pts[i], pts[(i+1)%n], pts[(i+2)%n])
                    signs.append(cp)
                pos = [s for s in signs if s > 1e-8]
                neg = [s for s in signs if s < -1e-8]
                return (len(pos)==len(signs)) or (len(neg)==len(signs))
            
            def all_solutions(theta_val, phi_val):
                F = np.array([0.0,0.0])
                G = np.array([1.0,0.0])
                H = np.array([1.0 + math.cos(theta_val), math.sin(theta_val)])
                I = np.array([H[0] + math.cos(theta_val+phi_val), H[1] + math.sin(theta_val+phi_val)])
                sols = []
                for side1 in [+1, -1]:
                    O1,R1 = circle_center_and_radius(I, G, side=side1)
                    for side2 in [+1, -1]:
                        O2,R2 = circle_center_and_radius(F, H, side=side2)
                        inters = circle_intersections(O1,R1,O2,R2)
                        for J in inters:
                            if is_convex_polygon([F,G,H,I,J]):
                                v1 = G - J
                                v2 = H - J
                                dot = np.dot(v1, v2)
                                ang = math.degrees(math.acos(dot/(np.linalg.norm(v1)*np.linalg.norm(v2))))
                                sols.append((ang, J, side1, side2))
                return sols
            
