,{"stream_name":"stdout","time":4263.832690095,"data":"       | \\log_x(y^{x})=10,\\qquad \\log_y(x^{4y})=10 ,\\qquad x\u003e1,\\;y\u003e1 .\n"}
,{"stream_name":"stdout","time":4263.832691584,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4263.832692619,"data":"       | \n"}
,{"stream_name":"stdout","time":4263.832693626,"data":"       | Using \\(\\log_a b=\\dfrac{\\ln b}{\\ln a}\\),\n"}
,{"stream_name":"stdout","time":4263.832694908,"data":"       | \n"}
,{"stream_name":"stdout","time":4263.832752506,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4263.832753979,"data":"       | \\frac{\\ln(y^{x})}{\\ln x}=10\\quad\\Longrightarrow\\quad\n"}
