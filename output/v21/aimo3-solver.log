,{"stream_name":"stdout","time":4070.70013892,"data":"       |     omega = len(factorint(m))  # number of distinct primes\n"}
,{"stream_name":"stdout","time":4070.700140161,"data":"       |     return 2**omega - 2 if omega\u003e0 else 0\n"}
