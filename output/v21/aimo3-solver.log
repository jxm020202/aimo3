,{"stream_name":"stdout","time":4137.332255527,"data":"       | ### 1.  Choose the unique consecutive pair  \n"}
,{"stream_name":"stdout","time":4137.332256618,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332257628,"data":"       | There are  \n"}
