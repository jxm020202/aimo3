,{"stream_name":"stdout","time":4291.707437485,"data":"       | relates the values \\(f(x)\\) and \\(f(1-x)\\).  \n"}
,{"stream_name":"stdout","time":4291.707438871,"data":"       | Write the same equation with \\(x\\) replaced by \\(1-x\\):\n"}
,{"stream_name":"stdout","time":4291.70744036,"data":"       | \n"}
