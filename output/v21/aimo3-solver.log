,{"stream_name":"stdout","time":4291.708589932,"data":"       | Finally,\n"}
,{"stream_name":"stdout","time":4291.708591054,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.708592136,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4291.708594952,"data":"       | \\alpha^{2}= \\left(\\frac{1+\\sqrt5}{2}\\right)^{2}= \\frac{3+\\sqrt5}{2},\n"}
,{"stream_name":"stdout","time":4291.708596599,"data":"       | \\qquad\n"}
,{"stream_name":"stdout","time":4291.708597736,"data":"       | \\beta^{2}= \\left(\\frac{1-\\sqrt5}{2}\\right)^{2}= \\frac{3-\\sqrt5}{2},\n"}
,{"stream_name":"stdout","time":4291.708599139,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4291.708600232,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.70860132,"data":"       | so\n"}
,{"stream_name":"stdout","time":4291.708602431,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.70860352,"data":"       | \\[\n"}
