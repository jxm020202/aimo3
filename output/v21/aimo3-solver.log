,{"stream_name":"stdout","time":4137.332263308,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.33226432,"data":"       | possible choices for the unique pair \\(\\{i,i+1\\}\\).\n"}
,{"stream_name":"stdout","time":4137.332265553,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332266587,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4137.332267754,"data":"       | ### 2.  Elements that cannot be taken  \n"}
,{"stream_name":"stdout","time":4137.332268892,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332269922,"data":"       | When the pair \\(\\{i,i+1\\}\\) is chosen we must also forbid the numbers\n"}
,{"stream_name":"stdout","time":4137.332271198,"data":"       | adjacent to it, otherwise another consecutive pair would appear.  \n"}
,{"stream_name":"stdout","time":4137.332272373,"data":"       | Thus the numbers  \n"}
,{"stream_name":"stdout","time":4137.33227347,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332274473,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4137.332275537,"data":"       | i-1\\;( \\text{if }i\u003e1),\\qquad i+2\\;(\\text{if }i+1\u003c10)\n"}
,{"stream_name":"stdout","time":4137.332278593,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4137.332279689,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332280731,"data":"       | cannot belong to the subset.\n"}
,{"stream_name":"stdout","time":4137.332281821,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332282893,"data":"       | Consequently the remaining admissible elements form two separated\n"}
,{"stream_name":"stdout","time":4137.332284058,"data":"       | blocks:\n"}
,{"stream_name":"stdout","time":4137.332285126,"data":"       | \n"}
,{"stream_name":"stdout","time":4137.332286151,"data":"       | * left block : \\(\\{1,2,\\dots ,i-2\\}\\) – length \\(L_{\\text{L}}=\\max(0,i-2)\\);\n"}
,{"stream_name":"stdout","time":4137.33228763,"data":"       | * right block : \\(\\{i+3,i+4,\\dots ,10\\}\\) – length \\(L_{\\text{R}}=\\max(0,8-i)\\).\n"}
