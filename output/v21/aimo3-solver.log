,{"stream_name":"stdout","time":4291.70743382,"data":"       | x^{2}f(x)+f(1-x)=-x^{4}+2x \\qquad (\\forall x\\in\\mathbb R)\n"}
,{"stream_name":"stdout","time":4291.707435272,"data":"       | \\]\n"}
