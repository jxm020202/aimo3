,{"stream_name":"stdout","time":4291.707474358,"data":"       | If \\(\\det M\\neq0\\) the system has a unique solution:\n"}
,{"stream_name":"stdout","time":4291.707475906,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.707477009,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4291.707478116,"data":"       | f(x)=\\frac{(1-x)^{2}A(x)-B(x)}{\\det M}=1-x^{2}.\n"}
,{"stream_name":"stdout","time":4291.707479422,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4291.707480484,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.7074816,"data":"       | Hence \\(f(x)=1-x^{2}\\) for every \\(x\\) with \\(\\det M\\neq0\\).\n"}
,{"stream_name":"stdout","time":4291.70748306,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.707484133,"data":"       | ---\n"}
,{"stream_name":"stdout","time":4291.70748522,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.70748633,"data":"       | ### When is the determinant\n"}
,{"stream_name":"stdout","time":4291.707487463,"data":"\n"}
