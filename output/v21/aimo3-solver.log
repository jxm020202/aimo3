,{"stream_name":"stdout","time":4263.832082729,"data":"       | 4 e^b = 100 / e^a.\n"}
,{"stream_name":"stdout","time":4263.832083756,"data":"       | \n"}
,{"stream_name":"stdout","time":4263.832084732,"data":"       | =\u003e e^b = 25 / e^a.\n"}
