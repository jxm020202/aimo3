,{"stream_name":"stdout","time":4291.707592806,"data":"       | x=sp.symbols('x')\n"}
,{"stream_name":"stdout","time":4291.707593951,"data":"       | expr = -x**4 + 2*x - ( -x**2*(1-x)**4 + 2*x**2*(1-x) )\n"}
