,{"stream_name":"stdout","time":4263.832291272,"data":"       | \\log_x (y^{x}) = 10 \u0026\\Longrightarrow y^{x}=x^{10},\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4263.832292606,"data":"       | \\log_y (x^{4y}) = 10 \u0026\\Longrightarrow x^{4y}=y^{10}.\n"}
