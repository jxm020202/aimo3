,{"stream_name":"stdout","time":4263.832757772,"data":"       | \n"}
,{"stream_name":"stdout","time":4263.832758758,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4263.832759786,"data":"       | \\frac{\\ln(x^{4y})}{\\ln y}=10\\quad\\Longrightarrow\\quad\n"}
