,{"stream_name":"stdout","time":4291.707448328,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4291.707449525,"data":"       | \\begin{cases}\n"}
,{"stream_name":"stdout","time":4291.707450675,"data":"       | x^{2}f(x)+f(1-x)=A(x),\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4291.707451895,"data":"       | f(x)+(1-x)^{2}f(1-x)=B(x),\n"}
,{"stream_name":"stdout","time":4291.707453037,"data":"       | \\end{cases}\n"}
,{"stream_name":"stdout","time":4291.707454164,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4291.707455265,"data":"       | \n"}
,{"stream_name":"stdout","time":4291.707456321,"data":"       | where  \n"}
