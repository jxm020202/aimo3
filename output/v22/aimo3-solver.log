,{"stream_name":"stdout","time":4322.292451182,"data":"       | # Rotation matrix applied to vector v = (vx, vy): (c*vx - s*vy, s*vx + c*vy)\n"}
,{"stream_name":"stdout","time":4322.292452347,"data":"       | def rotate(vec):\n"}
,{"stream_name":"stdout","time":4322.292453392,"data":"       |     vx, vy = vec\n"}
,{"stream_name":"stdout","time":4322.292454482,"data":"       |     return sp.Matrix([c*vx - s*vy, s*vx + c*vy])\n"}
,{"stream_name":"stdout","time":4322.292455589,"data":"       | \n"}
,{"stream_name":"stdout","time":4322.292456602,"data":"       | # Vectors EA, FB, DC as sympy matrices\n"}
,{"stream_name":"stdout","time":4322.292457713,"data":"       | EA_vec = sp.Matrix([EA[0], EA[1]])  # EA components\n"}
,{"stream_name":"stdout","time":4322.292458847,"data":"       | FB_vec = sp.Matrix([FB[0], FB[1]])\n"}
,{"stream_name":"stdout","time":4322.292459927,"data":"       | DC_vec = sp.Matrix([DC[0], DC[1]])\n"}
,{"stream_name":"stdout","time":4322.292461002,"data":"       | \n"}
,{"stream_name":"stdout","time":4322.292462007,"data":"       | # Points coordinates as sympy numbers\n"}
,{"stream_name":"stdout","time":4322.292463103,"data":"       | E_pt = sp.Matrix([E.x, E.y])\n"}
,{"stream_name":"stdout","time":4322.292464174,"data":"       | F_pt = sp.Matrix([F.x, F.y])\n"}
,{"stream_name":"stdout","time":4322.29246526,"data":"       | D_pt = sp.Matrix([D.x, D.y])\n"}
,{"stream_name":"stdout","time":4322.292466385,"data":"       | \n"}
