,{"stream_name":"stdout","time":4611.658126215,"data":"       | e^{b e^{a}} = e^{10a}\\;\\Longrightarrow\\; b e^{a}=10a, \\tag{2}\n"}
,{"stream_name":"stdout","time":4611.658127465,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658128511,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658129559,"data":"       | e^{4a e^{b}} = e^{10b}\\;\\Longrightarrow\\; 4a e^{b}=10b. \\tag{3}\n"}
,{"stream_name":"stdout","time":4611.658130806,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658131825,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658132828,"data":"       | ---\n"}
,{"stream_name":"stdout","time":4611.658133852,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658134874,"data":"       | ### 2.  Solve the system for \\(a,b\\)\n"}
,{"stream_name":"stdout","time":4611.658136024,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658137031,"data":"       | From (2)  \n"}
,{"stream_name":"stdout","time":4611.658138058,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658139069,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658140094,"data":"       | b = 10a\\,e^{-a}. \\tag{4}\n"}
,{"stream_name":"stdout","time":4611.658141232,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658142269,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658143257,"data":"       | Insert (4) into (3):\n"}
,{"stream_name":"stdout","time":4611.658144289,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658145269,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658146295,"data":"       | 4a e^{\\,b}=10b\n"}
,{"stream_name":"stdout","time":4611.658147498,"data":"       | \\Longrightarrow 4a e^{\\,10a e^{-a}} = 10\\bigl(10a e^{-a}\\bigr).\n"}
,{"stream_name":"stdout","time":4611.658148808,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658149844,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658150853,"data":"       | Dividing by \\(a\u003e0\\) and simplifying gives  \n"}
,{"stream_name":"stdout","time":4611.658152053,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658153042,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658154136,"data":"       | e^{\\,b}=25\\,e^{-a}. \\tag{5}\n"}
,{"stream_name":"stdout","time":4611.658155272,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658156301,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658158519,"data":"       | Taking natural logs of (5) yields  \n"}
,{"stream_name":"stdout","time":4611.658159664,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658160677,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658165289,"data":"       | b = \\ln 25 - a. \\tag{6}\n"}
,{"stream_name":"stdout","time":4611.658166512,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658167535,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658168541,"data":"       | Equating (4) and (6):\n"}
,{"stream_name":"stdout","time":4611.658169603,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658170605,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658171684,"data":"       | 10a e^{-a}= \\ln 25 - a .\n"}
,{"stream_name":"stdout","time":4611.658172815,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658173809,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658174832,"data":"       | This equation has a unique positive solution  \n"}
,{"stream_name":"stdout","time":4611.658175942,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658176956,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658177987,"data":"       | a\\approx 0.4282375577,\n"}
,{"stream_name":"stdout","time":4611.658179088,"data":"       | \\qquad b = \\ln 25 - a \\approx 2.7906382672 .\n"}
,{"stream_name":"stdout","time":4611.658180299,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658181308,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658182502,"data":"       | ---\n"}
,{"stream_name":"stdout","time":4611.658183595,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658184664,"data":"       | ### 3.  Compute \\(xy\\)\n"}
,{"stream_name":"stdout","time":4611.658185889,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658186974,"data":"       | Since \\(x=e^{a}\\) and \\(y=e^{b}\\),\n"}
,{"stream_name":"stdout","time":4611.658188253,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658189398,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658190491,"data":"       | \\ln (xy)=\\ln x+\\ln y = a+b = \\ln 25 .\n"}
,{"stream_name":"stdout","time":4611.658191741,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658192836,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658193915,"data":"       | Hence  \n"}
,{"stream_name":"stdout","time":4611.658195052,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658196128,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658197228,"data":"       | xy = e^{\\ln 25}=25 .\n"}
,{"stream_name":"stdout","time":4611.658198423,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658199522,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658200594,"data":"       | ---\n"}
,{"stream_name":"stdout","time":4611.658201692,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.658202766,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.658203856,"data":"       | \\boxed{25}\n"}
,{"stream_name":"stdout","time":4611.658205004,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.658206099,"data":"\n"}
