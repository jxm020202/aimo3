,{"stream_name":"stdout","time":3925.869869953,"data":"       |         for _ in range(n*n):\n"}
,{"stream_name":"stdout","time":3925.869871127,"data":"       |             if cur in visited:\n"}
,{"stream_name":"stdout","time":3925.869872289,"data":"       |                 break\n"}
