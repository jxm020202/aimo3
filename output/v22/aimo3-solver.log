,{"stream_name":"stdout","time":4140.191303571,"data":"       | K = sp.Symbol('K')\n"}
,{"stream_name":"stdout","time":4140.191304735,"data":"       | area_expr = b0 + (1/q)*(K*1 - p/2*1**2 - (K*b0 - p/2*b0**2))\n"}
