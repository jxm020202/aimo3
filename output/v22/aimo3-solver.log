,{"stream_name":"stdout","time":4452.668949334,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.668950537,"data":"       | x,y,z = sp.symbols('x y z', positive=True, real=True)\n"}
,{"stream_name":"stdout","time":4452.66895169,"data":"       | eq1 = sp.sqrt(x*(2-y)) + sp.sqrt(y*(2-x)) - 1\n"}
,{"stream_name":"stdout","time":4452.66895277,"data":"       | eq2 = sp.sqrt(y*(2-z)) + sp.sqrt(z*(2-y)) - sp.sqrt(2)\n"}
,{"stream_name":"stdout","time":4452.668953894,"data":"       | eq3 = sp.sqrt(z*(2-x)) + sp.sqrt(x*(2-z)) - sp.sqrt(3)\n"}
,{"stream_name":"stdout","time":4452.66895502,"data":"       | sol = sp.nsolve((eq1, eq2, eq3), (x,y,z), (0.5,0.5,0.5))\n"}
