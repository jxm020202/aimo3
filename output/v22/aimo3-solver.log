,{"stream_name":"stdout","time":4372.46240034,"data":"       |    =(\\mathbf{p}\\!\\cdot\\!\\mathbf{q})^{2}\\,|\\mathbf{u}|^{2}|\\mathbf{v}|^{2}.\n"}
