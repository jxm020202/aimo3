,{"stream_name":"stdout","time":3925.871856961,"data":"       |     N=m*n\n"}
,{"stream_name":"stdout","time":3925.871858117,"data":"       |     # encode vertices as indices 0..N-1\n"}
,{"stream_name":"stdout","time":3925.871859326,"data":"       |     verts=[(i,j) for i in range(m) for j in range(n)]\n"}
,{"stream_name":"stdout","time":3925.871860599,"data":"       |     # mapping from vertex to possible images\n"}
,{"stream_name":"stdout","time":3925.871861835,"data":"       |     succ={}\n"}
,{"stream_name":"stdout","time":3925.871862988,"data":"       |     for idx,(i,j) in enumerate(verts):\n"}
,{"stream_name":"stdout","time":3925.871864182,"data":"       |         succ[idx]=[((i+1)%m,j),(i,(j+1)%n)]\n"}
,{"stream_name":"stdout","time":3925.871865377,"data":"       |     # brute force permutations via backtracking\n"}
,{"stream_name":"stdout","time":3925.871866612,"data":"       |     count=0\n"}
,{"stream_name":"stdout","time":3925.87186776,"data":"       |     used=[False]*N\n"}
,{"stream_name":"stdout","time":3925.87186892,"data":"       |     perm=[None]*N\n"}
,{"stream_name":"stdout","time":3925.871870059,"data":"       |     # order of assignment: maybe recursion\n"}
,{"stream_name":"stdout","time":3925.871871311,"data":"       |     def backtrack(k):\n"}
,{"stream_name":"stdout","time":3925.87187248,"data":"       |         nonlocal count\n"}
,{"stream_name":"stdout","time":3925.871873617,"data":"       |         if k==N:\n"}
,{"stream_name":"stdout","time":3925.871874762,"data":"       |             count+=1\n"}
,{"stream_name":"stdout","time":3925.871875919,"data":"       |             return\n"}
,{"stream_name":"stdout","time":3925.871877086,"data":"       |         # choose next vertex index\n"}
,{"stream_name":"stdout","time":3925.871878355,"data":"       |         # we can simply iterate over all vertices not assigned yet\n"}
,{"stream_name":"stdout","time":3925.87187963,"data":"       |         # but we also need to ensure bijection (incoming unique)\n"}
,{"stream_name":"stdout","time":3925.871880918,"data":"       |         # We'll assign mapping for vertex k in order\n"}
,{"stream_name":"stdout","time":3925.87188217,"data":"       |         # However we must ensure that target not already taken\n"}
,{"stream_name":"stdout","time":3925.871883422,"data":"       |         for t in succ[k]:\n"}
,{"stream_name":"stdout","time":3925.871884597,"data":"       |             target=verts.index(t)\n"}
,{"stream_name":"stdout","time":3925.871885775,"data":"       |             if not used[target]:\n"}
,{"stream_name":"stdout","time":3925.871886985,"data":"       |                 used[target]=True\n"}
,{"stream_name":"stdout","time":3925.871888162,"data":"       |                 perm[k]=target\n"}
,{"stream_name":"stdout","time":3925.871889323,"data":"       |                 backtrack(k+1)\n"}
,{"stream_name":"stdout","time":3925.87189054,"data":"       |                 used[target]=False\n"}
,{"stream_name":"stdout","time":3925.871891724,"data":"       |     # This is O(N! ) huge quickly. Not feasible for N\u003e6.\n"}
,{"stream_name":"stdout","time":3925.871894603,"data":"       |     return None\n"}
