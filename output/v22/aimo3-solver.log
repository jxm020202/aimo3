,{"stream_name":"stdout","time":3925.869814283,"data":"       | def find_hamiltonian_cycles(n):\n"}
,{"stream_name":"stdout","time":3925.869815471,"data":"       |     vertices = [(i,j) for i in range(n) for j in range(n)]\n"}
,{"stream_name":"stdout","time":3925.869816684,"data":"       |     start = (0,0)\n"}
,{"stream_name":"stdout","time":3925.869817867,"data":"       |     # generate all permutations of vertices except start? Actually we need sequence of length n*n moves, visiting each vertex exactly once after each move, ending at start.\n"}
,{"stream_name":"stdout","time":3925.869819335,"data":"       |     # Equivalent to Hamiltonian cycle starting at start.\n"}
,{"stream_name":"stdout","time":3925.869820561,"data":"       |     # We'll brute force using backtracking.\n"}
,{"stream_name":"stdout","time":3925.869821743,"data":"       |     N = n*n\n"}
,{"stream_name":"stdout","time":3925.869822844,"data":"       |     visited = {start}\n"}
,{"stream_name":"stdout","time":3925.869824081,"data":"       |     path = [start]\n"}
,{"stream_name":"stdout","time":3925.869825211,"data":"       |     cycles = []\n"}
,{"stream_name":"stdout","time":3925.869826336,"data":"       |     # adjacency: from v we can go to (v[0]+1 mod n, v[1]) or (v[0], v[1]+1 mod n)\n"}
,{"stream_name":"stdout","time":3925.869827643,"data":"       |     def backtrack(current):\n"}
,{"stream_name":"stdout","time":3925.869828805,"data":"       |         if len(path) == N:\n"}
,{"stream_name":"stdout","time":3925.869830165,"data":"       |             # need to return to start in one more move? Actually after N moves we should be at start. Since we have visited N distinct vertices (including start?), we started at start (visited start), then we made N-1 moves to visit other N-1 vertices, then final move returns to start. But problem says 144 moves and each configuration appears exactly once after each move, including final start. So visited set includes start only at end, not at start. So we need to treat differently.\n"}
,{"stream_name":"stdout","time":3925.869832119,"data":"       |             pass\n"}
,{"stream_name":"stdout","time":3925.869833281,"data":"       |     # Let's brute force differently: generate a permutation sigma of vertices (size N) such that sigma(v) is successor, each vertex has outdegree 1, indegree 1, and sigma(v) is either east or north neighbor.\n"}
,{"stream_name":"stdout","time":3925.869834801,"data":"       |     # This is exactly our earlier functional digraph condition. So we can enumerate all assignments of direction per vertex (2^N) and test if indegree 1 and single cycle.\n"}
,{"stream_name":"stdout","time":3925.869836229,"data":"       |     # For n=2, N=4, 2^4=16 possibilities, easy.\n"}
,{"stream_name":"stdout","time":3925.869837417,"data":"       |     from itertools import product\n"}
,{"stream_name":"stdout","time":3925.869838563,"data":"       |     dirs = list(product([0,1], repeat=n*n))\n"}
,{"stream_name":"stdout","time":3925.869839724,"data":"       |     # map index to vertex\n"}
,{"stream_name":"stdout","time":3925.869840867,"data":"       |     idx_to_vert = {i: (i//n, i % n) for i in range(n*n)}\n"}
,{"stream_name":"stdout","time":3925.869843536,"data":"       |     vert_to_idx = {v:i for i,v in idx_to_vert.items()}\n"}
,{"stream_name":"stdout","time":3925.869844753,"data":"       |     count=0\n"}
,{"stream_name":"stdout","time":3925.869845909,"data":"       |     for bits in dirs:\n"}
,{"stream_name":"stdout","time":3925.869847033,"data":"       |         # bits[i] = direction for vertex idx i (0 east,1 north)\n"}
,{"stream_name":"stdout","time":3925.869848251,"data":"       |         # compute indegree counts\n"}
,{"stream_name":"stdout","time":3925.869849429,"data":"       |         indeg = [0]* (n*n)\n"}
,{"stream_name":"stdout","time":3925.869850617,"data":"       |         ok=True\n"}
,{"stream_name":"stdout","time":3925.869851757,"data":"       |         for i,bit in enumerate(bits):\n"}
,{"stream_name":"stdout","time":3925.869852906,"data":"       |             i_vert = idx_to_vert[i]\n"}
,{"stream_name":"stdout","time":3925.869854056,"data":"       |             if bit==0:\n"}
,{"stream_name":"stdout","time":3925.869855217,"data":"       |                 succ = ((i_vert[0]+1)%n, i_vert[1])\n"}
,{"stream_name":"stdout","time":3925.869856412,"data":"       |             else:\n"}
,{"stream_name":"stdout","time":3925.869857523,"data":"       |                 succ = (i_vert[0], (i_vert[1]+1)%n)\n"}
,{"stream_name":"stdout","time":3925.869858701,"data":"       |             succ_idx = vert_to_idx[succ]\n"}
,{"stream_name":"stdout","time":3925.869859885,"data":"       |             indeg[succ_idx] += 1\n"}
,{"stream_name":"stdout","time":3925.869861026,"data":"       |         if any(c!=1 for c in indeg):\n"}
,{"stream_name":"stdout","time":3925.869862217,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":3925.869865016,"data":"       |         # now check if permutation is single cycle\n"}
