,{"stream_name":"stdout","time":4194.437378535,"data":"       | # unknown u,v such that dot with b: x*x + y*u = d =\u003e x**2 + y*u = d =\u003e u = (d - x**2)/y\n"}
,{"stream_name":"stdout","time":4194.437380606,"data":"       | u = (d - x**2)/y\n"}
,{"stream_name":"stdout","time":4194.437382356,"data":"       | # length condition: x**2 + u**2 + v**2 = 13 =\u003e v = sqrt(13 - x**2 - u**2)\n"}
,{"stream_name":"stdout","time":4194.437384439,"data":"       | v = math.sqrt(13 - x**2 - u**2)\n"}
,{"stream_name":"stdout","time":4194.437386398,"data":"       | c = (x, u, v)\n"}
,{"stream_name":"stdout","time":4194.437387479,"data":"       | def dot(p,q):\n"}
,{"stream_name":"stdout","time":4194.437388559,"data":"       |     return sum(p[i]*q[i] for i in range(3))\n"}
,{"stream_name":"stdout","time":4194.437389642,"data":"       | def cross(p,q):\n"}
,{"stream_name":"stdout","time":4194.437390693,"data":"       |     return (p[1]*q[2]-p[2]*q[1], p[2]*q[0]-p[0]*q[2], p[0]*q[1]-p[1]*q[0])\n"}
