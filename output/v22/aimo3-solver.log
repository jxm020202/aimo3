,{"stream_name":"stdout","time":4140.193170638,"data":"       | # a_h·b_h = -8, a_h·c_h = -8, b_h·c_h = -16.\n"}
,{"stream_name":"stdout","time":4140.193171928,"data":"       | # Let's solve for b_h = (x,y). Then c_h must satisfy.\n"}
,{"stream_name":"stdout","time":4140.193173169,"data":"       | x,y = sp.symbols('x y', real=True)\n"}
