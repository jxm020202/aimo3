,{"stream_name":"stdout","time":3925.869193748,"data":"       | def get_x_from_cycle(cycle, n):\n"}
,{"stream_name":"stdout","time":3925.869194949,"data":"       |     # compute x[i,j] = 0 if outgoing from (i,j) is east, 1 if north\n"}
,{"stream_name":"stdout","time":3925.869196203,"data":"       |     # need to know outgoing direction for each vertex\n"}
,{"stream_name":"stdout","time":3925.869197393,"data":"       |     # we have path list of vertices visited (including start) length n^2\n"}
,{"stream_name":"stdout","time":3925.869198616,"data":"       |     # plus final edge to start\n"}
,{"stream_name":"stdout","time":3925.869199766,"data":"       |     out = {}\n"}
,{"stream_name":"stdout","time":3925.869200878,"data":"       |     for i in range(len(cycle)-1):\n"}
,{"stream_name":"stdout","time":3925.869202036,"data":"       |         cur = cycle[i]\n"}
,{"stream_name":"stdout","time":3925.869203183,"data":"       |         nxt = cycle[i+1]\n"}
,{"stream_name":"stdout","time":3925.869206112,"data":"       |         if (cur[0]+1)%n == nxt[0] and cur[1]==nxt[1]:\n"}
,{"stream_name":"stdout","time":3925.869207336,"data":"       |             out[cur]=0\n"}
,{"stream_name":"stdout","time":3925.869208465,"data":"       |         else:\n"}
,{"stream_name":"stdout","time":3925.86920959,"data":"       |             out[cur]=1\n"}
,{"stream_name":"stdout","time":3925.869210704,"data":"       |     # final edge\n"}
,{"stream_name":"stdout","time":3925.869211837,"data":"       |     cur = cycle[-1]\n"}
,{"stream_name":"stdout","time":3925.869212959,"data":"       |     nxt = (0,0)\n"}
,{"stream_name":"stdout","time":3925.869214075,"data":"       |     if (cur[0]+1)%n == nxt[0] and cur[1]==nxt[1]:\n"}
,{"stream_name":"stdout","time":3925.869215299,"data":"       |         out[cur]=0\n"}
,{"stream_name":"stdout","time":3925.8692164,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":3925.869217499,"data":"       |         out[cur]=1\n"}
,{"stream_name":"stdout","time":3925.869218625,"data":"       |     # return matrix\n"}
,{"stream_name":"stdout","time":3925.869219772,"data":"       |     mat = [[out[(i,j)] for j in range(n)] for i in range(n)]\n"}
,{"stream_name":"stdout","time":3925.86922097,"data":"       |     return mat\n"}
,{"stream_name":"stdout","time":3925.869222073,"data":"       | \n"}
