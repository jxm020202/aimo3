,{"stream_name":"stdout","time":4675.026426413,"data":"       |     # side lengths\n"}
,{"stream_name":"stdout","time":4675.026427569,"data":"       |     len1 = sp.sqrt(v1.dot(v1))\n"}
,{"stream_name":"stdout","time":4675.02642878,"data":"       |     len2 = sp.sqrt(v2.dot(v2))\n"}
,{"stream_name":"stdout","time":4675.026429942,"data":"       |     perim = 2*(len1+len2)\n"}
,{"stream_name":"stdout","time":4675.02643116,"data":"       |     # compute fourth vertex D = sum of other two - common\n"}
,{"stream_name":"stdout","time":4675.026432441,"data":"       |     D = pts[other_indices[0]] + pts[other_indices[1]] - common_pt\n"}
,{"stream_name":"stdout","time":4675.026433691,"data":"       |     return sp.simplify(perim), D\n"}
