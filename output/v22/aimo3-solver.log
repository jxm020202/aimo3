,{"stream_name":"stdout","time":4400.316608688,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4400.316609716,"data":"       | a(n)=\\#\\{\\text{subsets of }\\{1,\\dots ,n\\}\\text{ containing no consecutive numbers}\\}.\n"}
,{"stream_name":"stdout","time":4400.316611045,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4400.316612026,"data":"       | \n"}
,{"stream_name":"stdout","time":4400.316612998,"data":"       | A well‑known recurrence gives \\(a(n)=a(n-1)+a(n-2)\\) with \\(a(0)=1,\\;a(1)=2\\);\n"}
