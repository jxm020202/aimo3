,{"stream_name":"stdout","time":4266.94048901,"data":"       | t = sp.sqrt((u-1)/2)\n"}
,{"stream_name":"stdout","time":4266.940490111,"data":"       | sp.nsimplify(s + t)\n"}
,{"stream_name":"stdout","time":4266.94049116,"data":"       | \n"}
