,{"stream_name":"stdout","time":4372.465203358,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465205074,"data":"       | M=\\Bigl(\\frac{0+14}{2},0\\Bigr)=(7,0).\n"}
,{"stream_name":"stdout","time":4372.465207024,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465210699,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46521234,"data":"       | The circumcenter of \\(\\triangle ABC\\) is  \n"}
,{"stream_name":"stdout","time":4372.465214247,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465216013,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.46521775,"data":"       | O=\\Bigl(7,\\frac{33}{8}\\Bigr),\\qquad R=\\frac{65}{8}.\n"}
,{"stream_name":"stdout","time":4372.46521978,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465221472,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465223267,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.46522524,"data":"       | ### 2.  Point \\(P\\) (second intersection of \\(AM\\) with the circumcircle)\n"}
,{"stream_name":"stdout","time":4372.465227305,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46522896,"data":"       | The line \\(AM\\) is  \n"}
,{"stream_name":"stdout","time":4372.4652307,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465232379,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465234096,"data":"       | (x,y)=(5,12)+t(2,-12),\\qquad t\\in\\mathbb R .\n"}
,{"stream_name":"stdout","time":4372.465236057,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465237802,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465239444,"data":"       | Substituting in \\((x-O_x)^2+(y-O_y)^2=R^{2}\\) gives  \n"}
,{"stream_name":"stdout","time":4372.465241302,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465242798,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465244439,"data":"       | t\\bigl(148t-197\\bigr)=0 .\n"}
,{"stream_name":"stdout","time":4372.46524629,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465247964,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465249716,"data":"       | Thus \\(t=0\\) (point \\(A\\)) and  \n"}
,{"stream_name":"stdout","time":4372.465251652,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465253379,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465255068,"data":"       | t_P=\\frac{197}{148}\u003e1 .\n"}
,{"stream_name":"stdout","time":4372.465256858,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465258384,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465260097,"data":"       | Hence  \n"}
,{"stream_name":"stdout","time":4372.465261788,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465263453,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465265508,"data":"       | P=\\Bigl(5+2t_P,\\;12-12t_P\\Bigr)=\\Bigl(\\frac{567}{74},-\\frac{147}{37}\\Bigr).\n"}
,{"stream_name":"stdout","time":4372.465267646,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465269344,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465271067,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.465274561,"data":"       | ### 3.  Point \\(Q\\) on \\(AM\\) with \\(\\angle PBQ=\\angle PCQ\\)\n"}
,{"stream_name":"stdout","time":4372.465276702,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465278406,"data":"       | Write a point on the segment \\(AM\\) as  \n"}
,{"stream_name":"stdout","time":4372.465280284,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465281997,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465283723,"data":"       | Q(t)=(5+2t,\\;12-12t),\\qquad 0\\le t\\le 1 .\n"}
,{"stream_name":"stdout","time":4372.465287639,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465289504,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465291236,"data":"       | Let  \n"}
,{"stream_name":"stdout","time":4372.465292955,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465294643,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465296418,"data":"       | \\vec{BP}=P-B,\\quad \\vec{BQ}=Q-B,\\quad\n"}
,{"stream_name":"stdout","time":4372.465298451,"data":"       | \\vec{CP}=P-C,\\quad \\vec{CQ}=Q-C .\n"}
,{"stream_name":"stdout","time":4372.465300322,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465302063,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465303761,"data":"       | The condition \\(\\angle PBQ=\\angle PCQ\\) is  \n"}
,{"stream_name":"stdout","time":4372.465305679,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465307331,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465309026,"data":"       | \\frac{\\vec{BP}\\!\\cdot\\!\\vec{BQ}}{|\\vec{BP}||\\vec{BQ}|}\n"}
,{"stream_name":"stdout","time":4372.465311112,"data":"       |    =\\frac{\\vec{CP}\\!\\cdot\\!\\vec{CQ}}{|\\vec{CP}||\\vec{CQ}|}.\n"}
,{"stream_name":"stdout","time":4372.465313205,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465314894,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465316601,"data":"       | After clearing denominators and simplifying, the equation reduces to  \n"}
,{"stream_name":"stdout","time":4372.465318497,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465320173,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465321894,"data":"       | 224\\,t\\,(148t-197)^{2}\\,(148t-99)=0 .\n"}
,{"stream_name":"stdout","time":4372.46532383,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.46532549,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465327189,"data":"       | The admissible solutions are  \n"}
,{"stream_name":"stdout","time":4372.465328942,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465330606,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465332317,"data":"       | t=0\\;(A),\\qquad t=\\frac{197}{148}\\;(P),\\qquad \n"}
,{"stream_name":"stdout","time":4372.465334304,"data":"       | t=\\frac{99}{148}.\n"}
,{"stream_name":"stdout","time":4372.465336112,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465337765,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46533944,"data":"       | Only \\(t=\\dfrac{99}{148}\\) lies on the interior of the segment \\(AM\\); hence  \n"}
,{"stream_name":"stdout","time":4372.465341547,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465343232,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.46534497,"data":"       | Q=Q\\!\\left(\\frac{99}{148}\\right).\n"}
,{"stream_name":"stdout","time":4372.465356628,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465359461,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465361493,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.465363495,"data":"       | ### 4.  Length \\(AQ\\)\n"}
,{"stream_name":"stdout","time":4372.465365304,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465367159,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465368974,"data":"       | AM=|A-M|=\\sqrt{(2)^{2}+(-12)^{2}}=2\\sqrt{37}.\n"}
,{"stream_name":"stdout","time":4372.465370925,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465374494,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46537632,"data":"       | Since \\(AQ=t\\cdot AM\\),\n"}
,{"stream_name":"stdout","time":4372.465378222,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465379885,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.46538162,"data":"       | AQ=\\frac{99}{148}\\cdot 2\\sqrt{37}\n"}
,{"stream_name":"stdout","time":4372.465383557,"data":"       |     =\\frac{99\\sqrt{37}}{74}\n"}
,{"stream_name":"stdout","time":4372.465385371,"data":"       |     =\\frac{99}{\\sqrt{148}}.\n"}
,{"stream_name":"stdout","time":4372.465387206,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465388875,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465390561,"data":"       | Thus  \n"}
,{"stream_name":"stdout","time":4372.465392313,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465394005,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.465395762,"data":"       | AQ=\\frac{m}{\\sqrt{n}}\\quad\\text{with}\\quad m=99,\\;n=148,\n"}
,{"stream_name":"stdout","time":4372.465397865,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465399576,"data":"       | and \\(\\gcd(99,148)=1\\).\n"}
,{"stream_name":"stdout","time":4372.465401395,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465403195,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.465405106,"data":"       | ### 5.  Required sum\n"}
,{"stream_name":"stdout","time":4372.465406811,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.465408583,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.46541031,"data":"       | m+n = 99+148 = \\boxed{247}.\n"}
,{"stream_name":"stdout","time":4372.465412182,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.465413929,"data":"\n"}
