,{"stream_name":"stdout","time":4400.317041893,"data":"       | def has_exactly_one_consecutive_pair(subset):\n"}
,{"stream_name":"stdout","time":4400.317042937,"data":"       |     # subset as tuple of ints sorted\n"}
,{"stream_name":"stdout","time":4400.317043981,"data":"       |     subset = sorted(subset)\n"}
