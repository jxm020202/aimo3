,{"stream_name":"stdout","time":4611.657330745,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.657331792,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.657332919,"data":"       | \\begin{cases}\n"}
,{"stream_name":"stdout","time":4611.65733403,"data":"       | e^{A}B=10A,\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4611.657335239,"data":"       | 4e^{B}A=10B .\n"}
,{"stream_name":"stdout","time":4611.657336381,"data":"       | \\end{cases}\n"}
,{"stream_name":"stdout","time":4611.657337491,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.657338561,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.657339908,"data":"       | From the first equation \\(B/A=10/e^{A}\\); from the second,\n"}
,{"stream_name":"stdout","time":4611.657341232,"data":"       | \\(A/B=5/(2e^{B})\\).  Equating the two expressions for \\(B/A\\),\n"}
,{"stream_name":"stdout","time":4611.657342661,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.657343844,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.657344993,"data":"       | \\frac{10}{e^{A}}=\\frac{2e^{B}}{5}\\quad\\Longrightarrow\\quad\n"}
,{"stream_name":"stdout","time":4611.657346349,"data":"       | e^{A+B}=25 .\n"}
,{"stream_name":"stdout","time":4611.657355817,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.657357784,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.657359889,"data":"       | Hence  \n"}
,{"stream_name":"stdout","time":4611.657362685,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.657364378,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.657366277,"data":"       | A+B=\\ln 25=2\\ln5 .\n"}
