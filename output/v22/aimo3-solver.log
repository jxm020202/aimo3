,{"stream_name":"stdout","time":4482.930801316,"data":"       | Thus t r^{k-1} / t = r^{k-1} \u003c 10^{d} / 10^{d-1} = 10.\n"}
,{"stream_name":"stdout","time":4482.930802532,"data":"       | \n"}
,{"stream_name":"stdout","time":4482.93080362,"data":"       | Thus r^{k-1} \u003c 10.\n"}
