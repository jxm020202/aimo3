,{"stream_name":"stdout","time":3925.869874574,"data":"       |             # move\n"}
,{"stream_name":"stdout","time":3925.869875745,"data":"       |             bit = bits[cur]\n"}
,{"stream_name":"stdout","time":3925.869876892,"data":"       |             if bit==0:\n"}
,{"stream_name":"stdout","time":3925.869877997,"data":"       |                 nxt = ((idx_to_vert[cur][0]+1)%n, idx_to_vert[cur][1])\n"}
,{"stream_name":"stdout","time":3925.869879225,"data":"       |             else:\n"}
,{"stream_name":"stdout","time":3925.869880342,"data":"       |                 nxt = (idx_to_vert[cur][0], (idx_to_vert[cur][1]+1)%n)\n"}
,{"stream_name":"stdout","time":3925.869881555,"data":"       |             cur = vert_to_idx[nxt]\n"}
,{"stream_name":"stdout","time":3925.869882681,"data":"       |         if len(visited)==n*n and cur==0:\n"}
,{"stream_name":"stdout","time":3925.869883829,"data":"       |             count+=1\n"}
,{"stream_name":"stdout","time":3925.869885011,"data":"       |     return count\n"}
