,{"stream_name":"stdout","time":4140.192029893,"data":"       | def V0_formula(p_val):\n"}
,{"stream_name":"stdout","time":4140.19203103,"data":"       |     p_val=sp.nsimplify(p_val)\n"}
,{"stream_name":"stdout","time":4140.192032252,"data":"       |     if p_val\u003e=7:\n"}
,{"stream_name":"stdout","time":4140.192033443,"data":"       |         return (p_val+4)/(2*p_val)\n"}
,{"stream_name":"stdout","time":4140.192034614,"data":"       |     elif p_val\u003e=5:\n"}
,{"stream_name":"stdout","time":4140.192036069,"data":"       |         return (-p_val**3 + 27*p_val**2 - 171*p_val + 151)/(12*p_val*(p_val-8))\n"}
,{"stream_name":"stdout","time":4140.192037351,"data":"       |     else:\n"}
,{"stream_name":"stdout","time":4140.192038523,"data":"       |         return (p_val**2 - 8*p_val + sp.Rational(13,6))/(p_val*(p_val-8))\n"}
