,{"stream_name":"stdout","time":4452.671058531,"data":"       | ### 2.  Determining the angles  \n"}
,{"stream_name":"stdout","time":4452.671059577,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.6710606,"data":"       | For each sum we may take the acute or obtuse solution (both lie in \\((0,\\pi)\\)):\n"}
,{"stream_name":"stdout","time":4452.671061877,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67106287,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.67106389,"data":"       | \\begin{aligned}\n"}
