,{"stream_name":"stdout","time":4452.671013007,"data":"       | ### 1.  Trigonometric substitution  \n"}
,{"stream_name":"stdout","time":4452.671014095,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671015077,"data":"       | Write  \n"}
,{"stream_name":"stdout","time":4452.671016118,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671017097,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.671018128,"data":"       | x=2\\sin ^2\\alpha ,\\qquad y=2\\sin ^2\\beta ,\\qquad z=2\\sin ^2\\gamma ,\n"}
,{"stream_name":"stdout","time":4452.671019467,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.671020485,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671021485,"data":"       | so that  \n"}
,{"stream_name":"stdout","time":4452.6710225,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671023471,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.671024515,"data":"       | \\sqrt{2x-xy}= \\sqrt{2\\sin ^2\\alpha \\bigl(2-2\\sin ^2\\beta\\bigr)}\n"}
,{"stream_name":"stdout","time":4452.671025864,"data":"       |        =2\\sin\\alpha\\cos\\beta ,\n"}
,{"stream_name":"stdout","time":4452.671027027,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.67102804,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.67102906,"data":"       | \\sqrt{2y-xy}=2\\sin\\beta\\cos\\alpha ,\n"}
,{"stream_name":"stdout","time":4452.671030293,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.671031343,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671032373,"data":"       | and similarly for the other radicals.  \n"}
,{"stream_name":"stdout","time":4452.67103345,"data":"       | The three equations become  \n"}
,{"stream_name":"stdout","time":4452.671034505,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671035503,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.671036524,"data":"       | \\begin{aligned}\n"}
,{"stream_name":"stdout","time":4452.671037613,"data":"       | 2\\bigl(\\sin\\alpha\\cos\\beta+\\sin\\beta\\cos\\alpha\\bigr)\u0026=1,\\\\\n"}
,{"stream_name":"stdout","time":4452.671039005,"data":"       | 2\\bigl(\\sin\\beta\\cos\\gamma+\\sin\\gamma\\cos\\beta\\bigr)\u0026=\\sqrt2,\\\\\n"}
,{"stream_name":"stdout","time":4452.671040374,"data":"       | 2\\bigl(\\sin\\gamma\\cos\\alpha+\\sin\\alpha\\cos\\gamma\\bigr)\u0026=\\sqrt3 .\n"}
,{"stream_name":"stdout","time":4452.671041703,"data":"       | \\end{aligned}\n"}
,{"stream_name":"stdout","time":4452.67104276,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.671043777,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671044773,"data":"       | Using \\(\\sin u\\cos v+\\sin v\\cos u=\\sin(u+v)\\),\n"}
,{"stream_name":"stdout","time":4452.67104597,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.671046975,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.671049418,"data":"       | \\boxed{\\begin{aligned}\n"}
,{"stream_name":"stdout","time":4452.671050558,"data":"       | \\sin(\\alpha+\\beta)\u0026=\\frac12,\\\\\n"}
,{"stream_name":"stdout","time":4452.671051784,"data":"       | \\sin(\\beta+\\gamma)\u0026=\\frac{1}{\\sqrt2},\\\\\n"}
,{"stream_name":"stdout","time":4452.671053037,"data":"       | \\sin(\\gamma+\\alpha)\u0026=\\frac{\\sqrt3}{2}.\n"}
,{"stream_name":"stdout","time":4452.671054214,"data":"       | \\end{aligned}}\n"}
,{"stream_name":"stdout","time":4452.6710553,"data":"       | \\]\n"}
