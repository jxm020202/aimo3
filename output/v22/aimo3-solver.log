,{"stream_name":"stdout","time":4372.468251752,"data":"       | Compute dot product:\n"}
,{"stream_name":"stdout","time":4372.468253486,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.468255198,"data":"       | cos(PBQ) = (BP·BQ) / (|BP| |BQ|).\n"}
