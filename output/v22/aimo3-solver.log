,{"stream_name":"stdout","time":4611.657323767,"data":"       | \n"}
,{"stream_name":"stdout","time":4611.657324827,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4611.657325956,"data":"       | A=\\ln x,\\qquad B=\\ln y \\qquad (A\u003e0,\\;B\u003e0).\n"}
,{"stream_name":"stdout","time":4611.657327513,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4611.657328577,"data":"       | \n"}
