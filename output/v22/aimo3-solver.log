,{"stream_name":"stdout","time":4322.290725077,"data":"       | EA = sp.Matrix(A - E)  # from E to A\n"}
,{"stream_name":"stdout","time":4322.290726234,"data":"       | FB = sp.Matrix(B - F)  # from F to B\n"}
,{"stream_name":"stdout","time":4322.290727418,"data":"       | DC = sp.Matrix(C - D)  # from D to C\n"}
,{"stream_name":"stdout","time":4322.290729268,"data":"       | \n"}
,{"stream_name":"stdout","time":4322.290730317,"data":"       | EP = sp.Matrix(P - E)\n"}
,{"stream_name":"stdout","time":4322.290731429,"data":"       | FP = sp.Matrix(P - F)\n"}
,{"stream_name":"stdout","time":4322.290732591,"data":"       | DP = sp.Matrix(P - D)\n"}
