,{"stream_name":"stdout","time":3925.867172858,"data":"       | def count_cycles(n):\n"}
,{"stream_name":"stdout","time":3925.867176531,"data":"       |     # vertices as tuples (i,j)\n"}
,{"stream_name":"stdout","time":3925.867178513,"data":"       |     verts = [(i,j) for i in range(n) for j in range(n)]\n"}
,{"stream_name":"stdout","time":3925.867180537,"data":"       |     # map vertex to index\n"}
,{"stream_name":"stdout","time":3925.867182408,"data":"       |     idx = {v:k for k,v in enumerate(verts)}\n"}
,{"stream_name":"stdout","time":3925.86718478,"data":"       |     total = 0\n"}
,{"stream_name":"stdout","time":3925.867186624,"data":"       |     # generate all possible permutations that are single cycle? That's huge for n\u003e3.\n"}
,{"stream_name":"stdout","time":3925.867189006,"data":"       |     # Instead we can generate all possible functions f(i,j) (choice of which hand moves) and test if resulting permutation is a single cycle.\n"}
,{"stream_name":"stdout","time":3925.867191363,"data":"       |     # For each vertex, choose which hand moves: 0 for i+1, 1 for j+1.\n"}
,{"stream_name":"stdout","time":3925.867193424,"data":"       |     # That's 2^(n^2) possibilities, which is huge for n=2 (2^4=16) manageable.\n"}
,{"stream_name":"stdout","time":3925.867195656,"data":"       |     # For n=3, 2^9=512 manageable.\n"}
,{"stream_name":"stdout","time":3925.867196888,"data":"       |     # For n=4, 2^16=65536 manageable.\n"}
,{"stream_name":"stdout","time":3925.867198097,"data":"       |     # We'll compute for n up to 4.\n"}
,{"stream_name":"stdout","time":3925.867199352,"data":"       |     from collections import defaultdict, deque\n"}
,{"stream_name":"stdout","time":3925.867200548,"data":"       |     \n"}
,{"stream_name":"stdout","time":3925.867201694,"data":"       |     def is_single_cycle(f):\n"}
,{"stream_name":"stdout","time":3925.867202895,"data":"       |         # f is dict mapping vertex to next vertex\n"}
,{"stream_name":"stdout","time":3925.867204234,"data":"       |         visited = set()\n"}
,{"stream_name":"stdout","time":3925.867205392,"data":"       |         start = verts[0]\n"}
,{"stream_name":"stdout","time":3925.867206569,"data":"       |         cur = start\n"}
,{"stream_name":"stdout","time":3925.867207735,"data":"       |         for _ in range(n*n):\n"}
,{"stream_name":"stdout","time":3925.867209017,"data":"       |             if cur in visited:\n"}
,{"stream_name":"stdout","time":3925.867210205,"data":"       |                 return False\n"}
,{"stream_name":"stdout","time":3925.867211368,"data":"       |             visited.add(cur)\n"}
,{"stream_name":"stdout","time":3925.867212515,"data":"       |             cur = f[cur]\n"}
,{"stream_name":"stdout","time":3925.867213708,"data":"       |         # after n^2 steps we should be back to start\n"}
,{"stream_name":"stdout","time":3925.86721495,"data":"       |         return cur == start and len(visited) == n*n\n"}
,{"stream_name":"stdout","time":3925.86721617,"data":"       |     \n"}
,{"stream_name":"stdout","time":3925.867217318,"data":"       |     count = 0\n"}
,{"stream_name":"stdout","time":3925.867218509,"data":"       |     for bits in range(1 \u003c\u003c (n*n)):\n"}
,{"stream_name":"stdout","time":3925.867219924,"data":"       |         f = {}\n"}
,{"stream_name":"stdout","time":3925.867221079,"data":"       |         for idx_v, v in enumerate(verts):\n"}
,{"stream_name":"stdout","time":3925.867222277,"data":"       |             i,j = v\n"}
,{"stream_name":"stdout","time":3925.867223429,"data":"       |             if (bits \u003e\u003e idx_v) \u0026 1:\n"}
,{"stream_name":"stdout","time":3925.867225631,"data":"       |                 # move j hand\n"}
,{"stream_name":"stdout","time":3925.867229338,"data":"       |                 nxt = (i, (j+1)%n)\n"}
,{"stream_name":"stdout","time":3925.86723112,"data":"       |             else:\n"}
,{"stream_name":"stdout","time":3925.867232958,"data":"       |                 nxt = ((i+1)%n, j)\n"}
,{"stream_name":"stdout","time":3925.867234824,"data":"       |             f[v] = nxt\n"}
,{"stream_name":"stdout","time":3925.867236728,"data":"       |         # check indegree condition automatically? Not needed; we just test if permutation is a single cycle.\n"}
,{"stream_name":"stdout","time":3925.867238732,"data":"       |         # Need to ensure each vertex has indegree 1 (bijection). That's automatically satisfied if mapping is a permutation (bijection).\n"}
,{"stream_name":"stdout","time":3925.867240594,"data":"       |         # But we must also ensure each vertex has exactly one incoming edge; that's equivalent to mapping being bijective.\n"}
,{"stream_name":"stdout","time":3925.867242478,"data":"       |         # So we test if mapping is a permutation (bijection) and single cycle.\n"}
,{"stream_name":"stdout","time":3925.867244806,"data":"       |         # Check bijection:\n"}
,{"stream_name":"stdout","time":3925.86724665,"data":"       |         if len(set(f.values())) != n*n:\n"}
,{"stream_name":"stdout","time":3925.867248497,"data":"       |             continue\n"}
,{"stream_name":"stdout","time":3925.867250272,"data":"       |         if is_single_cycle(f):\n"}
,{"stream_name":"stdout","time":3925.86725198,"data":"       |             count += 1\n"}
,{"stream_name":"stdout","time":3925.86725386,"data":"       |     return count\n"}
