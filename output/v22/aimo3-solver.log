,{"stream_name":"stdout","time":4452.670499701,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670500715,"data":"       | ### 1.  A convenient substitution  \n"}
,{"stream_name":"stdout","time":4452.670501817,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67050282,"data":"       | Write  \n"}
,{"stream_name":"stdout","time":4452.670505557,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670506577,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670507627,"data":"       | \\sqrt{2x-xy}= \\sqrt{x(2-y)}= \\sqrt{x}\\,\\sqrt{2-y},\\qquad \n"}
,{"stream_name":"stdout","time":4452.670508984,"data":"       | \\sqrt{2y-xy}= \\sqrt{y}\\,\\sqrt{2-x},\n"}
,{"stream_name":"stdout","time":4452.67051018,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.67051123,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670512213,"data":"       | and similarly for the other two equations.  \n"}
,{"stream_name":"stdout","time":4452.670513288,"data":"       | Put  \n"}
,{"stream_name":"stdout","time":4452.670514283,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670515297,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670516311,"data":"       | a=\\sqrt{x},\\;b=\\sqrt{y},\\;c=\\sqrt{z},\\qquad \n"}
,{"stream_name":"stdout","time":4452.670517644,"data":"       | A=\\sqrt{2-a^{2}},\\;B=\\sqrt{2-b^{2}},\\;C=\\sqrt{2-c^{2}} .\n"}
,{"stream_name":"stdout","time":4452.670518907,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670519947,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670520943,"data":"       | Then  \n"}
,{"stream_name":"stdout","time":4452.670521991,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67052301,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670524043,"data":"       | \\begin{aligned}\n"}
,{"stream_name":"stdout","time":4452.670525105,"data":"       | aB+bA \u0026=1,\\\\\n"}
,{"stream_name":"stdout","time":4452.67052628,"data":"       | bC+cB \u0026=\\sqrt2,\\\\\n"}
,{"stream_name":"stdout","time":4452.67052742,"data":"       | cA+aC \u0026=\\sqrt3,\n"}
,{"stream_name":"stdout","time":4452.670528527,"data":"       | \\end{aligned}\n"}
,{"stream_name":"stdout","time":4452.670529604,"data":"       | \\tag{1}\n"}
,{"stream_name":"stdout","time":4452.670530664,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670531705,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670532754,"data":"       | and because \\(a^{2}+A^{2}=b^{2}+B^{2}=c^{2}+C^{2}=2\\) we may set  \n"}
,{"stream_name":"stdout","time":4452.670533997,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67053502,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670536035,"data":"       | a=\\sqrt2\\sin\\alpha,\\;A=\\sqrt2\\cos\\alpha,\\qquad \n"}
,{"stream_name":"stdout","time":4452.67053729,"data":"       | b=\\sqrt2\\sin\\beta ,\\;B=\\sqrt2\\cos\\beta,\\qquad \n"}
,{"stream_name":"stdout","time":4452.670538555,"data":"       | c=\\sqrt2\\sin\\gamma ,\\;C=\\sqrt2\\cos\\gamma,\n"}
,{"stream_name":"stdout","time":4452.67053978,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670540781,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670541785,"data":"       | with \\(\\alpha,\\beta,\\gamma\\in(0,\\tfrac{\\pi}{2})\\).\n"}
,{"stream_name":"stdout","time":4452.670543073,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67054409,"data":"       | ---\n"}
,{"stream_name":"stdout","time":4452.670545123,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670546167,"data":"       | ### 2.  Trigonometric form of the system  \n"}
,{"stream_name":"stdout","time":4452.670547277,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670548505,"data":"       | Substituting the above into (1) gives  \n"}
,{"stream_name":"stdout","time":4452.670549575,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670552261,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.67055332,"data":"       | \\begin{aligned}\n"}
,{"stream_name":"stdout","time":4452.670554398,"data":"       | 2\\bigl(\\sin\\alpha\\cos\\beta+\\sin\\beta\\cos\\alpha\\bigr)\u0026=1,\\\\\n"}
,{"stream_name":"stdout","time":4452.670555754,"data":"       | 2\\bigl(\\sin\\beta\\cos\\gamma+\\sin\\gamma\\cos\\beta\\bigr)\u0026=\\sqrt2,\\\\\n"}
,{"stream_name":"stdout","time":4452.670557137,"data":"       | 2\\bigl(\\sin\\alpha\\cos\\gamma+\\sin\\gamma\\cos\\alpha\\bigr)\u0026=\\sqrt3 .\n"}
,{"stream_name":"stdout","time":4452.670558473,"data":"       | \\end{aligned}\n"}
,{"stream_name":"stdout","time":4452.670559505,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670560537,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670561547,"data":"       | Using \\(\\sin u\\cos v+\\cos u\\sin v=\\sin(u+v)\\),\n"}
,{"stream_name":"stdout","time":4452.670562733,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670563757,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670564823,"data":"       | \\boxed{\\;\n"}
,{"stream_name":"stdout","time":4452.670565883,"data":"       | \\sin(\\alpha+\\beta)=\\tfrac12,\\;\n"}
,{"stream_name":"stdout","time":4452.67056708,"data":"       | \\sin(\\beta+\\gamma)=\\tfrac{\\sqrt2}{2},\\;\n"}
,{"stream_name":"stdout","time":4452.670568294,"data":"       | \\sin(\\alpha+\\gamma)=\\tfrac{\\sqrt3}{2}\\;}\n"}
,{"stream_name":"stdout","time":4452.670569485,"data":"       | \\tag{2}\n"}
,{"stream_name":"stdout","time":4452.670570527,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670571547,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670572573,"data":"       | Hence  \n"}
,{"stream_name":"stdout","time":4452.67057363,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670574634,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670575675,"data":"       | \\alpha+\\beta\\in\\Bigl\\{\\frac{\\pi}{6},\\frac{5\\pi}{6}\\Bigr\\},\\;\n"}
,{"stream_name":"stdout","time":4452.670577003,"data":"       | \\beta+\\gamma\\in\\Bigl\\{\\frac{\\pi}{4},\\frac{3\\pi}{4}\\Bigr\\},\\;\n"}
,{"stream_name":"stdout","time":4452.670578337,"data":"       | \\alpha+\\gamma\\in\\Bigl\\{\\frac{\\pi}{3},\\frac{2\\pi}{3}\\Bigr\\}.\n"}
,{"stream_name":"stdout","time":4452.670579635,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670580728,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670581814,"data":"       | Solving the linear system  \n"}
,{"stream_name":"stdout","time":4452.670582888,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670583907,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670584937,"data":"       | \\alpha+\\beta=s_{1},\\qquad \\beta+\\gamma=s_{2},\\qquad \\alpha+\\gamma=s_{3}\n"}
,{"stream_name":"stdout","time":4452.670586247,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670587263,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670588294,"data":"       | with the admissible choices \\(s_{1},s_{2},s_{3}\\) and keeping\n"}
,{"stream_name":"stdout","time":4452.670589513,"data":"       | \\(\\alpha,\\beta,\\gamma\\in(0,\\frac{\\pi}{2})\\) yields two possibilities:\n"}
,{"stream_name":"stdout","time":4452.67059084,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670591843,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670592858,"data":"       | \\begin{aligned}\n"}
,{"stream_name":"stdout","time":4452.670593927,"data":"       | \u0026\\alpha=\\frac{\\pi}{8},\\quad \\beta=\\frac{\\pi}{24},\\quad \\gamma=\\frac{5\\pi}{24},\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4452.670596984,"data":"       | \u0026\\alpha=\\frac{3\\pi}{8},\\quad \\beta=\\frac{11\\pi}{24},\\quad \\gamma=\\frac{7\\pi}{24}.\n"}
,{"stream_name":"stdout","time":4452.670598453,"data":"       | \\end{aligned}\n"}
,{"stream_name":"stdout","time":4452.670599518,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670600537,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670601573,"data":"       | Both satisfy (2) and give the same final value, as will be seen.\n"}
,{"stream_name":"stdout","time":4452.67060272,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670603734,"data":"       | ---\n"}
,{"stream_name":"stdout","time":4452.67060478,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670605807,"data":"       | ### 3.  Computing \\((1-x)(1-y)(1-z)\\)\n"}
,{"stream_name":"stdout","time":4452.670606955,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670607944,"data":"       | Since \\(x=a^{2}=2\\sin^{2}\\alpha=1-\\cos2\\alpha\\), we have  \n"}
,{"stream_name":"stdout","time":4452.670609234,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.670610264,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.670611324,"data":"       | 1-x=\\cos2\\alpha,\\qquad 1-y=\\cos2\\beta,\\qquad 1-z=\\cos2\\gamma .\n"}
,{"stream_name":"stdout","time":4452.670612645,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4452.670613657,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67061465,"data":"       | Thus  \n"}
,{"stream_name":"stdout","time":4452.67061568,"data":"       | \n"}
,{"stream_name":"stdout","time":4452.67061666,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4452.67061769,"data":"       | (1-x)(1-y)(1-z)=\\cos2\\alpha\\;\\cos2\\beta\\;\\cos2\\gamma .\n"}
,{"stream_name":"stdout","time":4452.67061901,"data":"       | \\]\n"}
