,{"stream_name":"stdout","time":4452.669604736,"data":"       |     y = 2*sp.sin(beta)**2\n"}
,{"stream_name":"stdout","time":4452.66960579,"data":"       |     z = 2*sp.sin(gamma)**2\n"}
