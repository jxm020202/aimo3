,{"stream_name":"stdout","time":4372.466004035,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466005733,"data":"       | AB^{2}=5^{2}+12^{2}=13^{2},\\qquad AC^{2}=(5-14)^{2}+12^{2}=15^{2}.\n"}
,{"stream_name":"stdout","time":4372.466007667,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466009421,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466011281,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.466013202,"data":"       | ### 1.  Circumcircle and point \\(P\\)\n"}
,{"stream_name":"stdout","time":4372.466015151,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466016936,"data":"       | The circumcenter of \\(\\triangle ABC\\) is  \n"}
,{"stream_name":"stdout","time":4372.466018928,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46602061,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466022312,"data":"       | O=\\Bigl(7,\\frac{33}{8}\\Bigr),\\qquad R=\\frac{65}{8}.\n"}
,{"stream_name":"stdout","time":4372.466024296,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466026117,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466027799,"data":"       | The line through \\(A\\) and the midpoint \\(M\\) of \\(BC\\) (where \\(M=(7,0)\\))\n"}
,{"stream_name":"stdout","time":4372.466030091,"data":"       | has equation  \n"}
,{"stream_name":"stdout","time":4372.466031776,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466033556,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.46603528,"data":"       | \\ell_{AM}:\\;(x,y)=(5,12)+t(2,-12),\\qquad t\\in\\mathbb R .\n"}
,{"stream_name":"stdout","time":4372.466037261,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466038968,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466040683,"data":"       | Intersecting \\(\\ell_{AM}\\) with the circumcircle gives the two points  \n"}
,{"stream_name":"stdout","time":4372.466042693,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466046468,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466048279,"data":"       | A\\;(t=0),\\qquad \n"}
,{"stream_name":"stdout","time":4372.466050189,"data":"       | P=\\Bigl(\\frac{567}{74},-\\frac{147}{37}\\Bigr)\\;(t\u003e0).\n"}
,{"stream_name":"stdout","time":4372.466052192,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.46605388,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46605556,"data":"       | Thus \\(P\\) is the second intersection of the line \\(AM\\) with the circumcircle.\n"}
,{"stream_name":"stdout","time":4372.466057673,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466059405,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.466061355,"data":"       | ### 2.  Point \\(Q\\) on \\(AM\\)\n"}
,{"stream_name":"stdout","time":4372.466063241,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466064923,"data":"       | Write a point on the segment \\(AM\\) as  \n"}
,{"stream_name":"stdout","time":4372.46606679,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466068402,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466070124,"data":"       | Q(t)=A+t(M-A)=(5+2t,\\;12-12t),\\qquad 0\\le t\\le 1 .\n"}
,{"stream_name":"stdout","time":4372.466072116,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.46607382,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466075508,"data":"       | We need \\(t\\) such that  \n"}
,{"stream_name":"stdout","time":4372.466077434,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466079138,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466080854,"data":"       | \\angle PBQ=\\angle PCQ .\n"}
,{"stream_name":"stdout","time":4372.466082624,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466084332,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466086004,"data":"       | Using the cosine formula for the angle between two vectors,\n"}
,{"stream_name":"stdout","time":4372.466087868,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466089604,"data":"       | \\cos\\angle PBQ=\n"}
,{"stream_name":"stdout","time":4372.466091476,"data":"       | \\frac{(P-B)\\cdot(Q-B)}{|P-B|\\,|Q-B|},\\qquad\n"}
,{"stream_name":"stdout","time":4372.46609351,"data":"       | \\cos\\angle PCQ=\n"}
,{"stream_name":"stdout","time":4372.466095327,"data":"       | \\frac{(P-C)\\cdot(Q-C)}{|P-C|\\,|Q-C|}.\n"}
,{"stream_name":"stdout","time":4372.466097212,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466098898,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466100563,"data":"       | Setting the two cosines equal and simplifying yields  \n"}
,{"stream_name":"stdout","time":4372.466102395,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466104095,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466106159,"data":"       | (-1850t-495)\\sqrt{148t^{2}-268t+169}\n"}
,{"stream_name":"stdout","time":4372.466108076,"data":"       | +(2886t-429)\\sqrt{148t^{2}-324t+225}=0 .\n"}
,{"stream_name":"stdout","time":4372.466109978,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466111652,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466113385,"data":"       | Squaring and solving gives the two solutions  \n"}
,{"stream_name":"stdout","time":4372.466115218,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466116892,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466118646,"data":"       | t=\\frac{99}{148},\\qquad t=\\frac{197}{148}.\n"}
,{"stream_name":"stdout","time":4372.466122459,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.46612425,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466125975,"data":"       | Only \\(t=\\dfrac{99}{148}\\) lies on the segment \\(AM\\).  \n"}
,{"stream_name":"stdout","time":4372.466127975,"data":"       | Hence  \n"}
,{"stream_name":"stdout","time":4372.466129742,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466131402,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466133188,"data":"       | Q=\\Bigl(5+2\\cdot\\frac{99}{148},\\;12-12\\cdot\\frac{99}{148}\\Bigr)\n"}
,{"stream_name":"stdout","time":4372.466135312,"data":"       |    =\\Bigl(\\frac{469}{74},\\;\\frac{147}{37}\\Bigr).\n"}
,{"stream_name":"stdout","time":4372.466137275,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466138992,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466140673,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.466142527,"data":"       | ### 3.  Length \\(AQ\\)\n"}
,{"stream_name":"stdout","time":4372.466144274,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466145931,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466147642,"data":"       | \\begin{aligned}\n"}
,{"stream_name":"stdout","time":4372.466149394,"data":"       | AQ\u0026=\\sqrt{(5-\\tfrac{469}{74})^{2}+(12-\\tfrac{147}{37})^{2}}\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4372.466151537,"data":"       |    \u0026=\\frac{99\\sqrt{37}}{74}\n"}
,{"stream_name":"stdout","time":4372.466153462,"data":"       |    =\\frac{99}{2\\sqrt{37}}\n"}
,{"stream_name":"stdout","time":4372.466155352,"data":"       |    =\\frac{99}{\\sqrt{148}} .\n"}
,{"stream_name":"stdout","time":4372.466157229,"data":"       | \\end{aligned}\n"}
,{"stream_name":"stdout","time":4372.466158954,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466160702,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466162393,"data":"       | Thus \\(AQ=\\dfrac{m}{\\sqrt{n}}\\) with relatively prime positive integers  \n"}
,{"stream_name":"stdout","time":4372.46616442,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466170301,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466172104,"data":"       | m=99,\\qquad n=148.\n"}
,{"stream_name":"stdout","time":4372.466173917,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466175614,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466177384,"data":"       | --------------------------------------------------------------------\n"}
,{"stream_name":"stdout","time":4372.466179326,"data":"       | ### 4.  Required sum\n"}
,{"stream_name":"stdout","time":4372.466181078,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.46618276,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466184486,"data":"       | m+n=99+148=247.\n"}
,{"stream_name":"stdout","time":4372.466186213,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466187927,"data":"       | \n"}
,{"stream_name":"stdout","time":4372.466189588,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4372.466191316,"data":"       | \\boxed{247}\n"}
,{"stream_name":"stdout","time":4372.46619304,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4372.466194737,"data":"\n"}
