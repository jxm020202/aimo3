,{"stream_name":"stdout","time":4322.290750554,"data":"       | \n"}
,{"stream_name":"stdout","time":4322.290751627,"data":"       | # tan ratios (assuming positive)\n"}
,{"stream_name":"stdout","time":4322.290752777,"data":"       | tanE = cross_E / dot_E\n"}
