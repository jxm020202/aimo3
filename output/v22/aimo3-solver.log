,{"stream_name":"stdout","time":4194.437429694,"data":"       | a = (s,0,0)\n"}
,{"stream_name":"stdout","time":4194.43743073,"data":"       | x = d/s\n"}
,{"stream_name":"stdout","time":4194.437431746,"data":"       | y = math.sqrt(13 - x**2)\n"}
,{"stream_name":"stdout","time":4194.437432996,"data":"       | b = (x, y, 0)\n"}
,{"stream_name":"stdout","time":4194.437434027,"data":"       | # compute c similarly\n"}
