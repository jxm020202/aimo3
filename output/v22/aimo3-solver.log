,{"stream_name":"stdout","time":4140.192019184,"data":"       |     import random, math\n"}
,{"stream_name":"stdout","time":4140.192020384,"data":"       |     N=200000\n"}
,{"stream_name":"stdout","time":4140.192021557,"data":"       |     cnt=0\n"}
,{"stream_name":"stdout","time":4140.192022704,"data":"       |     for _ in range(N):\n"}
,{"stream_name":"stdout","time":4140.192023919,"data":"       |         a,b,c = random.random(), random.random(), random.random()\n"}
,{"stream_name":"stdout","time":4140.192025185,"data":"       |         if 2*a + p_val*b + (8-p_val)*c \u003c= 7:\n"}
,{"stream_name":"stdout","time":4140.192026459,"data":"       |             cnt+=1\n"}
,{"stream_name":"stdout","time":4140.192027604,"data":"       |     return cnt/N\n"}
