,{"stream_name":"stdout","time":4194.438893286,"data":"       |       =\\frac{31+21}{4}=13\\quad\\Longrightarrow\\quad s=\\sqrt{13}.\n"}
,{"stream_name":"stdout","time":4194.43889456,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.438895618,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.438896653,"data":"       | From  \n"}
