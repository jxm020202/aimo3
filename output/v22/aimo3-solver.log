,{"stream_name":"stdout","time":4140.190036631,"data":"       | # generate random points in cube and estimate volume below z=7\n"}
,{"stream_name":"stdout","time":4140.190037899,"data":"       | def point():\n"}
,{"stream_name":"stdout","time":4140.190039037,"data":"       |     s = np.random.rand(3)\n"}
,{"stream_name":"stdout","time":4140.190040223,"data":"       |     return s[0]*e1 + s[1]*e2 + s[2]*e3\n"}
