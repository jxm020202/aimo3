,{"stream_name":"stdout","time":3925.870050823,"data":"       | def count_hamiltonian_cycles(n,m):\n"}
,{"stream_name":"stdout","time":3925.870051999,"data":"       |     # vertices (i,j) with i in range(n), j in range(m)\n"}
,{"stream_name":"stdout","time":3925.870053187,"data":"       |     vertices = [(i,j) for i in range(n) for j in range(m)]\n"}
,{"stream_name":"stdout","time":3925.870054388,"data":"       |     # map to index\n"}
,{"stream_name":"stdout","time":3925.870055495,"data":"       |     idx = {v:k for k,v in enumerate(vertices)}\n"}
,{"stream_name":"stdout","time":3925.870056696,"data":"       |     total = 0\n"}
,{"stream_name":"stdout","time":3925.870057803,"data":"       |     # we can generate all possible functional permutations where each vertex maps to east or north neighbor\n"}
,{"stream_name":"stdout","time":3925.870059086,"data":"       |     # there are 2^(n*m) possibilities. For n=m=2, that's 16, manageable.\n"}
,{"stream_name":"stdout","time":3925.870060319,"data":"       |     for bits in range(1\u003c\u003c(n*m)):\n"}
,{"stream_name":"stdout","time":3925.870061601,"data":"       |         # define mapping\n"}
,{"stream_name":"stdout","time":3925.870062757,"data":"       |         out = {}\n"}
,{"stream_name":"stdout","time":3925.870063871,"data":"       |         for k,v in enumerate(vertices):\n"}
,{"stream_name":"stdout","time":3925.870065033,"data":"       |             i,j=v\n"}
,{"stream_name":"stdout","time":3925.870066199,"data":"       |             # decide move: 0 east, 1 north (or whichever)\n"}
,{"stream_name":"stdout","time":3925.87006739,"data":"       |             if (bits\u003e\u003ek)\u00261:\n"}
,{"stream_name":"stdout","time":3925.87006866,"data":"       |                 # north (increment j)\n"}
,{"stream_name":"stdout","time":3925.870069793,"data":"       |                 out[v] = (i, (j+1)%m)\n"}
,{"stream_name":"stdout","time":3925.870070943,"data":"       |             else:\n"}
,{"stream_name":"stdout","time":3925.870072055,"data":"       |                 # east (increment i)\n"}
,{"stream_name":"stdout","time":3925.870073201,"data":"       |                 out[v] = ((i+1)%n, j)\n"}
,{"stream_name":"stdout","time":3925.870075921,"data":"       |         # check indegree of each vertex is 1 (since it's a permutation)\n"}
,{"stream_name":"stdout","time":3925.870077239,"data":"       |         indeg = {v:0 for v in vertices}\n"}
,{"stream_name":"stdout","time":3925.870078399,"data":"       |         for v,w in out.items():\n"}
,{"stream_name":"stdout","time":3925.870079562,"data":"       |             indeg[w] += 1\n"}
,{"stream_name":"stdout","time":3925.870080733,"data":"       |         if all(indeg[v]==1 for v in vertices):\n"}
,{"stream_name":"stdout","time":3925.87008192,"data":"       |             # Now check if it's a single cycle (i.e., permutation is a single orbit)\n"}
,{"stream_name":"stdout","time":3925.870083181,"data":"       |             visited=set()\n"}
,{"stream_name":"stdout","time":3925.870084321,"data":"       |             cur=vertices[0]\n"}
,{"stream_name":"stdout","time":3925.870085493,"data":"       |             for _ in range(n*m):\n"}
,{"stream_name":"stdout","time":3925.870087013,"data":"       |                 visited.add(cur)\n"}
,{"stream_name":"stdout","time":3925.870088167,"data":"       |                 cur=out[cur]\n"}
,{"stream_name":"stdout","time":3925.870089312,"data":"       |             if len(visited)==n*m and cur==vertices[0]:\n"}
,{"stream_name":"stdout","time":3925.8700905,"data":"       |                 total+=1\n"}
,{"stream_name":"stdout","time":3925.870091642,"data":"       |     return total\n"}
,{"stream_name":"stdout","time":3925.870092778,"data":"       | \n"}
,{"stream_name":"stdout","time":3925.870093866,"data":"       | for n in range(2,5):\n"}
,{"stream_name":"stdout","time":3925.870094977,"data":"       |     print(n, count_hamiltonian_cycles(n,n))\n"}
