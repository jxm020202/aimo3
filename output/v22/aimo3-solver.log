,{"stream_name":"stdout","time":4194.43889875,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.438899837,"data":"       | \\cos\\frac{\\theta}{2}= \\frac{\\sqrt{31}}{2\\sqrt{13}},\\qquad\n"}
,{"stream_name":"stdout","time":4194.438901138,"data":"       | \\sin\\frac{\\theta}{2}= \\frac{\\sqrt{21}}{2\\sqrt{13}},\n"}
,{"stream_name":"stdout","time":4194.438902386,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.438903438,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.438904489,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.438905574,"data":"       | \\cos\\theta=\\cos ^2\\frac{\\theta}{2}-\\sin ^2\\frac{\\theta}{2}\n"}
,{"stream_name":"stdout","time":4194.438908497,"data":"       |           =\\frac{31-21}{52}= \\frac{5}{26}.\n"}
,{"stream_name":"stdout","time":4194.438912727,"data":"       | \\]\n"}
