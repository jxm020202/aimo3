,{"stream_name":"stdout","time":4194.438878689,"data":"       | ### 1.  Geometry of a rhombus  \n"}
,{"stream_name":"stdout","time":4194.438879766,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.438880829,"data":"       | If a rhombus has side length \\(s\\) and interior angle \\(\\theta\\) (between two adjacent sides), then  \n"}
,{"stream_name":"stdout","time":4194.438882169,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.438883201,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.438884251,"data":"       | d_{\\text{long}} = 2s\\cos\\frac{\\theta}{2},\\qquad   \n"}
,{"stream_name":"stdout","time":4194.438885525,"data":"       | d_{\\text{short}} = 2s\\sin\\frac{\\theta}{2}.\n"}
,{"stream_name":"stdout","time":4194.438886782,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.43888784,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.438888846,"data":"       | Hence  \n"}
,{"stream_name":"stdout","time":4194.43888992,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.438890928,"data":"       | \\[\n"}
