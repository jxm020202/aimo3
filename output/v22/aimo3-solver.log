,{"stream_name":"stdout","time":4696.968826898,"data":"       | Solve quadratic: s = [ -8 ± sqrt(64 + 720) ] / (8) = [ -8 ± sqrt(784) ] / 8 = [ -8 ± 28 ] / 8.\n"}
