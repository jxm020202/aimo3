,{"stream_name":"stdout","time":4266.941647669,"data":"       | n=sp.symbols('n', integer=True, positive=True)\n"}
,{"stream_name":"stdout","time":4266.941648865,"data":"       | t=sp.sqrt(17)\n"}
,{"stream_name":"stdout","time":4266.941649962,"data":"       | r = (1+t)/2\n"}
,{"stream_name":"stdout","time":4266.941651059,"data":"       | a = sp.sqrt(r) # sec\n"}
,{"stream_name":"stdout","time":4266.941652178,"data":"       | b = 2/a\n"}
,{"stream_name":"stdout","time":4266.941653345,"data":"       | def u(n):\n"}
,{"stream_name":"stdout","time":4266.941654645,"data":"       |     return sp.simplify(a**n + b**n)\n"}
,{"stream_name":"stdout","time":4266.941655796,"data":"       | for i in range(1,11):\n"}
,{"stream_name":"stdout","time":4266.941656952,"data":"       |     val = sp.nsimplify(u(i))\n"}
,{"stream_name":"stdout","time":4266.941658142,"data":"       |     print(i, sp.simplify(val))\n"}
