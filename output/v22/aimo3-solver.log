,{"stream_name":"stdout","time":4194.43927056,"data":"       | \\(\\vec a+\\vec b\\) and \\(\\vec a-\\vec b\\).\n"}
,{"stream_name":"stdout","time":4194.439271859,"data":"       | Hence\n"}
,{"stream_name":"stdout","time":4194.439272885,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439273911,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439275008,"data":"       | |\\vec a+\\vec b|^2 = |\\vec a|^2+|\\vec b|^2+2\\vec a\\!\\cdot\\!\\vec b = 2L^{2}+2(\\vec a\\!\\cdot\\!\\vec b),\n"}
,{"stream_name":"stdout","time":4194.439276528,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439277545,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439278602,"data":"       | |\\vec a-\\vec b|^2 = 2L^{2}-2(\\vec a\\!\\cdot\\!\\vec b).\n"}
,{"stream_name":"stdout","time":4194.439279901,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439280928,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439282018,"data":"       | The diagonals of every face have lengths \\(\\sqrt{21}\\) and \\(\\sqrt{31}\\); thus,\n"}
,{"stream_name":"stdout","time":4194.439283411,"data":"       | for any pair of distinct vectors the unordered set\n"}
,{"stream_name":"stdout","time":4194.439284535,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439285579,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.43928801,"data":"       | \\{\\,2L^{2}+2(\\vec a\\!\\cdot\\!\\vec b),\\; 2L^{2}-2(\\vec a\\!\\cdot\\!\\vec b)\\,\\}\n"}
,{"stream_name":"stdout","time":4194.439289466,"data":"       |    =\\{21,31\\}.\n"}
,{"stream_name":"stdout","time":4194.439290586,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439291609,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439292651,"data":"       | Solving these equations gives  \n"}
,{"stream_name":"stdout","time":4194.43929375,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439294776,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439295826,"data":"       | 4L^{2}=52\\qquad\\Longrightarrow\\qquad L^{2}=13,\n"}
,{"stream_name":"stdout","time":4194.439297024,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439298077,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439299136,"data":"       | 2(\\vec a\\!\\cdot\\!\\vec b)=\\pm5\\qquad\\Longrightarrow\\qquad\n"}
,{"stream_name":"stdout","time":4194.43930043,"data":"       | \\vec a\\!\\cdot\\!\\vec b=\\pm\\frac52 .\n"}
,{"stream_name":"stdout","time":4194.439301624,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.43930267,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439303728,"data":"       | Thus for each pair \\(\\{i,j\\}\\),\n"}
,{"stream_name":"stdout","time":4194.439304957,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439305974,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439307053,"data":"       | \\vec v_i\\!\\cdot\\!\\vec v_j = \\pm\\frac52 .\n"}
,{"stream_name":"stdout","time":4194.439308283,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439309343,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439310364,"data":"       | Let  \n"}
,{"stream_name":"stdout","time":4194.439311417,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439312424,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439313452,"data":"       | G=\n"}
,{"stream_name":"stdout","time":4194.439314536,"data":"       | \\begin{pmatrix}\n"}
,{"stream_name":"stdout","time":4194.439315631,"data":"       | 13 \u0026 \\frac52 s_{12} \u0026 \\frac52 s_{13}\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4194.439317132,"data":"       | \\frac52 s_{12} \u0026 13 \u0026 \\frac52 s_{23}\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4194.439318409,"data":"       | \\frac52 s_{13} \u0026 \\frac52 s_{23} \u0026 13\n"}
,{"stream_name":"stdout","time":4194.439319603,"data":"       | \\end{pmatrix},\n"}
,{"stream_name":"stdout","time":4194.439320787,"data":"       | \\qquad s_{ij}\\in\\{+1,-1\\},\n"}
,{"stream_name":"stdout","time":4194.439321969,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439322975,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439323999,"data":"       | be the Gram matrix of \\(\\vec a,\\vec b,\\vec c\\).\n"}
,{"stream_name":"stdout","time":4194.439325257,"data":"       | The squared volume of the parallelepiped equals \\(\\det G\\).\n"}
,{"stream_name":"stdout","time":4194.439326487,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439327546,"data":"       | Evaluating the determinant for the eight possible sign choices gives only\n"}
,{"stream_name":"stdout","time":4194.439328722,"data":"       | two distinct values:\n"}
,{"stream_name":"stdout","time":4194.439329815,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439330834,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439331862,"data":"       | \\det G=\n"}
,{"stream_name":"stdout","time":4194.43933449,"data":"       | \\begin{cases}\n"}
,{"stream_name":"stdout","time":4194.439335634,"data":"       | 1922 = 2\\cdot31^{2}, \u0026 \\text{if }s_{12}s_{13}s_{23}=-1,\\\\[2mm]\n"}
,{"stream_name":"stdout","time":4194.439337007,"data":"       | \\displaystyle\\frac{3969}{2}, \u0026 \\text{if }s_{12}s_{13}s_{23}=+1.\n"}
,{"stream_name":"stdout","time":4194.439338289,"data":"       | \\end{cases}\n"}
,{"stream_name":"stdout","time":4194.439339357,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439340394,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439341455,"data":"       | Hence the possible volumes are  \n"}
,{"stream_name":"stdout","time":4194.439342538,"data":"       | \n"}
,{"stream_name":"stdout","time":4194.439343544,"data":"       | \\[\n"}
,{"stream_name":"stdout","time":4194.439344612,"data":"       | V_1=\\sqrt{1922}=31\\sqrt{2},\\qquad\n"}
,{"stream_name":"stdout","time":4194.439345797,"data":"       | V_2=\\sqrt{\\frac{3969}{2}}=\\frac{63}{\\sqrt{2}}.\n"}
,{"stream_name":"stdout","time":4194.439357284,"data":"       | \\]\n"}
,{"stream_name":"stdout","time":4194.439361119,"data":"       | \n"}
