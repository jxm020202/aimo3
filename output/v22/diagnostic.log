       | def family_info(fam_mask):
       |     subsets = [mask for mask in range(1, 1<<5)]
       |     fam_subsets = [subsets[i] for i in range(len(subsets)) if (fam_mask>>i)&1]
       |     sizes = [bin(s).count('1') for s in fam_subsets]
       |     min_size = min(sizes)
       |     # collect 2-element subsets as frozenset of frozenset elements
       |     two_subs = [tuple(sorted([i+1 for i in range(5) if (s>>i)&1])) for s in fam_subsets if bin(s).count('1')==2]
       |     return min_size, frozenset(two_subs)
       | 
       | info_counts = Counter()
       | for fam in families:
       |     min_sz, two_set = family_info(fam)
       |     info_counts[(min_sz, len(two_set))] += 1
       | 
