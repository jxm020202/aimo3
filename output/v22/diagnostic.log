     [Code]:
       | import itertools, math
       | 
       | def count_perm(m,n):
       |     N=m*n
       |     # encode vertices as indices 0..N-1
       |     verts=[(i,j) for i in range(m) for j in range(n)]
       |     # mapping from vertex to possible images
       |     succ={}
       |     for idx,(i,j) in enumerate(verts):
       |         succ[idx]=[((i+1)%m,j),(i,(j+1)%n)]
       |     # brute force permutations via backtracking
       |     count=0
       |     used=[False]*N
       |     perm=[None]*N
       |     # order of assignment: maybe recursion
       |     def backtrack(k):
       |         nonlocal count
       |         if k==N:
       |             count+=1
       |             return
       |         # choose next vertex index
       |         # we can simply iterate over all vertices not assigned yet
       |         # but we also need to ensure bijection (incoming unique)
       |         # We'll assign mapping for vertex k in order
       |         # However we must ensure that target not already taken
       |         for t in succ[k]:
       |             target=verts.index(t)
       |             if not used[target]:
       |                 used[target]=True
       |                 perm[k]=target
       |                 backtrack(k+1)
       |                 used[target]=False
       |     # This is O(N! ) huge quickly. Not feasible for N>6.
       |     return None
