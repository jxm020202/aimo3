       | def f_via_L(n):
       |     # compute minimal L using condition L >= ceil(n/3)
       |     for L in range((n+2)//3, n):
       |         # proper divisors of L
       |         divs = sp.divisors(L)
       |         proper = [d for d in divs if d != L]
       |         # need distinct a,b in proper distinct from each other
       |         target = n - L
       |         found=False
       |         s=set(proper)
       |         for a in proper:
       |             b = target - a
       |             if b != a and b in s:
       |                 # ensure b != L and a!=L automatically as proper
       |                 found=True
       |                 break
       |         if found:
       |             return L
       |     return None
       | 
       | for n in [27, 28, 29, 30, 31, 32, 33]:
       |     print(n, f_bruteforce2(n), f_via_L(n))
