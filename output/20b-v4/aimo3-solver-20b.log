,{"stream_name":"stdout","time":511.833818105,"data":"  # res.success, res.x (solution vector), res.fun (objective value)\n"}
,{"stream_name":"stdout","time":511.833819429,"data":"- Linear Programming: scipy.optimize.linprog(c, A_ub=A, b_ub=b, method=\"highs\")\n"}
