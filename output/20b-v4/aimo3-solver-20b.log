,{"stream_name":"stdout","time":511.833810673,"data":"Replacements for unavailable optimization/constraint libraries:\n"}
,{"stream_name":"stdout","time":511.833812068,"data":"- Integer/Binary Linear Programming (replaces pulp, mip, ortools):\n"}
,{"stream_name":"stdout","time":511.833813316,"data":"  from scipy.optimize import milp, LinearConstraint, Bounds\n"}
,{"stream_name":"stdout","time":511.833814509,"data":"  import numpy as np\n"}
,{"stream_name":"stdout","time":511.833815622,"data":"  res = milp(c=c_vec, constraints=LinearConstraint(A, lb, ub),\n"}
