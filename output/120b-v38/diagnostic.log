                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                edge_index = {e:i for i,e in enumerate(edges)}
                # variables: x1_i, x2_i for each edge i
                # total variables = 2*E
                c = np.zeros(2*E)
                # maximize 2*x1 + x2 -> minimize - (2*x1 + x2)
                c[:E] = -2  # x1 coeff
                c[E:] = -1   # x2 coeff
                # bounds 0/1
                bounds = [(0,1)]*(2*E)
                # constraints:
                A_ub = []
                b_ub = []
                # for each edge, x1 + x2 <=1
