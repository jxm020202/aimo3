            import random, math, itertools, time
            
            def random_labeling(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                labels = [random.choice([1,2,3]) for _ in range(m)]
                return edges, labels
            
            def check(edges, labels, n):
                # build adjacency dict
                label_dict = {}
                for (i,j),w in zip(edges, labels):
                    label_dict[(i,j)] = w
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            s = label_dict[(i,j)] + label_dict[(i,k)] + label_dict[(j,k)]
                            if s <5:
                                return False
                return True
            
            def total_sum(labels):
                return sum(labels)
            
            def hill_climb(n, iterations=10000):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # start with all 2s
                labels = [2]*m
                best = total_sum(labels)
                best_labels = labels[:]
                for it in range(iterations):
                    # pick random edge and try change to 1 or 3
                    idx = random.randrange(m)
                    old = labels[idx]
                    new = random.choice([1,2,3])
                    if new==old: continue
                    labels[idx]=new
                    if check(edges, labels, n):
                        s = total_sum(labels)
                        if s < best:
                            best = s
                            best_labels = labels[:]
                    else:
                        labels[idx]=old
                return best, best_labels
            
            def find_min(n, trials=20):
                best_overall = None
                for t in range(trials):
                    b,_ = hill_climb(n, iterations=2000)
                    if best_overall is None or b<best_overall:
                        best_overall=b
                return best_overall
            
