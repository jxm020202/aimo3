                    # adjacency set
                    adj = {i:set() for i in vertices}
                    for u,v in edges:
                        adj[u].add(v); adj[v].add(u)
                    # check any triangle
                    for a in vertices:
                        for b in adj[a]:
                            if b>a: continue
                        # better: iterate combos of three vertices
                    # simpler: iterate all triples
                    for a,b,c in itertools.combinations(vertices,3):
                        if (b in adj[a]) and (c in adj[a]) and (c in adj[b]):
                            ok=False
