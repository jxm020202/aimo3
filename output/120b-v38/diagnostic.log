            def solve_n_milp(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                E = len(edges)
                edge_index = {e:i for i,e in enumerate(edges)}
                # variables: x1[0:E-1], x2[0:E-1] (concatenated)
                total_vars = 2*E
                c = np.zeros(total_vars)
                c[:E] = -2
                c[E:] = -1
                # constraints list
                rows = []
                ub = []
                # edge constraint x1 + x2 <=1
                for i in range(E):
                    row = np.zeros(total_vars)
                    row[i] = 1
                    row[E+i] = 1
                    rows.append(row)
                    ub.append(1)
                # triangle constraints 2*S1 + S2 <=4
                for a in range(n):
                    for b in range(a+1,n):
                        for c_ in range(b+1,n):
                            row = np.zeros(total_vars)
                            i1 = edge_index[(a,b)]
                            i2 = edge_index[(a,c_)]
                            i3 = edge_index[(b,c_)]
                            for idx in (i1,i2,i3):
                                row[idx] = 2
                                row[E+idx] = 1
                            rows.append(row)
                            ub.append(4)
                A = np.array(rows)
                b_u = np.array(ub, dtype=float)
                b_l = np.full_like(b_u, -np.inf)
                constraints = opt.LinearConstraint(A, b_l, b_u)
                bounds = opt.Bounds(0, 1)  # all variables between 0 and1
                integrality = np.ones(total_vars, dtype=int)
                res = opt.milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("no success", n, res.message)
                    return None
                x = res.x
                total_obj = -res.fun  # because we minimized negative
                total_sum = 3*E - total_obj
                avg = total_sum / E
                return avg, total_sum, E
            
            for n in range(3,9):
                result = solve_n_milp(n)
                print(n, result)
            
