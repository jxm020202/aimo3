            def construct_graph(N,k):
                # assign vertices: first k are cores, rest leaves assigned round-robin to cores
                cores = list(range(k))
                leaves = list(range(k, N))
                # assign leaf to core
                assign = {}
                for idx, leaf in enumerate(leaves):
                    core = idx % k
                    assign[leaf] = core
                # edge weights dict
                w = {}
                for i in range(N):
                    for j in range(i+1,N):
                        if i<k and j<k:
