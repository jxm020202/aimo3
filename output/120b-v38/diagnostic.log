            from functools import lru_cache
            
            V_target = 28
            deg_target = 156
            y_target = 52
            
            @lru_cache(None)
            def dfs(i, v, d, y):
                # i index in type_list
                if i==len(type_list):
                    return v==0 and d==0 and y==0
                # prune if negative
                if v<0 or d<0 or y<0:
                    return False
                # also bound: maximum possible remaining degree and y using max per vertex
                # compute max degree and max y for remaining types
                max_deg = max(t[0] for t in type_list[i:])
                max_y = max(t[1] for t in type_list[i:])
                min_deg = min(t[0] for t in type_list[i:])
                min_y = min(t[1] for t in type_list[i:])
                # quick bounds
                if d > v*max_deg or d < v*min_deg:
                    return False
                if y > v*max_y or y < v*min_y:
                    return False
                x,yv = type_list[i]
                # try possible count k for this type from 0 to v
                for k in range(v+1):
                    if dfs(i+1, v-k, d - k*x, y - k*yv):
                        return True
                return False
            
