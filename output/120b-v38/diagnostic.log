            from scipy.optimize import milp, LinearConstraint, Bounds
            def min_average(n):
                m = n*(n-1)//2
                # variable indices for each edge
                # We'll use integer variable taking values 1,2,3 via encoding: maybe use two binary variables? Simpler: variable x_e integer in [1,3].
                # Use integer variable with bounds 1 to 3.
                c = np.ones(m)  # objective sum of labels
                # constraints: for each triangle (i,j,k), sum >=5
                # Build list of edges mapping
                edge_index = {}
                idx=0
                for i in range(n):
                    for j in range(i+1,n):
                        edge_index[(i,j)]=idx
                        idx+=1
                A=[]
                b=[]
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            row = np.zeros(m)
                            row[edge_index[(i,j)]] = 1
                            row[edge_index[(i,k)]] = 1
                            row[edge_index[(j,k)]] = 1
                            A.append(row)
                            b.append(-5)  # We'll set inequality: -sum <= -5 -> sum >=5
                A = np.array(A)
                # Convert to LinearConstraint: A @ x >= 5 => -A @ x <= -5
                lc = LinearConstraint(-A, -np.inf, -np.array(b))
                bounds = Bounds(np.ones(m), 3*np.ones(m))
                # integer constraints
                integrality = np.ones(m, dtype=int)
                res = milp(c=c, constraints=[lc], bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            res = min_average(6)
            print(res.success, res.x, res.fun)
            
