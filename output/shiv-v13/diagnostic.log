            def generate_pretty(N):
                # returns set of (m,n) pretty with m,n <= N
                pretty_set = set()
                for m in range(1, N+1):
                    a = math.floor(m*alpha)
                    # solve congruence n a ≡ m - k (mod m)
                    # compute g = gcd(a,m)
                    g = math.gcd(a, m)
                    rhs = (m - k) % m  # m - k mod m
                    if rhs % g != 0:
                        continue
                    # find particular solution n0 modulo m/g
                    # solve a/g * n ≡ rhs/g (mod m/g)
                    a1 = a // g
                    m1 = m // g
                    rhs1 = (rhs // g) % m1
                    # compute modular inverse of a1 mod m1 (since gcd(a1,m1)=1)
                    inv_a1 = pow(a1, -1, m1)
                    n0 = (inv_a1 * rhs1) % m1
                    # generate n = n0 + t*m1 for t >= 0
                    # need n >= 1 and n <= N
                    for t in range(0, (N - n0)//m1 + 1):
                        n = n0 + t*m1
                        if n < 1 or n > N:
                            continue
                        # compute b from equation
                        # b = (k - m + n*a) // m
                        num = k - m + n*a
                        if num % m != 0:
                            continue
                        b = num // m
                        if b < 0 or b > n-1:
                            continue
                        if math.floor(n*alpha) != b:
                            continue
                        pretty_set.add((m,n))
                return pretty_set
            
            def count_cool_fast(N):
                pretty = generate_pretty(N)
                cool = 0
                for (m,n) in pretty:
                    # check derived pairs
