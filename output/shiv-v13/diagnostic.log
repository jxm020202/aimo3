                for u_val in us:
                    vs = real_vs_for_u(u_val)
                    for v_val in vs:
                        # compute x^2 = 3/(1+u^2+v^2)
                        denom = 1+u_val**2+v_val**2
                        if denom <= 0: continue
                        x_sq = 3/denom
                        if x_sq <= 0: continue
                        # compute x = sqrt(x_sq) (both signs)
                        solutions.append((u_val, v_val))
                return solutions
            
