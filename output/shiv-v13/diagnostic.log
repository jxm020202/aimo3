            def sigma(n):
                s=1
                # factorization
                i=2
                nn=n
                while i*i<=nn:
                    if nn%i==0:
                        p=i
                        e=0
                        while nn%p==0:
                            nn//=p
                            e+=1
                        s*= (p**(e+1)-1)//(p-1)
                    i+=1 if i==2 else 2  # skip even after 2
                if nn>1:
                    p=nn
                    s*= (p**2-1)//(p-1)
                return s
            
