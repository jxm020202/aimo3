                    # Solve A * n ≡ -k (mod m)
                    # Reduce: (A/d) * n ≡ -k/d (mod m/d)
                    A1 = A // d
                    m1 = m // d
                    k1 = k // d
                    # Compute modular inverse of A1 modulo m1
                    # Since gcd(A1,m1)=1
                    inv = pow(A1, -1, m1)  # python 3.8+ supports
                    n0 = (-k1 * inv) % m1  # smallest non-negative solution modulo m1
                    # General solution: n = n0 + t * m1, for integer t
