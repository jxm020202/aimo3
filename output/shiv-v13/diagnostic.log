            import math
            
            def pretty_pairs(alpha, k, max_mn):
                pretty = set()
                for m in range(1, max_mn+1):
                    ceil_n_alpha = None
                    floor_m_alpha = math.floor(m*alpha)
                    for n in range(1, max_mn+1):
                        val = m*math.ceil(n*alpha) - n*floor_m_alpha
                        if val == k:
                            pretty.add((m,n))
                return pretty
            
            def cool_pairs(alpha, k, max_mn):
                pretty = pretty_pairs(alpha, k, max_mn)
                cool = set()
                for (m,n) in pretty:
                    # check predecessors
                    pred1 = (m-n, n) if m>n else None
                    pred2 = (m, n-m) if n>m else None
                    pred1_pretty = pred1 in pretty if pred1 and pred1[0]>0 and pred1[1]>0 else False
                    pred2_pretty = pred2 in pretty if pred2 and pred2[0]>0 and pred2[1]>0 else False
                    if not pred1_pretty and not pred2_pretty:
                        cool.add((m,n))
                return cool
            
            def count_cool(alpha, k, max_mn):
                return len(cool_pairs(alpha, k, max_mn))
            
