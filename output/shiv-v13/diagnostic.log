            import random, math
            def random_point_on_sphere():
                # generate random point uniformly on sphere radius sqrt(3)
                # using normal distribution
                import random, math
                while True:
                    x = random.gauss(0,1)
                    y = random.gauss(0,1)
                    z = random.gauss(0,1)
                    norm = math.sqrt(x*x+y*y+z*z)
                    if norm>0:
                        scale = math.sqrt(3)/norm
                        return (x*scale, y*scale, z*scale)
            
            def check_point(p, eps=1e-6):
                x,y,z=p
                return abs(x*y**3 + y*z**3 + z*x**3 - 3) < eps
            
            found=[]
            for i in range(200000):
                p=random_point_on_sphere()
                if check_point(p, 1e-5):
                    found.append(p)
                    if len(found)>=10:
                        break
            len(found)
            
