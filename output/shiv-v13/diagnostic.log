            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            num_vars = len(edges)
            c = -np.ones(num_vars)  # maximize sum => minimize -sum
            
            # Build constraints matrix A_ub x <= b_ub
            # We'll collect rows as list
            A_rows = []
            b_rows = []
            
            # Square constraint: for each (i,j), sum of two directions <=1
            edge_index = {e: idx for idx, e in enumerate(edges)}
            for i in range(N):
                for j in range(N):
                    row = np.zeros(num_vars)
                    row[edge_index[(i,j,0)]] = 1
                    row[edge_index[(i,j,1)]] = 1
                    A_rows.append(row)
                    b_rows.append(1)
            
            # Conflict constraints
            for e1, e2 in conflict_pairs:
                row = np.zeros(num_vars)
                row[edge_index[e1]] = 1
                row[edge_index[e2]] = 1
                A_rows.append(row)
                b_rows.append(1)
            
            A = np.vstack(A_rows)
            b = np.array(b_rows)
            
            # Bounds: 0 <= x <= 1
            bounds = Bounds(0, 1)
            
            # integrality: all variables integer
            integrality = np.ones(num_vars, dtype=int)
            
            # Solve
            res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds, integrality=integrality, options={'disp': True})
            
