            import math, sys
            from math import gcd
            
            def pretty_pairs_alpha(alpha, k, M):
                pretty=set()
                for m in range(1, M+1):
                    A = math.floor(m*alpha)
                    d = math.gcd(A, m)
                    if k % d != 0:
                        continue
                    # Solve A * n ≡ -k (mod m)
                    # Reduce: (A/d) * n ≡ -(k/d) (mod m/d)
                    A1 = A//d
                    m1 = m//d
                    rhs = (-k//d) % m1
                    # Compute modular inverse of A1 modulo m1
                    # Since gcd(A1,m1)=1
                    inv = pow(A1, -1, m1)  # Python 3.8+ supports modular inverse
                    n0 = (rhs * inv) % m1
                    # generate n = n0 + t*m1 for t >=0
                    # we need n positive. n0 could be 0; but n must be >=1.
                    # start t such that n>=1
                    t_start = 0
                    if n0 == 0:
                        t_start = 1
                    # Let's set an upper bound for n: maybe N_max = M (since we only care up to M)
                    # But we can generate n up to M as well.
                    # We'll generate n up to M (or maybe 2*M) to capture pairs where n <= M.
                    N_limit = M
                    t = t_start
                    while True:
                        n = n0 + t*m1
                        if n > N_limit:
                            break
                        # compute B = floor(n*alpha)
                        B = math.floor(n*alpha)
                        if m*(B+1) - n*A == k:
                            pretty.add((m,n))
                        t += 1
                return pretty
            
