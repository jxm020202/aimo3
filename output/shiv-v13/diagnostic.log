            def pretty_pairs_via_u(alpha, k, max_m):
                pretty = set()
                for m in range(1, max_m+1):
                    u = (m*alpha) % 1  # fractional part
                    # compute max_n = floor(k / u) if u>0 else large
                    if u == 0:
                        continue  # irrational, shouldn't happen
                    max_n = int(math.floor(k / u))
                    if max_n < 1:
                        continue
                    if m >= k:
                        n_start = 1
                    else:
                        # lower bound
                        L = math.ceil((k - m) / u)
                        n_start = L
                    for n in range(n_start, max_n+1):
                        # verify condition
                        if m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k:
                            pretty.add((m,n))
                return pretty
            
            def count_pretty(alpha,k,limit_m=200):
                return len(pretty_pairs_via_u(alpha,k,limit_m))
            
