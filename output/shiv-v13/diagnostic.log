            import random, math, numpy as np
            
            def f_val(x,y,z):
                return x*y**3 + y*z**3 + z*x**3 - 3
            
            def random_point_on_sphere():
                # uniform distribution on sphere
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v-1)
                r = math.sqrt(3)
                x = r*math.sin(phi)*math.cos(theta)
                y = r*math.sin(phi)*math.sin(theta)
                z = r*math.cos(phi)
                return x,y,z
            
            def find_near_zero(samples=200000, tol=1e-6):
                sols=[]
