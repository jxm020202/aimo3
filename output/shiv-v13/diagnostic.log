            def max_sum_two_columns():
                max_sum = 0
                best = None
                for A in valid_subsets:
                    for B in valid_subsets:
                        # check condition
                        # Build adjacency for close pairs (|a-b| <=1)
                        close_pairs = [(a,b) for a in A for b in B if abs(a-b) <= 1]
                        # each a or b can be in at most one close pair
                        # So we need to check if there is a matching covering all close pairs (i.e., each a appears at most once, each b at most once)
                        # Equivalent to: no a appears in two pairs, no b appears in two pairs
                        # So we just need to ensure that close_pairs have unique a and unique b
                        # If there are multiple pairs sharing same a or b, invalid
                        a_counts = {}
                        b_counts = {}
                        ok = True
                        for a,b in close_pairs:
                            if a in a_counts or b in b_counts:
                                ok = False
                                break
                            a_counts[a]=1
                            b_counts[b]=1
                        if not ok:
                            continue
                        # also need that any a,b with distance <=1 are included in close_pairs (they are by definition)
                        # So condition satisfied
                        total = len(A)+len(B)
                        if total > max_sum:
                            max_sum = total
                            best = (A,B)
                return max_sum, best
            
            max_sum, best = max_sum_two_columns()
