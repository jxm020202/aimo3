            def find_solutions_grid(num_x=301, num_theta=361):
                sols=set()
                for x in np.linspace(-math.sqrt(3), math.sqrt(3), num_x):
                    r2 = 3 - x*x
                    if r2 < -1e-12:
                        continue
                    r = math.sqrt(max(r2,0))
                    # sample theta for y = r cos theta, z = r sin theta
                    for theta in np.linspace(0, 2*math.pi, num_theta, endpoint=False):
                        y = r*math.cos(theta)
                        z = r*math.sin(theta)
                        val = x*y**3 + y*z**3 + z*x**3
                        if abs(val-3) < 1e-3:
                            sols.add((round(x,6), round(y,6), round(z,6)))
                return sols
            
