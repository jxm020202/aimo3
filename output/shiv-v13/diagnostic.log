                # returns list of pretty pairs (m,n) with m,n up to limit
                res = []
                for m in range(1, limit+1):
                    for n in range(1, limit+1):
                        lhs = m * math.ceil(n*alpha) - n * math.floor(m*alpha)
                        if lhs == k:
                            res.append((m,n))
