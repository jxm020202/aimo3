            import numpy as np, math, mpmath as mp
            
            def solutions_for_x(x):
                r2 = 3 - x*x
                if r2 < 0:
                    return []
                r = math.sqrt(r2)
                # define function of theta
                def f(theta):
                    return x*(r*math.cos(theta))**3 + (r*math.cos(theta))*(r*math.sin(theta))**3 + (r*math.sin(theta))*x**3 - 3
                # find roots in [0, 2π)
                roots=[]
                # sample intervals to locate sign changes
                N=720
                thetas = [2*math.pi*i/N for i in range(N+1)]
                vals = [f(t) for t in thetas]
                for i in range(N):
                    a, b = thetas[i], thetas[i+1]
                    fa, fb = vals[i], vals[i+1]
                    if fa==0:
                        roots.append(a)
                    if fa*fb < 0:
                        try:
                            root = mp.findroot(lambda th: x*(r*mp.cos(th))**3 + (r*mp.cos(th))*(r*mp.sin(th))**3 + (r*mp.sin(th))*x**3 - 3, (a,b))
                            # bring into [0,2π)
                            root = float(root % (2*math.pi))
                            # deduplicate
                            if not any(abs(root - r0) < 1e-6 for r0 in roots):
