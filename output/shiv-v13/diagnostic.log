            import numpy as np, math, random, sys, itertools, sympy as sp, warnings, math, time, collections, functools, fractions, decimal, heapq, statistics, random as rnd
            def find_solutions_grid(num_t=200, num_z=400):
                sols = []
                for t in np.linspace(-math.sqrt(3), math.sqrt(3), num_t):
                    r2 = 3 - t*t
                    if r2 < 0:
                        continue
                    # z range within sqrt(r2)
                    for z in np.linspace(-math.sqrt(r2), math.sqrt(r2), num_z):
                        y_sq = r2 - z*z
                        if y_sq < -1e-9:
                            continue
                        if y_sq < 0:
                            y_sq = 0
                        y_vals = [math.sqrt(y_sq), -math.sqrt(y_sq)]
                        for y in y_vals:
                            f = t*y**3 + y*z**3 + z*t**3
                            if abs(f - 3) < 1e-3:
