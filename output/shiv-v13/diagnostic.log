            def pretty_pairs_alpha(alpha, k, max_m):
                theta = alpha - math.floor(alpha)
                pretty = []
                for m in range(1, max_m+1):
                    r = math.floor(m*theta)  # floor(mθ)
                    if r == 0:
                        # need m | k
                        if k % m != 0:
                            continue
                        t = k//m - 1
                        if t < 0:
                            continue
                        # Need n such that floor(nθ) = t.
                        # n must satisfy nθ in [t, t+1)
                        # Since θ irrational, there is at most one n for each t? Actually n = floor((t+1)/θ) maybe.
                        # Let's find n = smallest integer with floor(nθ)=t.
                        # n = floor((t+1)/θ) maybe? Let's compute n = math.floor((t+1)/theta)
                        n_candidate = math.floor((t+1)/theta)
                        # adjust to ensure floor(nθ)=t
                        while n_candidate>0 and math.floor(n_candidate*theta) > t:
                            n_candidate -= 1
                        while math.floor(n_candidate*theta) < t:
                            n_candidate += 1
                        if math.floor(n_candidate*theta) == t:
                            pretty.append((m, n_candidate))
                    else:
                        # Solve congruence n r ≡ m - k (mod m)
                        d = math.gcd(r, m)
                        if (m - k) % d != 0:
                            continue
                        # Find a particular solution n0 modulo m/d
                        # Reduce equation: (r/d) n ≡ (m - k)/d (mod m/d)
                        md = m // d
                        rd = r // d
                        rhs = (m - k) // d % md
                        # Compute modular inverse of rd mod md
                        try:
                            inv = pow(rd, -1, md)
                        except ValueError:
                            continue
                        n0 = (rhs * inv) % md
                        # All solutions: n = n0 + t*md, t integer >=0
                        # For each t, compute n and check floor condition
                        # We'll iterate t until n becomes too large such that floor condition fails.
                        # Let's set a reasonable bound for t, maybe up to some limit.
                        # We'll try t up to, say, 5? Might need more.
                        for t_iter in range(0, 5):
                            n = n0 + t_iter * md
                            if n <= 0:
                                continue
                            # Compute floor(nθ) and check condition
                            lhs = n * r + k - m
                            if lhs % m != 0:
                                continue
                            t_val = lhs // m
                            if t_val < 0:
                                continue
                            if math.floor(n*theta) == t_val:
                                pretty.append((m, n))
                return pretty
            
