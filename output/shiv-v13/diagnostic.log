            def find_solutions_grid(step=0.05, tol=1e-4):
                sols = []
                R = math.sqrt(3)
                for y in np.arange(-R, R+step, step):
                    for z in np.arange(-R, R+step, step):
                        if y*y + z*z > 3: 
                            continue
                        S_sq = 3 - y*y - z*z
                        S = math.sqrt(S_sq)
                        # compute A
                        A = S*(y**3 + z*S_sq)
                        yz3 = y*z**3
                        # check sigma = +1
                        if abs(A + yz3 - 3) < tol:
                            sols.append((+S, y, z))
                        # sigma = -1
                        if abs(-A + yz3 - 3) < tol:
                            sols.append((-S, y, z))
                return sols
            
