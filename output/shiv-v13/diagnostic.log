            def cluster(sols, eps=1e-2):
                clusters = []
                for p in sols:
                    found=False
                    for c in clusters:
                        if np.linalg.norm(np.array(p)-np.array(c[0]))<eps:
                            c.append(p)
                            found=True
                            break
                    if not found:
                        clusters.append([p])
                return [c[0] for c in clusters]
            
