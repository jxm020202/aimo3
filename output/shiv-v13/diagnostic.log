            def count_solutions_for_pair(m,n):
                d = math.gcd(m,n)
                u = m//d
                v = n//d
                K = k//d
                # find particular solution (a0,b0) for u b - v a = K - u
                # we can use extended Euclid to find x,y such that u*x + v*y = 1
                g, x, y = sp.gcdex(u, v)  # returns (g, s, t) such that s*u + t*v = g
                # g should be 1
                # We need solution to u b - v a = K - u
                # rewrite as u b + v (-a) = K - u
                # So using x,y: multiply both sides by (K - u)
                b0 = x * (K - u)
                a0 = -y * (K - u)
                # general solution: b = b0 + v*t, a = a0 + u*t
                # find t range
                t_min = math.ceil((-a0)/u)  # ensure a >= 0
                t_max = math.floor((d*u - 1 - a0)/u)
                t2_min = math.ceil((-b0)/v)
                t2_max = math.floor((d*v - 1 - b0)/v)
                t_low = max(t_min, t2_min)
                t_high = min(t_max, t2_max)
                if t_low > t_high:
                    return 0
                else:
                    return t_high - t_low + 1
            
