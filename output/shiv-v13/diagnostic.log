            import numpy as np, math, itertools, random, sys, math, cmath, time, collections, itertools, sys, math
            R = math.sqrt(3)
            def S(phi,theta):
                x = R*math.sin(phi)*math.cos(theta)
                y = R*math.sin(phi)*math.sin(theta)
                z = R*math.cos(phi)
                return x*y**3 + y*z**3 + z*x**3
            
            def find_grid(step_phi=0.01, step_theta=0.01, tol=1e-3):
                sols=[]
                phi_vals = np.arange(0, math.pi+step_phi, step_phi)
                theta_vals = np.arange(0, 2*math.pi+step_theta, step_theta)
                for phi in phi_vals:
                    for theta in theta_vals:
                        val=S(phi,theta)
                        if abs(val-3) < tol:
                            x = R*math.sin(phi)*math.cos(theta)
                            y = R*math.sin(phi)*math.sin(theta)
                            z = R*math.cos(phi)
                            sols.append((x,y,z))
                return sols
            
            grid_sols = find_grid(0.05,0.05,0.02)
            len(grid_sols)
            
