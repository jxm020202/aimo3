            def solve_max():
                rows = 17
                cols = 16  # columns 1..16
                n_vars = rows * cols
                # variable index mapping
                def idx(i, j):
                    # i: 1..16, j:0..16
                    return (i-1)*rows + j
                # Build constraints
                A = []
                b = []
                # Horizontal adjacency
                for i in range(1, cols):
                    for j in range(rows):
                        row = np.zeros(n_vars)
                        row[idx(i, j)] = 1
                        row[idx(i+1, j)] = 1
                        A.append(row)
                        b.append(1)
                # Vertical adjacency
                for i in range(1, cols+1):
                    for j in range(rows-1):
                        row = np.zeros(n_vars)
                        row[idx(i, j)] = 1
                        row[idx(i, j+1)] = 1
                        A.append(row)
                        b.append(1)
                # Diagonal predecessor constraint
                for i in range(2, cols+1):
                    for j in range(rows):
                        preds = []
                        if j-1 >= 0:
                            preds.append(idx(i-1, j-1))
                        if j+1 <= rows-1:
                            preds.append(idx(i-1, j+1))
                        if len(preds) == 2:
                            row = np.zeros(n_vars)
                            row[preds[0]] = 1
                            row[preds[1]] = 1
                            A.append(row)
                            b.append(1)
                        # if only one predecessor (edge cases at top/bottom rows), no constraint needed? Actually at top row j=0, only predecessor (i-1,1) exists? Wait j+1=1, j-1 invalid. So only one predecessor, no conflict.
                A = np.array(A)
                b = np.array(b)
                c = -np.ones(n_vars)  # maximize sum => minimize negative sum
                integrality = np.ones(n_vars, dtype=int)
                bounds = Bounds(0, 1)
                lc = LinearConstraint(A, -np.inf, b)  # A x <= b
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            res = solve_max()
            print(res)
            
