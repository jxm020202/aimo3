            import numpy as np, math
            
            def find_grid_solutions(step=0.02):
                sols=set()
                r = math.sqrt(3)
                ys = np.arange(-r, r+step, step)
                zs = np.arange(-r, r+step, step)
                for y in ys:
                    for z in zs:
                        val = 3 - y*y - z*z
                        if val < -1e-12:
