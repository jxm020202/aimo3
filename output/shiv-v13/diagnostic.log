            def generate_pretty(alpha, k, max_m, t_max=5000):
                theta = alpha - math.floor(alpha)
                pretty = set()
                for m in range(1, max_m+1):
                    r = math.floor(m*theta)
                    if r == 0:
                        # need m divides k
                        if k % m != 0:
                            continue
                        t_val = k//m - 1
                        if t_val < 0:
                            continue
                        # find n such that floor(nθ)=t_val
                        # n approx (t+1)/θ
                        n_est = int((t_val+1)/theta)
                        # search around
                        for n in range(max(1, n_est-3), n_est+4):
                            if math.floor(n*theta) == t_val:
                                pretty.add((m,n))
                    else:
                        # iterate t from lower bound to t_max
                        t_start = max(0, math.ceil(k/m) - 1)  # ensure numerator positive
                        for t_val in range(t_start, t_max+1):
                            num = m * (t_val + 1) - k
