        ```python
import math

def pretty_pairs(k, alpha, limit):
    """Return list of pretty pairs (m,n) with 1<=m,n<=limit for given k and irrational alpha."""
    pairs = []
    for m in range(1, limit+1):
        for n in range(1, limit+1):
            if m*math.ceil(n*alpha) - n*math.floor(m*alpha) == k:
                pairs.append((m,n))
    return pairs

def cool_pairs(k, alpha, limit):
    """Return list of cool pairs among pretty pairs up to limit."""
    pretty = set(pretty_pairs(k, alpha, limit))
    cool = []
    for m,n in pretty:
        if (m-n, n) not in pretty and (m, n-m) not in pretty:
            # ensure the subtractions stay positive
            if (m-n > 0 or n==0) and (n-m > 0 or m==0):
                cool.append((m,n))
    return cool

# Test with a concrete irrational alpha, e.g., sqrt(2)
alpha = math.sqrt(2)
k = 2310
limit = 5000   # adjust as needed; we expect only finitely many cool pairs

cool = cool_pairs(k, alpha, limit)
len_cool = len(cool)
len_cool
```

