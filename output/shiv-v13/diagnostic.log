        >>> Code:
            def count_solutions_for_pair(m,n):
                d = math.gcd(m,n)
                u = m//d
                v = n//d
                K = k//d
                s, t, g = sp.gcdex(u, v)  # s*u + t*v = g = 1
                assert g == 1
                b0 = s * (K - u)
                a0 = -t * (K - u)
                # general solution: b = b0 + v*tau, a = a0 + u*tau
                tau_min_a = math.ceil((-a0) / u)
                tau_max_a = math.floor((d*u - 1 - a0) / u)
                tau_min_b = math.ceil((-b0) / v)
                tau_max_b = math.floor((d*v - 1 - b0) / v)
                tau_low = max(tau_min_a, tau_min_b)
                tau_high = min(tau_max_a, tau_max_b)
                if tau_low > tau_high:
                    return 0
                else:
                    return tau_high - tau_low + 1
            
            for m,n in sample:
                print(m,n, count_solutions_for_pair(m,n))
            
