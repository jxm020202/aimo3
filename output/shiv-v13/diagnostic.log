            import random, math, numpy as np
            
            def second(x,y,z):
                return x*y**3 + y*z**3 + z*x**3
            
            def random_point_on_sphere():
                # generate random direction uniformly
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v-1)
                # radius sqrt(3)
                r = math.sqrt(3)
                x = r*math.sin(phi)*math.cos(theta)
                y = r*math.sin(phi)*math.sin(theta)
                z = r*math.cos(phi)
                return x,y,z
            
            def close(a,b,eps=1e-6):
