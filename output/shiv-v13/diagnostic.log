            import random, math, numpy as np, itertools, sys, time, math, cmath
            def random_point_on_sphere():
                # uniform distribution
                theta = random.random()*2*math.pi
                phi = math.acos(2*random.random()-1)
                r = math.sqrt(3)
                x = r*math.sin(phi)*math.cos(theta)
                y = r*math.sin(phi)*math.sin(theta)
                z = r*math.cos(phi)
                return x,y,z
            
            def f(x,y,z):
                return x*y**3 + y*z**3 + z*x**3
            
            def near(val, target=3, eps=1e-3):
                return abs(val-target) < eps
            
            cnt=0
            samples=200000
            solutions=[]
            for i in range(samples):
                x,y,z = random_point_on_sphere()
                val = f(x,y,z)
