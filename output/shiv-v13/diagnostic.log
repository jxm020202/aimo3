            import random, math, numpy as np, sys, math, time
            
            def random_point_on_sphere(radius):
                # generate random direction uniformly
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v-1)
                x = radius*math.sin(phi)*math.cos(theta)
                y = radius*math.sin(phi)*math.sin(theta)
                z = radius*math.cos(phi)
                return x,y,z
            
            def test_samples(N=100000):
                radius = math.sqrt(3)
                close = []
                for _ in range(N):
