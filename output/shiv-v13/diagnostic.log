        >>> Code:
            def interval(m,n,k):
                # compute a,b solution such that intervals intersect
                # we can compute a = floor(m*alpha) for any alpha in the interval.
                # Use formula: choose a such that b = (k - m + n*a)/m integer.
                # We can find a by solving congruence n*a ≡ m - k (mod m)
                # Since d = gcd(m,n) | k, solution exists.
                d = math.gcd(m,n)
                # solve for a modulo m/d
                m1 = m//d
                n1 = n//d
                # we need n*a ≡ m - k (mod m)
                # divide by d: n1*a ≡ (m - k)/d (mod m1)
                target = (m - k)//d
                # find modular inverse of n1 mod m1
                inv = pow(n1, -1, m1)  # Python 3.8+ supports
                a0 = (target * inv) % m1
                # general solution: a = a0 + t*m1 for integer t
                # choose t such that intervals intersect and a positive? We'll find a that yields a/m approx alpha.
                # We can compute alpha interval as intersection:
                # a/m ≤ α < (a+1)/m
                # b = (k - m + n*a)/m
                # then b/n ≤ α < (b+1)/n
                # We'll find t such that the intervals overlap.
                # Let's compute for t such that a/m is near (k)/ (m+n)? maybe.
                # We'll just find t that gives positive overlap.
                for t in range(-10, 10):
                    a = a0 + t*m1
                    b = (k - m + n*a)//m  # integer division exact
                    # compute interval intersection
                    low = max(a/m, b/n)
                    high = min((a+1)/m, (b+1)/n)
                    if low < high:
                        return (low, high)
                return None
            
            def interval_derived(m,n,k):
                if m<=n: return None
                return interval(m-n,n,k)
            
            def test_inclusion(m,n,k):
                I = interval(m,n,k)
                I2 = interval_derived(m,n,k)
                if I and I2:
                    return I[0] <= I2[0] and I2[1] <= I[1]
                else:
                    return None
            
