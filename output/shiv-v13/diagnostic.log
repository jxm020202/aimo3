            import numpy as np, math
            def f_case(x,z,sign):
                A2 = 3 - x*x - z*z
                if A2 < 0:
                    return None
                A = math.sqrt(A2)
                return sign*(x*A**3 + A*z**3) + z*x**3 - 3
            
            def find_grid(sign, N=400):
                sols=[]
                R=math.sqrt(3)
                xs = np.linspace(-R,R,N)
                zs = np.linspace(-R,R,N)
                for x in xs:
                    for z in zs:
                        val = f_case(x,z,sign)
                        if val is None:
                            continue
                        if abs(val) < 1e-3:
                            # compute y
                            y = sign*math.sqrt(3 - x*x - z*z)
                            if abs(x*y**3 + y*z**3 + z*x**3 - 3) < 1e-3:
                                sols.append((x,y,z))
                return sols
            
            sols_grid_plus = find_grid(1, 200)
            sols_grid_minus = find_grid(-1, 200)
            len(sols_grid_plus), len(sols_grid_minus)
            
