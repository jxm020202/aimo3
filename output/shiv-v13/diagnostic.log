            def find_x_for_z(z_val, sign):
                # solve for x in real numbers
                # domain: x^2 <= 3 - z^2
                max_sq = 3 - z_val**2
                if max_sq < 0:
                    return []
                # Use mpmath findroot starting from multiple initial guesses
                sols=set()
                for guess in np.linspace(-math.sqrt(max_sq), math.sqrt(max_sq), 20):
                    try:
