            import random, math
            def f_val(x,y,z):
                return x*y**3 + y*z**3 + z*x**3
            
            def random_point_on_sphere():
                # generate random point uniformly on sphere radius sqrt(3)
                # using normal distribution
                import random, math
                u1 = random.gauss(0,1)
                u2 = random.gauss(0,1)
                u3 = random.gauss(0,1)
                norm = math.sqrt(u1*u1+u2*u2+u3*u3)
                r = math.sqrt(3)
                return (r*u1/norm, r*u2/norm, r*u3/norm)
            
            def find_close(num_samples=200000, tol=1e-6):
                close_points=[]
                for _ in range(num_samples):
                    x,y,z = random_point_on_sphere()
                    val = f_val(x,y,z)
                    if abs(val-3) < tol:
                        close_points.append((x,y,z,val))
                return close_points
            
            close_pts = find_close(200000, 1e-5)
            len(close_pts)
            
