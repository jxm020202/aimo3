            def head_tail(edge):
                i,j,d = edge
                if d == 0:  # NE: from (i,j) to (i+1,j+1)
                    tail = (i, j)
                    head = (i+1, j+1)
                else:  # SE: from (i,j+1) to (i+1,j)
                    tail = (i, j+1)
                    head = (i+1, j)
                return head, tail
            
