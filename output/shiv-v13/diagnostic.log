            def g(phi,theta):
                r = math.sqrt(3)
                x = r*math.sin(phi)*math.cos(theta)
                y = r*math.sin(phi)*math.sin(theta)
                z = r*math.cos(phi)
                return x*y**3 + y*z**3 + z*x**3 - 3
            
            # coarse grid
            def find_zeros_grid(Nphi=200, Ntheta=200, tol=1e-3):
                zeros=[]
                for i in range(Nphi+1):
                    phi = math.pi*i/Nphi
                    for j in range(Ntheta):
                        theta = 2*math.pi*j/Ntheta
                        val = g(phi,theta)
                        if abs(val) < tol:
                            zeros.append((phi,theta,val))
                return zeros
            
