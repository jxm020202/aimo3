            def count_cool(alpha, k, max_mn):
                pretty = set()
                for m in range(1, max_mn+1):
                    ceil_n_alpha = lambda n: math.ceil(n*alpha)
                    floor_m_alpha = lambda m: math.floor(m*alpha)
                # We'll loop n inside
                pretty = set()
                for m in range(1, max_mn+1):
                    fm = math.floor(m*alpha)
                    for n in range(1, max_mn+1):
                        cn = math.ceil(n*alpha)
                        if m*cn - n*fm == k:
                            pretty.add((m,n))
                # Now cool: (m-n,n) or (m,n-m) not pretty (if positive)
