            import math, sys, itertools, collections, time
            
            def compute_cool_count(alpha, k, max_m):
                # precompute floor values a_i = floor(i*alpha)
                a = [0]*(max_m+1)
                for i in range(1, max_m+1):
                    a[i] = math.floor(i*alpha)
                pretty_set = set()
                # For each m, find n candidates via congruence
                for m in range(1, max_m+1):
                    a_m = a[m]
                    g = math.gcd(a_m, m)
                    if k % g != 0:
                        continue
                    m_prime = m // g
                    a_prime = a_m // g
                    k_prime = k // g
                    # compute modular inverse of a_prime mod m_prime
                    # using pow with -1 mod (python 3.8+)
                    inv = pow(a_prime, -1, m_prime)  # works if coprime
                    n0 = (-k_prime * inv) % m_prime
                    # generate n values up to max_m (or maybe larger)
                    # n must be positive integer
                    # start with smallest positive n >=1
                    # n = n0 + t*m_prime
                    # ensure n >=1
                    t_start = 0
                    if n0 == 0:
                        n_start = m_prime
                    else:
                        n_start = n0
                    # iterate
                    n = n_start
                    while n <= max_m:
                        # compute a_n via formula
                        a_n = (n * a_m + k - m) // m  # integer by construction
                        # verify that a_n matches floor(n*alpha)
                        if a_n == a[n]:
                            pretty_set.add((m,n))
                        n += m_prime
                # Now compute cool pairs
                cool = []
                for (m,n) in pretty_set:
                    cond1 = (m>n) and ((m-n, n) in pretty_set)
                    cond2 = (n>m) and ((m, n-m) in pretty_set)
                    if not cond1 and not cond2:
                        cool.append((m,n))
                return len(cool), cool, len(pretty_set)
            
            # test for small k
            k_test = 10
            cnt, cool, total = compute_cool_count(math.sqrt(2), k_test, 2000)
            cnt, total
            
