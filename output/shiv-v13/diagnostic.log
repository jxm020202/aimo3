            def F(x, theta):
                r2 = 3 - x*x
                if r2 < 0:
                    return None
                r = math.sqrt(r2)
                y = r*math.cos(theta)
                z = r*math.sin(theta)
                return x*y**3 + y*z**3 + z*x**3 - 3
            
            def find_solutions_grid(nx=200, ntheta=200, tol=1e-4):
                sols = []
                for i in range(nx+1):
                    x = -math.sqrt(3) + 2*math.sqrt(3)*i/nx
                    for j in range(ntheta):
                        theta = 2*math.pi*j/ntheta
                        val = F(x, theta)
                        if val is None:
                            continue
                        if abs(val) < tol:
                            # compute y,z
                            r = math.sqrt(3 - x*x)
                            y = r*math.cos(theta)
                            z = r*math.sin(theta)
                            sols.append((x,y,z))
                return sols
            
            sols_grid = find_solutions_grid(200,400,1e-3)
            len(sols_grid)
            
