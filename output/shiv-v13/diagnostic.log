            def cluster_points(points, eps=1e-2):
                clusters = []
                for p in points:
                    found = False
                    for c in clusters:
                        if np.linalg.norm(np.array(p)-np.array(c[0])) < eps:
                            c.append(p)
                            found = True
                            break
                    if not found:
