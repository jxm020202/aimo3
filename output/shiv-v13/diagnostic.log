            def is_pretty(m,n,k):
                # brute check using constructed alpha
                d=math.gcd(m,n)
                if k % d !=0:
                    return False
                if m+n <= k:
                    return False
                # find b solving m(b+1) ≡ k (mod n)
                # solve for t=b+1
                # m t ≡ k (mod n)
                # we can find modular inverse of m/d modulo n/d
                d=math.gcd(m,n)
                m1=m//d
                n1=n//d
                k1=k//d
                # Solve m1 * t ≡ k1 (mod n1)
                # Since m1 and n1 coprime, inverse exists.
                inv = pow(m1, -1, n1)  # python 3.8+ modular inverse
                t = (inv * k1) % n1
                # ensure t positive? t can be 0, but then b = t-1 = -1 not allowed (b must be >=0)
                # If t==0, we can add n1 to make positive.
                if t==0:
                    t+=n1
                b = t-1
                a = (m*(b+1)-k)//n
                # compute interval
                lower = max(a/m, b/n)
                upper = min((a+1)/m, (b+1)/n)
                if not (lower < upper):
                    return False
                # choose alpha midpoint
                alpha = (lower+upper)/2
                # compute expression
                lhs = m*math.ceil(n*alpha) - n*math.floor(m*alpha)
                return lhs == k
            
