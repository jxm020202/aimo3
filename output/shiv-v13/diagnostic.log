            import random, math, numpy as np
            
            def find_approx_solutions(num_samples=200000, tol=1e-6):
                sols=[]
                for _ in range(num_samples):
                    # sample point on sphere radius sqrt(3)
                    # generate random normal vector and normalize
                    v = np.random.normal(size=3)
                    v = v / np.linalg.norm(v) * math.sqrt(3)
                    x,y,z = v
                    val = x*y**3 + y*z**3 + z*x**3
                    if abs(val-3) < tol:
