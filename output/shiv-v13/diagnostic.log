        def pretty_intervals(alpha,k,M):
    intervals = {}
    for m in range(1,M+1):
        u = (m*alpha) % 1
        if u==0: continue
        n_max = int((k-1e-12)//u)
        if n_max<1: continue
        if m<k:
            n_min = int((k - m)//u) + 1
        else:
            n_min = 1
        if n_min<=n_max:
            intervals[m]=(n_min,n_max)
    return intervals

def cool_by_interval(alpha,k,M):
    intervals = pretty_intervals(alpha,k,M)
    pretty=set()
    for m,(nmin,nmax) in intervals.items():
        for n in range(nmin,nmax+1):
            pretty.add((m,n))
    cool=[]
    for (m,n) in pretty:
        if not ((m>n and (m-n,n) in pretty) or (n>m and (m,n-m) in pretty)):
            cool.append((m,n))
    return cool

