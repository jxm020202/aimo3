            def count_cool_decimal(alpha_decimal, k):
                cool = 0
                for m in range(1, k+1):
                    for n in range(1, k+1):
                        if m + n <= k:
                            continue
                        # compute floor and ceil using Decimal
                        m_alpha = alpha_decimal * m
                        n_alpha = alpha_decimal * n
                        floor_m = int(m_alpha.to_integral_value(rounding=ROUND_FLOOR))
                        ceil_n = int(n_alpha.to_integral_value(rounding=ROUND_CEILING))
                        if m * ceil_n - n * floor_m == k:
                            cool += 1
