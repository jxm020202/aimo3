import sympy as sp

k = 2310
# compute divisors
divs = sp.divisors(k)
def f(N):
    total = 0
    for i in range(1, N+1):
        mu = sp.mobius(i)
        if mu == 0:
            continue
        M = N // i
        total += mu * M * (M + 1) // 2
    return total

total_cool = sum(f(k//d) for d in divs)
total_cool
```

