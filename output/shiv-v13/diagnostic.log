            k = 2310
            def count_cool(k):
                total = 0
                for d in range(1, k+1):
                    if k % d == 0:
                        N = k // d
                        # count coprime pairs (a,b) with 1<=a,b<=N and a+b > N
                        cnt = 0
                        for a in range(1, N+1):
                            # b must be > N - a
                            minb = max(1, N - a + 1)
                            for b in range(minb, N+1):
