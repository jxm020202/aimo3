            import numpy as np, math, sympy as sp
            u = sp.symbols('u')
            v = sp.symbols('v')
            quartic = v**4 - 3*u*v**3 + 2*(1+u**2)*v**2 - 3*v + (1+u**2)**2 - 3*u**3
            # For numeric scanning
            def real_vs_for_u(u_val):
                coeffs = sp.Poly(quartic.subs(u, u_val), v).all_coeffs()
                coeffs = [float(c) for c in coeffs]
                roots = np.roots(coeffs)
                real_roots = [r.real for r in roots if abs(r.imag) < 1e-8]
                return real_roots
            
