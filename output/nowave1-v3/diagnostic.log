Solution 1: import sympy as sp

def is_power_of_p(x, p):
    # returns exponent if x is p^e, else None
    if x <= 0:
        return None
    e = 0
    while x % p == 0:
        x //= p
        e += 1
    if x == 1:
        return e
    else:
        return None

def find_solutions(limit_a=200, limit_b=200, limit_p=50):
    sols = []
    primes = list(sp.primerange(3, limit_p+1))
    for p in primes:
        for a in range(1, limit_a+1):
            for b in range(a, limit_b+1):
                x = pow(a, p-1) + b
                y = pow(b, p-1) + a
                e1 = is_power_of_p(x, p)
                e2 = is_power_of_p(y, p)
                if e1 is not None and e2 is not None:
                    sols.append((p,a,b,e1,e2))
    return sols

sols = find_solutions(limit_a=200, limit_b=200, limit_p=50)
