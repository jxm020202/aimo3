            def ratio_via_vectors(a,b,c,d):
                # vectors relative to circumcenter (origin)
                R2 = (a.dot(a))
                K = (a+b+c+d)/2
                KT1 = (K - a).norm()
                KC2 = K.dot(K)
                # power: R^2 - KC^2
