                return digs[::-1]  # most significant first
            
            def delete_digit_at_position(digs, i):
                # i index from 0 (least) to len-1 (most) as per problem? They said i from 0 (least) to m (most). So i corresponds to position from least.
                # We'll treat i as index from least (rightmost) = 0.
                # So convert to list with most first, then compute position from right.
                L=len(digs)
                idx = L-1 - i
                new = digs[:idx] + digs[idx+1:]
                # convert new digits (most first) to integer base7
                val=0
                for d in new:
                    val = val*7 + d
                return val
            
