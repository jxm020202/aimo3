            def nullspace_mod2(matrix):
                A = matrix.copy()
                rows, cols = A.shape
                pivot_cols = []
                r = 0
                for c in range(cols):
                    pivot = None
                    for i in range(r, rows):
                        if A[i,c] == 1:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    if pivot != r:
                        A[[pivot, r]] = A[[r, pivot]]
                    for i in range(rows):
                        if i != r and A[i,c] == 1:
                            A[i] ^= A[r]
                    pivot_cols.append(c)
                    r += 1
                    if r == rows:
                        break
                free_cols = [c for c in range(cols) if c not in pivot_cols]
                basis = []
                for free in free_cols:
                    vec = np.zeros(cols, dtype=np.uint8)
                    vec[free] = 1
                    for i, pc in enumerate(pivot_cols):
                        if A[i, free] == 1:
                            vec[pc] = 1
                    basis.append(vec)
                return basis
            
