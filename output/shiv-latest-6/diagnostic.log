            def is_convex(r1_val, r2_val, R_val, h_val, s1_val, s2_val):
                Ox=7.5
                u1 = np.array([-Ox, -h_val])/R_val
                u2 = np.array([Ox, -h_val])/R_val
                a1 = R_val - r1_val**2/(2*R_val)
                a2 = R_val - r2_val**2/(2*R_val)
                M1 = np.array([Ox, h_val]) + a1*u1
                M2 = np.array([Ox, h_val]) + a2*u2
                v1 = np.array([u1[1], -u1[0]])
                v2 = np.array([u2[1], -u2[0]])
                L1 = 2*math.sqrt(R_val**2 - a1**2)
                L2 = 2*math.sqrt(R_val**2 - a2**2)
                Q = M1 + s1_val*(L1/2)*v1
                Rpt = M1 - s1_val*(L1/2)*v1
                S = M2 + s2_val*(L2/2)*v2
                T = M2 - s2_val*(L2/2)*v2
                P1 = np.array([0.0,0.0])
                P2 = np.array([15.0,0.0])
                verts = [S,Q,P1,Rpt,T,P2]
                # compute cross product z of consecutive edges
                signs = []
                n=len(verts)
                for i in range(n):
                    a = verts[i]
                    b = verts[(i+1)%n]
                    c = verts[(i+2)%n]
                    ab = b-a
                    bc = c-b
                    cross = np.cross(ab, bc)
                    signs.append(cross)
                return all(s>0 for s in signs) or all(s<0 for s in signs)
            
            for sol in solutions:
                print(is_convex(*sol))
            
