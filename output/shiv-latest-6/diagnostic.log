            # orthocenter O = X+Y+Z (since circumcenter at origin)
            O = X + Y + Z
            
            # foot from X to line YZ
            def foot(P, A, B):
                # projection of P onto line AB
                AB = B - A
                t = ((P - A).dot(AB)) / (AB.dot(AB))
                return A + t*AB
            
            Xprime = foot(X, Y, Z)
            Yprime = foot(Y, X, Z)
            
