            u1 = sp.Matrix([-Ox, -h]) / R  # from O to P1 (0,0)
            u2 = sp.Matrix([Ox, -h]) / R   # from O to P2 (15,0)
            
            # distances from O to chord midpoints
            a1 = R - r1**2/(2*R)
