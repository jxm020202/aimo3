                    if lhs % 2 != 0:
                        continue
                    N = lhs // 2
                    # factor N
                    fac = sp.factorint(N)
                    # compute squarefree part (product of primes with odd exponent)
                    sqfree = 1
                    for p, e in fac.items():
                        if e % 2 == 1:
                            sqfree *= p
                    # we need sqfree to be a prime ≡5 mod8
                    if sqfree != 0 and sp.isprime(sqfree) and sqfree % 8 == 5:
