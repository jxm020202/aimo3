            def second_intersection(P, Q, D):
                # line through P,Q intersect circle centered D radius |D-P|
                # returns the point other than P (assuming P is on circle)
                # param eq: P + t*(Q-P)
                t = sp.symbols('t')
                line_vec = Q - P
                X = P + t*line_vec
                eq = (X.distance(D))**2 - (P.distance(D))**2
                sol = sp.solve(eq, t)
                # there are two solutions, one t=0 (P). pick other
                t_vals = [s for s in sol if not sp.simplify(s)==0]
                if not t_vals:
