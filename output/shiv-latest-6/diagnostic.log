            # function to compute Fermat point using rotation method
            def fermat_point(X, Y, Z):
                # rotate Z around X by 60 deg
                R60 = sp.Matrix([[sp.cos(sp.pi/3), -sp.sin(sp.pi/3)],
                                 [sp.sin(sp.pi/3), sp.cos(sp.pi/3)]])
                Xv = sp.Matrix([X.x, X.y])
                Yv = sp.Matrix([Y.x, Y.y])
                Zv = sp.Matrix([Z.x, Z.y])
                Zp = sp.Point(*(Xv + R60*(Zv - Xv)))
                Xp = sp.Point(*(Yv + R60*(Xv - Yv)))  # rotate X around Y
                # line through Y and Zp
                line1 = sp.Line(Y, Zp)
                # line through Z and Xp
                line2 = sp.Line(Z, Xp)
                P = line1.intersection(line2)[0]
                return P
            
            P = fermat_point(X, Y, Z)
            P
            
