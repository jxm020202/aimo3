            def nullspace_basis(matrix):
                # matrix: list of rows as ints (length n_cols)
                n_rows = len(matrix)
                n_cols = max(matrix).bit_length() if matrix else 0
                # Perform Gaussian elimination, keep track of row operations to get reduced row echelon form
                A = matrix[:]  # copy
                pivots = []
                row = 0
                for col in range(n_cols):
                    # find pivot row with bit col set at or below current row
                    pivot = None
                    for r in range(row, n_rows):
                        if (A[r] >> col) & 1:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    pivots.append(col)
                    # eliminate other rows
                    for r in range(n_rows):
                        if r != row and ((A[r] >> col) & 1):
                            A[r] ^= A[row]
                    row += 1
                    if row == n_rows:
                        break
                # Now A is in reduced row echelon form (not necessarily sorted)
                # Determine free columns
                pivot_set = set(pivots)
                free_cols = [c for c in range(n_cols) if c not in pivot_set]
                basis = []
                # For each free column, construct a basis vector for nullspace:
                # Set free column to 1, other free columns to 0, solve for pivot variables.
                for free in free_cols:
                    vec = 0
                    # set free column bit
                    vec |= 1 << free
                    # For each pivot row, determine its variable value to satisfy equation.
                    # Row equation: sum_{col where A[row] has 1} x_col = 0 (mod 2)
                    # Since pivot column is the leading 1, we can solve for it:
                    # x_pivot = sum_{col != pivot and A[row][col]=1} x_col
                    for r, piv in enumerate(pivots):
                        # compute sum of known bits (free columns) in this row
                        row_bits = A[r]
                        # exclude pivot column
                        mask = row_bits & ~((1 << piv))
                        # compute parity of bits where mask has 1 and vec has 1
                        parity = bin(mask & vec).count("1") % 2
                        if parity:
                            # set pivot bit to 1 to make sum zero
                            vec |= 1 << piv
                    basis.append(vec)
                return basis, pivots
            
            basis, pivots = nullspace_basis(ints)
            len(basis)
