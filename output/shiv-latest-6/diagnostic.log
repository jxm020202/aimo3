            def circle_intersections(C1, rad1, C2, rad2):
                # returns two points (sympy Points)
                x1, y1 = C1.x, C1.y
                x2, y2 = C2.x, C2.y
                d_cent = sp.sqrt((x2 - x1)**2 + (y2 - y1)**2)
                # ex unit vector from C1 to C2
                ex = (x2 - x1) / d_cent
                ey = (y2 - y1) / d_cent
                # distance from C1 to line of intersection points
                a_len = (rad1**2 - rad2**2 + d_cent**2) / (2*d_cent)
                h_len_sq = rad1**2 - a_len**2
                # handle symbolic sqrt
                h_len = sp.sqrt(h_len_sq)
                # point P = C1 + a_len * e
                Px = x1 + a_len * ex
                Py = y1 + a_len * ey
                # intersection points
