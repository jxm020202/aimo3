                M = matrix.copy()
                rows, cols = M.shape
                r = 0
                for c in range(cols):
                    # find pivot
                    piv = None
                    for i in range(r, rows):
                        if M[i,c]==1:
                            piv = i
                            break
                    if piv is None:
                        continue
                    if piv != r:
                        M[[r,piv]] = M[[piv,r]]
                    for i in range(rows):
                        if i!=r and M[i,c]==1:
                            M[i] ^= M[r]
                    r+=1
                    if r==rows:
                        break
                return r
            
