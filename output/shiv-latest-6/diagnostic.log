            def compute_P_numeric(beta, gamma):
                # points on unit circle as complex numbers
                a = complex(1,0)
                b = cmath.exp(1j*2*gamma)
                c = cmath.exp(-1j*2*beta)  # cos2beta - i sin2beta
                # rotation by 60 deg
                rot = cmath.exp(1j*math.pi/3)
                Bp = a + rot*(b - a)
                Cp = b + rot*(c - b)
                # intersection of lines Bp-C and Cp-A
                # solve using linear algebra
                # Represent as vectors
                p1 = Bp
                p2 = c
                q1 = Cp
                q2 = a
                # compute intersection using cross product method
                def cross(u,v):
                    return (u.conjugate()*v).imag
                u = p2 - p1
                v = q2 - q1
                w = q1 - p1
                denom = cross(u, v)
                if abs(denom) < 1e-12:
                    return None
                t = cross(w, v) / denom
                P = p1 + t*u
                return P
            
            def nine_point_center_numeric(beta, gamma):
                # compute points as complex
                a = complex(1,0)
                b = cmath.exp(1j*2*gamma)
                c = cmath.exp(-1j*2*beta)
                # compute circumcenter O of triangle (a,b,c)
                # using formula for circumcenter of points on unit circle: O is origin (0) because they lie on unit circle centered at origin.
                # Indeed, since a,b,c are on unit circle centered at origin, circumcenter O = 0.
                O = 0+0j
