            def gf2_nullspace(matrix):
                # matrix: list of rows (vectors) as list of ints 0/1, shape m x n
                # returns list of basis vectors for nullspace (as list of int bitsets)
                m = len(matrix)
                n = len(matrix[0])
                # Convert to row-echelon form, track pivot columns
                # We'll use bitset rows as ints
                rows = [int(''.join(str(b) for b in row), 2) for row in matrix]
                pivot_cols = []
                row = 0
                for col in range(n):
                    mask = 1 << (n-1-col)
                    # find pivot
                    sel = None
                    for r in range(row, m):
                        if rows[r] & mask:
                            sel = r
                            break
                    if sel is None:
                        continue
                    # swap
                    rows[row], rows[sel] = rows[sel], rows[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r != row and (rows[r] & mask):
                            rows[r] ^= rows[row]
                    row += 1
                    if row == m:
                        break
                # Now rows are in reduced row echelon form (RREF) over GF(2)
                # Determine free columns
                free_cols = [c for c in range(n) if c not in pivot_cols]
                # For each free column, construct a nullspace vector
                nullspace = []
                for free in free_cols:
                    # vector with 1 at free column, and set pivot columns accordingly
                    vec = 0
                    # set bit at free column
                    vec |= 1 << (n-1-free)
                    # For each pivot row, determine its coefficient to cancel free column
                    # Each pivot row has a leading 1 at its pivot column; the row also may have 1s in free columns
                    # For each pivot row i (with pivot at pivot_cols[i]), if that row has a 1 in the free column, then set that pivot column bit in vec
                    for r_idx, piv in enumerate(pivot_cols):
                        # row r_idx corresponds to rows[r_idx] after elimination
                        if rows[r_idx] & (1 << (n-1-free)):
                            # need to set pivot column bit
                            vec |= 1 << (n-1-piv)
                    nullspace.append(vec)
                return nullspace
            
            nullspace = gf2_nullspace(matrix)
            len(nullspace)
            
