            def max_black_for_parities(row_parity, col_parity):
                n=19
                N=n*n
                c = -np.ones(N, dtype=int)  # maximize sum x => minimize -sum
                # variables: x_ij binary (N), y_i integer (n), z_j integer (n)
                # total variables = N + n + n
                # Build A matrix for constraints
                # Row constraints: sum_{j} x_{i,j} - 2*y_i = row_parity[i]
                # Column constraints: sum_{i} x_{i,j} - 2*z_j = col_parity[j]
                # We'll use LinearConstraint with bounds equalities.
                # Build A rows
                rows = []
                lbs = []
                ubs = []
                # row constraints
                for i in range(n):
                    coeff = np.zeros(N + 2*n, dtype=int)
                    for j in range(n):
                        coeff[i*n + j] = 1
                    coeff[N + i] = -2  # y_i variable index N+i
                    rows.append(coeff)
                    lbs.append(row_parity[i])
                    ubs.append(row_parity[i])
                # column constraints
                for j in range(n):
                    coeff = np.zeros(N + 2*n, dtype=int)
                    for i in range(n):
                        coeff[i*n + j] = 1
                    coeff[N + n + j] = -2  # z_j variable index N+n+j
                    rows.append(coeff)
                    lbs.append(col_parity[j])
                    ubs.append(col_parity[j])
                A = np.vstack(rows)
                lc = LinearConstraint(A, lbs, ubs)
                # bounds for variables: x in [0,1], y,z >=0 (no upper bound)
                bounds = Bounds(np.concatenate([np.zeros(N), np.zeros(n), np.zeros(n)]),
                                np.concatenate([np.ones(N), np.full(n, np.inf), np.full(n, np.inf)]))
                res = milp(c, constraints=[lc], bounds=bounds, integrality=np.concatenate([np.ones(N), np.ones(n), np.ones(n)]))
                if not res.success:
                    print("MILP failed")
                    return None
                max_black = -res.fun
                return max_black
            
