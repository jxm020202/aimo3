                # compute cumulative max/min from 0 up to j
                cum_max = 0
                cum_min = 0
                for j in range(k+1):
                    wj = w[j]
                    if wj >= 0:
                        cum_max += 6*wj
                        # min contribution is 0
                    else:
                        cum_min += 6*wj  # wj negative, 6*wj is negative, min (most negative) when digit=6
                    max_contrib[j] = cum_max
                    min_contrib[j] = cum_min
                # Actually we need for remaining positions (0..j-1) when we are at position j (starting from most).
                # Let's just use recursion with pruning using bounds of remaining positions.
                @lru_cache(None)
                def dfs(pos, current_sum):
                    # pos: current position index (starting from k down to -1). When pos == -1, all positions assigned.
                    if pos == -1:
                        return 1 if current_sum == 0 else 0
                    # Determine weight
                    wj = w[pos]
                    # Determine possible digit range
                    d_start = 1 if pos == k else 0
                    total = 0
                    # For pruning, compute remaining max/min possible contributions from positions 0..pos-1
                    # We'll compute max_possible and min_possible for remaining positions (lower indices)
                    # Precompute arrays for remaining positions quickly:
