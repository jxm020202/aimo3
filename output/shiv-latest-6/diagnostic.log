            import random, math, cmath, itertools, sys, numpy as np
            def rotate(p, angle):
                # rotate point p (complex) around origin by angle radians
                return p * cmath.exp(1j*angle)
            
            def fermat_point(A,B,C):
                # Compute first Fermat point (interior) using construction with outward equilateral triangles
                # Determine orientation: we need to ensure equilateral triangles are constructed outward relative to triangle orientation.
                # We'll compute both possibilities and choose the one inside triangle.
                # Use complex numbers for points.
                # Build equilateral triangle on AB outward: rotate vector B-A by +60° around A.
                D = A + rotate(B-A, math.radians(60))
                # equilateral triangle on BC outward: rotate C-B by +60° around B.
                E = B + rotate(C-B, math.radians(60))
                # Intersection of lines C-D and A-E
                # line defined by two points: p1 + t*(p2-p1)
                def line_intersection(p1,p2,p3,p4):
                    # solve p1 + t*(p2-p1) = p3 + s*(p4-p3)
                    # using complex numbers: treat as 2D vectors
                    x1,y1 = p1.real, p1.imag
                    x2,y2 = p2.real, p2.imag
                    x3,y3 = p3.real, p3.imag
                    x4,y4 = p4.real, p4.imag
                    # Solve linear equations
                    # (x2-x1)*t - (x4-x3)*s = x3 - x1
                    # (y2-y1)*t - (y4-y3)*s = y3 - y1
                    A = np.array([[x2-x1, -(x4-x3)],[y2-y1, -(y4-y3)]], dtype=float)
                    b = np.array([x3-x1, y3-y1], dtype=float)
                    try:
                        t,s = np.linalg.solve(A,b)
                    except np.linalg.LinAlgError:
                        return None
                    return p1 + t*(p2-p1)
                F = line_intersection(C,D,A,E)
                # Check if inside triangle (barycentric coordinates all positive)
                # Use area method
                def is_inside(P):
                    # compute barycentric using cross products
                    def area(p,q,r):
