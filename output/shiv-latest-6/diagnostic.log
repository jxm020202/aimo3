            def find_labelings(n, max_val=5):
                # brute force all assignments 0..max_val
                cells = [(i,j) for i in range(n) for j in range(n)]
                solutions=[]
                for vals in itertools.product(range(max_val+1), repeat=n*n):
                    grid = {}
                    for (i,j),v in zip(cells, vals):
                        grid[(i,j)] = v
                    ok=True
