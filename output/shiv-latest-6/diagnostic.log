            def orthocenter(pts):
                t1,t2,t3,t4 = pts
                hx,hy,hz = sp.symbols('hx hy hz')
                h = sp.Matrix([hx,hy,hz])
                eqs = [
                    (h - t1).dot(t2 - t3),
                    (h - t1).dot(t2 - t4),
                    (h - t2).dot(t1 - t3)
                ]
                sol = sp.solve(eqs, (hx,hy,hz), dict=True)
                if not sol:
                    return None
                sol = sol[0]
                return sp.Matrix([sol[hx], sol[hy], sol[hz]])
            
            def ratio(pts):
                t1,t2,t3,t4 = pts
                K = orthocenter(pts)
                if K is None:
                    return None
                n = (t3 - t2).cross(t4 - t2)
                d = K - t1
                t = sp.symbols('t')
                L = t1 + t*d
                solt = sp.solve((L - t2).dot(n), t)[0]
                X = sp.simplify(L.subs(t, solt))
                R2 = (t1).dot(t1)
                s = sp.symbols('s')
                eq = (t1 + s*d).dot(t1 + s*d) - R2
                sols = sp.solve(eq, s)
                s2 = [sol for sol in sols if not sol.is_zero][0]
                Y = sp.simplify(t1 + s2*d)
                KX = sp.sqrt(((K - X).dot(K - X)))
                KY = sp.sqrt(((K - Y).dot(K - Y)))
                return sp.nsimplify(KX/KY)
            
            for _ in range(5):
                pts = random_tetra()
                r = ratio(pts)
                print(r)
            
