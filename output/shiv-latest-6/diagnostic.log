            import mpmath as mp
            
            def area_for_p(p_val):
                # solve for t using root finding
                def f(t):
                    a = 12*t/(p_val + t)
                    q = mp.sqrt(t**2 - p_val**2)
                    return (a + p_val)**2 + q**2 - 784
