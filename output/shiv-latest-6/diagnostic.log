                N = size*size
                def idx(i,j): return i*size + j
                M = np.zeros((N,N), dtype=np.uint8)
                for i in range(size):
                    for j in range(size):
                        row = idx(i,j)
                        # row toggle
                        for col in range(size):
                            M[row, idx(i,col)] ^= 1
                        # column toggle
                        for row2 in range(size):
                            M[row, idx(row2,j)] ^= 1
                        # toggle intersection again
                        M[row, idx(i,j)] ^= 1
                rank = rank_mod2(M)
                dim_S = rank
