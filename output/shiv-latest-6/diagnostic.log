            def max_set(N):
                # grid points as (x,y) with 1..N
                points = [(x,y) for x in range(N) for y in range(N)]
                # adjacency constraints: for any four points forming isosceles trapezoid with bases horizontal or vertical, cannot all be selected.
                # Precompute forbidden quadruples (as sets of indices)
                idx = {p:i for i,p in enumerate(points)}
                forb = []
                # horizontal bases
                for y1 in range(N):
                    for y2 in range(N):
                        if y1>=y2: continue
                        # choose two points in each row
                        xs = list(range(N))
                        for a in xs:
                            for b in xs:
                                if a>=b: continue
                                for c in xs:
                                    for d in xs:
                                        if c>=d: continue
                                        if a + d == b + c:
                                            forb.append({idx[(a,y1)], idx[(b,y1)], idx[(c,y2)], idx[(d,y2)]})
                # vertical bases
                for x1 in range(N):
                    for x2 in range(N):
                        if x1>=x2: continue
                        ys = list(range(N))
                        for a in ys:
                            for b in ys:
                                if a>=b: continue
                                for c in ys:
                                    for d in ys:
                                        if c>=d: continue
                                        if a + d == b + c:
                                            forb.append({idx[(x1,a)], idx[(x1,b)], idx[(x2,c)], idx[(x2,d)]})
                # remove duplicates
                forb = [frozenset(s) for s in forb]
                forb = list(set(forb))
                # backtrack
                best = 0
                best_set = None
                # order points maybe by degree
                deg = [0]*len(points)
                for s in forb:
                    for i in s:
                        deg[i]+=1
                order = sorted(range(len(points)), key=lambda i: deg[i])
                # recursive
                selected = [False]*len(points)
                def backtrack(pos, count):
                    nonlocal best,best_set
                    if pos==len(order):
                        if count>best:
                            best=count
                            best_set=selected.copy()
                        return
                    # bound: remaining points
                    if count + (len(order)-pos) <= best:
                        return
                    i = order[pos]
                    # try include if not violating any forbidden set
                    can = True
                    if not selected[i]:
                        for s in forb:
                            if i in s:
                                # check if other three already selected
                                other = [j for j in s if j!=i]
                                if all(selected[j] for j in other):
                                    can=False
                                    break
                    if can:
                        selected[i]=True
                        backtrack(pos+1, count+1)
                        selected[i]=False
                    # skip
                    backtrack(pos+1, count)
                backtrack(0,0)
                return best
            
            for N in range(1,5):
                print(N, max_set(N))
            
