            import random
            size=19
            def parity_row(board, r):
                return sum(board[r*size:(r+1)*size])%2
            def parity_col(board, c):
                return sum(board[c::size])%2
            
            def apply(board,i,j):
                new=board[:]
                for col in range(size):
                    idx=i*size+col
                    new[idx]^=1
                for row in range(size):
                    idx=row*size+j
                    new[idx]^=1
                # intersection toggled twice? but we need once. So toggle again to correct:
                idx=i*size+j
                new[idx]^=1
                return new
            
            def invariants(board):
                inv=[]
                p0=parity_row(board,0)
                for i in range(1,size):
                    inv.append(p0 ^ parity_row(board,i))
                q0=parity_col(board,0)
                for j in range(1,size):
                    inv.append(q0 ^ parity_col(board,j))
                return tuple(inv)
            
            # test random
            board=[random.randint(0,1) for _ in range(size*size)]
            inv0=invariants(board)
            board2=apply(board,5,7)
            inv1=invariants(board2)
            inv0==inv1
            
