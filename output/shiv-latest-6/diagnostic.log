                # points
                Y = (a,b)
                P = (a*0.25/(a**2+b**2), b*0.25/(a**2+b**2))
                # compute sQ and Q
                sQ = ((a-1)**2 + b**2 + 0.75)/(((a-1)**2 + b**2)+1)
                Q = (a + sQ*(1-a), b*(1 - sQ))
                S = (xs,ys)
                angles = {name:ang(pt) for name,pt in [('Y',Y),('P',P),('Q',Q),('S',S)]}
                # normalize to 0-2pi
                for k in angles:
                    if angles[k] <0:
                        angles[k] += 2*math.pi
                print(angles)
                # Determine ordering along circle: we need arc YQ not containing P, S should be on that arc.
                # We'll check if moving from Y to Q clockwise (or ccw) passes P or not.
                # Let's compute difference angles ccw from Y to Q.
                diff_ccw = (angles['Q'] - angles['Y']) % (2*math.pi)
                # Check if P lies on that ccw arc
