            def compute_solution(sign_Q, sign_S):
                a,b,R = a_val,b_val,R_val
                x = a**2/(2*R)
                Mx = a**2 * d/(4*R**2)
                My = a**2 * h_val/(2*R**2)
                upx = -h_val/R
                upy = d/(2*R)
                h1 = math.sqrt(a**2 - x**2)
                Qx = Mx + sign_Q*h1*upx
                Qy = My + sign_Q*h1*upy
                Rx = Mx - sign_Q*h1*upx
                Ry = My - sign_Q*h1*upy
                Nx = d - b**2 * d/(4*R**2)
                Ny = b**2 * h_val/(2*R**2)
                up2x = -h_val/R
                up2y = -d/(2*R)
                h2 = math.sqrt(b**2 - (b**2/(2*R))**2)
                Sx = Nx + sign_S*h2*up2x
                Sy = Ny + sign_S*h2*up2y
                Tx = Nx - sign_S*h2*up2x
                Ty = Ny - sign_S*h2*up2y
                SQ = math.hypot(Sx-Qx, Sy-Qy)
