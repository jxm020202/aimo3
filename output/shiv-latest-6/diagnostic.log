            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def min_weight_for_syndrome(syndrome, H):
                # syndrome: length r (36) binary array
                # H: shape (r, n) binary matrix
                r, n = H.shape
                # variables: e (n binary) + z (r integer)
                c = np.concatenate([np.ones(n), np.zeros(r)])  # minimize sum of e
                # Equality constraints: H e - 2*z = syndrome
                A_eq = np.concatenate([H, -2*np.eye(r)], axis=1)
                b_eq = syndrome.astype(np.int64)
                # bounds: e in [0,1], z >= 0 (no upper bound)
                lb = np.concatenate([np.zeros(n), np.zeros(r)])
                ub = np.concatenate([np.ones(n), np.full(r, np.inf)])
                bounds = Bounds(lb, ub)
                integrality = np.concatenate([np.ones(n), np.ones(r)])  # all integer (binary for e, integer for z)
                # Use milp
                res = milp(c=c, constraints=LinearConstraint(A_eq, b_eq, b_eq), bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    # maybe infeasible?
                    return None
                weight = sum(res.x[:n])
                return int(round(weight))
            
