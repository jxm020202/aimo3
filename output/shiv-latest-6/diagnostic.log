            import numpy as np, sympy as sp, math, random, sys, itertools, mpmath as mp
            
            def fermat_point(theta):
                # Solve for fx, fy given theta, using nsolve
                # Provide initial guess near interior point: maybe barycenter?
                # Use sympy nsolve
                # Use equations eq1_expr, eq2_expr defined earlier with theta as symbol
                # We'll substitute numeric theta then solve for fx, fy.
                th = float(theta)
                # define numeric functions
                # Use sympy with substitution
                subs = {sp.cos(theta): math.cos(th), sp.sin(theta): math.sin(th)}
                # For O and N we need them as functions of theta
                # We'll recompute numeric O,N for given theta
                X = sp.Point(math.cos(th), math.sin(th))
                Y = sp.Point(0,0)
                Z = sp.Point(1,0)
                O = sp.Circle(X, Y, Z).center
                N = (X + Y + Z - O) / 2
                # unknowns fx, fy
                fx_sym, fy_sym = sp.symbols('fx fy')
                F = sp.Point(fx_sym, fy_sym)
                Xf = X - F
                Yf = Y - F
                Zf = Z - F
                len_XY = sp.sqrt(Xf.dot(Xf))
                len_YZ = sp.sqrt(Yf.dot(Yf))
                len_ZY = sp.sqrt(Zf.dot(Zf))
                eq1 = sp.Eq(Xf.dot(Yf), -sp.Rational(1,2) * len_XY * len_YZ)
                eq2 = sp.Eq(Yf.dot(Zf), -sp.Rational(1,2) * len_YZ * len_ZY)
                # solve numerically
                # initial guess: maybe centroid: ( (cos+0+1)/3, sin/3 )
                guess_fx = (math.cos(th)+1)/3
                guess_fy = math.sin(th)/3
                try:
                    sol = sp.nsolve([eq1.lhs - eq1.rhs, eq2.lhs - eq2.rhs],
                                    [fx_sym, fy_sym],
                                    [guess_fx, guess_fy],
                                    tol=1e-14, maxsteps=100)
                    fx_val, fy_val = float(sol[0]), float(sol[1])
                    return (fx_val, fy_val, N.x.evalf(), N.y.evalf())
                except Exception as e:
                    # fallback: return None
                    return None
            
            def cross_val(theta):
                res = fermat_point(theta)
                if res is None:
                    return None
                fx, fy, Nx, Ny = res
                return fx*float(Ny) - fy*float(Nx)
            
            # test for some theta values
            for th in [0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1.0]:
                print(th, cross_val(th))
            
