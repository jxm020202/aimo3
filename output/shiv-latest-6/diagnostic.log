                n = max(row.bit_length() for row in matrix)
                rows = matrix[:]
                # Perform Gaussian elimination to row-echelon form, tracking pivot columns
                pivot_cols = []
                row = 0
                for col in range(n-1, -1, -1):
                    # find pivot row with bit col set
                    pivot = None
                    for i in range(row, len(rows)):
                        if (rows[i] >> col) & 1:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap to current row
                    rows[row], rows[pivot] = rows[pivot], rows[row]
                    pivot_cols.append(col)
                    # eliminate below
                    for i in range(len(rows)):
                        if i != row and ((rows[i] >> col) & 1):
                            rows[i] ^= rows[row]
                    row += 1
                    if row == len(rows):
                        break
                # pivot_cols now list of pivot column indices (in decreasing order)
                pivot_set = set(pivot_cols)
                free_cols = [c for c in range(n) if c not in pivot_set]
                # For each free column, construct a basis vector
                basis = []
                # We'll need the reduced rows (after elimination) to express pivot variables in terms of free vars.
                # The rows are now in reduced row echelon form (each pivot column has a single 1 in its row, and other rows have 0 there).
