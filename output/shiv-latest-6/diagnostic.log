            def generate_walks(n):
                # generate walks of length n with steps +/-1, start at 0
                walks = []
                # represent as list of values
                # using recursion or iterative bit representation
                for mask in range(1 << (n-1)):
                    walk = [0]*n
                    for i in range(1,n):
                        step = 1 if (mask >> (i-1)) & 1 else -1
                        walk[i] = walk[i-1] + step
                    walks.append(walk)
                return walks
            
            def walk_stats(walk):
                s = sum(walk)
                mn = min(walk)
                return s, mn
            
