            def convex_hull(points):
                # points list of (x,y)
                pts = sorted(set(points))
                if len(pts) <=1:
                    return pts
                def cross(o,a,b):
                    return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
                lower=[]
                for p in pts:
                    while len(lower)>=2 and cross(lower[-2], lower[-1], p) <=0:
                        lower.pop()
                    lower.append(p)
                upper=[]
                for p in reversed(pts):
                    while len(upper)>=2 and cross(upper[-2], upper[-1], p) <=0:
                        upper.pop()
                    upper.append(p)
                return lower[:-1]+upper[:-1]
            
            def area_polygon(poly):
                area=0.0
                n=len(poly)
                for i in range(n):
                    x1,y1=poly[i]
                    x2,y2=poly[(i+1)%n]
                    area+=x1*y2-x2*y1
                return abs(area)/2
            
            def hull_area(signs, sol):
                r1v,r2v,hv=sol
                Rv=math.sqrt(7.5**2+hv**2)
                alpha=math.acos(1 - r1v**2/(2*Rv**2))
                beta=math.acos(1 - r2v**2/(2*Rv**2))
                u=sp.Matrix([7.5,hv])
