            def find_perm(N):
                used_diff=set()
                used_sum=set()
                perm=[None]*(N+1)  # 1-indexed
                def backtrack(i):
                    if i>N:
                        return True
                    for val in range(1,N+1):
                        if val==i: continue
                        if val in perm: continue
                        diff=abs(i-val)
                        s=i+val
                        if diff in used_diff or s in used_sum:
                            continue
                        used_diff.add(diff)
                        used_sum.add(s)
                        perm[i]=val
                        if backtrack(i+1):
                            return True
                        # undo
                        used_diff.remove(diff)
                        used_sum.remove(s)
                        perm[i]=None
                    return False
                if backtrack(1):
                    return perm[1:]
