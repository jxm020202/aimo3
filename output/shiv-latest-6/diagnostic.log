            def max_points(N):
                M = 2*N - 3
                # DP: maximize total points given N rows, each size >=0 integer, sum C(t,2) <= M
                # brute for small N to see pattern
                from functools import lru_cache
                @lru_cache(None)
                def dp(rows, pairs):
                    if rows==0:
                        return 0
                    best=0
                    # try size s for this row
                    for s in range(0, N+1):
                        need = s*(s-1)//2
                        if need>pairs: break
                        val = s + dp(rows-1, pairs-need)
                        if val>best:
                            best=val
                    return best
                return dp(N, M)
            
            for N in range(1,11):
                print(N, max_points(N))
            
