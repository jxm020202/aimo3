            def find_solutions_sqfree(limit):
                sols=[]
                for x in range(1, limit+1, 2):
                    N = x**3 + 1
                    if N % 2 != 0:
                        continue
                    half = N//2
                    fac = sp.factorint(half)
                    # compute squarefree part: product of primes with odd exponent
                    sf = 1
                    for p, e in fac.items():
                        if e % 2 == 1:
                            sf *= p
                    # need sf to be prime and ≡5 mod8
                    if sf != 1 and sp.isprime(sf) and sf % 8 == 5:
                        # compute y^2 = half / sf
                        q = half // sf
                        y = int(math.isqrt(q))
                        if y*y == q:
                            sols.append((x, y, sf))
                return sols
            
