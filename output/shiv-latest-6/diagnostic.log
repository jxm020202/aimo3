            import sympy as sp
            h_val = sp.Rational(35,8)
            a = sp.symbols('a', real=True)
            b = 15 - a
            D = sp.Rational(15,2)
            R = sp.sqrt(D**2 + h_val**2)  # sqrt(4825)/8
            
            # compute distances using formulas but maybe we can use chord length formulas directly.
            
            # chord SQ length: 2 = 2*R*sin(theta_SQ/2) where theta_SQ = 2*arcsin(1/R)
            # So chord length 2 corresponds to sin(theta_SQ/2) = 1/R
            # That's automatically satisfied.
            
            # But we need also that the chord SQ connects point on Gamma1 and Gamma2.
            
            # Let's compute a using condition that distance between S and Q is 2.
            
            # We'll compute coordinates as before with s1=-1, s2=1 (the convex case)
            s1_val = -1
            s2_val = 1
            
            def compute_coords_sym(a):
                b = 15 - a
                D = sp.Rational(15,2)
                R = sp.sqrt(D**2 + h_val**2)
                x = a**2/(2*R)
                y = b**2/(2*R)
                M1x = a**2 * D/(2*R**2)
                M1y = a**2 * h_val/(2*R**2)
                M2x = 15 - b**2 * D/(2*R**2)
                M2y = b**2 * h_val/(2*R**2)
                L1 = sp.sqrt(a**2 - x**2)
                L2 = sp.sqrt(b**2 - y**2)
                perp1x = -h_val / R
                perp1y = D / R
                perp2x = -h_val / R
                perp2y = -D / R
                Qx = M1x + s1_val*L1*perp1x
                Qy = M1y + s1_val*L1*perp1y
                Rx = M1x - s1_val*L1*perp1x
                Ry = M1y - s1_val*L1*perp1y
                Sx = M2x + s2_val*L2*perp2x
                Sy = M2y + s2_val*L2*perp2y
                Tx = M2x - s2_val*L2*perp2x
                Ty = M2y - s2_val*L2*perp2y
                return sp.simplify((Sx-Qx)**2 + (Sy-Qy)**2), sp.simplify((Tx-Rx)**2 + (Ty-Ry)**2)
            
            expr_SQ_sq, expr_RT_sq = compute_coords_sym(a)
            sp.simplify(expr_SQ_sq)
            
