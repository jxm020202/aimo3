            import random, math, numpy as np
            
            def angle_OX_OI(A,B,C):
                R=1
                # coordinates as earlier
                X = np.array([R,0.0])
                Y = np.array([R*math.cos(2*C), R*math.sin(2*C)])
                Z = np.array([R*math.cos(2*B), -R*math.sin(2*B)])
                a = 2*R*math.sin(A)
                b = 2*R*math.sin(B)
                c = 2*R*math.sin(C)
                I = (a*X + b*Y + c*Z)/(a+b+c)
                # compute angle between X vector and I vector
                dot = np.dot(X, I)
                cosphi = dot / (np.linalg.norm(X)*np.linalg.norm(I))
                return math.acos(cosphi)
            
            def test_random():
                for _ in range(5):
                    B = random.uniform(0.2,1.2)
                    C = random.uniform(0.2,1.2)
                    A = math.pi - B - C
