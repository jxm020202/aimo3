            def gf2_rank(matrix):
                A = matrix.copy()
                rows, cols = A.shape
                rank = 0
                pivot_col = 0
                for r in range(rows):
                    # find pivot row with a 1 in some column >= pivot_col
                    while pivot_col < cols:
                        # find row i >= r with A[i, pivot_col]==1
                        rows_with_one = np.where(A[r:, pivot_col]==1)[0]
                        if rows_with_one.size>0:
                            i = r + rows_with_one[0]
                            # swap rows r and i
                            if i != r:
                                A[[r,i]] = A[[i,r]]
                            # eliminate other rows
                            for k in range(rows):
                                if k != r and A[k, pivot_col]==1:
                                    A[k] ^= A[r]
                            rank += 1
                            pivot_col += 1
                            break
                        else:
                            pivot_col += 1
                    else:
                        break
                return rank
            
