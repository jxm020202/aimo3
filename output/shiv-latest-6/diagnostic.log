            def generate_walk_stats(n):
                # generate all walks of length n-1 steps, starting at 0.
                # returns list of (min_val, sum_val)
                stats=[]
                # use recursion or iterative bit representation
                # steps encoded as bits: 0 -> -1, 1 -> +1
                total_walks=1<<(n-1)
                for mask in range(total_walks):
                    pos=0
                    min_val=0
                    sum_val=pos
                    for i in range(n-1):
                        step = 1 if (mask>>i)&1 else -1
                        pos += step
                        sum_val += pos
                        if pos < min_val:
                            min_val = pos
                    stats.append((min_val, sum_val))
                return stats
            
