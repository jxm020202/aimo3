            import mpmath as mp
            
            def LHS(x):
                term = (1+x**2)/2
                sqrt_term = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)/6
                A = (term + sqrt_term) ** (1/3)
                B = (term - sqrt_term) ** (1/3)
                return A + B
            
            def cubic_res(x):
                t = LHS(x)
                return t**3 + x**2*t - (1 + x**2)
            
