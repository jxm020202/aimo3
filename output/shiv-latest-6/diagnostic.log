            import random, math
            def angle_Z(u,v):
                X=(0,0); Y=(1,0); Z=(u,v)
                # angle at Z between ZX and ZY
                ZX=(X[0]-Z[0], X[1]-Z[1])
                ZY=(Y[0]-Z[0], Y[1]-Z[1])
                dot=ZX[0]*ZY[0]+ZX[1]*ZY[1]
                norm1=math.hypot(*ZX)
                norm2=math.hypot(*ZY)
                return math.degrees(math.acos(dot/(norm1*norm2)))
            
            def is_acute(u,v):
                # compute all angles
                X=(0,0); Y=(1,0); Z=(u,v)
                def ang(a,b,c):
                    ba=(a[0]-b[0], a[1]-b[1])
                    bc=(c[0]-b[0], c[1]-b[1])
                    dot=ba[0]*bc[0]+ba[1]*bc[1]
                    return math.degrees(math.acos(dot/(math.hypot(*ba)*math.hypot(*bc))))
