                BA = A - B
                BC = C - B
                ang = abs(math.atan2((BA.conjugate()*BC).imag, (BA.conjugate()*BC).real)
                # ensure between 0 and pi
                if ang > math.pi:
                    ang = 2*math.pi - ang
                return ang
            
