                # also maintain for each row list of x selected, each column list of y selected.
                rows = {y: [] for y in range(1,n+1)}
                cols = {x: [] for x in range(1,n+1)}
                # also maintain sum sets per row and column
                row_sums = {y: set() for y in range(1,n+1)}
                col_sums = {x: set() for x in range(1,n+1)}
                best_set = set()
                def backtrack(idx, selected):
                    nonlocal best, best_set
                    if idx==N:
                        if len(selected)>best:
                            best=len(selected); best_set=selected.copy()
                        return
                    # pruning
                    if len(selected)+(N-idx) <= best:
                        return
                    x,y = pts[idx]
                    # option to include
                    ok=True
                    # check horizontal condition: need at least two points already in row y to cause issue with another row?
