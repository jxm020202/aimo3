            def count_solutions_by_m(max_m):
                total_solutions = []
                for m in range(1, max_m+1):
                    # compute f(m,d) for each digit d
                    f_vals = [f_remove_all(m, d) for d in range(7)]
                    # enumerate all sequences of length m (digits b_{m-1}...b_0)
                    # Use recursion or product
                    from itertools import product
                    count = 0
                    sols = []
                    for lower_digits in product(range(7), repeat=m):
                        # lower_digits is tuple of length m: b_{m-1},...,b_0 (most to least? Actually we need order)
                        # Let's define lower_digits[0] = b_{m-1} (most significant among lower), ..., lower_digits[-1] = b_0.
                        # Compute S = sum_{i=0}^{m-1} f(m, b_i)
                        # i index from 0 (least) to m-1 (most among lower). So we need to map.
                        # lower_digits reversed for i.
                        S = 0
                        L = 0
                        for i in range(m):
                            b_i = lower_digits[m-1 - i]  # b_i = digit at position i (least)
                            S += f_vals[b_i]
                            L += b_i * (7**i)
                        # Now compute Q = (S - L) // 7**m if divisible
                        diff = S - L
                        if diff % (7**m) != 0:
                            continue
                        Q = diff // (7**m)
                        if 1 <= Q <= 6:
                            # construct full number n
                            # digits: b_m = Q, then lower_digits as given
                            # n = Q * 7**m + L
                            n = Q * (7**m) + L
                            # verify condition directly (optional)
