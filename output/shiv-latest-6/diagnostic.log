                for r in range(rows):
                    # Find pivot in column pivot_col or later
                    while pivot_col < cols:
                        # find row >= r with a 1 in pivot_col
                        rows_with_one = np.where(A[r:, pivot_col] == 1)[0]
                        if rows_with_one.size == 0:
