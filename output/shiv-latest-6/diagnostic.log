            from collections import deque
            
            def min_moves(n):
                # initial state: bits list length n, 0 for heads, 1 for tails? Let's define 1 = tail (needs odd flips)
                init = [(i%2) for i in range(1,n+1)]  # 1 for odd positions (tail)
                # target all 0
                target = tuple([0]*n)
                # state: (position, tuple bits)
                # first move can be any position, flip it.
                # subsequent moves must move to adjacent position.
                # BFS
                start_states=[]
                for pos in range(n):
                    bits=list(init)
                    bits[pos]^=1
                    start_states.append( (pos, tuple(bits)) )
                visited=set()
                q=deque()
                for st in start_states:
                    q.append( (st[0], st[1], 1) )  # moves count =1
                    visited.add( (st[0], st[1]) )
                while q:
                    pos, bits, moves = q.popleft()
                    if bits==target:
                        return moves
                    for np in [pos-1, pos+1]:
                        if 0<=np<n:
                            newbits=list(bits)
                            newbits[np]^=1
                            state=(np, tuple(newbits))
                            if state not in visited:
                                visited.add(state)
                                q.append( (np, tuple(newbits), moves+1) )
                return None
            
            for n in range(1,13,2):
