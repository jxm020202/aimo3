                # matrix: numpy array shape (m, n) dtype uint8
                A = matrix.copy()
                m, n = A.shape
                # Perform row echelon form, track pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find a row with a 1 in this column at or below current row
                    pivot = None
                    for r in range(row, m):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap rows
                    if pivot != row:
                        A[[pivot, row]] = A[[row, pivot]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r, col]:
                            A[r] ^= A[row]
                    pivot_cols.append(col)
                    row += 1
                    if row == m:
