            import sympy as sp
            import random, math, itertools, numpy as np
            
            def circumcenter(p1,p2,p3,p4):
                # Solve for center C such that |C-pi|^2 = r^2 for all i
                # Use linear equations: (C-p1)^2 = (C-p2)^2 => 2(C·(p2-p1)) = |p2|^2 - |p1|^2
                C = sp.symbols('Cx Cy Cz')
                Cvec = sp.Matrix(C)
                eqs = []
                for (a,b) in [(p2,p1),(p3,p1),(p4,p1)]:
                    eq = 2*(Cvec.dot(sp.Matrix(b)-sp.Matrix(a))) + (sp.Matrix(a).dot(sp.Matrix(a)) - sp.Matrix(b).dot(sp.Matrix(b)))
                    # Actually derived: |C-a|^2 = |C-b|^2 => C·C -2C·a + a·a = C·C -2C·b + b·b => -2C·a + a·a = -2C·b + b·b => 2C·(b-a) = b·b - a·a
                    # So eq: 2*C·(b-a) - (b·b - a·a) = 0
                    eq = 2*Cvec.dot(sp.Matrix(b)-sp.Matrix(a)) - (sp.Matrix(b).dot(sp.Matrix(b)) - sp.Matrix(a).dot(sp.Matrix(a)))
                    eqs.append(eq)
                sol = sp.solve(eqs, (C[0],C[1],C[2]), dict=True)[0]
                return sp.Matrix([sol[C[0]], sol[C[1]], sol[C[2]]])
            
            def monge_point(T):
                # T is list of 4 vectors
                T1,T2,T3,T4 = T
                n1 = (T3-T2).cross(T4-T2)
                n2 = (T4-T3).cross(T1-T3)
                n3 = (T1-T4).cross(T2-T4)
                n4 = (T2-T1).cross(T3-T1)
                # unknown K, lambda1..4
                K = sp.symbols('Kx Ky Kz')
                Kvec = sp.Matrix(K)
                lam = sp.symbols('l1 l2 l3 l4')
                eqs = []
                eqs += list(Kvec - T1 - lam[0]*n1)
                eqs += list(Kvec - T2 - lam[1]*n2)
                eqs += list(Kvec - T3 - lam[2]*n3)
                eqs += list(Kvec - T4 - lam[3]*n4)
                # 12 equations, 7 unknowns (Kx,Ky,Kz,l1..l4) -> overdetermined but consistent.
                sol = sp.solve(eqs, (K[0],K[1],K[2],lam[0],lam[1],lam[2],lam[3]), dict=True)[0]
                Ksol = sp.Matrix([sol[K[0]], sol[K[1]], sol[K[2]]])
                return Ksol
            
            def foot_of_perpendicular(T1, face_pts):
                # face_pts: three points defining plane
                A,B,C = face_pts
                n = (B-A).cross(C-A)
                # param t such that point = T1 + t n lies in plane: (T1 + t n - A)·n = 0
                t = - (T1 - A).dot(n) / n.dot(n)
                X = T1 + t*n
                return X, t
            
            def second_intersection(T1, K, C):
                # line param s: T1 + s n where n = K - T1 (direction)
                n = K - T1
                a = T1 - C
                n2 = n.dot(n)
                a_dot_n = a.dot(n)
                sY = -2*a_dot_n / n2
                Y = T1 + sY*n
                return Y, sY
            
