                    piv=None
                    for r in range(row,m):
                        if A[r][col]:
                            piv=r; break
                    if piv is None:
                        continue
                    A[row],A[piv]=A[piv],A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
