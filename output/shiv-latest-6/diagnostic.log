            def solve_n(n, total):
                N = n*n
                # variable ordering: first N x variables, then M y variables
                # Build constraints
                # We'll use scipy.optimize milp with linear constraints and integer variables.
                # milp expects c (objective), A_ub, b_ub, A_eq, b_eq, bounds, integrality
                # We'll set dummy objective (e.g., minimize 0)
                c = np.zeros(N + 2*n*(n-1))
                # Equality constraints: sum x = total
                A_eq = []
                b_eq = []
                sum_row = np.zeros(N + 2*n*(n-1))
                sum_row[:N] = 1
                A_eq.append(sum_row)
                b_eq.append(total)
                # Edge constraints: for each edge, x_i - x_j - (2*y - 1) = 0
                # We'll create equality constraints.
                # Map (i,j) to index
                idx = lambda i,j: i*n + j
                # edges list
                edges = []
                for i in range(n):
                    for j in range(n):
                        if i+1 < n:
                            edges.append((idx(i,j), idx(i+1,j)))
                        if j+1 < n:
                            edges.append((idx(i,j), idx(i,j+1)))
                M = len(edges)
                # y variables start after N
                for e_idx, (u,v) in enumerate(edges):
                    row = np.zeros(N + M)
                    # x_u - x_v - (2*y_e - 1) = 0
                    row[u] = 1
                    row[v] = -1
                    row[N + e_idx] = -2  # coefficient for y_e
                    # constant term +1 moved to RHS
                    A_eq.append(row)
                    b_eq.append(-1)  # because we have ... - (2*y -1) =0 => x_u - x_v -2*y +1 =0 => x_u - x_v -2*y = -1
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # bounds: x >=0, integer; y binary (0 or 1)
                bounds = [(0, None)]*N + [(0,1)]*M
                integrality = np.concatenate([np.ones(N, dtype=int), np.ones(M, dtype=int)])
                # Use milp
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A_eq, b_eq, b_eq), bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            
