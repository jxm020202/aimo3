            # Define symbolic intersect_original with sign choices
            def intersect_sym_original(C1, rad1, C2, rad2):
                x1,y1 = C1.x, C1.y
                x2,y2 = C2.x, C2.y
                d = sp.sqrt((x2-x1)**2 + (y2-y1)**2)
                a_len = (rad1**2 - rad2**2 + d**2)/(2*d)
                h_sq = rad1**2 - a_len**2
                h = sp.sqrt(h_sq)
                ex = (x2-x1)/d
                ey = (y2-y1)/d
                Px = x1 + a_len*ex
                Py = y1 + a_len*ey
                offset_x = -ey*h
                offset_y = ex*h
                P_plus = sp.Point(Px + offset_x, Py + offset_y)
                P_minus = sp.Point(Px - offset_x, Py - offset_y)
                return P_plus, P_minus
            
