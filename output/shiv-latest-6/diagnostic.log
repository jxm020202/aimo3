            import math
            
            R = 8.682777493406128
            h = 4.375
            
            def compute_polygon(r1):
                r2 = 15 - r1
                a1 = r1**2/(2*R)
                a2 = r2**2/(2*R)
                h1 = math.sqrt(r1**2 - a1**2)
                h2 = math.sqrt(r2**2 - a2**2)
                # points
                Qx = a1*7.5/R - h1*h/R
                Qy = a1*h/R + h1*7.5/R
                Rx = a1*7.5/R + h1*h/R
                Ry = a1*h/R - h1*7.5/R
                Sx = 15 - a2*7.5/R - h2*h/R
                Sy = a2*h/R - h2*7.5/R
                Tx = 15 - a2*7.5/R + h2*h/R
                Ty = a2*h/R + h2*7.5/R
                # order: S, Q, P1, R, T, P2
                P1 = (0.0, 0.0)
                P2 = (15.0, 0.0)
                S = (Sx, Sy)
                Q = (Qx, Qy)
                Rpt = (Rx, Ry)
                T = (Tx, Ty)
                return [S, Q, P1, Rpt, T, P2]
            
            def polygon_area(poly):
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2
            
            def is_convex(poly):
                # check cross product sign for each consecutive triple
                n = len(poly)
                prev = 0
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    x3,y3 = poly[(i+2)%n]
                    # vectors
                    v1 = (x2-x1, y2-y1)
                    v2 = (x3-x2, y3-y2)
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    if cross != 0:
                        if prev == 0:
                            prev = 1 if cross > 0 else -1
                        else:
                            if (cross > 0 and prev < 0) or (cross < 0 and prev > 0):
                                return False
                return True
            
            for r1 in [3.468871125850725, 11.531128874149275]:
                poly = compute_polygon(r1)
                area = polygon_area(poly)
                convex = is_convex(poly)
                print("r1", r1, "area", area, "convex", convex)
