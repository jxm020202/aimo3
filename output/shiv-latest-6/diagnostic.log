            def min_sumset_size(d, n):
                # brute force all subsets of {0..d} of size n containing 0 and d
                from itertools import combinations
                best=10**9
                bestA=None
                universe=range(d+1)
                for comb in combinations(universe, n):
                    if comb[0]!=0 or comb[-1]!=d:
                        continue
                    size=sumset_size(set(comb))
                    if size<best:
                        best=size
                        bestA=comb
                return best, bestA
            
