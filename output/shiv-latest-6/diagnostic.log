            def base7_digits(n):
                # return list of digits most significant first
                if n == 0:
                    return [0]
                digs = []
                while n > 0:
                    digs.append(n % 7)
                    n //= 7
                return digs[::-1]
            
            def delete_digit_at_position(digs, i):
                # digs list most significant first
                # i counted from least significant (0 = least)
                idx = len(digs) - 1 - i
                # remove that digit
                new = digs[:idx] + digs[idx+1:]
                # interpret as base-7 number (if empty -> 0)
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
            def satisfies(n):
                digs = base7_digits(n)
                m = len(digs)-1  # highest index
                # sum over i=0..m-1
                total = 0
                for i in range(m):
                    total += delete_digit_at_position(digs, i)
                return total == n
            
            def count_upto(limit):
                cnt=0
                sols=[]
                for n in range(1, limit+1):
                    if satisfies(n):
                        cnt+=1
