            def barycentric_from_point(P, X, Y, Z):
                # compute signed areas of triangles P,Y,Z etc.
                # area of triangle (U,V,W) = 0.5 * det([V-U, W-U])
                def area(U,V,W):
                    return 0.5 * ((V[0]-U[0])*(W[1]-U[1]) - (V[1]-U[1])*(W[0]-U[0]))
                # barycentric coordinates proportional to areas opposite vertices
                # α opposite X = area(P,Y,Z)
                α = area(P, Y, Z)
                β = area(P, Z, X)
                γ = area(P, X, Y)
                return np.array([α, β, γ])
            
