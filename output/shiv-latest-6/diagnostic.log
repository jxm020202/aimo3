            def det_val(alpha,beta):
                gamma = math.pi - alpha - beta
                if gamma<=0: return None
                a = math.sin(beta)/math.sin(alpha)
                b = math.sin(gamma)/math.sin(alpha)
                x = (1 - a**2 + b**2)/2
                y_sq = b**2 - x**2
                if y_sq<=0: return None
                y = math.sqrt(y_sq)
                # foot Y'
                # compute projection parameter t
                v = (1 - x, -y)
                dot = x*(1 - x) + y*(-y)  # X·v
                vdotv = (1 - x)**2 + y**2
                t = -dot / vdotv
                Ypx = x + t*(1 - x)
                Ypy = y + t*(-y)
                # O
                y_O = x*(1 - x)/y
                # N
                Nx = 2*x/3
                Ny = (y + y_O)/3
                # M midpoint
                Mx = (x + Ypx)/2
                My = (0 + Ypy)/2
                # determinant (N-Z) x (M-Z)
                det = (Nx - 1)*(My - 0) - (Ny - 0)*(Mx - 1)
                return det
            
            # search for solutions
            sols = []
            for alpha_deg in range(20,80):
                for beta_deg in range(20,80):
                    alpha = math.radians(alpha_deg)
                    beta = math.radians(beta_deg)
                    gamma = math.pi - alpha - beta
                    if gamma<=0 or gamma>=math.pi/2: continue
                    if abs(alpha-beta)<1e-6: continue
                    d = det_val(alpha,beta)
                    if d is None: continue
                    if abs(d) < 1e-6:
                        sols.append((alpha_deg,beta_deg,math.degrees(gamma)))
            len(sols)
            
