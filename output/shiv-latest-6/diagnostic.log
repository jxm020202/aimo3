            import numpy as np, math, itertools, collections, sys, random, fractions, decimal, heapq, statistics, functools, itertools, math, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            n=len(dominos)
            c=np.ones(n)  # minimize sum
            
            # constraints list
            A=[]
            lb=[]
            ub=[]
            
            # non-overlap per cell: sum x <=1
            for cell, dlist in cell_to_dominos.items():
                row=np.zeros(n)
                for d in dlist:
                    row[d]=1
                A.append(row)
                lb.append(-np.inf)  # no lower bound
                ub.append(1)
            
            # adjacency constraints: for each domino d, for each side cell a inside board:
            for d_idx,d in enumerate(dominos):
                for side in d['sides']:
                    if side is None:
                        continue
                    # sum_{d' covering side} x_{d'} >= x_d
                    row=np.zeros(n)
                    for dprime in cell_to_dominos[side]:
                        row[dprime]=1
                    # inequality: row >= x_d -> row - x_d >=0
                    # Represent as linear constraint row - e_d >=0
                    row[d_idx] -= 1
                    A.append(row)
                    lb.append(0)
                    ub.append(np.inf)
            
            A=np.array(A)
            lb=np.array(lb)
            ub=np.array(ub)
            
            lincon=LinearConstraint(A, lb, ub)
            bounds=Bounds(0,1)  # binary later via integrality
            
            integrality=np.ones(n)
            
            res=milp(c=c, constraints=lincon, bounds=bounds, integrality=integrality, options={'presolve':True})
            res.success, res.fun
            
