            import numpy as np
            
            def angle_center(O, P):
                # return angle from positive x-axis
                return math.atan2(P[1]-O[1], P[0]-O[0])
            
            def analyze(a_val,b_val,x_val,y_val):
                r_val = ((a_val-1)**2 + b_val**2)/(2*b_val)
                O = (1.0, r_val)
                Y = (a_val,b_val)
                tP = 1/(a_val**2 + b_val**2)
                P = (a_val*tP, b_val*tP)
                L = 2*((a_val-1)*(2 - a_val) - b_val*(b_val - r_val))
                Qden = (2 - a_val)**2 + b_val**2
                sQ = -L / Qden
                Q = (a_val + sQ*(2 - a_val), b_val*(1 - sQ))
                S = (x_val,y_val)
                # compute angles
                ang = {name: angle_center(O,pt) for name,pt in [('Y',Y),('P',P),('Q',Q),('S',S),('R',(1.0,0.0))]}
                # normalize to 0..2pi
                for k in ang:
                    if ang[k] <0:
                        ang[k] += 2*math.pi
                return ang
            
