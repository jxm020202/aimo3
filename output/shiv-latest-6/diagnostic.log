                    n//=7
                return digs[::-1]
            
            def remove_digit_at(digits,i):
                idx=len(digits)-1-i
                new=digits[:idx]+digits[idx+1:]
                val=0
                for d in new:
                    val=val*7+d
                return val
            
            def satisfies2(n):
                digs=base7_digits(n)
