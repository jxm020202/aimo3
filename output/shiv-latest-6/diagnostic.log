            def nullspace_mod2(matrix):
                # matrix: shape (rows, cols) over GF(2)
                # returns list of basis vectors (as 1D numpy arrays) for nullspace (vectors x s.t. matrix @ x = 0)
                M = matrix.copy()
                rows, cols = M.shape
                # Perform row-reduced echelon form, track pivots
                pivot_cols = []
                r = 0
                for c in range(cols):
                    # find pivot row with 1 in column c at or below r
                    pivot = None
                    for i in range(r, rows):
                        if M[i, c] == 1:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap rows r and pivot
                    if pivot != r:
                        M[[r, pivot]] = M[[pivot, r]]
                    # eliminate other rows
                    for i in range(rows):
                        if i != r and M[i, c] == 1:
                            M[i] ^= M[r]
                    pivot_cols.append(c)
                    r += 1
                    if r == rows:
                        break
                # Now we have row-echelon form. Determine free columns.
                free_cols = [c for c in range(cols) if c not in pivot_cols]
                basis = []
                for free in free_cols:
                    # construct vector with 1 at free column, and appropriate entries at pivot columns to satisfy equations
                    vec = np.zeros(cols, dtype=np.uint8)
                    vec[free] = 1
                    # For each pivot row, compute value needed: row has 1 at pivot col, and maybe other free cols
                    # Since matrix is in reduced row echelon, each pivot row has 1 at pivot col and zeros elsewhere except possibly free cols.
                    # So we can solve: pivot_var = sum_{free cols with 1} * free_var (mod 2)
                    for row_idx, piv_col in enumerate(pivot_cols):
                        # row row_idx corresponds to pivot column piv_col
                        # compute dot product of row with vec (excluding pivot column)
                        # Actually we need to ensure M[row_idx] @ vec = 0
                        # Since pivot column variable is currently 0, we need to set it accordingly.
                        # The equation: sum_{j} M[row_idx, j] * vec[j] = 0
                        # Since M[row_idx, piv_col] = 1, we have vec[piv_col] = sum_{j != piv_col} M[row_idx, j] * vec[j] (mod 2)
                        s = 0
                        for j in range(cols):
                            if j != piv_col and M[row_idx, j] == 1 and vec[j] == 1:
                                s ^= 1
                        vec[piv_col] = s
                    basis.append(vec)
                return basis
            
            null_basis = nullspace_mod2(A.T)
            len(null_basis)
            
