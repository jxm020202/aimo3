            import numpy as np, math
            
            def compute_points(r1v, r2v, bv):
                a_val = (r2v - r1v)/2
                # compute intersection points numerically using geometry formulas via solving circles
                # We'll solve for intersections using sympy numeric for each pair
                # but easier: use circle intersection formula.
                # For circles C1 (center (-r1,0), radius r1) and C (center (a,b), radius R)
                # Compute intersection points.
                O1 = np.array([-r1v, 0.0])
                O2 = np.array([a_val, bv])
                R_val = np.linalg.norm(O2 - np.array([ -r1v, 0.0]))  # distance = radius of Sigma
                # distance between centers d = |O2-O1|
                d = np.linalg.norm(O2 - O1)
                # intersection chord distance from O1 along line O1O2:
                # a = (r1^2 - R^2 + d^2)/(2d)
                a_len = (r1v**2 - R_val**2 + d**2)/(2*d)
                h = math.sqrt(max(r1v**2 - a_len**2,0))
                # point P2 = O1 + a_len*(O2-O1)/d
                P_mid = O1 + a_len*(O2 - O1)/d
                # offset perpendicular
                perp = np.array([-(O2-O1)[1], (O2-O1)[0]])/d
                Q1 = P_mid + h*perp
                Q2 = P_mid - h*perp
                # similarly for circle Gamma2 centered at (r2,0)
                O1b = np.array([r2v, 0.0])
                d2c = np.linalg.norm(O2 - O1b)
                a_len2 = (r2v**2 - R_val**2 + d2c**2)/(2*d2c)
                h2 = math.sqrt(max(r2v**2 - a_len2**2,0))
                P_mid2 = O1b + a_len2*(O2 - O1b)/d2c
                perp2 = np.array([-(O2-O1b)[1], (O2-O1b)[0]])/d2c
                S1 = P_mid2 + h2*perp2
                S2 = P_mid2 - h2*perp2
                return Q1,Q2,S1,S2,R_val
            
            def test_grid():
