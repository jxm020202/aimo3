        def konig_vertex_cover(G, left_nodes):
    # compute maximum matching
    matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
    # Build alternating tree from unmatched left vertices
    # left unmatched
    left_unmatched = [u for u in left_nodes if u not in matching]
    # BFS alternating
    visited_left=set()
    visited_right=set()
    from collections import deque
    q=deque(left_unmatched)
    while q:
        u=q.popleft()
        if u.startswith('L'):
            visited_left.add(u)
            for v in G[u]:
                if v not in visited_right and (u,v) not in matching.items():
                    visited_right.add(v)
                    # follow matched edge from right to left if exists
                    if v in matching:
                        w=matching[v]
                        if w not in visited_left:
                            q.append(w)
        else:
            visited_right.add(u)
    # Vertex cover = (left not visited) union (right visited)
    left_set = set(left_nodes) - visited_left
    right_set = visited_right
    return left_set.union(right_set)

vc = konig_vertex_cover(G, left)
