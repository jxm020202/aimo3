            import numpy as np, itertools, math, random, time, sys, functools, collections, itertools, math, random
            def max_black(v):
                # v: 19x19 numpy array of 0/1
                n=19
                best=0
                # enumerate rows patterns as integer 0..2^n-1
                # we can fix r0=0 to avoid duplicate representation? Not needed for max.
                for r_int in range(1<<n):
                    r = np.array([(r_int>>i)&1 for i in range(n)], dtype=np.uint8)
                    # compute column sums for c=0 and c=1
                    # For each column j, we need sum_i v_ij XOR (r_i + c) mod2
                    # compute xor with r_i (broadcast)
                    xor_r = v ^ r[:,None]  # shape (n,n)
                    # column sum when c=0: sum of xor_r
                    col_sum0 = xor_r.sum(axis=0)
                    # when c=1: flip each entry (since adding 1 toggles)
                    col_sum1 = (xor_r ^ 1).sum(axis=0)
                    # choose max per column
                    total = col_sum0.clip(max=col_sum0)  # placeholder
                    # Actually we need sum of max per column
                    total = np.maximum(col_sum0, col_sum1).sum()
                    if total>best:
                        best=total
                return best
            
            # test on small board 2x2 to verify logic quickly
            def max_black_small(v):
                n=v.shape[0]
                best=0
                for r_int in range(1<<n):
                    r=np.array([(r_int>>i)&1 for i in range(n)],dtype=np.uint8)
                    xor_r=v ^ r[:,None]
                    col0=xor_r.sum(axis=0)
                    col1=(xor_r^1).sum(axis=0)
                    total=np.maximum(col0,col1).sum()
                    best=max(best,total)
                return best
            
            # test random 2x2
            for _ in range(5):
                v=np.random.randint(0,2,size=(2,2))
                print(v, max_black_small(v))
            
