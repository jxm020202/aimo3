            def solve_n_milp(n, total=471, time_limit=30):
                num_vars = 2*n + 1
                # objective zero
                c = np.zeros(num_vars)
                rows = []
                lbs = []
                ubs = []
                # adjacency constraints for p
                for i in range(n-1):
                    row = np.zeros(num_vars)
                    row[i] = -1
                    row[i+1] = 1
                    rows.append(row); lbs.append(-np.inf); ubs.append(1)
                    row2 = np.zeros(num_vars)
                    row2[i] = 1
                    row2[i+1] = -1
                    rows.append(row2); lbs.append(-np.inf); ubs.append(1)
                # adjacency for q
                offset = n
                for j in range(n-1):
                    row = np.zeros(num_vars)
                    row[offset + j] = -1
                    row[offset + j + 1] = 1
                    rows.append(row); lbs.append(-np.inf); ubs.append(1)
                    row2 = np.zeros(num_vars)
                    row2[offset + j] = 1
                    row2[offset + j + 1] = -1
                    rows.append(row2); lbs.append(-np.inf); ubs.append(1)
                # nonnegativity A + p_i + q_j >= 0 => -(A + p_i + q_j) <= 0
                for i in range(n):
                    for j in range(n):
                        row = np.zeros(num_vars)
                        row[i] = -1
                        row[offset + j] = -1
                        row[-1] = -1
                        rows.append(row); lbs.append(-np.inf); ubs.append(0)
                # total sum equality: n^2 A + n sum(p) + n sum(q) = total
                row = np.zeros(num_vars)
                row[-1] = n*n
                row[:n] = n
                row[offset:offset+n] = n
                rows.append(row); lbs.append(total); ubs.append(total)
                A_mat = np.vstack(rows)
                constraint = LinearConstraint(A_mat, lbs, ubs)
                # bounds
                lb = np.full(num_vars, -n)
                ub = np.full(num_vars, n)
                lb[-1] = 0  # A >=0
                bounds = Bounds(lb, ub)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=constraint, bounds=bounds, integrality=integrality,
                            options={'time_limit': time_limit, 'presolve': True, 'disp': False})
                return res
            
