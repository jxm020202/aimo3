            def fermat_point(A, B, C):
                # A,B,C are complex numbers for vertices
                # construct equilateral triangle on side BC outward of triangle ABC
                # Determine orientation: we need outward such that the constructed point is on opposite side of line BC from A.
                # Compute rotation of vector (C-B) by +60 degrees (counterclockwise)
                rot60 = sp.exp(sp.I*sp.pi/3)  # 60 deg ccw
                # candidate point D = B + (C-B)*rot60
                D1 = B + (C - B) * rot60
                # Determine side of line BC where A lies: sign of cross product (C-B) x (A-B)
                def cross(z1, z2):
                    return (z1.as_real_imag()[0]*z2.as_real_imag()[1] - z1.as_real_imag()[1]*z2.as_real_imag()[0])
                sideA = cross(C-B, A-B)
                sideD1 = cross(C-B, D1-B)
                # If sideA and sideD1 have same sign, D1 is on same side as A, need opposite orientation (rotate -60)
                if sideA*sideD1 > 0:
                    rot = sp.exp(-sp.I*sp.pi/3)
                    D = B + (C - B) * rot
                else:
                    D = D1
                # line from A to D
                # similarly construct equilateral on side AC outward, get point E, line from B to E
                # compute E similarly
                # For side AC
                sideB = cross(C-A, B-A)
                E1 = A + (C - A) * rot60
                sideE1 = cross(C-A, E1-A)
                if sideB*sideE1 > 0:
                    rot = sp.exp(-sp.I*sp.pi/3)
                    E = A + (C - A) * rot
                else:
                    E = E1
                # Intersection of lines AD and BE
                # Represent lines param: A + t*(D-A), B + s*(E-B)
                t, s = sp.symbols('t s')
                sol = sp.solve(A + t*(D-A) - (B + s*(E-B)), (t, s), dict=True)
                if not sol:
                    return None
                tval = sol[0][t]
                F = A + tval*(D-A)
                return sp.nsimplify(F)
            
