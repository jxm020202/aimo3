            # compute orthocenter of triangle ABC in plane z=0
            # Using intersection of two altitudes
            def orthocenter_triangle(P,Q,R):
                # altitude from P: line through P perpendicular to QR
                # plane is 2D, we can compute using linear algebra in 3D
                # direction vector of QR
                v = Q - R
                # altitude direction is cross of normal of plane (z) with v? In plane z=0, normal = (0,0,1)
