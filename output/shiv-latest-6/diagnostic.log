                N = num_x+num_h+num_v
                c = np.zeros(N)
                c[:num_x] = 1
                lb = np.zeros(N)
                ub = np.full(N, np.inf)
                ub[num_x:num_x+num_h] = 1
                ub[num_x+num_h:] = 1
                integrality = np.ones(N, dtype=int)
                A_eq=[]
