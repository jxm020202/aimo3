            import mpmath as mp
            
            def compute_angle_diff(r_val):
                # compute b solutions numerically
                r_val = mp.mpf(r_val)
                # coefficients numeric
                A_val = 4*mp.sqrt(3)*r_val**3 + 4*r_val**2 + 4*mp.sqrt(3)*r_val + 4
                B_val = -6*mp.sqrt(3)*r_val**4 - 12*r_val**3 - 8*mp.sqrt(3)*r_val**2 - 12*r_val - 2*mp.sqrt(3)
                C_val = 3*mp.sqrt(3)*r_val**3 + 9*r_val**2 + 3*mp.sqrt(3)*r_val + 1
                # quadratic solve
                disc = B_val**2 - 4*A_val*C_val
                if disc < 0:
                    return []
                sqrt_disc = mp.sqrt(disc)
                b1 = (-B_val + sqrt_disc)/(2*A_val)
                b2 = (-B_val - sqrt_disc)/(2*A_val)
                results=[]
                for b_val in [b1,b2]:
                    # compute a
                    a_val = -b_val*(mp.sqrt(3) - r_val)/(1 + mp.sqrt(3)*r_val)
                    # define points
                    X = mp.matrix([-1,0])
                    Z = mp.matrix([1,0])
                    P = mp.matrix([1+a_val, b_val])
                    # compute line X-P intersection second point Y
                    # Solve quadratic for t as earlier using formula
                    # We'll compute using solving linear equation for t not equal 1
                    # Use param t, solve circle equation
                    # We'll use sympy numeric maybe easier: solve for t using mpmath root of quadratic
                    # compute coefficients for t quadratic: point = X + t*(P-X)
                    d = P - X
                    # quadratic coefficients for t: (Xx + t*dx)^2 + (Xy + t*dy - r)^2 - r^2 =0
                    # expand
                    a_coef = d[0]**2 + d[1]**2
                    b_coef = 2*(X[0]*d[0] + (X[1]-r_val)*d[1])
                    c_coef = X[0]**2 + (X[1]-r_val)**2 - r_val**2
                    # solve quadratic
                    disc_t = b_coef**2 - 4*a_coef*c_coef
                    if disc_t < 0:
                        continue
                    sqrt_disc_t = mp.sqrt(disc_t)
                    t1 = (-b_coef + sqrt_disc_t)/(2*a_coef)
                    t2 = (-b_coef - sqrt_disc_t)/(2*a_coef)
                    # one of t should be 1 (P). Choose the other as Y
                    tY = t1 if abs(t1-1)>1e-6 else t2
                    Y = X + tY*d
                    # compute line Z-Y intersection with circle for Q (other than Z)
                    d2 = Y - Z
                    # quadratic for s param: Z + s*d2
                    a2 = d2[0]**2 + d2[1]**2
                    b2c = 2*(Z[0]*d2[0] + (Z[1]-r_val)*d2[1])
                    c2c = Z[0]**2 + (Z[1]-r_val)**2 - r_val**2
                    disc_s = b2c**2 - 4*a2*c2c
                    if disc_s < 0:
                        continue
                    sqrt_disc_s = mp.sqrt(disc_s)
                    s1 = (-b2c + sqrt_disc_s)/(2*a2)
                    s2 = (-b2c - sqrt_disc_s)/(2*a2)
                    sQ = s1 if abs(s1-0)>1e-6 else s2
                    Q = Z + sQ*d2
                    # compute angles
                    # angle QPS at P between vectors Q-P and S-P
                    S = Z + mp.matrix([a_val/2 - b_val*mp.sqrt(3)/2, a_val*mp.sqrt(3)/2 + b_val/2])
                    v1 = Q - P
                    v2 = S - P
                    # compute angle using atan2 of cross/dot
                    def angle_between(u,v):
                        dot = u[0]*v[0] + u[1]*v[1]
                        cross = u[0]*v[1] - u[1]*v[0]
                        return mp.atan2(abs(cross), dot)  # between 0 and pi
                    ang_QPS = angle_between(v1, v2)
                    # angle XZY at Z between ZX and ZY
                    ZX = X - Z
                    ZY = Y - Z
                    ang_XZY = angle_between(ZX, ZY)
                    diff = ang_QPS - ang_XZY
                    results.append((float(diff), float(ang_QPS), float(ang_XZY), float(r_val), float(a_val), float(b_val)))
                return results
            
