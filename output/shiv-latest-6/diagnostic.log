            def compute_O_H_Q(beta_val, b_val):
                # vertices
                X = np.array([b_val*math.cos(beta_val), b_val*math.sin(beta_val)])
                Y = np.array([0.0, 0.0])
                Z = np.array([1.0, 0.0])
                # compute circumcenter O using geometry
                # Use sympy for exact? Use numpy linear algebra: circumcenter is intersection of perpendicular bisectors.
                # We'll use sympy for reliability.
                import sympy as sp
                Xs = sp.Point(X[0], X[1])
                Ys = sp.Point(Y[0], Y[1])
                Zs = sp.Point(Z[0], Z[1])
                tri = sp.geometry.Triangle(Xs, Ys, Zs)
                O = sp.Point(tri.circumcenter)
                H = sp.Point(tri.orthocenter)
                O = np.array([float(O.x), float(O.y)])
                H = np.array([float(H.x), float(H.y)])
                Q = (O + H)/2.0
                return X, Y, Z, O, H, Q
            
            def compute_P(beta_val, b_val):
                # using barycentric coordinates for Fermat point
                X = np.array([b_val*math.cos(beta_val), b_val*math.sin(beta_val)])
                Y = np.array([0.0, 0.0])
                Z = np.array([1.0, 0.0])
                a = 1.0
                c = b_val
                b_side = np.linalg.norm(X - Z)
                # angles
                cos_alpha = (b_side**2 + c**2 - a**2) / (2 * b_side * c)
                cos_alpha = max(min(cos_alpha, 1), -1)
                alpha = math.acos(cos_alpha)
                gamma = math.pi - alpha - beta_val
                wX = 1.0 / math.sin(alpha + math.pi/3)
                wY = 1.0 / math.sin(beta_val + math.pi/3)
                wZ = 1.0 / math.sin(gamma + math.pi/3)
                P = (wX * X + wY * Y + wZ * Z) / (wX + wY + wZ)
                return P
            
            def collinearity_cross(beta_val, b_val):
                P = compute_P(beta_val, b_val)
                _, _, _, _, _, Q = compute_O_H_Q(beta_val, b_val)
                # cross product of vectors P and Q (since Y at origin)
                return P[0]*Q[1] - P[1]*Q[0]
            
