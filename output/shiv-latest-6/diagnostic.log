            from scipy.optimize import milp, LinearConstraint, Bounds
            
            n=8
            num=1<<n
            x_vars = np.arange(num)  # placeholder indices
            
            # Build constraints matrices
            rows=[]
            lb=[]
            ub=[]
            
            # y variables index mapping
            def idx_y(e,i):
                return num + e* n + i
            
            def idx_yp(e,i):
                return num + num*n + e*n + i  # after y block
            
            total_vars = num + 2*num*n  # x + y + y'
            # Objective maximize sum x -> minimize -sum x
            c = np.zeros(total_vars, dtype=int)
            c[:num] = -1
            
            # Constraints:
            
            # 1) y_{e,i} <= x_e
            for e in range(num):
                for i in range(n):
                    row = np.zeros(total_vars, dtype=int)
                    row[idx_y(e,i)] = 1
                    row[e] = -1
                    rows.append(row)
                    lb.append(-np.inf)
                    ub.append(0)
            
            # 2) y_{e,i}=0 if edge e does NOT contain i
            for e in range(num):
                mask = e
                for i in range(n):
                    if ((mask>>i)&1)==0:
                        row = np.zeros(total_vars, dtype=int)
                        row[idx_y(e,i)] = 1
                        rows.append(row)
                        lb.append(0)
                        ub.append(0)
            
            # 3) each vertex matched at most once: sum_e y_{e,i} <=1
            for i in range(n):
                row = np.zeros(total_vars, dtype=int)
                for e in range(num):
                    row[idx_y(e,i)] = 1
                rows.append(row)
                lb.append(-np.inf)
                ub.append(1)
            
            # 4) total matching size <=7
            row = np.zeros(total_vars, dtype=int)
            for e in range(num):
                for i in range(n):
                    row[idx_y(e,i)] = 1
            rows.append(row)
            lb.append(-np.inf)
            ub.append(7)
            
            # Now same for complement matching y'
            # 5) y'_{e,i} <= x_e
            for e in range(num):
                for i in range(n):
                    row = np.zeros(total_vars, dtype=int)
                    row[idx_yp(e,i)] = 1
                    row[e] = -1
                    rows.append(row)
                    lb.append(-np.inf)
                    ub.append(0)
            
            # 6) y'_{e,i}=0 if complement of e does NOT contain i i.e., if e contains i
            for e in range(num):
                mask = e
                for i in range(n):
                    if ((mask>>i)&1)==1:
                        row = np.zeros(total_vars, dtype=int)
                        row[idx_yp(e,i)] = 1
                        rows.append(row)
                        lb.append(0)
                        ub.append(0)
            
            # 7) each vertex matched at most once in zero matching
            for i in range(n):
                row = np.zeros(total_vars, dtype=int)
                for e in range(num):
                    row[idx_yp(e,i)] = 1
                rows.append(row)
                lb.append(-np.inf)
                ub.append(1)
            
            # 8) total zero matching size <=7
            row = np.zeros(total_vars, dtype=int)
            for e in range(num):
                for i in range(n):
                    row[idx_yp(e,i)] = 1
            rows.append(row)
            lb.append(-np.inf)
            ub.append(7)
            
            A = np.array(rows, dtype=int)
            lb = np.array(lb, dtype=float)
            ub = np.array(ub, dtype=float)
            
            lin = LinearConstraint(A, lb, ub)
            bounds = Bounds(0,1)
            res = milp(c=c, constraints=lin, bounds=bounds, integrality=np.ones(total_vars, dtype=int))
            print(res.success, -res.fun)
            
