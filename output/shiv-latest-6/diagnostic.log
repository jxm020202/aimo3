                # using sympy complex numbers with high precision
                # Build equilateral outward using rotation by +60 degrees (pi/3)
                rot = sp.exp(sp.I*sp.pi/3)
                D = A + (B - A)*rot
                E = B + (C - B)*rot
                # Intersection of lines C-D and A-E
                # Solve linear equations for t,s
                t,s = sp.symbols('t s')
                sol = sp.solve([sp.re(C + t*(D-C) - (A + s*(E-A))), sp.im(C + t*(D-C) - (A + s*(E-A)))],[t,s], dict=True)
