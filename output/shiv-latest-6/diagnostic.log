            import itertools, math
            
            def min_sumset_size(n,m):
                best=2*m+1
                bestA=None
                numbers=range(m+1)
                # brute for small m only
                for A in itertools.combinations(numbers, n):
                    if A[0]!=0 or A[-1]!=m:
                        continue
                    size=sumset_size(A)
                    if size<best:
                        best=size
                        bestA=A
                return best,bestA
            
            def test_small():
                for m in range(5,11):
                    for n in range(2,m+1):
                        if n>m+1: continue
                        best,_=min_sumset_size(n,m)
                        print(m,n,best, "n+m", n+m)
            test_small()
            
