            def fermat_point_minimize(A_pt,B_pt,C_pt):
                # use gradient descent or simple brute force search with sympy nsolve?
                # Use sympy nsolve for equations of equal angles? Could use minimize with scipy but not available.
                # We'll use simple iterative approach: start at centroid, then use gradient descent.
                import random, math
                # start at centroid
                x = (A_pt.real + B_pt.real + C_pt.real)/3
                y = (A_pt.imag + B_pt.imag + C_pt.imag)/3
                # simple simulated annealing
                step = max(abs(A_pt-B_pt), abs(B_pt-C_pt), abs(C_pt-A_pt))
                for i in range(10000):
                    # compute sum distances
                    def total(px,py):
                        return math.hypot(px-A_pt.real, py-A_pt.imag) + math.hypot(px-B_pt.real, py-B_pt.imag) + math.hypot(px-C_pt.real, py-C_pt.imag)
                    cur = total(x,y)
                    # try random direction
                    angle = random.random()*2*math.pi
                    nx = x + step*math.cos(angle)
                    ny = y + step*math.sin(angle)
                    new = total(nx,ny)
                    if new < cur:
                        x, y = nx, ny
                        cur = new
                    step *= 0.9995
                return complex(x,y)
            
