                # sample many points
                N=2000
                As = np.linspace(1e-6, S-1e-6, N)
                vals = [g(a) for a in As]
                roots = []
                for i in range(N-1):
                    if vals[i]==0: continue
                    if vals[i]*vals[i+1] < 0:
                        a1,a2 = As[i], As[i+1]
                        v1,v2 = vals[i], vals[i+1]
                        root = a1 - v1*(a2-a1)/(v2-v1)
                        roots.append(root)
                # filter near symmetric
                sym = S/2
                distinct = [r for r in roots if abs(r - sym) > 1e-4]
