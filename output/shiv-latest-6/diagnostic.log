            import itertools, math, sys, time, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def feasible_n(n, total=471):
                N=n*n
                # variables: f[0..N-1] integer >=0
                # also for each edge (horizontal and vertical) a binary variable indicating direction.
                # edges list
                edges=[]
                for i in range(n):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<n:
                            idx2=(i+1)*n+j
                            edges.append((idx, idx2))
                        if j+1<n:
                            idx2=i*n+(j+1)
                            edges.append((idx, idx2))
                E=len(edges)
                # total variables = N + E (binary)
                # objective dummy 0
                c = np.zeros(N+E)
                # constraints:
                # For each edge (u,v): f_u - f_v = 2*d - 1   where d binary (0 or 1)
                # This gives two linear equations: f_u - f_v - 2*d = -1
                # We'll use equality constraints.
                A_eq = []
                b_eq = []
                for e_idx, (u,v) in enumerate(edges):
                    row = np.zeros(N+E)
                    row[u]=1
                    row[v]=-1
                    row[N+e_idx] = -2  # coefficient for d
                    A_eq.append(row)
                    b_eq.append(-1)
                    # also the opposite? Actually if d=0 then diff = -1, if d=1 diff = +1. This equation captures both.
                # sum constraint
                row = np.zeros(N+E)
                row[:N]=1
                A_eq.append(row)
                b_eq.append(total)
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # bounds for f: >=0, no upper bound
                lb = np.concatenate([np.zeros(N), np.zeros(E)])  # d >=0
                ub = np.concatenate([np.full(N, np.inf), np.ones(E)])  # d <=1
                # integrality: all variables integer (binary for d, integer for f)
                integrality = np.ones(N+E, dtype=int)
                # Use milp
                try:
                    res = milp(c=c, constraints=LinearConstraint(A_eq, b_eq, b_eq), bounds=Bounds(lb, ub),
                               integrality=integrality, options={"disp": False, "presolve": True, "time_limit": 10})
                except Exception as e:
                    print("MILP error", e)
                    return False, None
                if res.success:
                    f_vals = np.rint(res.x[:N]).astype(int)
                    # verify
                    # check adjacency diff
                    for (u,v) in edges:
                        if abs(f_vals[u]-f_vals[v])!=1:
                            print("diff error")
                            return False, None
                    if f_vals.sum()!=total:
                        print("sum error")
                        return False, None
                    return True, f_vals.reshape((n,n))
                else:
                    return False, None
            
            for n in range(1,12,2):
                ok,grid=feasible_n(n)
                print(n, ok)
            
