            def check_config(y0_val, m_val):
                C = sp.Point(-2, y0_val)
                D = sp.Point(1, 2*sp.sqrt(2))  # D fixed as before
                # compute intersection points of circles with given y0,m
                x,y = sp.symbols('x y')
                eq1 = (x+2)**2 + (y - y0_val)**2 - (16 + y0_val**2)
                eq2 = x**2 + (y - m_val)**2 - (m_val**2)
                sols = sp.solve([eq1, eq2], (x,y))
