            def max_points_set(n):
                points = [(x,y) for x in range(1,n+1) for y in range(1,n+1)]
                rows = {y: [] for y in range(1,n+1)}
                cols = {x: [] for x in range(1,n+1)}
                row_sums = {y: set() for y in range(1,n+1)}
                col_sums = {x: set() for x in range(1,n+1)}
                best=0
                best_set=set()
                N=len(points)
                def backtrack(idx, selected):
                    nonlocal best,best_set
                    if idx==N:
                        if len(selected)>best:
                            best=len(selected); best_set=selected.copy()
                        return
                    if len(selected)+(N-idx) <= best:
                        return
                    x,y=points[idx]
                    # try include
                    ok=True
                    new_row_sums=set()
                    for x2 in rows[y]:
                        s=x+x2
                        for oy,ss in row_sums.items():
                            if oy!=y and s in ss:
                                ok=False; break
                        if not ok: break
                        new_row_sums.add(s)
                    if ok:
                        new_col_sums=set()
                        for y2 in cols[x]:
                            s=y+y2
                            for ox,ss in col_sums.items():
                                if ox!=x and s in ss:
                                    ok=False; break
                            if not ok: break
                            new_col_sums.add(s)
                    if ok:
                        rows[y].append(x); cols[x].append(y)
                        saved_row=row_sums[y].copy()
                        saved_col=col_sums[x].copy()
                        row_sums[y].update(new_row_sums)
                        col_sums[x].update(new_col_sums)
                        selected.add((x,y))
                        backtrack(idx+1, selected)
                        selected.remove((x,y))
                        rows[y].pop(); cols[x].pop()
                        row_sums[y]=saved_row
                        col_sums[x]=saved_col
                    backtrack(idx+1, selected)
                backtrack(0,set())
                return best,best_set
            
