            def max_black(V):
                n=len(V)
                # precompute columns of V
                # D = 1 - V
                D=[[1 - V[r][c] for c in range(n)] for r in range(n)]
                best=0
                # enumerate b vector
                for b_bits in range(1<<n):
                    b=[(b_bits>>c)&1 for c in range(n)]
                    sum_b=sum(b)%2
                    total=0
                    a=[]
                    deltas=[]
                    for r in range(n):
                        c0=0
                        c1=0
                        for c in range(n):
                            if D[r][c]==b[c]:
                                c0+=1
                            else:
                                c1+=1
                        # choose a_r to maximize
                        if c0>=c1:
                            a_r=0
                            total+=c0
                            delta= c0 - c1
                        else:
                            a_r=1
                            total+=c1
                            delta= c1 - c0
                        a.append(a_r)
                        deltas.append(delta)
                    sum_a=sum(a)%2
                    if sum_a==sum_b:
                        best=max(best,total)
                    else:
                        # need to flip parity, lose minimal delta (must be odd? any)
                        # find minimal loss to change a parity: flipping any row toggles a_r, changing total by -delta (since we lose the advantage)
                        # Actually flipping a_r from chosen to opposite reduces satisfied count by delta (since we go from max to min)
                        min_loss=min(deltas)  # could be zero if tie (delta=0) then parity can be flipped without loss
                        best=max(best,total - min_loss)
                return best
            
            def brute_n(n):
