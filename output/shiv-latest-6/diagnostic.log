            def solve_n_milp(n, total, time_limit=30):
                N = n*n
                idx = lambda i,j: i*n + j
                edges = []
                for i in range(n):
                    for j in range(n):
                        if i+1 < n:
                            edges.append((idx(i,j), idx(i+1,j)))
                        if j+1 < n:
                            edges.append((idx(i,j), idx(i,j+1)))
                M = len(edges)
                c = np.zeros(N+M)
                rows = []
                rhs = []
                # sum constraint
                row = np.zeros(N+M)
                row[:N] = 1
                rows.append(row)
                rhs.append(total)
                # edge constraints
                for e_idx, (u,v) in enumerate(edges):
                    row = np.zeros(N+M)
                    row[u] = 1
                    row[v] = -1
                    row[N+e_idx] = -2
                    rows.append(row)
                    rhs.append(-1)
                A_eq = np.array(rows)
                b_eq = np.array(rhs)
                lower = np.concatenate([np.zeros(N), np.zeros(M)])
                upper = np.concatenate([np.full(N, np.inf), np.ones(M)])
                bounds = Bounds(lower, upper)
                integrality = np.ones(N+M, dtype=int)
                lin_con = opt.LinearConstraint(A_eq, b_eq, b_eq)
                res = opt.milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality,
                               options={'disp': False, 'time_limit': time_limit})
                return res
            
