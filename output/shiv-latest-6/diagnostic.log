                    pts=[]
                    for i in range(N):
                        # uniform in unit disk: radius sqrt(r) uniform in [0,1], angle uniform
                        r=math.sqrt(random.random())
                        theta=2*math.pi*random.random()
                        pts.append((r*math.cos(theta), r*math.sin(theta)))
                    # compute convex hull and check if origin inside
