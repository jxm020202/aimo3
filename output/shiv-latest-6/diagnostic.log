            def nullspace_mod2(matrix):
                # matrix shape (m, n)
                m, n = matrix.shape
                A = matrix.copy()
                # Perform Gaussian elimination to row echelon form, track pivot columns
                row = 0
                pivots = []
                for col in range(n):
                    # find pivot row with 1
                    pivot = None
                    for r in range(row, m):
                        if A[r, col] == 1:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    if pivot != row:
                        A[[pivot, row]] = A[[row, pivot]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r, col] == 1:
                            A[r] ^= A[row]
                    pivots.append(col)
                    row += 1
                    if row == m:
                        break
                # free columns are those not pivots
                free = [c for c in range(n) if c not in pivots]
                basis = []
                for f in free:
                    vec = np.zeros(n, dtype=np.uint8)
                    vec[f] = 1
                    # set pivot variables to satisfy equations
                    # For each pivot row i, pivot column pivots[i]
                    for i, pc in enumerate(pivots):
                        # equation: sum over free cols with A[i,free]*x_free = 0 (since homogeneous)
                        # Since we set only free variable f=1, others 0, then x_pc = A[i,f] (because A[i,pc]=1)
                        if A[i, f] == 1:
                            vec[pc] = 1
                    basis.append(vec)
                return np.array(basis, dtype=np.uint8)
            
            # compute H basis
            M = np.array(vectors, dtype=np.uint8)
            # compute nullspace of M (i.e., vectors orthogonal to rows of M). Need nullspace of M (as rows are operation vectors)
            H_basis = nullspace_mod2(M)
