            import numpy as np, math
            
            def fermat_point_numeric(X, Y, Z):
                # X,Y,Z are np arrays shape (2,)
                # Build outward equilateral on XY: we need outward direction (outside triangle)
                # Determine orientation using sign of cross product (Z - Y) x (X - Y)
                def rotate(vec, angle):
                    ca, sa = math.cos(angle), math.sin(angle)
                    return np.array([ca*vec[0] - sa*vec[1], sa*vec[0] + ca*vec[1]])
                XY = X - Y
                # two possible points
                Xp1 = Y + rotate(XY, math.pi/3)
                Xp2 = Y + rotate(XY, -math.pi/3)
                YZ = Z - Y
                Yp1 = Y + rotate(YZ, math.pi/3)
                Yp2 = Y + rotate(YZ, -math.pi/3)
                # Choose outward: we need the equilateral triangle that lies outside original triangle.
                # For side XY, outward is opposite side of Z relative to line XY.
                # Compute signed area (cross product) of XY and ZY vector.
                cross = np.cross(XY, Z - Y)  # scalar in 2D
                # If cross >0, Z is to left of XY (assuming XY direction from Y to X). Outward would be to right => use rotation -60.
                if cross > 0:
                    Xp = Xp2
                else:
                    Xp = Xp1
                # Similarly for side YZ: outward opposite X.
                cross2 = np.cross(YZ, X - Y)
                if cross2 > 0:
                    Yp = Yp2
                else:
                    Yp = Yp1
                # Intersection of lines Z-Xp and X-Yp
                # Solve for parameters t,u: Z + t*(Xp-Z) = X + u*(Yp-X)
                A = np.column_stack((Xp - Z, -(Yp - X)))  # 2x2
                bvec = X - Z
                try:
                    t,u = np.linalg.solve(A, bvec)
                except np.linalg.LinAlgError:
                    return None
                P = Z + t*(Xp - Z)
                return P
            
            def nine_point_center_numeric(X,Y,Z):
                # circumcenter O
                # using formula
                D = 2*(X[0]*(Y[1]-Z[1]) + Y[0]*(Z[1]-X[1]) + Z[0]*(X[1]-Y[1]))
                if abs(D) < 1e-9:
                    return None
                Ux = ((np.dot(X,X))*(Y[1]-Z[1]) + (np.dot(Y,Y))*(Z[1]-X[1]) + (np.dot(Z,Z))*(X[1]-Y[1]))/D
                Uy = ((np.dot(X,X))*(Z[0]-Y[0]) + (np.dot(Y,Y))*(X[0]-Z[0]) + (np.dot(Z,Z))*(Y[0]-X[0]))/D
                O = np.array([Ux, Uy])
                # orthocenter H = X+Y+Z - 2O (Euler line relation)
                H = X + Y + Z - 2*O
                N = (O + H)/2
                return N
            
            def collinearity_val(theta, b=1.0, c=1.3):
                Y = np.array([0.0,0.0])
                X = np.array([c,0.0])
                Z = np.array([b*math.cos(theta), b*math.sin(theta)])
                P = fermat_point_numeric(X,Y,Z)
                N = nine_point_center_numeric(X,Y,Z)
                if P is None or N is None:
                    return None
                return P[0]*N[1] - P[1]*N[0]
            
            # test scanning
