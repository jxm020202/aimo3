            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np
            
            def exists_vector_with_min_dist(n, r):
                total=n*n
                # generate codewords
                ops=[]
                for i in range(n):
                    for j in range(n):
                        mask=0
                        for c in range(n):
                            mask ^= 1 << (i*n + c)
                        for r2 in range(n):
                            mask ^= 1 << (r2*n + j)
                        ops.append(mask)
                # basis
                basis=[]
                for mask in ops:
                    m=mask
                    for b in basis:
                        if (m ^ b) < m:
                            m ^= b
                    if m:
                        basis.append(m)
                code=[0]
                for b in basis:
                    code += [c ^ b for c in code]
                # variables y_i binary
                num_vars = total
                c = np.zeros(num_vars)  # dummy objective
                # constraints: for each codeword c, sum_i (y_i xor c_i) >= r
                A = []
                b = []
                for cw in code:
                    row = np.zeros(num_vars, dtype=int)
                    # compute xor expression: y_i xor c_i = y_i + c_i - 2*y_i*c_i but linearization needed.
                    # Instead we can write sum_i (y_i xor c_i) = sum_i (y_i + c_i - 2*y_i*c_i) = sum_i y_i + const - 2*sum_i (y_i * c_i)
                    # This is not linear due to product term.
                    # Alternative: we can introduce auxiliary variables for each i where c_i=1 to represent y_i (since xor with 1 is 1 - y_i). So:
                    # If c_i=0, term = y_i
                    # If c_i=1, term = 1 - y_i
                    # So sum = sum_{i: c_i=0} y_i + sum_{i: c_i=1} (1 - y_i) = const + sum_{i: c_i=0} y_i - sum_{i: c_i=1} y_i
                    const = 0
                    for i in range(total):
                        if (cw >> i) & 1:
                            const += 1
                            row[i] = -1
                        else:
                            row[i] = 1
                    # inequality: const + sum(row_i * y_i) >= r
                    A.append(row)
                    b.append(r - const)
                A = np.array(A, dtype=float)
                b = np.array(b, dtype=float)
                # constraints: A y >= b
                lin_con = LinearConstraint(A, b, np.full_like(b, np.inf))
                bounds = Bounds(np.zeros(num_vars), np.ones(num_vars))
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={"presolve": True})
                return res.success
            
            def covering_radius_via_milp(n):
                total=n*n
                lo=0
                hi=total
                while lo<hi:
                    mid=(lo+hi+1)//2
                    if exists_vector_with_min_dist(n, mid):
                        lo=mid
                    else:
                        hi=mid-1
                return lo
            
            print(covering_radius_via_milp(3))
            
