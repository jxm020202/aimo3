                                            row = np.zeros(nvar, dtype=int)
                                            row[idx(a,y1)] = 1
                                            row[idx(bcol,y1)] = 1
                                            row[idx(ccol,y2)] = 1
                                            row[idx(dcol,y2)] = 1
                                            A.append(row)
