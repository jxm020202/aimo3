            import numpy.linalg as la, math, numpy as np
            
            def orthocenter_from_vertices(verts):
                # verts list of 4 np arrays
                a,b,c,d = verts
                # compute normals of opposite faces
                n_a = np.cross(b-c, b-d)  # plane through b,c,d
                n_b = np.cross(a-c, a-d)
                # line from a: a + s * n_a
                # line from b: b + t * n_b
                # solve a + s n_a = b + t n_b
                # 3 equations, 2 unknowns -> solve least squares
                A = np.column_stack((n_a, -n_b))  # 3x2
                rhs = b - a
                # solve least squares for s,t
                sol, residuals, rank, svals = np.linalg.lstsq(A, rhs, rcond=None)
                s, t = sol
                K = a + s * n_a
                return K
            
