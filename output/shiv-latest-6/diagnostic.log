            def max_weight_pattern_milp(n, d_tuple, e_tuple):
                N=n*n
                # variables x_k for each cell
                c = -np.ones(N)  # minimize negative sum to maximize sum
                # constraints: parity equations
                # We'll create matrix A (eqs x N) and RHS b
                eqs = []
                rhs = []
                # row parity differences
                for i in range(1,n):
                    coeff = np.zeros(N, dtype=int)
                    for j in range(n):
                        coeff[i*n + j] ^= 1
                    for j in range(n):
                        coeff[0*n + j] ^= 1
                    eqs.append(coeff)
                    rhs.append(d_tuple[i-1])
                # column parity differences
                for j in range(1,n):
                    coeff = np.zeros(N, dtype=int)
                    for i in range(n):
                        coeff[i*n + j] ^= 1
                    for i in range(n):
                        coeff[i*n + 0] ^= 1
                    eqs.append(coeff)
                    rhs.append(e_tuple[j-1])
                A = np.vstack(eqs)
                # Each equation: sum coeff * x = rhs (mod 2). We'll enforce using integer variable z to represent parity:
                # sum coeff * x - 2*z = rhs
                # We'll add variables z_i (continuous integer) but integrality constraints can be added.
                m = A.shape[0]
                # Add z variables: total variables = N + m
                c_full = np.concatenate([c, np.zeros(m)])
                # Build constraints matrix for equality: A x - 2*z = rhs
                # Represent as A_full @ [x; z] = rhs
                A_full = np.hstack([A, -2*np.eye(m, dtype=int)])
                # Equality constraints
                lincon = LinearConstraint(A_full, rhs, rhs)
                # variable bounds: x binary 0-1, z integer (no bounds)
                bounds = Bounds(np.concatenate([np.zeros(N), np.full(m, -np.inf)]),
                                np.concatenate([np.ones(N), np.full(m, np.inf)]))
                integrality = np.concatenate([np.ones(N), np.zeros(m)])  # only x binary
                res = milp(c=c_full, constraints=lincon, bounds=bounds, integrality=integrality, options={"presolve": True})
                if not res.success:
                    raise RuntimeError("MILP failed")
                max_sum = -res.fun  # because we minimized negative sum
                # Since objective is integer, round
                return int(round(max_sum))
            
            def minmax_n7():
                n=7
                min_of_max = n*n
                # iterate over all patterns (2^(2*(n-1)) = 2^12 = 4096)
                for d_int in range(1<<(n-1)):
                    d = tuple((d_int>>i)&1 for i in range(n-1))
                    for e_int in range(1<<(n-1)):
                        e = tuple((e_int>>j)&1 for j in range(n-1))
                        maxw = max_weight_pattern_milp(n, d, e)
                        if maxw < min_of_max:
                            min_of_max = maxw
                return min_of_max
            
            print("computing n=7")
            print(minmax_n7())
            
