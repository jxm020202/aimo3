            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np, math, itertools, sys, random, time, collections, functools, fractions, decimal, heapq, statistics, typing, os, json, pathlib, warnings, itertools, math, sys
            warnings.filterwarnings('ignore')
            
            def min_moves_milp(n):
                # variables: y[0..n-2] for edges 1..n-1, start_i binary for each vertex (n), k_i integer for each vertex (n)
                num_y = n-1
                num_start = n
                num_k = n
                total_vars = num_y + num_start + num_k
                # objective: minimize sum y_i
                c = np.zeros(total_vars)
                c[:num_y] = 1  # minimize sum y
                # bounds
                lb = np.zeros(total_vars)
                ub = np.full(total_vars, np.inf)
                # start_i binary 0/1
                for i in range(num_y, num_y+num_start):
                    ub[i]=1
                # integrality: all variables integer
                integrality = np.ones(total_vars)
                # constraints
                A = []
                b = []
                # parity constraints: v_i - p_i = 2 k_i
                p = np.array([1 if (i%2)==1 else 0 for i in range(1,n+1)], dtype=int)
                for i in range(1,n+1):
                    # compute v_i expression coefficients
                    coeff = np.zeros(total_vars)
                    # start_i
                    coeff[num_y + (i-1)] = 1
                    # y_{i-1}
                    if i-1 >=1:
                        coeff[i-2] = 1  # y_{i-1} index i-2
                    # y_i
                    if i <= n-1:
                        coeff[i-1] = 1  # y_i index i-1
                    # -2 k_i
                    coeff[num_y+num_start + (i-1)] = -2
                    # RHS = p_i
                    A.append(coeff)
                    b.append(p[i-1])
                # also need exactly one start vertex? Actually start can be any vertex, but we must have exactly one start flip (first move). So sum start_i =1.
                coeff = np.zeros(total_vars)
                coeff[num_y:num_y+num_start]=1
                A.append(coeff)
                b.append(1)
                # Build LinearConstraint
                A = np.array(A)
                lc = LinearConstraint(A, b, b)
                bounds = Bounds(lb, ub)
                res = milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={"presolve": True})
                if not res.success:
                    return None
                y = res.x[:num_y]
                total_moves = int(round(1 + sum(y)))
                return total_moves
            
            for n in range(3,19,2):
                print(n, min_moves_milp(n))
            
