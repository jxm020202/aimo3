            import mpmath as mp
            
            def f_eq(vars):
                r1_val, R_val = vars[0], vars[1]
                r2_val = 15 - r1_val
                # compute angles
                if R_val < 8: 
                    return 1e6
                alpha = 2*mp.asin(1/R_val)
                beta = 2*mp.asin(8/R_val)
                # ensure domain for arcsin
                # gamma from r1
                # check r1 <= 2R
                if r1_val > 2*R_val or r2_val > 2*R_val:
                    return 1e6
                gamma = 2*mp.acos(1 - r1_val**2/(2*R_val**2))
                delta = 2*mp.acos(1 - r2_val**2/(2*R_val**2))
                return 2*mp.pi - (alpha + beta + gamma) - delta
            
