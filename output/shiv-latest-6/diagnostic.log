                    total = 0
                    sols = []
                    # iterate using product
                    from itertools import product
                    for digits in product(range(7), repeat=m+1):
                        if digits[0]==0: # leading zero not allowed
                            continue
                        # compute condition
                        # digits list most to least: d_m,...,d_0
                        # compute n
                        n=0
                        for d in digits:
