                # returns list of basis vectors (numpy arrays) for nullspace over GF(2)
                A = matrix.copy()
                rows, cols = A.shape
                # Perform row reduction to RREF, keep track of pivot columns
                pivot_cols = []
                r = 0
                for c in range(cols):
                    # find pivot
                    pivot = None
                    for i in range(r, rows):
                        if A[i,c] == 1:
