from scipy.optimize import milp, LinearConstraint, Bounds

def feasible_weight_leq(syndrome, maxw):
    total = n + m
    c = np.zeros(total, dtype=int)
    lb = np.zeros(total)
    ub = np.concatenate([np.ones(n), np.full(m, np.inf)])
    integrality = np.ones(total, dtype=int)
    A_eq = np.hstack([H.astype(float), -2*np.eye(m)])
    lin_eq = LinearConstraint(A_eq, syndrome, syndrome)
    A_weight = np.concatenate([np.ones(n), np.zeros(m)]).reshape(1,total)
    lin_weight = LinearConstraint(A_weight, [0], [maxw])
    res = milp(c=c, constraints=[lin_eq, lin_weight], bounds=Bounds(lb, ub), integrality=integrality, options={'presolve': True, 'disp': False})
    return res.success

def test_random_trials(maxw, trials=20):
    for _ in range(trials):
        syndrome = np.random.randint(0,2,size=m, dtype=int)
        if not feasible_weight_leq(syndrome, maxw):
            return False
    return True

