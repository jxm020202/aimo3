            px, py = sp.symbols('px py', real=True)
            P = sp.Point(px, py)
            
            def dot(u,v):
                return u[0]*v[0] + u[1]*v[1]
            
            def vec(P1,P2):
                return (P2.x-P1.x, P2.y-P1.y)
            
            # vectors from P to vertices
            PX = vec(P, X)  # X - P
            PY = vec(P, Y)  # Y - P
