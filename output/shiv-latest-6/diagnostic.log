            def orthocenter_triangle(A,B,C):
                # compute using formula: intersection of altitudes
                # using barycentric: H = A + B + C - 2*O where O circumcenter
                # compute circumcenter O
                def circumcenter_tri(A,B,C):
                    # using perpendicular bisectors
                    D = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                    Ux = ((np.dot(A,A))*(B[1]-C[1]) + (np.dot(B,B))*(C[1]-A[1]) + (np.dot(C,C))*(A[1]-B[1]))/D
                    Uy = ((np.dot(A,A))*(C[0]-B[0]) + (np.dot(B,B))*(A[0]-C[0]) + (np.dot(C,C))*(B[0]-A[0]))/D
                    return np.array([Ux, Uy])
                O = circumcenter_tri(A,B,C)
                H = A + B + C - 2*O
                return H
            
            def orthocenter_tetra(pts):
                # compute concurrency using solving for K from first two altitudes, then check others
