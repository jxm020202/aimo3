            def solve_linear(matrix, rhs):
                # matrix: list of rows (each row length m). Solve matrix^T * x = rhs (mod2)
                # Equivalent to solve A x = rhs where A is matrix^T (size n x m)
                A = [list(col) for col in zip(*matrix)]  # n rows, m cols
                n = len(A)
                m = len(A[0])
                # augment with rhs
                aug = [A[i] + [rhs[i]] for i in range(n)]
                # Gaussian elimination
                r = 0
                pivots = []
                for c in range(m):
                    # find pivot row >= r with 1 in column c
                    piv = None
                    for i in range(r, n):
                        if aug[i][c]:
                            piv = i
                            break
                    if piv is None:
                        continue
                    aug[r], aug[piv] = aug[piv], aug[r]
                    # eliminate other rows
                    for i in range(n):
                        if i != r and aug[i][c]:
                            aug[i] = [a ^ b for a,b in zip(aug[i], aug[r])]
                    pivots.append(c)
                    r += 1
                    if r == n:
                        break
                # Check consistency: rows with all zeros in coeff but RHS 1 -> no solution
                for i in range(r, n):
                    if aug[i][-1]:
                        return None  # no solution
                # Find a solution (set free vars to 0)
                x = [0]*m
                for i_rev in range(r-1, -1, -1):
                    c = pivots[i_rev]
                    # compute sum of known vars
                    s = aug[i_rev][-1]
                    for j in range(c+1, m):
                        if aug[i_rev][j] and x[j]:
                            s ^= 1
                    x[c] = s
                return x
            
            solution = solve_linear(ops, [1]*n)
            solution is None
            
