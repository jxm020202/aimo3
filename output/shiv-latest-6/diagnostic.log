            from collections import deque
            
            def covering_radius_by_bfs(size):
                vectors = generate_vectors(size)
                n = size*size
                null_basis = nullspace_mod2(vectors)
                r = null_basis.shape[0]
                # column vectors as ints
                col_ints = []
                for col in null_basis.T:
                    bits = 0
                    for i,bit in enumerate(col):
                        if bit:
                            bits |= (1<<i)
                    col_ints.append(bits)
                # BFS
                max_syndrome = 1<<r
                dist = np.full(max_syndrome, -1, dtype=np.int16)  # distances up to maybe 20
                q = deque()
                dist[0] = 0
                q.append(0)
                while q:
                    s = q.popleft()
                    d = dist[s]
                    for col in col_ints:
                        ns = s ^ col
                        if dist[ns] == -1:
                            dist[ns] = d + 1
                            q.append(ns)
                # after BFS, all syndromes should be reachable
                if np.any(dist == -1):
                    print("some unreachable")
                covering_radius = int(dist.max())
                return covering_radius, dist
            
