            def orthocenter(vertices):
                # vertices list of 4 np arrays
                a1,a2,a3,a4 = vertices
                # normals to opposite faces
                n1 = np.cross(a2-a3, a2-a4)  # plane through a2,a3,a4
                n2 = np.cross(a1-a3, a1-a4)
                n3 = np.cross(a1-a2, a1-a4)
                n4 = np.cross(a1-a2, a1-a3)
                # equations (K - ai)·ni = 0 => K·ni = ai·ni
                A = np.vstack([n1, n2, n3])
                b = np.array([np.dot(a1, n1), np.dot(a2, n2), np.dot(a3, n3)])
                # solve linear system
                K = np.linalg.solve(A, b)
                return K
            
