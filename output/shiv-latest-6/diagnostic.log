            def gf2_nullspace(matrix_rows, n_cols):
                # matrix_rows: list of ints representing rows (length n_cols bits)
                # returns list of ints representing basis vectors for nullspace (dimension n_cols - rank)
                rows = matrix_rows.copy()
                m = len(rows)
                n = n_cols
                # Perform Gaussian elimination, tracking pivot columns
                pivot_cols = []
                row = 0
                for col in reversed(range(n)):  # from high to low
                    # find pivot row with bit col set at or below current row
                    pivot = None
                    for r in range(row, m):
                        if (rows[r] >> col) & 1:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap to current row
                    rows[row], rows[pivot] = rows[pivot], rows[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r != row and ((rows[r] >> col) & 1):
                            rows[r] ^= rows[row]
                    row += 1
                    if row == m:
                        break
                rank = len(pivot_cols)
                # Determine free columns (non-pivot)
                pivot_set = set(pivot_cols)
                free_cols = [c for c in range(n) if c not in pivot_set]
                # For each free column, construct a nullspace basis vector where that free var = 1, others 0
                basis = []
                # We need to express pivot variables in terms of free variables.
                # For each pivot row i (corresponding to pivot column pivot_cols[i]), the row equation is:
                # pivot_col + sum_{free col j where row has 1 at j} * x_j = 0 => x_pivot = sum_{free cols with 1} x_j
                # Since rows are in reduced echelon (each pivot column appears only in its row), we can compute.
                # Let's build a list of rows after elimination (the rows list) which now have pivot bits and possibly free bits.
                # Ensure rows are in order of pivot_cols (they are)
                for free in free_cols:
                    vec = 0
                    # set free variable
                    vec |= 1 << free
                    # compute pivot variables
                    for i, piv in enumerate(pivot_cols):
                        # check if row i has bit at free column
                        if (rows[i] >> free) & 1:
                            # then pivot variable = 1 (since sum includes this free var)
                            vec |= 1 << piv
                    basis.append(vec)
                return basis
            
            null_basis = gf2_nullspace(ops, N)
            len(null_basis)
            
