            def monge_point(a1,a2,a3,a4):
                verts = [a1,a2,a3,a4]
                rows = []
                rhs = []
                for i in range(4):
                    for (j,k) in [( (i+1)%4, (i+2)%4), ((i+1)%4, (i+3)%4)]: # need two distinct others not i
                        # ensure j,k distinct and not i
                        if j==i or k==i or j==k:
                            continue
                        v = verts[j] - verts[k]
                        rows.append(v)
                        rhs.append(np.dot(verts[i], v))
                A = np.vstack(rows)  # shape (8,3)
                b = np.array(rhs)
                # solve least squares
                M, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)
                return M
            
            def ratio_monge():
                a1,a2,a3,a4 = random_tetra()
                M = monge_point(a1,a2,a3,a4)
                # line through a1 and M
                v = M - a1
                # foot X: intersection with plane a2,a3,a4
                n = np.cross(a3 - a2, a4 - a2)
                s = (np.dot(n, a2) - np.dot(n, a1)) / np.dot(n, v)
                X = a1 + s*v
                # Y: second intersection with sphere radius R (origin circumcenter)
                R = np.linalg.norm(a1)
                # solve |a1 + t v|^2 = R^2
                a = np.dot(v, v)
                b = 2*np.dot(a1, v)
                # equation: a t^2 + b t =0 (since |a1|^2=R^2)
                # solutions t=0 and t = -b/a
                t = -b / a
                Y = a1 + t*v
                KX = np.linalg.norm(M - X)
                KY = np.linalg.norm(M - Y)
                return KX/KY
            
            ratios = [ratio_monge() for _ in range(10)]
            ratios
            
