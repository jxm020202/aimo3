            def possible_walk_sums(n):
                # walk length n (indices 0..n-1) with steps +/-1, start at 0
                sums=set()
                def dfs(i, pos, total):
                    if i==n:
                        sums.add(total)
                        return
                    # position at index i is pos
                    dfs(i+1, pos+1, total+pos+1)  # next step +1, new pos
                    dfs(i+1, pos-1, total+pos-1)
                # start at index0 pos=0, total includes pos0=0
