            def covering_radius_bruteforce(n):
                size = n
                N = size*size
                # compute rank of operation vectors
                # but we just need minimal weight for each parity pattern
                # We'll compute max over patterns of max(a,b)
                max_min_weight = 0
                # iterate over all row parity vectors (2^n) and column parity vectors (2^n) with consistency
                for row_mask in range(1<<size):
                    a = bin(row_mask).count('1')
                    for col_mask in range(1<<size):
                        b = bin(col_mask).count('1')
                        if (a%2) != (b%2):
                            continue
                        # minimal weight = max(a,b)
                        min_w = max(a,b)
                        if min_w > max_min_weight:
                            max_min_weight = min_w
                return max_min_weight
            
