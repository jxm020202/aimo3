            def fermat_point(p1,p2,p3):
                # points as complex numbers
                # Determine orientation (counterclockwise)
                def orient(a,b,c):
                    return (b.real-a.real)*(c.imag-a.imag) - (b.imag-a.imag)*(c.real-a.real)
                # Choose rotation +60 degrees (pi/3) for each side such that lines intersect inside.
                # We'll try both signs for each side and pick intersection inside.
                rot = cmath.exp(1j*math.pi/3)  # +60°
                rot_minus = cmath.exp(-1j*math.pi/3)  # -60°
                candidates=[]
                for s1 in [rot, rot_minus]:
                    for s2 in [rot, rot_minus]:
                        # line from p1 direction = (p2-p1) rotated by s1
                        dir1 = (p2-p1)*s1
                        # line from p2 direction = (p3-p2) rotated by s2
                        dir2 = (p3-p2)*s2
                        # solve intersection: p1 + t1*dir1 = p2 + t2*dir2
                        # => t1*dir1 - t2*dir2 = p2 - p1
                        # treat as 2D linear system
                        A = np.array([[dir1.real, -dir2.real],[dir1.imag, -dir2.imag]])
                        b = np.array([ (p2-p1).real, (p2-p1).imag])
                        try:
                            t1,t2 = np.linalg.solve(A,b)
                            F = p1 + t1*dir1
                            # check if inside triangle using barycentric coordinates
                            # compute barycentric via area signs
                            def area(a,b,c):
