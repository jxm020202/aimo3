            import math, fractions
            def rational_roots(poly):
                coeffs = sp.Poly(poly, r).all_coeffs()
                # leading coeff
                a0 = coeffs[0]
                an = coeffs[-1]
                p_factors = sp.divisors(abs(an))
                q_factors = sp.divisors(abs(a0))
                roots = []
                for p in p_factors:
                    for q in q_factors:
                        for sign in [1, -1]:
                            val = sp.Rational(sign*p, q)
                            if sp.simplify(poly.subs(r, val)) == 0:
