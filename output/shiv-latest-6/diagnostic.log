            def min_moves_via_algorithm(n):
                p = [1 if i%2==0 else 0 for i in range(n)]  # i index 0-based: odd position (1-indexed) corresponds to i even
                best = None
                for s in range(n):
                    for e in range(n):
                        # compute minimal extra flips
                        t_prev = 0
                        extra = 0
                        feasible = True
                        # we will store needed RHS values to compute later maybe adjust final.
                        RHS = []
                        for i in range(n):
                            base = 2*p[i] - (1 if i==s else 0) - (1 if i==e else 0)
                            # need RHS_i >= t_prev and RHS_i ≡ base (mod 4)
                            # find smallest R >= t_prev with same mod 4 as base
                            # compute remainder difference
                            # we can compute k = ((t_prev - base) % 4)
                            # if base already >= t_prev and same mod? Actually we need R >= t_prev.
                            # Let r = base mod 4
                            r = base % 4
                            # smallest R >= t_prev with mod r:
                            R = t_prev + ((r - (t_prev % 4)) % 4)
                            if R < t_prev:
                                R += 4
                            # also ensure R >= base (since we can only increase)
                            if R < base:
                                # need to increase to at least base, also keep mod r (already)
                                R = base
                                # but may need to adjust to meet >= t_prev
                                if R < t_prev:
                                    # increase by multiples of 4
                                    diff = t_prev - R
                                    add = ((diff + 3)//4)*4
                                    R += add
                            # extra added amount:
                            extra += (R - base)
                            t_i = R - t_prev
                            t_prev = t_i
                            RHS.append(R)
                        # after loop, need t_prev == 0 (t_n)
                        if t_prev != 0:
                            feasible = False
                        total_flips = sum(p) + extra//2  # each extra of 4 corresponds to 2 flips
                        if feasible:
                            if best is None or total_flips < best:
                                best = total_flips
                return best
            
