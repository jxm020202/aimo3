            def gf2_nullspace(mat):
                # mat is list of rows, each list of bits length n
                m=len(mat)
                n=len(mat[0])
                A=[row[:] for row in mat]
                # augment with identity to track nullspace? We'll compute basis of solutions.
                # Perform Gaussian elimination to row-echelon form.
                pivot_cols=[]
                row=0
                for col in range(n):
                    # find pivot
                    pivot=None
                    for r in range(row, m):
                        if A[r][col]==1:
                            pivot=r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r!=row and A[r][col]==1:
                            # row r = row r + row row
                            A[r] = [(a^b) for a,b in zip(A[r], A[row])]
                    row+=1
                    if row==m:
                        break
                # Now pivot_cols are leading ones. Free variables are columns not in pivot_cols.
                free_cols=[c for c in range(n) if c not in pivot_cols]
                basis=[]
                for free in free_cols:
                    # set free variable to 1, others 0, solve for pivot vars
