            from scipy.optimize import milp, LinearConstraint, Bounds
            def feasible_n(n):
                # number of cells
                N = n*n
                # map cell index
                idx = lambda i,j: i*n + j
                # variables: N x's + M b's where M = number of edges
                edges = []
                for i in range(n):
                    for j in range(n):
                        if i+1 < n:
                            edges.append(((i,j),(i+1,j)))
                        if j+1 < n:
                            edges.append(((i,j),(i,j+1)))
                M = len(edges)
                total_vars = N + M
                # Build A_eq matrix for constraints
                rows = []
                rhs = []
                # edge constraints
                for e_idx, ((i1,j1),(i2,j2)) in enumerate(edges):
                    row = np.zeros(total_vars, dtype=int)
                    row[idx(i1,j1)] = 1
                    row[idx(i2,j2)] = -1
                    row[N + e_idx] = -2  # subtract 2*b
                    rows.append(row)
                    rhs.append(-1)  # because x_u - x_v - (2b -1) =0 => x_u - x_v -2b = -1
                # sum constraint
                row = np.zeros(total_vars, dtype=int)
                for i in range(N):
                    row[i] = 1
                rows.append(row)
                rhs.append(471)
                A_eq = np.vstack(rows)
                # variable bounds: x >=0 integer, b in {0,1}
                lb = np.zeros(total_vars, dtype=int)
                ub = np.full(total_vars, np.iinfo(np.int64).max, dtype=int)
                # set ub for b variables to 1
                ub[N:] = 1
                # integrality: all variables integer
                integrality = np.ones(total_vars, dtype=int)
                # Use milp
                try:
                    res = milp(c=np.zeros(total_vars), constraints=LinearConstraint(A_eq, rhs, rhs),
                               bounds=Bounds(lb, ub), integrality=integrality, options={'presolve': True, 'disp': False})
                except Exception as e:
                    print("Error", e)
                    return False
                return res.success
            
