            def base7_digits(n):
                # returns list of digits [b_m,...,b_0] most significant first
                if n == 0:
                    return [0]
                digs = []
                while n > 0:
                    digs.append(n % 7)
                    n //= 7
                return digs[::-1]
            
            def delete_digit(digs, i):
                # digs list most significant first, index i from 0..len(digs)-1
                new = digs[:i] + digs[i+1:]
                # interpret new as base-7 number
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
            def satisfies(n, include_all=True):
                digs = base7_digits(n)
                m = len(digs) - 1  # highest index
                # generate a_i for each digit position
                total = 0
                for i in range(len(digs)):
                    total += delete_digit(digs, i)
                if include_all:
                    return total == n
                else:
                    # sum over i=0..m-1 (exclude last digit? maybe exclude most significant digit)
                    # Let's exclude the most significant digit (i=0) maybe? Or exclude i=m?
                    # If we sum i=0..m-1, that excludes the least significant digit (i=m) if indexing from most significant.
                    # Let's interpret as exclude least significant digit (b_0). So sum over all except i = len(digs)-1.
                    total2 = sum(delete_digit(digs, i) for i in range(len(digs)-1))
                    return total2 == n
            
            def find_solutions(limit, include_all=True):
                sols = []
                for n in range(1, limit+1):
                    if satisfies(n, include_all):
