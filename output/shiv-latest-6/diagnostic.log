            def gf2_nullspace_left(matrix):
                # matrix is list of rows (ops), each row list length n
                # want basis for vectors y (length m) such that y * matrix = 0 (mod2)
                # Equivalent to nullspace of transpose.
                import copy
                A = [row[:] for row in matrix]  # m x n
                m = len(A)  # rows
                n = len(A[0])  # cols
                # compute row-reduced echelon form of transpose? Let's compute nullspace of transpose using Gaussian elimination on transpose.
                # We'll work on transpose matrix B of size n x m.
                B = [[A[i][j] for i in range(m)] for j in range(n)]  # n rows, m cols
                # Perform Gaussian elimination on B to find rank and basis for nullspace of B (i.e., left nullspace of A)
                rows = B
                r = 0
                pivots = []
                for c in range(m):
                    # find row >= r with rows[row][c]==1
                    pivot = None
                    for i in range(r, n):
                        if rows[i][c]:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap
                    rows[r], rows[pivot] = rows[pivot], rows[r]
                    pivots.append(c)
                    # eliminate other rows
                    for i in range(n):
                        if i != r and rows[i][c]:
                            # row_i = row_i xor row_r
                            rows[i] = [(a^b) for a,b in zip(rows[i], rows[r])]
                    r += 1
                    if r==n:
                        break
                rank = r
                # free variables are columns not in pivots
                free = [c for c in range(m) if c not in pivots]
                basis = []
                for free_var in free:
                    # set free_var =1, others free=0, solve for pivot vars
                    vec = [0]*m
                    vec[free_var]=1
                    # back substitution: for each pivot row, compute value
                    for i_rev in range(rank-1, -1, -1):
                        col = pivots[i_rev]
                        # row i_rev has leading 1 at col, and other entries at free vars
                        # compute sum of known free vars in that row
                        s = 0
                        for j in range(col+1, m):
                            if rows[i_rev][j] and vec[j]:
                                s ^= 1
                        # pivot variable = s (since row equation: x_col + sum_{j>col} a_{col,j} x_j =0)
                        vec[col] = s
                    basis.append(vec)
                return basis
            
            basis = gf2_nullspace_left(ops)
            len(basis)
            
