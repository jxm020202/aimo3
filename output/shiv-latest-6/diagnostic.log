            import itertools, math
            
            def convex_hull_ccw(points):
                # returns hull points in CCW order
                # Use monotonic chain then ensure CCW
                pts = sorted(set(points))
                if len(pts) <= 1:
                    return pts
                def cross(o,a,b):
                    return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
                lower = []
                for p in pts:
                    while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
                        lower.pop()
                    lower.append(p)
                upper = []
                for p in reversed(pts):
                    while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
                        upper.pop()
                    upper.append(p)
                hull = lower[:-1] + upper[:-1]
                # ensure CCW (positive area)
                area = 0
                n = len(hull)
                for i in range(n):
                    x1,y1 = hull[i]
                    x2,y2 = hull[(i+1)%n]
                    area += x1*y2 - x2*y1
                if area < 0:
                    hull = list(reversed(hull))
                return hull
            
            def points_for_labeling(a,b,h, swap_QR=False, swap_ST=False):
                Q,R_pt,S,T = compute_points_labeling(a,b,h, not swap_QR, not swap_ST) # Wait compute_points_labeling uses Q_near flag; we need to generate both points for each chord
                # Actually compute_points_labeling returns Q,R_pt,S,T based on near/far flags.
                # We want to generate both possibilities: near/far for each chord.
                # Let's just generate both points for each chord directly:
                # We'll compute base points Q1,R1,S1,T1 as earlier
                R = math.hypot(7.5, h)
                M_QR = (7.5 * a**2/(2*R**2), h * a**2/(2*R**2))
                M_ST = (15 - 7.5 * b**2/(2*R**2), h * b**2/(2*R**2))
                half_QR = a * math.sqrt(1 - a**2/(4*R**2))
                half_ST = b * math.sqrt(1 - b**2/(4*R**2))
                w = (-h / R, 7.5 / R)
                wp = (-h / R, -7.5 / R)
                Q1 = (M_QR[0] - w[0]*half_QR, M_QR[1] - w[1]*half_QR)
                R1 = (M_QR[0] + w[0]*half_QR, M_QR[1] + w[1]*half_QR)
                S1 = (M_ST[0] - wp[0]*half_ST, M_ST[1] - wp[1]*half_ST)
                T1 = (M_ST[0] + wp[0]*half_ST, M_ST[1] + wp[1]*half_ST)
                # swap if needed
                if swap_QR:
                    Q,R_pt = R1, Q1
                else:
                    Q,R_pt = Q1, R1
                if swap_ST:
                    S,T = T1, S1
                else:
                    S,T = S1, T1
                return Q,R_pt,S,T
            
            def check_labelings(a,b,h):
                solutions = []
                for swap_QR in [False, True]:
                    for swap_ST in [False, True]:
                        Q,R_pt,S,T = points_for_labeling(a,b,h,swap_QR,swap_ST)
                        SQ = dist(S,Q)
                        RT = dist(R_pt,T)
                        # compute convex hull order
                        hull = convex_hull_ccw([S,Q,(0,0),R_pt,T,(15,0)])
                        # check if hull order matches the sequence S,Q,P1,R,T,P2 up to rotation
                        seq = [S,Q,(0,0),R_pt,T,(15,0)]
                        # generate rotations of seq
                        def rotations(lst):
