            import numpy as np, math
            
            def diff(a,b,c):
                left = a/(4*a*a+1) + b/(4*b*b+1) + c/(4*c*c+1)
                right = 1/(8*(a+b)*(b+c)*(c+a))
                return left - right
            
            def find_c_bracket(a,b):
                # search c in (1e-6, 10) for sign change
                cs = np.logspace(-4, 2, 200)
                vals = [diff(a,b,c) for c in cs]
                for i in range(len(cs)-1):
                    if vals[i]==0:
                        return cs[i]
                    if vals[i]*vals[i+1] < 0:
                        # bracket found
                        lo, hi = cs[i], cs[i+1]
                        # use bisection
                        for _ in range(60):
                            mid = (lo+hi)/2
                            if diff(a,b,mid)==0:
                                return mid
                            if diff(a,b,lo)*diff(a,b,mid) <=0:
                                hi=mid
                            else:
                                lo=mid
                        return (lo+hi)/2
                return None
            
            # test with a=b equal case
            t = 1/(2*math.sqrt(3))
            print(diff(t,t,t))
            print(find_c_bracket(t,t))
            
