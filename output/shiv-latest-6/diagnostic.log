            import numpy as np, cmath, math, random, sys, itertools, sympy as sp, mpmath as mp
            
            def fermat_point(x, y, z):
                # solve for p using mpmath findroot
                # unknown p = u+iv
                def equations(vars):
                    u, v = vars[0], vars[1]
                    p = u + 1j*v
                    omega = complex(-0.5, math.sqrt(3)/2)  # e^{i 120°}
                    # condition: (x-p)/(y-p) / omega is real => imag = 0
                    t1 = (x-p)/(y-p)/omega
                    t2 = (z-p)/(y-p)/omega
                    return [t1.imag, t2.imag]
                # initial guess maybe centroid
                cx = (x+y+z)/3
                try:
                    sol = mp.findroot(lambda u,v: (equations([u,v])[0], equations([u,v])[1]), (cx.real, cx.imag))
                    p = complex(sol[0], sol[1])
                    return p
                except Exception as e:
                    # fallback: use sympy nsolve
                    u,v = sp.symbols('u v', real=True)
                    p_sym = u + sp.I*v
                    omega = sp.exp(sp.I*2*sp.pi/3)
                    eq1 = sp.im((x-p_sym)/(y-p_sym)/omega)
                    eq2 = sp.im((z-p_sym)/(y-p_sym)/omega)
                    try:
                        sol = sp.nsolve([eq1, eq2], [u,v], [cx.real, cx.imag], tol=1e-14, maxsteps=100)
                        p = complex(float(sol[0]), float(sol[1]))
                        return p
                    except Exception as e2:
                        # print("fail", e, e2)
                        return None
            
            def collinearity_error(p, y, n):
                # compute imag of (p-y)/(n-y)
                if abs(n-y) < 1e-12:
                    return None
                return ((p - y)/(n - y)).imag
            
            def test_random(num=100):
                errors = []
                for _ in range(num):
                    # random acute triangle: choose angles A,B,C < 90
                    # choose alpha, beta random in (0, pi)
                    alpha = random.uniform(0.1, math.pi-0.1)
                    beta = random.uniform(0.1, math.pi-0.1)
                    if alpha+beta <= math.pi: # ensure B acute (<90)
                        continue
                    # compute points
                    x = cmath.exp(1j*alpha)
                    y = 1+0j
                    z = cmath.exp(-1j*beta)
                    p = fermat_point(x,y,z)
                    if p is None:
                        continue
                    n = (x + y + z)/2
                    err = collinearity_error(p, y, n)
                    errors.append((alpha,beta,err))
