            import sympy as sp
            def find_solutions(limit):
                sols=[]
                for x in range(1, limit+1, 2): # odd x
                    N = (x+1)*(x*x - x + 1)
                    if N % 2 != 0:
                        continue
                    M = N//2
                    # factor M
                    fac = sp.factorint(M)
                    # compute squarefree part: product of primes with odd exponent
                    sqfree = 1
                    for prime, exp in fac.items():
                        if exp % 2 == 1:
                            sqfree *= prime
                    # need sqfree to be a prime
                    if not sp.isprime(sqfree):
                        continue
                    p = sqfree
                    if p % 8 != 5:
                        continue
                    # compute y^2 = M / p
                    if M % p != 0:
                        continue
                    y2 = M // p
                    if sp.is_square(y2):
                        y = int(sp.sqrt(y2))
                        sols.append((x,y,p))
                return sols
            
            sols = find_solutions(5000)
            len(sols), sols[:20]
            
