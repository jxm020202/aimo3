            def max_agreement(V):
                # V binary matrix n x n
                n = V.shape[0]
                W = 1 - 2*V  # map 0->1, 1->-1
                best = -10**9
                # enumerate a vectors (rows signs) as bits
                for a_int in range(1<<n):
                    a = np.array([1 if (a_int>>i)&1 else -1 for i in range(n)], dtype=np.int8)
                    # compute column sums s_j = sum_i a_i * W_{ij}
                    s = a @ W  # shape (n,)
                    # choose b_j = sign(s_j)
                    b = np.where(s>=0, 1, -1)
                    val = a @ (W @ b)
                    if val > best:
                        best = val
                # matches = (n*n + best)//2
                matches = (n*n + best)//2
                return matches
            
