            import math, cmath, numpy as np
            
            def collinearity_condition(beta,gamma):
                # compute as earlier
                a = complex(1,0)
                b = cmath.exp(1j*2*gamma)
                c = cmath.exp(-1j*2*beta)
                rot = cmath.exp(1j*math.pi/3)
                Bp = a + rot*(b - a)
                Cp = b + rot*(c - b)
                # intersection
                def cross(u,v):
                    return (u.conjugate()*v).imag
                u = c - Bp
                v = a - Cp
                w = Cp - Bp
                denom = cross(u, v)
                if abs(denom) < 1e-12:
                    return None
                t = cross(w, v) / denom
                P = Bp + t*u
                N = (a + b + c)/2  # nine-point center
                val = (P - b).conjugate() * (N - b)
                return val.imag
            
