            import random, math, cmath, numpy as np, sys, itertools, time, math, cmath
            def fermat_point(A,B,C):
                # A,B,C are complex numbers
                rot = cmath.exp(1j*math.pi/3)  # +60 deg
                Bp = A + rot*(B - A)
                Cp = B + rot*(C - B)
                # Intersection of line Bp-C and Cp-A
                # Solve using cross product method
                def intersect(p1,p2,q1,q2):
                    # returns intersection point
                    # cross product (2D) as imag(conj(u)*v)
                    u = p2 - p1
                    v = q2 - q1
                    w = q1 - p1
                    denom = (u.conjugate()*v).imag
                    if abs(denom) < 1e-12:
                        return None
                    t = (w.conjugate()*v).imag / denom
                    return p1 + t*u
                P = intersect(Bp, C, Cp, A)
                return P
            
            def nine_point_center(A,B,C):
                # circumcenter O of triangle ABC
                # compute using formula for circumcenter of points in plane
                # Use complex numbers: O = intersection of perpendicular bisectors
                # Use standard formula using coordinates
                Ax,Ay = A.real, A.imag
                Bx,By = B.real, B.imag
                Cx,Cy = C.real, C.imag
                D = 2*(Ax*(By-Cy) + Bx*(Cy-Ay) + Cx*(Ay-By))
                if abs(D) < 1e-12:
                    return None
                Ux = ((Ax**2+Ay**2)*(By-Cy) + (Bx**2+By**2)*(Cy-Ay) + (Cx**2+Cy**2)*(Ay-By))/D
                Uy = ((Ax**2+Ay**2)*(Cx-Bx) + (Bx**2+By**2)*(Ax-Cx) + (Cx**2+Cy**2)*(Bx-Ax))/D
                O = complex(Ux, Uy)
                # orthocenter H: using vector formula: H = A + B + C - 2*O (for Euclidean plane)
                H = A + B + C - 2*O
                N = (O + H)/2
                return N
            
