            def coeffs(L):
                coeff=[]
                for i in range(L):
                    # i index from 0 (most significant) to L-1 (least)
                    # compute (i-1)*7^{L-1-i} + (L-1-i)*7^{L-2-i}
                    term1 = (i-1)*(7**(L-1-i))
                    if L-2-i >= 0:
                        term2 = (L-1-i)*(7**(L-2-i))
                    else:
                        term2 = 0
                    coeff.append(term1 + term2)
                return coeff
            
            def find_solutions_by_length(L):
                coeff = coeffs(L)
                solutions=[]
                # recursion over digits
                def backtrack(pos, current_sum, digits):
                    # pos is index i (0..L-1)
                    if pos == L:
                        if current_sum == 0:
                            # leading digit must be non-zero
                            if digits[0] != 0:
                                # compute number value
                                val=0
                                for d in digits:
