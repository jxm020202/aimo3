            def a_i_from_n_digit(m, b_i, removal='all'):
                m_digits = base7_digits(m)
                if removal == 'all':
                    new = [d for d in m_digits if d != b_i]
                elif removal == 'one':
                    # remove first occurrence from left
                    new = m_digits.copy()
                    try:
                        idx = new.index(b_i)
                        del new[idx]
                    except ValueError:
                        pass
                else:
