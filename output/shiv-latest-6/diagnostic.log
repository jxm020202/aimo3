            # compute orthocenter H in plane z=0
            # Using formula: H = A + B + C - 2*O where O is circumcenter of triangle.
            def circumcenter_triangle(P,Q,R):
                # 2D circumcenter using sympy
                x1,y1 = P[0],P[1]
                x2,y2 = Q[0],Q[1]
                x3,y3 = R[0],R[1]
                D = 2*(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2))
                ux = ((x1**2+y1**2)*(y2-y3)+(x2**2+y2**2)*(y3-y1)+(x3**2+y3**2)*(y1-y2))/D
                uy = ((x1**2+y1**2)*(x3-x2)+(x2**2+y2**2)*(x1-x3)+(x3**2+y3**2)*(x2-x1))/D
                return sp.Matrix([ux, uy, 0])
            O = circumcenter_triangle(A,B,C)
            H = A + B + C - 2*O
            A,B,C,O,H
            
