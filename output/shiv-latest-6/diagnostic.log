            def min_moves_bitmask(n):
                init = 0
                for i in range(n):
                    if i%2==1:
                        init |= (1<<i)
                target = (1<<n)-1
                from collections import deque
                q=deque()
                q.append((init,-1,0))
                seen=set()
                while q:
                    mask,last,steps=q.popleft()
                    if mask==target:
                        return steps
                    key=(mask,last)
                    if key in seen: continue
                    seen.add(key)
                    if last==-1:
                        cand=range(n)
                    else:
                        cand=[]
                        if last-1>=0: cand.append(last-1)
                        if last+1<n: cand.append(last+1)
                    for i in cand:
                        q.append((mask ^ (1<<i), i, steps+1))
                return None
            
