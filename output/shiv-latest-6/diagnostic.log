                # backtrack to find size 2N-1
                target=2*N-1
                points=[(x,y) for x in range(N) for y in range(N)]
                bestset=None
                def recurse(idx, selected, rows, cols, rowdiffs, coldiffs):
                    nonlocal bestset
                    if len(selected)==target:
                        bestset=selected.copy()
                        raise StopIteration
                    if idx==len(points):
                        return
                    # bound
                    if len(selected)+(len(points)-idx) < target:
                        return
                    x,y=points[idx]
                    # try include
                    conflict=False
                    xs=rows.get(y, [])
                    for a in xs:
                        d=x-a
                        # check other rows
                        for other_y, diffs in rowdiffs.items():
                            if other_y!=y and d in diffs:
