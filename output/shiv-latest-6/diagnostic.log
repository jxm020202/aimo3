            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def min_weight_for_syndrome(s, H):
                # s is binary vector length m (36)
                m, n = H.shape
                # variables: x (n binary), y (m integer)
                c = np.concatenate([np.ones(n, dtype=int), np.zeros(m, dtype=int)])  # objective minimize sum x
                # constraints: H x - 2 y = s
                # Represent as A_eq x = b_eq, where variables = [x, y]
                A_eq = np.concatenate([H, -2*np.eye(m, dtype=int)], axis=1)
                # b_eq = s
                b_eq = s.astype(int)
                # variable bounds
                # x bounds 0-1 integer, y bounds 0- (maybe large)
                lb = np.concatenate([np.zeros(n), np.zeros(m)])
                ub = np.concatenate([np.ones(n), np.full(m, 361)])  # y <= 361 enough
                # integrality: first n variables integer (binary), rest integer (continuous but integer)
                integrality = np.concatenate([np.ones(n), np.ones(m)])  # all integer
                # define constraints
                lin_con = LinearConstraint(A_eq, b_eq, b_eq)
                bounds = Bounds(lb, ub)
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    # maybe infeasible? should always be feasible
                    return None
                weight = int(round(res.x[:n].sum()))
