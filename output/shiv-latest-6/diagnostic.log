            def has_perfect_matching(strings, color):
                # strings: list of ints 0..255 representing 8-bit rows
                # color: 0 or 1 meaning we look for edges where bit == color
                n = 8
                # Build adjacency list from columns to strings indices
                adj = [[] for _ in range(n)]
                for idx, s in enumerate(strings):
                    for col in range(n):
                        bit = (s >> (7-col)) & 1  # assume leftmost is col0
                        if bit == color:
                            adj[col].append(idx)
                # bipartite matching using DFS (Kuhn)
                m = len(strings)
                match_to = [-1]*m
                def dfs(v, visited):
                    for u in adj[v]:
                        if visited[u]: continue
                        visited[u]=True
                        if match_to[u]==-1 or dfs(match_to[u], visited):
                            match_to[u]=v
                            return True
                    return False
                for v in range(n):
