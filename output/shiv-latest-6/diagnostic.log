            def gf2_rank(matrix):
                # matrix: list of lists of ints 0/1, shape m x n
                m = len(matrix)
                if m == 0:
                    return 0
                n = len(matrix[0])
                # Convert rows to int bitsets for speed (n <= 361)
                # Use Python int as bitset
                rows = [int(''.join(str(b) for b in row), 2) for row in matrix]
                rank = 0
                col = n-1  # we can start from leftmost? We'll use highest bits.
                # Actually easier: iterate over columns from 0..n-1
                # We'll treat bit position 0 as LSB (rightmost). We'll map column index to bit position.
                # We'll use bitmask = 1 << (n-1-col) to align with string representation.
                # Let's just treat column index j corresponds to bit (n-1-j)
                rows = [int(''.join(str(b) for b in row), 2) for row in matrix]  # already done
                # Gaussian elimination
                pivot_row = 0
                for col in range(n):
                    # Find row with a 1 in this column at or below pivot_row
                    mask = 1 << (n-1-col)
                    sel = None
                    for r in range(pivot_row, m):
                        if rows[r] & mask:
                            sel = r
                            break
                    if sel is None:
                        continue
                    # Swap sel row with pivot_row
                    rows[pivot_row], rows[sel] = rows[sel], rows[pivot_row]
                    # Eliminate other rows
                    for r in range(m):
                        if r != pivot_row and (rows[r] & mask):
                            rows[r] ^= rows[pivot_row]
                    pivot_row += 1
                    if pivot_row == m:
                        break
                rank = pivot_row
                return rank
            
