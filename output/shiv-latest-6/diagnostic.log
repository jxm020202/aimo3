            def fermat_point(a,b,c):
                # a,b,c complex points on unit circle (or any)
                # Determine orientation sign using cross product of (b-a) and (c-a)
                def orientation(p,q,r):
                    # returns sign of imag((q-p)*conj(r-p))
                    return 1 if ((q-p)*(r-p).conjugate()).imag > 0 else -1
                # orientation of triangle a,b,c
                sign = orientation(a,b,c)  # +1 for CCW, -1 for CW
                # rotation factor for outward equilateral on side a-b
                omega_ab = cmath.exp(-1j*sign*math.pi/3)
                U = a + (b - a) * omega_ab
                # side b-c outward
                omega_bc = cmath.exp(-1j*sign*math.pi/3)  # same sign? orientation same for triangle
                V = b + (c - b) * omega_bc
                # line Z-U: points c and U
                # line X-V: points a and V
                # compute intersection
                # line param: p + t*(q-p)
                def line_intersection(p1, p2, q1, q2):
                    # solve p1 + t*(p2-p1) = q1 + s*(q2-q1)
                    # treat as 2D real
                    x1,y1 = p1.real, p1.imag
                    x2,y2 = p2.real, p2.imag
                    x3,y3 = q1.real, q1.imag
                    x4,y4 = q2.real, q2.imag
                    # solve using determinant
                    denom = (x1 - x2)*(y3 - y4) - (y1 - y2)*(x3 - x4)
                    if abs(denom) < 1e-12:
