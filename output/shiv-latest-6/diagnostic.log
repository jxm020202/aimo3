            import itertools, math, sys, numpy as np, itertools, math, time, collections, random, sys, os, json, math, itertools, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def feasible_sum(n, target):
                N=n*n
                # variable ordering: first N x's, then M binary for edges
                # edges: horizontal (n*(n-1)) + vertical ((n-1)*n) = 2n(n-1)
                M = 2*n*(n-1)
                total_vars = N + M
                # bounds
                lb = np.zeros(total_vars)
                ub = np.full(total_vars, np.inf)
                # integrality: first N variables integer, next M binary
                integrality = np.concatenate([np.ones(N), np.ones(M)])  # treat all as integer, but we will set binary constraints via bounds 0-1
                # For binary variables, set ub=1
                ub[N:] = 1
                # constraints list
                A=[]
                l=[]
                u=[]
                # adjacency constraints
                # map (i,j) to index
                idx=lambda i,j: i*n+j
                edge_idx=0
                for i in range(n):
                    for j in range(n):
                        u_idx=idx(i,j)
                        # right neighbor
                        if j+1<n:
                            v_idx=idx(i,j+1)
                            b=edge_idx
                            # x_u - x_v + 2*b = 1
                            row=np.zeros(total_vars)
                            row[u_idx]=1
                            row[v_idx]=-1
                            row[N+b]=2
                            A.append(row); l.append(1); u.append(1)
                            edge_idx+=1
                        # down neighbor
                        if i+1<n:
                            v_idx=idx(i+1,j)
                            b=edge_idx
                            row=np.zeros(total_vars)
                            row[u_idx]=1
                            row[v_idx]=-1
                            row[N+b]=2
                            A.append(row); l.append(1); u.append(1)
                            edge_idx+=1
                # sum constraint
                row=np.zeros(total_vars)
                row[:N]=1
                A.append(row); l.append(target); u.append(target)
                # convert to arrays
                A=np.array(A)
                lc=LinearConstraint(A,l,u)
                # bounds
                bounds=Bounds(lb,ub)
                # objective dummy zero
                c=np.zeros(total_vars)
                res=milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                return res.success
            
            def feasible_n_for_target(target, max_n=7):
                feasible=[]
                for n in range(1,max_n+1):
                    if feasible_sum(n,target):
                        feasible.append(n)
                return feasible
            
