            def coeffs_exclude(L):
                # compute coefficient for digit d_k (k from 0 least) in D' = sum_{i=0}^{L-2} (H_i*7^{i}+L_i) - n
                # We'll compute via brute symbolic using formula earlier but subtract term i=L-1.
                coeff=[]
                for k in range(L):
                    # compute contribution to S (full) earlier: c_full = k*7^{k-1} + (L-2 - k)*7^{k}
                    # For i = L-1 term removal: when removing most significant digit, resulting number = lower part = n mod 7^{L-1}
                    # Its contribution to coefficient for digit k is: if k <= L-2 then digit contributes 7^{k} (since lower part includes that digit), else (k = L-1) contributes 0.
                    # So subtract this from full coefficient.
                    c_full = (k*7**(k-1) if k>=1 else 0) + (L-2 - k)*7**k
                    # subtract contribution from removed term
                    if k <= L-2:
                        c_full -= 7**k
                    # else no subtraction
                    coeff.append(c_full)
                return coeff
            
            for L in range(2,10):
                print(L, coeffs_exclude(L))
            
