            def all_labelings(n, max_val=4):
                # brute force all possible labelings with values up to max_val
                from itertools import product
                cells=n*n
                # We'll generate via recursion using adjacency constraints.
                solutions=[]
                grid=[[0]*n for _ in range(n)]
                def rec(idx):
                    if idx==cells:
                        # compute sum
                        s=sum(grid[i][j] for i in range(n) for j in range(n))
                        solutions.append(s)
                        return
                    i=idx//n
                    j=idx%n
                    possible=set(range(max_val+1))
                    if i>0:
                        up=grid[i-1][j]
                        possible={up+1, up-1}.intersection(possible)
                    if j>0:
                        left=grid[i][j-1]
                        possible={left+1, left-1}.intersection(possible)
                    for v in possible:
