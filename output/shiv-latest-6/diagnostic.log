            def min_size_cover_fib(n):
                # need to cover F_2..F_n inclusive
                F=[0,1]
                for i in range(2,n+1):
                    F.append(F[-1]+F[-2])
                required=F[2:]  # list of required differences
                max_val=required[-1]
                # search m from 1 upward
                for m in range(1,10):
                    # generate combinations of m distinct integers between 0 and max_val inclusive
                    # we can assume 0 is in set (shift invariance)
                    # so we generate combinations of m-1 other numbers >0
                    for combo in itertools.combinations(range(1,max_val+1), m-1):
                        S = (0,)+combo
                        diffs=set()
                        for i in range(m):
                            for j in range(m):
                                if i!=j:
                                    diffs.add(S[j]-S[i])
                        if all(d in diffs for d in required):
                            return m, S
                return None
            
