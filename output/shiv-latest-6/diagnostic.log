            def find_row_seq(n, target_sum, min_needed):
                # return a sequence of s_i values (length n) meeting sum and min >= min_needed
                # steps +-1
                def dfs(i, disp, cum, min_disp, seq):
                    if i == n:
                        if cum == target_sum and min_disp >= min_needed:
                            return seq
                        return None
                    if i == 0:
                        # s_0 = 0
                        return dfs(1, 0, 0, 0, [0])
                    else:
                        for delta in (+1, -1):
                            nd = disp + delta
                            nc = cum + nd
                            nmin = min(min_disp, nd)
                            res = dfs(i+1, nd, nc, nmin, seq+[nd])
                            if res:
                                return res
                    return None
                return dfs(0,0,0,0,[])
                
