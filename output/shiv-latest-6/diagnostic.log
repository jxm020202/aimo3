            def find_degree3():
                a,b,c,d = sp.symbols('a b c d', integer=True)
                x=sp.symbols('x')
                f = a*x**3 + c
                g = b*x**3 + d
                expr = sp.expand(f.subs(x,g) - 3*g.subs(x,f))
                # collect coefficients up to degree 9
                coeffs = [sp.expand(expr).coeff(x,i) for i in range(9, -1, -1)]
                # equations for degrees 9..1 =0
                equations = [coeffs[i] for i in range(0,9)]  # first 9 entries correspond to x^9 down to x^1
