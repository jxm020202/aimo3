            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def min_weight_for_syndrome(syndrome_int):
                # syndrome_int is 36-bit integer
                # Build constraints: H x = s (mod 2) -> sum_i H[j,i] x_i - 2*t_j = s_j
                m = N
                # Variables: x_i binary, t_j integer >=0
                # We'll create variable vector of length m + 36 (t variables)
                n_vars = m + 36
                # Objective: minimize sum x_i (coeff 1 for first m vars)
                c = np.zeros(n_vars)
                c[:m] = 1.0
                # Bounds
                lb = np.zeros(n_vars)
                ub = np.ones(n_vars)
                # x_i bounds 0-1, t_j bounds 0-? Actually t_j can be up to m//2 maybe. We'll set ub large.
                ub[m:] = m  # allow up to m
                # Integrality: all variables integer (binary for x, integer for t)
                integrality = np.ones(n_vars, dtype=int)
                # Linear constraints: for each syndrome equation j:
                # sum_i H[j,i] * x_i - 2*t_j = s_j
                A = np.zeros((36, n_vars), dtype=int)
                for j in range(36):
                    A[j, :m] = H[j]
                    A[j, m + j] = -2
                # Right-hand side b = s_j
                b = np.array([(syndrome_int >> j) & 1 for j in range(36)], dtype=int)
                # Use LinearConstraint with lb=ub=b (equality)
                lin_con = LinearConstraint(A, b, b)
                # Solve MILP
                res = milp(c=c, constraints=lin_con, bounds=Bounds(lb, ub), integrality=integrality, options={"disp": False})
                if not res.success:
                    # No solution? Should always have solution
                    return None
                weight = int(round(res.fun))
                return weight
            
            # Test on syndrome 0 (should have solution weight 0)
            print(min_weight_for_syndrome(0))
            
