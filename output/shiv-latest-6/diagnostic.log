# Unknowns: r1 (radius of Gamma1), h (y-coordinate of Sigma center)
r1, h = sp.symbols('r1 h', positive=True, real=True)

# Derived quantities
r2 = 15 - r1  # radius of Gamma2
A = 4*h**2 + 225  # common denominator term

# Helper sqrt term that appears in coordinates
sqrt_term1 = sp.sqrt(4*h**2 + 225 - r1**2)   # appears for Gamma1 intersections
sqrt_term2 = sp.sqrt(4*h**2 + 225 - r2**2)   # appears for Gamma2 intersections

# Coordinates of the two intersection points of Sigma with Gamma1 (Q,R)
x_Q = (15*r1**2 + 2*r1*h*sqrt_term1) / A
x_R = (15*r1**2 - 2*r1*h*sqrt_term1) / A
y_Q = (r1**2 - 15*x_Q) / (2*h)
y_R = (r1**2 - 15*x_R) / (2*h)

# Coordinates of the two intersection points of Sigma with Gamma2 (S,T)
x_S = 15 + (-15*r2**2 + 2*r2*h*sqrt_term2) / A
x_T = 15 + (-15*r2**2 - 2*r2*h*sqrt_term2) / A
y_S = (15*x_S - (30*r1 - r1**2)) / (2*h)
y_T = (15*x_T - (30*r1 - r1**2)) / (2*h)

# Distance squared constraints
eq1 = (x_S - x_Q)**2 + (y_S - y_Q)**2 - 2**2   # SQ = 2
eq2 = (x_R - x_T)**2 + (y_R - y_T)**2 - 16**2  # RT = 16

# Solve numerically; provide reasonable initial guesses.
# r1 must be between 0 and 15, h>0. Try a few guesses.
