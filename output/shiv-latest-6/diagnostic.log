            import numpy as np, math, random
            
            def fermat_point_numeric(A,B,C):
                # rotate C around A by +60 deg
                theta = math.radians(60)
                cos60 = 0.5
                sin60 = math.sqrt(3)/2
                # vector C-A
                v = np.array([C[0]-A[0], C[1]-A[1]])
                R = np.array([[cos60, -sin60],[sin60, cos60]])
                Cprime = A + R.dot(v)
                # rotate A around B by -60 deg
                v2 = np.array([A[0]-B[0], A[1]-B[1]])
                Rm = np.array([[cos60, sin60],[-sin60, cos60]])  # -60
                Aprime = B + Rm.dot(v2)
                # lines B->Cprime and C->Aprime intersect
                # param t for B + t*(Cprime-B)
                # param s for C + s*(Aprime-C)
                # solve B + t*(Cprime-B) = C + s*(Aprime-C)
                # B is origin (0,0) in our coordinate system? Not necessarily; but we can solve general.
                # Use linear equations for t,s
                # Write as t*(Cprime-B) - s*(Aprime-C) = C - B
                # Solve 2x2
                M = np.column_stack((Cprime - B, -(Aprime - C)))  # 2x2
                rhs = np.array(C) - np.array(B)
                ts = np.linalg.solve(M, rhs)
                t = ts[0]
                P = B + t*(Cprime - B)
                return P
            
            def nine_point_center_numeric(A,B,C):
                # circumcenter O
                # using perpendicular bisector intersection
                A = np.array(A); B = np.array(B); C = np.array(C)
                # compute circumcenter via formula
                d = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                ux = ((np.linalg.norm(A)**2)*(B[1]-C[1]) + (np.linalg.norm(B)**2)*(C[1]-A[1]) + (np.linalg.norm(C)**2)*(A[1]-B[1]))/d
                uy = ((np.linalg.norm(A)**2)*(C[0]-B[0]) + (np.linalg.norm(B)**2)*(A[0]-C[0]) + (np.linalg.norm(C)**2)*(B[0]-A[0]))/d
                O = np.array([ux, uy])
                # orthocenter H = A + B + C - 2*O (Euler line relation: O is circumcenter, H = A + B + C - 2O? Actually vector relation: O is circumcenter, G centroid = (A+B+C)/3, Euler line: O,G,H are collinear with OG:GH = 1:2, and H = 3G - 2O = A+B+C - 2O
                H = A + B + C - 2*O
                N = (O + H)/2
                return N
            
            def angle_at_B_numeric(A,B,C):
                BA = np.array(A)-np.array(B)
                BC = np.array(C)-np.array(B)
                dot = np.dot(BA,BC)
                cross = np.cross(BA,BC)  # scalar in 2D
                ang = math.degrees(math.atan2(abs(cross), dot))
                return ang
            
