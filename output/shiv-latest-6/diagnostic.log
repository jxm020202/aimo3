                digs=base7_digits(n)
                L=len(digs)
                B=7
                total=0
                for j,d in enumerate(digs):
                    total += d * (j * B**(L-1-j) + (L-1-j) * B**(L-2-j) if L-2-j >=0 else j * B**(L-1-j))
