            def fermat_point_general(p1,p2,p3):
                # using complex numbers, compute Fermat point for acute triangle
                # Use known formula: For each vertex, construct equilateral triangle outward.
                # Determine outward orientation: The Fermat point is intersection of lines from vertices to opposite equilateral triangle vertices.
                # We'll try both possibilities for each side and find intersection inside triangle.
                rot_pos = cmath.exp(1j*math.pi/3)  # +60°
                rot_neg = cmath.exp(-1j*math.pi/3) # -60°
                # generate candidate points for equilateral triangle on side p1-p2
                candidates = []
                for rot in [rot_pos, rot_neg]:
                    # third vertex of equilateral triangle on side p1p2
                    U = p1 + (p2 - p1) * rot
                    # line from opposite vertex p3 to U
                    # Similarly need another line from another side.
                    for rot2 in [rot_pos, rot_neg]:
                        V = p2 + (p3 - p2) * rot2
                        # intersect line p3-U and line p1-V
                        # Solve p3 + t1*(U-p3) = p1 + t2*(V-p1)
                        dir1 = U - p3
                        dir2 = V - p1
                        A = np.array([[dir1.real, -dir2.real],[dir1.imag, -dir2.imag]])
                        b = np.array([ (p1-p3).real, (p1-p3).imag])
                        try:
                            t1,t2 = np.linalg.solve(A,b)
                            F = p3 + t1*dir1
                            # check inside triangle using barycentric sign
                            def area(a,b,c):
                                return (b.real-a.real)*(c.imag-a.imag)-(b.imag-a.imag)*(c.real-a.real)
                            A0 = area(p1,p2,p3)
                            A1 = area(F,p2,p3)
                            A2 = area(p1,F,p3)
                            A3 = area(p1,p2,F)
                            if (A0>0 and A1>0 and A2>0 and A3>0) or (A0<0 and A1<0 and A2<0 and A3<0):
                                return F
                        except np.linalg.LinAlgError:
                            pass
                return None
            
