            def S_formula(n):
                digs=to_base7(n)
                m=len(digs)-1
                S=0
                # first sum: j from 1..m, coefficient j, weight 7^{j-1}
                for j in range(1,m+1):
                    dj = digs[-1 - j]  # digit at position j
                    S += dj * (7**(j-1)) * j
                # second sum: j from 0..m-2, coefficient (m-1 - j), weight 7^{j}
                for j in range(0,m-1):
                    dj = digs[-1 - j]
                    S += dj * (7**j) * (m-1 - j)
                return S
            
            def check_S(n):
