            def dp_opt(N):
                import numpy as np
                M=2001
                t_vals = np.linspace(0,1,M)
                # f_{i}(t) for i from N down to 2 (since term i uses a_i/(1+a_{i-1}))
                f = np.zeros(M)  # for i = N+1 (no term)
                # compute for i = N down to 2
                for i in range(N,1,-1):
                    f_new = np.zeros(M)
                    for idx,t in enumerate(t_vals):
                        # maximize over a in [0,1]
                        a_grid = t_vals
                        val = a_grid/(1+t) + np.interp(a_grid, t_vals, f)
                        best = np.max(val)
                        f_new[idx]=best
                    f = f_new
                # now total = max_{a1} a1 + f(a1) where f corresponds to i=2 term onward
                best_total=0
                best_a1=0
                for idx,t in enumerate(t_vals):
                    total = t + f[idx]
                    if total>best_total:
                        best_total=total
                        best_a1=t
                return best_total,best_a1
            
