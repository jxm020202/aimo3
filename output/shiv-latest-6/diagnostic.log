            def fvec_mp2(r1_val, h_val):
                # using mpmath
                r1_val = mp.mpf(r1_val)
                h_val = mp.mpf(h_val)
                # compute sqrt term
                sqrt_term = mp.sqrt(4*h_val**2 - r1_val**2 + 30*r1_val)
                denom = 4*h_val**2 + 225
                # points
                xQ = r1_val*(-2*h_val*sqrt_term + 15*r1_val)/denom
                yQ = r1_val*(2*h_val*r1_val + 15*sqrt_term)/denom
                xR = r1_val*(2*h_val*sqrt_term + 15*r1_val)/denom
                yR = r1_val*(2*h_val*r1_val - 15*sqrt_term)/denom
                xS = (60*h_val**2 - 2*h_val*(r1_val - 15)*sqrt_term - 15*r1_val**2 + 450*r1_val)/denom
                yS = (15*xS + r1_val**2 - 30*r1_val)/(2*h_val)
                xT = (60*h_val**2 + 2*h_val*(r1_val - 15)*sqrt_term - 15*r1_val**2 + 450*r1_val)/denom
                yT = (15*xT + r1_val**2 - 30*r1_val)/(2*h_val)
                d_low = mp.sqrt((xR - xT)**2 + (yR - yT)**2)
                d_up = mp.sqrt((xQ - xS)**2 + (yQ - yS)**2)
                return [d_low - 2, d_up - 16]
            
            def solve_mp(r1_guess, h_guess):
                try:
                    sol = mp.findroot(lambda r1_val, h_val: (fvec_mp2(r1_val, h_val)[0], fvec_mp2(r1_val, h_val)[1]), (r1_guess, h_guess))
                    return sol
                except Exception as e:
                    return None
            
            for rg in [3,4,5,6,7]:
                for hg in [3,4,5,6,7,8,9,10]:
                    sol = solve_mp(rg, hg)
                    if sol:
                        print("guess",rg,hg,"solution",sol)
            
