            def max_black_milp(n, init):
                total=n*n
                # build basis
                ops=[]
                for i in range(n):
                    for j in range(n):
                        vec=[0]*total
                        for c in range(n):
                            vec[i*n+c]=1
                        for r in range(n):
                            vec[r*n+j]^=1
                        ops.append(vec)
                basis=basis_vectors(ops)
                rank=len(basis)
                # variables: y_k (binary) for k in rank, t_i (binary) for i in total, z_i (integer) auxiliary
                num_vars = rank + total + total  # order: y0..y_{rank-1}, t0.., z0..
                # objective coefficients
                c = np.zeros(num_vars)
                # coefficients for t_i part: a_i
                a = [1 if init[i]==0 else -1 for i in range(total)]
                for i in range(total):
                    c[rank + i] = a[i]  # t_i variable index
                # we will minimize -objective to maximize
                c = -c  # milp does minimization
                # constraints: t_i = sum_k basis_k[i] y_k - 2*z_i
                A_eq = []
                b_eq = []
                for i in range(total):
                    row = np.zeros(num_vars, dtype=int)
                    # t_i coefficient 1
                    row[rank + i] = 1
                    # subtract sum_k basis_k[i] y_k
                    for k in range(rank):
                        if basis[k][i]:
                            row[k] = -1
                    # subtract -2*z_i => add 2*z_i to left side? Equation: t_i - sum_k b_{k,i} y_k + 2*z_i = 0
                    row[rank + total + i] = 2
                    A_eq.append(row)
                    b_eq.append(0)
                A_eq = np.array(A_eq, dtype=float)
                b_eq = np.array(b_eq, dtype=float)
                # bounds
                lb = np.zeros(num_vars)
                ub = np.ones(num_vars)
                # y and t binary: bounds 0-1
                # z_i integer >=0, but also limited: sum_k <= rank, so z_i <= rank//2 maybe.
                # set ub for z_i to rank
                for i in range(total):
                    ub[rank + total + i] = rank
                # integrality: all variables integer
                integrality = np.ones(num_vars, dtype=int)
                # Use milp
                from scipy.optimize import milp, LinearConstraint, Bounds
                lin_con = LinearConstraint(A_eq, b_eq, b_eq)
                bounds = Bounds(lb, ub)
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={"presolve": True})
                if not res.success:
                    raise ValueError("MILP failed")
                # objective value
                max_obj = -res.fun  # because we minimized negative
                B = sum(init)
                final_black = B + max_obj
                return final_black
            
            # test for n=3 all white
            n=3
            init = [0]* (n*n)
            print(max_black_milp(n, init))
            
