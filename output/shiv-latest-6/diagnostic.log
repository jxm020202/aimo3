            def sum_delete_digits(n):
                # base-7 representation
                digs = base7_digits(n)
                m = len(digs)-1
                total = 0
                # i from 0 to m-1 (least to second most)
                for i in range(m):
                    # remove digit at position i (from right)
                    # compute number after removal
                    # using formula:
                    high = n // (7**(i+1))
                    low = n % (7**i)
                    new = high * (7**i) + low
                    total += new
                return total
            
            def find_solutions(limit):
                sols = []
                for n in range(1, limit):
                    if sum_delete_digits(n) == n:
                        sols.append(n)
                return sols
            
