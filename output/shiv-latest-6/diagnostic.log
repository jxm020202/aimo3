            import itertools, math
            
            def to_base7(x):
                if x==0:
                    return [0]
                digs=[]
                while x>0:
                    digs.append(x%7)
                    x//=7
                return digs[::-1]  # most significant first
            
            def remove_digit_from_digits(digits, d):
                # digits list of ints (base7)
                new=[x for x in digits if x!=d]
                if not new:
                    return 0
                # interpret as base7 number
                val=0
                for x in new:
                    val=val*7 + x
                return val
            
            def satisfies(n):
                # get base7 digits of n
                digs=to_base7(n)
                m=len(digs)-1
                # representation of m in base7
                m_digits=to_base7(m)
                total=0
                for i in range(m):
                    b_i=digs[i]  # careful: i from 0 to m-1 corresponds to which digit? b_i is digit at position i (least significant?). The representation is b_m ... b_0. So b_i is digit at position i (0 least significant). But we have digs list most significant first. So we need to map.
                    # Let's compute b_i: i from 0 (least) to m-1 (second most). So b_i = digs[-1-i]
                    b_i = digs[-1-i]
                    a_i = remove_digit_from_digits(m_digits, b_i)
                    total += a_i
                return total == n
            
            def find_solutions(limit):
                sols=[]
                for n in range(1, limit+1):
                    if satisfies(n):
                        sols.append(n)
                return sols
            
