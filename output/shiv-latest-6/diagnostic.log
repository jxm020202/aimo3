            import random, math, numpy as np
            
            def test(phi, theta):
                B = np.array([1.0, 0.0])
                C = np.array([math.cos(theta), math.sin(theta)])
                A = np.array([math.cos(phi), math.sin(phi)])
                H = A + B + C
                # compute circumcenter of H,B,C numerically
                # Solve linear equations: (X - H)·(B - C) = (B - C)·( (B+C)/2 )? Actually easier: use circumcenter formula via perpendicular bisectors.
                # Use numpy linear algebra.
                # Solve for X: (X - B)·(B - C) = (X - C)·(B - C) (equal distances)
                # Equivalent to (X)·(B - C) = (|B|^2 - |C|^2)/2
                # Similarly (X)·(B - H) = (|B|^2 - |H|^2)/2
                M = np.vstack([B - C, B - H])
                rhs = np.array([(np.dot(B,B) - np.dot(C,C))/2, (np.dot(B,B) - np.dot(H,H))/2])
                X = np.linalg.solve(M, rhs)
                # radius vector from X to H
                w = H - X
                # tangent direction v is perpendicular to w
                v = np.array([-w[1], w[0]])
                # compare v direction to BC vector
                bc = C - B
                # compute cross product (2D) of v and bc
                cross = v[0]*bc[1] - v[1]*bc[0]
                dot = np.dot(v, bc)
                return cross, dot
            
            for i in range(5):
                phi = random.uniform(0.2, 1.0)
                theta = random.uniform(1.2, 2.0)
                cross, dot = test(phi, theta)
                print(cross, dot)
            
