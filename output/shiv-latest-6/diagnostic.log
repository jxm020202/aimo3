                            # check if P inside triangle using barycentric
                            if sp.geometry.Triangle(X,Y,Z).encloses_point(P):
                                candidates.append(P)
                # should be one point
                return candidates[0] if candidates else None
            
            def nine_point_center(X,Y,Z):
                tri = sp.geometry.Triangle(X,Y,Z)
                O = tri.circumcenter
                H = tri.orthocenter
                return sp.Point( (O.x+H.x)/2, (O.y+H.y)/2 )
            
