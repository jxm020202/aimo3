            def nullspace_mod2(matrix):
                # matrix rows m x n, return list of basis vectors (length n) for nullspace over GF(2)
                m = len(matrix)
                n = len(matrix[0])
                A = [row[:] for row in matrix]
                # Perform Gaussian elimination to row-echelon form, keep track of column pivots
                pivots = []
                row = 0
                for col in range(n):
                    # find pivot row with 1 in this column
                    pivot = None
                    for r in range(row, m):
                        if A[r][col] % 2 == 1:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    pivots.append(col)
                    # eliminate below
                    for r in range(m):
                        if r != row and A[r][col] % 2 == 1:
                            A[r] = [(A[r][c] ^ A[row][c]) for c in range(n)]
                    row += 1
                    if row == m:
                        break
                # Now pivots list, free columns are those not in pivots
                free_cols = [c for c in range(n) if c not in pivots]
                basis = []
                for free in free_cols:
                    vec = [0]*n
                    vec[free] = 1
                    # set pivot variables to satisfy equations
                    # For each pivot row, the equation is sum_{j} A[row][j]*x_j = 0
                    # Since only free variable set, compute pivot variable value as dot of row with free vars
                    for r, piv in enumerate(pivots):
                        # compute sum of known free vars in this row
                        s = 0
                        for c in free_cols:
