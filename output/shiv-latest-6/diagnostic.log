            def base7_digits(n):
                # returns list of digits from most significant to least
                if n == 0:
                    return [0]
                digs = []
                while n > 0:
                    digs.append(n % 7)
                    n //= 7
                return digs[::-1]
            
            def delete_digit_at_position(digits, pos):
                # digits list, pos index from 0 (most) to len-1 (least)
                new = digits[:pos] + digits[pos+1:]
                # interpret as base-7 number (if empty, treat as 0)
                if not new:
                    return 0
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
            def condition1(n):
                digs = base7_digits(n)
                m = len(digs)-1
                # sum over i=0..m (i.e., all positions)
                total = sum(delete_digit_at_position(digs, i) for i in range(len(digs)))
                return total == n
            
            def count_up_to(limit):
                cnt = 0
                sols = []
                for n in range(1, limit+1):
                    if condition1(n):
                        cnt += 1
                        sols.append(n)
                return cnt, sols
            
