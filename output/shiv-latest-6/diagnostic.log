            def min_distance_to_code(v):
                # v is list or array of 0/1 length n
                # Solve MILP: minimize sum_i d_i where d_i = v_i XOR w_i, w binary, H w = 0 (mod 2)
                # Use linear objective: minimize sum_i ( (1-2*v_i) * w_i ) + const
                const = np.sum(v)  # sum v_i
                coeff = 1 - 2*np.array(v)  # +1 if v_i=0, -1 if v_i=1
                # Variables: w_i (binary), z_r (integer >=0)
