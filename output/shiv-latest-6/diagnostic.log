            import numpy as np
            
            def rank_mod2(mat):
                # Gaussian elimination over GF(2)
                A = mat.copy()
                rows, cols = A.shape
                r = 0
                for c in range(cols):
                    # find pivot
                    pivot = None
                    for i in range(r, rows):
                        if A[i,c] == 1:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap
                    if pivot != r:
                        A[[r, pivot]] = A[[pivot, r]]
                    # eliminate
                    for i in range(rows):
                        if i != r and A[i,c] == 1:
                            A[i] ^= A[r]
                    r += 1
                    if r == rows:
                        break
                return r
            
            def operation_matrix(n):
                ops = []
                for i in range(n):
                    for j in range(n):
                        vec = np.zeros(n*n, dtype=np.uint8)
                        # row i
                        for col in range(n):
                            idx = i*n + col
                            vec[idx] ^= 1
                        # column j except (i,j)
                        for row in range(n):
                            if row == i: continue
                            idx = row*n + j
                            vec[idx] ^= 1
                        ops.append(vec)
                return np.array(ops, dtype=np.uint8)
            
