            def find_solutions_by_m(m):
                # m is index of most significant digit, so length = m+1
                # compute coefficients C_j
                C = [0]*(m+1)
                C[0] = 2 - m
                for j in range(1,m):
                    C[j] = (6*j - 7*(m-2)) * (7**(j-1))
                C[m] = (7 - m) * (7**(m-1))
                solutions = []
                # recursion over digits from most significant to least
                # leading digit cannot be zero
                # We'll use depth-first search with pruning based on possible min/max contributions of remaining positions.
                # Precompute for each position the max possible contribution (abs) if digit is 6.
                max_contrib = [6*abs(C[j]) for j in range(m+1)]
                # also compute suffix max sum
                suffix_max = [0]*(m+2)
                for j in range(m, -1, -1):
                    suffix_max[j] = suffix_max[j+1] + max_contrib[j]
                # recursion
                def dfs(pos, current_sum, digits):
