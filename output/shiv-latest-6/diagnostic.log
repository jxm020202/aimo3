            # lengths squared
            lenPX2 = PX[0]**2 + PX[1]**2
            lenPY2 = PY[0]**2 + PY[1]**2
            lenPZ2 = PZ[0]**2 + PZ[1]**2
            
            # angle condition: dot = -1/2 * sqrt(len1*len2)
            eq1 = dot(PX, PY) + sp.Rational(1,2)*sp.sqrt(lenPX2*lenPY2)
