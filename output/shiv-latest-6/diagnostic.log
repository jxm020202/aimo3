            def max_black_bruteforce(V):
                n=V.shape[0]
                best=0
                for r_int in range(1<<n):
                    r=np.array([(r_int>>i)&1 for i in range(n)], dtype=np.uint8)
                    xor_r=V ^ r[:,None]
                    col0=xor_r.sum(axis=0)
                    col1=(xor_r^1).sum(axis=0)
                    total=np.maximum(col0,col1).sum()
                    best=max(best,total)
                return best
            
