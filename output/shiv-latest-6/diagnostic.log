            import numpy as np, random, math
            
            def random_tetra_on_sphere():
                # ensure not degenerate
                while True:
                    verts = random_vertices()
                    # check not coplanar: volume not near zero
                    a,b,c,d = verts
                    vol = np.dot(np.cross(b-a, c-a), d-a)
                    if abs(vol) > 1e-3:
                        return verts
            
            def orthocenter_numeric(a):
                # Solve intersection of lines: each line passes through a_i with direction n_i (normal to opposite face)
                # Find point H that lies on all lines: a_i + t_i n_i = H
                # So H - a_i is parallel to n_i. Means cross product zero? Simpler: solve linear system using least squares for H satisfying (H - a_i)·v = 0 for any v in opposite face.
                # Equivalent to (H - a_i) orthogonal to plane => (H - a_i)·n_i = 0 and also (H - a_i) is parallel to n_i? Actually line direction is n_i, so H lies on line: H = a_i + s_i n_i for some scalar s_i.
                # So we can solve for H using two such lines, e.g., i=1,2.
                n = []
                for i in range(4):
                    others = [j for j in range(4) if j!=i]
                    v1 = a[others[0]] - a[others[1]]
                    v2 = a[others[0]] - a[others[2]]
                    n_i = np.cross(v1, v2)
                    n.append(n_i)
                # Solve for H using least squares: find H that minimizes sum_i ||(H - a_i) - proj onto n_i? Actually we need H such that (H - a_i) is parallel to n_i, i.e., cross product zero => (H - a_i) × n_i = 0 => there exists scalar s_i with H - a_i = s_i n_i.
                # This gives 3 equations per i (components) but only rank 1 per i. Use linear equations: H = a_i + s_i n_i.
                # Unknowns: H (3) and s_i (4). 7 unknowns, 12 equations (3 per i). Solve linear system.
                A = []
                b = []
                # variables order: Hx,Hy,Hz, s0,s1,s2,s3
                for i in range(4):
                    rowx = [1,0,0] + [0]*4
                    rowy = [0,1,0] + [0]*4
                    rowz = [0,0,1] + [0]*4
                    # H - a_i - s_i n_i = 0
                    # So H - s_i n_i = a_i
                    # Write as H + (-n_i)*s_i = a_i
                    # We'll add three equations:
                    A.append(rowx[:3] + [ -n[i][0] if j==i else 0 for j in range(4) ])
                    b.append(a[i][0])
                    A.append(rowy[:3] + [ -n[i][1] if j==i else 0 for j in range(4) ])
                    b.append(a[i][1])
                    A.append(rowz[:3] + [ -n[i][2] if j==i else 0 for j in range(4) ])
                    b.append(a[i][2])
                A = np.array(A, dtype=float)
                b = np.array(b, dtype=float)
                # solve least squares
                sol, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)
                H = sol[:3]
                return H
            
            def foot_of_altitude(a1, others):
                # plane through others points
                p0, p1, p2 = others
                normal = np.cross(p1-p0, p2-p0)
                # line through a1 with direction normal
                # foot X is intersection of line a1 + t*normal with plane
                # plane equation: (x-p0)·normal = 0
                t = -np.dot(a1 - p0, normal) / np.dot(normal, normal)
                X = a1 + t*normal
                return X
            
            def compute_ratio():
                a = random_tetra_on_sphere()
                H = orthocenter_numeric(a)
                a1 = a[0]
                others = a[1:]
                X = foot_of_altitude(a1, others)
                # find Y second intersection of line a1->H with sphere radius 1
                dir_vec = H - a1
                # param a1 + t*dir, t=0 at a1. Need |a1 + t*dir| = 1
                # Solve quadratic for t
                A = np.dot(dir_vec, dir_vec)
                B = 2*np.dot(a1, dir_vec)
                C = np.dot(a1, a1) - 1.0
                # solutions t=0 and t=t2
                disc = B*B - 4*A*C
                t2 = (-B - math.sqrt(disc)) / (2*A)  # one solution is 0; choose other
                # verify which is zero
                if abs(t2) < 1e-6:
                    t2 = (-B + math.sqrt(disc)) / (2*A)
                Y = a1 + t2*dir_vec
                KX = np.linalg.norm(H - X)
                KY = np.linalg.norm(H - Y)
                return KX/KY
            
            ratios = [compute_ratio() for _ in range(10)]
            ratios
