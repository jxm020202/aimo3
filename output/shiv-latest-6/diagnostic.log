            def linear_solutions(n, max_val=10):
                sols=[]
                for p in [1,-1]:
                    for q in [1,-1]:
                        # compute min value across grid for a given a
                        # values = a + p*i + q*j
                        # we need all >=0, so a >= -min(p*i+q*j)
                        mins = min(p*i + q*j for i in range(n) for j in range(n))
                        # a must be >= -mins
                        for a in range(-mins, max_val+1):
                            grid=[[a + p*i + q*j for j in range(n)] for i in range(n)]
                            if all(v>=0 and v<=max_val for row in grid for v in row):
                                sols.append(grid)
                return sols
            
