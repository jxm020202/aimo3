            def base7_digits(x):
                if x==0:
                    return [0]
                digs=[]
                while x>0:
                    digs.append(x%7)
                    x//=7
                return digs[::-1]  # most significant first
            
            def remove_digit_from_number(num, digit):
                # num given as integer, we treat its base7 representation string, remove all occurrences of digit? or first occurrence?
                # We'll try removing all occurrences.
                digs=base7_digits(num)
                new=[d for d in digs if d!=digit]
                if not new:
                    return 0
                # convert back
                val=0
                for d in new:
                    val=val*7+d
                return val
            
            def condition(n):
                # get base7 digits of n
                digs=base7_digits(n)
                m=len(digs)-1
                if m<=0:
                    return False
                # representation of m in base7
                # compute a_i for i=0..m-1 using b_i (digit at position i from least significant? they defined b_m ... b_0)
                # b_i is digit at position i from least significant (since they wrote b_m ... b_0)
                # So we need list reversed.
                rev=digs[::-1]  # b_0 ... b_m
                total=0
                for i in range(m):
                    bi=rev[i]
                    a_i=remove_digit_from_number(m, bi)
                    total+=a_i
                return total==n
            
            def brute(limit):
                res=[]
