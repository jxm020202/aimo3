            def min_moves(N):
                # initial state: bits list 0=heads,1=tails; pattern T,H,T,H...
                init = tuple(1 if i%2==0 else 0 for i in range(N))  # 0-index: position 0 tails (1)
                target = tuple(0 for _ in range(N))
                # BFS over (state, last_pos) where last_pos is index of last flipped coin (or None for first move)
                # We'll treat first move can be any coin, so we start with each possible first flip.
                visited = set()
                q = deque()
                # initial moves: flip each coin i
                for i in range(N):
                    s = list(init)
                    s[i] ^= 1
                    state = tuple(s)
                    key = (state, i)
                    visited.add(key)
                    q.append((state, i, 1))
