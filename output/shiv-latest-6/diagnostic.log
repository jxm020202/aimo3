            Q1 = M1 + w*h1
            Q2 = M1 - w*h1
            S1 = M2 + wprime*h2
            S2 = M2 - wprime*h2
            
            # distances squared for combos
            def dist2(p,q):
                return sp.simplify(((p-q).dot(p-q)))
            
