                    F = line_intersection(C,D,A,E)
                return F
            
            def circumcenter(A,B,C):
                # using perpendicular bisectors
                # formula using complex numbers
                # convert to coordinates
                ax, ay = A.real, A.imag
                bx, by = B.real, B.imag
                cx, cy = C.real, C.imag
                d = 2*(ax*(by-cy) + bx*(cy-ay) + cx*(ay-by))
                if abs(d) < 1e-12:
                    return None
                ux = ((ax**2+ay**2)*(by-cy) + (bx**2+by**2)*(cy-ay) + (cx**2+cy**2)*(ay-by))/d
                uy = ((ax**2+ay**2)*(cx-bx) + (bx**2+by**2)*(ax-cx) + (cx**2+cy**2)*(bx-ax))/d
                return complex(ux, uy)
            
            def orthocenter(A,B,C):
                # intersection of altitudes
                # using formula: H = A + B + C - 2*O where O is circumcenter? Actually Euler line: O,G,H collinear with OG:GH = 1:2, and G = (A+B+C)/3.
                # So H = 3G - 2O = A+B+C - 2O
                O = circumcenter(A,B,C)
                if O is None:
                    return None
                G = (A+B+C)/3
                H = 3*G - 2*O
                return H
            
