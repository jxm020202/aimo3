            size=19
            def vec_allones():
                return [1]*(size*size)
            def in_span(target, basis):
                # Gaussian elimination to see if target in span of basis
                # Build matrix with basis rows, then augment with target, see if consistent.
                m = len(basis)
                n = len(basis[0])
                A = [row[:] for row in basis]
                b = target[:]
                # Perform elimination on augmented matrix
                rank = 0
                for col in range(n):
                    # find pivot row
                    pivot = None
                    for r in range(rank, m):
                        if A[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[rank], A[pivot] = A[pivot], A[rank]
                    b[rank], b[pivot] = b[pivot], b[rank]
                    # eliminate other rows
                    for r in range(m):
                        if r != rank and A[r][col]:
                            A[r] = [(a ^ c) for a,c in zip(A[r], A[rank])]
                            b[r] ^= b[rank]
                    rank += 1
                # after elimination, check consistency for rows with all zero in A
                for r in range(rank, m):
                    if all(v==0 for v in A[r]) and b[r]==1:
                        return False
                return True
            
            ops = []
            for r in range(size):
                for c in range(size):
                    vec = [0]*(size*size)
                    for j in range(size):
                        vec[r*size + j] = 1
                    for i in range(size):
                        vec[i*size + c] = 1
                    ops.append(vec)
            print(in_span(vec_allones(), ops))
            
