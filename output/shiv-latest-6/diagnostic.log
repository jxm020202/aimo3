            def pattern_n(n, base=0):
                arr = np.zeros((n,n), dtype=int)
                for i in range(n):
                    for j in range(n):
                        d = min(i, j, n-1-i, n-1-j)
                        arr[i,j] = base + i + j - 2*d
                return arr
            
            def check(arr):
                n = arr.shape[0]
                for i in range(n):
                    for j in range(n):
                        if i+1<n and abs(arr[i,j]-arr[i+1,j])!=1:
                            return False
                        if j+1<n and abs(arr[i,j]-arr[i,j+1])!=1:
                            return False
                return True
            
