            import itertools, math, sympy as sp, sys, random, time, collections, math, itertools, sympy
            def find_solutions(deg_f, deg_g, coeff_range):
                x=sp.Symbol('x')
                # unknown coefficients for f: a_deg x^deg + ... + a0
                coeffs_f = [sp.Symbol(f'a{i}') for i in range(deg_f+1)]
                coeffs_g = [sp.Symbol(f'b{i}') for i in range(deg_g+1)]
                f = sum(coeffs_f[i]*x**i for i in range(deg_f+1))
                g = sum(coeffs_g[i]*x**i for i in range(deg_g+1))
                expr = sp.expand(f.subs(x,g) - 3*g.subs(x,f))
                # expr must be constant k
                # collect coefficients
                poly = sp.Poly(expr, x)
                coeff_dict = poly.as_dict()
                # degree terms
                equations = []
                for mon, coeff in coeff_dict.items():
                    power = mon[0]
                    if power == 0:
                        k = coeff
                    else:
                        equations.append(sp.Eq(coeff, 0))
                # solve integer solutions within range brute force
                sols=[]
                # leading coeff constraints
                lead_f = coeffs_f[deg_f]
                lead_g = coeffs_g[deg_g]
                for vals in itertools.product(range(-coeff_range, coeff_range+1), repeat=len(coeffs_f)+len(coeffs_g)):
                    # assign
                    assign = {}
                    for i, sym in enumerate(coeffs_f):
                        assign[sym]=vals[i]
                    for i, sym in enumerate(coeffs_g):
                        assign[sym]=vals[len(coeffs_f)+i]
                    # leading coeff constraints
                    if assign[lead_f]==0 or assign[lead_g]==0:
                        continue
                    # evaluate equations
                    ok=True
                    for eq in equations:
                        if eq.subs(assign)!=True:
                            ok=False
                            break
                    if ok:
                        k_val = sp.expand(expr.subs(assign)).subs(x,0) # constant term
                        if k_val!=0:
                            sols.append((assign,k_val))
                            # break early
                            #return sols
                return sols
            
