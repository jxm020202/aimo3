            def min_sum_residues(N):
                # N odd, start/end distinct odd vertices (1 and N)
                # r1 fixed =1, r_{N-1}=1
                # DP over edges index i from 1..N-1
                # We'll store dict of possible r_i values with minimal cumulative sum up to i.
                # Initialize for i=1
                dp = {1:1}  # key r_i, value sum up to i (including r_i)
                # Process vertices v=2..N-1
                for v in range(2, N):
                    # constraint at vertex v: (r_{v-1}+r_v) mod4 = target
                    target = 2 if (v%2==1) else 0  # odd vertex ->2, even ->0
                    newdp={}
                    for prev_r, cum in dp.items():
                        # find r_v in 0..3 satisfying (prev_r + r_v) %4 == target
                        needed = (target - prev_r) %4
                        # possible r_v = needed + 4k, but residues limited 0..3, so only one option
                        r = needed
                        newcum = cum + r
                        # keep minimal for each r
