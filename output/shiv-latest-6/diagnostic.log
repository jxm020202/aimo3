            import random, math
            def compute_P_fermat(a,b):
                # compute Fermat point numerically using sympy nsolve for given triangle
                X = sp.Point(a,b)
                Y = sp.Point(0,0)
                Z = sp.Point(1,0)
                px, py = sp.symbols('px py', real=True)
                P = sp.Point(px, py)
                # angle conditions
                def dot(u,v):
                    return u[0]*v[0]+u[1]*v[1]
                def vec(P1,P2):
                    return (P2.x-P1.x, P2.y-P1.y)
                PX = vec(P,X)
                PY = vec(P,Y)
                PZ = vec(P,Z)
                lenPX2 = PX[0]**2+PX[1]**2
                lenPY2 = PY[0]**2+PY[1]**2
                lenPZ2 = PZ[0]**2+PZ[1]**2
                eq1 = dot(PX,PY)+sp.Rational(1,2)*sp.sqrt(lenPX2*lenPY2)
                eq2 = dot(PY,PZ)+sp.Rational(1,2)*sp.sqrt(lenPY2*lenPZ2)
                # initial guess maybe centroid
                guess = [ (a+0+1)/3, b/3 ]
                sol = sp.nsolve([eq1,eq2],[px,py],guess, tol=1e-14, maxsteps=100, prec=50)
                return float(sol[0]), float(sol[1])
            
