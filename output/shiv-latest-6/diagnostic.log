            def gf2_rank(matrix):
                # matrix: list of ints representing rows (bits)
                rows = matrix[:]
                n = len(rows)
                m = max(rows).bit_length() if rows else 0
                rank = 0
                col = 0
                while col < m and rank < n:
                    # find pivot row with bit col set
                    pivot = None
                    for i in range(rank, n):
                        if (rows[i] >> col) & 1:
                            pivot = i
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap pivot row to current rank
                    rows[rank], rows[pivot] = rows[pivot], rows[rank]
                    # eliminate other rows
                    for i in range(n):
                        if i != rank and ((rows[i] >> col) & 1):
                            rows[i] ^= rows[rank]
                    rank += 1
                    col += 1
                return rank
            
            # Build rows as ints
            def moves_int():
                n = 19
