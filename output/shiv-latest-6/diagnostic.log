            def fermat_point(A,B,C):
                # using rotation method as above
                # A,B,C are sympy Points
                # rotate C around A by +60, line through B and C' intersect line through C and A' (A' rotated around B -60)
                cos60=sp.Rational(1,2)
                sin60=sp.sqrt(3)/2
                R60=sp.Matrix([[cos60, -sin60],[sin60, cos60]])
                Rm60=sp.Matrix([[cos60, sin60],[-sin60, cos60]])
                Cprime = sp.Point(A.x + (R60*sp.Matrix([C.x-A.x, C.y-A.y]))[0],
                                  A.y + (R60*sp.Matrix([C.x-A.x, C.y-A.y]))[1])
                Aprime = sp.Point(B.x + (Rm60*sp.Matrix([A.x-B.x, A.y-B.y]))[0],
                                  B.y + (Rm60*sp.Matrix([A.x-B.x, A.y-B.y]))[1])
                # intersection
                line1 = sp.Line(B, Cprime)
                line2 = sp.Line(C, Aprime)
                P = line1.intersection(line2)[0]
                return P
            
            def nine_point_center(A,B,C):
                # circumcenter O
                O = sp.geometry.Triangle(A,B,C).circumcenter
                # orthocenter H
                H = sp.geometry.Triangle(A,B,C).orthocenter
                N = sp.Point((O.x+H.x)/2, (O.y+H.y)/2)
                return N
            
            def angle_at_B(A,B,C):
                # angle ABC
                BA = sp.Matrix([A.x-B.x, A.y-B.y])
                BC = sp.Matrix([C.x-B.x, C.y-B.y])
                dot = BA.dot(BC)
                cross = BA[0]*BC[1]-BA[1]*BC[0]
                ang = sp.atan2(abs(cross), dot)
                return sp.N(ang*180/sp.pi)
            
            def test_random():
                for _ in range(200):
                    # random acute triangle
                    # choose points random
                    A = sp.Point(random.random()*2-1, random.random()*2-0.5)
                    B = sp.Point(0,0)
                    C = sp.Point(1,0)
                    # ensure acute: all angles <90
                    # compute angles
                    tri = sp.geometry.Triangle(A,B,C)
                    angles = [float(tri.angles[tri.vertices[i]]) for i in range(3)]
                    if max(angles) >= math.pi/2:
                        continue
                    # scalene: sides not equal
                    sides = [float(tri.sides[i]) for i in range(3)]
                    if len(set(round(s,6) for s in sides))<3:
