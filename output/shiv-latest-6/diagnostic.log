                coeffs_g = [sp.Symbol(f'b{i}') for i in range(deg_g+1)]
                f = sum(coeffs_f[i]*x**i for i in range(deg_f+1))
                g = sum(coeffs_g[i]*x**i for i in range(deg_g+1))
