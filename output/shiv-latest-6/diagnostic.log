            from scipy.optimize import milp, LinearConstraint, Bounds
            def max_black_for_A(A):
                n = len(A)
                m = len(basis)  # 36
                # variables: x (n binary), y (m integer, unrestricted but can be >=0 maybe)
                # We'll treat y as integer unrestricted (can be negative). Use bounds (-inf, inf)
                # but milp requires bounds; we can set large bounds.
                total_vars = n + m
                # Objective: maximize sum of x_i => c = [1]*n + [0]*m (since we minimize by default? milp solves minimization)
                # milp solves minimization; we can set c = -objective to maximize.
                c = np.concatenate((-np.ones(n), np.zeros(m)))  # minimize -sum x => maximize sum x
                # Constraints: A_eq x - 2 y = b (mod 2). We'll implement as equality constraints over integers.
                # Build matrix for equality: for each k row: sum_i w_k[i]*x_i - 2*y_k = b_k
                A_eq = np.zeros((m, total_vars), dtype=int)
                for k, w in enumerate(basis):
                    A_eq[k, :n] = w
                    A_eq[k, n + k] = -2
                b_vec = np.array([sum(wi*ai for wi, ai in zip(basis[k], A)) % 2 for k in range(m)], dtype=int)
                # Use LinearConstraint with lb=ub=b_vec
                lincon = LinearConstraint(A_eq, b_vec, b_vec)
                # bounds: x in [0,1] integer, y in some range say [-n, n]
                lb = np.concatenate((np.zeros(n), -n*np.ones(m)))
                ub = np.concatenate((np.ones(n), n*np.ones(m)))
                bounds = Bounds(lb, ub)
                integrality = np.concatenate((np.ones(n), np.ones(m)))  # all integer
                res = milp(c=c, constraints=[lincon], bounds=bounds, integrality=integrality, options={"disp": False})
                if not res.success:
                    print("MILP failed")
                    return None
                x_opt = np.round(res.x[:n])
                return int(x_opt.sum())
            
