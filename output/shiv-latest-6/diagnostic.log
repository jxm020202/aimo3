            import sympy as sp
            
            def has_permutation(m):
                divs = sorted(sp.divisors(m))
                n = len(divs)
                sigma = sum(divs)
                # need sequence of squares ending sigma with n steps.
                # brute force permutations maybe too many. Instead backtrack constructing squares.
                squares = [i*i for i in range(int(sigma**0.5)+2)]
                # we need increasing squares list length n ending sigma.
                # Use backtracking: choose next square > current such that diff is unused divisor.
                target = sigma
                div_set = set(divs)
                # recursion
                from functools import lru_cache
                
                @lru_cache(None)
                def dfs(current_sum, used_mask):
                    # current_sum is last square value
                    if used_mask == (1<<n)-1:
                        return current_sum == target
                    # try next square larger than current_sum
                    # compute remaining sum needed = target - current_sum
                    # next square must be <= target
                    for next_sq in squares:
                        if next_sq <= current_sum: continue
                        diff = next_sq - current_sum
                        # find index of diff in divs not used
                        if diff in div_set:
                            idx = divs.index(diff)  # O(n) but fine
                            if not (used_mask>>idx &1):
                                if dfs(next_sq, used_mask | (1<<idx)):
                                    return True
                    return False
                # start from 0 square
                return dfs(0,0)
            
            def find_ms(limit):
                res=[]
                for m in range(2,limit+1):
                    if has_permutation(m):
                        res.append(m)
                return res
            
            print(find_ms(200))
            
