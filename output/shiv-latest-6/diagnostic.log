            def compute_P(beta_val, b_val):
                # compute coordinates
                X = np.array([b_val*math.cos(beta_val), b_val*math.sin(beta_val)])
                Y = np.array([0.0, 0.0])
                Z = np.array([1.0, 0.0])
                # side lengths
                a = 1.0  # YZ
                c = b_val  # XY
                b = np.linalg.norm(X - Z)  # XZ
                # angles
                # angle at Y is beta_val
                # compute angle at X using law of cosines
                # avoid domain errors
                cos_alpha = (b**2 + c**2 - a**2) / (2 * b * c)
                # clamp
                cos_alpha = max(min(cos_alpha, 1), -1)
                alpha = math.acos(cos_alpha)
                gamma = math.pi - alpha - beta_val
                # barycentric weights for Fermat point
                wX = 1.0 / math.sin(alpha + math.pi/3)
                wY = 1.0 / math.sin(beta_val + math.pi/3)
                wZ = 1.0 / math.sin(gamma + math.pi/3)
                # point P
                P = (wX * X + wY * Y + wZ * Z) / (wX + wY + wZ)
                return X, Y, Z, P
            
            def collinearity_condition(beta_val, b_val):
                X, Y, Z, P = compute_P(beta_val, b_val)
                Q = (X + Z) / 2.0  # since Y=0
                # cross product Z component (2D)
                cross = P[0]*Q[1] - P[1]*Q[0]
                return cross
            
            # Let's try scanning beta values and find b that makes cross zero via root find.
            def find_b_for_beta(beta_val, b_guess=1.0):
                # Use root finding for function f(b) = cross
                import mpmath as mp
                f = lambda b: collinearity_condition(beta_val, b)
                try:
                    root = mp.findroot(f, b_guess)
                    return float(root)
                except Exception as e:
