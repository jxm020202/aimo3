            def rank_mod2(matrix):
                # matrix as list of list of ints 0/1, shape m x n (m rows)
                m = len(matrix)
                n = len(matrix[0]) if m else 0
                A = [row[:] for row in matrix]
                rank = 0
                col = 0
                for col in range(n):
                    # find pivot row >= rank with A[row][col]==1
                    pivot = None
                    for r in range(rank, m):
                        if A[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[rank], A[pivot] = A[pivot], A[rank]
                    # eliminate other rows
                    for r in range(m):
                        if r != rank and A[r][col]:
                            # row r = row r xor row rank
                            A[r] = [(a ^ b) for a,b in zip(A[r], A[rank])]
                    rank += 1
                return rank
            
