            def find_caseB(limit_a):
                sols=[]
                for a in range(1, limit_a+1):
                    N = 12*a**4 - 6*a**2 + 1
                    # find square divisors b^2 of N
                    # factor N
                    fac = sp.factorint(N)
                    # generate all possible b from exponents floor(exp/2)
                    # we need b^2 dividing N, so b = product p^{e} where e <= floor(exp/2)
                    # generate all possible b values via recursion
                    primes = list(fac.keys())
                    exps = [fac[p] for p in primes]
                    # generate list of possible b^2 values
                    # We'll generate b values directly
                    def rec(idx, current):
                        if idx == len(primes):
                            b = current
                            b2 = b*b
                            if N % b2 == 0:
                                p = N // b2
                                if sp.isprime(p) and p % 8 == 5:
