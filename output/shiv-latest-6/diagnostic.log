            def invariants(board, n):
                # board: list of 0/1 length n*n
                # compute row sums parity and column sums parity
                rows = [0]*n
                cols = [0]*n
                for i in range(n):
                    for j in range(n):
                        val = board[i*n + j]
                        rows[i] ^= val  # parity
                        cols[j] ^= val
                # compute differences relative to row0 and col0
                d = tuple(rows[i] ^ rows[0] for i in range(1,n))
                e = tuple(cols[j] ^ cols[0] for j in range(1,n))
                # also include maybe overall parity? Not needed because complement yields same differences.
                return (d,e)
            
            def max_black_per_coset(n):
                N=n*n
                # map from invariants to max weight
                max_weight = {}
                for mask in range(1<<N):
                    board = [(mask>>k)&1 for k in range(N)]
                    inv = invariants(board,n)
                    w = sum(board)
                    # also consider complement; but complement will have same invariants, weight = N-w
                    # max weight in coset is max(w, N-w)
                    cur = max_weight.get(inv, -1)
                    # we can store max of max(w,N-w) across all boards in coset
                    best = max(w, N-w)
                    if best > cur:
                        max_weight[inv] = best
                # now compute minimal of these maxes
                min_of_max = min(max_weight.values())
                return min_of_max, max_weight
            
            for n in [3,5,7]:
