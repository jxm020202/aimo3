            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def min_weight_for_syndrome(n, syndrome):
                # syndrome: binary vector length 2n-2
                N = n*n
                r = 2*n-2
                # Build H matrix as before
                H_rows = []
                # row differences
                for i in range(n-1):
                    row_vec = np.zeros(N, dtype=np.int8)
                    for j in range(n):
                        row_vec[i*n + j] ^= 1
                        row_vec[(i+1)*n + j] ^= 1
                    H_rows.append(row_vec)
                # column differences
                for j in range(n-1):
                    row_vec = np.zeros(N, dtype=np.int8)
                    for i in range(n):
                        row_vec[i*n + j] ^= 1
                        row_vec[i*n + (j+1)] ^= 1
                    H_rows.append(row_vec)
                H = np.array(H_rows, dtype=np.int8)  # shape (r, N)
                # Variables: e (N binary), y (r integer)
                # We'll combine into one vector of length N + r
                # Objective: minimize sum(e)
                c = np.concatenate([np.ones(N), np.zeros(r)])  # minimize sum of e
                # Constraints: H e - 2 y = syndrome
                # Represent as A_eq x = b
                # A_eq = [H | -2*I_r] (size r x (N+r))
                A_eq = np.concatenate([H, -2*np.eye(r, dtype=np.int8)], axis=1)
                lb = np.zeros(N+r)
                ub = np.concatenate([np.ones(N), np.full(r, np.inf)])  # e in [0,1], y >=0 unbounded above
                # integrality: e binary (0/1), y integer (but we can treat as integer)
                integrality = np.concatenate([np.ones(N), np.ones(r)])  # all integer
                # bounds for e: 0 <= e <= 1
                bounds = Bounds(lb, ub)
                # Use milp
                res = milp(c=c, constraints=LinearConstraint(A_eq, syndrome, syndrome), bounds=bounds,
                           integrality=integrality, options={'disp': False})
                if not res.success:
                    raise RuntimeError("MILP failed")
                e = np.round(res.x[:N])
                weight = int(np.sum(e))
                return weight
            
            def covering_radius_n(n):
                # enumerate all syndromes (2^{2n-2}) and compute min weight
                r = 2*n-2
                max_min_weight = 0
                for s_int in range(1<<r):
                    s = np.array([(s_int>>i)&1 for i in range(r)], dtype=np.int8)
                    w = min_weight_for_syndrome(n, s)
                    if w > max_min_weight:
                        max_min_weight = w
                return max_min_weight
            
