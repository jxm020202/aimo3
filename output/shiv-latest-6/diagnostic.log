            def count_roots_B(B):
                # count distinct roots of h(A)=0 in (0, pi-B) besides symmetric
                S = math.pi - B
                def h(A):
                    C = S - A
                    return (math.cos(A)*math.sin(A+math.pi/3) - math.cos(C)*math.sin(C+math.pi/3))
                # sample fine grid
                N=2000
                As = np.linspace(1e-6, S-1e-6, N)
                vals = [h(a) for a in As]
                roots = []
                for i in range(N-1):
                    if vals[i]==0: continue
                    if vals[i]*vals[i+1] < 0:
                        # approximate root via linear interpolation
                        a1,a2 = As[i], As[i+1]
                        v1,v2 = vals[i], vals[i+1]
                        root = a1 - v1*(a2-a1)/(v2-v1)
                        roots.append(root)
                # include symmetric root
                sym = S/2
                # count distinct away from sym
                distinct = [r for r in roots if abs(r - sym) > 1e-3]
                return len(distinct), sym, roots
            
