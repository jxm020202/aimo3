            def bipartite_havel_hakimi(left, right):
                # left and right are lists of degrees
                left = sorted(left, reverse=True)
                right = sorted(right, reverse=True)
                nL = len(left)
                nR = len(right)
                # adjacency matrix as set of edges
                edges = set()
                while left and left[0]>0:
                    d = left[0]
                    left = left[1:]
                    if d > len(right):
                        return None
                    # connect to first d vertices in right
                    for i in range(d):
                        right[i] -= 1
                        if right[i] < 0:
                            return None
                        edges.add((len(left), i))  # placeholder indices not important
                    # re-sort right
                    right.sort(reverse=True)
                    left.sort(reverse=True)
                # check all right degrees zero
                if any(right):
                    return None
                return edges
            
