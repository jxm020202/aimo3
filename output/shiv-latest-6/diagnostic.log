            def good_residual(D, A, B, C):
                # D is tuple
                D = np.array(D, dtype=float)
                A = np.array(A, dtype=float)
                B = np.array(B, dtype=float)
                C = np.array(C, dtype=float)
                # radius = distance D-A
                r = np.linalg.norm(D - A)
                # intersect circle centered D radius r with line AB: solve for second intersection besides A
                def second_intersection(P, Q, center, radius):
                    # line through P,Q param P + t*(Q-P)
                    P = np.array(P); Q = np.array(Q); Cc = np.array(center)
                    v = Q - P
                    # solve |P + t v - Cc|^2 = radius^2
                    a = np.dot(v, v)
                    b = 2*np.dot(v, P - Cc)
                    c = np.dot(P - Cc, P - Cc) - radius**2
                    # quadratic a t^2 + b t + c =0. One solution t=0 corresponds to P if P on circle (should be A etc)
                    disc = b*b - 4*a*c
                    if disc < 0:
                        return None
                    t1 = (-b + math.sqrt(disc)) / (2*a)
                    t2 = (-b - math.sqrt(disc)) / (2*a)
                    # choose t not close to 0 (since P is on circle)
                    t = t1 if abs(t1) > 1e-8 else t2
                    return P + t*v
                A_b = second_intersection(A, B, D, r)
                A_c = second_intersection(A, C, D, r)
                # similarly for B point: circle centered D passing through B (radius DB)
                rB = np.linalg.norm(D - B)
                B_a = second_intersection(B, A, D, rB)
                B_c = second_intersection(B, C, D, rB)
                rC = np.linalg.norm(D - C)
                C_a = second_intersection(C, A, D, rC)
                C_b = second_intersection(C, B, D, rC)
                pts = [A_b, A_c, B_a, B_c, C_a, C_b]
                # compute circumcircle of first three non-collinear points
                # use sympy circle from three points
                try:
                    circ = sp.Circle(sp.Point(*pts[0]), sp.Point(*pts[1]), sp.Point(*pts[2]))
                except Exception as e:
                    return None
                center = np.array([float(circ.center.x), float(circ.center.y)])
                rad = float(circ.radius)
                # compute max deviation of distances
                dev = max(abs(np.linalg.norm(p - center) - rad) for p in pts)
                return dev
            
