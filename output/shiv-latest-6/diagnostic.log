            import numpy as np
            from math import sin, cos, pi, sqrt
            
            def residuals(vars):
                R, A, B = vars
                C = pi - A - B
                # lengths
                d_len = 3.0
                e_len = 2*R*cos(B)
                f_len = 2*R*cos(C)
                # vectors
                e_vec = np.array([e_len, 0.0])
                theta = pi - B
                f_vec = np.array([f_len*cos(theta), f_len*sin(theta)])
                # d vector perpendicular to f-e
                fe = f_vec - e_vec
                perp_fe = np.array([-fe[1], fe[0]])
                lam = d_len / np.linalg.norm(perp_fe)
                d_vec = lam * perp_fe
                # circumcenter C_vec solving linear system
                # equations: C·(e-d) = (|e|^2 - |d|^2)/2, C·(f-d) = (|f|^2 - |d|^2)/2
                A_mat = np.column_stack((e_vec - d_vec, f_vec - d_vec))  # 2x2 matrix columns are vectors
                b_vec = np.array([ (np.dot(e_vec,e_vec) - d_len**2)/2,
                                   (np.dot(f_vec,f_vec) - d_len**2)/2 ])
                # Solve for C (C_vec)
                C_vec = np.linalg.solve(A_mat, b_vec)
                # unit vectors
                e_hat = e_vec / np.linalg.norm(e_vec)
                f_hat = f_vec / np.linalg.norm(f_vec)
                s = np.dot(e_hat, f_hat)
                # solve for a,b
                # a + b*s = sin C
                # a*s + b = sin A
                # solve linear system
                M = np.array([[1, s],[s,1]])
                rhs = np.array([sin(C), sin(A)])
                a,b = np.linalg.solve(M, rhs)
                u_vec = a*e_hat + b*f_hat
                u_vec = u_vec / np.linalg.norm(u_vec)
                # residuals:
                # 1: C·u = -2
                res1 = np.dot(C_vec, u_vec) + 2
                # 2: 2R cos A = 3
                res2 = 2*R*cos(A) - 3
                # 3: R^2 = |C|^2 + 12
                res3 = R**2 - (np.dot(C_vec, C_vec) + 12)
                return np.array([res1, res2, res3])
            
