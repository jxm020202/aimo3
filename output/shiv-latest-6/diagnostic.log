            def is_convex(coords):
                # compute cross product signs for consecutive edges
                n = len(coords)
                signs = []
                for i in range(n):
                    x1,y1 = coords[i]
                    x2,y2 = coords[(i+1)%n]
                    x3,y3 = coords[(i+2)%n]
                    # vectors
                    v1 = (x2-x1, y2-y1)
                    v2 = (x3-x2, y3-y2)
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    signs.append(cross)
                # all cross products should have same sign (non-zero)
                pos = sum(1 for c in signs if c>1e-9)
                neg = sum(1 for c in signs if c<-1e-9)
                return pos==0 or neg==0
            
            is_convex(coords)
            
