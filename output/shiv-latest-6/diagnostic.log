            def signed_angle(p,q):
                # compute signed angle from p to q, in range (-pi, pi]
                ang1 = math.atan2(p[1], p[0])
                ang2 = math.atan2(q[1], q[0])
                diff = (ang2 - ang1)
                # normalize to (-pi, pi]
                while diff <= -math.pi:
                    diff += 2*math.pi
                while diff > math.pi:
                    diff -= 2*math.pi
                return diff
            
            signed_angles = [signed_angle(S,Q), signed_angle(Q,P1), signed_angle(P1,R_pt), signed_angle(R_pt,T), signed_angle(T,P2), signed_angle(P2,S)]
