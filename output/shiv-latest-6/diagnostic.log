            def nullspace_mod2(matrix):
                # matrix shape (rows, cols)
                M = matrix.copy()
                rows, cols = M.shape
                # row-reduce to RREF
                pivot_cols = []
                r = 0
                for c in range(cols):
                    # find pivot row
                    piv = None
                    for i in range(r, rows):
                        if M[i,c]==1:
