            # compute intersection points directly using line param solving numeric with numpy
            import numpy.linalg as la
            def intersect_line_circle(O, dir_vec, R):
                # solve quadratic a t^2 + b t + c =0
                a = np.dot(dir_vec, dir_vec)
                b = 2*np.dot(O, dir_vec)
                c = np.dot(O, O) - R**2
                disc = b**2 - 4*a*c
                t1 = (-b + math.sqrt(disc))/(2*a)
                t2 = (-b - math.sqrt(disc))/(2*a)
                P1 = O + t1*dir_vec
                P2 = O + t2*dir_vec
                return P1,P2,t1,t2
            
