            def side_line(P1,P2):
                A = P2[1]-P1[1]
                B = P1[0]-P2[0]
                C = -(A*P1[0] + B*P1[1])
                return A,B,C
            
            def signed_distance(P, line):
                A,B,C = line
                return (A*P[0] + B*P[1] + C)/math.hypot(A,B)
            
            def trilinear_ratios(N, X, Y, Z):
                # distances to sides opposite X (YZ), opposite Y (ZX), opposite Z (XY)
                dX = abs(signed_distance(N, side_line(Y,Z)))
                dY = abs(signed_distance(N, side_line(Z,X)))
                dZ = abs(signed_distance(N, side_line(X,Y)))
                return dX,dY,dZ
            
