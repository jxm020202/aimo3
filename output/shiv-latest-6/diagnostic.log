            def possible_sums(n, max_val=10):
                # brute force small n with values limited
                from itertools import product
                cells=n*n
                # generate all assignments with values 0..max_val
                sums=set()
                # use recursion for small n only
                def rec(idx, grid):
                    if idx==cells:
                        # check adjacency
                        ok=True
                        for i in range(n):
                            for j in range(n):
                                v=grid[i][j]
                                if i+1<n and abs(v-grid[i+1][j])!=1: return
                                if j+1<n and abs(v-grid[i][j+1])!=1: return
                        sums.add(sum(grid[i][j] for i in range(n) for j in range(n)))
                        return
                    i=idx//n
                    j=idx%n
                    # possible values based on neighbors
                    # if neighbor above exists, value must be neighbor +/-1
                    # if neighbor left exists, also must satisfy both
                    # we can compute feasible set
                    possible=set(range(max_val+1))
                    if i>0:
                        up=grid[i-1][j]
                        possible={up+1, up-1}.intersection(possible)
                    if j>0:
                        left=grid[i][j-1]
                        possible={left+1, left-1}.intersection(possible)
                    for v in possible:
                        if v<0: continue
                        grid[i][j]=v
                        rec(idx+1, grid)
                grid=[[0]*n for _ in range(n)]
                rec(0, grid)
                return sums
            
