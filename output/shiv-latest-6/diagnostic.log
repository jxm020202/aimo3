        def find_solutions_by_m_correct(m):
    # m is index of most significant digit, length = m+1
    # compute C_j for j=0..m (least to most)
    C = [0]*(m+1)
    C[0] = 2 - m
    for j in range(1,m):
        C[j] = (6*j - 7*(m-2)) * (7**(j-1))
    C[m] = (7 - m) * (7**(m-1))
    # recursion over digits from most significant (j=m) down to least (j=0)
    # We'll build list rev_digits where index j corresponds to b_j.
    solutions = []
    # Precompute max possible contribution from remaining positions (absolute)
    max_contrib = [6*abs(C[j]) for j in range(m+1)]
    suffix_max = [0]*(m+2)
    for j in range(m, -1, -1):
        suffix_max[j] = suffix_max[j+1] + max_contrib[j]
    # recursion
    def dfs(j, current_sum, rev_digits):
        # j is current position index (starting from m down to 0)
        if j < 0:
