            import random, math, itertools, sys, numpy as np
            
            R=4
            C=np.array([2.0,0.0])
            
            def on_circle(theta):
                return C + R*np.array([math.cos(theta), math.sin(theta)])
            
            def dot(a,b):
                return a[0]*b[0]+a[1]*b[1]
            
            def is_orthocenter(D,E,F,O=np.array([0.0,0.0]),tol=1e-6):
                # check O is orthocenter: O lies on altitudes from each vertex
                # altitude from D is line through D and O, must be perpendicular to EF
                if abs(dot(O-D, E-F))>tol: return False
                if abs(dot(O-E, D-F))>tol: return False
                if abs(dot(O-F, D-E))>tol: return False
                return True
            
            def tangent_condition(O,E,F, line_dir, tol=1e-6):
                # line_dir is direction vector of tangent line (through O)
                # condition: line makes equal angles with OE and OF
                # equivalently, absolute value of cross product normalized?
                # angle between line_dir and OE: compute sin of angle via |cross|/(|line||OE|)
                # compare with angle with OF
                a = np.cross(line_dir, E-O)/ (np.linalg.norm(line_dir)*np.linalg.norm(E-O))
                b = np.cross(line_dir, F-O)/ (np.linalg.norm(line_dir)*np.linalg.norm(F-O))
                return abs(abs(a)-abs(b))<tol
            
            def find():
                O=np.array([0.0,0.0])
                # precompute possible D points with distance 3 from O on circle
                thetas=np.linspace(0,2*math.pi,361)
                Ds=[]
                for th in thetas:
                    D=on_circle(th)
                    if abs(np.linalg.norm(D-O)-3)<1e-6:
                        Ds.append((th,D))
                print(len(Ds))
                # sample random E,F
                for _ in range(200000):
                    thE=random.random()*2*math.pi
                    thF=random.random()*2*math.pi
                    E=on_circle(thE)
                    F=on_circle(thF)
                    # compute tangent line at O to circumcircle of O,E,F
                    # we can compute center of circumcircle of O,E,F and get direction perpendicular to radius
                    # circumcenter of triangle OEF:
                    # using perpendicular bisectors
                    A=O; B=E; C=F
                    # compute circumcenter via linear algebra
                    def circumcenter(A,B,C):
                        D = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                        if abs(D)<1e-8: return None
                        Ux = ((np.dot(A,A))*(B[1]-C[1]) + (np.dot(B,B))*(C[1]-A[1]) + (np.dot(C,C))*(A[1]-B[1]))/D
                        Uy = ((np.dot(A,A))*(C[0]-B[0]) + (np.dot(B,B))*(A[0]-C[0]) + (np.dot(C,C))*(B[0]-A[0]))/D
                        return np.array([Ux,Uy])
                    Ocenter=circumcenter(A,B,C)
                    if Ocenter is None: continue
                    # tangent direction is perpendicular to Ocenter - O
                    dir_vec = np.array([-(Ocenter[1]), Ocenter[0]])  # rotate 90 deg
                    # check condition that line through O with dir_vec intersects Ω at distances 2 and 6
                    # compute intersection parameters t where O + t*dir_vec lies on circle centered C radius R
                    # solve |C - t*dir|^2 = R^2
                    a = np.dot(dir_vec, dir_vec)
                    b = -2*np.dot(C, dir_vec)
                    c = np.dot(C,C) - R**2
                    # quadratic a t^2 + b t + c =0
                    disc = b*b - 4*a*c
                    if disc<0: continue
                    t1 = (-b + math.sqrt(disc))/(2*a)
                    t2 = (-b - math.sqrt(disc))/(2*a)
                    # distances from O are |t|*|dir|
                    d1 = abs(t1)*math.sqrt(a)
                    d2 = abs(t2)*math.sqrt(a)
                    # check if {d1,d2} approx {2,6}
                    if sorted([round(d1,3), round(d2,3)]) != [2.0,6.0]:
                        continue
                    # now check orthocenter condition for some D among Ds
                    for thD,D in Ds:
                        if is_orthocenter(D,E,F):
                            return D,E,F,thD,thE,thF
                return None
            
            res=find()
            print(res)
            
