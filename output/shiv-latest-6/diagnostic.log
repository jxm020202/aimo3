            def row_options(n):
                # DP: dict mapping (displacement, cum_sum, min_disp) reachable after i steps (i from 0 to n-1)
                # start at i=0: displacement = 0, cum_sum = 0 (s_0 = 0), min_disp = 0
                from collections import defaultdict
                dp = {(0,0,0)}  # set of tuples (disp, cum, min_disp)
                for step in range(1, n):
                    new = set()
                    for disp, cum, min_disp in dp:
                        for delta in (+1, -1):
                            nd = disp + delta
                            nc = cum + nd  # add s_i for i=step (since s_i = displacement after step steps)
                            nmin = min(min_disp, nd)
                            new.add((nd, nc, nmin))
                    dp = new
                # After n-1 steps, we have s_i for i=0..n-1 (including s_0=0 already counted in cum? Wait cum currently sum of s_i for i=1..n-1, not including s_0.)
                # We need total sum of s_i for i=0..n-1 = 0 + cum
                results = set()
                for disp, cum, min_disp in dp:
                    total_s = cum  # since s_0=0, sum s_i = cum
                    results.add((total_s, min_disp))
                return results
            
            def feasible_n(n,total=471):
                opts_r = row_options(n)
                opts_c = row_options(n)  # same length
                for Sr, min_s in opts_r:
                    for Sc, min_t in opts_c:
                        S = Sr + Sc
                        min_sum = min_s + min_t
                        numerator = total - n * S
                        if numerator % (n*n) != 0:
                            continue
                        d = numerator // (n*n)
                        if d >= -min_sum:
                            # feasible
                            return True, (Sr,Sc,d)
                return False, None
            
            feas = []
            for n in range(1,31):
                ok, data = feasible_n(n)
                feas.append((n, ok, data))
            feas
            
