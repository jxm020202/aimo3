            def N_from_trilinear_signed(A_deg,B_deg,C_deg):
                # compute using signed trilinear coordinates (cos A, -cos B, cos C)
                c=1.0
                sinC = math.sin(math.radians(C_deg))
                a = c*math.sin(math.radians(A_deg))/sinC
                b = c*math.sin(math.radians(B_deg))/sinC
                X=np.array([c,0.])
                Y=np.array([0.,0.])
                Z=np.array([a*math.cos(math.radians(B_deg)), a*math.sin(math.radians(B_deg))])
                # trilinear signs
                alpha = math.cos(math.radians(A_deg))
                beta = -math.cos(math.radians(B_deg))
                gamma = math.cos(math.radians(C_deg))
                # barycentric
                nA = a*alpha
                nB = b*beta
                nC = c*gamma
                N = (nA*X + nB*Y + nC*Z) / (nA + nB + nC)
                return N
            
