            def fermat_point(X, Y, Z):
                # construct outward equilateral on XY (outside triangle)
                # Determine orientation: use cross product to see which side is outward.
                # We'll construct both possibilities and later pick intersection that lies inside triangle.
                def rotate(vec, angle):
                    return sp.Matrix([[sp.cos(angle), -sp.sin(angle)],[sp.sin(angle), sp.cos(angle)]])*sp.Matrix(vec)
                # side XY
                XY = sp.Matrix([X.x - Y.x, X.y - Y.y])
                # two possible equilateral points
                Xp1 = sp.Point(Y.x + rotate(XY, sp.pi/3)[0], Y.y + rotate(XY, sp.pi/3)[1])  # +60°
                Xp2 = sp.Point(Y.x + rotate(XY, -sp.pi/3)[0], Y.y + rotate(XY, -sp.pi/3)[1]) # -60°
                # side YZ
                YZ = sp.Matrix([Z.x - Y.x, Z.y - Y.y])
                Yp1 = sp.Point(Y.x + rotate(YZ, sp.pi/3)[0], Y.y + rotate(YZ, sp.pi/3)[1])
                Yp2 = sp.Point(Y.x + rotate(YZ, -sp.pi/3)[0], Y.y + rotate(YZ, -sp.pi/3)[1])
                # side ZX
                ZX = sp.Matrix([X.x - Z.x, X.y - Z.y])
                Zp1 = sp.Point(Z.x + rotate(ZX, sp.pi/3)[0], Z.y + rotate(ZX, sp.pi/3)[1])
                Zp2 = sp.Point(Z.x + rotate(ZX, -sp.pi/3)[0], Z.y + rotate(ZX, -sp.pi/3)[1])
                # Try combinations where lines intersect inside triangle.
                candidates = []
                for Xp in [Xp1, Xp2]:
                    for Yp in [Yp1, Yp2]:
                        # line Z-Xp and line X-Yp intersect
                        L1 = sp.Line(Z, Xp)
                        L2 = sp.Line(X, Yp)
                        P = L1.intersection(L2)
                        if P:
