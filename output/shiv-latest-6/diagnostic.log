            def intersect_line_circle(P, Q, D):
                # returns second intersection point (not P) of line PQ with circle centered D radius |D-P|
                P = np.array(P); Q = np.array(Q); D = np.array(D)
                v = Q-P
                # param t
                # solve |P + t v - D|^2 = |P-D|^2
                a = np.dot(v,v)
                b = 2*np.dot(v, P-D)
                c = np.dot(P-D,P-D) - np.dot(P-D,P-D)  # zero
                # Actually equation reduces to a t^2 + 2 v·(P-D) t =0 -> t (a t + 2 v·(P-D))=0
                # solutions t=0 (P) and t = -2 v·(P-D)/a
                t = -2*np.dot(v, P-D)/a
                return P + t*v
            
