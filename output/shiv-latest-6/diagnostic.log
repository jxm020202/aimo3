            def is_bipartite_constant(vals,n):
                # check if all black same and all white same, and differ by 1
                black=None
                white=None
                for i in range(n):
                    for j in range(n):
                        v=vals[i*n+j]
                        if (i+j)%2==0:
                            if black is None: black=v
                            elif black!=v: return False
                        else:
                            if white is None: white=v
                            elif white!=v: return False
                if black is None or white is None: return False
