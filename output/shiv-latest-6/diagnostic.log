            import sympy as sp
            
            def barycentric_N_sympy(A_deg,B_deg,C_deg):
                # Use sympy to compute nine-point center coordinates
                # define triangle vertices with symbolic coordinates as earlier
                c = 1.0
                sinC = math.sin(math.radians(C_deg))
                a = c*math.sin(math.radians(A_deg))/sinC
                b = c*math.sin(math.radians(B_deg))/sinC
                X = sp.Point(c,0)
                Y = sp.Point(0,0)
                Z = sp.Point(a*math.cos(math.radians(B_deg)), a*math.sin(math.radians(B_deg)))
                # compute nine-point center using sympy's geometry?
                # sympy has Triangle class with nine_point_center? Not sure.
                # Let's compute midpoints and circumcenter of medial triangle.
                M1 = sp.Point((X.x+Y.x)/2, (X.y+Y.y)/2)  # midpoint XY
                M2 = sp.Point((Y.x+Z.x)/2, (Y.y+Z.y)/2)  # midpoint YZ
                M3 = sp.Point((Z.x+X.x)/2, (Z.y+X.y)/2)  # midpoint ZX
                # circumcenter of triangle M1,M2,M3
                circle = sp.Circle(M1, M2, M3)
                O_mid = circle.center
                return O_mid
            
