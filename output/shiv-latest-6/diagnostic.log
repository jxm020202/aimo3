            def nullspace_gf2(matrix):
                # returns list of basis vectors for nullspace of matrix (rows are constraints)
                A = matrix.copy()
                rows, cols = A.shape
                # Perform Gaussian elimination to row-echelon form
                # We'll keep track of column pivots
                pivot_cols = []
