            import itertools
            
            def find_solution(n,total):
                # assign values row by row
                # we will use recursion, with pruning based on adjacency constraints.
                # Represent grid as list of lists.
                grid = [[None]*n for _ in range(n)]
                # we need to assign values such that adjacent differences =1.
                # We'll start with (0,0) value from 0 to total maybe.
                # But values can be large; we can bound by total.
                # Use backtracking.
                solutions=[]
                def backtrack(pos, remaining):
                    if pos==n*n:
                        if remaining==0:
                            solutions.append([row[:] for row in grid])
                        return
                    i=pos//n
                    j=pos%n
                    # Determine possible value based on neighbors already assigned (up and left)
                    possible=set()
                    # If no neighbor, any nonnegative integer <= remaining
                    if i>0:
                        up=grid[i-1][j]
                    else:
                        up=None
                    if j>0:
                        left=grid[i][j-1]
                    else:
                        left=None
                    # Determine constraints:
                    # For each neighbor, value must be neighbor +/-1.
                    if up is not None:
                        possible.update({up+1, up-1})
                    if left is not None:
                        if not possible:
                            possible.update({left+1, left-1})
                        else:
                            possible = possible.intersection({left+1, left-1})
                    if not possible:
                        # no neighbor constraints, can be any nonnegative up to remaining
                        low=0
                        high=remaining
                        for val in range(low, high+1):
                            # prune: remaining - val must be feasible for remaining cells (nonnegative)
                            # simple bound: remaining - val >=0
                            grid[i][j]=val
                            backtrack(pos+1, remaining-val)
                            grid[i][j]=None
                        return
                    # else possible set maybe includes negative numbers; filter >=0
                    possible = {v for v in possible if v>=0}
                    for val in possible:
                        if val>remaining: continue
                        # also need to ensure that future cells can sum to remaining-val; trivial bound.
                        grid[i][j]=val
                        backtrack(pos+1, remaining-val)
                        grid[i][j]=None
                backtrack(0,total)
                return solutions
            
