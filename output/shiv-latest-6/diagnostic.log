            def fermat_point_coords(r_val, th_val):
                # compute using geometric construction
                X = np.array([r_val*math.cos(th_val), r_val*math.sin(th_val)])
                Y = np.array([0.0, 0.0])
                Z = np.array([1.0, 0.0])
                # rotate vector Y-X by +60 deg
                def rot60(v):
                    x,y = v
                    return np.array([x*0.5 - y*math.sqrt(3)/2, x*math.sqrt(3)/2 + y*0.5])
                Xprime = X + rot60(Y - X)
                Yprime = Y + rot60(Z - Y)
                # line intersection
                # line through X and Yprime: param X + s*(Yprime - X)
                # line through Z and Xprime: Z + t*(Xprime - Z)
                # solve X + s*(Yprime - X) = Z + t*(Xprime - Z)
                A = np.column_stack((Yprime - X, -(Xprime - Z)))  # 2x2
                b = Z - X
                sol = np.linalg.solve(A, b)
                s = sol[0]
                F = X + s*(Yprime - X)
                return F
            
