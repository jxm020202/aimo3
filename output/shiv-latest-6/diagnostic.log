            def max_weight_given_b(b, A):
                m, n = A.shape
                # variables: x (n binary), y (m integer)
                total_vars = n + m
                # objective: maximize sum x_i -> minimize negative sum
                c = np.zeros(total_vars)
                c[:n] = -1  # minimize negative sum = maximize sum
                
                # constraints: A x - 2 y = b
                # Represent as A_ext @ vars = b
                A_ext = np.zeros((m, total_vars), dtype=int)
                A_ext[:, :n] = A
                A_ext[:, n:] = -2*np.eye(m, dtype=int)
                # Use LinearConstraint with lb=ub=b
                lc = LinearConstraint(A_ext, b, b)
                # bounds: x in [0,1], y in [0, 361] maybe
                lb = np.concatenate([np.zeros(n), np.zeros(m)])
                ub = np.concatenate([np.ones(n), np.full(m, 361)])
                bounds = Bounds(lb, ub)
                integrality = np.concatenate([np.ones(n), np.ones(m)])  # all integer (binary for x)
                res = milp(c, constraints=[lc], bounds=bounds, integrality=integrality, options={'presolve': True})
                if not res.success:
                    return None
                x = res.x[:n]
                # round to nearest integer
                x = np.rint(x).astype(int)
                return int(x.sum())
            
