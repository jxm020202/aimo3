            def condition_AB(A,B):
                C = math.pi - A - B
                if C<=0 or C>=math.pi/2:
                    return None
                # compute g
                def g(theta):
                    return 2*math.cos(theta)*math.sin(theta) + math.sqrt(3)*(math.cos(theta)**2)
                return g(A) - g(C)
            
            def find_B():
                solutions = []
                for B in np.linspace(0.1, math.pi/2 - 0.1, 200):
                    # find A such that condition zero, A not equal C
                    # search A in (0, pi - B)
                    vals = []
                    for A in np.linspace(0.01, math.pi - B - 0.01, 500):
                        diff = condition_AB(A,B)
                        if diff is None: continue
                        vals.append(diff)
                    # look for sign change
