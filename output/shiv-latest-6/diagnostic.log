            def gf2_rank(A):
                A = A.copy()
                rows, cols = A.shape
                rank = 0
                col = 0
                while col < cols and rank < rows:
                    # find pivot row with 1 in current column at or below rank
                    pivot = None
                    for r in range(rank, rows):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap pivot row with current rank row
                    if pivot != rank:
                        A[[pivot, rank]] = A[[rank, pivot]]
                    # eliminate other rows
                    for r in range(rows):
                        if r != rank and A[r, col]:
                            A[r] ^= A[rank]
                    rank += 1
                    col += 1
                return rank
            
