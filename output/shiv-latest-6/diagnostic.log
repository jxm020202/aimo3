            def find_gamma_for_beta(beta):
                # search gamma in (eps, pi/2 - eps) such that alpha also acute.
                eps = 1e-6
                # define range for gamma: must satisfy gamma>0, gamma<pi/2, and alpha=pi-beta-gamma>0 and <pi/2
                # So gamma must be between max(eps, pi - beta - pi/2) and min(pi/2 - eps, pi - beta - eps)
                low = max(eps, math.pi - beta - math.pi/2 + eps)  # ensure alpha < pi/2 => gamma > pi - beta - pi/2
                high = min(math.pi/2 - eps, math.pi - beta - eps)  # ensure alpha > 0
                if low >= high:
                    return None
                # Use root finding scanning
                # sample many points to find sign change
                Nsamples = 200
                gammas = np.linspace(low, high, Nsamples)
                vals = [collinearity_condition(beta, g) for g in gammas]
                # find intervals where sign changes
                for i in range(Nsamples-1):
                    if vals[i] is None or vals[i+1] is None:
                        continue
                    if vals[i]==0:
                        return gammas[i]
                    if vals[i]*vals[i+1] < 0:
                        # root in interval
                        a=gammas[i]; b=gammas[i+1]
                        for _ in range(40):
                            m=(a+b)/2
                            vm=collinearity_condition(beta,m)
                            if vm is None:
                                break
                            if vals[i]*vm <= 0:
                                b=m
                            else:
                                a=m
                        return (a+b)/2
                return None
            
            # test for various beta
            results=[]
            for beta_deg in np.linspace(10,80,71):
                beta=math.radians(beta_deg)
                g=find_gamma_for_beta(beta)
                if g:
                    results.append((beta_deg, math.degrees(g)))
            len(results)
            
