            def second_intersection_sym(P, Q, center):
                # returns second intersection point of circle centered at center with radius |center-P|
                # Solve param t for P + t*(Q-P)
                t = sp.symbols('t')
                v = sp.Matrix(Q) - sp.Matrix(P)
                expr = (sp.Matrix(P) + t*v - sp.Matrix(center)).dot(sp.Matrix(P) + t*v - sp.Matrix(center)) - (sp.Matrix(center)-sp.Matrix(P)).dot(sp.Matrix(center)-sp.Matrix(P))
                # quadratic in t
                sol = sp.solve(expr, t)
                # choose solution not zero
                sol = [s for s in sol if not sp.simplify(s).equals(0)]
                if not sol:
                    return None
                t2 = sol[0]
                point = sp.Point(*(sp.Matrix(P) + t2*v))
                return point
            
