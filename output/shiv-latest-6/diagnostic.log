            def fermat_point(a,b,c):
                # a,b,c are complex numbers on unit circle
                # compute Fermat point via intersection of lines AD and BE where D = b + omega*(c-b), E = c + omega*(a-c)
                omega = cmath.exp(1j*math.pi/3)  # 60 degrees rotation
                D = b + omega*(c - b)
                E = c + omega*(a - c)
                # line AD: param a + t*(D - a)
                # line BE: param b + s*(E - b)
                # Solve a + t*(D-a) = b + s*(E-b)
                # Solve for t,s (complex)
                # Write as two real equations (real and imag)
                A = np.array([[ (D - a).real, -(E - b).real],
                              [ (D - a).imag, -(E - b).imag ]], dtype=float)
                Bvec = np.array([ (b - a).real, (b - a).imag ], dtype=float)
                try:
                    t_s = np.linalg.solve(A, Bvec)
                except np.linalg.LinAlgError:
                    return None
                t = t_s[0]
                # compute intersection point
                F = a + t*(D - a)
                return F
            
            def nine_point_center(a,b,c):
                # O=0, orthocenter h = a+b+c, N = (O + h)/2 = (a+b+c)/2
                return (a+b+c)/2
            
            def collinearity_condition(a,b,c):
                F = fermat_point(a,b,c)
                N = nine_point_center(a,b,c)
                if F is None:
                    return None
                # check if (F - b) / (N - b) is real
                val = (F - b) / (N - b)
                # return imaginary part
                return val.imag
            
            def test_random():
                for _ in range(1000):
                    # random acute triangle angles A,B,C each < 90°, sum 180°
                    # generate random angles uniformly? Use random for A,B then compute C=pi-A-B if positive
                    A = random.uniform(math.radians(20), math.radians(80))
                    B = random.uniform(math.radians(20), math.radians(80))
                    if A + B >= math.pi - math.radians(20):
