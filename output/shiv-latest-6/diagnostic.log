            def covering_radius_bfs(n):
                total=n*n
                ops=[]
                for i in range(n):
                    for j in range(n):
                        mask=0
                        for c in range(n):
                            mask ^= 1 << (i*n + c)
                        for r in range(n):
                            mask ^= 1 << (r*n + j)
                        ops.append(mask)
                # generate basis via Gaussian elimination to get independent masks
                # We'll just generate all codewords via BFS using operations as moves (since subspace generated by ops)
                # BFS from 0 to generate all codewords distances (not needed)
                # Instead compute all codewords set
                # Use linear basis to generate all codewords as ints
                # Perform Gaussian elimination on list of masks to get basis
                basis=[]
                for mask in ops:
                    m=mask
                    for b in basis:
                        if (m ^ b) < m:
                            m ^= b
                    if m:
                        basis.append(m)
                # reduce basis to independent
                # Now generate all codewords
                code=[0]
                for b in basis:
                    code += [c ^ b for c in code]
                # BFS from all codewords to compute distance to nearest codeword
                N = 1 << total
                from collections import deque
                dist = bytearray(N)  # initialize 0 meaning unvisited, but we need sentinel
                INF=255
                for i in range(N):
                    dist[i]=INF
                q=deque()
                for c in code:
                    dist[c]=0
                    q.append(c)
                while q:
                    v=q.popleft()
                    d=dist[v]
                    if d==total:  # max possible
                        continue
                    # flip each bit
                    for i in range(total):
                        u = v ^ (1<<i)
                        if dist[u]==INF:
                            dist[u]=d+1
                            q.append(u)
                # covering radius is max distance
                R = max(dist)
                return R
            
