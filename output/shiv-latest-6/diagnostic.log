            def build_ilp():
                n=7
                # list dominoes: each as tuple of cells ((r1,c1),(r2,c2))
                dominoes=[]
                # horizontal
                for i in range(n):
                    for j in range(n-1):
                        dominoes.append(((i,j),(i,j+1)))
                # vertical
                for i in range(n-1):
                    for j in range(n):
                        dominoes.append(((i,j),(i+1,j)))
                D=len(dominoes)
                # mapping cell to index
                cell_index={(i,j):i*n+j for i in range(n) for j in range(n)}
                # constraints:
                # 1) each cell covered at most once: sum x_d for d covering cell <=1
                A_ub=[]
                b_ub=[]
                # 2) sliding constraints: for each domino d, for each end where adjacent inside board,
                # sum x_{d'} covering that adjacent cell >= x_d
                # We'll convert to -sum >= -x_d -> sum x_{d'} - x_d >=0 -> -sum + x_d <=0 for upper bound form.
                # We'll add as A_ub row.
                # also need variable bounds 0-1 integer.
                # Build coverage list per cell
                cover_by_cell=[[] for _ in range(n*n)]
                for idx,d in enumerate(dominoes):
                    for cell in d:
                        cover_by_cell[cell_index[cell]].append(idx)
                # cell constraints
                for cell_idx, dlist in enumerate(cover_by_cell):
                    row=[0]*D
                    for d in dlist:
                        row[d]=1
                    A_ub.append(row)
                    b_ub.append(1)
                # sliding constraints
                for idx,d in enumerate(dominoes):
                    (r1,c1),(r2,c2)=d
                    # orientation
                    if r1==r2: # horizontal, left to right
                        # left end at (r1,c1), adjacent left cell (r1,c1-1)
                        left_adj=(r1,c1-1)
                        right_adj=(r2,c2+1) # (r1,c2+1)
                        ends=[left_adj,right_adj]
                    else: # vertical
                        # top end (r1,c1), adj up (r1-1,c1)
                        top_adj=(r1-1,c1)
                        bottom_adj=(r2+1,c2) # (r2+1,c1)
                        ends=[top_adj,bottom_adj]
                    for adj in ends:
                        if 0<=adj[0]<n and 0<=adj[1]<n:
                            # need sum x covering adj >= x_idx
                            row=[0]*D
                            for d2 in cover_by_cell[cell_index[adj]]:
                                row[d2]= -1  # we'll move to left side? Let's do: sum_adj - x_idx >=0 -> -(sum_adj - x_idx) <=0 -> -sum_adj + x_idx <=0
                            row[idx]=1
                            A_ub.append(row)
                            b_ub.append(0)
                        else:
                            # outside board, no constraint
                            pass
                A_ub=np.array(A_ub,dtype=int)
                b_ub=np.array(b_ub,dtype=int)
                c=np.ones(D,dtype=int) # minimize sum
                return c,A_ub,b_ub,dominoes
            
            c,A_ub,b_ub,dominoes=build_ilp()
            print(len(dominoes))
            
