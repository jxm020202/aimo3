            import itertools, math, numpy as np, sys, time, random, collections, functools, math, itertools, sys, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def find_solution_n(n, total):
                N=n*n
                # variables: a_0..a_{N-1} integer >=0, plus binary for each edge
                # edges: horizontal (n*(n-1)) and vertical ((n-1)*n)
                horiz_edges = [(i,j) for i in range(n) for j in range(n-1)]
                vert_edges = [(i,j) for i in range(n-1) for j in range(n)]
                m = len(horiz_edges)+len(vert_edges)
                # variable order: a cells then x binaries for each edge
                # total vars = N + m
                # constraints: for each edge, a_u - a_v = 1 - 2*x
                A=[]
                b=[]
                # each constraint equality -> two inequalities? milp supports equality via LinearConstraint with lb=ub
                # We'll build equality constraints matrix
                rows=[]
                lbs=[]
                ubs=[]
                # mapping cell index
                def idx(i,j): return i*n+j
                # horizontals
                for (i,j) in horiz_edges:
                    u=idx(i,j)
                    v=idx(i,j+1)
                    row = np.zeros(N+m)
                    row[u]=1
                    row[v]=-1
                    # binary variable index
                    bin_idx = N + horiz_edges.index((i,j))
                    row[bin_idx]=2
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(1)
                # verticals
                for (i,j) in vert_edges:
                    u=idx(i,j)
                    v=idx(i+1,j)
                    row = np.zeros(N+m)
                    row[u]=1
                    row[v]=-1
                    bin_idx = N + len(horiz_edges) + vert_edges.index((i,j))
                    row[bin_idx]=2
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(1)
                A_eq = np.vstack(rows)
                lc = LinearConstraint(A_eq, lbs, ubs)
                # bounds for variables
                lower = np.zeros(N+m)
                upper = np.full(N+m, np.inf)
                # binary vars bounds 0-1
                for i in range(N, N+m):
                    upper[i]=1
                bounds = Bounds(lower, upper)
                # objective: minimize 0 (just feasibility) but we need total sum constraint
                # add total sum equality as another linear constraint
                row = np.zeros(N+m)
                row[:N]=1
                rows2 = np.vstack([A_eq, row])
                lbs2 = np.append(lbs, total)
                ubs2 = np.append(ubs, total)
                lc2 = LinearConstraint(rows2, lbs2, ubs2)
                # solve
                res = milp(c=np.zeros(N+m), constraints=lc2, bounds=bounds, integrality=np.concatenate([np.ones(N), np.ones(m)]))
                return res
            
            # Try n=3
            res = find_solution_n(3, 471)
            print(res.success)
            
