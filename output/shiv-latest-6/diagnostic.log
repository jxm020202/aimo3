            def base7_digits(n):
                if n==0:
                    return [0]
                digs=[]
                while n>0:
                    digs.append(n%7)
                    n//=7
                return digs[::-1]  # most significant first
            
            def delete_digit(digs, i):
                # delete digit at index i (0 based from most significant)
                new = digs[:i]+digs[i+1:]
                # interpret as base7 number
                val=0
                for d in new:
                    val=val*7+d
                return val
            
            def satisfies(n):
                digs=base7_digits(n)
                m=len(digs)-1
                total=0
                for i in range(m): # 0..m-1
                    total+=delete_digit(digs,i)
                return total==n
            
            def satisfies_all(n):
                digs=base7_digits(n)
                total=0
                for i in range(len(digs)):
