                    C = math.pi - A - B
                    if C <= math.radians(20) or C >= math.radians(90):
                        continue
                    # construct points
                    a = 1+0j
                    b = cmath.exp(1j*2*C)  # angle at B is B, but we used C for arc AB? Wait we earlier derived mapping: b = e^{i*2C}
                    c = cmath.exp(1j*2*(C+A))
                    imag = collinearity_condition(a,b,c)
                    if imag is not None and abs(imag) < 1e-6:
                        return (A,B,C)
                return None
            
            print(test_random())
            
