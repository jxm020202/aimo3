            def fermat_point_barycentric(X,Y,Z):
                # compute side lengths
                a = abs(Y-Z)  # opposite X
                b = abs(Z-X)  # opposite Y
                c = abs(X-Y)  # opposite Z
                # compute angles using law of cos
                def angle(a,b,c):
                    cosA = (b*b + c*c - a*a)/(2*b*c)
                    cosA = max(-1.0, min(1.0, cosA))
                    return math.acos(cosA)
                A = angle(a,b,c)  # angle at X opposite side a
                B = angle(b,c,a)  # at Y
                C = angle(c,a,b)  # at Z
                # barycentric weights: a*csc(A+π/3) etc.
                wX = a / math.sin(A + math.pi/3)
                wY = b / math.sin(B + math.pi/3)
                wZ = c / math.sin(C + math.pi/3)
                # convert barycentric to Cartesian: P = (wX*X + wY*Y + wZ*Z)/(wX+wY+wZ)
                P = (wX*X + wY*Y + wZ*Z) / (wX + wY + wZ)
                return P
            
            def test_triangle(u,v):
                X = cmath.exp(1j*u)
