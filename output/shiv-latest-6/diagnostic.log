            import math, random, itertools, numpy as np
            
            def collinearity_measure(A,B):
                C = math.pi - A - B
                if C<=0: return None
                # side lengths proportionally sin of angles, set a=sin A etc.
                a = math.sin(A)
                b = math.sin(B)
                c = math.sin(C)
                # coordinates
                Y = np.array([0.0,0.0])
                Z = np.array([a,0.0])
                X = np.array([c*math.cos(B), c*math.sin(B)])
                # midpoints
                Ma = (Y+Z)/2
                Mb = (Z+X)/2
                Mc = (X+Y)/2
                # circumcenter of triangle Ma Mb Mc
                # function to compute circumcenter of three points
                def circumcenter(p1,p2,p3):
                    d = 2*(p1[0]*(p2[1]-p3[1]) + p2[0]*(p3[1]-p1[1]) + p3[0]*(p1[1]-p2[1]))
                    if abs(d)<1e-9:
                        return None
                    ux = ((np.linalg.norm(p1)**2)*(p2[1]-p3[1]) + (np.linalg.norm(p2)**2)*(p3[1]-p1[1]) + (np.linalg.norm(p3)**2)*(p1[1]-p2[1]))/d
                    uy = ((np.linalg.norm(p1)**2)*(p3[0]-p2[0]) + (np.linalg.norm(p2)**2)*(p1[0]-p3[0]) + (np.linalg.norm(p3)**2)*(p2[0]-p1[0]))/d
                    return np.array([ux, uy])
                N = circumcenter(Ma, Mb, Mc)
                # Fermat point coordinates using barycentric weights
                # weights: w_X = a / sin(A+60°), w_Y = b / sin(B+60°), w_Z = c / sin(C+60°)
                wX = a / math.sin(A + math.radians(60))
                wY = b / math.sin(B + math.radians(60))
                wZ = c / math.sin(C + math.radians(60))
                F = (wX*X + wY*Y + wZ*Z) / (wX + wY + wZ)
                # collinearity: cross product of N and F (since Y=0)
                cross = N[0]*F[1] - N[1]*F[0]
                return cross
            
            # test random acute triangles
