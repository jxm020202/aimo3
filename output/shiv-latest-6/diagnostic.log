            def random_acute_triangle():
                # generate three random angles on circle such that triangle is acute.
                # Choose three points on unit circle with angles t1<t2<t3.
                t1 = random.random()*2*math.pi
                t2 = t1 + random.random()*math.pi*0.9  # ensure less than pi apart maybe
                t3 = t2 + random.random()*math.pi*0.9
                # ensure they are within 2pi
                if t3 - t1 > 2*math.pi:
                    return random_acute_triangle()
                pts = [cmath.exp(1j*t1), cmath.exp(1j*t2), cmath.exp(1j*t3)]
                # compute angles using law of cos
                X, Y, Z = pts
                # side lengths
                a = abs(Y-Z)  # opposite X
                b = abs(Z-X)  # opposite Y
                c = abs(X-Y)  # opposite Z
                # angles
                # cos A = (b^2 + c^2 - a^2)/(2bc)
                def angle_from_sides(a,b,c):
                    # angle opposite side a
                    cosA = (b*b + c*c - a*a)/(2*b*c)
                    # clamp
                    cosA = max(-1.0, min(1.0, cosA))
                    return math.degrees(math.acos(cosA))
                A = angle_from_sides(a,b,c)
                B = angle_from_sides(b,c,a)
                C = angle_from_sides(c,a,b)
                if max(A,B,C) < 90:
                    return (X,Y,Z,A,B,C)
                else:
                    return random_acute_triangle()
            
            def fermat_point(X,Y,Z):
                # compute side lengths and angles
                a = abs(Y-Z)
                b = abs(Z-X)
                c = abs(X-Y)
                # angles at vertices
                def angle_opposite(a,b,c):
                    cosA = (b*b + c*c - a*a)/(2*b*c)
                    cosA = max(-1.0, min(1.0, cosA))
                    return math.acos(cosA)  # in radians
                A = angle_opposite(a,b,c)
                B = angle_opposite(b,c,a)
                C = angle_opposite(c,a,b)
                # weights barycentric: a*csc(A+pi/3) etc.
                # csc = 1/sin
                wX = a / math.sin(A + math.pi/3)
                wY = b / math.sin(B + math.pi/3)
                wZ = c / math.sin(C + math.pi/3)
                # compute Cartesian coordinates (complex)
                p = (wX*X + wY*Y + wZ*Z) / (wX + wY + wZ)
                return p
            
            def nine_point_center(X,Y,Z):
                # circumcenter O is 0 for unit circle
                # N = (X+Y+Z)/2
                return (X+Y+Z)/2
            
            def angle_at_vertex(Y, X, Z):
                # angle XYZ at Y: angle between vectors YX and YZ
                v1 = X - Y
                v2 = Z - Y
                dot = (v1.real*v2.real + v1.imag*v2.imag)
                norm1 = abs(v1)
                norm2 = abs(v2)
                cosang = dot/(norm1*norm2)
                cosang = max(-1.0, min(1.0, cosang))
                return math.degrees(math.acos(cosang))
            
            def collinear(Y, P, N, tol=1e-6):
                # check area of triangle YPN ~ 0
                # cross product magnitude
                v1 = P - Y
                v2 = N - Y
                cross = v1.real*v2.imag - v1.imag*v2.real
                return abs(cross) < tol
            
