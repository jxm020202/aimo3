            from itertools import product
            
            def count_solutions_bruteforce_m(m, removal='all'):
                # compute a_map for digit values 0..6
                m_digits = base7_digits(m)
                def compute_a(d):
                    new = [dig for dig in m_digits if dig != d]
                    val = 0
                    for dig in new:
                        val = val*7 + dig
                    return val
                a_map = [compute_a(d) for d in range(7)]
                count = 0
                solutions = []
                # iterate over all digit tuples of length m+1, leading digit non-zero
                for digits in product(range(7), repeat=m+1):
                    if digits[0] == 0:
                        continue
                    # compute n value
                    n_val = 0
                    for d in digits:
                        n_val = n_val*7 + d
                    # sum over i=0..m-1 (i.e., exclude most significant digit)
                    # digits list is most significant first: digits[0] = b_m, digits[1] = b_{m-1}, ..., digits[m] = b_0
                    # So i from 0 (least) to m-1 (second most). That corresponds to digits indices from m (least) down to 1.
                    total = 0
                    for idx in range(1, m+1):  # idx 1..m inclusive
                        b_i = digits[idx]
                        total += a_map[b_i]
                    if total == n_val:
                        count += 1
                        solutions.append(n_val)
                return count, solutions
            
            for m in range(1,9):
                cnt, sols = count_solutions_bruteforce_m(m, removal='all')
                print(m, cnt)
            
