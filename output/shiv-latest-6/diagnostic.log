            import numpy as np, math, itertools, sys, time
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def solve_n(n, target_sum):
                N=n*n
                # variable ordering: first f variables (N), then d_h (horizontal edges), then d_v (vertical edges)
                # total variables
                num_f = N
                num_h = n*(n-1)  # horizontal edges per row n, columns n-1
                num_v = (n-1)*n
                total_vars = num_f + num_h + num_v
                # bounds: f unrestricted integer, d binary 0/1
                # We'll set bounds for f as large range, say [-M, M]
                M=1000  # large enough
                lb = np.full(total_vars, -M, dtype=float)
                ub = np.full(total_vars, M, dtype=float)
                # for d variables, bounds 0-1
                for i in range(num_f, total_vars):
                    lb[i]=0
                    ub[i]=1
                # integrality: all variables integer, but we can set integrality for all.
                integrality = np.ones(total_vars, dtype=int)
                # constraints:
                constraints = []
                # reference f[0,0]=0: we can set equality constraint
                A_ref = np.zeros(total_vars)
                A_ref[0]=1
                constraints.append(LinearConstraint(A_ref, 0, 0))
                # edge constraints: f[i][j+1] - f[i][j] = 2*d_h - 1
                # map indices
                def idx_f(i,j):
                    return i*n + j
                def idx_h(i,j):
                    # horizontal edge at (i,j) connecting (i,j) and (i,j+1), j from 0..n-2
                    return num_f + i*(n-1) + j
                def idx_v(i,j):
                    # vertical edge at (i,j) connecting (i,j) and (i+1,j), i from 0..n-2
                    return num_f + num_h + i*n + j
                # horizontal edges
                for i in range(n):
                    for j in range(n-1):
                        row = np.zeros(total_vars)
                        row[idx_f(i,j+1)] = 1
                        row[idx_f(i,j)] = -1
                        row[idx_h(i,j)] = -2
                        # equation: f(i,j+1)-f(i,j) - (2*d_h -1) =0 => f(i,j+1)-f(i,j) -2*d_h +1 =0
                        # So we add constant +1 on RHS: we can move to RHS by setting lower=upper = -1? Wait:
                        # We need: f(i,j+1)-f(i,j) -2*d_h +1 = 0 => f(i,j+1)-f(i,j) -2*d_h = -1
                        # So row * vars = -1
                        constraints.append(LinearConstraint(row, -1, -1))
                # vertical edges
                for i in range(n-1):
                    for j in range(n):
                        row = np.zeros(total_vars)
                        row[idx_f(i+1,j)] = 1
                        row[idx_f(i,j)] = -1
                        row[idx_v(i,j)] = -2
                        # equation: f(i+1,j)-f(i,j) - (2*d_v -1) =0 => ... = -1
                        constraints.append(LinearConstraint(row, -1, -1))
                # total sum constraint: sum of f = target_sum
                row_sum = np.zeros(total_vars)
                for i in range(n):
                    for j in range(n):
                        row_sum[idx_f(i,j)] = 1
                constraints.append(LinearConstraint(row_sum, target_sum, target_sum))
                # combine constraints
                A = None
                # SciPy milp expects list of LinearConstraint objects
                # Build bounds
                bounds = Bounds(lb, ub)
                # objective: dummy zero
                c = np.zeros(total_vars)
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            # test for small n=3 to ensure works
            res3 = solve_n(3, target_sum=10)
            print(res3.success, res3.x[:9])
            
