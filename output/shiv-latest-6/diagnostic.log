            def max_black_from_board(board):
                # board list length 361 of 0/1 (0 white,1 black)
                size=19
                N=size*size
                c = np.array([1-2*b for b in board], dtype=float)  # maximize c·w
                # variables: w (N), p (1), r_i (size), c_j (size)
                # total vars = N + 1 + size + size
                total_vars = N + 1 + size + size
                # variable bounds: w binary 0/1, others integer unrestricted? but we can bound r_i,c_j between 0..size
                lb = np.zeros(total_vars)
                ub = np.ones(total_vars)*np.inf
                # set bounds for binary vars: w in [0,1], p in [0,1]
                for i in range(N):
                    ub[i]=1
                ub[N]=1  # p
                # r_i bounds 0..size
                for i in range(size):
                    lb[N+1+i]=0
                    ub[N+1+i]=size
                    lb[N+1+size+i]=0
                    ub[N+1+size+i]=size
                # constraints: row parity
                A = []
                b = []
                # each row: sum w - 2 r_i - p = 0
                for i in range(size):
                    row = np.zeros(total_vars)
                    for j in range(size):
                        idx = i*size + j
                        row[idx]=1
                    row[N+1+i] = -2
                    row[N] = -1
                    A.append(row)
                    b.append(0)
                # each column: sum w - 2 c_j - p =0
                for j in range(size):
                    row = np.zeros(total_vars)
                    for i in range(size):
                        idx = i*size + j
                        row[idx]=1
                    row[N+1+size+j] = -2
                    row[N] = -1
                    A.append(row)
                    b.append(0)
                A = np.array(A)
                lc = LinearConstraint(A, lb=np.array(b), ub=np.array(b))
                # objective: maximize c·w => minimize -c·w
                c_obj = np.zeros(total_vars)
                c_obj[:N] = -c  # minimize negative
                # integer variables: all are integer (binary or integer)
                integrality = np.ones(total_vars)
                # solve
                res = milp(c=c_obj, constraints=[lc], bounds=Bounds(lb, ub), integrality=integrality, options={"disp": False})
                if not res.success:
                    print("MILP failed")
                    return None
                w = np.round(res.x[:N])
                max_weight = int(np.sum(board ^ w.astype(int)))  # XOR count
                return max_weight
            
