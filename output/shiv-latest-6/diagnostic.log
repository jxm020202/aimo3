            def base7_digits(num):
                if num == 0:
                    return [0]
                digs = []
                while num > 0:
                    digs.append(num % 7)
                    num //= 7
                return digs[::-1]  # most significant first
            
            def remove_digit_at_position(digits, pos):
                # digits list, pos counting from 0 least significant? We'll define pos as index from least significant (i)
                # So we need to map i to index in digits list (most significant first)
                # digits length = len(digits)
                # i=0 corresponds to least significant digit, i=m corresponds to most significant
                # So index = len(digits)-1 - i
                idx = len(digits) - 1 - pos
                if idx < 0 or idx >= len(digits):
                    raise ValueError
                new = digits[:idx] + digits[idx+1:]
                # interpret new as base-7 number (empty -> 0)
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
            def remove_all_occurrences(digits, digit):
                new = [d for d in digits if d != digit]
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
