            def fermat_point(X, Y, Z, A, B, C):
                # barycentric weights
                wX = 1.0 / math.sin(A + math.pi/3)
                wY = 1.0 / math.sin(B + math.pi/3)
                wZ = 1.0 / math.sin(C + math.pi/3)
                s = wX + wY + wZ
                px = (wX*X[0] + wY*Y[0] + wZ*Z[0]) / s
                py = (wX*X[1] + wY*Y[1] + wZ*Z[1]) / s
                return (px, py)
            
            def circumcenter(P1, P2, P3):
                # using formula based on perpendicular bisectors
                x1,y1 = P1
                x2,y2 = P2
                x3,y3 = P3
                d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))
                if abs(d) < 1e-12:
                    return None
                ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2)) / d
                uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1)) / d
                return (ux, uy)
            
            def nine_point_center(X, Y, Z):
                MXY = ((X[0]+Y[0])/2, (X[1]+Y[1])/2)
                MYZ = ((Y[0]+Z[0])/2, (Y[1]+Z[1])/2)
                MZX = ((Z[0]+X[0])/2, (Z[1]+X[1])/2)
                return circumcenter(MXY, MYZ, MZX)
            
            def collinear(Y, P, N, eps=1e-8):
                (x1,y1),(x2,y2),(x3,y3) = Y,P,N
                area = x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2)
                return abs(area) < eps
            
