            import itertools
            
            def min_flips(rows, cols):
                n=len(rows)
                m=len(cols)
                # brute force all matrices
                minw= n*m+1
                for bits in itertools.product([0,1], repeat=n*m):
                    # compute parity of flips (bits)
                    ok=True
                    for i in range(n):
                        if sum(bits[i*m:(i+1)*m])%2 != rows[i]:
                            ok=False; break
                    if not ok: continue
                    for j in range(m):
                        if sum(bits[j::m])%2 != cols[j]:
                            ok=False; break
                    if not ok: continue
                    w=sum(bits)
                    if w<minw:
                        minw=w
                return minw
            
            def test_small(n):
                results={}
                for rows in itertools.product([0,1], repeat=n):
                    for cols in itertools.product([0,1], repeat=n):
                        if sum(rows)%2 != sum(cols)%2: continue
                        mf=min_flips(rows, cols)
                        results[(rows,cols)]=mf
                return results
            
