            import numpy as np, cmath, random, math, sympy as sp
            def foot_of_altitude(x, y, z):
                # line through y and z: param y + t*(z-y)
                # projection of x onto line yz
                v = z - y
                t = ((x - y).conjugate()*v).real / (v.conjugate()*v).real  # using complex dot product as real part of product with conj
                # Actually dot product of complex numbers a,b is Re(a*conj(b))
                # We'll compute projection using vector in R2
                # convert to 2D
                xv = np.array([x.real, x.imag])
                yv = np.array([y.real, y.imag])
                zv = np.array([z.real, z.imag])
                v = zv - yv
                t = np.dot(xv - yv, v) / np.dot(v, v)
                proj = yv + t*v
                return proj[0]+1j*proj[1]
            
            def test():
                for _ in range(5):
                    angs = np.random.rand(3)*2*math.pi
                    x = cmath.exp(1j*angs[0])
                    y = cmath.exp(1j*angs[1])
