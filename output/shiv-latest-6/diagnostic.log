                            if not ok: break
                            new_col_sums.add(s)
                    if ok:
                        # add point
                        rows[y].append(x)
                        cols[x].append(y)
                        # update sum sets
                        saved_row = row_sums[y].copy()
                        saved_col = col_sums[x].copy()
