                # Solve A * g = d
                # Use rational Gaussian elimination
                # Convert to Fractions
                A = [[Fraction(val) for val in row] for row in A]
                b = [Fraction(val) for val in selected_vals]
                # Gaussian elimination
                # Augmented matrix
                M = [row + [b_i] for row, b_i in zip(A, b)]
                # forward elimination
                nvar = g_len
                rank = 0
                for col in range(nvar):
                    # find pivot row
                    pivot = None
                    for r in range(rank, m):
                        if M[r][col] != 0:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    M[rank], M[pivot] = M[pivot], M[rank]
                    # normalize pivot row
                    pivval = M[rank][col]
                    M[rank] = [v / pivval for v in M[rank]]
                    # eliminate other rows
