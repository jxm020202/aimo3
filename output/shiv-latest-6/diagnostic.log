            def covering_radius(size):
                n=size*size
                ops=[]
                for i in range(size):
                    for j in range(size):
                        vec=[0]*n
                        for k in range(size):
                            vec[i*size + k]=1
                            vec[k*size + j]=1
                        ops.append(vec)
                # compute basis of subspace S via Gaussian elimination to get list of independent vectors
                # We'll use row reduction to get basis rows.
                # Use our gf2_rank but also return basis rows.
                def gf2_basis(matrix):
                    A=[row[:] for row in matrix]
                    rows=len(A)
                    cols=len(A[0])
                    pivots=[]
                    basis=[]
                    r=0
                    for c in range(cols):
                        piv=None
                        for i in range(r, rows):
                            if A[i][c]:
                                piv=i
                                break
                        if piv is None:
                            continue
                        A[r],A[piv]=A[piv],A[r]
                        pivots.append(c)
                        basis.append(A[r][:])  # store row after elimination? We'll later transform.
                        for i in range(rows):
                            if i!=r and A[i][c]:
                                A[i]=[a^b for a,b in zip(A[i],A[r])]
                        r+=1
                        if r==rows:
                            break
                    # basis rows are independent rows of original matrix after elimination (not necessarily original rows)
                    return basis
                basis = gf2_basis(ops)
                # generate all vectors in subspace S (might be large). For small size we can enumerate.
                dim=len(basis)
                # enumerate all 2^dim vectors
                S=set()
                for mask in range(1<<dim):
                    vec=[0]*n
                    for i in range(dim):
                        if (mask>>i)&1:
                            vec = [a^b for a,b in zip(vec, basis[i])]
                    S.add(tuple(vec))
                # compute covering radius: max over all vectors of min distance to S
                max_dist=0
                for x_int in range(1<<n):
                    x=[(x_int>>i)&1 for i in range(n)]
                    # compute min distance to any s in S
                    min_dist=n
                    for s in S:
                        d=sum((x[i]^s[i]) for i in range(n))
                        if d<min_dist:
                            min_dist=d
                            if min_dist==0:
                                break
                    if min_dist>max_dist:
                        max_dist=min_dist
                return max_dist
            
            for sz in [2,3]:
                print(sz, covering_radius(sz))
            
