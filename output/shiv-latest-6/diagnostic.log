            import sympy as sp
            def polygon_area(pts):
                area = 0
                n = len(pts)
                for i in range(n):
                    x1,y1 = pts[i].x, pts[i].y
                    x2,y2 = pts[(i+1)%n].x, pts[(i+1)%n].y
                    area += x1*y2 - x2*y1
                return abs(area)/2
            
            area_val = polygon_area([Spt, Qpt, P1pt, Rpt, Tpt, P2pt])
            area_val.evalf()
            
