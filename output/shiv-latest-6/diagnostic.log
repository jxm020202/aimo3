            def check_solution(sol):
                θY_val, θP_val, θQ_val, θS_val, r_val = sol
                # normalize angles 0-2π
                def norm(a):
                    a = float(a) % (2*math.pi)
                    return a
                θYn, θPn, θQn, θSn = map(norm, [θY_val, θP_val, θQ_val, θS_val])
                # coordinates
                Y = np.array([0.5 + r_val*math.cos(θY_val), r_val + r_val*math.sin(θY_val)])
                P = np.array([0.5 + r_val*math.cos(θP_val), r_val + r_val*math.sin(θP_val)])
                Q = np.array([0.5 + r_val*math.cos(θQ_val), r_val + r_val*math.sin(θQ_val)])
                S = np.array([0.5 + r_val*math.cos(θS_val), r_val + r_val*math.sin(θS_val)])
                X = np.array([0.0,0.0])
                Z = np.array([1.0,0.0])
                # compute λ
                lam = np.dot(P, Y) / np.dot(Y, Y)
                mu = np.dot(Q - Y, Z - Y) / np.dot(Z - Y, Z - Y)
                # check within (0,1) tolerance
                condP = 0 < lam < 1
                condQ = 0 < mu < 1
                # Determine arc order: we need that moving along circle from Y to Q (shorter arc) does not pass through P.
                # Compute angular differences clockwise? Let's compute difference modulo 2π.
                def diff(a,b):
                    # smallest positive angle from a to b moving CCW
                    d = (b - a) % (2*math.pi)
                    return d
                dYQ = diff(θYn, θQn)
                dYP = diff(θYn, θPn)
                # If P lies on minor arc YQ, then dYP < dYQ
                P_on_minor = dYP < dYQ
                # We need P not on that arc, so P_on_minor should be False.
                condArc = not P_on_minor
                # also S should be on that minor arc YQ (i.e., between Y and Q CCW)
                dYS = diff(θYn, θSn)
                condS = dYS < dYQ
                return {
