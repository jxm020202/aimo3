            def compute_orthocenter(verts):
                a1,a2,a3,a4 = verts
                n1 = np.cross(a2-a3, a2-a4)  # normal to face a2,a3,a4
                n2 = np.cross(a1-a3, a1-a4)  # normal to face a1,a3,a4
                # Solve a1 + s n1 = a2 + t n2
                # 3 equations, 2 unknowns; should be consistent
                A = np.column_stack((n1, -n2))  # 3x2 matrix
                b = a2 - a1
                # least squares solve for s,t
                sol, residuals, rank, s = np.linalg.lstsq(A, b, rcond=None)
                s_val, t_val = sol
                K = a1 + s_val * n1
                return K
            
