            def base7_digits(n):
                # return list of digits from most significant to least
                if n == 0:
                    return [0]
                digs = []
                while n>0:
                    digs.append(n%7)
                    n//=7
                return digs[::-1]
            
            def delete_digit_at_pos(digits, pos):
                # pos from 0 (least significant) to len-1 (most)
                # remove digit at that position (count from right)
                idx = len(digits)-1-pos
                new = digits[:idx] + digits[idx+1:]
                # interpret as base7 number (allow leading zeros? If new list empty -> 0)
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
            def sum_deletions(n, include_most=True):
                digs = base7_digits(n)
                m = len(digs)-1
                total = 0
                # i from 0 to m inclusive if include_most else to m-1
                max_i = m if include_most else m-1
                for i in range(0, max_i+1):
                    total += delete_digit_at_pos(digs, i)
                return total
            
            def find_solutions(limit, include_most=True):
                sols = []
                for n in range(1, limit+1):
                    if n == sum_deletions(n, include_most):
                        sols.append(n)
                return sols
            
