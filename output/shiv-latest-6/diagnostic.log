        ```python
import sympy as sp

# define symbols
θ, φ = sp.symbols('θ φ', real=True)

# coordinates on unit circle
X = sp.Matrix([sp.cos(θ), sp.sin(θ)])          # X above x-axis
Y = sp.Matrix([1, 0])                         # Y at (1,0)
Z = sp.Matrix([sp.cos(φ), -sp.sin(φ)])        # Z below x-axis (φ>0)

# nine‑point center N = (X+Y+Z)/2  (since circumcenter O is origin)
N = (X + Y + Z) / 2

# we take P = N (i.e. t = 1, Y‑P‑N collinear trivially)
P = N

# vectors from vertices to P
XP = P - X
YP = P - Y
ZP = P - Z

# dot products
dot_XP_YP = XP.dot(YP)
dot_YP_ZP = YP.dot(ZP)

# squared lengths
norm2_XP = XP.dot(XP)
norm2_YP = YP.dot(YP)
norm2_ZP = ZP.dot(ZP)

# angle 120° condition: dot = -½·|a||b|
eq1 = sp.simplify(dot_XP_YP + sp.Rational(1,2)*sp.sqrt(norm2_XP*norm2_YP))
eq2 = sp.simplify(dot_YP_ZP + sp.Rational(1,2)*sp.sqrt(norm2_YP*norm2_ZP))

# solve numerically for θ and φ
sol = sp.nsolve([eq1, eq2], (θ, φ), (1.0, 1.0), tol=1e-14, maxsteps=100)
sol
