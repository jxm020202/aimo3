            def compose_quad(a2,a1,a0,b2,b1,b0):
                # returns coefficients of f(g(x)) as dict degree->coeff
                # compute g(x) = b2 x^2 + b1 x + b0
                # g^2 = (b2 x^2 + b1 x + b0)^2
                # Expand:
                # (b2^2) x^4 + 2*b2*b1 x^3 + (2*b2*b0 + b1^2) x^2 + 2*b1*b0 x + b0^2
                coeff = {}
                # f(g) = a2 * g^2 + a1 * g + a0
                # degree 4 term:
                coeff[4] = a2 * (b2**2)
                # degree 3 term:
                coeff[3] = a2 * (2*b2*b1) + a1 * b2
                # degree 2 term:
                coeff[2] = a2 * (2*b2*b0 + b1**2) + a1 * b1
                # degree 1 term:
                coeff[1] = a2 * (2*b1*b0) + a1 * b0
                # degree 0 term:
                coeff[0] = a2 * (b0**2) + a0
                return coeff
            
            def compose_quad_g_of_f(b2,b1,b0,a2,a1,a0):
                # compute g(f(x))
                # f(x) = a2 x^2 + a1 x + a0
                # f^2 = (a2 x^2 + a1 x + a0)^2
                coeff = {}
