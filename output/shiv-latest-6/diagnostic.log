            def find_labeling(n, target_sum):
                # backtrack row by row
                grid = [[None]*n for _ in range(n)]
                # Precompute parity: (i+j) % 2
                def dfs(cell_idx, current_sum):
                    if current_sum > target_sum:
                        return None
                    if cell_idx == n*n:
                        if current_sum == target_sum:
                            return [row[:] for row in grid]
                        return None
                    i = cell_idx // n
                    j = cell_idx % n
                    # Determine possible values based on already placed neighbors
                    possible = set()
                    # neighbor up
                    if i>0 and grid[i-1][j] is not None:
                        possible.update({grid[i-1][j]-1, grid[i-1][j]+1})
                    # neighbor left
                    if j>0 and grid[i][j-1] is not None:
                        left_vals = {grid[i][j-1]-1, grid[i][j-1]+1}
                        if possible:
                            possible = possible.intersection(left_vals)
                        else:
                            possible = left_vals
                    if not possible:
                        # no constraints yet, can choose any nonnegative integer up to some bound
                        # bound: target_sum - current_sum (remaining)
                        max_val = target_sum - current_sum
                        # also limit to maybe target_sum for practicality
                        possible = set(range(max_val+1))
                    # iterate possible values in some order
                    for val in sorted(possible):
                        if val < 0:
                            continue
                        # quick prune: remaining cells minimal sum assuming minimal pattern for rest
                        # Not needed for small n
                        grid[i][j] = val
                        res = dfs(cell_idx+1, current_sum+val)
                        if res:
                            return res
                        grid[i][j] = None
                    return None
                return dfs(0,0)
            
