            def S_formula(digs):
                m = len(digs)-1
                total = 0
                for k in range(0,m):
                    b = digs[k]
                    total += b * (k * 7**(k-1) + (m-1 - k) * 7**k)
                # k=m term
                b = digs[m]
                total += b * m * 7**(m-1)
                return total
            
