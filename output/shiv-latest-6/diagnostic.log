            def imag_part(A, B):
                C = math.pi - A - B
                if C <= 0:
                    return None
                a = 1+0j
                b = cmath.exp(1j*2*C)
                c = cmath.exp(1j*2*(C + A))
                # compute Fermat point using barycentric weights
                alpha = 1/math.sin(A + math.pi/3)
                beta = 1/math.sin(B + math.pi/3)
                gamma = 1/math.sin(C + math.pi/3)
                F = (alpha*a + beta*b + gamma*c) / (alpha + beta + gamma)
                N = (a + b + c)/2
                val = (F - b) / (N - b)
                return val.imag
            
            def find_solution_for_B(B):
                # search A in (0, pi-B) for root of imag_part
                # Use scanning
                n=200
