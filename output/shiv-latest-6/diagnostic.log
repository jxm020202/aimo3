        def find_good_solutions_numeric(A,B,C):
    # use sympy nsolve with random starts
    x,y = sp.symbols('x y')
    D = sp.Point(x,y)
    def second(P,Q):
        t = sp.symbols('t')
        X = P + t*(Q-P)
        eq = (X.distance(D))**2 - (P.distance(D))**2
        sol = sp.solve(eq, t)
        t_vals = [s for s in sol if not sp.simplify(s)==0]
        return sp.simplify(P + t_vals[0]*(Q-P))
    A_b = second(sp.Point(*A), sp.Point(*B))
    A_c = second(sp.Point(*A), sp.Point(*C))
    B_a = second(sp.Point(*B), sp.Point(*A))
    B_c = second(sp.Point(*B), sp.Point(*C))
    C_a = second(sp.Point(*C), sp.Point(*A))
    C_b = second(sp.Point(*C), sp.Point(*B))
    circle = sp.Circle(A_b, B_a, C_a)
    O = circle.center
    R2 = circle.radius**2
    eq1 = O.distance(A_c)**2 - R2
    eq2 = O.distance(B_c)**2 - R2
    eq3 = O.distance(C_b)**2 - R2
    sols=set()
    for guess in [(random.uniform(-5,5), random.uniform(-5,5)) for _ in range(20)]:
        try:
            sol = sp.nsolve([eq1,eq2,eq3], (x,y), guess, tol=1e-14, maxsteps=100)
            sol = (float(sol[0]), float(sol[1]))
            # round
            solr = (round(sol[0],10), round(sol[1],10))
            sols.add(solr)
        except Exception as e:
            pass
    return sols

