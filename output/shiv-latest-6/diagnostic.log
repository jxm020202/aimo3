            import random, math, numpy as np, itertools, sys, sympy as sp, math, numpy.linalg as la
            def random_tetra():
                # generate 4 random points not coplanar
                while True:
                    pts = np.random.randn(4,3)
                    # ensure not coplanar: volume non-zero
                    v = np.linalg.det(np.column_stack((pts[1]-pts[0], pts[2]-pts[0], pts[3]-pts[0])))
                    if abs(v) > 1e-6:
                        return pts
            
            def circumcenter(pts):
                # Solve for center O such that |Oi - O|^2 = |Oj - O|^2 for i,j
                # Use linear equations: 2*(pj - p1)·O = |pj|^2 - |p1|^2
                p1 = pts[0]
                A = []
                b = []
                for j in range(1,4):
                    pj = pts[j]
                    A.append(2*(pj - p1))
                    b.append(np.dot(pj,pj) - np.dot(p1,p1))
                A = np.array(A)
                b = np.array(b)
                O = np.linalg.solve(A,b)
                return O
            
            def orthocenter(pts):
                # compute normals for each vertex
                normals = []
                for i in range(4):
                    others = [j for j in range(4) if j!=i]
                    a,b,c = [pts[j] for j in others]
                    n = np.cross(b-a, c-a)  # normal direction (not unit)
                    normals.append(n)
                # intersect lines a_i + t_i n_i
                # Solve using least squares for t_i maybe
                # Use first two lines to solve for K
                # a1 + t1 n1 = a2 + t2 n2
                A = np.column_stack((normals[0], -normals[1]))
                rhs = pts[1] - pts[0]
                t = np.linalg.lstsq(A, rhs, rcond=None)[0]
                K = pts[0] + t[0]*normals[0]
                # verify with other lines
                return K
            
            def foot_of_altitude(a1, face_pts):
                # plane defined by three points
                p,q,r = face_pts
                normal = np.cross(q-p, r-p)
                # projection of a1 onto plane: X = a1 - ((a1-p)·n)/|n|^2 * n
                n = normal
                X = a1 - np.dot(a1-p, n)/np.dot(n,n) * n
                return X
            
            def compute_ratio(pts):
                C = circumcenter(pts)
                # translate so C at origin
                pts0 = pts - C
                K = orthocenter(pts0)
                a1 = pts0[0]
                # normals
                normals = []
                for i in range(4):
                    others = [j for j in range(4) if j!=i]
                    a,b,c = [pts0[j] for j in others]
                    n = np.cross(b-a, c-a)
                    normals.append(n)
                n1 = normals[0]
                # foot X
                X = foot_of_altitude(a1, pts0[1:4])
                # find Y: second intersection of line a1 + t n1 with sphere radius R (R = |a1|)
                R = np.linalg.norm(a1)
                # solve |a1 + t n|^2 = R^2
                # (a1 + t n)·(a1 + t n) = R^2 => |a1|^2 + 2 t a1·n + t^2 |n|^2 = R^2 = |a1|^2
                # => 2 t a1·n + t^2 |n|^2 = 0 => t (2 a1·n + t |n|^2) =0
                # solutions t=0 and t = -2 (a1·n)/|n|^2
                tY = -2*np.dot(a1, n1)/np.dot(n1,n1)
                Y = a1 + tY * n1
                KX = np.linalg.norm(K - X)
                KY = np.linalg.norm(K - Y)
                return KX/KY
            
            for _ in range(5):
                pts = random_tetra()
                ratio = compute_ratio(pts)
                print(ratio)
            
