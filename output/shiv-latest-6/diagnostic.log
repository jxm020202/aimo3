                # Use coordinates
                A = np.array([p1.real, p1.imag])
                B = np.array([p2.real, p2.imag])
                C = np.array([p3.real, p3.imag])
                # circumcenter
                def circumcenter(A,B,C):
                    D = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                    Ux = ((np.linalg.norm(A)**2)*(B[1]-C[1]) + (np.linalg.norm(B)**2)*(C[1]-A[1]) + (np.linalg.norm(C)**2)*(A[1]-B[1]))/D
                    Uy = ((np.linalg.norm(A)**2)*(C[0]-B[0]) + (np.linalg.norm(B)**2)*(A[0]-C[0]) + (np.linalg.norm(C)**2)*(B[0]-A[0]))/D
                    return np.array([Ux, Uy])
                O = circumcenter(A,B,C)
                # orthocenter H = A + B + C - 2*O (Euler line property)
                H = A + B + C - 2*O
                N = (O + H)/2
                return N
            
            def angle_at(p1,p2,p3):
                # angle at p2 formed by p1-p2-p3
                v1 = np.array([p1.real, p1.imag]) - np.array([p2.real, p2.imag])
                v2 = np.array([p3.real, p3.imag]) - np.array([p2.real, p2.imag])
                dot = np.dot(v1,v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                return math.degrees(math.acos(dot/norm))
            
