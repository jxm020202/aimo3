            def compute_S(u_val, v_val, k_val):
                # compute P, Q, S as earlier
                u, v, k = sp.symbols('u v k')
                c = sp.sqrt(u**2 + v**2)
                a = sp.sqrt((1 - u)**2 + v**2)
                lam = sp.Rational(1,4) / (c**2)
                mu = sp.Rational(1,4) / (a**2)
                P = sp.Point(lam*u, lam*v)
                Q = sp.Point(1 + mu*(u - 1), mu*v)
                vvec = sp.Point(P.x - 1, P.y)
                sin60n = -sp.sqrt(3)/2
                cos60 = sp.Rational(1,2)
                S = sp.Point(1 + vvec.x*cos60 - vvec.y*sin60n,
                             vvec.x*sin60n + vvec.y*cos60)
                # substitute values
                subs = {u:u_val, v:v_val, k:k_val}
                Pn = P.subs(subs)
                Qn = Q.subs(subs)
                Sn = S.subs(subs)
                return Pn, Qn, Sn
            
