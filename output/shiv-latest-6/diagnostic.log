            import numpy as np, itertools, math, sys, time
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def find_set(n, time_limit=30):
                targets = [F[k] for k in range(2,126)]
                m = len(targets)
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                P = len(pairs)
                total_vars = n + m*P
                # Objective zero
                c = np.zeros(total_vars)
                # integrality: first n integer, rest binary (2)
                integrality = np.concatenate([np.ones(n, dtype=int), np.full(m*P, 2, dtype=int)])
                # bounds: x_i between 0 and max_target
                max_target = targets[-1]
                lb = np.concatenate([np.zeros(n), np.zeros(m*P)])  # binary lower bound 0
                ub = np.concatenate([np.full(n, max_target), np.ones(m*P)])  # binary upper bound 1
                bounds = Bounds(lb, ub)
                # Build constraints
                # We'll collect rows for A_ub x <= b_ub
                rows = []
                b = []
                # 1) covering constraints: sum_{pairs} y_{t,pair} >= 1 => -sum y <= -1
                for t_idx in range(m):
                    row = np.zeros(total_vars)
                    # y variables start at offset n
                    offset = n + t_idx*P
                    row[offset:offset+P] = -1  # -y
                    rows.append(row)
                    b.append(-1)
                # 2) linking constraints for each t and pair
                M = max_target
                for t_idx, target in enumerate(targets):
                    offset = n + t_idx*P
                    for p_idx, (i,j) in enumerate(pairs):
                        y_index = offset + p_idx
                        # constraint: x_j - x_i - target <= M*(1 - y)
                        row = np.zeros(total_vars)
                        row[j] = 1
                        row[i] = -1
                        row[y_index] = M  # bring M*y to left: x_j - x_i - target - M + M*y <= 0 => x_j - x_i - target + M*y <= M
                        # Actually we want: x_j - x_i - target <= M*(1 - y)
                        # => x_j - x_i - target - M*(1 - y) <= 0
                        # => x_j - x_i - target - M + M*y <= 0
                        # => x_j - x_i + M*y <= target + M
                        # Let's implement as: x_j - x_i + M*y <= target + M
                        row = np.zeros(total_vars)
                        row[j] = 1
                        row[i] = -1
                        row[y_index] = M
                        rows.append(row)
                        b.append(target + M)
                        # second constraint: -(x_j - x_i - target) <= M*(1 - y)
                        # => -x_j + x_i + target <= M*(1 - y)
                        # => -x_j + x_i + target - M + M*y <= 0
                        # => -x_j + x_i + M*y <= M - target
                        row2 = np.zeros(total_vars)
                        row2[j] = -1
                        row2[i] = 1
                        row2[y_index] = M
                        rows.append(row2)
                        b.append(M - target)
                # 3) ordering constraints: x_i <= x_{i+1} - 1 => x_i - x_{i+1} <= -1
                for i in range(n-1):
                    row = np.zeros(total_vars)
                    row[i] = 1
                    row[i+1] = -1
                    rows.append(row)
                    b.append(-1)
                # Build A_ub matrix
                A_ub = np.vstack(rows)
                b_ub = np.array(b)
                # Define linear constraints
                lin_con = LinearConstraint(A_ub, -np.inf, b_ub)  # only upper bounds
                # Solve MILP
                start = time.time()
                res = milp(c, integrality=integrality, bounds=bounds, constraints=lin_con, options={'presolve': True, 'time_limit': time_limit})
                elapsed = time.time() - start
                print("Status:", res.message, "time", elapsed)
                if res.success:
                    x_vals = res.x
                    S = [int(round(v)) for v in x_vals[:n]]
                    S.sort()
                    return S
                else:
                    return None
            
            # Try n=12 first (lower bound)
            print("Attempt n=12")
            S12 = find_set(12, time_limit=10)
            print("Result:", S12)
            
