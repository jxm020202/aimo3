    for i in range(n):
        for j in range(n):
            vec = np.zeros(n*n, dtype=np.uint8)
            for col in range(n):
                vec[i*n+col]=1
            for row in range(n):
                vec[row*n+j] ^= 1
            vec[i*n+j]=1
            vectors.append(vec)
    M = np.array(vectors, dtype=np.uint8)
    # nullspace
    def nullspace_mod2(A):
        m, n = A.shape
        M = A.copy()
        row=0
        pivots=[]
        for col in range(n):
            piv=None
            for r in range(row,m):
                if M[r,col]:
                    piv=r
                    break
            if piv is None:
                continue
            if piv!=row:
                M[[piv,row]]=M[[row,piv]]
            for r in range(m):
                if r!=row and M[r,col]:
                    M[r]^=M[row]
            pivots.append(col)
            row+=1
            if row==m:
                break
        free=[c for c in range(n) if c not in pivots]
        basis=[]
        for f in free:
            vec=np.zeros(n,dtype=np.uint8)
            vec[f]=1
            for i,p in enumerate(pivots):
                if M[i,f]:
                    vec[p]^=1
            basis.append(vec)
        return np.array(basis,dtype=np.uint8)
    H = nullspace_mod2(M)
    return M, H

