            def apply_op(board, i, j):
                # board is list of 0/1 length 361
                size=19
                new = board[:]
                # flip row i
                for col in range(size):
                    idx = i*size + col
                    new[idx] ^= 1
                # flip column j
                for row in range(size):
                    idx = row*size + j
                    new[idx] ^= 1
                # flip intersection again to make single flip (since flipped twice)
                idx = i*size + j
                new[idx] ^= 1
