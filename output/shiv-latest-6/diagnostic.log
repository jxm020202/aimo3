            import numpy as np
            
            def points_from_params(r1_val, h_val):
                d = 15.0
                r2_val = d - r1_val
                # compute Dnorm
                Dnorm = np.sqrt(225.0 + 4.0*h_val**2)
                # foot F1
                F1x = 15.0 * r1_val**2 / (225.0 + 4.0*h_val**2)
                F1y = 2.0*h_val * r1_val**2 / (225.0 + 4.0*h_val**2)
                # half chord length for Gamma1
                d1 = r1_val**2 / Dnorm
                half_len1 = np.sqrt(max(r1_val**2 - d1**2, 0.0))
                # direction vector v1 = (-2h, 15)
                v1x = -2.0*h_val
                v1y = 15.0
                # offset
                off1x = v1x * half_len1 / Dnorm
                off1y = v1y * half_len1 / Dnorm
                # Upper R
                Rx = F1x + off1x
                Ry = F1y + off1y
                # Lower Q
                Qx = F1x - off1x
                Qy = F1y - off1y
                
                # foot F2
                # F2 = (15 - 15*r2^2/Dnorm2, 2h*r2^2/Dnorm2)
                Dnorm2 = 225.0 + 4.0*h_val**2
                F2x = 15.0 - 15.0 * r2_val**2 / Dnorm2
                F2y = 2.0*h_val * r2_val**2 / Dnorm2
                # half chord length for Gamma2
                d2 = r2_val**2 / Dnorm
                half_len2 = np.sqrt(max(r2_val**2 - d2**2, 0.0))
                # direction v2 = (2h, 15)
                v2x = 2.0*h_val
                v2y = 15.0
                off2x = v2x * half_len2 / Dnorm
                off2y = v2y * half_len2 / Dnorm
                # Upper T
                Tx = F2x + off2x
                Ty = F2y + off2y
                # Lower S
                Sx = F2x - off2x
                Sy = F2y - off2y
                
                return (np.array([Sx, Sy]), np.array([Qx, Qy]), np.array([Rx, Ry]), np.array([Tx, Ty]))
                
            def distances(r1_val, h_val):
                S, Q, R, T = points_from_params(r1_val, h_val)
                SQ = np.linalg.norm(S - Q)
                RT = np.linalg.norm(R - T)
                # also compute other distances
                ST = np.linalg.norm(S - T)
                QR = np.linalg.norm(Q - R)
                return SQ, RT, ST, QR
            
            # test with some random values
            print(distances(5.0, 4.0))
            
