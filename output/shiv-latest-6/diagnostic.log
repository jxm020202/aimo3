            def base7_digits(num):
                # return list of digits from most significant to least
                if num == 0:
                    return [0]
                digs = []
                while num > 0:
                    digs.append(num % 7)
                    num //= 7
                return digs[::-1]
            
            def remove_digit_from_number(num, digit):
                # num given as integer, interpret its base-7 representation, remove all occurrences of digit (value 0-6)
                digs = base7_digits(num)
                new = [d for d in digs if d != digit]
                if not new:
                    return 0
                # interpret new list as base-7 number
                val = 0
                for d in new:
                    val = val * 7 + d
                return val
            
            def satisfies(n):
                # compute base-7 digits of n
                digs = base7_digits(n)
                m = len(digs) - 1
                if m <= 0:  # require positive integer m?
                    return False
                # compute a_i for i=0..m-1
                total = 0
                for i in range(m):
                    b_i = digs[-1 - i]  # b_i is digit at position i (least significant index i)
                    # Actually b_0 is least significant digit (rightmost). So we need b_i accordingly.
                    # base7_digits returns most significant first, so index from left.
                    # Let's compute b_i using position from right.
                    b_i = digs[-1 - i]
                    a_i = remove_digit_from_number(m, b_i)
                    total += a_i
                return total == n
            
            def find_solutions(limit):
                sols = []
                for n in range(1, limit+1):
                    if satisfies(n):
                        sols.append(n)
                return sols
            
            sols = find_solutions(50000)
            len(sols), sols[:20]
            
