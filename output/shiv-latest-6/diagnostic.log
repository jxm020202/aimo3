            import numpy as np, math
            
            def rotate(vec, angle):
                c = math.cos(angle)
                s = math.sin(angle)
                return np.array([c*vec[0] - s*vec[1], s*vec[0] + c*vec[1]])
            
            def fermat_point_np(A, B, C):
                # A,B,C are np arrays
                # side BC
                vecBC = C - B
                D1 = B + rotate(vecBC, math.radians(60))
                # cross product z-component
                def cross(u,v):
                    return u[0]*v[1] - u[1]*v[0]
                sideA = cross(vecBC, A - B)
                sideD1 = cross(vecBC, D1 - B)
                if sideA * sideD1 > 0:
                    D = B + rotate(vecBC, -math.radians(60))
                else:
                    D = D1
                # side AC
                vecAC = C - A
                E1 = A + rotate(vecAC, math.radians(60))
                sideB = cross(vecAC, B - A)
                sideE1 = cross(vecAC, E1 - A)
                if sideB * sideE1 > 0:
                    E = A + rotate(vecAC, -math.radians(60))
                else:
                    E = E1
                # intersect lines AD and BE
                # solve A + t*(D-A) = B + s*(E-B)
                P = np.column_stack((D - A, -(E - B)))  # 2x2 matrix
                rhs = B - A
                try:
                    t_s = np.linalg.solve(P, rhs)
                except np.linalg.LinAlgError:
                    return None
                t = t_s[0]
                F = A + t*(D - A)
                return F
            
            def nine_point_center(A,B,C):
                # circumcenter O is origin for unit circle case; but we can compute generally.
                # Let's compute O via perpendicular bisectors.
                # Use formula for circumcenter.
                def circumcenter(A,B,C):
                    D = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                    Ux = ((np.dot(A,A))*(B[1]-C[1]) + (np.dot(B,B))*(C[1]-A[1]) + (np.dot(C,C))*(A[1]-B[1]))/D
                    Uy = ((np.dot(A,A))*(C[0]-B[0]) + (np.dot(B,B))*(A[0]-C[0]) + (np.dot(C,C))*(B[0]-A[0]))/D
                    return np.array([Ux, Uy])
                O = circumcenter(A,B,C)
                # orthocenter H = A + B + C - O*? Actually vector relation: O is circumcenter, H = A + B + C - 2O? Wait Euler line: O, G, H.
                # In coordinates, for circumcenter O, we have OA, OB, OC are radii. Orthocenter H = A + B + C - 2O? Let's verify.
                # For triangle with circumcenter at origin, H = A + B + C (since O=0). For general O, translate.
                # So compute H = A + B + C - 2*O? Let's test with simple triangle.
                H = A + B + C - 2*O
                N = (O + H)/2
                return N
            
            def test_angle(B_deg):
                A_deg = 70
                C_deg = 110 - B_deg
                # Build triangle on unit circle as before
                A_rad = math.radians(A_deg)
                B_rad = math.radians(B_deg)
                C_rad = math.radians(C_deg)
                # using central angles method
                A_pt = np.array([math.cos(0), math.sin(0)])
                B_pt = np.array([math.cos(2*C_rad), math.sin(2*C_rad)])
                C_pt = np.array([math.cos(2*C_rad+2*A_rad), math.sin(2*C_rad+2*A_rad)])
                F = fermat_point_np(A_pt, B_pt, C_pt)
                N = nine_point_center(A_pt, B_pt, C_pt)
                # collinearity of Y (which is B_pt) with F and N
                cross = (F - B_pt)[0]*(N - B_pt)[1] - (F - B_pt)[1]*(N - B_pt)[0]
                return cross
            
            for B in [30,40,50,60,70,80]:
                print(B, test_angle(B))
            
