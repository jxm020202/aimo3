            def foot_of_perpendicular(point, plane_pts):
                # point is a1, plane defined by three points
                p0, p1, p2 = plane_pts
                # plane normal
                n = np.cross(p1-p0, p2-p0)
                n = n / la.norm(n)
                # distance from point to plane along normal
                d = np.dot(point - p0, n)
                foot = point - d*n
                return foot
            
