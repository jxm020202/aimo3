            def find_digit_sequences(L):
                solutions=[]
                # recursion: b_{k+1} = (L-3) b_k / (6 (k+1))
                # L=8 => factor =5
                factor = L-3
                def recurse(k, digits):
                    # digits list currently contains b_0..b_k
                    if k == L-1:
                        # we have full length
                        # ensure most significant digit non-zero
                        if digits[-1] != 0:
                            solutions.append(list(digits))
                        return
                    # compute next digit b_{k+1}
                    denom = 6*(k+1)
                    # b_k is digits[-1]
                    b_k = digits[-1]
                    # we need b_{k+1} integer 0..6 satisfying factor * b_k = denom * b_{k+1}
                    # So b_{k+1} = factor * b_k / denom, must be integer.
                    if factor * b_k % denom == 0:
                        b_next = factor * b_k // denom
                        if 0 <= b_next <= 6:
                            recurse(k+1, digits + [b_next])
                    # also we could allow b_{k+1}=0 regardless? Actually if factor * b_k = denom * b_{k+1}, the equation must hold. If b_k =0, then RHS zero, so b_{k+1}=0 works.
                    # Already covered because factor * 0 % denom ==0 yields b_next=0.
                # start with any b_0 in 0..6
                for b0 in range(0,7):
                    recurse(0, [b0])
                return solutions
            
