            def second_intersection_on_sphere(a1, K):
                d = K - a1
                # solve |a1 + t d|^2 = 1
                # (a1 + t d)·(a1 + t d) = 1
                A = np.dot(d,d)
                B = 2*np.dot(a1,d)
                Cc = np.dot(a1,a1) - 1
                # quadratic A t^2 + B t + Cc =0
                roots = np.roots([A,B,Cc])
                # choose root not zero (t=0 corresponds to a1)
                t_vals = [t for t in roots if abs(t) > 1e-8]
                t = t_vals[0]
                Y = a1 + t*d
                return Y
            
            Y = second_intersection_on_sphere(a1, K)
            Y
            
