            def gf2_nullspace(A):
                # returns list of basis vectors for nullspace of A (rows as constraints)
                m, n = A.shape
                # Perform Gaussian elimination and keep track of pivot columns
                A = A.copy()
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot row
                    rows_with_one = np.where(A[row:, col]==1)[0]
                    if rows_with_one.size==0:
                        continue
                    i = rows_with_one[0] + row
                    # swap
                    if i != row:
                        A[[row,i]] = A[[i,row]]
                    # eliminate other rows
                    for r in range(m):
                        if r!=row and A[r,col]==1:
                            A[r] ^= A[row]
                    pivot_cols.append(col)
                    row += 1
                    if row==m:
                        break
                free_cols = [c for c in range(n) if c not in pivot_cols]
                basis=[]
                for free in free_cols:
