            def possible_low_values_up_to(n, limit):
                mod = n*n
                counts = {}
                for s in range(2, 2*n+1):
                    if s <= n+1:
                        counts[s] = s-1
                    else:
                        counts[s] = 2*n+1 - s
                L = 2*n-2
                dp = {(0,0): 0}  # (S, minS) -> acc (minimal)
                low_set = set()
                for step in range(L):
                    k = step + 2
                    c = counts[k+1]
                    new_dp = {}
                    for (S, minS), acc in dp.items():
                        for eps in (+1, -1):
                            S2 = S + eps
                            minS2 = min(minS, S2)
                            acc2 = acc + S2*c
                            # we keep all possibilities (not pruning)
                            key = (S2, minS2)
                            # keep minimal acc for each state
                            if key not in new_dp or acc2 < new_dp[key]:
                                new_dp[key] = acc2
                    dp = new_dp
                for (S, minS), acc in dp.items():
                    low = acc - minS * mod
                    if low <= limit:
                        low_set.add(low)
                return low_set
            
