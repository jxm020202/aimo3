            def nullspace_gf2(A):
                # A: m x n matrix over GF(2) (numpy uint8)
                A = A.copy()
                m, n = A.shape
                # Perform Gaussian elimination to row echelon form, keep track of pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot row >= row with A[i,col]=1
                    piv = None
                    for i in range(row, m):
                        if A[i,col]:
                            piv = i
                            break
                    if piv is None:
                        continue
                    # swap rows
                    if piv != row:
                        A[[row, piv]] = A[[piv, row]]
                    # eliminate other rows
                    for i in range(m):
                        if i != row and A[i,col]:
                            A[i] ^= A[row]
                    pivot_cols.append(col)
                    row += 1
                    if row == m:
                        break
                # Now A is in reduced row echelon form
                # Free columns are those not in pivot_cols
                free_cols = [c for c in range(n) if c not in pivot_cols]
                # For each free column, construct a nullspace basis vector
                basis = []
                for free in free_cols:
                    vec = np.zeros(n, dtype=np.uint8)
                    vec[free] = 1
                    # For each pivot row, set pivot column based on row's entry in free column
                    # In RREF, each pivot column has a leading 1 and zeros elsewhere.
                    # The relationship is: pivot_var + sum_{free} (coeff) * free_var = 0
                    # Since we have eliminated other rows, the pivot column entry in that row is 1,
                    # and the row may have other 1s in free columns. So we set pivot var = sum of those free vars.
                    # For each pivot row i, pivot column = pivot_cols[i]
                    for i, pivcol in enumerate(pivot_cols):
                        if A[i, free]:
                            vec[pivcol] = 1  # because pivot + free = 0 => pivot = free (since over GF2)
                    basis.append(vec)
                return np.array(basis, dtype=np.uint8)
            
            # compute nullspace of G (as numpy array)
            G_np = np.array(G.tolist(), dtype=np.uint8) % 2
            null_basis = nullspace_gf2(G_np)
