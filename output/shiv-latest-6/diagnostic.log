            def min_total_for_n(n):
                # compute counts c_s for s = 2..2n
                counts = {}
                for s in range(2, 2*n+1):
                    if s <= n+1:
                        counts[s] = s-1
                    else:
                        counts[s] = 2*n+1 - s
                # DP: dictionary mapping (current S, minS) -> minimal accumulated sum of S_k * c_{k+1} up to current k
                # start at k=1 (S_1 = 0, minS = 0), accumulated sum = 0 (since S_1 corresponds to c_{2})
                dp = {(0,0):0}
                # iterate k from 2 to 2n-1 (inclusive). At each step we compute S_k (after adding epsilon_k)
                # The contribution of S_k to total sum uses c_{k+1}
                for k in range(2, 2*n):
                    c = counts[k+1]  # c_{k+1}
                    new_dp = {}
                    for (S, minS), acc in dp.items():
                        for eps in (+1, -1):
                            S2 = S + eps
                            minS2 = min(minS, S2)
                            acc2 = acc + S2 * c
                            key = (S2, minS2)
                            if key not in new_dp or acc2 < new_dp[key]:
                                new_dp[key] = acc2
                    dp = new_dp
                # after loop, we have processed up to k=2n-1, with S_{2n-1} and minS.
                # total = accumulated sum - minS * n^2
                best = None
                for (S, minS), acc in dp.items():
                    total = acc - minS * n * n
                    if best is None or total < best:
                        best = total
                return best
            
