                # compute coefficients c_j = 7**j * (6*j + 14 - 7*m)
                coeffs = [7**j * (6*j + 14 - 7*m) for j in range(m+1)]
                # recursion from most significant j=m down to 0
                # we will keep running sum of contributions.
                # At each step, we have remaining indices list.
                # Precompute for each index the min and max possible sum from that index downwards.
                # For pruning, we compute remaining_min[j] = sum_{k=0}^{j-1} min_contrib(k) where min_contrib depends on sign of coeff.
                # Actually we can compute suffix min/max.
                suffix_min = [0]*(m+2)
                suffix_max = [0]*(m+2)
                # suffix from index 0 up to j-1? Let's compute suffix for positions < current index.
                # We'll fill from low to high.
                for j in range(m+1):
                    c = coeffs[j]
                    if c >= 0:
                        min_c = 0
                        max_c = 6*c
                    else:
                        min_c = 6*c
                        max_c = 0
                    suffix_min[j+1] = suffix_min[j] + min_c
                    suffix_max[j+1] = suffix_max[j] + max_c
                # suffix_min[j] = min possible sum from digits 0..j-1
                # We'll use while recursing from high to low, we need remaining min/max for lower indices.
                solutions = []
                def dfs(pos, current_sum, digits):
