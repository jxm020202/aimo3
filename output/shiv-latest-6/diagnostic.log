            import sympy as sp
            
            def find_solution(m,n,lead_min=1):
                # variables for coefficients: assume monic? We'll include leading coeff a,b
                a = sp.symbols('a', integer=True)
                b = sp.symbols('b', integer=True)
                # other coefficients for f: c0..c_{m-1}
                coeffs_f = sp.symbols('f0:'+str(m))
                coeffs_g = sp.symbols('g0:'+str(n))
                # Build polynomials
                x=sp.symbols('x')
                f = a*x**m + sum(coeffs_f[i]*x**i for i in range(m))
                g = b*x**n + sum(coeffs_g[i]*x**i for i in range(n))
                k = sp.symbols('k', integer=True)
                expr = sp.expand(f.subs(x,g) - 3*g.subs(x,f) - k)
                # collect coefficients
                equations = [sp.Eq(sp.expand(expr).coeff(x,i),0) for i in range(m*n+1)]
                # solve linear equations for unknowns except a,b,k maybe nonlinear due to powers a,b.
                # This is nonlinear due to a,b powers in compositions.
                return len(equations)
            print(find_solution(2,2))
            
