                # cross product of (P-Y) and (N-Y) should be zero (imag part of conj(P-Y)*(N-Y))
                val = (P - Y).conjugate() * (N - Y)
                return val.imag
            
            def is_solution(beta,gamma,eps=1e-6):
                val = collinearity_condition(beta,gamma)
                return val is not None and abs(val) < eps
            
