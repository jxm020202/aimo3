            def base7_digits(n):
                # returns list of digits most significant first
                if n == 0:
                    return [0]
                digs = []
                while n > 0:
                    digs.append(n % 7)
                    n //= 7
                return digs[::-1]
            
            def remove_digit_at_position(digits, i):
                # digits: list most->least
                # i: exponent index from least (0 = least)
                idx = len(digits) - 1 - i
                new = digits[:idx] + digits[idx+1:]
                # convert new digits to integer
                val = 0
                for d in new:
                    val = val*7 + d
                return val
            
            def satisfies(n):
                digits = base7_digits(n)
                m = len(digits)-1  # highest exponent
                # sum over i=0..m-1
                total = 0
                for i in range(m):
                    total += remove_digit_at_position(digits, i)
                return total == n
            
            def find_solutions(limit):
                sols = []
                for n in range(1, limit+1):
                    if satisfies(n):
                        sols.append(n)
                return sols
            
