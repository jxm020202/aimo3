            from collections import deque
            
            def covering_radius_bfs(size):
                n=size*size
                ops=[]
                for i in range(size):
                    for j in range(size):
                        vec=[0]*n
                        for k in range(size):
                            vec[i*size + k]=1
                            vec[k*size + j]=1
                        ops.append(vec)
                # compute basis rows via Gaussian elimination to get subspace S as set of vectors? We'll generate all vectors via basis enumeration (size manageable)
                # get basis rows
                def gf2_basis(matrix):
                    A=[row[:] for row in matrix]
                    rows=len(A)
                    cols=len(A[0])
                    r=0
                    basis=[]
                    for c in range(cols):
                        piv=None
                        for i in range(r, rows):
                            if A[i][c]:
                                piv=i
                                break
                        if piv is None:
                            continue
                        A[r],A[piv]=A[piv],A[r]
                        basis.append(A[r][:])
                        for i in range(rows):
                            if i!=r and A[i][c]:
                                A[i]=[a^b for a,b in zip(A[i],A[r])]
                        r+=1
                        if r==rows:
                            break
                    return basis
                basis = gf2_basis(ops)
                dim=len(basis)
                # generate all vectors in subspace
                S=set()
                for mask in range(1<<dim):
                    vec=[0]*n
                    for i in range(dim):
                        if (mask>>i)&1:
                            vec = [a^b for a,b in zip(vec, basis[i])]
                    S.add(tuple(vec))
                # BFS from all S vectors
                dist = [-1]* (1<<n)
                q=deque()
                for s in S:
                    idx=0
                    for i,b in enumerate(s):
                        if b:
                            idx |= (1<<i)
                    dist[idx]=0
                    q.append(idx)
                while q:
                    cur = q.popleft()
                    d = dist[cur]
                    # generate neighbors by flipping each bit
                    for i in range(n):
                        nxt = cur ^ (1<<i)
                        if dist[nxt]==-1:
                            dist[nxt]=d+1
                            q.append(nxt)
                return max(dist)
            
