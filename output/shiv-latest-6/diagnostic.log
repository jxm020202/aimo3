            tP = sp.Rational(1,4) / D  # 0.25/(a^2+b^2)
            P = sp.Point(a*tP, b*tP)
            
            # Q: compute u_Q expression
            L = 2*((a - sp.Rational(1,2))*(1 - a) - b*(b - r))
            Qcoeff = (1 - a)**2 + b**2
            uQ = -L / Qcoeff  # as derived earlier
            # Simplify maybe
            uQ = sp.simplify(uQ)
            Q = sp.Point(a + (1 - a)*uQ, b*(1 - uQ))
            
            # Vector v = P - Z
            v = sp.Matrix([P.x - Z.x, P.y - Z.y])
            
            # rotation matrices
            theta = sp.pi/3  # 60 degrees
            cos_t = sp.cos(theta)
            sin_t = sp.sin(theta)
            
            def rotate(vec, sign=1):
                # sign = +1 for +60, -1 for -60
                rot = sp.Matrix([[cos_t, -sign*sin_t],
                                 [sign*sin_t, cos_t]])
                return rot*vec
            
            # Candidates for S
            v_rot_plus = rotate(v, sign=1)
            S_plus = sp.Point(Z.x + v_rot_plus[0], Z.y + v_rot_plus[1])
            
            v_rot_minus = rotate(v, sign=-1)
            S_minus = sp.Point(Z.x + v_rot_minus[0], Z.y + v_rot_minus[1])
            
            # Distance OS condition: squared distance equals r^2
            def eq_OS(S):
                return (S.x - sp.Rational(1,2))**2 + (S.y - r)**2 - r**2
            
            eq_OS_plus = sp.simplify(eq_OS(S_plus))
            eq_OS_minus = sp.simplify(eq_OS(S_minus))
            
            # Angle condition: angle QPS = angle XZY
