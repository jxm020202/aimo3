            def solve_pattern(n, d_tuple, e_tuple):
                # d_tuple length n-1, e_tuple length n-1
                N=n*n
                # Build linear system Ax = b over GF(2)
                eqs=[]
                b=[]
                # row parity differences equations
                for i in range(1,n):
                    coeff=[0]*N
                    # sum over row i
                    for j in range(n):
                        coeff[i*n + j] ^= 1
                    # sum over row 0
                    for j in range(n):
                        coeff[0*n + j] ^= 1
                    eqs.append(coeff)
                    b.append(d_tuple[i-1])
                # column parity differences
                for j in range(1,n):
                    coeff=[0]*N
                    for i in range(n):
                        coeff[i*n + j] ^= 1
                    for i in range(n):
                        coeff[i*n + 0] ^= 1
                    eqs.append(coeff)
                    b.append(e_tuple[j-1])
                # Solve using Gaussian elimination over GF(2)
                # Augmented matrix
                m=len(eqs)
                A=[eqs[i][:] + [b[i]] for i in range(m)]
                # elimination
