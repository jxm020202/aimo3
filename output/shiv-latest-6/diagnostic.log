            def polygon_area(points):
                # points list of (x,y) in order, compute signed area via shoelace
                area = 0
                n = len(points)
                for i in range(n):
                    x1,y1 = points[i]
                    x2,y2 = points[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2
            
            def test_solution(a, h, s1, s2):
                Qx,Qy,Rx,Ry,Sx,Sy,Tx,Ty,R,Rval = compute_points(a,h,s1,s2)
                P1 = (0.0,0.0)
                P2 = (15.0,0.0)
                # order: S, Q, P1, R, T, P2
                pts = [(Sx,Sy),(Qx,Qy),P1,(Rx,Ry),(Tx,Ty),P2]
                area = polygon_area(pts)
                # compute convexity: check all cross products have same sign (assuming non-self-intersecting)
                def cross(o,a,b):
                    return (a[0]-o[0])*(b[1]-o[1]) - (a[1]-o[1])*(b[0]-o[0])
                signs = []
                n = len(pts)
                for i in range(n):
                    o = pts[i]
                    a_pt = pts[(i+1)%n]
                    b_pt = pts[(i+2)%n]
                    cp = cross(o,a_pt,b_pt)
                    signs.append(cp)
                # Determine if all have same sign (positive or negative)
                all_pos = all(cp > 0 for cp in signs)
                all_neg = all(cp < 0 for cp in signs)
                convex = all_pos or all_neg
                return area, convex, signs
            
            # Test each solution
            solutions = [
                (0.6992647456322783, 4.375, 1, 1),
                (3.468871125850724, 4.375, -1, 1),
