            def max_milp(N):
                nvar=N*N
                c = -np.ones(nvar)  # maximize sum -> minimize negative
                # constraints list
                A=[]
                b=[]
                # map (x,y) to index
                idx=lambda x,y: y*N + x
                # generate constraints
                for y1 in range(N):
