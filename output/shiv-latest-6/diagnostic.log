            def is_convex(poly):
                # poly list of points in order, closed (implicitly back to first)
                n = len(poly)
                sign = None
                for i in range(n):
                    p0 = poly[i]
                    p1 = poly[(i+1)%n]
                    p2 = poly[(i+2)%n]
                    # vector p0->p1, p1->p2
                    v1 = (p1[0]-p0[0], p1[1]-p0[1])
                    v2 = (p2[0]-p1[0], p2[1]-p1[1])
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    if cross == 0:
                        continue
                    if sign is None:
                        sign = cross > 0
                    else:
                        if (cross > 0) != sign:
                            return False
                return True
            
