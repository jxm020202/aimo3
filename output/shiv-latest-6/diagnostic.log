            import numpy as np, math, cmath, random, itertools, sys, math, cmath
            def triangle_from_angles(A_deg, B_deg, R=1.0):
                # angles in degrees, sum to 180
                A = math.radians(A_deg)
                B = math.radians(B_deg)
                C = math.radians(180 - A_deg - B_deg)
                # place B at angle 0 on circumcircle radius R
                B_pt = complex(R, 0)
                # C at angle 2A from B (counterclockwise)
                C_pt = R * cmath.rect(1, 2*A)  # radius R, angle 2A
                # A at angle 2A+2B
                A_pt = R * cmath.rect(1, 2*A + 2*B)
                return A_pt, B_pt, C_pt
            
            def collinearity_condition(A_deg, B_deg):
                A_pt, B_pt, C_pt = triangle_from_angles(A_deg, B_deg)
                F = fermat_point(A_pt, B_pt, C_pt)
                N = nine_point_center(A_pt, B_pt, C_pt)
                if F is None or N is None:
                    return None
                # check collinearity of B, F, N
                return is_collinear(B_pt, F, N, eps=1e-6)
            
