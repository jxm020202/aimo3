            def possible_totals_n(n, max_val=500):
                totals=set()
                # generate all Dyck-like sequences of length n-1 steps (±1) staying nonnegative
                def gen_sequences():
                    seqs=[]
                    def rec(i, cur, heights):
                        if i==n:
                            seqs.append(heights[:])
                            return
                        # step +1
                        heights.append(cur+1)
                        rec(i+1, cur+1, heights)
                        heights.pop()
                        # step -1 if allowed
                        if cur>0:
                            heights.append(cur-1)
                            rec(i+1, cur-1, heights)
