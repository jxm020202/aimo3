            def n_minus_S_formula(n):
                digs=to_base7(n)
                m=len(digs)-1
                n_val=0
                for k,dk in enumerate(digs[::-1]): # k from 0 least
                    n_val += dk * (7**k)
                # compute S using formula
                S=0
                for k,dk in enumerate(digs[::-1]): # k position
                    if k==0:
                        # contribution for k=0: dk * (m-1)
                        S += dk * (m-1)
                    else:
                        S += dk * (7**(k-1)) * (7*(m-1 - k) + k)
                return n_val - S
            
