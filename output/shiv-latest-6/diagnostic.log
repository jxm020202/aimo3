            import math
            
            def compute_coords(r1_val, h_val):
                # define points numeric
                P1 = (-7.5, 0.0)
                P2 = (7.5, 0.0)
                O = (0.0, h_val)
                R_val = math.hypot(7.5, h_val)
                # compute intersections using numeric formulas
                # helper function
                def intersect(cx, cy, r):
                    # circles O (0,h) radius R_val and (cx,cy) radius r
                    dx = cx - O[0]
                    dy = cy - O[1]
                    d = math.hypot(dx, dy)
                    a = (R_val**2 - r**2 + d**2) / (2*d)
                    # base point
                    base_x = O[0] + a * dx / d
                    base_y = O[1] + a * dy / d
                    h_off = math.sqrt(max(R_val**2 - a**2, 0.0))
                    # perp unit
                    perp_x = -dy / d
                    perp_y = dx / d
                    p1 = (base_x + h_off * perp_x, base_y + h_off * perp_y)
                    p2 = (base_x - h_off * perp_x, base_y - h_off * perp_y)
                    return p1, p2
                Q1, Q2 = intersect(-7.5, 0.0, r1_val)
                r2_val = 15 - r1_val
                S1, S2 = intersect(7.5, 0.0, r2_val)
                return P1, P2, Q1, Q2, S1, S2
            
