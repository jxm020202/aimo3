            def distance_to_V(v):
                n = len(v)
                m = len(basis)
                total_vars = n + m
                # variables: x binary, y integer
                # constraints: sum w_k[i] x_i - 2 y_k = 0 (since x in V)
                A_eq = np.zeros((m, total_vars), dtype=int)
                for k, w in enumerate(basis):
                    A_eq[k, :n] = w
                    A_eq[k, n + k] = -2
                lincon = LinearConstraint(A_eq, np.zeros(m), np.zeros(m))
                # objective: minimize weight of v xor x = sum (v_i xor x_i)
                # we can express xor as v_i + x_i - 2*v_i*x_i, but that's quadratic.
                # Instead, we can introduce auxiliary binary z_i = v_i xor x_i.
                # Add constraints: z_i = v_i + x_i (mod 2). Equivalent to z_i = v_i + x_i - 2*t_i where t_i binary.
                # Simpler: Since v is constant, we can treat two cases:
                # if v_i = 0, then z_i = x_i.
                # if v_i = 1, then z_i = 1 - x_i.
                # So we can set objective directly: sum (x_i) for v_i=0 plus sum (1 - x_i) for v_i=1 = const + sum (coeff_i * x_i)
                const = sum(v)  # number of ones in v
                coeff = [ ( -1 if vi==1 else 1) for vi in v ]  # because contribution = x_i if vi=0, else (1 - x_i) = 1 - x_i => const part + (-x_i)
                # total weight = const + sum coeff_i * x_i
                c = np.concatenate((np.array(coeff, dtype=float), np.zeros(m)))  # we will minimize const + coeff·x, constant ignored for optimization
                # Since milp minimizes c·vars, we can just set objective as coeff·x (ignore constant)
                # bounds:
                lb = np.concatenate((np.zeros(n), -n*np.ones(m)))
                ub = np.concatenate((np.ones(n), n*np.ones(m)))
                bounds = Bounds(lb, ub)
                integrality = np.concatenate((np.ones(n), np.ones(m)))
                res = milp(c=c, constraints=[lincon], bounds=bounds, integrality=integrality, options={"disp": False})
                if not res.success:
                    raise ValueError("MILP failed")
                # compute distance
                x_opt = np.round(res.x[:n])
                dist = sum((vi ^ int(xi)) for vi, xi in zip(v, x_opt))
                return int(dist)
            
