            def nullspace_mod2(matrix):
                # matrix: list of rows (list of ints) shape (m, n)
                A = np.array(matrix, dtype=np.uint8)
                m, n = A.shape
                # Perform Gaussian elimination to row-echelon form, tracking column swaps?
                # We'll compute basis for nullspace using standard algorithm: compute RREF and identify free variables.
                # Use sympy's GF2 matrix? Could use sympy's Matrix with mod 2 arithmetic manually.
                # Let's implement using sympy's Matrix over GF(2) by converting to rational and using .rref?
                # But rational may cause issues; better to implement ourselves.
                # We'll use algorithm to compute row echelon and record pivot columns.
                A = A.copy()
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot
                    pivot = None
                    for r in range(row, m):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap rows
                    if pivot != row:
                        A[[pivot, row]] = A[[row, pivot]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r, col]:
                            A[r] ^= A[row]
                    pivot_cols.append(col)
                    row += 1
                    if row == m:
                        break
                # Now pivot columns are those with leading ones.
                free_cols = [c for c in range(n) if c not in pivot_cols]
                # For each free variable, set it to 1 and others 0, solve for pivot variables.
                basis = []
                for free in free_cols:
                    vec = np.zeros(n, dtype=np.uint8)
                    vec[free] = 1
                    # Back substitution: for each pivot row, compute value for pivot column.
                    # Since matrix is now in reduced row echelon form (RREF) because we eliminated both above and below.
                    # So each pivot row has a leading 1 at pivot_col, and other entries only possibly in free columns.
                    for i, pc in enumerate(pivot_cols):
                        # row i corresponds to pivot col pc
                        # The equation is: x_pc + sum_{j in free_cols} A[i, j] * x_j = 0 (since homogeneous)
                        # So x_pc = sum_{j in free_cols} A[i, j] * x_j (mod 2)
                        if A[i, free]:
                            vec[pc] ^= 1  # because x_pc = sum of free vars (mod 2)
                    basis.append(vec)
                # Also, if there are no free columns, the nullspace is zero vector only.
                return np.array(basis, dtype=np.uint8)
            
