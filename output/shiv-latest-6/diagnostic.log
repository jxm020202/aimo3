            def reachable_sum_min(n):
                # DP over steps
                # state: (current_value, sum_sofar, min_sofar)
                states = {(0,0,0)}  # start at index 0 value 0, sum includes this first value? We need sum of all n values.
                # At start, we have first element a_0 = 0, sum = 0, min = 0.
                for step in range(1, n):
                    new_states = set()
                    for cur, s, mn in states:
                        for delta in (+1, -1):
                            nxt = cur + delta
                            ns = s + nxt
                            nmn = mn if mn < nxt else nxt
                            new_states.add((nxt, ns, nmn))
                    states = new_states
                # After n-1 steps, we have n values (including a_0). sum includes all values.
                # Return set of (sum, min)
                return {(s, mn) for cur, s, mn in states}
            
