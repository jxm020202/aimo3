            def rref_mod2(matrix):
                # returns reduced row echelon form and pivot columns
                A=[row[:] for row in matrix]
                m=len(A); n=len(A[0])
                pivot_cols=[]
                row=0
                for col in range(n):
                    # find pivot
                    piv=None
                    for r in range(row,m):
                        if A[r][col]:
                            piv=r; break
                    if piv is None:
                        continue
                    # swap
                    A[row],A[piv]=A[piv],A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r!=row and A[r][col]:
                            A[r]=[(a^b) for a,b in zip(A[r],A[row])]
                    row+=1
                    if row==m: break
                return A, pivot_cols
            
            def nullspace_mod2_from(matrix):
                R, pivots = rref_mod2(matrix)
                m=len(R); n=len(R[0])
                free = [c for c in range(n) if c not in pivots]
                basis=[]
                for f in free:
                    vec=[0]*n
                    vec[f]=1
                    # for each pivot row, set pivot var to entry in that row at column f
                    for r, pcol in enumerate(pivots):
                        if R[r][f]:
