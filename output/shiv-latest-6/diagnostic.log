            def compute_covering_radius(n):
                vectors=[]
                for i in range(n):
                    for j in range(n):
                        mat=np.zeros((n,n), dtype=int)
                        mat[i,:]=1
                        mat[:,j]=1
                        vectors.append(mat.reshape(-1)%2)
                # build H basis as described
                basis=[]
                for i in range(n-1):
                    R=np.zeros(n,dtype=int); R[i]=1; R[n-1]=1
                    C=np.zeros(n,dtype=int)
                    w=np.add.outer(R,C)%2
                    basis.append(w.reshape(-1))
                for j in range(n-1):
                    R=np.zeros(n,dtype=int)
                    C=np.zeros(n,dtype=int); C[j]=1; C[n-1]=1
                    w=np.add.outer(R,C)%2
                    basis.append(w.reshape(-1))
                H=np.array(basis,dtype=int)
                N=n*n
                max_min_weight=0
                # precompute syndrome for each vector
                for x in range(1<<N):
                    vec = np.array([(x>>k)&1 for k in range(N)], dtype=int)
                    s = (H @ vec) % 2
                    # find minimal weight vector with same syndrome by brute force over all y
                    min_w = N+1
                    for y in range(1<<N):
                        yvec = np.array([(y>>k)&1 for k in range(N)], dtype=int)
                        if np.all((H @ yvec)%2 == s):
                            w = np.sum(yvec)
                            if w < min_w:
                                min_w = w
                                if min_w==0:
                                    break
                    if min_w > max_min_weight:
                        max_min_weight = min_w
                return max_min_weight
            
            print(compute_covering_radius(2))
            
