            import sympy as sp
            
            def find_solutions(limit_x=5000):
                sols=[]
                for x in range(1, limit_x+1):
                    lhs = x**3 + 1
                    # factor 2 out
                    if lhs % 2 != 0:
                        continue
                    lhs2 = lhs // 2
                    # lhs2 = p*y^2
                    # Need to find prime p dividing lhs2 such that p ≡5 mod8 and after dividing by p, remainder is a perfect square.
                    # Could also have p=1? but p must be prime.
                    # So iterate over prime divisors of lhs2
                    for p in sp.factorint(lhs2):
                        if not sp.isprime(p):
                            continue
                        if p % 8 != 5:
                            continue
                        # compute y^2 = lhs2 / p
                        y2 = lhs2 // p
                        if lhs2 % p != 0:
                            continue
                        if int(y2**0.5)**2 == y2:
                            y = int(y2**0.5)
                            sols.append((x,y,p))
                return sols
            
            sols=find_solutions(5000)
            len(sols), sols[:20]
            
