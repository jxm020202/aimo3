            def intersect_circle_line(circle_center, radius, p1, p2):
                # returns intersection points of line p1-p2 with circle (center, radius)
                # line param p = p1 + t*(p2-p1)
                cx, cy = circle_center
                x1, y1 = p1
                x2, y2 = p2
                dx = x2 - x1
                dy = y2 - y1
                # solve (x1+dx*t - cx)^2 + (y1+dy*t - cy)^2 = r^2
                a = dx*dx + dy*dy
                b = 2*(dx*(x1-cx) + dy*(y1-cy))
                c = (x1-cx)**2 + (y1-cy)**2 - radius**2
                disc = b*b - 4*a*c
                if disc < -1e-9:
                    return []  # no intersection
                disc = max(disc,0.0)
                t1 = (-b + math.sqrt(disc))/(2*a)
                t2 = (-b - math.sqrt(disc))/(2*a)
                p_int1 = (x1+dx*t1, y1+dy*t1)
                p_int2 = (x1+dx*t2, y1+dy*t2)
                return [p_int1, p_int2]
            
            def other_point_on_segment(A, B, circle_center, radius):
                # returns the intersection point other than A
                pts = intersect_circle_line(circle_center, radius, A, B)
                # choose point not equal to A (within tolerance)
                for pt in pts:
                    if math.hypot(pt[0]-A[0], pt[1]-A[1])>1e-6:
                        return pt
                return None
            
            def six_points(D, A,B,C):
                r = math.hypot(A[0]-D[0], A[1]-D[1])
                Ab = other_point_on_segment(A, B, D, r)
                Ac = other_point_on_segment(A, C, D, r)
                rB = math.hypot(B[0]-D[0], B[1]-D[1])
                Ba = other_point_on_segment(B, A, D, rB)
                Bc = other_point_on_segment(B, C, D, rB)
                rC = math.hypot(C[0]-D[0], C[1]-D[1])
                Ca = other_point_on_segment(C, A, D, rC)
                Cb = other_point_on_segment(C, B, D, rC)
                return [Ab,Ac,Ba,Bc,Ca,Cb]
            
