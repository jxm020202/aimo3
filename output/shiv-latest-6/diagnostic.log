            import numpy as np
            
            def is_in_span(target, generators):
                # target: numpy array length N
                # generators: list of numpy arrays (rows)
                # Solve using Gaussian elimination on augmented matrix
                A = np.array(generators, dtype=np.uint8)
                b = target.copy()
                rows, cols = A.shape
                # Perform elimination to row-echelon form, also apply to b
                rank = 0
                col = 0
                # We'll keep track of pivot columns
                pivot_cols = []
                while col < cols and rank < rows:
                    # find pivot row
                    pivot = None
                    for r in range(rank, rows):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap
                    if pivot != rank:
                        A[[pivot, rank]] = A[[rank, pivot]]
                        b[[pivot, rank]] = b[[rank, pivot]]
                    # eliminate other rows
                    for r in range(rows):
                        if r != rank and A[r, col]:
                            A[r] ^= A[rank]
                            b[r] ^= b[rank]
                    pivot_cols.append(col)
                    rank += 1
                    col += 1
                # After elimination, check consistency: rows where A row is all zeros must have b zero
                for r in range(rank, rows):
                    if not A[r].any() and b[r]:
                        return False
                # If consistent, solution exists
                return True
            
            N = 19*19
            all_ones = np.ones(N, dtype=np.uint8)
            print(is_in_span(all_ones, vectors))
            
