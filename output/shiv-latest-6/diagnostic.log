                target = (1<<N)-1
                # BFS over (pos, state) where pos is index of last flipped (0..N-1)
                # first move can be any pos, so we start with all possibilities after flipping that coin.
                visited = set()
                dq = deque()
                for pos in range(N):
                    state = init ^ (1<<pos)  # flip
