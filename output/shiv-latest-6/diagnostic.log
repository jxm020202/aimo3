            def nullspace_GF2(matrix_rows, n_cols):
                # matrix_rows: list of ints representing rows length n_cols bits
                # returns list of basis vectors (as ints) for nullspace (solutions x where M*x=0)
                A = matrix_rows[:]  # copy
                m = len(A)
                n = n_cols
                # Perform Gaussian elimination, keep track of pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot row with bit col set
                    pivot = None
                    for i in range(row, m):
                        if (A[i] >> col) & 1:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for i in range(m):
                        if i != row and ((A[i] >> col) & 1):
                            A[i] ^= A[row]
                    row += 1
                    if row == m:
                        break
                rank = len(pivot_cols)
                free_cols = [c for c in range(n) if c not in pivot_cols]
                basis = []
                for free in free_cols:
                    # set free variable =1, others 0, solve for pivot variables
                    vec = 0
                    vec |= 1 << free
                    # back substitution: for each pivot row, determine value
                    for r in reversed(range(rank)):
                        col = pivot_cols[r]
                        # compute sum of known variables in this row (excluding pivot col)
                        # row r corresponds to original row after elimination? We need the reduced rows.
                        # We have A in reduced row-echelon form where each pivot row has 1 at pivot col and possibly 1s at free cols.
                        row_bits = A[r]
                        # compute parity of bits where vec has 1 and row has 1, excluding pivot col
                        # dot product row_bits & vec, count bits, mod2
                        # Since row_bits includes pivot col itself, we need to exclude it
                        mask = row_bits ^ (1 << col)  # remove pivot bit
                        parity = bin(mask & vec).count("1") % 2
                        if parity == 1:
                            # need to set pivot variable to 1 to make equation 0
                            vec |= 1 << col
                    basis.append(vec)
                return basis
            
            def nullspace_dim(m):
                rows = []
                for vec in operation_vectors(m):
                    val = 0
                    for i,bit in enumerate(vec):
                        if bit:
                            val |= 1 << i
                    rows.append(val)
                n = m*m
                basis = nullspace_GF2(rows, n)
                return len(basis)
            
            for m in [3,5,7,9]:
                print(m, nullspace_dim(m))
            
