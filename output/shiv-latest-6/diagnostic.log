            def find_solutions_by_m(m):
                # digits indices 0..m-1 (least significant 0)
                c = [6*k - 7*m + 14 for k in range(m)]
                pow7 = [7**k for k in range(m)]
                solutions=[]
                # backtrack from most significant (k=m-1 down to 0)
                def backtrack(k, current_sum, digits):
                    # k is current index to set (starting from m-1)
                    if k < 0:
                        if current_sum == 0:
                            # construct number
                            n = sum(digits[i]*pow7[i] for i in range(m))
                            solutions.append(n)
                        return
                    # possible digit range
                    start = 1 if k==m-1 else 0
                    # compute remaining max/min possible contribution from lower indices
                    # lower indices are 0..k-1
                    max_remaining = 0
                    min_remaining = 0
                    for j in range(k):
                        coeff = c[j]*pow7[j]
                        if coeff >=0:
                            max_remaining += 6*coeff
                            # min is 0
                        else:
                            min_remaining += 6*coeff
                    # For each digit choice, compute new sum and prune if impossible to reach 0
                    for d in range(start,7):
