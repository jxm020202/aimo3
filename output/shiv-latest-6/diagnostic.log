                # DP backwards: store optimal value function as piecewise? We'll discretize.
                import numpy as np
                M=1001
                t_vals = np.linspace(0,1,M)
                # f_{N+1}=0 (no terms after N)
                f_next = np.zeros(M)  # value from i=N+1 onward is 0
                # we will compute f_i(t) = max_{a in [0,1]} a/(1+t) + f_{i+1}(a)
                # store optimal a maybe
                opt_a = np.zeros((N+2,M))
                for i in range(N,0,-1):
                    f_curr = np.zeros(M)
                    for idx,t in enumerate(t_vals):
                        # maximize over a discretized
                        vals = (np.linspace(0,1,M)/(1+t)) + np.interp(np.linspace(0,1,M), t_vals, f_next)
                        # but need f_next evaluated at a (not t). Use interpolation.
                        # We'll approximate.
                        a_grid = np.linspace(0,1,M)
                        f_next_at_a = np.interp(a_grid, t_vals, f_next)
                        vals = a_grid/(1+t) + f_next_at_a
                        best_idx = np.argmax(vals)
                        f_curr[idx]=vals[best_idx]
                        opt_a[i,idx]=a_grid[best_idx]
                    f_next = f_curr
                # Now compute forward with t0? For our sum, initial term a1 not divided.
                # Actually DP defined for terms from i to N where term i is a_i/(1+prev). For i=1 we have a1 alone.
