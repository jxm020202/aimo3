            def generate_walks(n):
                walks = []
                for mask in range(1 << (n-1)):
                    walk = [0]*n
                    for i in range(1,n):
                        step = 1 if (mask >> (i-1)) & 1 else -1
                        walk[i] = walk[i-1] + step
                    walks.append(walk)
                return walks
            
