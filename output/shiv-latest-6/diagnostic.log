            def min_edges_bruteforce(n, row_parities, col_parities):
                # row_parities, col_parities are lists of length n bits
                # edges: (i,j) for i,j in range(n)
                # brute force all subsets up to 2^(n*n) maybe small n
                best = n*n+1
                # enumerate all subsets using integer mask
                total_edges = n*n
                for mask in range(1<<total_edges):
                    # compute parity
                    rp = [0]*n
                    cp = [0]*n
                    cnt = 0
                    for i in range(n):
                        for j in range(n):
                            idx = i*n + j
                            if (mask>>idx) & 1:
