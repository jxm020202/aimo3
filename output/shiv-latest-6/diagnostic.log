            G = np.array([L+a, q])
            O = np.array([x0, r])
            def line_intersections():
                # line EG param t from 0 to 1: E + t*(G-E)
                dir_vec = G - E
                # solve |O - (E + t*dir)|^2 = r^2
                # quadratic in t
                a_quad = np.dot(dir_vec, dir_vec)
                b_quad = 2*np.dot(O - E, dir_vec)
                c_quad = np.dot(O - E, O - E) - r**2
                disc = b_quad**2 - 4*a_quad*c_quad
                t1 = (-b_quad - math.sqrt(disc)) / (2*a_quad)
                t2 = (-b_quad + math.sqrt(disc)) / (2*a_quad)
                # distances from E
