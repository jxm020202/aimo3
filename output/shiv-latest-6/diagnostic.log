        >>> Code:
            def nullspace_mod2(matrix_rows, n):
                # matrix_rows: list of ints (bitmask) length n columns
                # Compute basis for nullspace (vectors v such that v·row = 0 for all rows)
                # Use Gaussian elimination to row-reduce matrix and then find nullspace.
                # We'll treat rows as bitmask.
                rows = matrix_rows[:]
                m = len(rows)
                # Perform elimination to row-echelon form, tracking pivot columns.
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find row with 1 in this column at or below current row
                    sel = None
                    for i in range(row, m):
                        if (rows[i] >> col) & 1:
                            sel = i
                            break
                    if sel is None:
                        continue
                    # swap
                    rows[row], rows[sel] = rows[sel], rows[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for i in range(m):
                        if i != row and ((rows[i] >> col) & 1):
                            rows[i] ^= rows[row]
                    row += 1
                    if row == m:
                        break
                # Now we have pivot columns; free columns are those not in pivot_cols.
                pivot_set = set(pivot_cols)
                free_cols = [c for c in range(n) if c not in pivot_set]
                # For each free column, construct a nullspace basis vector where that free column = 1,
                # and pivot columns set to satisfy equations.
                basis = []
                # For each free column f, set variable f = 1, others free = 0.
                # Then solve for pivot variables using equations: each row corresponds to pivot variable expressed in terms of free vars.
                # We have rows in reduced row-echelon form: each row has leading 1 at pivot col, and may have 1s in free cols.
                # So pivot variable = sum of free vars where row has 1.
                for f in free_cols:
                    vec = 0
                    # set free variable f
                    vec |= 1 << f
                    # For each pivot row, determine if row has 1 in column f; if so, set pivot variable.
                    for r_idx, piv in enumerate(pivot_cols):
                        if (rows[r_idx] >> f) & 1:
                            # then pivot variable at column piv must be 1 to satisfy equation (since sum of free vars = pivot var)
                            vec |= 1 << piv
                    basis.append(vec)
                return basis
            
            null_basis = nullspace_mod2(rows, N)
            len(null_basis)
            
