            def feasible_n_milp(n, target):
                N = n*n
                # variable ordering: first N a's, then vertical edges (n-1)*n, then horizontal edges n*(n-1)
                V = (n-1)*n
                H = n*(n-1)
                total_vars = N + V + H
                # bounds: a >=0, no upper bound
                lb = np.zeros(total_vars)
                ub = np.full(total_vars, np.inf)
                # a variables integer, b variables binary (0/1)
                integrality = np.ones(total_vars, dtype=int)  # all integer, but we will enforce binary via bounds 0-1 for b
                # constraints:
                cons = []
                # sum constraint
                A_sum = np.zeros(total_vars)
                A_sum[:N] = 1
                cons.append(LinearConstraint(A_sum, [target], [target]))
                # adjacency constraints for vertical edges
                # index mapping for a(i,j): idx = i*n + j
                # vertical edge between (i,j) and (i+1,j) for i in 0..n-2, j in 0..n-1
                # binary var b_v index = N + i*n + j
                for i in range(n-1):
                    for j in range(n):
                        a1 = i*n + j
                        a2 = (i+1)*n + j
                        b_idx = N + i*n + j
                        # a2 - a1 = 2*b -1
                        row = np.zeros(total_vars)
                        row[a2] = 1
                        row[a1] = -1
                        row[b_idx] = -2
                        # equality: = -1
                        cons.append(LinearConstraint(row, [-1], [-1]))
                # horizontal edges
                for i in range(n):
                    for j in range(n-1):
                        a1 = i*n + j
                        a2 = i*n + (j+1)
                        b_idx = N + V + i*(n-1) + j
                        row = np.zeros(total_vars)
                        row[a2] = 1
                        row[a1] = -1
                        row[b_idx] = -2
                        cons.append(LinearConstraint(row, [-1], [-1]))
                # set bounds for binary vars
                for idx in range(N, total_vars):
                    lb[idx]=0
                    ub[idx]=1
                # define bounds object
                bounds = Bounds(lb, ub)
                # objective dummy zero
                c = np.zeros(total_vars)
                res = milp(c=c, constraints=cons, bounds=bounds, integrality=integrality, options={'disp': False})
                return res.success
            
            # test for n=7 (should be feasible)
            print(feasible_n_milp(7, 471))
            
