            def nullspace_mod2(matrix_rows):
                # matrix_rows: list of ints representing rows (size m x n)
                m = len(matrix_rows)
                n = max(row.bit_length() for row in matrix_rows) if m>0 else 0
                # Perform Gaussian elimination to row echelon form, tracking column pivots
                rows = matrix_rows[:]
                pivots = []
                row = 0
                for col in range(n):
                    # find pivot row with bit col set
                    pivot = None
                    for r in range(row, m):
                        if (rows[r] >> col) & 1:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    rows[row], rows[pivot] = rows[pivot], rows[row]
                    pivots.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r != row and ((rows[r] >> col) & 1):
                            rows[r] ^= rows[row]
                    row += 1
                    if row == m:
                        break
                rank = len(pivots)
                # Determine free columns
                free_cols = [c for c in range(n) if c not in pivots]
                # For each free column, construct a nullspace vector by setting that free var =1, others 0, solving for pivot vars.
                null_vectors = []
                for free in free_cols:
                    vec = 0
                    # set free var
                    vec |= 1 << free
                    # backsolve pivot vars: each pivot equation expresses pivot var as sum of free vars in that row.
