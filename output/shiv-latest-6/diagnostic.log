            def all_labelings_sum(n, max_val=10):
                cells=n*n
                grid=[[0]*n for _ in range(n)]
                sums=set()
                def rec(idx):
                    if idx==cells:
                        s=sum(grid[i][j] for i in range(n) for j in range(n))
                        sums.add(s)
                        return
                    i=idx//n
                    j=idx%n
                    possible=set(range(max_val+1))
                    if i>0:
                        up=grid[i-1][j]
                        possible={up+1, up-1}.intersection(possible)
                    if j>0:
                        left=grid[i][j-1]
                        possible={left+1, left-1}.intersection(possible)
                    for v in possible:
                        if v<0: continue
                        grid[i][j]=v
                        rec(idx+1)
                rec(0)
                return sorted(sums)
            
