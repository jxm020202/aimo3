            def compute_area_hull(r1_val, h_val):
                # compute points as mpmath floats
                import mpmath as mp
                P1 = (mp.mpf('0'), mp.mpf('0'))
                P2 = (mp.mpf('15'), mp.mpf('0'))
                O = (mp.mpf('7.5'), mp.mpf(str(h_val)))
                R = mp.sqrt((mp.mpf('7.5'))**2 + O[1]**2)
                # compute intersection points using formulas with mp
                # For circle Gamma1 radius r1
                a1 = r1_val**2/(2*R)
                d = R
                # direction vector from P1 to O
                dx1 = O[0] - P1[0]
                dy1 = O[1] - P1[1]
                # point along line
                x_mid1 = P1[0] + a1*dx1/d
                y_mid1 = P1[1] + a1*dy1/d
                h1 = mp.sqrt(r1_val**2 - a1**2)
                # unit perpendicular
                perp1x = -dy1/d
                perp1y = dx1/d
                Q1 = (x_mid1 + h1*perp1x, y_mid1 + h1*perp1y)
                Q2 = (x_mid1 - h1*perp1x, y_mid1 - h1*perp1y)
                # For Gamma2 radius r2
                r2_val = 15 - r1_val
                a2 = r2_val**2/(2*R)
                dx2 = O[0] - P2[0]
                dy2 = O[1] - P2[1]
                x_mid2 = P2[0] + a2*dx2/d
                y_mid2 = P2[1] + a2*dy2/d
                h2 = mp.sqrt(r2_val**2 - a2**2)
                perp2x = -dy2/d
                perp2y = dx2/d
                S1 = (x_mid2 + h2*perp2x, y_mid2 + h2*perp2y)
                S2 = (x_mid2 - h2*perp2x, y_mid2 - h2*perp2y)
                # hull order: Q1, P1, Q2, S1, P2, S2
                pts = [Q1, P1, Q2, S1, P2, S2]
                area = mp.mpf('0')
                n = len(pts)
                for i in range(n):
                    x1,y1 = pts[i]
                    x2,y2 = pts[(i+1)%n]
                    area += x1*y2 - x2*y1
                return mp.fabs(area)/2
            
