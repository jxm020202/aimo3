            # Compute nullspace of M (vectors orthogonal to rows of M) i.e., solve M * x = 0 (mod2) where x length 361.
            def gf2_nullspace(matrix):
                A = matrix.copy()
                rows, cols = A.shape
                # Perform Gaussian elimination to row-echelon form, track pivot columns
                pivot_cols = []
                r = 0
                for c in range(cols):
                    # find pivot
                    pivot = None
                    for i in range(r, rows):
                        if A[i, c]:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap
                    if pivot != r:
                        A[[pivot, r]] = A[[r, pivot]]
                    # eliminate below
                    for i in range(r+1, rows):
                        if A[i, c]:
                            A[i] ^= A[r]
                    pivot_cols.append(c)
                    r += 1
                    if r == rows:
                        break
                rank = len(pivot_cols)
                free_cols = [c for c in range(cols) if c not in pivot_cols]
                # back substitution to express each free variable as basis vector
                basis = []
                for free in free_cols:
                    vec = np.zeros(cols, dtype=np.uint8)
                    vec[free] = 1
                    # solve for pivot variables
                    for i in reversed(range(rank)):
                        pc = pivot_cols[i]
                        # row i has pivot at pc; compute dot of row i with current vec for columns > pc
                        # Since matrix is in row-echelon, entries to right of pivot may be non-zero.
                        # Determine if sum of A[i, j]*vec[j] for j>pc is 1, then set vec[pc]=1
                        s = 0
                        for j in range(pc+1, cols):
                            if A[i, j] and vec[j]:
                                s ^= 1
                        if s:
                            vec[pc] = 1
                    basis.append(vec)
                return np.array(basis, dtype=np.uint8)
            
            null = gf2_nullspace(M)
            null.shape
            
