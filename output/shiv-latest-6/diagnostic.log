            def diff_n(n):
                # returns S - n
                digs=[]
                temp=n
                while temp:
                    digs.append(temp%7)
                    temp//=7
                L=len(digs)
                pow7=[1]
                for i in range(1,L+1):
                    pow7.append(pow7[-1]*7)
                S=0
                for i in range(L-1):
                    high=n//pow7[i+1]
                    low=n%pow7[i]
                    S+=high*pow7[i]+low
                return S-n
            
