            import math, random, mpmath as mp, sympy as sp, numpy as np, sys, time, itertools, fractions, collections, decimal, heapq, statistics, functools, itertools, math, random
            def find_gamma(alpha,beta, guess=0.5):
                def F(g):
                    lhs = (math.tan(alpha)+math.tan(beta))*(math.tan(beta)+math.tan(g))*(math.tan(g)+math.tan(alpha))
                    rhs = 4.0/(math.sin(2*alpha)+math.sin(2*beta)+math.sin(2*g))
                    return lhs - rhs
                try:
                    root = mp.findroot(F, guess)
                    if root>0 and root< mp.pi/2:
                        return float(root)
                except Exception as e:
                    return None
            
            def test_random():
                for _ in range(30):
