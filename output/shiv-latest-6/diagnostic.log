            import numpy as np, math, itertools, sys, time, collections, random, scipy
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def solve():
                n = 172
                max_sum = 342
                num_vars = n + (max_sum+1)
                c = np.zeros(num_vars)
                c[n:] = 1.0
                # Build constraint rows
                rows = []
                lowers = []
                uppers = []
                # equality constraints rows
                # sum x_i = 87
                row = np.zeros(num_vars)
                row[:n] = 1
                rows.append(row); lowers.append(87); uppers.append(87)
                # x0 =1
                row = np.zeros(num_vars); row[0]=1
                rows.append(row); lowers.append(1); uppers.append(1)
                # x171=1
                row = np.zeros(num_vars); row[171]=1
                rows.append(row); lowers.append(1); uppers.append(1)
                # inequality y_s >= x_i + x_j -1 => -y_s + x_i + x_j <=1
                for i in range(n):
                    for j in range(i, n):
                        s = i + j
                        row = np.zeros(num_vars)
                        row[i] = 1
                        row[j] = 1
                        row[n + s] = -1
                        rows.append(row)
                        lowers.append(-np.inf)
                        uppers.append(1)
                A = np.vstack(rows)
                lower = np.array(lowers, dtype=float)
                upper = np.array(uppers, dtype=float)
                constraint = LinearConstraint(A, lower, upper)
                bounds = Bounds(0,1)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=constraint, bounds=bounds, integrality=integrality, options={'disp': True, 'time_limit':30})
                return res
            
            # Warning: this may be large; let's try with time limit small
            
