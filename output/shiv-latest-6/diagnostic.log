            # Function to get third vertex of equilateral triangle on segment P1-P2 outward relative to a reference point ref
            def equilateral_third(P1, P2, ref):
                # vector from P1 to P2
                v = sp.Matrix([P2.x - P1.x, P2.y - P1.y])
                # rotate v by +60° and -60° to get possible third vertices
                # rotation matrix for +60°: [[cos60, -sin60],[sin60, cos60]]
                cos60 = sp.Rational(1,2)
                sin60 = sqrt3/2
                R_plus = sp.Matrix([[cos60, -sin60],[sin60, cos60]]) * v
                R_minus = sp.Matrix([[cos60, sin60],[-sin60, cos60]]) * v  # rotation by -60° (or +300°)
                # third vertex candidates:
                C1 = sp.Point(P1.x + R_plus[0], P1.y + R_plus[1])
                C2 = sp.Point(P1.x + R_minus[0], P1.y + R_minus[1])
                # Determine which side is outward: we want the candidate that lies on opposite side of ref compared to segment line.
                # Compute signed area (cross product) of (P2-P1) and (ref-P1)
                cross_ref = (P2.x - P1.x)*(ref.y - P1.y) - (P2.y - P1.y)*(ref.x - P1.x)
                # compute signed area for each candidate
                cross_c1 = (P2.x - P1.x)*(C1.y - P1.y) - (P2.y - P1.y)*(C1.x - P1.x)
                cross_c2 = (P2.x - P1.x)*(C2.y - P1.y) - (P2.y - P1.y)*(C2.x - P1.x)
                # If cross_ref and cross_candidate have same sign, candidate is on same side as ref; we want opposite side.
                # So choose candidate where sign differs.
                # Use piecewise? We'll just return both and later decide based on sign condition.
                return C1, C2, cross_ref, cross_c1, cross_c2
            
