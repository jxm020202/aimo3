            def gf2_rank(matrix):
                A = matrix.copy()
                rows, cols = A.shape
                rank = 0
                col = 0
                for col in range(cols):
                    # find pivot row with 1 in this column at or below rank
                    pivot = None
                    for r in range(rank, rows):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row to current rank
                    if pivot != rank:
                        A[[pivot, rank]] = A[[rank, pivot]]
                    # eliminate other rows
                    for r in range(rows):
                        if r != rank and A[r, col]:
                            A[r] ^= A[rank]
                    rank += 1
                    if rank == rows:
                        break
                return rank
            
