            def rank_gf2(matrix):
                # matrix: list of lists of 0/1 ints, shape m x n
                m = len(matrix)
                if m == 0:
                    return 0
                n = len(matrix[0])
                # copy
                A = [row[:] for row in matrix]
                rank = 0
                row = 0
                for col in range(n):
                    # find pivot row with 1 in this column at or below current row
                    pivot = None
                    for r in range(row, m):
                        if A[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row to current row
                    A[row], A[pivot] = A[pivot], A[row]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r][col]:
                            # row r = row r xor row row
                            A[r] = [(a ^ b) for a,b in zip(A[r], A[row])]
                    row += 1
                    rank += 1
                    if row == m:
                        break
                return rank
            
