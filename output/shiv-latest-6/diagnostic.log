            def fermat_point_interior(A,B,C):
                # A,B,C are numpy arrays
                # compute side lengths
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                # compute angles using law of cos
                A_angle = math.acos((b*b + c*c - a*a)/(2*b*c))
                B_angle = math.acos((a*a + c*c - b*b)/(2*a*c))
                C_angle = math.pi - A_angle - B_angle
                wA = 1.0 / math.sin(A_angle + math.pi/3)
                wB = 1.0 / math.sin(B_angle + math.pi/3)
                wC = 1.0 / math.sin(C_angle + math.pi/3)
                P = (wA*A + wB*B + wC*C) / (wA + wB + wC)
                return P
            
