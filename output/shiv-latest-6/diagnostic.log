            import sympy as sp, random, math, numpy as np
            
            def random_acute_triangle():
                # generate random points in plane, ensure acute
                while True:
                    # generate three points not collinear
                    A = np.random.rand(2)*10
                    B = np.random.rand(2)*10
                    C = np.random.rand(2)*10
                    # check area not zero
                    area = abs(np.cross(B-A, C-A))
                    if area < 1e-3:
                        continue
                    # compute side lengths
                    a = np.linalg.norm(B-C)
                    b = np.linalg.norm(C-A)
                    c = np.linalg.norm(A-B)
                    # compute angles using law of cos
                    # cosA opposite a
                    cosA = (b*b + c*c - a*a)/(2*b*c)
                    cosB = (c*c + a*a - b*b)/(2*c*a)
                    cosC = (a*a + b*b - c*c)/(2*a*b)
                    # acute if all cos > 0
                    if cosA>0 and cosB>0 and cosC>0:
                        return A, B, C
            
            def orthocenter(A,B,C):
                # using sympy geometry maybe easier
                A = sp.Point(A[0], A[1])
                B = sp.Point(B[0], B[1])
                C = sp.Point(C[0], C[1])
                # compute altitudes intersection
                # altitude from A: line through A perpendicular to BC
                lineBC = sp.Line(B, C)
                altA = lineBC.perpendicular_line(A)
                lineCA = sp.Line(C, A)
                altB = lineCA.perpendicular_line(B)
