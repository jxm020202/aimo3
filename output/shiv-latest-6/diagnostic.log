            import random, math, numpy as np
            
            def random_point_on_sphere():
                # uniform on sphere
                theta = random.random()*2*math.pi
                u = random.random()*2-1
                r = math.sqrt(1-u*u)
                return np.array([r*math.cos(theta), r*math.sin(theta), u])
            
            def compute_ratio():
                a1 = random_point_on_sphere()
                a2 = random_point_on_sphere()
                a3 = random_point_on_sphere()
                a4 = random_point_on_sphere()
                # ensure not coplanar (volume not too small)
                vol = np.dot(a2-a1, np.cross(a3-a1, a4-a1))
                if abs(vol) < 1e-6:
                    return None
                S = a1 + a2 + a3 + a4
                v = a2 + a3 + a4  # direction from a1 to orthocenter
                # normal of plane a2,a3,a4
                n = np.cross(a3 - a2, a4 - a2)
                tX = np.dot(a2 - a1, n) / np.dot(v, n)
                # sphere radius R = 1
                # solve |a1 + t v|^2 = 1
                # quadratic: (v·v) t^2 + 2 (a1·v) t + (a1·a1 -1)=0
                A = np.dot(v, v)
                B = 2*np.dot(a1, v)
                Cc = np.dot(a1, a1) - 1
                # roots
                disc = B*B - 4*A*Cc
                t1 = (-B + math.sqrt(disc)) / (2*A)
                t2 = (-B - math.sqrt(disc)) / (2*A)
                # one root should be 0 (a1 on sphere). Check which is near zero
                tY = t1 if abs(t1) > 1e-8 else t2
                ratio = abs(1 - tX) / abs(1 - tY)
                return ratio
            
            ratios = []
            for _ in range(200):
                r = compute_ratio()
                if r:
                    ratios.append(r)
            len(ratios), sum(ratios)/len(ratios)
            
