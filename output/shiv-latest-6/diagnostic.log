                # s = sum_k x_k * op_vec_k (mod 2)
                # Use binary variables x_k (361) and w_i (361) and auxiliary y_i for mod2 constraints.
                # We'll use scipy.optimize.milp
                import numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                m = size
                num_ops = size
                # Variables: x (num_ops), w (m), y (m) integer for parity constraints
                # total variables = num_ops + m + m
                total_vars = num_ops + m + m
                # objective: maximize sum w_i => minimize -sum w_i
                c = np.zeros(total_vars)
                c[num_ops:num_ops+m] = -1.0  # w part
                # bounds: x binary 0/1, w binary 0/1, y integer >=0 (no upper bound)
                lb = np.zeros(total_vars)
                ub = np.ones(total_vars)
                # but y can be larger; we set ub large
                ub[num_ops+m:] = 1000  # large enough
                # integrality: all variables binary/integer
                integrality = np.ones(total_vars)
                # Constraints: for each i: board_i XOR w_i = s_i = sum_k M_{k,i} x_k (mod 2)
                # Equivalent: board_i + w_i = sum_k M_{k,i} x_k + 2*y_i (mod? actually equality over integers)
                # So board_i + w_i - sum_k M_{k,i} x_k - 2*y_i = 0.
                A = np.zeros((m, total_vars))
                for i in range(m):
                    # board_i + w_i - sum_k M_{k,i} x_k - 2*y_i = 0
                    A[i, i] = 1  # w_i coefficient
                    # x part: subtract M_{k,i}
                    for k in range(num_ops):
                        if (ops[k] >> i) & 1:
                            A[i, k] = -1
                    A[i, num_ops + i] = -2  # y_i coefficient
                    # board_i constant will be moved to RHS
                # RHS = -board_i (since board_i + w_i - ... = 0 => w_i - ... = -board_i)
                b = np.array([ - ((board_bits>>i)&1) for i in range(m) ], dtype=float)
                # Use LinearConstraint with equality
                lin_con = LinearConstraint(A, b, b)
                bounds = Bounds(lb, ub)
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
