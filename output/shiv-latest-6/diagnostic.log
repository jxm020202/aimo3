            from scipy.optimize import milp, LinearConstraint, Bounds
            def feasible_n(n, total=471, time_limit=30):
                # variable ordering: first all x (n*n), then h (n*(n-1)), then v ((n-1)*n)
                num_x = n*n
                num_h = n*(n-1)
                num_v = (n-1)*n
                N = num_x + num_h + num_v
                # objective zero
                c = np.zeros(N)
                # bounds
                lb = np.zeros(N)
                ub = np.full(N, np.inf)
                # x upper bound maybe total
                ub[:num_x] = total
                # h,v bounds 0-1
                ub[num_x:num_x+num_h] = 1
                ub[num_x+num_h:] = 1
                # integrality: all variables integer
                integrality = np.ones(N, dtype=int)
                # constraints list
                A_eq = []
                b_eq = []
                # horizontal edges constraints
                # map index of x(i,j) to variable index
                def idx_x(i,j):
                    return i*n + j
                def idx_h(i,j):
                    # i row, j column left cell (0..n-2)
                    return num_x + i*(n-1) + j
                def idx_v(i,j):
                    # i row top cell (0..n-2), j column
                    return num_x + num_h + i*n + j
                # horizontal constraints
                for i in range(n):
                    for j in range(n-1):
                        row = np.zeros(N)
                        row[idx_x(i,j+1)] = 1
                        row[idx_x(i,j)] = -1
                        row[idx_h(i,j)] = -2  # because x_{j+1} - x_j = 2h -1 => left side - (2h) = -1
                        # bring constant -1 to RHS
                        A_eq.append(row)
                        b_eq.append(-1)
                # vertical constraints
                for i in range(n-1):
                    for j in range(n):
                        row = np.zeros(N)
                        row[idx_x(i+1,j)] = 1
                        row[idx_x(i,j)] = -1
                        row[idx_v(i,j)] = -2
                        A_eq.append(row)
                        b_eq.append(-1)
                # sum constraint
                row = np.zeros(N)
                row[:num_x] = 1
                A_eq.append(row)
                b_eq.append(total)
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                lincon = LinearConstraint(A_eq, b_eq, b_eq)
                bounds = Bounds(lb, ub)
                try:
                    res = milp(c, constraints=lincon, bounds=bounds, integrality=integrality, options={'presolve': True, 'time_limit': time_limit})
                except Exception as e:
                    print("MILP error:", e)
                    return False, None
                return res.success, res
            
