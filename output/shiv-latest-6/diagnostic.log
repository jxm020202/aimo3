            def solve_pattern(n, d_tuple, e_tuple):
                N=n*n
                eqs=[]
                b=[]
                # row parity differences
                for i in range(1,n):
                    coeff=[0]*N
                    for j in range(n):
                        coeff[i*n + j] ^= 1
                    for j in range(n):
                        coeff[0*n + j] ^= 1
                    eqs.append(coeff)
                    b.append(d_tuple[i-1])
                # column parity differences
                for j in range(1,n):
                    coeff=[0]*N
                    for i in range(n):
                        coeff[i*n + j] ^= 1
                    for i in range(n):
                        coeff[i*n + 0] ^= 1
                    eqs.append(coeff)
                    b.append(e_tuple[j-1])
                # Gaussian elimination
                m=len(eqs)
                A=[eqs[i][:] + [b[i]] for i in range(m)]
                row=0
                col=0
                pivot_cols=[]
                while row < m and col < N:
                    # find pivot
                    pivot=None
                    for r in range(row,m):
                        if A[r][col]:
                            pivot=r
                            break
                    if pivot is None:
                        col+=1
                        continue
                    A[row],A[pivot]=A[pivot],A[row]
                    # eliminate other rows
                    for r in range(m):
                        if r!=row and A[r][col]:
                            A[r]=[(a^b) for a,b in zip(A[r],A[row])]
                    pivot_cols.append(col)
                    row+=1
                    col+=1
                # check consistency
                for r in range(m):
                    if all(v==0 for v in A[r][:-1]) and A[r][-1]==1:
                        raise ValueError("Inconsistent")
                # back substitution, set free vars 0
                x=[0]*N
                for r_idx in reversed(range(len(pivot_cols))):
                    piv = pivot_cols[r_idx]
                    s = A[r_idx][-1]
                    # subtract known vars
                    for c in range(piv+1,N):
                        if A[r_idx][c] and x[c]:
                            s ^= 1
                    x[piv]=s
                return x
            
