            def collinearity_for_angles(alpha_deg,beta_deg,gamma_deg):
                alpha = math.radians(alpha_deg)
                beta = math.radians(beta_deg)
                gamma = math.radians(gamma_deg)
                # points
                X = complex(1,0)
                Y = cmath.exp(1j*2*gamma)
                Z = cmath.exp(-1j*2*beta)
                # compute P (Fermat point)
                rot = cmath.exp(1j*math.pi/3)
                Bp = X + rot*(Y - X)
                Cp = Y + rot*(Z - Y)
                # intersection
                def cross(u,v):
                    return (u.conjugate()*v).imag
                u = Z - Bp
                v = X - Cp
                w = Cp - Bp
                denom = cross(u, v)
                if abs(denom) < 1e-12:
                    return None
                t = cross(w, v) / denom
                P = Bp + t*u
                N = (X + Y + Z)/2
                # collinearity measure
                val = (P - Y).conjugate() * (N - Y)
                return val.imag
            
            print(collinearity_for_angles(50,60,70))
            
