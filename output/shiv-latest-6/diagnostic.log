            from collections import deque
            
            def find_path(N):
                init = [False if (i%2==0) else True for i in range(N)]
                target = tuple([True]*N)
                visited=set()
                q=deque()
                parent={}
                for i in range(N):
                    cfg = init.copy()
                    cfg[i]=not cfg[i]
                    state=(i, tuple(cfg))
                    q.append(state)
                    visited.add(state)
                    parent[state]=None
                while q:
                    pos,cfg = q.popleft()
                    if cfg==target:
                        # reconstruct
                        path=[]
                        cur=(pos,cfg)
                        while cur is not None:
                            path.append(cur)
                            cur=parent[cur]
                        path.reverse()
                        return path
                    for nb in [pos-1,pos+1]:
                        if 0<=nb<N:
                            newcfg=list(cfg)
                            newcfg[nb]=not newcfg[nb]
                            newstate=(nb, tuple(newcfg))
                            if newstate not in visited:
                                visited.add(newstate)
                                parent[newstate]=(pos,cfg)
                                q.append(newstate)
                return None
            
            path5=find_path(5)
            len(path5)-1
            
