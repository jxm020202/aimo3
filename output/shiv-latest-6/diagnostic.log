            import sympy as sp
            
            # define symbols
            A, B = sp.symbols('A B', positive=True)
            C = sp.pi - A - B
            
            # define unit vectors as complex numbers using sympy
            # Represent as 2D vectors (x,y)
            def unit_vec(theta):
                return sp.Matrix([sp.cos(theta), sp.sin(theta)])
            
            # vertices
            a = unit_vec(0)  # X at angle 0
            b = unit_vec(2*C)  # Y at angle 2C
            c = unit_vec(2*C + 2*A)  # Z
            
            # nine-point center n = (a+b+c)/2
            n = (a + b + c) / 2
            
            # barycentric coefficients for Fermat point
            coeff_a = 1/sp.sin(A + sp.pi/3)
            coeff_b = 1/sp.sin(B + sp.pi/3)
            coeff_c = 1/sp.sin(C + sp.pi/3)
            
            f = (coeff_a * a + coeff_b * b + coeff_c * c) / (coeff_a + coeff_b + coeff_c)
            
            # compute cross product (2D) of (f-b) and (n-b)
            def cross2(u, v):
                return u[0]*v[1] - u[1]*v[0]
            
            cross = sp.simplify(cross2(f - b, n - b))
            cross_simpl = sp.simplify(sp.trigsimp(cross))
            cross_simpl
            
