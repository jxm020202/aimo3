            import sympy as sp
            
            # variables
            a,b,xs,ys = sp.symbols('a b xs ys', real=True)
            
            # radius r
            r = ((a- sp.Rational(1,2))**2 + b**2)/(2*b)
            
            # t_P
            tP = sp.Rational(1,4)/(a**2 + b**2)
            
            xp = a*tP
            yp = b*tP
            
            # s_Q
            sQ = ( (a-1)**2 + b**2 + sp.Rational(3,4) ) / ( (a-1)**2 + b**2 + 1 )
            xq = a + sQ*(1-a)
            yq = b*(1 - sQ)
            
            # equations
            eq_circle = (xs- sp.Rational(1,2))**2 + (ys - r)**2 - r**2
            
            # equilateral: ZP = ZS and ZP = PS
            eq1 = (1 - xp)**2 + (0 - yp)**2 - ((1 - xs)**2 + (0 - ys)**2)  # ZP^2 - ZS^2 =0
            eq2 = (1 - xp)**2 + (0 - yp)**2 - ((xp - xs)**2 + (yp - ys)**2)  # ZP^2 - PS^2 =0
            
            # angle condition: cos(QP,SP) = cos(XZ, YZ)
            # vectors
            vQP = sp.Matrix([xp - xq, yp - yq])
            vSP = sp.Matrix([xp - xs, yp - ys])
            vXZ = sp.Matrix([0-1, 0-0])  # ZX vector from Z to X = (-1,0)
            vYZ = sp.Matrix([a-1, b-0])  # ZY vector from Z to Y = (a-1,b)
            
            def cos_eq(v1, v2):
                return (v1.dot(v2)) / (sp.sqrt(v1.dot(v1))*sp.sqrt(v2.dot(v2)))
            
            cos1 = cos_eq(vQP, vSP)
            cos2 = cos_eq(vXZ, vYZ)
            eq3 = sp.simplify(cos1 - cos2)
            
            eqs = [eq_circle, eq1, eq2, eq3]
            
            eqs
            
