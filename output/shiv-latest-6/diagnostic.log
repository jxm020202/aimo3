            import sympy as sp
            # Define symbols
            A, B = sp.symbols('A B', positive=True)
            C = sp.pi - A - B
            
            # side a = 1
            a = sp.Rational(1,1)
            # b = sin B / sin A
            b = sp.sin(B)/sp.sin(A)
            c = sp.sin(C)/sp.sin(A)
            
            # coordinates
            Y = sp.Point(0,0)
            Z = sp.Point(1,0)
            X = sp.Point(c*sp.cos(B), c*sp.sin(B))
            
            # Fermat point using barycentric weights
            wX = 1/sp.sin(A + sp.pi/3)
            wY = 1/sp.sin(B + sp.pi/3)
            wZ = 1/sp.sin(C + sp.pi/3)
            s = wX + wY + wZ
            Px = (wX*X.x + wY*Y.x + wZ*Z.x)/s
            Py = (wX*X.y + wY*Y.y + wZ*Z.y)/s
            P = sp.Point(Px, Py)
            
            # Nine-point center N: circumcenter of midpoints
            MXY = sp.Point((X.x+Y.x)/2, (X.y+Y.y)/2)
            MYZ = sp.Point((Y.x+Z.x)/2, (Y.y+Z.y)/2)
            MZX = sp.Point((Z.x+X.x)/2, (Z.y+X.y)/2)
            
            # circumcenter function symbolic
            def circumcenter_sym(P1,P2,P3):
                x1,y1 = P1.x, P1.y
                x2,y2 = P2.x, P2.y
                x3,y3 = P3.x, P3.y
                d = 2*(x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))
                ux = ((x1**2 + y1**2)*(y2 - y3) + (x2**2 + y2**2)*(y3 - y1) + (x3**2 + y3**2)*(y1 - y2))/d
                uy = ((x1**2 + y1**2)*(x3 - x2) + (x2**2 + y2**2)*(x1 - x3) + (x3**2 + y3**2)*(x2 - x1))/d
                return sp.Point(sp.simplify(ux), sp.simplify(uy))
            
            N = circumcenter_sym(MXY, MYZ, MZX)
            Nx, Ny = N.x, N.y
            
            # Condition determinant zero:
            det = sp.simplify(Nx*Py - Ny*Px)
            det_simpl = sp.simplify(sp.factor(det))
            det_simpl
            
