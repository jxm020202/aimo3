            import mpmath as mp
            mp.mp.dps = 80
            
            def fermat_point_mp(A,B,C):
                # A,B,C are complex numbers (mp.mpc)
                rot = mp.e**(mp.j*mp.pi/3)  # e^{iπ/3}
                D = A + (B - A)*rot
                E = B + (C - B)*rot
                # Solve intersection of lines C-D and A-E
                # param t for line CD: C + t*(D-C)
                # param s for line AE: A + s*(E-A)
                # Solve for t,s: C + t*(D-C) = A + s*(E-A)
                # Write as two equations for real and imag
                # Use mp.matrix solve
                # Represent unknowns t,s
                # We'll solve linear equations: t*(D-C) - s*(E-A) = A - C
                # Let u = D-C, v = E-A, w = A-C
                u = D - C
                v = E - A
                w = A - C
                # Represent as 2x2 real matrix
                M = mp.matrix([[mp.re(u), -mp.re(v)],
                               [mp.im(u), -mp.im(v)]])
                rhs = mp.matrix([mp.re(w), mp.im(w)])
                sol = mp.lu_solve(M, rhs)
                t = sol[0]
                # compute intersection point
                F = C + t*u
                return F
            
            def circumcenter_mp(A,B,C):
                # using formula for circumcenter of triangle with complex coordinates
                # Convert to mp.mpc
                ax, ay = mp.re(A), mp.im(A)
                bx, by = mp.re(B), mp.im(B)
                cx, cy = mp.re(C), mp.im(C)
                d = 2*(ax*(by-cy) + bx*(cy-ay) + cx*(ay-by))
                ux = ((ax**2+ay**2)*(by-cy) + (bx**2+by**2)*(cy-ay) + (cx**2+cy**2)*(ay-by))/d
                uy = ((ax**2+ay**2)*(cx-bx) + (bx**2+by**2)*(ax-cx) + (cx**2+cy**2)*(bx-ax))/d
                return mp.mpc(ux, uy)
            
            def nine_point_center_mp(A,B,C):
                O = circumcenter_mp(A,B,C)
                # orthocenter H = A+B+C - 2*O
                H = A + B + C - 2*O
                return (O + H)/2
            
