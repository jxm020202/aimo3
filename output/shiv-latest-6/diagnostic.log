            def angle(a,b,c):
                # angle at b formed by points a-b-c
                v1 = sp.Matrix([a[0]-b[0], a[1]-b[1]])
                v2 = sp.Matrix([c[0]-b[0], c[1]-b[1]])
                dot = float(v1.dot(v2))
                norm1 = float(sp.sqrt(v1.dot(v1)))
                norm2 = float(sp.sqrt(v2.dot(v2)))
                return math.degrees(math.acos(dot/(norm1*norm2)))
            
            def compute_angles(theta):
                res = fermat_point(theta)
                if res is None:
                    return None
                fx, fy, Nx, Ny = res
                X = (math.cos(theta), math.sin(theta))
                Y = (0.0, 0.0)
                Z = (1.0, 0.0)
                P = (fx, fy)
                a1 = angle(X, P, Y)
                a2 = angle(Y, P, Z)
                a3 = angle(Z, P, X)
                return a1, a2, a3
            
