            import cmath, math, random
            
            def fermat_point(X, Y, Z):
                # using complex numbers, construct equilateral outward on each side
                # orientation: outward meaning external to triangle; we can choose same orientation for all sides.
                # Use rotation by +60 degrees (counterclockwise) of side vectors.
                omega = cmath.rect(1, math.radians(60))  # e^{i60}
                # point on side YZ outward: T = Y + omega*(Z - Y)
                T = Y + omega*(Z - Y)
                # point on side ZX outward: U = Z + omega*(X - Z)
                U = Z + omega*(X - Z)
                # line X-T and Y-U intersect
                # Solve for intersection of lines (X + s*(T-X)) and (Y + t*(U-Y))
                def intersect(p1, p2, p3, p4):
                    # returns intersection of lines p1p2 and p3p4
                    # using complex numbers: solve p1 + s*(p2-p1) = p3 + t*(p4-p3)
                    a = p2 - p1
                    b = p4 - p3
                    # solve for s: (p3 - p1) = s*a - t*b
                    # treat as 2D real equations
                    A = [[a.real, -b.real],[a.imag, -b.imag]]
                    B = [p3.real - p1.real, p3.imag - p1.imag]
                    s, t = np.linalg.solve(A, B)
                    return p1 + s*a
                import numpy as np
                F = intersect(X, T, Y, U)
                return F
            
            def test(d_deg):
                d = math.radians(d_deg)
                A = math.radians(60 - d_deg)  # Wait A = 60° - d
                C = math.radians(60 + d_deg)
                B = math.radians(60)
                # central angles
                X = complex(1,0)
                Y = cmath.rect(1, 2*C)  # angle 2C
                Z = cmath.rect(1, -2*B)  # angle -2B
                F = fermat_point(X, Y, Z)
                # nine-point center N = (X+Y+Z)/2 (since circumcenter at 0)
                N = (X+Y+Z)/2
                # check collinearity Y, F, N: cross product of vectors (F-Y) and (N-Y) should be ~0 imaginary part of (F-Y)/(N-Y) real
                col = abs(((F - Y)/(N - Y)).imag) < 1e-6
