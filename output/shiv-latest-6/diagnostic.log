            import math, random
            
            def angle_Z(a,b):
                # compute angle at Z in degrees
                zx = (-a, -b)
                zy = (1-a, -b)
                dot = zx[0]*zy[0] + zx[1]*zy[1]
                norm1 = math.hypot(*zx)
                norm2 = math.hypot(*zy)
