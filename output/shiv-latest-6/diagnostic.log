            def guaranteed_n_bruteforce(n):
                total = n*n
                # generate all parity patterns (R,C) consistent
                max_min = -1
                worst_pattern = None
                for R in itertools.product([0,1], repeat=n):
                    for C in itertools.product([0,1], repeat=n):
                        if sum(R)%2 != sum(C)%2:
                            continue
                        evenRows = sum(1 for r in R if r==0)
                        evenCols = sum(1 for c in C if c==0)
                        oddRows = n - evenRows
                        oddCols = n - evenCols
                        m = min(max(evenRows, evenCols), max(oddRows, oddCols))
                        if m > max_min:
                            max_min = m
                            worst_pattern = (R,C)
