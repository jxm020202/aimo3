            def compute_R(r1):
                # solve sum condition: sin((θ+β+φ)/2)=7.5/R where θ=2asin(r1/(2R)), φ=2asin((15-r1)/(2R)), β=2asin(8/R)
                def f(R):
                    theta = 2*mp.asin(r1/(2*R))
                    phi = 2*mp.asin((15-r1)/(2*R))
                    beta = 2*mp.asin(8/R)
                    lhs = mp.sin((theta+beta+phi)/2)
                    return lhs - 7.5/R
                # find root for R > max(...)
                low = max(8,7.5,1, r1/2, (15-r1)/2)+1e-6
                try:
                    R = mp.findroot(f, low+5)
                    return R
                except:
                    return None
            
            def residual_eq2(r1):
                R = compute_R(r1)
                if R is None:
                    return None
                r2 = 15 - r1
                # compute h from eq1
                h_sq = r2**2 - (R - 7.5)**2
                if h_sq < 0:
                    return None
                h = mp.sqrt(h_sq)
                alpha = 2*mp.asin(1/R)
                # compute distance P1Q squared
                lhs = (7.5 + R*mp.cos(alpha))**2 + (h + R*mp.sin(alpha))**2
                return lhs - r1**2
            
            # scan r1 values
            for r1 in mp.arange(1,14,0.5):
                res = residual_eq2(r1)
                print(r1, res)
            
