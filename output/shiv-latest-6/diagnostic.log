            def barycentric_coords(P, X, Y, Z):
                # compute barycentric coordinates (u:v:w) such that P = (u*X+v*Y+w*Z)/(u+v+w)
                # Solve linear system for u,v,w up to scale.
                # Use area method: coordinates proportional to areas of opposite subtriangles.
                # Using formula based on determinants.
                mat = np.array([X, Y, Z]).T
                # Solve for weights: mat * [u,v,w] = P * (u+v+w)
                # Not straightforward. Use linear solve for u,v,w with constraint u+v+w=1.
                # Solve for u,v,w directly: P = u*X + v*Y + w*Z, with u+v+w=1.
                A = np.vstack([mat, np.ones(3)])
                b = np.append(P, 1)
                sol = np.linalg.lstsq(A.T, b, rcond=None)[0]
                return sol
            
