            def nullspace_mod2(matrix):
                # matrix rows: m x n over GF(2)
                m = len(matrix)
                n = len(matrix[0])
                A = [row[:] for row in matrix]
                # Perform Gaussian elimination to row-echelon form, track pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot
                    pivot = None
                    for r in range(row, m):
                        if A[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    pivot_cols.append(col)
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r][col]:
                            A[r] = [(a ^ b) for a,b in zip(A[r], A[row])]
                    row += 1
                    if row == m:
                        break
                rank = len(pivot_cols)
                free_cols = [c for c in range(n) if c not in pivot_cols]
                # Build basis vectors for nullspace
                basis = []
                for free in free_cols:
                    vec = [0]*n
                    vec[free] = 1
                    # set pivot variables according to equations
                    # For each pivot row, the pivot column variable expressed as sum of free vars where row has 1
                    for r, pc in enumerate(pivot_cols):
                        if A[r][free]:
                            vec[pc] = 1
                    basis.append(vec)
                return basis
            
