            from collections import deque
            
            def min_moves(n):
                # initial state list of bool: True=heads, False=tails
                init = [(i%2==0) for i in range(n)]  # 0-index: position0 tails (False),1 heads (True)
                target = [True]*n
                # BFS over (state tuple, last index flipped or None)
                start = (tuple(init), None, 0)  # steps 0
                seen = set()
                q = deque([start])
                while q:
                    state, last, steps = q.popleft()
                    if state == tuple(target):
                        return steps
                    key = (state, last)
                    if key in seen:
                        continue
                    seen.add(key)
                    # possible flips
                    if last is None:
                        candidates = range(n)
                    else:
                        candidates = [i for i in (last-1, last+1) if 0 <= i < n]
                    for i in candidates:
                        lst = list(state)
                        lst[i] = not lst[i]
                        q.append((tuple(lst), i, steps+1))
                return None
            
            for n in range(1,8):
