        >>> Code:
            def gf2_nullspace(A):
                # A is matrix shape (m,n) over GF(2)
                A = A.copy()
                m, n = A.shape
                # Perform row echelon on A, keep track of pivot columns
                pivot_cols = []
                row = 0
                for col in range(n):
                    # find pivot row
                    pivot = None
                    for r in range(row, m):
                        if A[r, col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap
                    if pivot != row:
                        A[[pivot, row]] = A[[row, pivot]]
                    # eliminate other rows
                    for r in range(m):
                        if r != row and A[r, col]:
                            A[r] ^= A[row]
                    pivot_cols.append(col)
                    row += 1
                    if row == m:
                        break
                # Now rows are in reduced row echelon form
                # Determine free columns
                free_cols = [c for c in range(n) if c not in pivot_cols]
                basis = []
                for free in free_cols:
                    vec = np.zeros(n, dtype=np.uint8)
                    vec[free] = 1
                    # For each pivot row, set entry according to row's coefficient at free column
                    for i, piv in enumerate(pivot_cols):
                        if A[i, free]:
                            vec[piv] = 1
                    basis.append(vec)
                return np.array(basis, dtype=np.uint8)
            
            # compute nullspace of M.T
            size=19
            n=size*size
            M = np.zeros((n, n), dtype=np.uint8)
            def idx(i,j):
                return i*size + j
            for i in range(size):
                for j in range(size):
                    col = idx(i,j)
                    for k in range(size):
                        M[idx(i,k), col] ^= 1
                        M[idx(k,j), col] ^= 1
                    M[idx(i,j), col] ^= 1
            
            null_basis = gf2_nullspace(M.T)
            null_basis.shape
