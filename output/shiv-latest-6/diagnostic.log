                eqs = [(Cc - v).dot(Cc - v) - (Cc - A).dot(Cc - A) for v in [B,Cv,D]]
                solC = sp.solve(eqs, (x,y,z), dict=True)[0]
                Cc = sp.Matrix([sp.nsimplify(solC[x]), sp.nsimplify(solC[y]), sp.nsimplify(solC[z])])
                # orthocenter K: intersection of altitudes from A and B (should be same as from C)
                # compute altitude direction normals
                def altitude(vertex, others):
                    p1,p2,p3 = others
                    normal = (p2-p1).cross(p3-p1)
                    return (vertex, normal)
                lineA = altitude(A, [B,Cv,D])
                lineB = altitude(B, [A,Cv,D])
                s,tpar = sp.symbols('s tpar')
                sol = sp.solve(lineA[0] + s*lineA[1] - (lineB[0] + tpar*lineB[1]), (s,tpar), dict=True)[0]
                K = sp.simplify(lineA[0] + sol[s]*lineA[1])
