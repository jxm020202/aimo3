            import random, numpy as np, math
            
            def random_orthocentric():
                # generate random points satisfying opposite edge orthogonal
                # Approach: generate random vectors a,b,c then compute d to satisfy conditions.
                # Use equations: (a-b)·(c-d)=0, (a-c)·(b-d)=0, (a-d)·(b-c)=0.
                # Choose a,b,c random, solve for d.
                a = np.random.randn(3)
                b = np.random.randn(3)
                c = np.random.randn(3)
                # unknown d = (x,y,z). Solve linear equations for d.
                # Write equations linear in d:
                # (a-b)·(c-d)=0 => (a-b)·c - (a-b)·d =0 => (a-b)·d = (a-b)·c
                # similarly (a-c)·(b-d)=0 => (a-c)·d = (a-c)·b
                # (a-d)·(b-c)=0 => a·(b-c) - d·(b-c)=0 => d·(b-c) = a·(b-c)
                A = np.stack([a-b, a-c, b-c])  # each row dot with d
                rhs = np.array([np.dot(a-b,c), np.dot(a-c,b), np.dot(a,b-c)])
                # Solve linear system A d = rhs
                try:
                    d = np.linalg.solve(A, rhs)
                except np.linalg.LinAlgError:
                    return None
                # Check volume non-zero
                vol = np.dot(np.cross(b-a, c-a), d-a)
                if abs(vol) < 1e-6:
                    return None
                return [a,b,c,d]
            
            def compute_K(verts):
                a,b,c,d = verts
                # set up linear equations (K - a)·(b-c)=0 and (K - a)·(b-d)=0 for i=1
                # We'll collect equations for i=1,2 (enough)
                equations = []
                rhs = []
                # i=1 (a)
                equations.append(b-c)
                rhs.append(np.dot(a, b-c))
                equations.append(b-d)
                rhs.append(np.dot(a, b-d))
                # i=2 (b)
                equations.append(a-c)
                rhs.append(np.dot(b, a-c))
                equations.append(a-d)
                rhs.append(np.dot(b, a-d))
                A = np.stack(equations)  # 4x3
                # Solve least squares for K
                K, residuals, rank, s = np.linalg.lstsq(A, rhs, rcond=None)
                return K
            
            def ratio_KXKY(verts):
                a,b,c,d = verts
                K = compute_K(verts)
                # foot X from a to plane b,c,d
                normal = np.cross(c-b, d-b)
                t = -np.dot(a-b, normal)/np.dot(normal, normal)
                X = a + t*normal
                # line aK direction
                dir_vec = K - a
                # intersect sphere centered at circumcenter? Need circumcenter C.
                # Compute circumcenter of tetrahedron (unique sphere through four points)
                # Use linear algebra solving for center O.
                A = np.stack([2*(b-a), 2*(c-a), 2*(d-a)])  # 3x3
                rhs = np.array([np.dot(b,b)-np.dot(a,a),
                                np.dot(c,c)-np.dot(a,a),
                                np.dot(d,d)-np.dot(a,a)])
                O = np.linalg.solve(A, rhs)
                R = np.linalg.norm(a - O)
                # line param a + s*dir, find second intersection with sphere
                # Solve |a + s*dir - O|^2 = R^2
                # Let p = a - O
                p = a - O
                Acoeff = np.dot(dir_vec, dir_vec)
                Bcoeff = 2*np.dot(p, dir_vec)
                Ccoeff = np.dot(p,p) - R**2
                disc = Bcoeff**2 - 4*Acoeff*Ccoeff
                if disc < 0:
                    return None
                s1 = (-Bcoeff + math.sqrt(disc))/(2*Acoeff)
                s2 = (-Bcoeff - math.sqrt(disc))/(2*Acoeff)
                # one solution should be s=0 (a point). Choose the other.
                s_vals = [s1,s2]
                sY = s_vals[0] if abs(s_vals[0])>1e-6 else s_vals[1]
                Y = a + sY*dir_vec
                KX = np.linalg.norm(K - X)
                KY = np.linalg.norm(K - Y)
                return KX/KY
            
            # test generate many
            for _ in range(10):
                verts = None
                while verts is None:
                    verts = random_orthocentric()
                r = ratio_KXKY(verts)
                print(r)
            
