            def is_convex(poly):
                n = len(poly)
                prev = 0
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    x3,y3 = poly[(i+2)%n]
                    # vector from i to i+1 and i+1 to i+2
                    cross = (x2-x1)*(y3-y2) - (y2-y1)*(x3-x2)
