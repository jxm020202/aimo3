            import numpy as np, math
            
            def construct(p,e,f):
                t1 = np.array([1.0,0.0,0.0])
                t2 = np.array([p, p*(1-p)/e, 0.0])
                t3 = np.array([p, e, f])
                t4 = np.array([p, e, (-e**2 - p**2 + p)/f])
                # circumcenter computed formula
                C = np.array([ (3*p)/2 + 0.5,
                              (2*e**2 - p**2 + p)/(2*e),
                              (-e**2 + f**2 - p**2 + p)/(2*f) ])
                # orthocenter K at origin
                K = np.array([0.0,0.0,0.0])
                # compute X: intersection of line K->t1 with plane of t2,t3,t4
                # plane equation: normal = (t3-t2) x (t4-t2)
                normal = np.cross(t3-t2, t4-t2)
                # param s such that s*t1 lies in plane: (s*t1 - t2)·normal =0
                s = np.dot(t2, normal) / np.dot(t1, normal)  # because (s t1 - t2)·n =0 => s t1·n = t2·n
                X = s * t1
                # compute Y: other intersection of line with sphere centered at C radius = |t1-C|
                R2 = np.dot(t1-C, t1-C)
                # solve for mu: |mu t1 - C|^2 = R2
                # quadratic: (t1·t1) mu^2 -2 (t1·C) mu + C·C - R2 =0
                A = np.dot(t1,t1)
                B = np.dot(t1,C)
                # roots:
                coeff = [A, -2*B, np.dot(C,C)-R2]
                roots = np.roots(coeff)
                # pick root not equal to 1
                mu_vals = roots
                mu2 = [mu for mu in mu_vals if abs(mu-1)>1e-6][0]
                Y = mu2 * t1
                KX = np.linalg.norm(X-K)
                KY = np.linalg.norm(Y-K)
                return KX/KY
            
