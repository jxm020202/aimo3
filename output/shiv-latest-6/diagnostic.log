            def compute_points(b,c,B):
                # coordinates
                Y = np.array([0.0,0.0])
                X = np.array([c,0.0])
                Z = np.array([b*math.cos(B), b*math.sin(B)])
                # side a = XZ distance
                a = np.linalg.norm(X-Z)
                # compute angles using law of cos
                # angle at X = A opposite side b
                cosA = (c**2 + a**2 - b**2)/(2*c*a)
                cosA = max(-1,min(1,cosA))
                A = math.acos(cosA)
                # angle at Z = C opposite side c
                cosC = (b**2 + a**2 - c**2)/(2*b*a)
                cosC = max(-1,min(1,cosC))
                C = math.acos(cosC)
                # verify sum
                # compute Fermat point using barycentric coordinates (weights)
                wX = 1/math.sin(A + math.pi/3)
                wY = 1/math.sin(B + math.pi/3)
                wZ = 1/math.sin(C + math.pi/3)
                total = wX + wY + wZ
                F = (wX*X + wY*Y + wZ*Z)/total
                # compute nine-point center N: circumcenter of medial triangle
                M_XY = (X+Y)/2
                M_YZ = (Y+Z)/2
                M_ZX = (Z+X)/2
                # circumcenter function
                def circumcenter(p1,p2,p3):
                    # using perpendicular bisectors
                    d = 2*(p1[0]*(p2[1]-p3[1]) + p2[0]*(p3[1]-p1[1]) + p3[0]*(p1[1]-p2[1]))
                    if abs(d) < 1e-12:
                        return None
                    ux = ((np.dot(p1,p1))*(p2[1]-p3[1]) + (np.dot(p2,p2))*(p3[1]-p1[1]) + (np.dot(p3,p3))*(p1[1]-p2[1]))/d
                    uy = ((np.dot(p1,p1))*(p3[0]-p2[0]) + (np.dot(p2,p2))*(p1[0]-p3[0]) + (np.dot(p3,p3))*(p2[0]-p1[0]))/d
                    return np.array([ux, uy])
                N = circumcenter(M_XY, M_YZ, M_ZX)
                return A,B,C,F,N
            
            def collinearity_measure(Y,F,N):
                # compute area of triangle YFN (cross product magnitude) divided by length YN
                v1 = F - Y
                v2 = N - Y
                area = abs(np.cross(v1, v2))
                return area  # zero if collinear
            
