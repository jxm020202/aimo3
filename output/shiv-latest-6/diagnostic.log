            def nullspace_dim(n):
                # Build matrix of operations (rows = ops, cols = cells)
                ops = []
                for i in range(n):
                    for j in range(n):
                        vec = [0]*(n*n)
                        for c in range(n):
                            vec[i*n + c] = 1
                        for r in range(n):
                            vec[r*n + j] ^= 1
                        ops.append(vec)
                # compute rank
                rank = rank_mod2(ops)
                return n*n - rank
            
