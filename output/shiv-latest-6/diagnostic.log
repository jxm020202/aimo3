            def nullspace_basis(matrix_rows, nbits):
                # matrix_rows: list of ints representing rows of size nbits
                # returns list of basis vectors for nullspace (as ints)
                # Perform Gaussian elimination to row-reduce matrix, track pivots, then back-substitution to get nullspace.
                rows = matrix_rows[:]  # copy
                m = len(rows)
                n = nbits
                pivots = []
                # forward elimination
                row = 0
                for col in range(n-1, -1, -1):
                    # find a row with a 1 in this column at or below current row
                    sel = None
                    for i in range(row, m):
                        if (rows[i] >> col) & 1:
                            sel = i
                            break
                    if sel is None:
                        continue
                    # swap
                    rows[row], rows[sel] = rows[sel], rows[row]
                    pivots.append(col)
                    # eliminate other rows
                    for i in range(m):
                        if i != row and ((rows[i] >> col) & 1):
                            rows[i] ^= rows[row]
                    row += 1
                    if row == m:
                        break
                # Now rows are in reduced row-echelon form (over GF2) with pivots.
                # Determine free columns
                pivot_set = set(pivots)
                free_cols = [c for c in range(n) if c not in pivot_set]
                basis = []
                # For each free column, set that column to 1, others free to 0, solve for pivot columns.
                for free in free_cols:
                    vec = 0
                    # set free column bit
                    vec |= 1 << free
                    # back substitution: for each pivot row, compute its value
                    # rows are in order of pivots list
                    for r_idx, col in enumerate(pivots):
                        # row r_idx corresponds to pivot at column col
                        # compute sum of known bits in this row (excluding pivot col)
                        # row bits are rows[r_idx]
                        # we need dot product of row with vec (excluding pivot col) mod 2
                        # Since row has 1 at pivot col, we set that variable to make equation hold 0.
                        # Equation: sum_{j} row_j * x_j = 0 (mod2). So x_pivot = sum_{j != pivot} row_j * x_j.
                        # Compute parity of (rows[r_idx] & vec) ignoring pivot bit.
                        # Actually rows[r_idx] includes pivot bit; we can compute parity of (rows[r_idx] & vec) then XOR with x_pivot to get 0.
                        # So x_pivot = parity of (rows[r_idx] & vec) (excluding pivot). We'll compute parity of (rows[r_idx] & vec) then set pivot accordingly.
                        # Let's compute parity of (rows[r_idx] & vec) ignoring pivot col.
                        rowbits = rows[r_idx]
                        # compute parity of bits where rowbits has 1 and vec has 1, except pivot col
                        # we can compute (rowbits & vec) then toggle pivot bit if set in vec (but we haven't set pivot yet)
                        # Since vec currently does not have pivot bits set (we will set them now)
                        # So parity = popcount(rowbits & vec) % 2
                        parity = bin(rowbits & vec).count("1") % 2
                        # set pivot bit to parity (since we need rowbits·x = 0 => x_pivot = parity)
                        if parity:
                            vec |= 1 << col
                    basis.append(vec)
                return basis
            
            # Build matrix rows as operation vectors
            rows = [op_vector(r,c) for r in range(19) for c in range(19)]
            basis_null = nullspace_basis(rows, 361)
            len(basis_null)
            
