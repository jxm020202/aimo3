            def reachable_sums(n, max_total=30):
                # brute force all assignments with values nonnegative up to max_total maybe.
                # Use recursion with pruning based on adjacency constraints.
                # For n up to 3 maybe feasible.
                reachable=set()
                grid=[[None]*n for _ in range(n)]
                def backtrack(pos, current_sum):
                    if pos==n*n:
                        reachable.add(current_sum)
                        return
                    i=pos//n
                    j=pos%n
                    # Determine possible values based on up/left neighbors
                    possible=None
                    if i>0:
                        up=grid[i-1][j]
                        possible={up+1, up-1}
                    if j>0:
                        left=grid[i][j-1]
                        if possible is None:
                            possible={left+1, left-1}
                        else:
                            possible=possible.intersection({left+1, left-1})
                    if possible is None:
                        # no constraints: any nonnegative up to max_total
                        for val in range(0, max_total+1):
                            grid[i][j]=val
                            backtrack(pos+1, current_sum+val)
                            grid[i][j]=None
                        return
                    # filter nonnegative and not too large
                    for val in possible:
                        if val<0 or val>max_total: continue
                        grid[i][j]=val
                        backtrack(pos+1, current_sum+val)
                        grid[i][j]=None
                backtrack(0,0)
                return sorted(reachable)
            
