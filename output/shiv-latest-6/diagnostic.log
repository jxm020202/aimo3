            def triangle_angles(A,B,C):
                # returns angles at A,B,C in radians
                import sympy as sp
                a = B.distance(C)
                b = A.distance(C)
                c = A.distance(B)
                # law of cos
                angleA = sp.acos((b**2 + c**2 - a**2)/(2*b*c))
                angleB = sp.acos((a**2 + c**2 - b**2)/(2*a*c))
                angleC = sp.pi - angleA - angleB
                return [sp.N(angleA), sp.N(angleB), sp.N(angleC)]
            
