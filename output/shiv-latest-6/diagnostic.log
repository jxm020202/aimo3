            def dist_point_to_line(px, py, vx, vy):
                # line passes through origin with direction v
                # distance = |px*(-vy) + py*vx| / sqrt(vx^2+vy^2)
                return abs(px*(-vy) + py*vx)/math.sqrt(vx**2+vy**2)
            
