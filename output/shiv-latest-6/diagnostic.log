            def optimal_black_count(board):
                # board is 19x19 list of 0/1 (0 white,1 black)
                n=19
                N=n*n
                # compute w = 1-2A
                w = [[1-2*board[i][j] for j in range(n)] for i in range(n)]
                # precompute total_i per row
                total_row = [sum(row) for row in w]  # odd numbers between -19 and 19
                best = -1
                # iterate over all y vectors
                for y_int in range(1<<n):
                    y = [(y_int>>j)&1 for j in range(n)]
                    # compute S_i = sum_j w_{i,j} * y_j
                    S = []
                    for i in range(n):
                        s = 0
                        roww = w[i]
                        for j in range(n):
                            if y[j]:
                                s += roww[j]
                        S.append(s)
                    # decide x_i
                    x = []
                    sum_x = 0
                    total = 0
                    for i in range(n):
                        s = S[i]
                        t = total_row[i] - s
                        if t > s:
                            xi = 1
                            contrib = t
                        else:
                            xi = 0
                            contrib = s
                        x.append(xi)
                        sum_x += xi
                        total += contrib
                    sum_y = sum(y)
                    if (sum_x - sum_y) % 2 != 0:
                        continue
                    # total = sum w_{i,j} (x_i xor y_j)
                    # final black count = base + total
                    base = sum(board[i][j] for i in range(n) for j in range(n))
                    final = base + total
                    if final > best:
                        best = final
                return best
            
            # test on all white board
            n=19
            white_board = [[0]*n for _ in range(n)]
            print(optimal_black_count(white_board))
            
