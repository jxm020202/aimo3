            def find_labelings(n, max_val=5):
                solutions=[]
                # grid positions list
                cells=[(i,j) for i in range(n) for j in range(n)]
                # assign values via recursion
                grid=[[None]*n for _ in range(n)]
                def backtrack(idx):
                    if idx==n*n:
                        # check sum maybe
                        solutions.append([row[:] for row in grid])
                        return
                    i=idx//n
                    j=idx%n
                    # compute allowed values based on neighbors already assigned
                    # neighbors up and left maybe assigned
                    allowed=range(0, max_val+1)
                    if i>0:
                        v_up=grid[i-1][j]
                        if v_up is not None:
                            # must differ by 1
                            allowed=[v_up+1, v_up-1]
                    if j>0:
                        v_left=grid[i][j-1]
                        if v_left is not None:
                            # intersect with allowed
                            allowed2=[v_left+1, v_left-1]
                            allowed=[v for v in allowed if v in allowed2]
                    for v in allowed:
                        if v<0 or v>max_val: continue
                        grid[i][j]=v
                        backtrack(idx+1)
                        grid[i][j]=None
                backtrack(0)
                return solutions
            
