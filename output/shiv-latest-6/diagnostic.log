            # define function for internal angle bisector line at vertex V with adjacent points A,B (order V-A and V-B)
            def angle_bisector_line(V, A, B):
                # vectors from V to A and B
                v1 = sp.Matrix(A - V)
                v2 = sp.Matrix(B - V)
                # lengths
                l1 = sp.sqrt(v1.dot(v1))
                l2 = sp.sqrt(v2.dot(v2))
                # unit vectors
                u1 = v1 / l1
                u2 = v2 / l2
                # direction vector sum
                d = u1 + u2
                # line through V with direction d
                return sp.Line(V, V + sp.Point(d[0], d[1]))
            
