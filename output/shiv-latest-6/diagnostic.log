                            A1=area(F,p2,p3)
                            A2=area(p1,F,p3)
                            A3=area(p1,p2,F)
                            A0=area(p1,p2,p3)
                            if (A0>0 and A1>0 and A2>0 and A3>0) or (A0<0 and A1<0 and A2<0 and A3<0):
                                candidates.append(F)
                        except np.linalg.LinAlgError:
                            pass
                # return first candidate
                if candidates:
                    return candidates[0]
                else:
                    return None
            
