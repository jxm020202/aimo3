            def is_convex(poly):
                # assume polygon vertices in order
                n = len(poly)
                sign = None
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    x3,y3 = poly[(i+2)%n]
                    # cross product (p2-p1) x (p3-p2)
                    cross = (x2-x1)*(y3-y2) - (y2-y1)*(x3-x2)
                    if cross != 0:
                        if sign is None:
                            sign = cross > 0
                        else:
                            if (cross > 0) != sign:
                                return False
                return True
            
