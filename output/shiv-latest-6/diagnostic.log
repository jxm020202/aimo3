            import sympy as sp
            
            def find_small(m,n,limit=10):
                a,b,c,d=sp.symbols('a b c d', integer=True)
                x=sp.symbols('x')
                f = a*x**m + c
                g = b*x**n + d
                expr = sp.expand(f.subs(x,g) - 3*g.subs(x,f))
                # expr is polynomial in x
                # we want expr independent of x => coefficients of x^k for k>0 zero
                coeffs = [sp.expand(expr).coeff(x,i) for i in range(1, m*n+1)]
                # solve for a,b,c,d integers maybe small
                sol = sp.solve(coeffs, (a,b,c,d), dict=True)
                return sol
            
