            def compute_P(X, Y, Z):
                # Solve for point P such that angles XPY = YPZ = 120 degrees
                # Unknown (px, py)
                px, py = sp.symbols('px py', real=True)
                # vectors
                XP = sp.Matrix([px - X[0], py - X[1]])
                YP = sp.Matrix([px - Y[0], py - Y[1]])
                ZP = sp.Matrix([px - Z[0], py - Z[1]])
                # angle condition: dot product formula cos angle = (u·v)/(|u||v|)
                # cos 120 = -1/2
                eq1 = (XP.dot(YP)) / (sp.sqrt(XP.dot(XP))*sp.sqrt(YP.dot(YP))) + sp.Rational(1,2)
                eq2 = (YP.dot(ZP)) / (sp.sqrt(YP.dot(YP))*sp.sqrt(ZP.dot(ZP))) + sp.Rational(1,2)
                sol = sp.nsolve([eq1, eq2], [px, py], [0.2, 0.2])  # initial guess
                return float(sol[0]), float(sol[1])
            
            def nine_point_center(X, Y, Z):
                # Compute circumcenter of medial triangle (midpoints)
                M1 = ((X[0]+Y[0])/2, (X[1]+Y[1])/2)
                M2 = ((Y[0]+Z[0])/2, (Y[1]+Z[1])/2)
                M3 = ((Z[0]+X[0])/2, (Z[1]+X[1])/2)
                # circumcenter of triangle M1,M2,M3
                # use sympy geometry
                M1p = sp.Point(M1)
                M2p = sp.Point(M2)
                M3p = sp.Point(M3)
                circ = sp.Circle(M1p, M2p, M3p)
                O = circ.center
                return float(O.x), float(O.y)
            
