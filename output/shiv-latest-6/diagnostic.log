            def min_distance_to_code(v):
                v = np.array(v, dtype=int)
                const = np.sum(v)
                coeff = 1 - 2*v  # +1 for v_i=0, -1 for v_i=1
                n = len(v)
                m = H.shape[0]
                # Objective: minimize const + sum_i coeff_i * w_i
                c = np.concatenate([coeff.astype(float), np.zeros(m, dtype=float)])
                # Bounds: w_i in [0,1]; z_r >=0 (no upper bound)
                lower = np.concatenate([np.zeros(n), np.zeros(m)])
                upper = np.concatenate([np.ones(n), np.full(m, np.inf)])
                bounds = Bounds(lower, upper)
                # Constraints matrix
                A = np.zeros((m, n+m), dtype=int)
                for r in range(m):
                    A[r,:n] = H[r]
                    A[r, n+r] = -2
                lc = LinearConstraint(A, np.zeros(m), np.zeros(m))
                integrality = np.concatenate([np.ones(n, dtype=int), np.zeros(m, dtype=int)])
                res = milp(c=c, constraints=lc, integrality=integrality, bounds=bounds, options={'disp': False})
                if not res.success:
                    raise RuntimeError("MILP failed")
                w = np.round(res.x[:n]).astype(int)  # binary solution
