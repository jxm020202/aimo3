            def rank_mod2(matrix):
                # Gaussian elimination over GF2
                m = [row[:] for row in matrix]
                n_rows = len(m)
                n_cols = len(m[0])
                rank = 0
                col = 0
                while col < n_cols and rank < n_rows:
                    # find pivot
                    pivot = None
                    for r in range(rank, n_rows):
                        if m[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap
                    m[rank], m[pivot] = m[pivot], m[rank]
                    # eliminate
                    for r in range(n_rows):
                        if r != rank and m[r][col]:
                            # row r = row r xor pivot row
                            m[r] = [(a ^ b) for a,b in zip(m[r], m[rank])]
                    rank += 1
                    col += 1
                return rank
            
            def span_rank(n):
                ops = []
                for i in range(n):
                    for j in range(n):
                        vec = [0]*(n*n)
                        # row i
                        for c in range(n):
                            vec[i*n + c] = 1
                        # column j
                        for r in range(n):
                            vec[r*n + j] ^= 1  # toggle (if already set from row)
                        ops.append(vec)
                return rank_mod2(ops)
            
            for n in range(2,6):
                print(n, span_rank(n), n*n)
            
