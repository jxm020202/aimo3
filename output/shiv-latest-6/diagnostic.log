                # Perform elimination
                ncol = len(target)
                row = 0
                for col in range(ncol):
                    # find pivot
                    pivot = None
                    for r in range(row, len(mat)):
                        if mat[r][col]:
                            pivot = r
                            break
                    if pivot is None:
                        continue
