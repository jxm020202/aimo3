            import random, math, sympy as sp
            def test():
                # random triangle acute
                while True:
                    # random points on circle radius 1
                    angles = [random.random()*2*math.pi for _ in range(3)]
                    A = sp.Point(math.cos(angles[0]), math.sin(angles[0]))
                    B = sp.Point(math.cos(angles[1]), math.sin(angles[1]))
                    C = sp.Point(math.cos(angles[2]), math.sin(angles[2]))
                    # ensure acute: all angles < 90 deg
                    # compute side lengths squared
                    a2 = B.distance(C)**2
                    b2 = A.distance(C)**2
                    c2 = A.distance(B)**2
                    # using law of cos: angle at A acute if b2 + c2 > a2, etc.
                    if (b2 + c2 > a2) and (a2 + c2 > b2) and (a2 + b2 > c2):
                        break
                # orthocenter H = A+B+C (vectors)
                H = sp.Point(A.x + B.x + C.x, A.y + B.y + C.y)
                # circumcenter O_c = (0,0)
                # compute circumcenter of triangle H,B,C
                # using sympy Circle
                circ = sp.Circle(H, B, C)
                center = circ.center
                # compare to A/2
                halfA = sp.Point(A.x/2, A.y/2)
                return center.distance(halfA).evalf()
            print(test())
            
