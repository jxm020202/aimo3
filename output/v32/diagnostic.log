            import math, random, numpy as np
            
            def min_t_for_point(p, eps=1e-9):
                x1,y1,z1 = p
                # binary search t
                lo = 0.0
                # lower bound: need t >= max(0, -x1, -y1, -z1) because x2,y2,z2 must be >=0
                lo = max(lo, -x1, -y1, -z1)
                hi = 5.0  # enough large
                for _ in range(60):
                    mid = (lo+hi)/2
                    t = mid
                    # intervals
                    Lx = max(0.0, x1 - t)
                    Ux = x1 + t
                    Ly = max(0.0, y1 - t)
                    Uy = y1 + t
                    Lz = max(0.0, z1 - t)
                    Uz = z1 + t
                    # check feasibility: need Lx <= Ux etc.
                    if Lx > Ux or Ly > Uy or Lz > Uz:
                        feasible = False
                    else:
                        # compute f_max at (Lx, Ly), f_min at (Ux, Uy)
                        f_max = 6 - 3*Lx - 1.5*Ly
                        f_min = 6 - 3*Ux - 1.5*Uy
                        # need Lz <= f_max and Uz >= f_min
                        feasible = (Lz <= f_max + 1e-12) and (Uz >= f_min - 1e-12)
                    if feasible:
                        hi = mid
                    else:
                        lo = mid
                return hi
            
            def random_point_on_sphere():
                # generate random point uniformly on sphere
                u = random.random()
                v = random.random()
                theta = 2*math.pi*u
                phi = math.acos(2*v-1)
                x = math.sin(phi)*math.cos(theta)
                y = math.sin(phi)*math.sin(theta)
                z = math.cos(phi)
                return (x,y,z)
            
            # test random points
