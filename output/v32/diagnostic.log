            import math
            from sympy import crt
            
            def M_mod_d(d):
                # compute 3^{2025!} mod d
                # factor d into 3^a * m where m not divisible by 3
                a = 0
                while d % 3 == 0:
                    a += 1
                    d //= 3
                m = d
                # compute mod for each part
                if a > 0:
                    mod1 = 0  # mod 3^a
                    mod1_mod = 3**a
                else:
                    mod1 = None
                    mod1_mod = None
                if m > 1:
                    # compute 3^{2025!} mod m
                    # exponent modulo phi(m)
                    phi = sp.totient(m)
                    exp_mod = 2025*0  # placeholder
                    # compute exponent modulo phi using factorial property
                    # Since 2025! is multiple of phi (for m <= 2025?), but m may be up to 200, phi <= 200, definitely divides 2025!
                    # So exponent ≡ 0 mod phi
                    # So 3^{2025!} ≡ 1 mod m
                    mod2 = 1
                    mod2_mod = m
                else:
                    mod2 = None
                    mod2_mod = None
                # combine
                if mod1 is None:
                    return mod2 % mod2_mod
                if mod2 is None:
                    return mod1 % mod1_mod
                # use CRT
                res, lcm_mod = crt([mod1_mod, mod2_mod], [mod1, mod2])
                return int(res % lcm_mod)
            
            # test for some d
            for d in range(2,31):
                print(d, M_mod_d(d))
            
