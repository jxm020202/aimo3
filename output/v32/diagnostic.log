            def is_core_leaf_structure(n):
                d=math.gcd(866,n)
                if d==1:
                    return False
                mod=n+1
                indeg=[0]*n
                succ=[0]*n
                prelist=[[] for _ in range(n)]
                for a in range(1,n+1):
                    b=pow(a,866,mod)
                    succ[a-1]=b
                    indeg[b-1]+=1
                    prelist[b-1].append(a)
                # classify nodes
                core_nodes=[i+1 for i,c in enumerate(indeg) if c==d]
                leaf_nodes=[i+1 for i,c in enumerate(indeg) if c==0]
                # check that all nodes are either core or leaf
                if len(core_nodes)+len(leaf_nodes)!=n:
                    return False
                # For each core node, check that among its predecessors, exactly one is core and d-1 are leaf
                for y in core_nodes:
                    preds=prelist[y-1]
                    if len(preds)!=d:
                        return False
                    core_preds=sum(1 for p in preds if indeg[p-1]==d)
                    leaf_preds=sum(1 for p in preds if indeg[p-1]==0)
                    if core_preds!=1 or leaf_preds!=d-1:
                        return False
                # For each leaf node, its predecessor must be core (since indegree 0, but outdegree to core)
                # Actually leaf nodes have indegree 0, but they have a successor (outgoing edge) which must be core.
                for x in leaf_nodes:
                    y=succ[x-1]
                    # y must be core
                    if indeg[y-1]!=d:
                        return False
                return True
            
            def find_n_structure(start, limit):
                for n in range(start, limit+1):
                    if is_core_leaf_structure(n):
                        return n
                return None
            
            print(find_n_structure(866,2000))
            
