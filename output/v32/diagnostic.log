            # compute paths from adjacency
            selected_set = set(selected)
            # Build adjacency dict: from edge i to edge j if end_i == start_j
            adj = {}
            for i in selected:
                for j in selected:
                    if i!=j and edges[i]['end'] == edges[j]['start']:
                        adj[i] = j
            # Build paths
            visited = set()
            paths = []
            for i in selected:
                if i in visited: continue
                # find start of path (node with no incoming edge)
                # compute incoming
                incoming = None
                for k,v in adj.items():
                    if v == i:
                        incoming = k
                        break
                if incoming is not None:
                    continue  # not a start
                # follow forward
                path = []
                cur = i
                while True:
                    path.append(cur)
                    visited.add(cur)
                    if cur in adj:
                        cur = adj[cur]
                        if cur in visited:
                            break
                    else:
                        break
                paths.append(path)
            len(paths), [len(p) for p in paths]
            
