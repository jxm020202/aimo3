            import math, mpmath as mp
            def I_n_asymp(n):
                # using harmonic approximation up to 1/(2n) term
                # H_n ≈ ln n + gamma + 1/(2n) - 1/(12 n**2)
                gamma = mp.euler
                Hn = mp.log(n) + gamma + 1/(2*n) - 1/(12*n**2)
                H2n = mp.log(2*n) + gamma + 1/(4*n) - 1/(48*n**2)
                return H2n - 0.5*Hn
            for n in [10**6, 10**8, 10**10, 10**12]:
                val = I_n_asymp(n)
                ratio = val / mp.log10(n)
                print(n, ratio)
            
