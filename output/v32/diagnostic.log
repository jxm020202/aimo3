            from copy import deepcopy
            
            def allowed_third_colors_given_pair(a,b):
                # returns set of colors allowed for third edge given colors a,b on the other two edges
                colors = {0,1,2}
                if a == b:
                    # third must be different from a
                    return colors - {a}
                else:
                    # third must be either a or b
                    return {a,b}
            
            def propagate(domains, colors):
                # Perform unit propagation: while there exists edge with domain size 1 and not assigned, assign it and propagate.
                changed = True
                while changed:
                    changed = False
                    # find edges with domain size 1 and not assigned
                    for e in range(edges_count):
                        if colors[e] == -1 and len(domains[e]) == 1:
                            col = next(iter(domains[e]))
                            colors[e] = col
                            # propagate to faces containing e
                            for fi in edge_to_faces[e]:
                                e1,e2,e3 = faces[fi]
                                # identify other two edges
                                others = [e1,e2,e3]
                                others.remove(e)
                                e_a, e_b = others[0], others[1]
                                # If both other edges have assigned colors, check condition
                                if colors[e_a] != -1 and colors[e_b] != -1:
                                    # check condition
                                    cset = {colors[e], colors[e_a], colors[e_b]}
                                    if len(cset)==1 or len(cset)==3:
