            def vertices_quad(theta):
                c = math.cos(theta)
                s = math.sin(theta)
                # Solve linear equations for each pair
                # 1: x*c + y*s = 0.5
                # 2: -(x-1)*s + y*c = 0.5  => -x*s + s + y*c = 0.5 => -x*s + y*c = 0.5 - s
                # 3: -x*s + (y-1)*c = 0.5 => -x*s + y*c - c = 0.5 => -x*s + y*c = 0.5 + c
                # 4: (x-1)*c + (y-1)*s = -0.5 => x*c - c + y*s - s = -0.5 => x*c + y*s = c + s - 0.5
                # Solve 1&2:
                A = np.array([[c, s], [-s, c]])
                b12 = np.array([0.5, 0.5 - s])
                v12 = np.linalg.solve(A, b12)
                # Solve 2&3:
                b23 = np.array([0.5 - s, 0.5 + c])
                v23 = np.linalg.solve(A, b23)
                # Solve 3&4:
                b34 = np.array([0.5 + c, c + s - 0.5])
                v34 = np.linalg.solve(A, b34)
                # Solve 4&1:
                b41 = np.array([c + s - 0.5, 0.5])
                v41 = np.linalg.solve(A, b41)
                return np.array([v12, v23, v34, v41])
            
            for th in [0.1, 0.3, 0.6, 0.78]:
                verts = vertices_quad(th)
                print(th, verts)
            
