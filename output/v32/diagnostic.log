            import itertools, math, sys
            from functools import lru_cache
            
            def min_T_bruteforce(n):
                N = 2**n
                vertices = list(range(N))
                # adjacency: edges between vertices differing by exactly one bit
                adj = {v: [] for v in vertices}
                for v in vertices:
                    for i in range(n):
                        u = v ^ (1<<i)
                        adj[v].append((u, 1/(2**i)))  # cost weight
                best = math.inf
                best_path = None
                # backtracking
                visited = [False]*N
                path = [0]
                visited[0]=True
                def dfs(current, cost):
                    nonlocal best, best_path
                    if cost >= best:
                        return
                    if len(path)==N:
                        # reached full path
                        best = cost
                        best_path = path.copy()
                        return
                    for (nbr, w) in adj[current]:
                        if not visited[nbr]:
                            visited[nbr]=True
                            path.append(nbr)
                            dfs(nbr, cost + w)
                            path.pop()
                            visited[nbr]=False
                dfs(0,0.0)
                return best, best_path
            
            for n in range(1,5):
                best, path = min_T_bruteforce(n)
                # compute Gray code T
                T_gray = sum(2**(n-1-2*i) for i in range(n))
                print(n, best, T_gray, best < T_gray)
            
