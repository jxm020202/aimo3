            def max_induced_matching_bruteforce(N):
                # Precompute neighbor sets within distance <=2
                coords = [(i,j) for i in range(N) for j in range(N)]
                V = len(coords)
                neighbor = [set() for _ in range(V)]
                partners = [set() for _ in range(V)]
                for i, (x1,y1) in enumerate(coords):
                    for j, (x2,y2) in enumerate(coords):
                        if i==j: continue
                        if max(abs(x1-x2), abs(y1-y2)) <= 2:
                            neighbor[i].add(j)
                            partners[i].add(j)
                # recursion with memoization using frozenset of available vertices maybe too large.
                # Use simple backtracking with pruning.
                best = 0
                # order vertices maybe by degree
                # Use list of vertices sorted by degree ascending
                degrees = [len(partners[i]) for i in range(V)]
                # We'll use a heuristic: choose vertex with smallest number of partners among available.
                from functools import lru_cache
                
                # Represent available set as bitmask using Python int (225 bits). That's possible using Python's arbitrary integers.
                # Map vertex index to bit position.
                all_mask = (1 << V) - 1
                
                # Precompute bitmask for neighbor closed set (distance <=2) for each vertex
                neighbor_mask = []
                for i in range(V):
                    mask = 0
                    for j in neighbor[i]:
                        mask |= (1 << j)
                    mask |= (1 << i)  # include itself
                    neighbor_mask.append(mask)
                # Precompute partner list as list of ints
                partner_list = [list(partners[i]) for i in range(V)]
                
                @lru_cache(maxsize=None)
                def dfs(mask):
                    nonlocal best
                    # count of vertices left
                    remaining = mask.bit_count()
                    # upper bound
                    ub = remaining // 2
                    if ub <= best:
                        return 0  # cannot improve
                    if mask == 0:
                        return 0
                    # choose a vertex: pick least significant set bit
                    v = (mask & -mask).bit_length() - 1  # index of lowest set bit
                    # Option 1: skip v
                    best_skip = dfs(mask & ~(1 << v))
                    best_val = best_skip
                    # Option 2: try pairing v with each partner u in mask
                    for u in partner_list[v]:
                        if not (mask >> u) & 1:
                            continue
                        # ensure u != v
                        # new mask: remove neighbor_mask[v] union neighbor_mask[u]
                        new_mask = mask & ~ (neighbor_mask[v] | neighbor_mask[u])
                        val = 1 + dfs(new_mask)
                        if val > best_val:
                            best_val = val
                            # update global best for pruning
                            if best_val > best:
                                best = best_val
                    return best_val
                max_edges = dfs(all_mask)
                return max_edges
            
            # Test on small N=5 (25 squares) to see runtime
            print("Testing N=5")
            max_edges_5 = max_induced_matching_bruteforce(5)
            print("max edges", max_edges_5)
            
