            def has_solution(n):
                mod = n+1
                # compute g map
                g = {}
                for x in range(1, n+1):
                    y = (866*x) % n
                    if y == 0:
                        y = n
                    g[x] = y
                # compute cycles of g
                visited = set()
                cycles = []
                for x in range(1, n+1):
                    if x not in visited:
                        cur = x
                        cyc = []
                        while cur not in visited:
                            visited.add(cur)
                            cyc.append(cur)
                            cur = g[cur]
                        cycles.append(cyc)
                # compute exponentiation map on residues 1..n (mod n+1)
                def pow_mod(a):
                    return pow(a, 866, mod)
                # we need to assign distinct values to each element of cycles such that
                # for each x, f(g(x)) = pow_mod(f(x))
                # This is similar to constructing a functional graph isomorphism.
                # We'll attempt backtracking using recursion over cycles.
                # For each cycle, we need to choose a seed a such that the orbit under pow_mod has length equal to cycle length and stays within 1..n.
                # We'll precompute orbits of pow_mod for all possible a.
                orbits = {}
                for a in range(1, n+1):
                    # compute orbit until repeats
                    seq = []
                    seen = {}
                    cur = a
                    while cur not in seen:
                        seen[cur] = len(seq)
                        seq.append(cur)
                        cur = pow_mod(cur)
                    # find cycle start index
                    start = seen[cur]
                    cycle = seq[start:]  # periodic part
                    # note that we may have preperiodic tail; we need pure cycles (no tail) for seeds.
                    # For our purposes, we need a such that its orbit is purely cyclic (i.e., start == 0)
                    if start == 0:
                        # pure cycle length
                        orbits[a] = tuple(cycle)
                # Now attempt to assign cycles of g to orbits of same length, using distinct elements.
                # This is a matching problem.
                # Build list of cycles lengths
                cycle_lengths = [len(c) for c in cycles]
                # Build list of candidate orbits grouped by length
                from collections import defaultdict
                orbit_by_len = defaultdict(list)
                for a, cyc in orbits.items():
                    orbit_by_len[len(cyc)].append((a, cyc))
                # Simple greedy: for each g-cycle, pick an unused orbit of same length.
                used_vals = set()
                for L in sorted(cycle_lengths, reverse=True):
                    # find orbit of length L with all elements unused
                    found = False
                    for a, cyc in orbit_by_len[L]:
                        if all(v not in used_vals for v in cyc):
                            # assign
                            used_vals.update(cyc)
                            found = True
                            break
                    if not found:
                        return False
                # after assigning all cycles, check that used_vals size == n
                return len(used_vals) == n
            
            for n in range(866, 876):
                print(n, has_solution(n))
            
