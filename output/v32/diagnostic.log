                    [0, 1],    # y <= y_high
                    [2, 1],    # 2x + y <= 4
                    [-3, -1.5],# -(3x+1.5y) <= -L  => 3x+1.5y >= L
                    [3, 1.5]   # 3x+1.5y <= U
                ], dtype=float)
                b_ub = np.array([
                    -x_low,
                    x_high,
                    -y_low,
                    y_high,
                    4.0,
