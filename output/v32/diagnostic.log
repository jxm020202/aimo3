            def projection_area(theta, N=200000):
                # Monte Carlo: sample random point in unit cell, test if it lies in projection of Rθ
                # i.e., if there exists integer k such that point is in Rθ + k
                # Equivalent to: point - k in Rθ for some k, i.e., point shifted by integer to lie in Rθ.
                # Since point in [0,1), we can test if point shifted by -0 or -1 in each coordinate lies in Rθ.
                # Check four possibilities: (x,y), (x-1,y), (x,y-1), (x-1,y-1)
                xs = np.random.rand(N)
                ys = np.random.rand(N)
                c = math.cos(theta)
                s = math.sin(theta)
                def in_R(x,y):
                    xp = x*c + y*s
                    yp = -x*s + y*c
                    return (abs(xp) <= 0.5) and (abs(yp) <= 0.5)
                # vectorized check
                # compute for each shift
                in_any = np.zeros(N, dtype=bool)
                for dx in (0.0, -1.0):
                    for dy in (0.0, -1.0):
                        in_any |= in_R(xs+dx, ys+dy)
                return np.mean(in_any)
            
            # test for few angles
            for th in [0, math.pi/8, math.pi/4, math.pi/3, math.pi/2]:
                print(th, projection_area(th, N=200000))
            
