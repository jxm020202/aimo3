            def seq_from_start(k,n):
                left=k
                right=k
                used=set([k])
                seq=[k]
                # we will add numbers until all used
                while len(used)<n:
                    # decide to add left-1 or right+1 whichever not used
                    # we have two choices: add left-1 (if >0) or right+1 (if <=n)
                    # but we can choose either if both available
                    # For counting, we consider both possibilities
                    # Here just produce one deterministic: add left-1 if possible else right+1
                    if left>1 and (left-1) not in used:
                        left-=1
                        seq.append(left)
                        used.add(left)
                    elif right<n and (right+1) not in used:
                        right+=1
                        seq.append(right)
                        used.add(right)
                    else:
                        break
                return seq
            
