            def solve_with_set(max_sum):
                dp = [[-10**9]*(max_sum+1) for _ in range(2)]
                choice = [[None]*(max_sum+1) for _ in range(2)]
                dp[0][0] = 0
                for k in range(1, max_sum+1):
                    profit = 7 if k%2 else 5
                    parity = k%2
                    for s in range(max_sum, k-1, -1):
                        for p in (0,1):
                            if dp[p][s-k] >= 0:
                                newp = (p + parity) % 2
                                val = dp[p][s-k] + profit
                                if val > dp[newp][s]:
                                    dp[newp][s] = val
                                    choice[newp][s] = (p, s-k, k)
                # reconstruct
                s = max_sum
                p = 1
                sel = []
                while s > 0:
                    ch = choice[p][s]
                    if ch is None:
                        break
                    prevp, prevs, k = ch
                    sel.append(k)
                    s = prevs
                    p = prevp
                return dp, choice, sel
            
