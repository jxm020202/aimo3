            from fractions import Fraction
            
            def f_rational(p, q):
                # compute exact sum using period detection of parity sequence
                # compute s_n = (-1)^{floor(n * p/q)} for n=1..T where T is period
                # We'll compute until we see repetition of pair (n mod q, floor parity?) Actually we can just compute for n up to 2*q maybe.
                # For rational p/q, floor(n p/q) = (n p - r_n)/q where r_n = (n p) mod q.
                # Parity depends on integer part.
                # The sequence of floor values modulo 2 repeats with period 2q maybe.
                # We'll compute s_n for n up to period = 2*q (or maybe q) and detect minimal period.
                seq = []
                seen = {}
                period = None
                max_n = 2*q+5
                for n in range(1, max_n+1):
                    val = (n * p) // q  # floor
                    s = 1 if val % 2 == 0 else -1
                    seq.append(s)
                    # try to detect period: store tuple of (val%2, (n*p)%q) maybe.
                    key = ((n * p) % q, val % 2)  # not enough
                # Instead just assume period = q (maybe 2q)
                T = q  # test
                # compute sum_{n=1}^\infty s_n/2^n = (sum_{j=1}^T s_j/2^j) / (1 - 2^{-T}) if period T.
                # But need to verify periodicity of s_n with period T.
                # Let's compute s for first 2T and check if s_{n+T}=s_n for n=1..T.
                s = []
                for n in range(1, 2*q+1):
                    val = (n * p) // q
                    s.append(1 if val%2==0 else -1)
                # find smallest T>0 such that s[n+T]==s[n] for all n up to some length
                def find_period(seq):
                    L = len(seq)
                    for T in range(1, L//2+1):
                        ok=True
                        for i in range(L-T):
                            if seq[i]!=seq[i+T]:
                                ok=False
                                break
                        if ok:
                            return T
                    return None
                T = find_period(s)
                if T is None:
                    T = 2*q  # fallback
                # compute sum using period T
                # compute sum_{j=1}^T s_j / 2^j as Fraction
                num = Fraction(0,1)
                for j in range(1, T+1):
                    sj = 1 if ((j * p) // q) % 2 == 0 else -1
                    num += Fraction(sj, 2**j)
                # total sum = num / (1 - 2^{-T})
                total = num / (Fraction(1,1) - Fraction(1, 2**T))
                # f = 1 + total/2
                f_val = Fraction(1,1) + total/2
                return f_val
            
