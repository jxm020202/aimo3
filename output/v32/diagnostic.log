            import itertools, math, sys, time, numpy as np, scipy.optimize as opt, scipy.sparse as sp
            
            def max_D_ilp(n):
                # variables: x_e for each unordered edge (i<j) binary
                # z_uv for each unordered pair (i<j) binary (forced 3)
                # total variables = m + m = 2m where m = C(n,2)
                vertices = list(range(n))
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # mapping edge to index
                edge_index = {e:i for i,e in enumerate(edges)}
                # variable order: first x (size m), then z (size m)
                # constraints:
                # 1) For each pair (u,v) and each w != u,v:
                #    z_uv >= x_{uw} + x_{vw} - 1
                # 2) For each pair (u,v):
                #    z_uv <= 1 - x_{uv}
                # 3) x,z binary (integrality)
                # objective: maximize sum x - sum z  (i.e., c^T var)
                # We'll use milp (mixed integer linear programming) from scipy.optimize
                # Build sparse matrices for constraints A_ub x <= b_ub (or A_eq)
                rows = []
                cols = []
                data = []
                b_ub = []
                # constraint type: -z_uv + x_{uw} + x_{vw} <= 1   (since z >= x+ x -1 => -z + x + x <= 1)
                # We'll convert to <= form.
                for u in range(n):
                    for v in range(u+1,n):
                        idx_z = m + edge_index[(u,v)]
                        for w in range(n):
                            if w==u or w==v: continue
                            # edges (u,w) and (v,w)
                            # ensure ordering (min,max)
                            e1 = (u,w) if u<w else (w,u)
                            e2 = (v,w) if v<w else (w,v)
                            idx_x1 = edge_index[e1]
                            idx_x2 = edge_index[e2]
                            # -z + x1 + x2 <= 1
                            rows.append(len(b_ub))
                            cols.extend([idx_z, idx_x1, idx_x2])
                            data.extend([-1, 1, 1])
                            b_ub.append(1)
                # constraint type: z_uv + x_uv <= 1  (since z <= 1 - x => z + x <=1)
                for u in range(n):
                    for v in range(u+1,n):
                        idx_z = m + edge_index[(u,v)]
                        idx_x = edge_index[(u,v)]
                        rows.append(len(b_ub))
                        cols.extend([idx_z, idx_x])
                        data.extend([1, 1])
                        b_ub.append(1)
                A_ub = sp.csr_matrix((data, (rows, cols)), shape=(len(b_ub), 2*m))
                c = np.concatenate([np.ones(m), -np.ones(m)])  # maximize sum x - sum z => maximize c^T var
                # milp expects minimization, so minimize -c^T var
                res = opt.milp(c=-c, A_ub=A_ub, b_ub=b_ub, integrality=np.ones(2*m), bounds=opt.Bounds(0,1))
                if not res.success:
                    print("ILP failed", res.message)
                    return None
                x = res.x[:m]
                D = sum(x) - sum(res.x[m:])
                return D
            
            for n in range(4,9):
                D = max_D_ilp(n)
                print(n, D, "floor(n/2)=", n//2)
            
