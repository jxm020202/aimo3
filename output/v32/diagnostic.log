                    for p,exp in sp.factorint(n).items():
                        # check if any of a..a+100 ≡ 0 mod p
                        # compute a_mod = a % p
                        a_mod = a % p
                        # The set of residues a_mod + k (mod p) for k=0..100
                        # If 0 in that set then fail.
                        # Equivalent to there exists k such that (a_mod + k) % p == 0 => k ≡ -a_mod mod p
                        # So condition fails iff -a_mod mod p is in [0,100] as integer.
                        # Since k range is 0..100, we just need to check if (-a_mod) % p <= 100.
                        k_needed = (-a_mod) % p
                        if k_needed <= 100:
                            good=False
                            break
                    if good:
                        return True, a
                return False, None
            
