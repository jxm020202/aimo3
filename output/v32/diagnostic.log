            def can_represent(n, L, max_exp=10):
                # BFS generate sums using up to L terms (allow repeats)
                from functools import lru_cache
                powers = [2**e for e in range(max_exp+1)]
                signs = [1, -1]
                # Use recursion with memoization
                @lru_cache(None)
                def dfs(k, remaining):
                    # k terms used so far, remaining sum needed
                    if k == L:
                        return remaining == 0
                    # try adding any signed power
                    for p in powers:
                        for s in signs:
                            if dfs(k+1, remaining - s*p):
                                return True
                    return False
                return dfs(0, n)
            
            def minimal_not_rep(L, max_n=100):
                for n in range(1, max_n+1):
                    if not can_represent(n, L):
                        return n
                return None
            
            for L in range(1,5):
                print(L, minimal_not_rep(L, max_n=200))
            
