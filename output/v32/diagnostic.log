            def overlap_center_torus(theta, N=2000):
                # approximate area of overlap between rotated unit square centered at origin and torus square [0,1]^2
                xs = np.linspace(-0.5,0.5,N)
                ys = np.linspace(-0.5,0.5,N)
                # rotated square region: points (x,y) such that after rotation -theta they lie within [-0.5,0.5]^2
                # Equivalent to check if point (x,y) is inside rotated square: rotate by theta and test bounds
                cos = math.cos(theta)
                sin = math.sin(theta)
                count=0
                for x in xs:
                    for y in ys:
                        # rotate point by -theta (or rotate coordinate system)
                        xr = cos*x + sin*y
                        yr = -sin*x + cos*y
                        if abs(xr) <= 0.5 and abs(yr) <= 0.5:
                            # point is inside rotated square
                            # also need point to be inside torus square [0,1]^2
                            if 0 <= x+0.5 <= 1 and 0 <= y+0.5 <= 1: # but x,y already in [-0.5,0.5], so x+0.5 in [0,1]
                                # Actually torus square is [0,1]x[0,1]; our sampling region is already within that after shift
                                # Since we sample x,y in [-0.5,0.5], the corresponding torus coordinates are (x+0.5, y+0.5) ∈ [0,1].
                                count+=1
                area = count/(N*N) # proportion of unit square area (since sampling area = 1*1)
                return area
            
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/4]:
                print(th, overlap_center_torus(th, N=400))
            
