            import random, numpy as np, itertools, math, time
            
            def random_matrix():
                n=12
                A=np.zeros((n,n), dtype=int)
                for i in range(n):
                    ones = random.sample(range(n), 6)
                    for j in ones:
                        A[i,j]=1
                return A
            
            def is_bipartite_form(A):
                # Determine if there exists subset S such that A matches bipartite pattern
                n=12
                # Find rows with pattern: each row must have either ones in same columns (size 6)
                # Actually bipartite pattern: rows can be partitioned into two groups where rows in same group have identical pattern.
                # Let's check if there are exactly two distinct row patterns, each being complement of the other.
                rows = [tuple(A[i]) for i in range(n)]
                uniq = list(set(rows))
                if len(uniq)!=2:
                    return False
                # Check that each pattern has exactly six 1's
                if any(sum(p)!=6 for p in uniq):
                    return False
                # Check complement
                comp = tuple(1 - x for x in uniq[0])
                return comp == uniq[1]
            
            def test_random(trials=5000):
                for _ in range(trials):
                    A=random_matrix()
                    if check(A):
                        if not is_bipartite_form(A):
                            print("found non-bipartite solution")
                            return A
                print("no non-bipartite found")
                return None
            
            test_random(2000)
            
