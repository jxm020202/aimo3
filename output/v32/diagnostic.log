            import random, itertools, math
            def random_triangle_free_graph(n, p):
                # start with empty graph, add edges randomly while maintaining triangle-free
                edges=set()
                # simple algorithm: iterate over all pairs and add with probability p if doesn't create triangle
                for i in range(n):
                    for j in range(i+1,n):
                        if random.random()<p:
                            # check if adding edge (i,j) would create triangle with existing edges
                            # i.e., there exists k such that (i,k) and (j,k) already edges
                            triangle=False
                            for k in range(n):
                                if k!=i and k!=j:
                                    if ((i,k) in edges or (k,i) in edges) and ((j,k) in edges or (k,j) in edges):
                                        triangle=True
                                        break
                            if not triangle:
                                edges.add((i,j))
                return edges
            
            def compute_F(edges, n):
                # edges is set of 1-edges
                # compute forced edges: pairs of vertices having common neighbor in edges
                adj = {i:set() for i in range(n)}
                for u,v in edges:
                    adj[u].add(v)
                    adj[v].add(u)
                forced=set()
                for w in range(n):
                    neigh = list(adj[w])
                    for i in range(len(neigh)):
                        for j in range(i+1,len(neigh)):
                            a,b = neigh[i], neigh[j]
                            if a>b: a,b=b,a
                            forced.add((a,b))
                return forced
            
            def avg_sum(edges, n):
                total=n*(n-1)//2
                e1=len(edges)
                forced=compute_F(edges,n)
                F=len(forced)
                total_sum = 2*total - e1 + F
                return Fraction(total_sum,total)
            
            def test_random(n, trials=10):
                for t in range(trials):
                    edges = random_triangle_free_graph(n, 0.5)
                    avg=avg_sum(edges,n)
                    print(len(edges), avg, float(avg))
            test_random(9,5)
            
