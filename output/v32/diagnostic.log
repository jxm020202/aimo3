            def max_m_for_pair(r, max_check=10, eps=1e-9):
                # find largest m such that product equals 1 for all e up to m
                for m in range(1, max_check+1):
                    ok=True
                    for e in range(1,m+1):
                        prod = (r**e+1)*((1/r)**e+1)
                        if abs(prod-1)>1e-6:
