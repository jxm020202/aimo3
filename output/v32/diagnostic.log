            def F_minU(A, Delta):
                if A < abs(Delta):
                    return -1
                U = (A**2 + Delta**2)/8.0
                C = (1 - Delta**2)/9.0
                return A**2 * (9*U - Delta**2) / ((C + U)**3)
            
            def search_grid():
                best = -1
