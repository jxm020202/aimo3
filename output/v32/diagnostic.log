            def count_good_ks(n, perm):
                cnt=0
                for k in range(101):
                    seen=[False]*n
                    ok=True
                    for x in range(n):
                        y=(perm[x]+k*x)%n
                        if seen[y]:
                            ok=False
                            break
                        seen[y]=True
                    if ok:
                        cnt+=1
