            def multiply_factors(f1, f2):
                vars1, table1 = f1
                vars2, table2 = f2
                # union of vars preserving order: we can take vars1 + vars2 not in vars1
                vars_union = list(vars1)
                for v in vars2:
                    if v not in vars_union:
                        vars_union.append(v)
                vars_union = tuple(vars_union)
                # map var to position in each factor
                pos1 = {v:i for i,v in enumerate(vars1)}
                pos2 = {v:i for i,v in enumerate(vars2)}
                # build new table
                new_table = {}
                for assign1, w1 in table1.items():
                    if w1 == 0: continue
                    # create dict for quick lookup of values for vars1
                    # assign1 is tuple of colors for vars1
                    for assign2, w2 in table2.items():
                        if w2 == 0: continue
                        # check consistency on overlapping vars
                        consistent = True
                        for v in set(vars1).intersection(vars2):
