            import itertools, cmath, math
            
            def roots_of_unity(order):
                return [cmath.exp(2j*math.pi*k/order) for k in range(order)]
            
            def test_solution(rs, m):
                for j in range(1,m+1):
                    prod = 1
                    for r in rs:
                        prod *= (r**j + 1)
                    if abs(prod - 1) > 1e-6:
                        return False
                return True
            
            def find_max_m(n, max_order=6, max_m=6):
                # generate candidate values: 0 plus roots of unity up to max_order
                candidates = [0] + [root for order in range(2, max_order+1) for root in roots_of_unity(order) if abs(root+1)>1e-9] # exclude -1
                # remove duplicates approx
                # brute force combos with repetitions (order matters not)
                best = 0
                best_sol = None
                for rs in itertools.product(candidates, repeat=n):
                    if all(abs(r) < 1e-9 for r in rs):
                        continue
                    # compute max m up to max_m that holds
                    m=0
                    for j in range(1,max_m+1):
                        prod=1
                        for r in rs:
                            prod*= (r**j + 1)
                        if abs(prod-1) < 1e-6:
                            m=j
                        else:
                            break
                    if m>best:
                        best=m
                        best_sol=rs
                return best, best_sol
            
            print(find_max_m(2, max_order=6, max_m=6))
            
