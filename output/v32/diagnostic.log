            import itertools
            
            def min_T(m):
                n = 2**m
                vertices = list(range(n))
                start = 0
                # adjacency: edges where xor is power of two
                powers = [1<<k for k in range(m)]
                adj = {v: [v^p for p in powers] for v in vertices}
                best = None
                best_path = None
                # backtrack
                visited = [False]*n
                visited[start]=True
                path=[start]
                def dfs(curr, steps, total):
                    nonlocal best,best_path
                    if steps==n-1:
                        # visited all vertices
                        if best is None or total<best:
                            best=total
                            best_path=path.copy()
                        return
                    for nb in adj[curr]:
                        if not visited[nb]:
                            visited[nb]=True
                            path.append(nb)
                            length = abs(nb-curr) # which is power of two
                            dfs(nb, steps+1, total+1/length)
                            path.pop()
                            visited[nb]=False
                dfs(start,0,0)
                return best,best_path
            
            for m in range(1,5):
                best,_ = min_T(m)
                print(m,best)
            
