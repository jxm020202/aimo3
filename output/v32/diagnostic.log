            def divisors(n):
                divs = []
                for i in range(1, int(math.isqrt(n))+1):
                    if n % i == 0:
                        divs.append(i)
                        if i != n//i:
                            divs.append(n//i)
                return sorted(divs)
            
            def has_solution_factorization(s, max_k=5):
                M = s//2 if s%2==0 else s
                g = math.gcd(M, 3)
                Mp = M // g  # need product divisible by Mp
                # try product = k * Mp for small k
                for k in range(1, max_k+1):
                    target = k * Mp
                    # iterate over d1,d2
                    for d1 in divisors(target):
                        if d1 < 2:
                            continue
                        for d2 in divisors(target // d1):
                            if d2 < 2:
                                continue
                            if target % (d1*d2) != 0:
                                continue
                            d3 = target // (d1*d2)
                            if d3 < 2:
                                continue
                            # compute a,b,c
                            a_num = d1 + d3 - d2
                            b_num = d1 + d2 - d3
                            c_num = d2 + d3 - d1
                            if a_num % 2 != 0 or b_num % 2 != 0 or c_num % 2 != 0:
                                continue
                            a = a_num // 2
                            b = b_num // 2
                            c = c_num // 2
                            if a <=0 or b <=0 or c <=0:
                                continue
                            d = s - a - b - c
                            if d <=0:
                                continue
                            # verify original condition
                            if (a*b*c + a*b*d + a*c*d + b*c*d) % s == 0:
                                return True, (a,b,c,d)
                return False, None
            
            for s in [3458, 3459, 3461, 3463, 3465, 3467, 3469, 3470]:
                ok, tup = has_solution_factorization(s, max_k=10)
                print(s, ok, tup)
            
