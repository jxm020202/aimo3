            def f_of_x(x, N=60):
                total = 0.0
                for n in range(1, N+1):
                    if math.floor(n*x) % 2 == 0:
                        total += 1.0 / (2**n)
                # tail bound: max remaining sum = sum_{n>N} 1/2^n = 1/2**N
                # Actually sum_{n=N+1}^\infty 1/2^n = 1/2**N
                # So error <= 1/2**N
