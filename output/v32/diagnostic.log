            def construct_path(n):
                # returns list of vertices (0..2^n-1) path starting at 0
                if n == 1:
                    return [0,1]
                # get path for n-1
                lower = construct_path(n-1)  # list of length 2^{n-1}
                # Build path for n using scheme described:
                path = []
                # start with first vertex lower[0] with MSB 0
                # We'll follow pattern: for i from 0 to len(lower)-2:
                #   v = lower[i]; w = lower[i+1]
                #   append v with MSB 0
                #   append v with MSB 1
                #   append w with MSB 1
                #   # next iteration will append w with MSB 0
                # After loop, need to append last vertex with MSB 0
                for i in range(len(lower)-1):
                    v = lower[i]
                    w = lower[i+1]
                    # v with MSB 0
                    path.append(v)  # MSB 0 implicit
                    # v with MSB 1
                    path.append(v + (1 << (n-1)))
                    # w with MSB 1
                    path.append(w + (1 << (n-1)))
                    # w with MSB 0 will be added in next iteration as v
                # after loop, add last vertex with MSB 0
                path.append(lower[-1])
                return path
            
            # test for n=4
            p4 = construct_path(4)
            print(p4[:20])
            print(len(p4))
            print(compute_T(p4))
            
