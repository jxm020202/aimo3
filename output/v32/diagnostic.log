                reachable = {0}
                for _ in range(w):
                    new_set = set()
                    for x in reachable:
                        for t in term_vals:
                            y = x + t
                            if -max_val <= y <= max_val:
                                new_set.add(y)
                    reachable = reachable.union(new_set)
                return reachable
            
