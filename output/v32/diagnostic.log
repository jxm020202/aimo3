                    involved = [ (vars, arr) for (vars, arr) in factors if v in vars ]
                    # remove them from factors list
                    factors = [ (vars, arr) for (vars, arr) in factors if v not in vars ]
                    if not involved:
                        # variable isolated (should not happen)
                        continue
                    # compute combined factor over union of vars
                    # Determine union set
                    all_vars = set()
                    for vars, _ in involved:
                        all_vars.update(vars)
                    all_vars = list(all_vars)
                    # Determine ordering: keep v first maybe
                    # We'll put v first, then others
                    # Ensure v is first for summation later
                    others = [x for x in all_vars if x != v]
                    combined_vars = [v] + others
                    # Prepare an array of shape (d,)*len(combined_vars) initialized to 1
                    shape = [d]*len(combined_vars)
                    combined = np.ones(shape, dtype=int)
                    # Multiply each factor
                    for vars_f, arr_f in involved:
                        # Determine axes order to align arr_f with combined
                        # vars_f is list of variables (size 2)
                        # Need to broadcast arr_f into combined shape
                        # We'll create a view with axes corresponding to combined_vars order
                        # Build index mapping
                        # Create slices for broadcasting
                        # We'll use np.einsum maybe? Simpler: expand arr_f to combined shape using reshape and transpose.
                        # Determine positions of vars_f in combined_vars
                        axes = [combined_vars.index(var) for var in vars_f]
                        # Move axes of arr_f to match combined order
                        # arr_f shape is (d,d) corresponding to vars_f order as stored originally (maybe [u,v] order)
                        # We need to permute axes accordingly.
                        # We'll first reshape arr_f to shape with length len(combined_vars) where dimensions not in vars_f are 1.
                        # Then use np.broadcast_to.
                        # Build shape for arr_f expanded
                        exp_shape = [1]*len(combined_vars)
                        for idx, ax in enumerate(axes):
                            exp_shape[ax] = d
                        arr_exp = arr_f.reshape(exp_shape)
                        # Multiply elementwise
                        combined = (combined * arr_exp) % 1000  # keep mod 1000 to avoid overflow
                    # Now sum over v (first axis)
                    # Sum over axis 0
                    combined_sum = combined.sum(axis=0) % 1000
                    # The resulting factor is over 'others' variables
                    if others:
                        factors.append( (others, combined_sum) )
                    else:
                        # No remaining vars, this is a scalar factor
                        total_scalar = combined_sum  # scalar
                # After eliminating all variables, we should have a single scalar factor (maybe multiple scalars multiplied)
                # Multiply remaining scalar factors
                result = 1
                for vars_f, arr_f in factors:
                    # vars_f should be empty
                    if vars_f:
                        raise ValueError("Remaining factor with vars")
                    result = (result * int(arr_f)) % 1000
                # If we stored total_scalar earlier
                if 'total_scalar' in locals():
                    result = (result * int(total_scalar)) % 1000
                return result
            
