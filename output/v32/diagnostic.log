            def max_E_for_c(eps):
                # c = eps
                # maximize over a,b>0, a+b = 3-eps
                S = 3 - eps
                # Use derivative as before: maximize f(a) = (a^3 + (S-a)^3) * S * a * (S-a)
                a = sp.symbols('a', real=True)
                b = S - a
                expr = (a**3 + b**3) * S * a * b
                d = sp.diff(expr, a)
                crit = sp.solve(sp.Eq(d,0), a)
                # evaluate numeric
                max_val = -1
                for val in crit:
                    if val.is_real:
                        val_f = float(val)
                        if 0 < val_f < S:
                            val_expr = float(expr.subs(a,val))
                            if val_expr > max_val:
                                max_val = val_expr
                # also endpoints (a->0 or a->S) give zero
                return max_val
            
