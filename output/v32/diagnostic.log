            def min_T_milp(d):
                N = 1<<d
                total_vertices = N + 1  # include dummy at index N
                dummy = N
                # generate list of arcs (i,j) where i!=j and allowed edge (i xor j) is power of 2, or dummy connections
                arcs = []
                costs = []
                # edges between real vertices
                for i in range(N):
                    for k in range(d):
                        j = i ^ (1<<k)
                        if i < j:  # add both directions later
                            # add both directions
                            arcs.append((i,j))
                            costs.append(1/(1<<k))
                            arcs.append((j,i))
                            costs.append(1/(1<<k))
                # dummy edges
                for v in range(N):
                    # dummy -> v
                    arcs.append((dummy, v))
                    costs.append(0.0)
                    # v -> dummy
                    arcs.append((v, dummy))
                    costs.append(0.0)
                m = len(arcs)
                # binary variables x for each arc
                c = np.array(costs)
                # constraints
                # indegree and outdegree constraints
                # For each vertex v != dummy:
                # outdeg = 1, indeg = 1
                # For dummy: outdeg = 1 (to 0), indeg = 1 (from end)
                A_eq = []
                b_eq = []
                # outdegree
                for v in range(total_vertices):
                    row = np.zeros(m)
                    for idx, (i,j) in enumerate(arcs):
                        if i == v:
                            row[idx] = 1
                    if v == dummy:
                        # outdegree must be 1 (to 0)
                        # We'll enforce later by fixing variable
                        # For now set equality 1
                        b = 1
                    else:
                        b = 1
                    A_eq.append(row)
                    b_eq.append(b)
                # indegree
                for v in range(total_vertices):
                    row = np.zeros(m)
                    for idx, (i,j) in enumerate(arcs):
                        if j == v:
                            row[idx] = 1
                    if v == dummy:
                        # indegree must be 1 (from end)
                        b = 1
                    elif v == 0:
                        # start vertex 0: indegree 0 (since start)
                        b = 0
                    else:
                        b = 1
                    A_eq.append(row)
                    b_eq.append(b)
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # MTZ order variables: u_i for each real vertex (1..N-1). dummy u_dummy = 0.
                # We'll create additional continuous variables u_i (not binary) with bounds [1,N].
                # We'll add constraints: u_i - u_j + total_vertices * x_{i,j} <= total_vertices - 1 for i!=dummy, j!=dummy
                # We'll need to add these as linear constraints.
                # We'll use LinearConstraint for each inequality.
                # Build matrix A_ub, lb, ub.
                # Variables order: first m binary x, then (N) continuous u (including dummy? we can include dummy but fix to 0)
                num_vars = m + total_vertices
                # bounds: x binary 0/1, u in [0, total_vertices] (or [0,N] for dummy)
                # We'll set bounds later.
                # Build inequality constraints list
                A_ub = []
                ub = []
                # For each arc (i,j) where i!=dummy and j!=dummy:
                for idx, (i,j) in enumerate(arcs):
                    if i != dummy and j != dummy:
                        row = np.zeros(num_vars)
                        # u_i coefficient 1, u_j coefficient -1, x_{i,j} coefficient total_vertices
                        row[m + i] = 1   # u_i
                        row[m + j] = -1  # u_j
                        row[idx] = total_vertices
                        A_ub.append(row)
                        ub.append(total_vertices - 1)
                # Also need to set u_dummy = 0 (fix)
                # We'll add equality constraint for dummy.
                row = np.zeros(num_vars)
                row[m + dummy] = 1
                A_eq = np.vstack([A_eq, row])
                b_eq = np.append(b_eq, 0)
                # Also for start vertex 0, we can set u_0 = 1 maybe to avoid symmetry.
                row = np.zeros(num_vars)
                row[m + 0] = 1
                A_eq = np.vstack([A_eq, row])
                b_eq = np.append(b_eq, 1)
                # For other vertices, u_i in [2, N] maybe? We'll set bounds.
                # Build bounds
                lower = np.zeros(num_vars)
                upper = np.full(num_vars, np.inf)
                # x bounds 0-1
                # Already lower=0, upper=inf, but we will set integrality later.
                # u bounds: for real vertices (except dummy) set [2, N] maybe, but we can just set [0,N].
                for i in range(total_vertices):
                    lower[m + i] = 0
                    upper[m + i] = total_vertices
                # Set dummy u bound to 0
                lower[m + dummy] = 0
                upper[m + dummy] = 0
                # Set start u_0 = 1 already fixed via equality.
                # Now call milp
                integrality = np.concatenate([np.ones(m), np.zeros(total_vertices)])  # binary for x, continuous for u
                res = milp(c=c, constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                                             LinearConstraint(np.array(A_ub), -np.inf*np.ones(len(A_ub)), ub)],
                                 bounds=Bounds(lower, upper), integrality=integrality, options={'presolve': True})
                return res
            
