                V = [(-3,0), (-2,1), (-1,0), (-2,-1)]
                # edges: V0->V1, V1->V2, V2->V3, V3->V0
                for (x1,y1),(x2,y2) in [(V[0],V[1]), (V[1],V[2]), (V[2],V[3]), (V[3],V[0])]:
