            def max_e_k(n, target_k):
                N = 2**n
                lengths = [2**k for k in range(n)]
                @lru_cache(None)
                def dfs(pos, mask):
                    if mask == (1<<N)-1:
                        return (0, 0)  # (total jumps left, count of target length)
                    best = (-1, -1)
                    for l in lengths:
                        for sign in (-1, 1):
                            nxt = pos + sign*l
                            if 0 <= nxt < N and not (mask>>nxt)&1:
                                total, cnt = dfs(nxt, mask | (1<<nxt))
                                total += 1
                                if l == target_k:
                                    cnt += 1
                                if total > best[0] or (total == best[0] and cnt > best[1]):
                                    best = (total, cnt)
                    return best
                return dfs(0, 1<<0)
            
