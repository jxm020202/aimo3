            import sympy as sp
            
            x = sp.symbols('x', real=True)
            
            # define functions for right edges
            f1 = (2*x - 5)/(2*x - 1)   # edge y = x - 1, x in [1,2]
            f2 = (-2*x + 3)/(2*x - 1)  # edge y = -x + 3, x in [2,3]
            f3 = (2*x - 9)/(2*x - 1)   # edge y = x - 3, x in [2,3]
            f4 = (-2*x + 1)/(2*x - 1)  # edge y = -x + 1, x in [1,2]
            
            # compute derivative and critical points within intervals
            def critical_points(expr, interval):
                d = sp.diff(expr, x)
                crit = sp.solve(sp.Eq(d, 0), x)
                # filter real within interval
                crit_in = [c for c in crit if c.is_real and c >= interval[0] and c <= interval[1]]
                return crit_in
            
            intervals = [(1,2), (2,3), (2,3), (1,2)]
            exprs = [f1, f2, f3, f4]
            for expr, inter in zip(exprs, intervals):
                crit = critical_points(expr, inter)
                print(expr, "critical:", crit)
            
