            def feasible(S):
                for m in range(1,n+1):
                    k=n-m
                    # C1
                    if k>0:
                        if k*(k+1)//2 > S:
                            continue
                    # else k=0 automatically ok
                    # X = T - 2S
                    X = T - 2*S
                    if X < 1:
                        # a_{k+1} must be positive integer, but X could be <=0; but we can choose larger X.
                        # Actually we can choose X >= max(1, T-2S). Since we want minimal total sum, we set X = max(1, T-2S)
                        X = max(1, T-2*S)
                    # compute minimal total sum
                    total_min = k*(k+1)//2 + m*X + m*(m-1)//2
                    if total_min <= T:
                        # also need X > a_k (if k>0). Since a_k = k (if we use minimal numbers). Actually a_k = k (since numbers are 1..k). So need X > k.
