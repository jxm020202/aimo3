            def count_solutions(n):
                maxc=2**(n-1)
                total=2**n-1
                count=0
                sols=[]
                # generate via recursion
                def rec(i, remaining, cur):
                    nonlocal count
                    if i==n-1:
                        c=remaining
                        if 1<=c<=maxc:
                            count+=1
                            sols.append(tuple(cur+[c]))
                        return
                    for c in range(1, maxc+1):
                        if c>remaining-(n-i-1)*1: # ensure enough left for rest minimal 1 each
                            break
                        if c<remaining-(n-i-1)*maxc:
                            continue
                        rec(i+1, remaining-c, cur+[c])
                rec(0,total,[])
                return count, sols
            
            cnt, sols = count_solutions(4)
            cnt
            
