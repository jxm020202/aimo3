            import time, sys
            
            edges_list = edges  # list of (u,v)
            n_edges = len(edges_list)
            
            # fix edge 0 color to 0 (R) to reduce factor 3
            fixed_edge0_color = 0
            
            # Initialize vertex counts
            vertex_counts = {v: [0,0,0] for v in G.nodes()}
            assigned = [None]*n_edges
            
            def backtrack(idx):
                # idx: index of edge to assign next (skip already assigned)
                if idx == n_edges:
                    # all assigned, check all vertices satisfied (should be)
                    return 1
                # skip already assigned edges (like edge 0)
                if assigned[idx] is not None:
                    return backtrack(idx+1)
                u,v = edges_list[idx]
                total = 0
                # try each color
                for col in range(3):
                    # update counts
                    cnt_u = vertex_counts[u]
                    cnt_v = vertex_counts[v]
                    cnt_u[col] += 1
                    cnt_v[col] += 1
                    # check feasibility for u and v
                    if vertex_feasible(cnt_u) and vertex_feasible(cnt_v):
                        assigned[idx] = col
                        total += backtrack(idx+1)
                        assigned[idx] = None
                    # revert
                    cnt_u[col] -= 1
                    cnt_v[col] -= 1
                return total
            
            # set edge 0 fixed
            e0_u, e0_v = edges_list[0]
            vertex_counts[e0_u][fixed_edge0_color] += 1
            vertex_counts[e0_v][fixed_edge0_color] += 1
            assigned[0] = fixed_edge0_color
            
            start = time.time()
            count_fixed = backtrack(0)
            elapsed = time.time() - start
            print("count_fixed:", count_fixed, "time:", elapsed)
            
