            def elimination_order_max_frontier(G):
                Gcopy = G.copy()
                order = []
                max_frontier = 0
                while Gcopy.nodes():
                    v = min(Gcopy.nodes(), key=lambda x: Gcopy.degree[x])
                    frontier = Gcopy.degree[v]
                    max_frontier = max(max_frontier, frontier)
                    order.append(v)
                    neigh = list(Gcopy.neighbors(v))
                    # make clique
                    for i in range(len(neigh)):
                        for j in range(i+1, len(neigh)):
                            Gcopy.add_edge(neigh[i], neigh[j])
                    Gcopy.remove_node(v)
                return order, max_frontier
            
