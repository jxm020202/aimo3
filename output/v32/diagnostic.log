                # p prime, d divisor of p-1
                # find primitive root g modulo p
                # compute subgroup generated by g^{(p-1)//d}
                # compute product (1+omega^{h}) for h in subgroup
                # return product
                # find primitive root
                for g in range(2, p):
                    # check if g is primitive
                    seen = set(pow(g, k, p) for k in range(1, p))
                    if len(seen) == p-1:
                        primitive = g
                        break
                else:
