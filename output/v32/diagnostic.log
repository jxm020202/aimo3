            def is_reflection_symmetric(p):
                n = len(p)
                # For each possible axis: through vertex i (odd n) => reflection maps i to itself, and maps i+k to i-k (mod n)
                for i in range(n):
                    symmetric = True
                    for k in range(1, n):
                        if p[(i+k)%n] != p[(i-k)%n]:
                            symmetric = False
                            break
                    if symmetric:
                        return True
                return False
            
            sym_count = 0
            for p in itertools.permutations(range(1,10)):
                if is_reflection_symmetric(p):
                    sym_count += 1
            sym_count
            
