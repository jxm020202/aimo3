            def last_nonzero_digit_factorial(n):
                # compute D(n) using recurrence
                if n==0:
                    return 1
                # recursion using while loop
                res=1
                while n>0:
                    # product of numbers 1..(n%5) ignoring zeros
                    r=n%5
                    # d(r) values
                    d=[1,1,2,6,4][r]
                    res = (res * d) % 10
                    # multiply by 2^{n//5}
                    exp = n//5
                    # 2^exp mod 10
                    # cycle length 4
                    pow2 = pow(2, exp, 10)
                    res = (res * pow2) % 10
                    n //=5
                return res
            
