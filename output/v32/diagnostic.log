            def count_colorings():
                n_edges = len(edges)
                colors = [-1]*n_edges
                # per vertex assigned colors list
                assigned = [[] for _ in range(20)]
                count = 0
                # order edges maybe by degree of vertices? all same.
                order = list(range(n_edges))
                # recursion
                def backtrack(pos):
                    nonlocal count
                    if pos == n_edges:
                        # all assigned, check all vertices condition (should already hold)
                        count += 1
                        return
                    e_idx = order[pos]
                    u,v = edges[e_idx]
                    for col in range(3):
                        # assign
                        colors[e_idx] = col
                        assigned[u].append(col)
                        assigned[v].append(col)
                        # check constraints for u and v if they have 3 assigned
                        ok = True
                        for vert in (u,v):
                            if len(assigned[vert]) == 3:
                                s = set(assigned[vert])
                                if len(s) != 2:
                                    ok = False
                                    break
                        if ok:
                            backtrack(pos+1)
                        # undo
                        assigned[u].pop()
                        assigned[v].pop()
                        colors[e_idx] = -1
                backtrack(0)
                return count
            
            start = time.time()
            cnt = count_colorings()
            print("count:", cnt, "time:", time.time()-start)
            
