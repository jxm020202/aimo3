                ks = list(range(min(max_k+1, n)))  # if n<=101, ks = 0..n-1 else 0..100
                # used[k][val] indicates if value val already used in column k
                used = [set() for _ in ks]
                g = [-1]*n
                # order of x to assign: maybe descending by something? We'll try natural order.
                def backtrack(x):
                    if x==n:
                        return True
                    # try each possible value for g(x) not used in column 0 (since column 0 is just g(x))
                    for val in range(n):
                        if val in used[0]:
                            continue
                        # check all ks
                        conflict=False
                        for idx,k in enumerate(ks):
                            v = (val + k*x) % n
                            if v in used[idx]:
                                conflict=True
                                break
                        if conflict:
                            continue
                        # assign
                        g[x]=val
                        for idx,k in enumerate(ks):
                            used[idx].add((val + k*x) % n)
                        if backtrack(x+1):
                            return True
                        # undo
                        for idx,k in enumerate(ks):
                            used[idx].remove((val + k*x) % n)
                        g[x]=-1
                    return False
                return backtrack(0)
            
            for n in range(2,31):
                ok = exists_g(n)
                print(n, ok)
            
