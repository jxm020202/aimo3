            def grid_counts(m, n):
                # m columns, n rows; total rectangles = m*n
                # vertices: (m+1)*(n+1)
                V = (m+1)*(n+1)
                # edges: vertical edges: (m+1)*n, horizontal edges: m*(n+1)
                E = (m+1)*n + m*(n+1)
                # degree-2 vertices: 4 corners
                n2 = 4
                # degree-3 vertices: boundary non-corner vertices
                # each side has (m-1) interior vertices on top/bottom, (n-1) interior vertices on left/right
                n3b = 2*(m-1) + 2*(n-1)
                # interior vertices degree-4:
                n4 = (m-1)*(n-1)
                # interior degree-3 vertices: 0
                n3i = 0
                n3 = n3b + n3i
                return V, E, n2, n3b, n3i, n4
            
