                # We'll implement a function to propagate constraints after assigning a state to a face.
                def propagate(domains, assigned_face, assigned_state):
                    # Use queue of faces whose domain reduced to a single state (i.e., assigned)
                    queue = collections.deque()
                    # assign the domain of assigned_face to {assigned_state}
                    if assigned_state not in domains[assigned_face]:
                        return False
                    domains[assigned_face] = {assigned_state}
                    queue.append(assigned_face)
                    while queue:
                        f = queue.popleft()
                        # Since domain size is 1, we have a fixed state
                        s = next(iter(domains[f]))
                        # colors of edges for this state
                        colors_f = face_state_colors[f][s]
                        # For each neighbor via shared edge
                        for (g, e, pos_f, pos_g) in face_neighbors[f]:
                            # The color that f assigns to edge e
                            col = colors_f[pos_f]
                            # Restrict domain of g to states where its color on pos_g equals col
                            allowed = set()
                            for sg in domains[g]:
                                if face_state_colors[g][sg][pos_g] == col:
                                    allowed.add(sg)
                            if not allowed:
                                return False
                            if allowed != domains[g]:
                                domains[g] = allowed
                                if len(allowed) == 1:
                                    queue.append(g)
                    return True
            
                # Choose next face to assign: smallest domain >1
                def backtrack(domains):
                    nonlocal count
                    # Check if all faces assigned
                    # If any domain empty -> dead end
                    # If all size 1 -> solution
                    # else choose face with smallest domain >1
                    # Also we can early count if all assigned
                    # find unassigned
                    min_sz = 100
                    chosen = -1
                    for i,dom in enumerate(domains):
                        sz = len(dom)
                        if sz == 0:
                            return
                        if sz > 1 and sz < min_sz:
                            min_sz = sz
                            chosen = i
                    if chosen == -1:
                        # all assigned
                        count = (count + 1) % MOD
                        return
                    # branch on each possible state
                    for s in list(domains[chosen]):  # copy
                        new_domains = [d.copy() for d in domains]
                        if propagate(new_domains, chosen, s):
                            backtrack(new_domains)
                backtrack(domains)
                return count
            
            print(count_colorings_faces())
            
