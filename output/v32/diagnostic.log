            def rotated_square_vertices(theta):
                # unit square centered at origin, side 1, axis-aligned before rotation
                # vertices before rotation: (±0.5, ±0.5)
                verts = [(-0.5, -0.5), (0.5, -0.5), (0.5, 0.5), (-0.5, 0.5)]
                c, s = math.cos(theta), math.sin(theta)
                rot = lambda x,y: (c*x - s*y, s*x + c*y)
                return [rot(x,y) for x,y in verts]
            
            def polygon_area(poly):
                # poly list of (x,y) in order (convex)
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2
            
            def intersect_polygons(poly1, poly2):
                # Sutherland–Hodgman polygon clipping: clip poly1 against each edge of poly2
                def inside(p, edge):
                    # edge defined by two points a->b, keep left side (assuming poly2 is CCW)
                    (ax, ay), (bx, by) = edge
                    (px, py) = p
                    return (bx-ax)*(py-ay) - (by-ay)*(px-ax) >= -1e-12  # left or on
            
                def intersection(p1, p2, edge):
                    (ax, ay), (bx, by) = edge
                    x1, y1 = p1
                    x2, y2 = p2
                    # line p1-p2 param t
                    # compute intersection of segment with line ax+ t*(bx-ax) etc? Actually we need intersection of segment with line of edge.
                    # Solve using line intersection formula
                    # Edge line: (ax, ay) + u*(bx-ax, by-ay)
                    # Segment line: (x1, y1) + t*(x2-x1, y2-y1)
                    # Solve for intersection point.
                    # Use determinant method.
                    dx1 = x2 - x1
                    dy1 = y2 - y1
                    dx2 = bx - ax
                    dy2 = by - ay
                    det = dx1 * dy2 - dy1 * dx2
                    if abs(det) < 1e-12:
                        return (x1, y1)  # parallel, return p1
                    # Solve for t where segment intersects edge line
                    t = ((ax - x1) * dy2 - (ay - y1) * dx2) / det
                    return (x1 + t * dx1, y1 + t * dy1)
            
                output = poly1[:]
                n2 = len(poly2)
                for i in range(n2):
                    edge = (poly2[i], poly2[(i+1)%n2])
                    input_list = output
                    output = []
                    if not input_list:
                        break
                    S = input_list[-1]
                    for E in input_list:
                        if inside(E, edge):
                            if not inside(S, edge):
                                output.append(intersection(S, E, edge))
                            output.append(E)
                        elif inside(S, edge):
                            output.append(intersection(S, E, edge))
                        S = E
                return output
            
            def overlap_area_exact(theta):
                poly1 = rotated_square_vertices(theta)
                poly2 = [(x+1, y) for x,y in rotated_square_vertices(theta)]
                inter = intersect_polygons(poly1, poly2)
                return polygon_area(inter)
            
            for th in [0.01, 0.05, 0.1, 0.2]:
                print(th, overlap_area_exact(th))
            
