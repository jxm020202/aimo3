            import random, itertools, math, time
            
            def condition_ok(adj):
                n=len(adj)
                for u in range(n):
                    found=False
                    for v in range(n):
                        if u==v: continue
                        if adj[u][v]:
                            # check common neighbor
                            common=False
                            for w in range(n):
                                if w==u or w==v: continue
                                if adj[u][w] and adj[v][w]:
                                    common=True
                                    break
                            if not common:
                                found=True
                                break
                    if not found:
                        return False
                return True
            
            def random_search(n, trials=100000):
                # start with complete bipartite floor/ceil
                a=n//2
                b=n-a
                # adjacency matrix
                adj=[[0]*n for _ in range(n)]
                for i in range(a):
                    for j in range(a,n):
                        adj[i][j]=adj[j][i]=1
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                # compute current edge count
                cur = sum(adj[i][j] for i in range(n) for j in range(i+1,n))
                best=cur
                best_adj=None
                for t in range(trials):
                    # randomly toggle an edge not present maybe
                    i,j = random.choice(edges)
                    # toggle
                    adj[i][j] ^= 1
                    adj[j][i] ^= 1
                    if condition_ok(adj):
                        cur = sum(adj[i][j] for i in range(n) for j in range(i+1,n))
                        if cur>best:
                            best=cur
                            best_adj=[row[:] for row in adj]
                    else:
                        # revert toggle
                        adj[i][j] ^= 1
                        adj[j][i] ^= 1
                return best
            
            for n in range(8,13):
                best = random_search(n, trials=20000)
