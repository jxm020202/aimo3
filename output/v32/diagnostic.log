            import itertools, math, numpy as np, sys, time, random, collections, math, itertools
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_min_sum_milp(m,n,target):
                N=m*n
                # map vertex index to (i,j)
                verts = [(i,j) for i in range(m) for j in range(n)]
                # edges list (undirected)
                edges = []
                for i,j in verts:
                    for di,dj in [(1,0),(0,1)]: # only right and down to avoid duplicates
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            edges.append(((i,j),(ni,nj)))
                # variable index mapping: (v_idx, k) -> var index
                var_index = {}
                idx = 0
                for v in range(N):
                    for k in range(1,N+1):
                        var_index[(v,k)] = idx
                        idx += 1
                num_vars = idx
                # objective: dummy (0)
                c = np.zeros(num_vars)
                # constraints:
                A = []
                lb = []
                ub = []
                # each vertex assigned exactly one number
                for v in range(N):
                    row = np.zeros(num_vars)
                    for k in range(1,N+1):
                        row[var_index[(v,k)]] = 1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # each number assigned to exactly one vertex
                for k in range(1,N+1):
                    row = np.zeros(num_vars)
                    for v in range(N):
                        row[var_index[(v,k)]] = 1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # edge constraints: for each edge (v,w), for each (k,l) with k+l < target, x_vk + x_wl <= 1
                for (i1,j1),(i2,j2) in edges:
                    v = i1*n + j1
                    w = i2*n + j2
                    for k in range(1,N+1):
                        max_l = target - 1 - k
                        if max_l < 1:
                            continue
                        for l in range(1, max_l+1):
                            # add constraint x_vk + x_wl <= 1
                            row = np.zeros(num_vars)
                            row[var_index[(v,k)]] = 1
                            row[var_index[(w,l)]] = 1
                            A.append(row)
                            lb.append(-np.inf)
                            ub.append(1)
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                bounds = Bounds(0,1)  # binary variables
                # integrality: all variables integer
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                return res.success
            
            # test for 4x4 target 16
            print("Testing 4x4 target 16")
            success = max_min_sum_milp(4,4,16)
            print("feasible:", success)
            
