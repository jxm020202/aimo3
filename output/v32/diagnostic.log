                        leaf_children_h.setdefault(parent, []).append(x)
                # similarly leaf children for e
                leaf_children_e={}
                for x in range(1,n+1):
                    if indeg_e[x-1]==0:
                        parent=e_map[x]
                        leaf_children_e.setdefault(parent, []).append(x)
                # Now assign leaf mapping
                for core in core_h:
                    leaf_h = leaf_children_h.get(core, [])
                    leaf_e = leaf_children_e.get(f[core], [])
                    if len(leaf_h)!=len(leaf_e):
                        raise ValueError("leaf count mismatch")
                    for lh, le in zip(leaf_h, leaf_e):
                        f[lh]=le
                # Ensure f is bijection
                if len(f)!=n:
                    raise ValueError("incomplete mapping")
                if set(f.values())!=set(range(1,n+1)):
