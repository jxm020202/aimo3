            import itertools
            
            def find_path(n):
                N = 2**n
                vertices = list(range(N))
                # edges: (i,j) if i xor j is power of 2 and <=2**(n-1)
                edges = {}
                for i in vertices:
                    edges[i] = []
                for i in vertices:
                    for k in range(n):
                        j = i ^ (1<<k)
                        if i < j:
                            edges[i].append((j,k))
                            edges[j].append((i,k))
                # brute force DFS with pruning for small n
                start = 0
                target_len = N-1
                visited = [False]*N
                path = [start]
                visited[start]=True
                best = None
                def dfs(v):
                    nonlocal best
                    if len(path)==N:
                        # found Hamiltonian path
                        # compute T
                        T = 0
                        for i in range(1,N):
                            diff = path[i]^path[i-1]
                            k = diff.bit_length()-1
                            T += 1/(2**k)
                        best = T
                        return True
                    for (nbr,k) in edges[v]:
                        if not visited[nbr]:
                            # optional prune: if T already > best
                            visited[nbr]=True
                            path.append(nbr)
                            if dfs(nbr):
                                return True
                            path.pop()
                            visited[nbr]=False
                    return False
                dfs(start)
                return best, path
            
            print(find_path(3)[0])
            
