            def estimate_p(N_total=2000000, batch=200000):
                count=0
                total=0
                for _ in range(N_total//batch):
                    # generate batch random values
                    theta = np.random.rand(batch) * (math.pi/2)  # uniform 0 to pi/2
                    x = np.random.rand(batch)
                    y = np.random.rand(batch)
                    cos = np.cos(theta)
                    sin = np.sin(theta)
                    # compute for each point whether any corner inside
                    # vectorized: compute distances for 4 corners
                    # shape (batch,4)
                    # compute u = (x - i)*cos + (y - j)*sin
                    # v = -(x - i)*sin + (y - j)*cos
                    # corners: (0,0),(1,0),(0,1),(1,1)
                    # We'll compute arrays
                    xs = np.stack([x, x-1, x, x-1])  # shape (4,batch)
                    ys = np.stack([y, y, y-1, y-1])
                    u = xs * cos + ys * sin
                    v = -xs * sin + ys * cos
                    inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)
                    any_inside = inside.any(axis=0)
                    count += np.sum(~any_inside)  # uncovered
                    total += batch
                return count/total
            
            print(estimate_p(2000000, 200000))
            
