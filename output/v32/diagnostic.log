            def conflict(d1, d2):
                # d1,d2 are tuples ((i,j,dir), start, end)
                _, s1, e1 = d1
                _, s2, e2 = d2
                # condition: either e1 == s2 or e2 == s1 or distance(e1,e2) >= 2
                if e1 == s2 or e2 == s1:
                    return False
                # compute Euclidean distance squared
                dx = e1[0]-e2[0]
                dy = e1[1]-e2[1]
                dist2 = dx*dx + dy*dy
                # distance < 2 => dist2 < 4
                if dist2 < 4 - 1e-9:  # tolerance
                    return True
                else:
                    return False
            
            # test conflict detection
            # Example: two diagonals sharing endpoint as start
            dA = diags[0]  # (0,0,0) NE from (0,0) to (1,1)
            # find a diagonal whose start is (1,1)
            candidates = [d for d in diags if d[1]==(1,1)]
            len(candidates)
            
