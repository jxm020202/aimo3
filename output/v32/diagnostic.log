            def has_solution(s):
                # iterate over p = a+b from 2 to s-2 (since each part at least 2)
                for p in range(2, s-1):
                    q = s - p
                    if q < 2:
                        continue
                    # compute possible products A for sum p
                    # a ranges 1..p-1
                    A_set = set()
                    for a in range(1, p):
                        b = p - a
                        A_set.add(a*b)
                    # compute possible products B for sum q
                    B_set = set()
                    for c in range(1, q):
                        d = q - c
                        B_set.add(c*d)
                    # check condition: exists A in A_set, B in B_set such that (A*q + B*p) % s == 0
                    # We can precompute modulo s.
                    for A in A_set:
                        Aq_mod = (A * q) % s
                        # need B such that (Aq_mod + B*p) % s == 0 => B*p % s == (-Aq_mod) mod s
                        target = (-Aq_mod) % s
                        # need B such that (B * p) % s == target
                        # iterate B_set
                        for B in B_set:
                            if (B * p) % s == target:
                                # found solution
                                return True
                return False
            
            # test for small s known odd solutions
            for s in [9,15,21,25,27,33]:
                print(s, has_solution(s))
            
