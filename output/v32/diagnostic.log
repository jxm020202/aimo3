                if not ac3(domains):
                    return 0
                count = 0
                def backtrack(domains):
                    nonlocal count
                    # check for empty domain
                    for d in domains:
                        if not d:
                            return
                    # check if all assigned
                    if all(len(d)==1 for d in domains):
                        count = (count + 1) % MOD
                        return
                    # choose variable with smallest domain >1
                    var = min((i for i,d in enumerate(domains) if len(d)>1), key=lambda i: len(domains[i])
                    # branch
                    for sv in list(domains[var]):
                        new_domains = [d.copy() for d in domains]
                        new_domains[var] = {sv}
                        if ac3(new_domains):
                            backtrack(new_domains)
                backtrack(domains)
                return count
            
            print(count_colorings())
            
