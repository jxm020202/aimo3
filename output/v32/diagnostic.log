            def max_matching_size(n):
                d1_range = list(range(-(n-1), n))
                d2_range = list(range(0, 2*n-1))
                d1_to_idx = {d:i for i,d in enumerate(d1_range)}
                d2_to_idx = {d:i for i,d in enumerate(d2_range)}
                G = nx.Graph()
                # add nodes with bipartite attribute
                for i in range(len(d1_range)):
                    G.add_node(('d1', i), bipartite=0)
                for j in range(len(d2_range)):
                    G.add_node(('d2', j), bipartite=1)
                # add edges for squares
                for r in range(n):
                    for c in range(n):
                        i = d1_to_idx[r-c]
                        j = d2_to_idx[r+c]
                        G.add_edge(('d1', i), ('d2', j))
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=[('d1', i) for i in range(len(d1_range))])
                # matching includes both sides; size is half number of matched vertices
                return len(matching)//2
            
            for n in range(1,14):
