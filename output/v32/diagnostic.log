            def min_weight(m):
                total = 2**m - 1
                max_edge = 2**(m-1)  # max edges per dimension
                # simple greedy: allocate as many as possible to largest k
                n = [0]*m
                remaining = total
                for k in reversed(range(m)):
                    # max we can allocate is min(max_edge, remaining)
                    # but also need parity constraints: for k>=1 even, for k=0 odd.
                    # We'll allocate as many as possible while respecting parity later.
                    # Use greedy: allocate as many as possible but ensure remaining can be satisfied with parity.
                    max_alloc = min(max_edge, remaining)
                    # adjust to meet parity: for k>=1 need even, for k=0 need odd.
                    if k>=1:
                        max_alloc = max_alloc - (max_alloc % 2)  # make even
                    else:
                        max_alloc = max_alloc - ((max_alloc+1) % 2)  # make odd
                    # ensure not negative
                    if max_alloc < 0:
                        max_alloc = 0
                    n[k] = max_alloc
                    remaining -= max_alloc
                # after loop, adjust if remaining not zero (should be zero)
                return n, remaining
            
            for m in range(1,7):
                n, rem = min_weight(m)
                print(m, n, rem, sum(n), sum(n[i]/2**i for i in range(m)))
            
