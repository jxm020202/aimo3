            def exists_g_backtrack(n, max_trials=1):
                # backtrack to find a permutation g satisfying condition
                # Use recursion with pruning.
                used = [set() for _ in range(101)]  # used values per k
                g = [-1]*n
                # order of x to assign: maybe 0..n-1
                xs = list(range(n))
                # simple heuristic: assign in order
                def backtrack(idx):
                    if idx==n:
                        return True
                    x = xs[idx]
                    # possible values for g(x) are those not used in column k=0 (i.e., not already assigned)
                    # but also must satisfy that for each k, (val + k*x) not already used in column k
                    for val in range(n):
                        if val in used[0]:
                            continue
                        ok=True
                        for k in range(101):
                            y = (val + k*x) % n
                            if y in used[k]:
                                ok=False
                                break
                        if not ok:
                            continue
                        # assign
                        g[x]=val
                        for k in range(101):
                            used[k].add((val + k*x) % n)
                        if backtrack(idx+1):
                            return True
                        # undo
                        for k in range(101):
                            used[k].remove((val + k*x) % n)
                        g[x]=-1
                    return False
                return backtrack(0)
            
            def find_smallest_composite(limit):
                for n in range(4, limit+1):
                    if sp.isprime(n):
                        continue
                    # quick filter: if n has prime factor <=101, skip? We'll try anyway but may be impossible.
                    if exists_g_backtrack(n):
                        return n
                return None
            
            print(find_smallest_composite(200))
            
