            def simulated_annealing(N=8, max_iter=200000, start_temp=10.0, end_temp=0.1):
                size = N*N
                # initial assignment: low to black, high to white
                black_mask = np.fromfunction(lambda i,j: ((i+j)%2==0), (N,N), dtype=bool)
                white_mask = ~black_mask
                low_numbers = np.arange(1, size//2+1)
                high_numbers = np.arange(size//2+1, size+1)
                np.random.shuffle(low_numbers)
                np.random.shuffle(high_numbers)
                grid = np.empty((N,N), dtype=int)
                grid[black_mask] = low_numbers
                grid[white_mask] = high_numbers
                
                def min_adj_sum(g):
                    right = g[:, :-1] + g[:, 1:]
                    down = g[:-1, :] + g[1:, :]
                    return min(right.min(), down.min())
                
                cur_min = min_adj_sum(grid)
                best_min = cur_min
                best_grid = grid.copy()
                
                for it in range(max_iter):
                    # temperature schedule
                    t = it / max_iter
                    temp = start_temp * (1 - t) + end_temp * t
                    # random swap
                    i1,j1 = random.randrange(N), random.randrange(N)
                    i2,j2 = random.randrange(N), random.randrange(N)
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    new_min = min_adj_sum(grid)
                    delta = new_min - cur_min
                    if delta > 0 or random.random() < math.exp(delta / temp):
                        cur_min = new_min
                        if new_min > best_min:
                            best_min = new_min
                            best_grid = grid.copy()
                    else:
                        # revert
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                return best_min, best_grid
            
            best_min, best_grid = simulated_annealing(N=8, max_iter=200000)
            print(best_min)
            
