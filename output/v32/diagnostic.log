        def max_S_grid(N):
    total = N*N
    # list of cells indices
    cells = [(i,j) for i in range(N) for j in range(N)]
    cell_index = {c:k for k,c in enumerate(cells)}
    # adjacency edges (undirected)
    edges = []
    for i in range(N):
        for j in range(N):
            if i+1<N:
                edges.append(((i,j),(i+1,j)))
            if j+1<N:
                edges.append(((i,j),(i,j+1)))
    # binary variables x_{c,n} where c in cells, n in 1..total
    # We'll flatten: variable index = c*total + (n-1)
    num_vars = total*total
    # constraints:
    constraints = []
    # each cell assigned exactly one number
    A_cell = np.zeros((total, num_vars), dtype=int)
    for ci,c in enumerate(cells):
        for n in range(1,total+1):
            var_idx = ci*total + (n-1)
            A_cell[ci, var_idx] = 1
    constraints.append(LinearConstraint(A_cell, np.ones(total), np.ones(total)))  # equality
    
    # each number used exactly once
    A_num = np.zeros((total, num_vars), dtype=int)
    for n in range(1,total+1):
        for ci in range(total):
            var_idx = ci*total + (n-1)
            A_num[n-1, var_idx] = 1
    constraints.append(LinearConstraint(A_num, np.ones(total), np.ones(total)))  # equality
    
    # edge constraints for a given S: we will add later as linear constraints for each edge and each forbidden pair
    # We'll create a function that builds constraints for a given S and solves feasibility.
    def feasible(S):
        # Build forbidden pair constraints
        # For each edge (c1,c2), for each (n,m) with n+m < S, add x_{c1,n}+x_{c2,m} <= 1
        rows = []
        lbs = []
        ubs = []
        for (c1,c2) in edges:
            ci1 = cell_index[c1]
            ci2 = cell_index[c2]
            for n in range(1,total+1):
                max_m = S-1 - n
                if max_m < 1:
                    continue
                # m from 1 to min(max_m,total)
                for m in range(1, min(max_m,total)+1):
                    # add constraint
                    row = np.zeros(num_vars, dtype=int)
                    row[ci1*total + (n-1)] = 1
                    row[ci2*total + (m-1)] = 1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(1)
        if rows:
            A_edge = np.vstack(rows)
            constraints_edge = LinearConstraint(A_edge, np.full(A_edge.shape[0], -np.inf), np.ones(A_edge.shape[0]))
            all_constraints = constraints + [constraints_edge]
        else:
            all_constraints = constraints
        # objective zero (feasibility)
        c = np.zeros(num_vars)
        # bounds 0-1 integer
        bounds = Bounds(0,1)
        integrality = np.ones(num_vars, dtype=int)
        res = milp(c=c, constraints=all_constraints, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
        return res.success
    # binary search S
    lo, hi = 2, 2*total  # max possible sum of two numbers
    best = 0
    while lo <= hi:
        mid = (lo+hi)//2
        print("Testing S", mid)
        if feasible(mid):
            best = mid
            lo = mid+1
        else:
            hi = mid-1
    return best

# test for N=4
print(max_S_grid(4))


