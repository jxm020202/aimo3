            import math
            
            def perm_cycle_type(perm):
                n = len(perm)
                visited = [False]*n
                cycles = []
                for i in range(n):
                    if not visited[i]:
                        length = 0
                        j = i
                        while not visited[j]:
                            visited[j] = True
                            j = perm[j]-1  # perm values are 1-indexed
                            length += 1
                        cycles.append(length)
                cycles.sort()
                return cycles
            
            def find_min_n(limit=5000):
                for n in range(866, limit+1):
                    if math.gcd(866, n) != 1:
                        continue
                    # compute T
                    T = []
                    for x in range(1, n+1):
                        y = (866 * x) % n
                        if y == 0:
                            y = n
                        T.append(y)
                    # compute phi
                    mod = n+1
                    phi = [pow(a, 866, mod) for a in range(1, n+1)]
                    # ensure phi values not zero
                    # they will be in 0..n, but 0 cannot happen because a < mod and mod is not dividing a
                    # but just in case:
                    phi = [v if v != 0 else mod for v in phi]
                    # compute cycle types
                    ct_T = perm_cycle_type(T)
                    ct_phi = perm_cycle_type(phi)
                    if ct_T == ct_phi:
                        return n, ct_T
                return None
            
            result = find_min_n(5000)
            result
            
