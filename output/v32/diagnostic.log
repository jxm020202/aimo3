            def exists_a_linear(n):
                # find a in [0,n-1] such that gcd(a+k, n)==1 for all k=0..100
                for a in range(n):
                    ok=True
                    for k in range(101):
                        if math.gcd(a+k, n)!=1:
                            ok=False
                            break
                    if ok:
                        return True, a
                return False, None
            
