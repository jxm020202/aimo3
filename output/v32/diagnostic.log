            import random, math, numpy as np
            
            def contains_lattice(theta, cx, cy):
                # square centered at (cx,cy) with side 1 rotated by theta
                # check if any integer point (i,j) lies inside
                # Since square size limited, only need to check points near center within distance ~1
                # We'll check integer points in range floor(cx-1) to ceil(cx+1)
                cos, sin = math.cos(theta), math.sin(theta)
                # transform integer points to square coordinates
                # For each integer point (i,j), compute (u,v) = R_{-theta} ( (i-cx, j-cy) )
                # Check if |u| <= 0.5 and |v| <= 0.5
                ix_min = math.floor(cx - 1)
                ix_max = math.ceil(cx + 1)
                iy_min = math.floor(cy - 1)
                iy_max = math.ceil(cy + 1)
                for i in range(ix_min, ix_max+1):
                    for j in range(iy_min, iy_max+1):
                        dx = i - cx
                        dy = j - cy
                        u = dx * cos + dy * sin
                        v = -dx * sin + dy * cos
                        if abs(u) <= 0.5 and abs(v) <= 0.5:
                            return True
                return False
            
            def estimate_p(samples=200000):
                count_no = 0
                for _ in range(samples):
                    theta = random.random() * 2*math.pi
                    cx = random.random()  # uniform in [0,1)
                    cy = random.random()
                    if not contains_lattice(theta, cx, cy):
                        count_no += 1
                return count_no / samples
            
            print(estimate_p(200000))
            
