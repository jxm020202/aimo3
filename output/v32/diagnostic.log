            def last_nonzero_digit_factorial(n):
                # compute D(n) using recurrence
                if n==0:
                    return 1
                # recursion
                # Use iterative approach
                res=1
                while n>0:
                    # D(n%5) values
                    d = [1,1,2,6,4][n%5]
                    res = (res * d) % 10
                    # multiply by 2^{n//5} mod 10
                    # 2^k mod 10 cycles with period 4: 2,4,8,6
                    k = n//5
                    # compute 2^k mod 10
                    # pow(2,k,10)
                    res = (res * pow(2, k, 10)) % 10
                    n //= 5
                return res
            
            # test small values
            for i in range(1,21):
                import math, itertools, sys, math
                # compute directly
                fact = math.factorial(i)
                # remove trailing zeros
                while fact%10==0:
                    fact//=10
                print(i, last_nonzero_digit_factorial(i), fact%10)
            
