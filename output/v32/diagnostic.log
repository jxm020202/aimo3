            def min_moves_path(N):
                init_mask = 0
                for i in range(N):
                    if i%2==0:
                        init_mask |= (1<<i)
                goal_mask = 0
                from collections import deque
                visited = {}
                q = deque()
                for i in range(N):
                    mask = init_mask ^ (1<<i)
                    state = (i, mask)
                    visited[state] = (1, None)  # moves, predecessor
                    if mask == goal_mask:
                        return 1, state
                    q.append(state)
                while q:
                    pos, mask = q.popleft()
                    moves,_ = visited[(pos,mask)]
                    if mask == goal_mask:
                        return moves, (pos,mask)
                    for np in (pos-1, pos+1):
                        if 0 <= np < N:
                            nmask = mask ^ (1<<np)
                            nstate = (np, nmask)
                            if nstate not in visited:
                                visited[nstate] = (moves+1, (pos,mask))
                                if nmask == goal_mask:
                                    return moves+1, nstate
                                q.append(nstate)
                return None, None
            
            moves, state = min_moves_path(5)
            print("moves", moves)
            
