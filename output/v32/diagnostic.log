            def max_min_adjacent_sum_grid(N=60, trials=20000):
                # N x N grid
                size = N*N
                # create initial assignment: low numbers to black cells, high numbers to white cells
                # black cells: (i+j)%2==0
                black_mask = np.fromfunction(lambda i,j: ((i+j)%2==0), (N,N), dtype=int)
                white_mask = ~black_mask
                # assign numbers
                numbers = np.arange(1, size+1)
                # sort low numbers for black, high for white
                low_numbers = numbers[:size//2]  # 1800
                high_numbers = numbers[size//2:]  # 1800
                # assign low numbers to black cells in random order
                np.random.shuffle(low_numbers)
                np.random.shuffle(high_numbers)
                grid = np.empty((N,N), dtype=int)
                grid[black_mask] = low_numbers
                grid[white_mask] = high_numbers
                
                # compute minimal adjacent sum
                def min_adj_sum(g):
                    # compute sums for right and down neighbors
                    right = g[:, :-1] + g[:, 1:]
                    down = g[:-1, :] + g[1:, :]
                    return min(right.min(), down.min())
                
                best_grid = grid.copy()
                best_min = min_adj_sum(grid)
                # simulated annealing
                start = time.time()
                for t in range(trials):
                    # pick two random cells (could be any)
                    i1, j1 = random.randrange(N), random.randrange(N)
                    i2, j2 = random.randrange(N), random.randrange(N)
                    # swap values
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    cur_min = min_adj_sum(grid)
                    if cur_min > best_min:
                        best_min = cur_min
                        best_grid = grid.copy()
                        # print progress
                        #print("iter", t, "new best", best_min)
                    # accept if not worse? we can revert if not improving to keep hill climbing
                    if cur_min < best_min:
                        # revert swap
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                return best_min, best_grid
            
            best_min, best_grid = max_min_adjacent_sum_grid(8, trials=50000)
            print(best_min)
            
