            from fractions import Fraction
            def f_rational(p,q, Nmax=2000):
                # compute exact rational sum using fractions up to Nmax terms (or until period repeats)
                # But we can compute infinite sum using periodic pattern.
                # Determine period: floor(n*p/q) parity repeats every q? Let's compute sequence of parity for n=1..q*2 maybe.
                seq = []
                for n in range(1, q*2+1):
                    seq.append(( (n*p)//q ) % 2)  # 0 if even, 1 if odd? Actually we want indicator of even (0 parity) -> 1 if even else 0.
                # Actually we need I_n = 1 if floor(np/q) even else 0.
                I = [( ((n*p)//q) % 2 == 0) for n in range(1, q*2+1)]
                # Find minimal period of I sequence.
                # Use simple search for period length up to q maybe.
                period = None
                for per in range(1, q*2+1):
                    if I[:per] == I[per:2*per]:
                        period = per
                        break
                if period is None:
                    period = q*2
                # compute sum over infinite series using period
                # sum_{k=0}^\infty sum_{i=1}^{period} I_i / 2^{i + k*period}
                # = sum_{i=1}^{period} I_i / 2^i * sum_{k=0}^\infty (1/2^{period})^k
                # = (1 / (1 - 2^{-period})) * sum_{i=1}^{period} I_i / 2^i
                num = sum( (1 if I[i] else 0) * Fraction(1, 2**(i+1)) for i in range(period) ) # careful indexing: i from 0
                # Actually i index 0 corresponds to n=1: weight 1/2^1 = 1/2
                # So weight = 1/2^{i+1}
                # Use Fraction for exact.
                num = sum( Fraction(1, 2**(i+1)) if I[i] else Fraction(0,1) for i in range(period) )
                factor = Fraction(1, 1 - Fraction(1, 2**period))
                return num * factor
            
            def min_f_rational(max_den=30):
                min_val = Fraction(1,1)
                min_frac = None
                for q in range(1, max_den+1):
                    for p in range(0, q):
                        # consider x in [0,1)
                        val = f_rational(p,q)
                        if val < min_val:
                            min_val = val
                            min_frac = Fraction(p,q)
                return min_val, min_frac
            
            min_val, min_frac = min_f_rational(30)
            min_val, min_frac, float(min_val)
            
