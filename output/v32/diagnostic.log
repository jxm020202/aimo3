                verts = [(cx + (math.cos(theta)*x - math.sin(theta)*y),
                          cy + (math.sin(theta)*x + math.cos(theta)*y)) for x,y in base]
                # bounding box
                minx = min(v[0] for v in verts)
                maxx = max(v[0] for v in verts)
                miny = min(v[1] for v in verts)
                maxy = max(v[1] for v in verts)
                count = 0
