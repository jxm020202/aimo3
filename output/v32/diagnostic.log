            # Find maximum size of set of lines that are pairwise disjoint (no common cell)
            # This is a maximum matching problem in hypergraph; we can brute-force using ILP again:
            # binary variable y_j for each line, maximize sum y_j subject to for each cell sum_{lines containing cell} y_j <= 1.
            num_lines = len(lines)
            A_line_cell = np.zeros((num_vars, num_lines), dtype=int)  # cell x line incidence
            for j,line in enumerate(lines):
                for cell in line:
                    A_line_cell[cell, j] = 1
            
            c_max = -np.ones(num_lines, dtype=int)  # maximize sum y => minimize -sum
            # constraints: for each cell, sum_{j} A_line_cell[cell,j] * y_j <= 1
            lin_con2 = LinearConstraint(A_line_cell, -np.inf, np.ones(num_vars))
            bounds2 = Bounds(0, 1)
            integrality2 = np.ones(num_lines, dtype=int)
            res2 = milp(c=c_max, constraints=lin_con2, bounds=bounds2, integrality=integrality2, options={"presolve": True, "disp": False})
            print(res2.success, -res2.fun)
            
