            A = np.zeros((num_vars, num_vars), dtype=int)
            b = np.zeros(num_vars, dtype=int)
            for v in range(num_vars):
                for u in neighbors[v]:
                    A[v,u] = 1
                A[v,v] = -1  # bring x_v to left side: sum_neighbors - x_v = 0
                b[v] = 0
            
            # Convert to LinearConstraint
