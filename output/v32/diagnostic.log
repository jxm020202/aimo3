        def collinear_points(n, spacing=0.01):
    # points along x-axis centered at 0
    pts=[((i-(n-1)/2)*spacing, 0.0) for i in range(n)]
    return pts

def improve_from_initial(pts, iterations=5000, step=0.01):
    n=len(pts)
    cur=total_sum_pts(pts)
    best=cur
    best_pts=pts[:]
    T0=1.0
    for it in range(iterations):
        T = T0 * (1 - it/iterations)
        i=random.randrange(n)
        x,y=pts[i]
        dx=(random.random()*2-1)*step
        dy=(random.random()*2-1)*step
        nx,ny=x+dx,y+dy
        # ensure within unit circle radius 1
        if nx*nx+ny*ny>1:
            continue
        old=pts[i]
        pts[i]=(nx,ny)
        new=total_sum_pts(pts)
        delta=new-cur
        if delta>0 or random.random()<math.exp(delta/T if T>0 else 0):
            cur=new
            if cur>best:
                best=cur
                best_pts=pts[:]
        else:
            pts[i]=old
    return best, best_pts

