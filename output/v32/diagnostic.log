            def min_f(L, final):
                # L odd length, indices 1..L, a1=1, aL=final, nondecreasing integers.
                n = L
                best = None
                best_seq = None
                # generate all nondecreasing sequences? Might be huge; limit small L.
                # We'll use recursion.
                def rec(idx, prev, seq):
                    nonlocal best, best_seq
                    if idx == n:
                        if prev != final:
                            return
                        # compute f
                        a = seq + [final]
                        f = sum(x*x for x in a) - sum(a[i]*a[i+2] for i in range(n-2))
                        if best is None or f < best:
                            best = f
                            best_seq = a
                        return
                    # remaining positions left = n-idx
                    # we need to ensure we can reach final with nondecreasing.
                    # minimal possible value for remaining positions is prev (stay same).
                    # maximal needed increments: we can increase at most final - prev.
                    # We'll loop over possible value for a_{idx+1} from prev to final.
                    for val in range(prev, final+1):
                        # simple pruning: ensure enough positions left to reach final
                        # If we set val now, we need to increase at most final - val over remaining positions
                        # That's always possible.
                        rec(idx+1, val, seq+[val])
                rec(1, 1, [1])  # idx counts already placed? Actually we start after a1.
                return best, best_seq
            
