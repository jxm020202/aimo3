            def naf_weight(x):
                # compute NAF weight using algorithm
                weight=0
                while x>0:
                    if x%2==1:
                        u = 2 - (x%4)
                        weight+=1
                        x = x - u
                    else:
                        u = 0
                    x //= 2
                return weight
            
            def min_missing_weight(n, limit=2000):
                # find smallest positive integer with NAF weight > n
                for m in range(1, limit+1):
                    if naf_weight(m) > n:
                        return m
                return None
            
            for n in range(1,8):
                print(n, min_missing_weight(n, limit=5000), "formula", (pow(2,2*n+1)+1)//3)
            
