            def gray_code(n):
                # binary reflected Gray code list of integers 0..2^n-1
                res = [0]
                for i in range(n):
                    res += [x | (1<<i) for x in reversed(res)]
                return res
            
            def reversed_bits(x, n):
                rev = 0
                for i in range(n):
                    if x>>i & 1:
                        rev |= 1 << (n-1-i)
                return rev
            
            n=11
            seq = [reversed_bits(g, n) for g in gray_code(n)]
            # verify it's a permutation of 0..2^n-1
            assert sorted(seq) == list(range(1<<n))
            # compute jumps lengths and T
            jumps = [abs(seq[i+1]-seq[i]) for i in range(len(seq)-1)]
            # check each jump is power of 2
            def is_power_of_two(x):
                return x and (x & (x-1)) == 0
            assert all(is_power_of_two(j) for j in jumps)
            T = sum(1/j for j in jumps)
            T
            
