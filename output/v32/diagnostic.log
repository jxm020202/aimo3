            start_time = time.time()
            
            # Initialize vertex counts
            vertex_counts = [(0,0,0) for _ in range(nV)]
            
            def recurse(i):
                global count
                if i == nE:
                    # all edges assigned, check all vertices satisfied (should be by feasibility)
                    count += 1
                    return
                e_idx = edge_order[i]
                u,v = edge_vertices[e_idx]
                # try each color 0,1,2
                for col in range(3):
                    # update counts
                    cu = list(vertex_counts[u])
                    cv = list(vertex_counts[v])
                    cu[col] += 1
                    cv[col] += 1
                    # quick reject if any count exceeds 2
                    if cu[col] > 2 or cv[col] > 2:
                        continue
                    # also if any vertex now has three distinct colors (i.e., each count>0) -> infeasible
                    # Actually feasible function will catch.
                    if not feasible(tuple(cu)):
                        continue
                    if not feasible(tuple(cv)):
                        continue
                    # assign
                    old_u = vertex_counts[u]
                    old_v = vertex_counts[v]
                    vertex_counts[u] = tuple(cu)
                    vertex_counts[v] = tuple(cv)
                    recurse(i+1)
                    # backtrack
                    vertex_counts[u] = old_u
                    vertex_counts[v] = old_v
            
            recurse(0)
            print("count:", count, "time:", time.time()-start_time)
            
