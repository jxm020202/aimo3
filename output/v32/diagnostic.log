            def max_E_pattern_bruteforce(p,q,r, samples=200000):
                best = -1
                for _ in range(samples):
                    # sample a,b in range maybe [-1,1]
                    a = random.uniform(-1,1)
                    b = random.uniform(-1,1)
                    # compute m from sum constraint
                    if q == 0:
