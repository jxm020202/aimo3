            import math
            
            def last_nonzero_digit_factorial(n):
                # compute last non-zero digit of n! in base 10
                # using algorithm described
                count2 = 0
                count5 = 0
                res = 1
                for i in range(2, n+1):
                    x = i
                    while x % 2 == 0:
                        x //= 2
                        count2 += 1
                    while x % 5 == 0:
                        x //= 5
                        count5 += 1
                    res = (res * x) % 10
                # now multiply by 2^(count2-count5) mod 10
                extra = count2 - count5
                # compute 2^extra mod 10
                # 2^phi(10)=2^4=16 ≡6 mod10? Actually 2^4=16 =>6 mod10
                # but we can compute directly
                res = (res * pow(2, extra, 10)) % 10
                return res
            
            # test small n
            for n in range(1, 21):
                print(n, last_nonzero_digit_factorial(n))
            
