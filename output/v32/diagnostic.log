        >>> Code:
            import random, math, itertools, time
            
            def count_good_ks(n, perm):
                cnt=0
                for k in range(101):
                    seen=[False]*n
                    ok=True
                    for x in range(n):
                        y=(perm[x]+k*x)%n
                        if seen[y]:
                            ok=False
                            break
                        seen[y]=True
                    if ok:
                        cnt+=1
                return cnt
            
            def search_n(n, max_iter=200000):
                # start with random perm
                perm=list(range(n))
                random.shuffle(perm)
                best=count_good_ks(n, perm)
                if best==101:
                    return perm
                for it in range(max_iter):
                    # propose swap two positions
                    i,j=random.sample(range(n),2)
                    perm[i],perm[j]=perm[j],perm[i]
                    cnt=count_good_ks(n, perm)
                    if cnt>best:
                        best=cnt
                        #print("n",n,"new best",best)
                        if best==101:
                            return perm
                    else:
                        # revert
                        perm[i],perm[j]=perm[j],perm[i]
                return None
            
            def try_find(n, attempts=20):
                for _ in range(attempts):
                    res=search_n(n, max_iter=50000)
                    if res is not None:
                        return res
