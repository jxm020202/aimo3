                        count5 += 1
                    res = (res * x) % 10
                # now multiply by 2^(count2-count5) mod 10
                extra = count2 - count5
                # compute 2^extra mod 10
                # 2^phi(10)=2^4=16 ≡6 mod10? Actually 2^4=16 =>6 mod10
                # but we can compute directly
                res = (res * pow(2, extra, 10)) % 10
