            def max_A_minus_C(n):
                max_val = 0
                max_A = None
                for A in range(0, (n*n)//4 + 1):
                    S1 = 2*A
                    avg = S1 / n
                    floor_deg = int(avg)
                    k = S1 - floor_deg * n  # remainder
                    # degrees: k vertices have floor_deg+1, rest floor_deg
                    S2_min = k * (floor_deg+1)**2 + (n - k) * floor_deg**2
                    val = ((n-1)*S1 - S2_min) / (2*(n-2))
                    if val > max_val:
                        max_val = val
                        max_A = A
                return max_val, max_A
            
            # test for small n
