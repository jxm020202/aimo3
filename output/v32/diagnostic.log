            def max_S_grid_bruteforce(N):
                # brute force all permutations for very small N (N<=3 maybe)
                import itertools, math
                total = N*N
                cells = [(i,j) for i in range(N) for j in range(N)]
                edges = []
                for i in range(N):
                    for j in range(N):
                        if i+1<N:
                            edges.append(((i,j),(i+1,j)))
                        if j+1<N:
                            edges.append(((i,j),(i,j+1)))
                best = 0
                for perm in itertools.permutations(range(1,total+1)):
                    # assign to cells in order
                    grid = {}
                    for idx,c in enumerate(cells):
                        grid[c]=perm[idx]
                    min_sum = min(grid[a]+grid[b] for (a,b) in edges)
                    if min_sum>best:
                        best=min_sum
                return best
            
            print("N=2", max_S_grid_bruteforce(2))
            
