            import random, math, itertools
            
            def contains_lattice_point(x, y, theta):
                # square vertices after rotation and translation
                # define square as set of points (x,y) + Rθ * (u,v) where u,v in [0,1]
                # we can test integer points within bounding box
                # compute bounding box
                cos = math.cos(theta)
                sin = math.sin(theta)
                # vertices
                verts = [(x + 0, y + 0),
                         (x + cos, y + sin),
                         (x - sin, y + cos),
                         (x + cos - sin, y + sin + cos)]
                xs = [v[0] for v in verts]
                ys = [v[1] for v in verts]
                minx, maxx = min(xs), max(xs)
                miny, maxy = min(ys), max(ys)
                # check integer points in bounding box
                for i in range(math.floor(minx)-1, math.ceil(maxx)+2):
                    for j in range(math.floor(miny)-1, math.ceil(maxy)+2):
                        # check if point (i,j) inside rotated square using barycentric coordinates
                        # Solve for (u,v) such that (i,j) = (x,y) + Rθ * (u,v)
                        # => Rθ^T * ((i,j)-(x,y)) = (u,v)
                        dx = i - x
                        dy = j - y
                        # apply inverse rotation (transpose)
                        u =  cos*dx + sin*dy
                        v = -sin*dx + cos*dy
                        if 0 <= u <= 1 and 0 <= v <= 1:
                            return True
                return False
            
            def trial(N=10000):
                count=0
                for _ in range(N):
                    theta = random.random()*math.pi/2 # due to symmetry
                    x = random.random()
                    y = random.random()
                    if not contains_lattice_point(x,y,theta):
                        count+=1
                return count/N
            
            print(trial(2000))
            
