            # Build incidence list for each vertex
            incidence = [[] for _ in range(n_vertices)]
            for e_idx, (i,j) in enumerate(edges):
                incidence[i].append(e_idx)
                incidence[j].append(e_idx)
            
            # Variables order: first x_i (0..n_vertices-1), then y_e (n_vertices..)
            num_vars = n_vertices + n_edges
            
            # Objective: maximize sum x_i
            c = np.zeros(num_vars, dtype=int)
            c[:n_vertices] = -1  # minimize negative to maximize
            
            # Constraints:
            # 1) For each vertex i: sum_{e incident} y_e - x_i = 0
            A_eq = []
            b_eq = []
            for i in range(n_vertices):
                row = np.zeros(num_vars, dtype=int)
                row[i] = -1
                for e_idx in incidence[i]:
                    row[n_vertices + e_idx] = 1
                A_eq.append(row)
                b_eq.append(0)
            
            A_eq = np.array(A_eq)
            b_eq = np.array(b_eq)
            
            # 2) For each edge e=(i,j): y_e - x_i <= 0  (i.e., y_e <= x_i)
            # 3) y_e - x_j <= 0
            # 4) -y_e + x_i + x_j <= 1  (i.e., x_i + x_j - 1 <= y_e)
            A_ub = []
            b_ub = []
            for e_idx, (i,j) in enumerate(edges):
                # y_e - x_i <= 0
                row = np.zeros(num_vars, dtype=int)
                row[n_vertices + e_idx] = 1
                row[i] = -1
                A_ub.append(row)
                b_ub.append(0)
                # y_e - x_j <= 0
                row = np.zeros(num_vars, dtype=int)
                row[n_vertices + e_idx] = 1
                row[j] = -1
                A_ub.append(row)
                b_ub.append(0)
                # -y_e + x_i + x_j <= 1
                row = np.zeros(num_vars, dtype=int)
                row[n_vertices + e_idx] = -1
                row[i] = 1
                row[j] = 1
                A_ub.append(row)
                b_ub.append(1)
            
            A_ub = np.array(A_ub)
            b_ub = np.array(b_ub)
            
            # Bounds: binary variables 0-1
            lb = np.zeros(num_vars)
            ub = np.ones(num_vars)
            
            bounds = Bounds(lb, ub)
            
            # Solve MILP
            res = milp(c=c, integrality=np.ones(num_vars), bounds=bounds,
