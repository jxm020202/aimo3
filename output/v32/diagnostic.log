                        assigned[v].append(col)
                        saved = []
                        consistent = True
                        for vert in (u,v):
                            if len(assigned[vert]) == 3:
                                if len(set(assigned[vert])) != 2:
                                    consistent = False
                                    break
                            elif len(assigned[vert]) == 2:
                                c1,c2 = assigned[vert][0], assigned[vert][1]
                                if c1 == c2:
                                    allowed_colors = {c for c in [0,1,2] if c != c1}
                                else:
                                    allowed_colors = {c1,c2}
                                for e2 in vertex_edges[vert]:
                                    if colors[e2]==-1:
                                        old = allowed[e2]
                                        new = old & allowed_colors
                                        if not new:
                                            consistent = False
                                            break
                                        if new != old:
                                            saved.append((e2, old))
                                            allowed[e2] = new
                                if not consistent:
                                    break
                        if consistent:
                            if backtrack():
                                return True
                        # restore
                        for e2, old in saved:
                            allowed[e2] = old
                        assigned[u].pop()
                        assigned[v].pop()
                        colors[e] = -1
                    return False
                success = backtrack()
                return found, steps
            
            sol, steps = find_solution_random(max_steps=2000000)
            print("found:", sol is not None, "steps:", steps)
            
