                # BFS
                visited = set()
                q = deque()
                # first move any coin
                for p in range(N):
                    config = list(init)
                    config[p] ^= 1
                    state = (p, tuple(config))
                    visited.add(state)
                    q.append((state, 1))
                while q:
                    (pos, config), d = q.popleft()
                    if config == goal:
                        return d
                    if d >= max_depth:
                        continue
                    for np in (pos-1, pos+1):
                        if 0 <= np < N:
                            newconfig = list(config)
                            newconfig[np] ^= 1
                            newstate = (np, tuple(newconfig))
                            if newstate not in visited:
