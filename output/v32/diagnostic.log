            from scipy.optimize import milp, LinearConstraint, Bounds
            
            c = -np.ones(N)  # maximize sum x_i
            # constraints: 2N rows
            A = np.zeros((2*N, N), dtype=int)
            lb = np.zeros(2*N)
            ub = np.zeros(2*N)
            
            # Row i: sum_{j in N(i)} x_j >= x_i  => -x_i + sum >= 0
            for i in range(N):
                A[i, i] = -1
                for j in neighbors[i]:
                    A[i, j] = 1
                lb[i] = 0
                ub[i] = np.inf  # no upper bound for this inequality (we'll treat as >=)
            # Row N+i: sum_{j in N(i)} x_j <= M - (M-1)*x_i
            for i in range(N):
                row = N + i
                A[row, i] = -(Mmax - 1)  # move RHS to LHS: sum - (M - (M-1)*x_i) <= 0 => sum - M + (M-1)*x_i <= 0
                for j in neighbors[i]:
                    A[row, j] = 1
                # LHS = sum + (M-1)*x_i - M <= 0
                lb[row] = -np.inf
                ub[row] = 0
            
            # variable bounds
            var_lb = np.zeros(N)
            var_ub = np.ones(N)
            
