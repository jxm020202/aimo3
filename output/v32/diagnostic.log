            import cmath, math, itertools
            
            def max_m_pair(r,s,limit=10):
                for m in range(1,limit+1):
                    ok=True
                    for e in range(1,m+1):
                        if abs((r**e+1)*(s**e+1) - 1) > 1e-9:
                            ok=False
                            break
                    if not ok:
                        return m-1
                return limit
            
            def search_pairs(max_order=12, limit=10):
                roots = []
                for n in range(1,max_order+1):
                    for k in range(n):
                        roots.append(cmath.exp(2j*math.pi*k/n))
                best=0
                best_pair=None
                for r,s in itertools.combinations(roots,2):
                    if abs(r) < 1e-9 or abs(s) < 1e-9: # ignore zero
                        continue
                    m = max_m_pair(r,s,limit)
                    if m>best:
                        best=m
                        best_pair=(r,s)
                return best,best_pair
            
