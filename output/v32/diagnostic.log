            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np
            
            num_edges = len(edges)
            c = -np.ones(num_edges)  # maximize sum x, so minimize -sum
            
            # variable bounds 0/1
            bounds = Bounds(0, 1)
            integrality = np.ones(num_edges, dtype=int)
            
            # constraints list
            A = []
            lb = []
            ub = []
            
            # indegree <=1 for each vertex
            for v in vertices:
                row = np.zeros(num_edges, dtype=int)
                for idx, (u,w) in enumerate(edges):
                    if w == v:
                        row[idx] = 1
                A.append(row)
                lb.append(-np.inf)
                ub.append(1)
            
            # orthogonal adjacency constraints
            # orthogonal neighbor pairs (Manhattan distance 1)
            orth_pairs = []
            for (i,j) in vertices:
                for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                    ni, nj = i+di, j+dj
                    if 0 <= ni < 17 and 0 <= nj < 17:
                        v2 = (ni,nj)
                        if (i,j) < v2:  # avoid duplicates
                            orth_pairs.append(((i,j), v2))
            
            for v,w in orth_pairs:
                row = np.zeros(num_edges, dtype=int)
                # sum incoming to v + sum incoming to w <= 1
                for idx, (u,head) in enumerate(edges):
                    if head == v or head == w:
                        row[idx] = 1
                A.append(row)
                lb.append(-np.inf)
                ub.append(1)
            
            # diagonal adjacency constraints
            diag_pairs = []
            for (i,j) in vertices:
                for di,dj in [(1,1),(1,-1),(-1,1),(-1,-1)]:
                    ni, nj = i+di, j+dj
                    if 0 <= ni < 17 and 0 <= nj < 17:
                        v2 = (ni,nj)
                        if (i,j) < v2:
                            diag_pairs.append(((i,j), v2))
            
            for v,w in diag_pairs:
                row = np.zeros(num_edges, dtype=int)
                # sum incoming to v + sum incoming to w <= 1 + x_{v->w} + x_{w->v}
                for idx, (u,head) in enumerate(edges):
                    if head == v or head == w:
                        row[idx] = 1
                # add coefficients for x_{v->w} and x_{w->v}
                # find indices
                idx_vw = None
                idx_wv = None
                for idx, (u,head) in enumerate(edges):
                    if u == v and head == w:
                        idx_vw = idx
                    if u == w and head == v:
                        idx_wv = idx
                # subtract 1 from RHS? Actually we want: sum_in_v + sum_in_w - x_vw - x_wv <= 1
                # Equivalent to sum_in_v + sum_in_w - x_vw - x_wv <= 1
                # So we set row[idx_vw] -= 1, row[idx_wv] -= 1, ub = 1
                if idx_vw is not None:
