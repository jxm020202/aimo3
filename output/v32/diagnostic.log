            import random, math, numpy as np
            
            def area_D(theta, n_samples=200000):
                # Monte Carlo estimate of area of intersection of rotated unit square centered at origin with third quadrant
                # Use random points in bounding box [-0.8,0.8]^2
                # Actually we can compute analytically via polygon clipping, but Monte Carlo okay for verification.
                # We'll generate many random points uniformly in square [-0.6,0.6]^2 (since max extent ~0.707)
                # Count points that are inside rotated square and in third quadrant.
                # Use vectorized operations.
                N=n_samples
                # generate points uniformly in bounding box [-0.8,0.8]
                xs = np.random.uniform(-0.8,0.8,N)
                ys = np.random.uniform(-0.8,0.8,N)
                # rotate points by +theta (i.e., apply inverse rotation to test if point is in axis-aligned square)
                # Condition: after rotating by -theta, coordinates must satisfy |x'| <= 0.5 and |y'| <= 0.5
                # Compute rotation matrix for -theta
                c = math.cos(theta)
                s = math.sin(theta)
                # rotate (xs,ys) by -theta: x' = xs*c + ys*s, y' = -xs*s + ys*c
                xp = xs*c + ys*s
                yp = -xs*s + ys*c
                inside = (np.abs(xp) <= 0.5) & (np.abs(yp) <= 0.5)
                third_quad = (xs < 0) & (ys < 0)
                count = np.sum(inside & third_quad)
                # area of bounding box
                area_box = (1.6)*(1.6)
                return count / N * area_box
            
            def estimate_p(num_theta=200, n_samples=50000):
                thetas = np.random.uniform(0, 2*math.pi, num_theta)
                areas = [area_D(t, n_samples) for t in thetas]
                return np.mean(areas)
            
            print(estimate_p(200, 200000))
            
