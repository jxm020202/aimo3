            def is_bipartite(adj):
                n=len(adj)
                color=[-1]*n
                from collections import deque
                for start in range(n):
                    if color[start]==-1:
                        color[start]=0
                        q=deque([start])
                        while q:
                            u=q.popleft()
                            for v in adj[u]:
                                if color[v]==-1:
                                    color[v]=color[u]^1
                                    q.append(v)
                                elif color[v]==color[u]:
                                    return False
                return True
            
