            def union_area(polys):
                # inclusion-exclusion for up to 4 polygons
                from itertools import combinations
                total = 0.0
                n = len(polys)
                for k in range(1, n+1):
                    sign = 1 if k%2==1 else -1
                    for combo in combinations(range(n), k):
                        # intersect all polygons in combo
                        inter = polys[combo[0]]
                        for idx in combo[1:]:
                            inter = intersect_polygons(inter, polys[idx])
                            if not inter:
                                break
                        area = polygon_area(inter)
                        total += sign * area
                return total
            
