            def generate_patterns(rows):
                patterns = []
                def backtrack(pos, prev_one, mask):
                    if pos == rows:
                        patterns.append(mask)
                        return
                    # put 0
                    backtrack(pos+1, False, mask)
                    # put 1 if previous not 1
                    if not prev_one:
                        backtrack(pos+1, True, mask | (1<<pos))
                backtrack(0, False, 0)
                return patterns
            
