            def find_path_counts(n, target_counts):
                N = 2**n
                # adjacency list with edge lengths (k)
                adj = {i: [] for i in range(N)}
                for i in range(N):
                    for k in range(n):
                        j = i ^ (1<<k)
                        adj[i].append((j,k))
                target = tuple(target_counts)
                # backtrack
                visited = [False]*N
                path = [0]
                visited[0]=True
                counts = [0]*n
                def dfs():
                    if len(path)==N:
                        return True
                    cur = path[-1]
                    for nxt,k in adj[cur]:
                        if not visited[nxt]:
                            if counts[k] + 1 > target_counts[k]:
                                continue
                            # proceed
                            visited[nxt]=True
                            path.append(nxt)
                            counts[k]+=1
                            if dfs():
                                return True
                            # backtrack
                            visited[nxt]=False
                            path.pop()
                            counts[k]-=1
                    return False
                if dfs():
                    return path, counts
                else:
                    return None
            
            target_counts = [1,2,4]  # for n=3
            res = find_path_counts(3, target_counts)
            print(res)
            
