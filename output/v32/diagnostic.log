            def test_quadratic_residue(p):
                # p odd prime
                omega = cmath.exp(2j*math.pi/p)
                residues = sorted({(i*i)%p for i in range(1,p)})  # includes 0? exclude 0
                residues = [r for r in residues if r != 0]
                # Use r_k = omega**r for each residue
                vals = [omega**r for r in residues]
                # compute max m
                max_m = 0
                for m in range(1, p):
                    prod = 1
                    for v in vals:
                        prod *= (v**m + 1)
                    if abs(prod - 1) < 1e-9:
                        max_m = m
                    else:
                        break
                return len(vals), max_m, residues
            
