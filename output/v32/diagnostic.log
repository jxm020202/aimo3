                    A = max(2*m+1, t+1)
                    min_total = base_t + r*A + r*(r-1)//2
                    if min_total <= 1997:
                        # we can construct by distributing extra = 1997 - min_total among later numbers
                        extra = 1997 - min_total
                        # start with minimal sequence:
                        seq = list(range(1, t+1))  # a_1..a_t
                        # a_{t+1} = A
                        seq.append(A)
                        # remaining numbers: A+1, A+2, ..., A+(r-1)
                        for i in range(1, r):
