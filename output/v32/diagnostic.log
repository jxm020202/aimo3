            def max_pieces(board_size=15, M=25):
                n = board_size
                N = n*n
                # Build neighbor lists
                neighbor_indices = []
                for i in range(n):
                    for j in range(n):
                        neigh = []
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                ii = i+di
                                jj = j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    neigh.append(ii*n + jj)
                        neighbor_indices.append(neigh)
                # Build constraint matrices
                rows = []
                b = []
                for idx, neigh in enumerate(neighbor_indices):
                    coeff = np.zeros(N, dtype=int)
                    # constraint 1: sum_{neighbors} x + M*x_i <= M + 2
                    for j in neigh:
                        coeff[j] = 1
                    coeff[idx] += M
                    rows.append(coeff)
                    b.append(M + 2)
                    # constraint 2: -sum_{neighbors} x + M*x_i <= M - 2
                    coeff2 = np.zeros(N, dtype=int)
                    for j in neigh:
                        coeff2[j] = -1
                    coeff2[idx] += M
                    rows.append(coeff2)
                    b.append(M - 2)
                A = np.vstack(rows)
                b = np.array(b)
                # objective: maximize sum x => minimize -sum x
                c = -np.ones(N, dtype=int)
                # bounds 0-1
                bounds = Bounds(0, 1)
                integrality = np.ones(N, dtype=int)  # 1 for integer
                # Use milp
                start = time.time()
                res = milp(c=c, A_ub=A, b_ub=b, bounds=bounds, integrality=integrality, options={"presolve": True, "disp": False})
                print("status:", res.success, res.message, "time:", time.time()-start)
                if not res.success:
                    return None
                x = np.round(res.x).astype(int)
                total = int(x.sum())
                return total, x.reshape((n,n))
            print(max_pieces())
            
