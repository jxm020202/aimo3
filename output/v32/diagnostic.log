            def min_Cprime_k(k, total=198):
                # dp dict: key = (sum_sofar, last_value) -> min cost
                dp = {}
                # i=1 initialization
                for x in range(total+1):
                    dp[(x, x)] = x*x  # cost x1^2
                # iterate i=2..k
                for i in range(2, k+1):
                    new_dp = {}
                    for (s, prev), cost in dp.items():
                        # remaining sum can be allocated to current x
                        max_x = total - s
                        for x in range(max_x+1):
                            new_s = s + x
                            new_cost = cost + (prev + x)*(prev + x)
                            key = (new_s, x)
                            if key not in new_dp or new_cost < new_dp[key]:
                                new_dp[key] = new_cost
                    dp = new_dp
                # after k variables, add final term (199 - x_k)^2
                best = None
                best_tuple = None
                for (s, last), cost in dp.items():
                    if s == total:
                        total_cost = cost + (199 - last)*(199 - last)
                        if best is None or total_cost < best:
                            best = total_cost
                            best_tuple = (last, cost)
                return best
            
            for k in range(1,11):
                best = min_Cprime_k(k)
                print(k, best)
            
