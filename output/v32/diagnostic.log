            import random, math, numpy as np
            
            def covers_any_lattice(theta, cx, cy):
                # square side 1 centered at (cx,cy), rotated by theta.
                # Determine if any integer lattice point (i,j) lies inside or on square.
                # Since square size 1, we only need to check lattice points within distance ~0.8?
                # We'll check points in range floor(cx-1) to ceil(cx+1) etc.
                # Use rotation to transform point to square's local coordinates.
                c = math.cos(theta)
                s = math.sin(theta)
                # Inverse rotation: rotate point by -theta
                # For each candidate lattice point (i,j)
                for i in range(int(math.floor(cx-1)), int(math.ceil(cx+1))+1):
                    for j in range(int(math.floor(cy-1)), int(math.ceil(cy+1))+1):
                        # vector from center to point
                        dx = i - cx
                        dy = j - cy
                        # rotate by -theta
                        x_local = dx*c + dy*s
                        y_local = -dx*s + dy*c
                        if abs(x_local) <= 0.5 + 1e-12 and abs(y_local) <= 0.5 + 1e-12:
                            return True
                return False
            
            def simulate(N=200000):
                count_no_cover = 0
                for _ in range(N):
                    theta = random.random()*2*math.pi
                    cx = random.random()  # uniform in [0,1)
                    cy = random.random()
                    if not covers_any_lattice(theta, cx, cy):
                        count_no_cover += 1
                return count_no_cover / N
            
            print(simulate(50000))
            
