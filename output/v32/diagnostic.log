            def max_edges_n(n):
                # vertices 0..n-1
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                max_m = -1
                best_graphs = []
                for mask in range(1<<m):
                    # quick bound: count bits
                    ecount = mask.bit_count()
                    if ecount < max_m:
                        continue
                    # build adjacency list
                    adj = [set() for _ in range(n)]
                    for idx,(i,j) in enumerate(edges):
                        if mask>>idx & 1:
                            adj[i].add(j)
                            adj[j].add(i)
