            def count_colorings_elimination_big(order):
                # Build factors
                factors = []
                for v in G.nodes():
                    vars_v = tuple(vertex_edges[v])
                    # create table as dict mapping assignment tuple to 1 if allowed else 0
                    table = {}
                    for colors in itertools.product(range(3), repeat=3):
                        if len(set(colors)) == 2:
                            table[colors] = 1
                    factors.append((vars_v, table))
                for var in order:
                    relevant = [f for f in factors if var in f[0]]
                    factors = [f for f in factors if var not in f[0]]
                    if not relevant:
                        continue
                    combined_vars = sorted(set().union(*[set(f[0]) for f in relevant]))
                    k = len(combined_vars)
                    var_index = {v:i for i,v in enumerate(combined_vars)}
                    # compute combined table as dict
                    combined_table = {}
                    # iterate over assignments
                    for assign in itertools.product(range(3), repeat=k):
                        prod = 1
                        for vars_f, table_f in relevant:
                            idx = tuple(assign[var_index[v]] for v in vars_f)
                            prod *= table_f.get(idx, 0)
                            if prod == 0:
                                break
                        if prod != 0:
                            combined_table[assign] = prod
                    # sum over var
                    idx_elim = var_index[var]
                    new_table = {}
                    for assign, val in combined_table.items():
                        # remove the coordinate at idx_elim
                        new_assign = assign[:idx_elim] + assign[idx_elim+1:]
                        new_table[new_assign] = new_table.get(new_assign, 0) + val
                    new_vars = tuple(v for v in combined_vars if v != var)
                    if len(new_vars) == 0:
                        # final total
                        total = sum(new_table.values())
                        return total
                    else:
                        factors.append((new_vars, new_table))
                # multiply remaining factors
                total = 1
                for vars_f, table_f in factors:
                    total *= sum(table_f.values())
                return total
            
            order = min_fill_ordering(L)
            total_big = count_colorings_elimination_big(order)
            total_big, total_big % 1000
            
