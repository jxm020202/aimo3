            import math
            
            def covered_area(theta):
                # compute area of union of squares (I-1,I]x(J-1,J] intersected with unit square [0,1]^2
                # where (I,J) = R_theta (i,j) for integer i,j
                # We'll enumerate i,j in a reasonable range
                # Use axis-aligned rectangles after clipping
                # Return covered area (float)
                cos = math.cos(theta)
                sin = math.sin(theta)
                rects = []
                # Determine range for i,j
                # Since (I,J) must be in (0,2], we can bound i,j by say -2..4
                # We'll just use a larger range to be safe
                R = 4
                for i in range(-R, R+1):
                    for j in range(-R, R+1):
                        I = cos*i + sin*j
                        J = -sin*i + cos*j
                        # square (I-1,I] x (J-1,J]
                        # intersect with [0,1]^2
                        x0 = max(0.0, I-1)
                        x1 = min(1.0, I)
                        y0 = max(0.0, J-1)
                        y1 = min(1.0, J)
                        if x0 < x1 and y0 < y1:
                            rects.append((x0,x1,y0,y1))
                # compute union area of axis-aligned rectangles
                # plane sweep over x
                xs = sorted(set([r[0] for r in rects] + [r[1] for r in rects]))
                area = 0.0
                for k in range(len(xs)-1):
                    x_left = xs[k]
                    x_right = xs[k+1]
                    width = x_right - x_left
                    if width <= 0:
                        continue
                    # find y-intervals of rectangles covering this x-interval
                    intervals = []
                    for (x0,x1,y0,y1) in rects:
                        if x0 <= x_left and x1 >= x_right:  # rectangle spans this x-slab
                            intervals.append((y0,y1))
                    # compute union length of intervals
                    if not intervals:
                        continue
                    intervals.sort()
                    cur_start, cur_end = intervals[0]
                    total_y = 0.0
                    for a,b in intervals[1:]:
                        if a <= cur_end:
                            cur_end = max(cur_end, b)
                        else:
                            total_y += cur_end - cur_start
                            cur_start, cur_end = a,b
                    total_y += cur_end - cur_start
                    area += width * total_y
                return area
            
            def p_theta(theta):
                return 1 - covered_area(theta)
            
            # test for some angles
            for th in [0, math.pi/6, math.pi/4, 0.3]:
                print(th, p_theta(th))
            
