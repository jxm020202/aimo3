                    DP[a1][curr] = a1*a1 + curr*curr
                # iterate for i from 2 to n-1 (since we need to add up to index n)
                for step in range(2, n):  # step = current index i
                    DP2 = [[INF]*(V+1) for _ in range(V+1)]
                    # for each curr value
                    for curr in range(1, V+1):
                        # Build convex hull of lines from prev=1..curr where DP[prev][curr] finite
                        # Each line: y = m*x + b, where m = -prev, b = DP[prev][curr]
                        # We'll store as (m,b)
                        from collections import deque
                        hull = deque()
                        # function to compute intersection x-coordinate where line1 and line2 have same value
                        # Since slopes are decreasing, we can use cross-multiplication to avoid floating.
                        def bad(l1, l2, l3):
                            # return True if l2 is unnecessary between l1 and l3
                            # l1, l2, l3 are (m,b)
                            # Intersection of l1 and l2: (b2-b1)/(m1-m2)
                            # Intersection of l2 and l3: (b3-b2)/(m2-m3)
                            # l2 is bad if first intersection >= second intersection (for lower hull)
                            m1,b1 = l1
                            m2,b2 = l2
                            m3,b3 = l3
                            # avoid division: (b2-b1)*(m2-m3) >= (b3-b2)*(m1-m2)
                            return (b2 - b1)*(m2 - m3) >= (b3 - b2)*(m1 - m2)
                        # add lines
                        for prev in range(1, curr+1):
                            val = DP[prev][curr]
                            if val >= INF:
                                continue
                            m = -prev
                            b = val
                            new_line = (m,b)
                            # maintain hull
                            while len(hull) >= 2 and bad(hull[-2], hull[-1], new_line):
                                hull.pop()
                            hull.append(new_line)
                        if not hull:
                            continue
                        # query for nxt from curr to V (increasing)
                        # pointer to best line
                        # We'll pop from left while next line gives smaller value
                        def value(line, x):
                            m,b = line
                            return m*x + b
                        # ensure hull is deque
                        # iterate nxt
                        # we can keep index pointer
                        # We'll use while to pop front if next line better
                        for nxt in range(curr, V+1):
                            while len(hull) >= 2 and value(hull[0], nxt) >= value(hull[1], nxt):
                                hull.popleft()
                            best = value(hull[0], nxt)
                            DP2[curr][nxt] = nxt*nxt + best
                    DP = DP2
                # after processing up to index n, we have DP[prev][curr] where curr = a_n
                # need a_n = V
                ans = INF
                for prev in range(1, V+1):
                    if DP[prev][V] < ans:
                        ans = DP[prev][V]
                return ans
            
            print(min_f_dp_cht(5,5))
            
