            from fractions import Fraction
            def f_exact_periodic(p,q):
                period = 2*q  # maybe 2q? Let's compute actual period by searching.
                # find minimal period
                max_check=2*q
                # compute parity for first max_check
                seq = [parity(p,q,n) for n in range(1,max_check+1)]
                # find smallest period >0 such that seq repeats
                for per in range(1,max_check+1):
                    if all(seq[i]==seq[i+per] for i in range(max_check-per)):
                        period=per
                        break
                # compute sum over period
                s=Fraction(0,1)
                for r in range(1,period+1):
                    if seq[r-1]==0: # even floor -> a=1
                        s+=Fraction(1, 2**r)
                # multiply by 1/(1-2^{-period})
                factor = Fraction(1, 1) / (Fraction(1,1) - Fraction(1, 2**period))
                return factor * s
            
            val = f_exact_periodic(25,38)
            val, float(val)
            
