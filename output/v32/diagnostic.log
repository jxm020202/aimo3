            def min_fill_treewidth(G):
                # G is networkx Graph
                best = [len(G.nodes())]  # upper bound
                best_order = []
                start = time.time()
                # initial upper bound via min-degree heuristic
                def heuristic_upper(G):
                    # simple elimination order: repeatedly remove min degree vertex
                    Gcopy = G.copy()
                    maxbag = 0
                    order = []
                    while Gcopy.nodes():
                        v = min(Gcopy.nodes(), key=lambda x: Gcopy.degree[x])
                        bag = set(Gcopy.neighbors(v))
                        bag.add(v)
                        maxbag = max(maxbag, len(bag))
                        order.append(v)
                        # make neighbors clique
                        neigh = list(Gcopy.neighbors(v))
                        for i in range(len(neigh)):
                            for j in range(i+1, len(neigh)):
                                Gcopy.add_edge(neigh[i], neigh[j])
                        Gcopy.remove_node(v)
                    return maxbag-1, order
                ub, order = heuristic_upper(G)
                best[0] = ub
                best_order[:] = order
                # recursive search with branch and bound
                def recurse(Gcur, cur_max, order_sofar):
                    # prune
                    if cur_max >= best[0]:
                        return
                    if not Gcur.nodes():
                        # finished
                        best[0] = cur_max
                        best_order[:] = order_sofar[:]
                        return
                    # choose vertex with minimum degree (or other heuristic)
                    # we can try all vertices of minimum degree to explore
                    min_deg = min(dict(Gcur.degree()).values())
                    candidates = [v for v in Gcur.nodes() if Gcur.degree[v]==min_deg]
                    for v in candidates:
                        # copy graph
                        Gnext = Gcur.copy()
                        # bag size = degree(v)+1
                        bag_size = Gcur.degree[v] + 1
                        new_max = max(cur_max, bag_size)
                        # make neighbors clique
                        neigh = list(Gnext.neighbors(v))
                        for i in range(len(neigh)):
                            for j in range(i+1, len(neigh)):
                                Gnext.add_edge(neigh[i], neigh[j])
                        Gnext.remove_node(v)
                        recurse(Gnext, new_max, order_sofar+[v])
                recurse(G, 0, [])
                return best[0], best_order
            
            tw_opt, order_opt = min_fill_treewidth(H)
            tw_opt, order_opt[:10]
            
