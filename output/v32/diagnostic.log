            def S_of_perm(p):
                n=len(p)
                s=0
                for i in range(n):
                    s+=abs(p[i]-p[(i+1)%n])
                return s
            
            def canonical(p):
                # return canonical representation of permutation under rotations and reversal (mirror)
                # p is tuple of length n
                n=len(p)
                # all rotations
                rots = [p[i:]+p[:i] for i in range(n)]
                # reversed order (mirror) also rotations of reversed
                rev = tuple(reversed(p))
                rots_rev = [rev[i:]+rev[:i] for i in range(n)]
                # choose minimal lexicographically
                cand = rots+rots_rev
                return min(cand)
            
            def compute():
                minS=10**9
                count=0
                classes=set()
                min_classes=set()
                for p in itertools.permutations(range(1,10)):
                    s=S_of_perm(p)
                    if s<minS:
                        minS=s
                        count=1
                        # reset classes
                        classes=set()
                        can=canonical(p)
                        classes.add(can)
                        min_classes={can}
                    elif s==minS:
                        count+=1
                        can=canonical(p)
                        classes.add(can)
                        min_classes.add(can)
                return minS, count, len(classes), len(min_classes)
            
