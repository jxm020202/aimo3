            def estimate_p_numpy(N, chunk=1000000):
                count=0
                total=0
                for _ in range(N//chunk):
                    # generate chunk samples
                    dx = np.random.rand(chunk) - 0.5  # uniform in [-0.5,0.5)
                    dy = np.random.rand(chunk) - 0.5
                    theta = np.random.rand(chunk) * (math.pi/2)
                    cos = np.cos(theta)
                    sin = np.sin(theta)
                    # For each of four vertices
                    # We'll compute a boolean array indicating if any vertex inside
                    inside_any = np.zeros(chunk, dtype=bool)
                    for sx, sy in [(-0.5, -0.5), (0.5, -0.5), (-0.5, 0.5), (0.5, 0.5)]:
                        x = dx + sx
                        y = dy + sy
                        # rotate by -theta: x' = cos*x + sin*y, y' = -sin*x + cos*y
                        xr = cos*x + sin*y
                        yr = -sin*x + cos*y
                        inside = (np.abs(xr) <= 0.5 + 1e-12) & (np.abs(yr) <= 0.5 + 1e-12)
                        inside_any |= inside
                    # count those where none inside
                    count += np.sum(~inside_any)
                    total += chunk
                # handle remainder
                rem = N % chunk
                if rem:
                    dx = np.random.rand(rem) - 0.5
                    dy = np.random.rand(rem) - 0.5
                    theta = np.random.rand(rem) * (math.pi/2)
                    cos = np.cos(theta)
                    sin = np.sin(theta)
                    inside_any = np.zeros(rem, dtype=bool)
