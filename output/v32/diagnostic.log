            import itertools
            
            def min_int_with_weight(w, max_bits=20):
                min_val = None
                best = None
                # generate all NAF patterns of length up to max_bits with weight w
                # digits -1,0,1, no adjacent non-zero
                # we can generate combinations of positions for non-zero digits, then assign signs.
                positions = list(range(max_bits))
                for comb in itertools.combinations(positions, w):
                    # check no adjacency
                    ok = True
                    for i in range(w-1):
                        if comb[i+1] == comb[i]+1:
                            ok = False
                            break
                    if not ok:
                        continue
                    # assign signs: each non-zero digit can be +1 or -1
                    for signs in itertools.product([-1,1], repeat=w):
                        # compute value
                        val = sum(signs[i]* (1<<comb[i]) for i in range(w))
                        if val>0:
                            if min_val is None or val < min_val:
                                min_val = val
                                best = (comb, signs)
                return min_val, best
            
            for w in range(1,6):
                val,best = min_int_with_weight(w, max_bits=12)
                print(w, val, best)
            
