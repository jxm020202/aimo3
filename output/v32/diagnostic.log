            N=15
            coords = [(i,j) for i in range(N) for j in range(N)]
            neighbors = {}
            for c in coords:
                i,j = c
                neigh = []
                for di in range(-2,3):
                    for dj in range(-2,3):
                        if max(abs(di),abs(dj)) <= 2:
                            ni, nj = i+di, j+dj
                            if 0 <= ni < N and 0 <= nj < N:
                                if (ni,nj)!=c:
                                    neigh.append((ni,nj))
                neighbors[c]=neigh
            
            def forbidden_zone(a,b):
                zone=set()
                for p in neighbors[a]:
                    if p!=a and p!=b:
                        zone.add(p)
                for p in neighbors[b]:
                    if p!=a and p!=b:
                        zone.add(p)
                return zone
            
            best_n=0
            best_pairs=[]
            start_time=time.time()
            time_limit=25  # seconds
            
            def recurse(available, pairs):
                global best_n, best_pairs, start_time
                # time check
                if time.time()-start_time > time_limit:
                    raise TimeoutError
                cur_n=len(pairs)*2
                if cur_n>best_n:
                    best_n=cur_n
                    best_pairs=pairs.copy()
                    print("New best:",best_n)
                # bound
                if cur_n + 2*(len(available)//2) <= best_n:
                    return
                if not available:
                    return
                # MRV: choose cell with fewest available neighbors
                # compute candidate cells and neighbor counts
                min_options=999
                chosen=None
                for cell in available:
                    # count neighbors that are also in available
                    cnt=sum(1 for nb in neighbors[cell] if nb in available)
                    if cnt < min_options:
                        min_options=cnt
                        chosen=cell
                        if cnt==0:
                            break
                a=chosen
                # option 1: try pairing a with each available neighbor
                neighbor_list=[nb for nb in neighbors[a] if nb in available]
                for b in neighbor_list:
                    # pair a,b
                    zone=forbidden_zone(a,b)
                    new_avail=available - {a,b} - zone
                    recurse(new_avail, pairs+[(a,b)])
                # option 2: skip a (leave empty)
                recurse(available-{a}, pairs)
            
            available_initial=set(coords)
            try:
                recurse(available_initial, [])
            except TimeoutError:
                print("Time limit reached")
            print("Best n:",best_n)
            
