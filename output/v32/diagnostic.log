        >>> Code:
            import itertools, math
            
            def total_bruteforce(n):
                S=list(range(1,n+1))
                subsets=[]
                for mask in range(1<<n):
                    subset=set()
                    for i in range(n):
                        if mask>>i &1:
                            subset.add(S[i])
                    subsets.append(subset)
                total=0
                for A in subsets:
                    for B in subsets:
                        symdiff = (A - B) | (B - A)
                        total+=sum(symdiff)
                return total
            
            for n in range(1,6):
                brute=total_bruteforce(n)
                formula = n*(n+1)*(2**(2*n-2))
                print(n, brute, formula, brute==formula)
            
