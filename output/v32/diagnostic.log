            import random, math, numpy as np
            
            def area_intersection(theta, N=200000):
                # Monte Carlo estimate of area of rotated square intersect first quadrant
                # bounding box: x,y in [0, max_coord] where max_coord = (cos+sin)/2
                max_coord = (math.cos(theta)+math.sin(theta))/2
                # sample uniformly in square [0, max_coord]^2, compute fraction inside rotated square
                count=0
                for _ in range(N):
                    x = random.random()*max_coord
                    y = random.random()*max_coord
                    # condition: |x cosθ + y sinθ| <= 0.5 and |-x sinθ + y cosθ| <= 0.5
                    if abs(x*math.cos(theta)+y*math.sin(theta)) <= 0.5 and abs(-x*math.sin(theta)+y*math.cos(theta)) <= 0.5:
                        count+=1
                return (count/N)*(max_coord**2)
            
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/5, math.pi/4]:
                print(th, area_intersection(th, N=200000))
            
