            def solve_board(N=15):
                coords = [(i,j) for i in range(N) for j in range(N)]
                index = {c:k for k,c in enumerate(coords)}
                num_vars = N*N
                # neighbor list for each vertex
                neighbors = []
                max_neighbors = 0
                for (i,j) in coords:
                    neigh = []
                    for di in range(-2,3):
                        for dj in range(-2,3):
                            if di==0 and dj==0: continue
                            ni, nj = i+di, j+dj
                            if 0 <= ni < N and 0 <= nj < N:
                                neigh.append(index[(ni,nj)])
                    neighbors.append(neigh)
                    max_neighbors = max(max_neighbors, len(neigh))
                # Build constraints
                # For each v: sum_{u in N(v)} x_u >= x_v
                # and sum_{u in N(v)} x_u <= x_v + max_neighbors*(1 - x_v)
                rows = []
                lbs = []
                ubs = []
                for v in range(num_vars):
                    row = np.zeros(num_vars, dtype=int)
                    for u in neighbors[v]:
                        row[u] = 1
                    # lower bound: sum - x_v >= 0 => sum - x_v >= 0
                    row[v] -= 1
                    rows.append(row.copy())
                    lbs.append(0)
                    ubs.append(np.inf)  # no upper bound for lower constraint
                    # upper bound: sum - x_v <= max_neighbors*(1 - x_v)
                    # rewrite: sum - x_v + max_neighbors*x_v <= max_neighbors
                    # => sum + (max_neighbors-1)*x_v <= max_neighbors
                    row2 = np.zeros(num_vars, dtype=int)
                    for u in neighbors[v]:
                        row2[u] = 1
                    row2[v] += (max_neighbors - 1)  # coefficient for x_v
                    rows.append(row2)
                    lbs.append(-np.inf)
                    ubs.append(max_neighbors)
                A = np.vstack(rows)
                lc = LinearConstraint(A, lbs, ubs)
                c = -np.ones(num_vars)  # maximize sum
                bounds = Bounds(0,1)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                return res
            
            res15 = solve_board(15)
            print(res15.success, res15.fun)
            
