                for n in range(4, limit+1):
                    if n%2==0 and n>2: # composite includes even numbers
                        # but we need composite; check not prime
                        if sympy.isprime(n):
                            continue
                        # test existence via linear map
                        ok,_=exists_a_linear(n)
                        if ok:
                            if smallest is None:
                                smallest=n
                            elif second is None:
                                second=n
                                break
                return smallest, second
            
