            def integrate_adj(N=200000):
                # integrate over theta from 0 to pi/4 using Simpson or trapezoidal
                a = 0.0
                b = math.pi/4
                thetas = np.linspace(a, b, N)
                areas = np.array([overlap_area_adj(t) for t in thetas])
