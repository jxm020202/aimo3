        ```python
import sympy as sp

def count_real_roots(n):
    # polynomial z^n + z^(n-1) + 5
    z = sp.symbols('z')
    poly = z**n + z**(n-1) + 5
    roots = sp.nroots(poly, n= n+5) # numeric roots
    real_roots = [r for r in roots if abs(sp.im(r)) < 1e-10]
    return len(real_roots), roots

for n in [3,5,7,9]:
    real_count, roots = count_real_roots(n)
    print(n, real_count)
    # print roots for verification
