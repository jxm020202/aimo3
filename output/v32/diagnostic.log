            def find_scaled_triple(N, d):
                target = N // d
                for x in range(1, target):
                    for y in range(x+1, target):
                        z = target - x - y
                        if z <= y:
                            continue
                        if z % x == 0 and z % y == 0:
                            return (x,y,z)
                return None
            
            def find_best_f(N, max_d=None):
                # search over divisors d of N up to maybe some limit
                best = None
                best_trip = None
                for d in sympy.divisors(N):
                    if max_d is not None and d > max_d:
                        continue
                    t = find_scaled_triple(N, d)
                    if t:
                        l = d * max(t)
                        if best is None or l < best:
                            best = l
                            best_trip = (d, t)
                return best, best_trip
            
            import sympy
            N = 5*3**5  # example small k=5
            best, trip = find_best_f(N)
            best, trip
            
