            def max_E_pr_random(p, r, samples=500000, L=5):
                q = 9 - p - r
                best = -1
                best_vals = None
                for _ in range(samples):
                    a = random.uniform(-L, L)
                    c = random.uniform(-L, L)
                    b = (1 - p*a - r*c)/q
                    if not (a <= b <= c):
                        continue
                    # compute A, C
                    A = p*(b - a) + r*(c - b)
                    C = p*a*a + q*b*b + r*c*c
                    if C <= 0:
                        continue
                    E = (A*A * (9*C - 1)) / (C**3)
                    if E > best:
                        best = E
                        best_vals = (a,b,c)
                return best, best_vals
            
