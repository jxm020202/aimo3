            import numpy as np, math, random, sys, time
            from scipy.optimize import minimize
            
            def objective(vars):
                # vars = [x1,y1,z1,x,y,t]
                return vars[5]
            
            def constraints(vars):
                x1,y1,z1,x,y,t = vars
                z = 6 - 3*x - 1.5*y
                cons = []
                # equality constraints
                cons.append({'type':'eq','fun': lambda v: x1**2 + y1**2 + z1**2 - 1})
                cons.append({'type':'eq','fun': lambda v: 6*x + 3*y + 2*z - 12})
                # inequality constraints (>=0)
                cons.append({'type':'ineq','fun': lambda v: x}) # x>=0
                cons.append({'type':'ineq','fun': lambda v: y}) # y>=0
                cons.append({'type':'ineq','fun': lambda v: 4 - (2*x + y)}) # 2x+y <=4
                # bounds for differences
                cons.append({'type':'ineq','fun': lambda v: t - (x - x1)}) # t >= x - x1
                cons.append({'type':'ineq','fun': lambda v: t + (x - x1)}) # t >= -(x - x1)
                cons.append({'type':'ineq','fun': lambda v: t - (y - y1)})
                cons.append({'type':'ineq','fun': lambda v: t + (y - y1)})
                cons.append({'type':'ineq','fun': lambda v: t - (z - z1)})
                cons.append({'type':'ineq','fun': lambda v: t + (z - z1)})
                cons.append({'type':'ineq','fun': lambda v: t}) # t>=0
                return cons
            
            def solve_initial_guess():
                # random initial guess
                # sphere point
                x1,y1,z1 = random_point_on_sphere()
                # triangle point: random inside triangle
                # sample barycentric coordinates
                u = random.random()
                v = random.random()
                if u+v>1:
                    u = 1-u
                    v = 1-v
                # vertices (2,0,0), (0,4,0), (0,0,6)
                x = 2*u
                y = 4*v
                # compute z from plane
                z = 6 - 3*x - 1.5*y
                # initial t guess as max diff
                t0 = max(abs(x - x1), abs(y - y1), abs(z - z1))
                return np.array([x1,y1,z1,x,y,t0])
            
            def run_opt():
                best = None
                best_val = 1e9
                for i in range(20):
                    x0 = solve_initial_guess()
                    res = minimize(objective, x0, method='SLSQP', constraints=constraints(x0), options={'ftol':1e-9,'maxiter':200})
                    if res.success:
                        val = res.fun
                        if val < best_val:
                            best_val = val
                            best = res.x
                return best_val, best
            
            best_val, best = run_opt()
            print(best_val, best)
            
