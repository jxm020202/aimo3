            def check_pairs(pairs, board_size=15):
                # Build list of all pieces
                pieces = [p for pair in pairs for p in pair]
                # Check each piece has exactly one neighbor within distance <=2
                for i, a in enumerate(pieces):
                    count = 0
                    for j, b in enumerate(pieces):
                        if i==j: continue
                        if max(abs(a[0]-b[0]), abs(a[1]-b[1])) <= 2:
                            count += 1
                    if count != 1:
                        return False, (a, count)
                return True, None
            
            check_pairs(pairs)
            
