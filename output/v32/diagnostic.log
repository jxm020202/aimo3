            def count_colorings():
                # initialize factors for each vertex
                factors = [vertex_factor(tuple(vertex_edges[v])) for v in range(nV)]
                remaining_edges = set(range(nE))
                # loop
                while remaining_edges:
                    e = next(iter(remaining_edges))
                    # find factors containing e
                    idxs = [i for i,f in enumerate(factors) if e in f[0]]
                    if len(idxs) != 2:
                        # maybe e already eliminated? Should not happen
                        remaining_edges.remove(e)
                        continue
                    i,j = idxs
                    f_i = factors[i]
                    f_j = factors[j]
                    # multiply
                    f_comb = multiply_factors(f_i, f_j)
                    # sum out e
                    f_new = sum_out_var(f_comb, e)
                    # update factors list: remove higher index first
                    for idx in sorted([i,j], reverse=True):
                        factors.pop(idx)
                    factors.append(f_new)
                    remaining_edges.remove(e)
                # after all edges eliminated, there should be a single factor with empty vars
                assert len(factors) == 1
                final_factor = factors[0]
                assert final_factor[0] == ()
                total = sum(final_factor[1].values())
                return total
            
