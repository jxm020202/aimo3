            def min_prefix_value(N):
                # generate all rational points k/n for 1<=n<=N, 0<=k<=n
                points = set()
                for n in range(1, N+1):
                    for k in range(0, n+1):
                        points.add(fractions.Fraction(k, n))
                # keep only points in [0,1]
                points = [p for p in points if 0 <= p <= 1]
                points = sorted(set(points))
                # intervals between consecutive points (open intervals)
                intervals = []
                for i in range(len(points)-1):
                    a = points[i]
                    b = points[i+1]
                    if a == b:
                        continue
                    # choose midpoint rational as float
                    mid = (a + b) / 2
                    intervals.append((float(mid), a, b))
                # also consider leftmost interval from 0 to first point? Actually first point is 0.
                # points includes 0 and 1, so intervals cover (0,1) open.
                # For each interval compute prefix bits
                min_val = 1.0  # max possible
                min_bits = None
                for mid, a, b in intervals:
                    bits = []
                    for n in range(1, N+1):
                        floor_val = math.floor(n * mid)
                        bits.append(1 if floor_val % 2 == 0 else 0)
                    # compute binary fraction value
                    val = sum(bit / (2**(i+1)) for i, bit in enumerate(bits))
                    if val < min_val:
                        min_val = val
                        min_bits = bits
                return min_val, min_bits, intervals
            
            for N in range(1, 11):
