            import itertools
            
            def count_independent_sets(n):
                # generate all binary strings length n with no adjacent 1's horizontally
                valid = []
                for bits in range(1<<n):
                    # check no adjacent 1s
                    if bits & (bits<<1):
                        continue
                    valid.append(bits)
                # compatibility: no overlapping 1s
                compat = {s: [] for s in valid}
                for s in valid:
                    for t in valid:
                        if s & t == 0:
                            compat[s].append(t)
                # DP
                dp = {s: 1 for s in valid}  # first row
                for row in range(1, n):  # already have first row, need n-1 more rows
                    newdp = {t: 0 for t in valid}
                    for t in valid:
                        total = 0
                        for s in compat[t]:
                            total += dp[s]
                        newdp[t] = total
                    dp = newdp
                total = sum(dp.values())
                return total
            
            for n in range(2,6):
                print(n, count_independent_sets(n))
            
