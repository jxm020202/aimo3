            def new_cells_for_move(orient, r, c, direction):
                # return list of cells that would be newly occupied after moving one step in direction
                dr, dc = dirs[direction]
                if orient == 'H':
                    # original cells: (r,c) and (r,c+1)
                    # after move: (r+dr, c+dc) and (r+dr, c+dc+1)
                    # overlapping cells are those that are also in original set
                    new_cells = []
                    # compute target cells
                    target = [(r+dr, c+dc), (r+dr, c+dc+1)]
                    # overlapping cells: intersection of target and original cells
                    original = {(r,c), (r,c+1)}
                    for cell in target:
                        if cell not in original:
                            new_cells.append(cell)
                    return new_cells
                else:  # 'V'
                    # original cells: (r,c) and (r+1,c)
                    target = [(r+dr, c+dc), (r+1+dr, c+dc)]
                    original = {(r,c), (r+1,c)}
                    new_cells = [cell for cell in target if cell not in original]
                    return new_cells
            
