                n=4
                N=2**n
                allowed_lengths = {8,4}
                # adjacency list with allowed lengths
                edges = {i:[] for i in range(N)}
                for i in range(N):
                    for k in range(n):
                        length = 2**k
                        if length in allowed_lengths:
                            j = i ^ length
                            if i < j:
                                edges[i].append(j)
                                edges[j].append(i)
