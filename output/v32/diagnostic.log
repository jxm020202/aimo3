            def trial(N=1000000):
                cnt_contains = 0
                for _ in range(N):
                    cx = random.random()
                    cy = random.random()
                    theta = random.random() * 2*math.pi
                    # compute coordinates of origin relative to square center after rotating by -theta
                    # vector from center to origin = (-cx, -cy)
                    x = -cx*math.cos(theta) - (-cy)*math.sin(theta)  # Actually rotation matrix: 
                    # Wait: rotate vector v by -theta: v' = R_{-theta} v = (cosθ v_x + sinθ v_y, -sinθ v_x + cosθ v_y)
                    vx = -cx
                    vy = -cy
                    xr = math.cos(theta)*vx + math.sin(theta)*vy
                    yr = -math.sin(theta)*vx + math.cos(theta)*vy
                    if abs(xr) <= 0.5 and abs(yr) <= 0.5:
                        cnt_contains += 1
                return cnt_contains/N
            
            for N in [10000, 50000, 200000]:
                p_est = 1 - trial(N)
                print(N, p_est)
            
