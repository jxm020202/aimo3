            def max_D_ilp(n):
                import numpy as np, scipy.sparse as sp, scipy.optimize as opt
                vertices = list(range(n))
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                edge_index = {e:i for i,e in enumerate(edges)}
                rows = []
                cols = []
                data = []
                ub = []
                # -z + x1 + x2 <= 1
                for u in range(n):
                    for v in range(u+1,n):
                        idx_z = m + edge_index[(u,v)]
                        for w in range(n):
                            if w==u or w==v: continue
                            e1 = (u,w) if u<w else (w,u)
                            e2 = (v,w) if v<w else (w,v)
                            idx_x1 = edge_index[e1]
                            idx_x2 = edge_index[e2]
                            row = len(ub)
                            rows.extend([row, row, row])
                            cols.extend([idx_z, idx_x1, idx_x2])
                            data.extend([-1, 1, 1])
                            ub.append(1)
                # z + x <= 1
                for u in range(n):
                    for v in range(u+1,n):
                        idx_z = m + edge_index[(u,v)]
                        idx_x = edge_index[(u,v)]
                        row = len(ub)
                        rows.extend([row, row])
                        cols.extend([idx_z, idx_x])
                        data.extend([1, 1])
                        ub.append(1)
                A = sp.csr_matrix((data, (rows, cols)), shape=(len(ub), 2*m))
                # lower bounds are -inf
                lb = np.full_like(ub, -np.inf, dtype=float)
                constraints = opt.LinearConstraint(A, lb, ub)
                c = np.concatenate([np.ones(m), -np.ones(m)])  # maximize sum x - sum z -> minimize -c
                integrality = np.ones(2*m, dtype=int)
                bounds = opt.Bounds(0, 1)  # all variables between 0 and 1
                res = opt.milp(c=-c, constraints=constraints, integrality=integrality, bounds=bounds, options={'disp': False})
                if not res.success:
                    print("ILP failed", res.message)
                    return None
                x = res.x[:m]
                D = sum(x) - sum(res.x[m:])
                return D
            
            for n in range(4,8):
                D = max_D_ilp(n)
                print(n, D, n//2)
            
