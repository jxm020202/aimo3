            def contains_lattice_point_robust2(x, y, theta):
                cos = math.cos(theta)
                sin = math.sin(theta)
                # rectangle in (I,J) space
                A = cos*x + sin*y
                B = -sin*x + cos*y
                corners = [(A, B),
                           (A+1, B),
                           (A, B+1),
                           (A+1, B+1)]
                # map to (i,j) via R_theta (inverse of R_{-theta})
                def inv(I,J):
                    # apply rotation by +theta
                    return (cos*I - sin*J, sin*I + cos*J)
                ij_corners = [inv(I,J) for (I,J) in corners]
                i_vals = [c[0] for c in ij_corners]
                j_vals = [c[1] for c in ij_corners]
                i_min = math.floor(min(i_vals)) - 1
                i_max = math.ceil(max(i_vals)) + 1
                j_min = math.floor(min(j_vals)) - 1
                j_max = math.ceil(max(j_vals)) + 1
                for i in range(i_min, i_max+1):
                    for j in range(j_min, j_max+1):
                        I = cos*i + sin*j
                        J = -sin*i + cos*j
                        if A <= I <= A+1 and B <= J <= B+1:
                            return True
                return False
            
            def test_random2(N, theta):
                for _ in range(N):
                    x=random.random()
                    y=random.random()
