            def make_matrix_generic(n, part):
                X=set(part)
                Y=set(range(n))-X
                A=np.zeros((n,n),dtype=int)
                for i in range(n):
                    for j in range(n):
                        if i!=j and ((i in X and j in Y) or (i in Y and j in X)):
                            A[i,j]=1
                return A
            
            def check_matrix(A):
                n=A.shape[0]
                k=n//2
                J=np.ones((n,n),dtype=int)
                return np.all(A.dot(A)+k*A == k*J)
            
            def test_n(n):
                k=n//2
                # iterate over all partitions (choose k out of n)
                from itertools import combinations
                count=0
                for part in combinations(range(n), k):
                    A=make_matrix_generic(n, part)
                    if check_matrix(A):
                        count+=1
                # each unordered partition counted twice (choose complement)
                return count//2
            
            for n in [2,4,6,8]:
