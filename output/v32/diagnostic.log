        >>> Code:
            def I_n_quad(n):
                f = lambda t: (mp.sin(n*t)**2)/mp.sin(t) if t!=0 else 0
                # integrate from 0 to pi/2, split into many subintervals to handle oscillations
                # use mp.quad with list of intervals: [0, pi/2] might be okay but we can split at points k*pi/n?
                # We'll split at points t = k*pi/(2*n) maybe? Actually sin^2(nt) period pi/n, zeros at t = k*pi/n.
                # Let's split into intervals of length pi/(2*n) to capture oscillations.
                intervals = []
                step = mp.pi/(2*n)
                a = 0
                while a < mp.pi/2:
                    b = min(a+step, mp.pi/2)
                    intervals.append([a, b])
                    a = b
                # integrate each interval
                total = mp.mpf('0')
                for seg in intervals:
                    total += mp.quad(f, seg)
                return total
            
            for n in [1,2,3,5,10,20,50]:
                mp.mp.dps = 30
                print(n, I_n_quad(n))
            
