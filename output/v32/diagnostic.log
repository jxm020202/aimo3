            import itertools
            
            def max_edges_n(n):
                max_e = 0
                best = []
                # enumerate all graphs via edge bitmask
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                for mask in range(1<<m):
                    # quick prune: if potential max edges less than current max, skip? not needed for small n
                    e_set = set()
                    for idx, (i,j) in enumerate(edges):
                        if mask>>idx & 1:
                            e_set.add((i,j))
                    # compute adjacency list
                    adj = [set() for _ in range(n)]
                    for (i,j) in e_set:
                        adj[i].add(j)
                        adj[j].add(i)
                    # condition: for each vertex u, there exists neighbor v such that no common neighbor
                    ok = True
                    for u in range(n):
                        found = False
                        for v in adj[u]:
                            # check common neighbor
                            common = adj[u].intersection(adj[v])
                            # exclude u and v themselves? they are not in adjacency sets
                            if len(common)==0:
                                found = True
                                break
                        if not found:
                            ok = False
                            break
                    if ok:
                        ecount = len(e_set)
                        if ecount > max_e:
                            max_e = ecount
                            best = [mask]
                        elif ecount == max_e:
                            best.append(mask)
                return max_e, best
            
            for n in range(2,7):
                max_e,_ = max_edges_n(n)
                print(n, max_e, "floor(n^2/4)=", (n*n)//4)
            
