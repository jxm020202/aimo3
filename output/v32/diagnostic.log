                                c2 = assigned[1][1]
                                e3 = unassigned[0]
                                if c1==c2:
                                    allowed = {0,1,2} - {c1}
                                else:
                                    allowed = {c1,c2}
                                new_dom = domains[e3] & allowed
                                if not new_dom:
                                    return False
                                if new_dom != domains[e3]:
                                    domains[e3] = new_dom
                                    changed = True
                                    if len(new_dom)==1:
                                        colors[e3] = next(iter(new_dom))
                    return True
                
                def backtrack():
                    # propagate constraints
                    if not propagate():
                        return False
                    # check if all assigned
                    if all(c!=-1 for c in colors):
                        # verify all triangles
                        for tri in tri_edges:
                            if not triangle_ok(tri):
                                return False
                        return True
                    # choose edge with smallest domain >1
                    # pick unassigned edge with smallest domain size
                    min_edge = None
                    min_size = 10
                    for i in range(30):
                        if colors[i]==-1:
                            sz = len(domains[i])
                            if sz < min_size:
                                min_size = sz
                                min_edge = i
                                if sz==2:
                                    break
                    # branch
                    saved_domains = [d.copy() for d in domains]
                    saved_colors = colors[:]
                    for col in list(domains[min_edge]):
                        colors[min_edge] = col
                        domains[min_edge] = {col}
                        if backtrack():
                            return True
                        # restore
                        domains[:] = [d.copy() for d in saved_domains]
                        colors[:] = saved_colors[:]
                    return False
                
                return backtrack()
            
