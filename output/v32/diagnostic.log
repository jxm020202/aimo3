            def max_pieces(board_size=15, radius=2):
                n = board_size
                N = n*n
                # map index to (r,c)
                coords = [(i//n, i%n) for i in range(N)]
                # Precompute neighbor sets
                neighbor_indices = []
                for i, (r,c) in enumerate(coords):
                    neigh = []
                    for dr in range(-radius, radius+1):
                        for dc in range(-radius, radius+1):
                            rr = r+dr
                            cc = c+dc
                            if 0 <= rr < n and 0 <= cc < n:
                                j = rr*n + cc
                                neigh.append(j)
                    neighbor_indices.append(neigh)
                # Build constraint matrix rows
                rows = []
                lb = []
                ub = []
                # constraint sum_{j in N(i)} x_j <= 2
                for i, neigh in enumerate(neighbor_indices):
                    coeff = np.zeros(N, dtype=int)
                    coeff[neigh] = 1
                    rows.append(coeff)
                    lb.append(-np.inf)  # no lower bound
                    ub.append(2)
                # constraint -sum_{j in N(i)} x_j + 2*x_i <= 0
                for i, neigh in enumerate(neighbor_indices):
                    coeff = np.zeros(N, dtype=int)
                    # -1 for all neighbors
                    coeff[neigh] = -1
                    # +2 for i
                    coeff[i] += 2  # note i already -1, so net +1
                    rows.append(coeff)
                    lb.append(-np.inf)
                    ub.append(0)
                A = np.vstack(rows)
                # Convert to LinearConstraint
                lc = LinearConstraint(A, lb, ub)
                c = -np.ones(N)  # maximize sum x_i => minimize -sum
                bounds = Bounds(0, 1)
                integrality = np.ones(N, dtype=int)
                # Solve MILP
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': True})
                return res
            
            res = max_pieces()
            
