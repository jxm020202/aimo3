            def find_path(m, max_iter=1000000):
                n = 2**m
                powers = [1<<k for k in range(m)]
                adj = {v: [v^p for p in powers] for v in range(n)}
                target_counts = [2**k for k in range(m)]  # n_k
                # We'll backtrack depth-first with pruning counts.
                visited = [False]*n
                path = [0]
                visited[0]=True
                counts = [0]*m
                # recursion
                def dfs(v, depth):
                    if depth == n-1:
                        return True
                    # order neighbors maybe by larger power first to reduce branching
                    # generate neighbors sorted by descending power (i.e., larger length)
                    # compute power index for each neighbor
                    neighs = []
                    for nb in adj[v]:
                        if not visited[nb]:
                            # length = abs(nb - v) = power
                            length = abs(nb - v)
                            k = length.bit_length()-1  # power index
                            neighs.append(( -k, nb, k))  # sort descending k
                    neighs.sort()
                    for _, nb, k in neighs:
                        # prune if count would exceed target
                        if counts[k] + 1 > target_counts[k]:
                            continue
                        visited[nb]=True
                        path.append(nb)
                        counts[k]+=1
                        if dfs(nb, depth+1):
                            return True
                        # backtrack
                        visited[nb]=False
                        path.pop()
                        counts[k]-=1
                    return False
                if dfs(0,0):
                    return path
                else:
                    return None
            
            path5 = find_path(5)
            path5[:20], len(path5)
            
