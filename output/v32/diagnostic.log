            def random_regular_matrix(n, d):
                # generate random n x n binary matrix with row sum d and column sum d
                # using configuration model: create d copies of each row index (out-stubs) and each column index (in-stubs)
                # then random matching
                out = [i for i in range(n) for _ in range(d)]
                inn = [j for j in range(n) for _ in range(d)]
                random.shuffle(inn)
                A = np.zeros((n,n), dtype=int)
                for i,j in zip(out, inn):
                    A[i,j] += 1
                # ensure binary (no multiple edges)
                # if any entry >1, reject and retry
                if np.any(A>1):
                    return None
                return A
            
