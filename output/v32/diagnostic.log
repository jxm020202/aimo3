            import numpy as np, math, itertools, collections, sys, time, random, math
            n_vertices = n
            n_edges = len(edges)
            total_vars = n_vertices + n_edges
            
            # variable ordering: first x_i (0..n_vertices-1), then y_e (n_vertices..total_vars-1)
            # Build equality constraints
            A_eq_rows = []
            b_eq = []
            
            # incidence list for each vertex
            incident_edges = [[] for _ in range(n_vertices)]
            for e_idx, (i,j) in enumerate(edges):
                incident_edges[i].append(e_idx)
                incident_edges[j].append(e_idx)
            
            for i in range(n_vertices):
                row = np.zeros(total_vars, dtype=int)
                # sum of y incident
                for e_idx in incident_edges[i]:
                    row[n_vertices + e_idx] = 1
                # -x_i
                row[i] = -1
                A_eq_rows.append(row)
                b_eq.append(0)
            
            A_eq = np.array(A_eq_rows)
            b_eq = np.array(b_eq)
            
            # Inequality constraints for each edge
            A_ub_rows = []
            b_ub = []
            for e_idx, (i,j) in enumerate(edges):
                row = np.zeros(total_vars, dtype=int)
                row[i] = 1
                row[j] = 1
                row[n_vertices + e_idx] = -1
                A_ub_rows.append(row)
                b_ub.append(1)
            
            A_ub = np.array(A_ub_rows)
            b_ub = np.array(b_ub)
            
            # variable bounds: binary 0-1
            lb = np.zeros(total_vars)
            ub = np.ones(total_vars)
            
            # objective: maximize sum x_i (or 2* sum y_e). We'll maximize sum x_i.
            c = -np.concatenate([np.ones(n_vertices), np.zeros(n_edges)])  # milp minimizes c^T x, so negative to maximize
            
            # Solve MILP
            res = milp(c=c, A_eq=A_eq, b_eq=b_eq, A_ub=A_ub, b_ub=b_ub,
                       bounds=Bounds(lb, ub), integrality=np.arange(total_vars))
            
