                                    coeff[r1*N + a] = 1
                                    coeff[r1*N + bcol] = 1
                                    coeff[r2*N + ccol] = 1
                                    coeff[r2*N + dcol] = 1
                                    constraints.append(coeff)
                                    lbs.append(-np.inf)
                                    ubs.append(3)
