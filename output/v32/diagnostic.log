            def construct_graph(n=160, k=9):
                # core vertices 0..k-1
                # leaves assigned to groups
                t = n - 2*k
                q = t // k
                r = t % k
                # group sizes a_i = 1 + b_i, where b_i = q+1 for first r groups, q for rest
                a = []
                for i in range(k):
                    b = q + (1 if i < r else 0)
                    a_i = 1 + b
                    a.append(a_i)
                # assign leaf vertices indices from k to n-1
                leaf_groups = []
                idx = k
                for size in a:
                    group = list(range(idx, idx+size))
                    leaf_groups.append(group)
                    idx += size
                # adjacency matrix
                adj = [[0]*n for _ in range(n)]
                # core clique
                for i in range(k):
                    for j in range(i+1, k):
                        adj[i][j] = adj[j][i] = 1
                # core-leaf edges
                for i, group in enumerate(leaf_groups):
                    for leaf in group:
                        adj[i][leaf] = adj[leaf][i] = 1
                # leaf-leaf edges across groups (complete multipartite)
                for i in range(k):
                    for j in range(i+1, k):
                        for leaf_i in leaf_groups[i]:
                            for leaf_j in leaf_groups[j]:
                                adj[leaf_i][leaf_j] = adj[leaf_j][leaf_i] = 1
                return adj
            
            def check_condition(adj):
                n = len(adj)
                for u in range(n):
                    found = False
                    for v in range(n):
                        if adj[u][v]:
                            # check common neighbor
                            common = False
                            for w in range(n):
                                if w!=u and w!=v and adj[u][w] and adj[v][w]:
                                    common = True
                                    break
                            if not common:
                                found = True
                                break
                    if not found:
                        return False
                return True
            
            adj = construct_graph()
            print(check_condition(adj))
            
