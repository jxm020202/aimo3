            import itertools
            
            def max_edges_bruteforce(n):
                # enumerate all graphs via edge bitmask
                max_e = -1
                best = None
                vertices = list(range(n))
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                for mask in range(1<<m):
                    # compute adjacency matrix
                    adj = [[0]*n for _ in range(n)]
                    edge_count = 0
                    for idx, (i,j) in enumerate(edges):
                        if mask>>idx & 1:
                            adj[i][j] = adj[j][i] = 1
                            edge_count += 1
                    # check condition
                    ok = True
                    for u in range(n):
                        found = False
                        for v in range(n):
                            if adj[u][v]:
                                # check no common neighbor
                                common = False
                                for w in range(n):
                                    if w!=u and w!=v and adj[u][w] and adj[v][w]:
                                        common = True
                                        break
                                if not common:
                                    found = True
                                    break
                        if not found:
                            ok = False
                            break
                    if ok and edge_count > max_e:
                        max_e = edge_count
                        best = mask
                return max_e
            
            def max_edges_model(n):
                best = -1
                bestk = None
                for k in range(1, n//2 + 1):
                    m = n - k
                    t = n - 2*k
                    if t < 0: continue
                    q = t // k
                    r = t - k * q
                    sum_b_sq = k * q * q + r * (2 * q + 1)
                    sum_a_sq = k + 2 * t + sum_b_sq
                    E = k*(k-1)//2 + m + (m*m - sum_a_sq)//2
                    if E > best:
                        best = E
                        bestk = k
                return best, bestk
            
            for n in range(2,9):
                brute = max_edges_bruteforce(n)
                model, k = max_edges_model(n)
                print(n, brute, model, k)
            
