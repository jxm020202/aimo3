            def min_f(n, M):
                best = None
                best_seq = None
                def backtrack(idx, prev, seq):
                    nonlocal best, best_seq
                    if idx == n:
                        # compute f
                        a = seq
                        f = sum(x*x for x in a) - sum(a[i]*a[i+2] for i in range(n-2))
                        if best is None or f < best:
                            best = f
                            best_seq = a[:]
                        return
                    # Determine allowed range
                    low = prev
                    high = M
                    # If this is the last index, must be M
                    if idx == n-1:
                        low = high = M
                    for val in range(low, high+1):
                        seq.append(val)
                        backtrack(idx+1, val, seq)
                        seq.pop()
                backtrack(1, 1, [1])
                return best, best_seq
            
            for n,M in [(5,3),(5,4),(7,4),(7,5)]:
                best, seq = min_f(n,M)
                print(n,M,best,seq)
            
