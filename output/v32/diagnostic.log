                cycles_e=get_cycles(core_pred_e, core_e)
                # sort cycles by length
                cycles_h.sort(key=len)
                cycles_e.sort(key=len)
                # map cycles of same length
                f={}
                for cyc_h, cyc_e in zip(cycles_h, cycles_e):
                    if len(cyc_h)!=len(cyc_e):
                        raise ValueError("cycle length mismatch")
                    # map elements in order
                    for a,b in zip(cyc_h, cyc_e):
                        f[a]=b
                # Now map leaf nodes: each leaf node maps to the leaf child of its image's core node.
                # For each leaf node x (indeg_h[x-1]==0), its image y = h_map[x]
                # We have already assigned f(y) (core node). Need to assign f(x) as a leaf child of f(y) that hasn't been used yet.
                # For each core node c in core_h, there are d-1 leaf children (here d=2, so exactly 1 leaf child).
