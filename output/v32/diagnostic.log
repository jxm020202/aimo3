            def feasible(counts):
                # counts: tuple of three ints (c0,c1,c2)
                c0,c1,c2 = counts
                assigned = c0+c1+c2
                r = 3 - assigned
                for a,b,d in target_perms:
                    if a>=c0 and b>=c1 and d>=c2:
                        # also need that total added = r, but that's automatic because sum targets=3
                        # ensure that we don't need to add negative
                        return True
                return False
            
            # We'll store for each vertex the current counts as a tuple (c0,c1,c2)
