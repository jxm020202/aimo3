            def hypercube_edges(n):
                edges = {}
                for v in range(1<<n):
                    edges[v] = []
                    for i in range(n):
                        w = v ^ (1<<i)
                        edges[v].append((w,i))
                return edges
            
            def all_hamiltonian_paths(n, max_paths=10000):
                edges = hypercube_edges(n)
                start = 0
                visited = [False]*(1<<n)
                path = [start]
                visited[start]=True
                results=[]
                def dfs(v):
                    if len(path)==(1<<n):
                        results.append(list(path))
                        return
                    for w,i in edges[v]:
                        if not visited[w]:
                            visited[w]=True
                            path.append(w)
                            dfs(w)
                            path.pop()
                            visited[w]=False
                            if len(results)>=max_paths:
                                return
                dfs(start)
                return results
            
            def flip_counts(path):
                # compute counts of bit flips between consecutive vertices
                counts=[0]*len(bin(path[0])) # placeholder
                n = max(path).bit_length()
                counts=[0]*n
                for a,b in zip(path, path[1:]):
                    diff = a ^ b
                    i = diff.bit_length()-1
                    counts[i]+=1
                return tuple(counts)
            
            def enumerate_counts(n, max_paths=2000):
                paths = all_hamiltonian_paths(n, max_paths)
                cnts=set()
                for p in paths:
                    cnts.add(flip_counts(p))
                return cnts
            
            for n in range(2,5):
                cnts=enumerate_counts(n, max_paths=2000)
                print(n, len(cnts))
            
