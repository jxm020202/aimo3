            def min_average(n):
                edges = list(itertools.combinations(range(n),2))
                m = len(edges)
                # variable order: for each edge, three binaries a,b,c
                var_count = 3*m
                # objective coefficients
                c = np.zeros(var_count, dtype=int)
                for i in range(m):
                    c[3*i] = 1   # a (label1)
                    c[3*i+1] = 2 # b (label2)
                    c[3*i+2] = 3 # c (label3)
                # constraints
                A = []
                b = []
                # each edge exactly one label
                for i in range(m):
                    row = np.zeros(var_count, dtype=int)
                    row[3*i:3*i+3] = 1
                    A.append(row)
                    b.append(1)
                # triangle constraints
                # map edge index
                edge_index = {e:i for i,e in enumerate(edges)}
                for tri in itertools.combinations(range(n),3):
                    i,j,k = tri
                    e1 = tuple(sorted((i,j)))
                    e2 = tuple(sorted((i,k)))
                    e3 = tuple(sorted((j,k)))
                    idx1 = edge_index[e1]
                    idx2 = edge_index[e2]
                    idx3 = edge_index[e3]
                    # sum of labels >=5 => (a+2b+3c) >=5
                    row = np.zeros(var_count, dtype=int)
                    # for each edge, add coefficients
                    for idx in (idx1, idx2, idx3):
                        row[3*idx] = 1
                        row[3*idx+1] = 2
                        row[3*idx+2] = 3
                    A.append(-row)  # -sum <= -5
                    b.append(-5)
                A = np.array(A, dtype=int)
                b = np.array(b, dtype=int)
                # bounds: binary 0-1
                bounds = Bounds(0,1)
                integrality = np.ones(var_count, dtype=int)
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf*np.ones_like(b), b), bounds=bounds,
                           integrality=integrality, options={'presolve':True})
                if not res.success:
                    print("failed")
                    return None
                total = sum(c[i]*res.x[i] for i in range(var_count))
                avg = total / m
                return avg, total, m, res.x
            
            for n in range(3,8):
                avg,total,m,_ = min_average(n)
                print(n, avg, total, m)
            
