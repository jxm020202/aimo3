            def intersection_polygon(constraints):
                # constraints: list of (a,b,c) meaning a*x + b*y <= c
                # returns list of vertices of convex polygon (may be empty)
                pts = []
                n = len(constraints)
                for i in range(n):
                    a1,b1,c1 = constraints[i]
                    for j in range(i+1, n):
                        a2,b2,c2 = constraints[j]
                        det = a1*b2 - a2*b1
                        if abs(det) < 1e-12:
                            continue
                        x = (c1*b2 - c2*b1)/det
                        y = (a1*c2 - a2*c1)/det
                        # check all constraints
                        ok = True
                        for a,b,c in constraints:
                            if a*x + b*y - c > 1e-9:
                                ok = False
                                break
                        if ok:
                            pts.append((x,y))
                # also consider vertices that are intersections of a line with a boundary at infinity? Not needed.
                # Remove duplicates
                uniq = []
                for p in pts:
                    if not any(math.hypot(p[0]-q[0], p[1]-q[1]) < 1e-8 for q in uniq):
                        uniq.append(p)
                if not uniq:
                    return []
                # compute convex hull (since region convex)
                # Use Graham scan via sorting by angle around centroid
                cx = sum(p[0] for p in uniq)/len(uniq)
                cy = sum(p[1] for p in uniq)/len(uniq)
                uniq.sort(key=lambda p: math.atan2(p[1]-cy, p[0]-cx))
                return uniq
            
