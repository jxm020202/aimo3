            def random_point_general():
                # generate random nonnegative numbers? Real numbers can be negative too.
                # Let's allow negative numbers as well.
                # generate 9 random numbers from normal distribution, sort, shift to sum 1.
                a = np.random.randn(9)
                a = np.sort(a)
                # shift to make sum 1: add constant t to each? Actually adding constant changes ordering but keeps sorted.
                # We can just scale to sum 1: multiply by factor 1/total.
                # But if total is zero or negative, scaling flips sign; we can shift then scale.
                # Simpler: generate random numbers from exponential (nonnegative) to ensure sum positive.
                a = np.random.exponential(scale=1.0, size=9)
                a = np.sort(a)
                a = a / np.sum(a)
                return a
            
