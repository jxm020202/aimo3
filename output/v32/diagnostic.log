            def feasible(S, total=1997, n=38):
                # n=38 numbers
                for t in range(0, n-1):  # t numbers before the jump, a_{t+1} is the jump element
                    r = (n-1) - t  # number of elements after a_{t+1}
                    # a must be at least t+1
                    # also a must be such that minimal tail sum fits within total
                    # minimal sum of a_{t+1}..a_n is (r+1)*a + r(r+1)/2
                    # So we need (r+1)*a + r(r+1)/2 <= total
                    # => a <= (total - r(r+1)/2) // (r+1)
                    max_a = (total - r*(r+1)//2) // (r+1)
                    # also a must be positive
                    for a in range(t+1, max_a+1):
                        # lower bound for P
                        lowerP = t*(t+1)//2  # minimal sum of t numbers < a
                        # also need P >= total - S - a (since P + a >= total - S)
                        lowerP = max(lowerP, total - S - a, 0)
                        # upper bound for P
                        upperP = t*a - t*(t+1)//2  # maximal sum of t numbers < a
                        # also P <= S
                        upperP = min(upperP, S)
                        # also tail condition: P <= total - ((r+1)*a + r(r+1)/2)
                        upperP = min(upperP, total - ((r+1)*a + r*(r+1)//2))
                        if lowerP <= upperP:
                            # feasible
                            # we could also construct actual sequence but not needed
                            return True, (t, a, lowerP, upperP)
                return False, None
            
            # test for some S values
            for S in range(0, 1000):
                ok, info = feasible(S)
                if ok:
                    print("minimal S", S, "info", info)
                    break
