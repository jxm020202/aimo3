                v_edges = {v: [] for v in verts}
                for idx,(u,v) in enumerate(edge_list):
                    v_edges[u].append(idx)
                    v_edges[v].append(idx)
                # initial factors per vertex
                factors = []
                for v in verts:
                    vars_v = tuple(v_edges[v])
                    table = {}
                    for colors in itertools.product(range(3), repeat=3):
                        if len(set(colors)) == 2:
                            table[colors] = 1
                    factors.append((vars_v, table))
                # elimination order
                L = nx.line_graph(nx.complete_graph(4))
                order = min_fill_ordering(L)
                for var in order:
