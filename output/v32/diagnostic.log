        >>> Code:
            # Build constraints
            num_vars = len(edges)
            A = []
            ub = []
            lb = []  # all constraints are <=, so we only need ub; but milp expects both lb and ub arrays for LinearConstraint
            
            # Square constraints
            for i in range(16):
                for j in range(16):
                    idx_ne = edge_index[('NE',i,j)]
                    idx_se = edge_index[('SE',i,j)]
                    row = np.zeros(num_vars, dtype=int)
                    row[idx_ne] = 1
                    row[idx_se] = 1
                    A.append(row)
                    ub.append(1)
                    lb.append(-np.inf)  # no lower bound
            
            # Pair constraints
            def squared_dist(p,q):
                return (p[0]-q[0])**2 + (p[1]-q[1])**2
            
            pair_count = 0
            for i1 in range(num_vars):
                e1 = edges[i1]
                end1 = e1['end']
                start1 = e1['start']
                for i2 in range(i1+1, num_vars):
                    e2 = edges[i2]
                    end2 = e2['end']
                    start2 = e2['start']
                    # Check if distance between ends <2
                    if squared_dist(end1, end2) < 4:  # <4 means distance <2
                        # Check if end1 == start2 or end2 == start1
                        if not (end1 == start2 or end2 == start1):
                            # then cannot both be selected
                            row = np.zeros(num_vars, dtype=int)
                            row[i1] = 1
                            row[i2] = 1
                            A.append(row)
                            ub.append(1)
                            lb.append(-np.inf)
                            pair_count += 1
            
            pair_count
            
