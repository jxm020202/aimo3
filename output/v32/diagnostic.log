            from scipy.optimize import milp, LinearConstraint, Bounds
            def min_average(n):
                # edges indexed by (i,j) with i<j
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # binary variables for each edge label: we can use integer variable taking values 1,2,3 directly?
                # milp supports integer variables with bounds. We can set variable x_e integer in [1,3].
                # constraints: x_e >=1, x_e <=3, integer.
                # triangle constraints: sum >=5.
                # objective: minimize sum x_e.
                c = np.ones(m)  # objective coefficients
                # bounds for each variable: integer between 1 and 3
                bounds = Bounds(np.ones(m), 3*np.ones(m))
                # integrality vector: all variables integer
                integrality = np.ones(m, dtype=int)
                # triangle constraints: for each triangle (i,j,k)
                A = []
                b = []
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            # edges indices
                            idx_ij = edges.index((i,j))
                            idx_ik = edges.index((i,k))
                            idx_jk = edges.index((j,k))
                            row = np.zeros(m)
                            row[idx_ij] = 1
                            row[idx_ik] = 1
                            row[idx_jk] = 1
                            A.append(row)
                            b.append(5)
                A = np.array(A)
                b = np.array(b)
                # LinearConstraint: A @ x >= b
                lc = LinearConstraint(A, b, np.full_like(b, np.inf))
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("failed", res.message)
                    return None
                total = res.fun
                avg = total / (n*(n-1)/2)
                return total, avg, res.x
            
            print(min_average(5))
            
