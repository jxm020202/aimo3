            def max_match_parity(n, parity):
                # parity 0 for even sum (white), 1 for odd sum (black)
                left_vals = list(range(-(n-1), n))
                right_vals = list(range(2, 2*n+1))
                left_index = {v:i for i,v in enumerate(left_vals)}
                right_index = {v:i for i,v in enumerate(right_vals)}
                import networkx as nx
                G=nx.Graph()
                for i in range(1,n+1):
                    for j in range(1,n+1):
                        if (i+j)%2==parity:
                            l=left_index[i-j]
                            r=right_index[i+j]
                            G.add_edge(('L',l), ('R',r))
                matching=nx.algorithms.bipartite.maximum_matching(G, top_nodes=[('L',i) for i in range(len(left_vals))])
                size=len(matching)//2
                return size
            print(max_match_parity(13,0), max_match_parity(13,1))
            
