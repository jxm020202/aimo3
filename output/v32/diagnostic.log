            def construct_f(n, a=866):
                info=graph_info(n, a)
                A=info['A']; B=info['B']
                coreA=info['coreA']; coreB=info['coreB']
                # Build list of core nodes with leaf count
                leaf_counts_A = {}
                for v in coreA:
                    leaf_counts_A[v] = info['indegA'][v]-1
                leaf_counts_B = {}
                for v in coreB:
                    leaf_counts_B[v] = info['indegB'][v]-1
                # Group core nodes by leaf count
                from collections import defaultdict
                groupsA=defaultdict(list)
                groupsB=defaultdict(list)
                for v,cnt in leaf_counts_A.items():
                    groupsA[cnt].append(v)
                for v,cnt in leaf_counts_B.items():
                    groupsB[cnt].append(v)
                # Check multiset equality
                for cnt in groupsA:
                    if len(groupsA[cnt]) != len(groupsB.get(cnt, [])):
                        return None
                # Build mapping for core nodes
                f_core={}
                for cnt, nodesA in groupsA.items():
                    nodesB = groupsB[cnt]
                    # arbitrary bijection
                    for vA, vB in zip(nodesA, nodesB):
                        f_core[vA]=vB
                # Now map leaves
                f = [None]*n
                # assign core nodes
                for vA, vB in f_core.items():
                    f[vA]=vB
                # For each leaf u (non-core), its image under A is vA (core)
                # Need to assign a leaf w (non-core) such that B[w] = f[vA]
                # Build list of leaf nodes in B grouped by their image
                leavesB_by_target=defaultdict(list)
                for w in range(n):
                    if w not in coreB:
                        target = B[w]
                        leavesB_by_target[target].append(w)
                # For each core node vA, get list of leaf predecessors in A
                leavesA_by_target=defaultdict(list)
                for u in range(n):
                    if u not in coreA:
                        target = A[u]
                        leavesA_by_target[target].append(u)
                # Now assign leaves
                for vA in coreA:
                    targetB = f_core[vA]
                    leavesA = leavesA_by_target[vA]
                    leavesB = leavesB_by_target[targetB]
                    if len(leavesA)!=len(leavesB):
                        return None
                    for u, w in zip(leavesA, leavesB):
                        f[u]=w
                # Verify bijection
                if None in f:
                    return None
                if len(set(f))!=n:
                    return None
                # Verify condition
                for x in range(n):
                    y = A[x]
                    if f[y] != B[f[x]]:
                        print("fail at", x)
                        return None
                return f
            
            # test for n=876
            f876 = construct_f(876)
            print(f876 is not None)
            
