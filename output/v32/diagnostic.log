            def test_rs(rs, d):
                # compute counts of dth roots of unity
                import cmath, math
                roots = [cmath.exp(2j*math.pi*k/d) for k in range(d)]
                # map each product to nearest root (since may be rounding)
                counts = [0]*d
                for p in subset_products(rs):
                    # find k such that p is close to root
                    # compute argument modulo 2π
                    arg = cmath.phase(p) % (2*math.pi)
                    # round to nearest k/d
                    k = round(arg * d / (2*math.pi)) % d
                    # verify closeness
                    if abs(p - roots[k]) > 1e-6:
                        # not a root of unity
