            import random, math, numpy as np
            
            def intersect_area(theta, shift=(1,0), N=2000000):
                # Monte Carlo estimate of area of intersection of S and S+shift
                cos, sin = math.cos(theta), math.sin(theta)
                # generate points uniformly in bounding box covering both squares
                # bounding box size: w+1 maybe
                w = abs(math.cos(theta)) + abs(math.sin(theta))
                # bounding box from -w/2-1 to w/2 maybe
                L = w/2 + 1
                xs = np.random.uniform(-L, L, N)
                ys = np.random.uniform(-L, L, N)
                # check if point in S
                # transform back: rotate by -theta and check within [-0.5,0.5]^2
                xr = xs * cos + ys * sin
                yr = -xs * sin + ys * cos
                in_S = (np.abs(xr) <= 0.5) & (np.abs(yr) <= 0.5)
                # check if point in S shifted by shift
                xs2 = xs - shift[0]
                ys2 = ys - shift[1]
                xr2 = xs2 * cos + ys2 * sin
                yr2 = -xs2 * sin + ys2 * cos
                in_S2 = (np.abs(xr2) <= 0.5) & (np.abs(yr2) <= 0.5)
                in_both = in_S & in_S2
                # area of bounding box
                area_box = (2*L)*(2*L)
                return np.mean(in_both) * area_box
            
            theta = math.pi/4
            print(intersect_area(theta, shift=(1,0), N=500000))
            
