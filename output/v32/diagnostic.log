            import itertools, math, sys, time, numpy as np, math, random, collections, itertools, sys, math
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_e_minus_p_ilp(n):
                # Map edge (i,j) to index
                edge_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1,n):
                        edge_index[(i,j)] = idx
                        idx += 1
                m = idx  # number of edges
                # variables: x_e (binary) for edges (label 1), y_{ij} (binary) for pairs with common neighbor
                # We'll also need z_{ijk} binary for each triple (i,j,k) where i<j, k distinct.
                # But we can avoid z by using constraints: y_{ij} >= x_{ik}+x_{jk}-1 for each k.
                # This ensures if both edges present, y_{ij}=1 (or at least >=1). Since y binary, must be 1.
                # However we also need y_{ij}=0 if no common neighbor. The constraints above don't prevent y=1 when no common neighbor.
                # To avoid that, we can minimize objective sum x - sum y, so solver will set y=0 unless forced to 1.
                # Since objective penalizes y (negative coefficient), solver will set y to 0 unless needed.
                # So we can just use constraints y_{ij} >= x_{ik}+x_{jk}-1 for all k.
                # Also need triangle-free: for each triple i<j<k, x_{ij}+x_{ik}+x_{jk} <= 2.
                # Variables count: x: m, y: N = C(n,2) same as m, total 2m ~ n(n-1). For n up to 9, fine.
                # Build constraints matrices
                num_vars = 2*m
                # variable ordering: first x edges, then y pairs (same order as edges)
                # Build A_ub and b_ub for inequalities.
                A = []
                b = []
                # triangle constraints
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            row = np.zeros(num_vars)
                            row[edge_index[(i,j)]] = 1
                            row[edge_index[(i,k)]] = 1
                            row[edge_index[(j,k)]] = 1
                            A.append(row)
                            b.append(2)
                # y >= xik + xjk -1 => -y + xik + xjk >= -1 => multiply by -1? Use A_ub format: A_ub * x <= b_ub
                # Convert inequality: -y + xik + xjk >= -1 => multiply by -1: y - xik - xjk <= 1
                # So row: y_{ij} coefficient 1, x_{ik} -1, x_{jk} -1, others 0; RHS = 1
                for i in range(n):
                    for j in range(i+1,n):
                        y_idx = m + edge_index[(i,j)]
                        for k in range(n):
                            if k==i or k==j:
                                continue
                            # ensure ordering of edge indices: (min,max)
                            ik = (i,k) if i<k else (k,i)
                            jk = (j,k) if j<k else (k,j)
                            row = np.zeros(num_vars)
                            row[y_idx] = 1
                            row[edge_index[ik]] = -1
                            row[edge_index[jk]] = -1
                            A.append(row)
                            b.append(1)
                A = np.array(A)
                b = np.array(b)
                # bounds: all variables binary 0-1
                bounds = Bounds(0, 1)
                # objective: maximize e - p = sum x - sum y
                c = np.concatenate([np.ones(m), -np.ones(m)])  # maximize c^T x
                # scipy milp solves minimization, so we minimize -c^T x
                res = milp(c=-c, constraints=LinearConstraint(A, -np.inf*np.ones_like(b), b), bounds=bounds, integrality=np.ones(num_vars))
                if not res.success:
                    print("failed")
                    return None
                x = res.x[:m]
                y = res.x[m:]
                e = int(round(x.sum()))
                p = int(round(y.sum()))
                return e - p, (e,p)
            
            for n in range(3,9):
                val = max_e_minus_p_ilp(n)
                print(n, val)
            
