                inside = (np.abs(xs*c + ys*s) <= 0.25) & (np.abs(-xs*s + ys*c) <= 0.25)
                total_inside = np.count_nonzero(inside)
                first_quad = np.count_nonzero(inside & (xs>=0) & (ys>=0))
