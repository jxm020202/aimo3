            def intersect_AB(theta):
                c = math.cos(theta)
                s = math.sin(theta)
                A = np.array([[c, s], [-s, c]])
                b = np.array([0.5, 0.5 + c])
                return np.linalg.solve(A, b)
            
            def intersect_BC(theta):
                c = math.cos(theta)
                s = math.sin(theta)
                # B: -x s + y c = 0.5 + c
                # C: -x c - y s = 0.5 - c - s
                A = np.array([[-s, c], [-c, -s]])
                b = np.array([0.5 + c, 0.5 - c - s])
                return np.linalg.solve(A, b)
            
            def intersect_CA(theta):
                c = math.cos(theta)
                s = math.sin(theta)
                # C: -x c - y s = 0.5 - c - s
                # A: x c + y s = 0.5
                A = np.array([[-c, -s], [c, s]])
                b = np.array([0.5 - c - s, 0.5])
                return np.linalg.solve(A, b)
            
            for th in [0.1, 0.3, 0.6, 0.78]:
                print(th, intersect_AB(th), intersect_BC(th), intersect_CA(th))
            
