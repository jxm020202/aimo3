            import sympy as sp
            
            def f_brutal(N):
                S = N-1
                best = None
                best_pair = None
                for a in range(2, S):
                    b = S - a
                    if b <= a: continue  # ensure a<b distinct
                    # compute lcm
                    l = sp.ilcm(a,b)
                    if best is None or l < best:
                        best = l
                        best_pair = (a,b)
                return best, best_pair
            
            def f_formula(N):
                S = N-1
                p = sp.factorint(S)
                # smallest prime factor
                spf = min(p.keys())
                return S - spf
            
            def test(limit):
                for N in range(6, limit+1):
                    bf, pair = f_brutal(N)
                    ff = f_formula(N)
                    if bf != ff:
                        print(N, bf, ff, pair)
                        break
                else:
                    print("All equal up to", limit)
            
            test(200)
            
