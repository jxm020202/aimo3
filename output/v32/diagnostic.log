            def A_of_n(n):
                # compute product of d_{a_i} for base-5 digits
                prod = 1
                while n>0:
                    a = n%5
                    # d values
                    if a==0 or a==1:
                        d=1
                    elif a==2:
                        d=2
                    elif a==3:
                        d=6
                    elif a==4:
                        d=4
                    prod = (prod * d) % 10
