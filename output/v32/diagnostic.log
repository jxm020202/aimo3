        def simple_divisors(n):
    divs = set()
    for i in range(1, int(math.isqrt(n))+1):
        if n % i == 0:
            divs.add(i)
            divs.add(n//i)
    return divs

def generate_S_simple(limit=30):
    S_set=set()
    for x in range(1, limit+1):
        for y in range(x, limit+1):
            for z in range(y, limit+1):
                s=x+y+z
                if s%2: continue
                sum3=s//2
                product=x*y*z
                for d in simple_divisors(product):
                    if d>=3456 and d>sum3:
                        S_set.add(d)
    return sorted(S_set)

