            import numpy as np, random, math, itertools, sys, math, collections, fractions, functools, decimal, statistics, hashlib, os, json, typing, fractions
            from scipy.optimize import linprog
            
            def origin_inside_lp(points):
                # Solve for w >=0, sum w =1, sum w * p = 0
                # Variables: w_i for i=0..n-1
                n=len(points)
                A_eq = np.zeros((3,n))
                # sum w = 1
                A_eq[0,:] = 1
                # sum w * x_i = 0
                A_eq[1,:] = [p[0] for p in points]
                # sum w * y_i = 0
                A_eq[2,:] = [p[1] for p in points]
                b_eq = np.array([1,0,0])
                # Objective can be zero
                c = np.zeros(n)
                res = linprog(c, A_eq=A_eq, b_eq=b_eq, bounds=[(0,None)]*n, method='highs')
                return res.success
            
            def trial_lp(N=20000):
                cnt=0
                for _ in range(N):
                    pts=[random_point_in_disk() for __ in range(10)]
                    if not origin_inside_lp(pts):
                        cnt+=1
                return cnt/N
            
            print(trial_lp(20000))
            
