            def max_E_pr(p, r):
                q = 9 - p - r
                a, c = sp.symbols('a c')
                b = (1 - p*a - r*c)/q
                A = p*(b - a) + r*(c - b)
                C = p*a**2 + q*b**2 + r*c**2
                E = sp.simplify(A**2 * (9*C - 1) / C**3)
                # candidate list
                candidates = []
                # interior critical points: solve gradient zero
                dEa = sp.diff(E, a)
                dEc = sp.diff(E, c)
                # Use multiple starting points
                sols = set()
                for start in [(-0.2,0.2), (-0.1,0.3), (-0.3,0.4), (-0.5,0.6), (-0.05,0.1), (-0.05,0.3), (0.0,0.2), (0.0,0.5), (-0.2,0.5)]:
                    try:
                        sol = sp.nsolve([dEa, dEc], [a, c], start, tol=1e-14, maxsteps=100)
                        sol = (float(sol[0]), float(sol[1]))
                        sols.add((round(sol[0],12), round(sol[1],12)))
                    except Exception as e:
                        pass
                for (aa, cc) in sols:
                    bb = (1 - p*aa - r*cc)/q
                    if aa <= bb <= cc:
