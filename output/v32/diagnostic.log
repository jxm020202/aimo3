            from scipy.optimize import minimize, Bounds, LinearConstraint, NonlinearConstraint
            
            def objective(v):
                return v[5]
            
            def sphere_eq(v):
                return v[0]**2 + v[1]**2 + v[2]**2 - 1
            
            def plane_eq(v):
                x,y = v[3], v[4]
                z = 6 - 3*x - 1.5*y
                return 6*x + 3*y + 2*z - 12
            
            # Nonlinear constraints
            nlc1 = NonlinearConstraint(sphere_eq, 0, 0)  # equality
            nlc2 = NonlinearConstraint(plane_eq, 0, 0)   # equality
            
            # Linear inequality constraints: we can use LinearConstraint
            # Variables order: [x1,y1,z1,x,y,t]
            # Build A matrix for inequalities A @ v <= b
            A = []
            b = []
            # x >= 0 -> -x <= 0
            A.append([-0, -0, -0, -1, 0, 0])
            b.append(0)
