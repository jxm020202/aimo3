                # We'll compute minimal w·s for each possible S in allowed interval (including possibly fractional via adjusting one variable).
                w_sorted = sorted(w, reverse=True)  # descending
                # Precompute prefix sums
                prefix = [0]
                for val in w_sorted:
                    prefix.append(prefix[-1]+val)
                total_w = sum(w_sorted)
                best = None
                # Allowed S interval
                lower = (b - a) - 1
                upper = (b - a) + 1
                # Since S must be integer of same parity as 11 (odd) if all s_i are +/-1. But we can also adjust one variable fractionally to achieve any S within +/-1 of integer.
                # We'll consider k from 0..11
                for k in range(0,12):
                    S = 2*k - 11
                    if S < lower - 1e-9 or S > upper + 1e-9:
                        continue
                    # compute w·s with +1 assigned to smallest k w_i (i.e., the last k in descending list)
                    # Since w_sorted descending, smallest k are the last k elements.
                    sum_smallest_k = sum(w_sorted[-k:]) if k>0 else 0
                    sum_largest = total_w - sum_smallest_k
                    # w·s = (+1)*sum_smallest_k + (-1)*sum_largest = sum_smallest_k - sum_largest
                    obj = sum_smallest_k - sum_largest
                    # If S not exactly matching, we could adjust one variable fractionally, which would affect objective proportionally.
                    # But for now treat exact.
                    if best is None or obj < best:
                        best = obj
                # If best still None, maybe need fractional assignment. We'll use linear programming via scipy for safety.
                if best is None:
                    # fallback to linear programming
                    from scipy.optimize import linprog
                    c = w.astype(float)
                    A_eq = np.ones((1,12))
                    b_eq = np.array([b-a])
                    bounds = [(-1,1)]*12
                    res = linprog(c, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
                    best = res.fun
                # interior sum = 11*a + best
                return 11*a + best
            
