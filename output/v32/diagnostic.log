            def f_bruteforce_limit(N, maxL=None):
                # compute f(N) by enumerating triples and lcm
                best = None
                for a in range(1, N-1):
                    for b in range(a+1, N):
                        c = N - a - b
                        if c <= b:
                            continue
                        l = sp.ilcm(a,b,c)
                        if best is None or l < best:
                            best = l
                return best
            
            def f_bruteforce_by_L(N):
                # compute minimal L such that N is sum of three distinct divisors of L
                bestL = None
                bestTrip = None
                for L in range(1, N+1):
                    # get divisors of L
                    divs = sp.divisors(L)
                    # need three distinct
                    for a_idx in range(len(divs)):
                        a = divs[a_idx]
                        for b_idx in range(a_idx+1, len(divs)):
                            b = divs[b_idx]
                            c = N - a - b
                            if c <= b:
                                continue
                            if c in divs and c != a and c != b:
                                # found representation
                                bestL = L
                                bestTrip = (a,b,c)
                                return L, bestTrip
                return None, None
            
            def f_bruteforce_by_L_brutal(N):
                # just compute f(N) via lcm
                return f_bruteforce_limit(N)
            
            def test_M_c(M):
                results = {}
                for c in range(0, 30):
                    N = M + c
                    fN = f_bruteforce_limit(N)
                    results[c] = fN
                return results
            
            for M in [27, 81, 243]:
                print("M=",M)
                res = test_M_c(M)
                for c in range(0, 10):
                    print(c, M+c, res[c])
            
