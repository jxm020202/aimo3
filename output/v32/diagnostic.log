            def f_exact_rational(p,q):
                # compute parity sequence a_n = 1 if floor(n*p/q) even else 0
                # we need to compute infinite sum sum a_n/2^n
                # Since sequence is eventually periodic with period q (maybe 2q)
                # We'll compute first 2q terms and find period after some prefix.
                N = 2*q+10
                a = [1 if ( (n*p)//q )%2==0 else 0 for n in range(1,N+1)]
                # find minimal period after some preperiod (maybe 0)
                # We'll try to find period p_len such that for all i from start to N-p_len, a[i]==a[i+p_len]
                # Since sequence should be purely periodic from start (since floor(n p/q) depends only on n mod q)
                # Actually floor(n p/q) = floor((n mod q)*p/q + floor(n/q)*p)?? Might be periodic with period q.
                # Let's just assume period q.
                period = q
                # verify
                ok = all(a[i]==a[i+period] for i in range(N-period))
                if not ok:
                    # try 2q
                    period = 2*q
                    ok = all(a[i]==a[i+period] for i in range(N-period))
                    if not ok:
                        # fallback: find period by brute force
                        for per in range(1, N//2):
                            if all(a[i]==a[i+per] for i in range(N-per)):
                                period=per
                                break
                # Now compute infinite sum using periodic binary expansion.
                # The binary expansion repeats every period bits after some initial offset (maybe 0).
                # Since we assume pure periodic from start, we can compute sum = sum_{k=0}^\infty sum_{i=1}^{period} a_i / 2^{i + k*period}
                # = (sum_{i=1}^{period} a_i / 2^i) * (1 + 1/2^{period} + 1/2^{2*period}+ ...) = S * 1/(1 - 1/2^{period})
                S = sum(Fraction(a[i], 2**(i+1)) for i in range(period))  # i index 0->a1 corresponds to n=1 weight 1/2^1
                total = S * Fraction(1, 1 - Fraction(1, 2**period))
                return total
            
            def min_f_rational(max_q):
                min_f = Fraction(1,1)
                min_x = None
                for q in range(1, max_q+1):
                    for p in range(0,q):
                        f_val = f_exact_rational(p,q)
                        if f_val < min_f:
                            min_f = f_val
                            min_x = Fraction(p,q)
                return min_x, min_f
            
