                from scipy.optimize import milp, LinearConstraint, Bounds
                import numpy as np
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(pairs)
                edge_idx = {}
                for idx,(i,j) in enumerate(pairs):
                    edge_idx[(i,j)] = idx
                    edge_idx[(j,i)] = idx
                # w variables ordered
                w_idx = {}
                idx_counter = m
                for i in range(n):
                    for j in range(n):
                        if i==j: continue
                        w_idx[(i,j)] = idx_counter
                        idx_counter += 1
                total_vars = idx_counter
                c = np.zeros(total_vars)
                c[:m] = -1  # maximize edges
                bounds = Bounds(0,1)
                A = []
                b = []
                # w <= x
                for i in range(n):
                    for j in range(n):
                        if i==j: continue
                        row = np.zeros(total_vars)
                        row[w_idx[(i,j)]] = 1
                        row[edge_idx[(i,j)]] = -1
                        A.append(row); b.append(0)
                # each vertex at least one private edge
                for i in range(n):
                    row = np.zeros(total_vars)
                    for j in range(n):
                        if i==j: continue
                        row[w_idx[(i,j)]] = -1
                    A.append(row); b.append(-1)
                # triangle condition
                for i in range(n):
                    for j in range(n):
                        if i==j: continue
                        for k in range(n):
                            if k==i or k==j: continue
                            row = np.zeros(total_vars)
                            row[w_idx[(i,j)]] = 1
                            row[edge_idx[(i,k)]] = 1
                            row[edge_idx[(j,k)]] = 1
                            A.append(row); b.append(2)
                A = np.array(A)
                b = np.array(b)
                lin_con = LinearConstraint(A, -np.inf*np.ones_like(b), b)
                integrality = np.ones(total_vars)
                res = milp(c, constraints=lin_con, integrality=integrality, bounds=bounds, options={'disp': False})
                if not res.success:
                    print("MILP failed")
                    return None
                edge_vals = np.rint(res.x[:m]).astype(int)
                adj=[[0]*n for _ in range(n)]
                for (i,j), idx in edge_idx.items():
                    if i<j:
                        adj[i][j]=adj[j][i]=edge_vals[idx]
                return adj
            
            adj10 = solve_milp(10)
            print(edge_count(adj10))
            print(condition_satisfied(adj10))
            
