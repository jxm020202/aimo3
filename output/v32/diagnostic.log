            def count_compositions(total, parts, max_part):
                count=0
                def rec(remaining, k):
                    nonlocal count
                    if k==1:
                        if 1 <= remaining <= max_part:
                            count+=1
                        return
                    for i in range(1, max_part+1):
                        if i < remaining - (parts-k)*max_part or i > remaining - (parts-k)*1:
                            continue
                        rec(remaining-i, k-1)
                rec(total, parts)
                return count
            
