            def works_for_n(n, g):
                # g is list of length n mapping x->g[x] (0-indexed)
                for k in range(101):
                    seen = [False]*n
                    for x in range(n):
                        val = (g[x] + k*x) % n
                        if seen[val]:
                            return False
                        seen[val] = True
                return True
            
            def random_test(n, trials=1000):
                for _ in range(trials):
                    perm = list(range(n))
                    random.shuffle(perm)
                    if works_for_n(n, perm):
                        return perm
                return None
            
            def find_smallest_composite(limit=500):
                for n in range(4, limit+1):
                    if sp.isprime(n):
                        continue
                    # quick test: maybe linear solution?
                    # try linear a
                    for a in range(1, n):
                        if math.gcd(a, n) != 1:
                            continue
                        ok = True
                        for k in range(101):
                            if math.gcd(a + k, n) != 1:
                                ok = False
                                break
                        if ok:
                            return n, ('linear', a)
                    # else random search
