        def find_S_range(minS, maxS, limit=200):
    good = set()
    for b in range(1, limit+1):
        for c in range(b, limit+1):
            for d in range(c, limit+1):
                sum3 = b + c + d
                for S in range(max(minS, sum3+1), maxS+1):
                    # compute F
                    F = b*b*c + b*c*c + b*b*d + b*d*d + c*c*d + c*d*d + 2*b*c*d
                    if F % S == 0:
                        good.add(S)
    return sorted(good)

