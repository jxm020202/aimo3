            def product_one_plus_subgroup(p, size):
                # find a subgroup of given size (dividing p-1)
                # we can generate using generator g of multiplicative group
                # find primitive root g
                # For simplicity, use sympy primitive_root
                import sympy as sp
                g = sp.primitive_root(p)
                # generate subgroup generated by g^{(p-1)//size}
                step = (p-1)//size
                H = [(g**(step*i)) % p for i in range(size)]
                # ensure exclude 0 (mod p)
                return product_one_plus(p, H)
            
            for p in [13]:
                for size in [1,2,3,4,6,12]:
