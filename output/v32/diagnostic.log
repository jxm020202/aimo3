            def pattern_match_S(n):
                m = n+1
                indeg_counts = collections.Counter()
                for a in range(1, n+1):
                    b = pow(a, 866, m)
                    if b == 0:
                        return False
                    indeg_counts[b] += 1
                # indeg_counts maps each b to its indegree (since we counted preimages)
                # Determine distinct indegree values
                indeg_vals = list(indeg_counts.values())
                # Some residues may have indegree 0 (not present in indeg_counts)
                zero_count = n - len(indeg_counts)
                # Determine d from n
                d = math.gcd(866, n)
                # Need exactly n/d residues with indegree d, and rest zero
                if zero_count != n - n//d:
                    return False
                # Check that all non-zero indegrees equal d
                if any(v != d for v in indeg_vals):
                    return False
                return True
            
            def find_n(limit):
                for n in range(866, limit+1):
                    if pattern_match_S(n):
                        return n
                return None
            
            print(find_n(5000))
            
