            def is_linear_perm(perm, n):
                # check if there exist a,b such that perm[x] = (a*x + b) mod n for all x
                # solve for a,b using first two points where x differ
                # find a = (perm[1]-perm[0]) * inv(1-0) mod n = (perm[1]-perm[0]) mod n
                a = (perm[1] - perm[0]) % n
                b = (perm[0] - a*0) % n
                for x in range(n):
                    if perm[x] != (a*x + b) % n:
                        return False
                return True
            
