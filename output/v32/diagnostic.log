            import itertools
            
            def can_rep_odd(n, max_bits=12):
                # search for representation using bits up to max_bits (i.e., 2**max_bits)
                # coefficients -1,0,1
                # brute force all combos? That's 3**max_bits huge; we need smarter.
                # Use BFS on signed binary representation maybe.
                # We'll just do recursion with pruning: try to represent n using bits up to max_bits.
                # Use DP: store reachable (value, parity) pairs.
                from collections import defaultdict
                reachable = {(0,0)}  # (value, parity of non-zero count mod 2)
                for j in range(max_bits):
                    power = 1<<j
                    newset = set()
                    for val,par in reachable:
                        # option 0
                        newset.add((val,par))
                        # option +1
                        newset.add((val+power, (par+1)%2))
                        # option -1
                        newset.add((val-power, (par+1)%2))
                    reachable = newset
                # after max_bits bits, check if (n,1) reachable
                return any(val==n and par==1 for val,par in reachable)
            
            def find_min(limit=200):
                for n in range(1,limit+1):
                    if not can_rep_odd(n, max_bits=12):
                        return n
                return None
            
            print(find_min(200))
            
