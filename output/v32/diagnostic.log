            def works_for_n(g, n):
                # g is list of length n representing permutation (values 0..n-1)
                for k in range(101):
                    images = [(g[x] + k*x) % n for x in range(n)]
                    if len(set(images)) != n:
                        return False
                return True
            
            def find_perm_bruteforce(n, limit=1000000):
                # try random permutations up to limit
                arr = list(range(n))
                for _ in range(limit):
                    random.shuffle(arr)
                    if works_for_n(arr, n):
                        return arr
                return None
            
