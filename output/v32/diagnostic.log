            def in_S_full(s):
                # returns True if there exist positive integers a,b,c,d satisfying condition
                # using representation with x,y,u,v
                # s >=4
                for x in range(2, s-1):
                    y = s - x
                    if y < 2:
                        continue
                    # compute residues set for v
                    residues = set()
                    # v must have same parity as y
                    start_v = 0 if (y%2==0) else 1
                    for v in range(start_v, y, 2):
                        residues.add((x * (v*v)) % (4*s))
                    # iterate u
                    start_u = 0 if (x%2==0) else 1
                    for u in range(start_u, x, 2):
                        target = (- y * (u*u)) % (4*s)
                        if target in residues:
                            # need to ensure that corresponding v < y (already ensured) and also that resulting a,b,c,d positive
                            # We can construct a,b,c,d to verify
                            # Find a v that yields target
                            for v in range(start_v, y, 2):
                                if (x * (v*v)) % (4*s) == target:
                                    # construct a,b,c,d
                                    a = (x + u)//2
                                    b = (x - u)//2
                                    c = (y + v)//2
                                    d = (y - v)//2
                                    if a>0 and b>0 and c>0 and d>0:
                                        # verify condition
                                        if (a+b+c+d)==s and (a*b*c + a*b*d + a*c*d + b*c*d) % s == 0:
                                            return True
                            # if not found maybe due to parity? but should be fine
                    # continue next x
                return False
            
            def test_range(lo, hi):
                lst=[]
                for s in range(lo, hi+1):
                    lst.append((s, in_S_full(s)))
                return lst
            
