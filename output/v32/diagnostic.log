            for u,v in decomp.edges():
                bag_adj[u].add(v)
                bag_adj[v].add(u)
            
            # Choose root arbitrarily, say first bag
            root = bag_nodes[0]
            
            # Build parent/children via BFS
            parent = {}
            order = []  # post-order list
            from collections import deque
            dq = deque([root])
            parent[root] = None
            bfs_order = []
            while dq:
                b = dq.popleft()
                bfs_order.append(b)
                for nb in bag_adj[b]:
                    if nb not in parent:
                        parent[nb] = b
                        dq.append(nb)
            # post-order (children before parent)
            order = bfs_order[::-1]
            
