            import numpy as np, math, random, itertools, sys, time, math, sympy as sp
            def E_val(a,c):
                b = 1 - 4*a - 4*c
                if not (a <= b <= c):
                    return -1
                S2 = 4*a*a + b*b + 4*c*c
                A2 = 16*(c-a)**2
                return A2 * (9*S2 - 1) / (S2**3)
            
            def search_grid(N=2001):
                maxE = -1
                best = None
                for a in np.linspace(-2,2,N):
                    # compute feasible c range from inequalities
                    # c >= (1 - 4a)/5
                    c_min = (1 - 4*a)/5
                    # also need 5a + 4c <= 1 => c <= (1 - 5a)/4
                    c_max = (1 - 5*a)/4
                    if c_min > c_max:
                        continue
                    # also need a <= c (maybe)
                    c_min = max(c_min, a)
                    # sample c
                    for c in np.linspace(c_min, c_max, N):
                        val = E_val(a,c)
                        if val > maxE:
                            maxE = val
                            best = (a,c,val)
                return maxE,best
            
