                    for e_idx, e in enumerate(edges):
                        if e['end'] == (x,y):
                            row[e_idx] = 1
                    if row.sum() > 0:
                        rows.append(row)
                        b.append(1)
            
            # Pairwise close-end constraints
            def squared_distance(p,q):
                return (p[0]-q[0])**2 + (p[1]-q[1])**2
            
            # Precompute start and end for each edge
            starts = [e['start'] for e in edges]
            ends = [e['end'] for e in edges]
            
            # For each unordered pair
            pair_count = 0
            for i in range(len(edges)):
                for j in range(i+1, len(edges)):
                    end_i = ends[i]
                    end_j = ends[j]
                    if end_i == ends[j]:
                        continue
                    # check if ends are within distance <2 (squared distance <=3)
                    if squared_distance(end_i, end_j) <= 3:
                        # check if end_i == start_j or end_j == start_i
                        if end_i == starts[j] or end_j == starts[i]:
                            # allowed, no constraint
                            continue
                        # otherwise forbid both
                        row = np.zeros(len(edges), dtype=int)
                        row[i] = 1
                        row[j] = 1
                        rows.append(row)
                        b.append(1)
                        pair_count += 1
            
            pair_count
            
