                                # If one of the others assigned, the other unassigned, we can restrict its domain
                                elif colors[e_a] != -1 and colors[e_b] == -1:
                                    allowed = allowed_third_colors_given_pair(colors[e], colors[e_a])
                                    # intersect domain of e_b
                                    new_dom = domains[e_b] & allowed
                                    if not new_dom:
                                        return False
                                    if new_dom != domains[e_b]:
                                        domains[e_b] = new_dom
                                        changed = True
                                elif colors[e_b] != -1 and colors[e_a] == -1:
                                    allowed = allowed_third_colors_given_pair(colors[e], colors[e_b])
                                    new_dom = domains[e_a] & allowed
                                    if not new_dom:
                                        return False
                                    if new_dom != domains[e_a]:
                                        domains[e_a] = new_dom
                                        changed = True
                                # If neither assigned, we cannot restrict yet
                            # after processing, continue loop
                return True
            
