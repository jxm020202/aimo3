                                    coeff = np.zeros(n_vars, dtype=float)
                                    coeff[a*N + c1] = 1
                                    coeff[brow*N + c1] = 1
                                    coeff[c*N + c2] = 1
                                    coeff[drow*N + c2] = 1
                                    constraints.append(coeff)
                                    lbs.append(-np.inf)
                                    ubs.append(3)
