            import math, sympy as sp
            
            def is_squarefree(m):
                # return True if m is squarefree
                return sp.factorint(m).values() and all(e==1 for e in sp.factorint(m).values())
            
            def condition_n(n):
                # check gcd(866,n)=1
                if math.gcd(866, n) != 1:
                    return False
                m = n+1
                # squarefree
                if not is_squarefree(m):
                    return False
                # for each prime p dividing m, gcd(866, p-1)=1
                for p, e in sp.factorint(m).items():
                    if math.gcd(866, p-1) != 1:
                        return False
                return True
            
            def cycle_lengths_mul(a, mod):
                # permutation on 1..mod-1 (non-zero residues) given by multiplication by a modulo mod
                visited = [False]*mod
                lengths = []
                for x in range(1, mod):
                    if not visited[x]:
                        # start cycle
                        cur = x
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = (a*cur) % mod
                            cnt += 1
                        lengths.append(cnt)
                return sorted(lengths)
            
            def cycle_lengths_pow(e, mod):
                # permutation on 1..mod-1 (non-zero residues) given by exponentiation a^e mod mod
                visited = [False]*mod
                lengths = []
                for x in range(1, mod):
                    if not visited[x]:
                        cur = x
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = pow(cur, e, mod)
                            cnt += 1
                        lengths.append(cnt)
                return sorted(lengths)
            
            def find_min(limit=20000):
                for n in range(866, limit+1):
                    if not condition_n(n):
                        continue
                    # compute cycles
                    len_mul = cycle_lengths_mul(866, n)
                    # exponentiation on mod n+1, exclude 1 (since we will map fixed point)
                    # but we need cycles on set {2..n} i.e., all non-zero residues except 1.
                    # Let's compute cycles on all non-zero residues then remove the fixed point length 1 for element 1.
                    lengths_pow = cycle_lengths_pow(866, n+1)
                    # remove one occurrence of length 1 (for element 1)
                    # but there may be other fixed points; we need to remove exactly one 1 corresponding to element 1.
                    # We'll just decrement count of length 1 by 1.
                    # lengths_pow is multiset of cycle lengths for all residues 1..n.
                    # We'll copy and adjust.
                    from collections import Counter
                    cnt = Counter(lengths_pow)
                    if cnt[1] == 0:
                        continue  # no fixed point at 1? impossible
                    cnt[1] -= 1
                    if cnt[1] == 0:
                        del cnt[1]
                    # Now we need the multiset to match len_mul
                    # Convert to sorted list
                    adjusted = []
                    for L, c in cnt.items():
                        adjusted.extend([L]*c)
                    adjusted.sort()
