            def solve_ilp():
                from scipy.optimize import milp, LinearConstraint, Bounds
                c = np.array([-1]*n_vertices + [0]*n_edges, dtype=int)  # minimize -sum x_i
                # Build constraints as before
                A_eq = np.zeros((n_vertices, num_vars), dtype=int)
                b_eq = np.zeros(n_vertices, dtype=int)
                for i in range(n_vertices):
                    A_eq[i,i] = -1
                    for e_idx in incidence[i]:
                        A_eq[i, n_vertices+e_idx] = 1
                # Upper constraints
                n_ub = 3 * n_edges
                A_ub = np.zeros((n_ub, num_vars), dtype=int)
                b_ub = np.zeros(n_ub, dtype=int)
                row = 0
                for e_idx, (i,j) in enumerate(edges):
                    # y - x_i <= 0
                    A_ub[row, n_vertices+e_idx] = 1
                    A_ub[row, i] = -1
                    b_ub[row] = 0
                    row += 1
                    # y - x_j <= 0
                    A_ub[row, n_vertices+e_idx] = 1
                    A_ub[row, j] = -1
                    b_ub[row] = 0
                    row += 1
                    # -y + x_i + x_j <= 1
                    A_ub[row, n_vertices+e_idx] = -1
                    A_ub[row, i] = 1
                    A_ub[row, j] = 1
                    b_ub[row] = 1
