            def feasible_with_k(n,k):
                left_vals = list(range(-(n-1), n))
                right_vals = list(range(0, 2*n-1))
                edges = []
                for i in range(n):
                    for j in range(n):
                        edges.append((i-j, i+j))
                # Build MILP with constraint sum x <= k
                m = len(edges)
                left_index = {v:i for i,v in enumerate(left_vals)}
                right_index = {v:i for i,v in enumerate(right_vals)}
                inc_left = collections.defaultdict(list)
                inc_right = collections.defaultdict(list)
                for idx,(d1,d2) in enumerate(edges):
                    inc_left[left_index[d1]].append(idx)
                    inc_right[right_index[d2]].append(idx)
                rows = []
                lb = []
                ub = []
                # matching constraints
                for l in range(len(left_vals)):
                    row = np.zeros(m)
                    for idx in inc_left[l]:
                        row[idx]=1
                    rows.append(row); lb.append(-np.inf); ub.append(1)
                for r in range(len(right_vals)):
                    row = np.zeros(m)
                    for idx in inc_right[r]:
                        row[idx]=1
                    rows.append(row); lb.append(-np.inf); ub.append(1)
                # maximality constraints
                for e_idx,(lval,rval) in enumerate(edges):
                    row = np.zeros(m)
                    l = left_index[lval]; r = right_index[rval]
                    for idx in set(inc_left[l] + inc_right[r]):
                        row[idx]=1
                    rows.append(row); lb.append(1); ub.append(np.inf)
                # total count constraint
                rows.append(np.ones(m))
                lb.append(0); ub.append(k)
                A = np.array(rows,float)
                lc = LinearConstraint(A, np.array(lb,float), np.array(ub,float))
                c = np.ones(m)
                bounds = Bounds(0,1)
                integrality = np.ones(m,dtype=int)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={"disp": False})
                return res.success
            
