            def exists_g_backtrack(n, max_k=100, time_limit=5.0):
                import time
                start=time.time()
                # Precompute forbidden deltas for each d
                forb = {}
                for d in range(1,n):
                    s=set((k*d)%n for k in range(max_k+1))
                    forb[d]=s
                # order of x: maybe 0..n-1
                used=[False]*n
                g=[None]*n
                # fix g(0)=0 to reduce symmetry
                g[0]=0
                used[0]=True
                # recursion
                def backtrack(idx):
                    if time.time()-start>time_limit:
                        raise TimeoutError
                    if idx==n:
                        return True
                    # skip already assigned (0)
                    if g[idx] is not None:
                        return backtrack(idx+1)
                    for y in range(n):
                        if used[y]:
                            continue
                        # check constraints with earlier assigned a<idx
                        ok=True
                        for a in range(n):
                            if g[a] is None:
                                continue
                            d = (idx - a) % n
                            if d==0:
                                continue
                            delta = (y - g[a]) % n
                            if delta in forb[d]:
                                ok=False
                                break
                            # also need check opposite direction? Already covered when a later.
                        if not ok:
                            continue
                        # assign
                        g[idx]=y
                        used[y]=True
                        if backtrack(idx+1):
                            return True
                        used[y]=False
                        g[idx]=None
                    return False
                try:
                    return backtrack(1)
                except TimeoutError:
                    return None
            
