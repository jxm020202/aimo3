                return lengths
            
            def multiplication_cycle_type(m, k):
                # permutation on Z_m (0..m-1) via multiplication by k modulo m
                perm = {i: (k*i) % m for i in range(m)}
                # we consider all elements 0..m-1
                return cycle_type_perm(perm)
            
            def exponentiation_core_cycle_type(n):
                # returns cycle type of core permutation (nodes with indegree d)
                d=math.gcd(866,n)
                mod=n+1
                indeg=[0]*n
                succ=[0]*n
                for a in range(1,n+1):
                    b=pow(a,866,mod)
                    succ[a-1]=b
                    indeg[b-1]+=1
                core_nodes=[i+1 for i,c in enumerate(indeg) if c==d]
                # Build permutation dict for core nodes
                perm={}
                for a in core_nodes:
                    perm[a]=succ[a-1]
                # Ensure perm maps core to core
                # (should hold)
                return cycle_type_perm(perm)
            
            def check_n_full(n):
                d=math.gcd(866,n)
                if d==1:
                    return False
                m=n//d
                # compute cycle types
                ct_mul = multiplication_cycle_type(m, 866//d)
                ct_exp = exponentiation_core_cycle_type(n)
                return ct_mul == ct_exp
            
            def find_min_full(start, limit):
                for n in range(start, limit+1):
                    if check_n_full(n):
                        return n
                return None
            
