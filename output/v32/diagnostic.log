            def count_colorings():
                import networkx as nx
                # Build dodecahedron graph
                G = nx.dodecahedral_graph()
                edges = list(G.edges())
                nE = len(edges)
                verts = list(G.nodes())
                nV = len(verts)
                vert_index = {v:i for i,v in enumerate(verts)}
                vertex_edges = [[] for _ in range(nV)]
                for idx,(u,v) in enumerate(edges):
                    ui, vi = vert_index[u], vert_index[v]
                    vertex_edges[ui].append(idx)
                    vertex_edges[vi].append(idx)
                for lst in vertex_edges:
                    lst.sort()
                # vertex factor
                def vertex_factor(edge_idxs):
                    vars = tuple(edge_idxs)
                    table = {}
                    # generate allowed triples (a,a,b) permutations
                    for a in range(3):
                        for b in range(3):
                            if a==b: continue
                            for pos in range(3):
                                triple = [a,a,a]
                                triple[pos] = b
                                table[tuple(triple)] = 1
                    return (vars, table)
                # multiply factors
                def multiply_factors(f1, f2):
                    vars1, table1 = f1
                    vars2, table2 = f2
                    # union vars preserving order
                    vars_union = list(vars1)
                    for v in vars2:
                        if v not in vars_union:
                            vars_union.append(v)
                    vars_union = tuple(vars_union)
                    # position maps
                    pos1 = {v:i for i,v in enumerate(vars1)}
                    pos2 = {v:i for i,v in enumerate(vars2)}
                    posU = {v:i for i,v in enumerate(vars_union)}
                    inter = set(vars1).intersection(vars2)
                    new_table = {}
                    # iterate over assignments
                    for assign1, w1 in table1.items():
                        if w1 == 0: continue
                        for assign2, w2 in table2.items():
                            if w2 == 0: continue
                            # consistency on intersecting vars
                            ok = True
                            for v in inter:
                                if assign1[pos1[v]] != assign2[pos2[v]]:
                                    ok = False
                                    break
                            if not ok:
                                continue
                            # combine
                            combined = [0]*len(vars_union)
                            for v in vars1:
                                combined[posU[v]] = assign1[pos1[v]]
                            for v in vars2:
                                combined[posU[v]] = assign2[pos2[v]]
                            combined = tuple(combined)
                            new_table[combined] = new_table.get(combined, 0) + w1*w2
                    return (vars_union, new_table)
                # sum out variable
                def sum_out_var(factor, var):
                    vars, table = factor
                    if var not in vars:
                        return factor
                    idx = vars.index(var)
                    new_vars = tuple(v for v in vars if v != var)
                    new_table = {}
                    for assign, w in table.items():
                        new_assign = assign[:idx] + assign[idx+1:]
                        new_table[new_assign] = new_table.get(new_assign, 0) + w
                    return (new_vars, new_table)
                # initialize factors list
                factors = [vertex_factor(tuple(vertex_edges[v])) for v in range(nV)]
                remaining_edges = set(range(nE))
                # elimination loop
                while remaining_edges:
                    e = next(iter(remaining_edges))
                    # find two factors containing e
                    idxs = [i for i,f in enumerate(factors) if e in f[0]]
                    if len(idxs) != 2:
                        # edge already eliminated?
                        remaining_edges.remove(e)
                        continue
                    i,j = idxs
                    f_i = factors[i]
                    f_j = factors[j]
                    f_comb = multiply_factors(f_i, f_j)
                    f_new = sum_out_var(f_comb, e)
                    # replace factors
                    # remove higher index first
                    for idx in sorted([i,j], reverse=True):
                        factors.pop(idx)
                    factors.append(f_new)
                    remaining_edges.remove(e)
                # after elimination, one factor remains with no vars
                assert len(factors) == 1
                final_vars, final_table = factors[0]
                assert final_vars == ()
                total = sum(final_table.values())
                return total
            
            print(count_colorings())
            
