            def rank_mod3(rows, ncols):
                # rows: list of lists length ncols (int 0/1)
                # returns rank over GF(3)
                rows = [row[:] for row in rows]  # copy
                rank = 0
                col = 0
                while rank < len(rows) and col < ncols:
                    # find pivot row with non-zero in column col
                    pivot = None
                    for i in range(rank, len(rows)):
                        if rows[i][col] % 3 != 0:
                            pivot = i
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap pivot row to position rank
                    rows[rank], rows[pivot] = rows[pivot], rows[rank]
                    # normalize pivot row: make leading coefficient 1 (multiply by inverse)
                    inv = {1:1, 2:2}  # since 2*2=4≡1 mod3
                    lead = rows[rank][col] % 3
                    factor = inv[lead]
                    rows[rank] = [(val * factor) % 3 for val in rows[rank]]
                    # eliminate other rows
                    for i in range(len(rows)):
                        if i != rank and rows[i][col] % 3 != 0:
                            factor = rows[i][col] % 3
                            # row_i = row_i - factor * row_rank
                            rows[i] = [ (rows[i][j] - factor*rows[rank][j]) % 3 for j in range(ncols) ]
                    rank += 1
                    col += 1
                return rank
            
