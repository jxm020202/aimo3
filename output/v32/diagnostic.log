            def min_S_bruteforce(n,total):
                best = None
                best_seq = None
                # generate increasing sequences of length n with sum total
                # numbers positive integers
                # use combinations with replacement? Actually need strictly increasing.
                # We'll generate combinations of n distinct positive ints up to total.
                # Use itertools.combinations of range(1,total) choose n, then filter sum.
                for combo in itertools.combinations(range(1,total), n):
                    if sum(combo) != total:
                        continue
                    seq = combo
                    # compute b_k for k=1..n-1
                    S = 0
                    for k in range(1,n):
                        left = sum(seq[:k])
                        right = total - left
                        b = min(left,right)
                        if b > S:
                            S = b
                    if best is None or S < best:
                        best = S
                        best_seq = seq
                return best, best_seq
            
            def min_S_algorithm(n,total):
                # algorithm similar to earlier but with n elements
                best = None
                best_m = None
                for m in range(0,n):
                    s = m*(m+1)//2
                    if s > total//2:
                        continue
                    # n_total = n
                    # after a_{m+1}, there are n-(m+1) elements
                    tail = n - (m+1)
                    # minimal sum of tail after a_{m+1} given a_{m+1}=t
                    # tail elements: t+1,...,t+tail
                    # sum tail = tail*t + tail*(tail+1)//2
                    # total = s + t + tail*t + tail*(tail+1)//2 = s + (tail+1)*t + tail*(tail+1)//2
                    numerator = total - s - tail*(tail+1)//2
                    denominator = tail+1
                    t_max = numerator // denominator
                    if t_max <= m:
                        continue
                    S_candidate = max(s, total - s - t_max)
                    if best is None or S_candidate < best:
                        best = S_candidate
                        best_m = m
                return best, best_m
            
