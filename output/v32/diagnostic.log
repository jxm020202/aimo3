                # map index
                idx_map={sq:k for k,sq in enumerate(squares)}
                # compute diagonal groups for this color
                diag1=collections.defaultdict(list)
                diag2=collections.defaultdict(list)
                for k,(i,j) in enumerate(squares):
                    d1=i-j
                    d2=i+j
                    diag1[d1].append(k)
                    diag2[d2].append(k)
                # Build constraints: for each square s, sum over its two diagonals >=1
                A=np.zeros((n_sq,n_sq),dtype=int)
                b=np.ones(n_sq,dtype=int)
                for k,(i,j) in enumerate(squares):
                    for kk in diag1[i-j]:
                        A[k,kk]=1
                    for kk in diag2[i+j]:
