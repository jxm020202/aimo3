            import random, math, itertools, numpy as np, sys, time, math, itertools, collections, statistics, fractions, decimal, heapq, functools, sympy as sp, mpmath as mp
            
            def compute_E(x):
                n = len(x)
                s = sum(x)
                assert abs(s-1) < 1e-9
                C = sum(v*v for v in x)
                B = n*C - s*s
                # median is 5th smallest (index 4)
                med = sorted(x)[4]
                A = sum(abs(v - med) for v in x)
                return (A*A * B) / (C**3)
            
            def random_vec():
                # generate random numbers maybe with large variance
                # use normal distribution then shift to sum=1
                arr = np.random.randn(9)
                arr = arr - np.mean(arr) + 1/9 # adjust to sum=1
                return arr.tolist()
            
            def random_search(iterations=200000):
                best = -1
                best_x = None
                for _ in range(iterations):
                    x = random_vec()
                    # ensure sum exactly 1 (floating)
                    # compute
                    val = compute_E(x)
                    if val > best:
                        best = val
                        best_x = x[:]
                return best, best_x
            
            best, best_x = random_search(20000)
            best, best_x[:5]
            
