            def feasible_interval(N, pattern):
                # pattern list of length N (bits)
                intervals = [(0.0, 1.0)]  # list of (low, high) intervals inclusive of low, exclusive of high
                for n in range(1, N+1):
                    a = pattern[n-1]
                    new_intervals = []
                    # For each integer k, intervals where floor(nx) parity matches a
                    # For even (a=1): nx in [2k, 2k+1)
                    # For odd (a=0): nx in [2k+1, 2k+2)
                    # So x in [ (2k + (1-a))/n , (2k + (2 - a))/n )
                    # Actually:
                    # if a=1: lower = 2k/n, upper = (2k+1)/n
                    # if a=0: lower = (2k+1)/n, upper = (2k+2)/n
                    # k ranges over integers such that interval intersects [0,1)
                    max_k = int(math.ceil(n*1))  # enough
                    for low, high in intervals:
                        # we need to intersect low-high with union of allowed intervals for this n
                        # We'll iterate k to generate allowed intervals within [0,1)
                        k_start = int(math.floor(n*low/2)) - 2
                        k_end = int(math.ceil(n*high/2)) + 2
                        for k in range(k_start, k_end+1):
                            if a==1:
                                a_low = (2*k)/n
                                a_high = (2*k+1)/n
                            else:
                                a_low = (2*k+1)/n
                                a_high = (2*k+2)/n
                            # intersect with [low,high)
                            inter_low = max(low, a_low)
                            inter_high = min(high, a_high)
                            if inter_low < inter_high - 1e-15:
                                new_intervals.append((inter_low, inter_high))
                    intervals = new_intervals
                    if not intervals:
                        return []  # empty
                return intervals
            
