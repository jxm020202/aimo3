                            coeff[idx_v(x1,s)] = 1
                            coeff[idx_v(x2,s)] = 1
                            constraints.append(LinearConstraint(coeff, -np.inf, 1))
                
                # Build bounds object
                bounds = Bounds(lb, ub)
                
                # Solve MILP
