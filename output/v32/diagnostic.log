            def allowed_area(theta, resolution=2000):
                # compute area of points (dx,dy) in D = [-0.5,0.5]^2 not covered by any Q_i
                # Use grid sampling for approximation
                xs = np.linspace(-0.5, 0.5, resolution)
                ys = np.linspace(-0.5, 0.5, resolution)
                dx, dy = np.meshgrid(xs, ys, indexing='ij')
                # flatten
                dx_flat = dx.ravel()
                dy_flat = dy.ravel()
                cos = math.cos(theta)
                sin = math.sin(theta)
                # For each point, check if inside any Q_i (i.e., (dx,dy) is such that vertex (dx+0.5, dy+0.5) inside S_theta etc.)
                # Equivalent to check if point (dx,dy) lies within Q_i = S_theta shifted by (-0.5,-0.5) etc.
                # We'll compute for each sign combination
                inside_any = np.zeros_like(dx_flat, dtype=bool)
                for sx, sy in [(-0.5, -0.5), (0.5, -0.5), (-0.5, 0.5), (0.5, 0.5)]:
                    # point in Q_i if (dx - sx, dy - sy) is inside S_theta (centered at origin)
                    # Because Q_i = S_theta + (sx, sy) ??? Wait shift: Q_i = S_theta + (sx, sy) where sx,sy are signs? Actually earlier Q_i = S_theta + (±0.5,±0.5)
                    # So point (dx,dy) is inside Q_i if (dx - sx, dy - sy) ∈ S_theta.
