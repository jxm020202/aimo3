            import networkx as nx
            
            def build_graph_h(n):
                G=nx.DiGraph()
                G.add_nodes_from(range(1,n+1))
                for x in range(1,n+1):
                    y = ((866*x - 1) % n) + 1
                    G.add_edge(x,y)
                return G
            
            def build_graph_e(n):
                G=nx.DiGraph()
                mod=n+1
                G.add_nodes_from(range(1,n+1))
                for a in range(1,n+1):
                    b=pow(a,866,mod)
                    # b cannot be 0; ensure
                    if b==0:
                        raise ValueError("zero")
                    G.add_edge(a,b)
                return G
            
            n=882
            G_h=build_graph_h(n)
            G_e=build_graph_e(n)
            
            # Use DiGraphMatcher with node labels maybe degree invariants
            matcher=nx.algorithms.isomorphism.DiGraphMatcher(G_h, G_e,
                node_match=lambda u,v: (G_h.out_degree(u)==G_e.out_degree(v) and G_h.in_degree(u)==G_e.in_degree(v))
            print("isomorphic?", matcher.is_isomorphic())
            
