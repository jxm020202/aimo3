            import itertools
            
            def naf_weight(n):
                # compute NAF representation weight (minimal signed-digit weight)
                # algorithm: while n>0:
                # if n odd: u = 2 - (n % 4)  (i.e., u = 1 if n%4==1 else -1)
                # else u=0
                # n = (n - u)//2
                # weight += abs(u)
                weight=0
                while n>0:
                    if n & 1:
                        u = 2 - (n & 3)  # n%4
                        # u will be 1 if n%4==1, -1 if n%4==3
                        weight += 1
                        n = (n - u) >> 1
                    else:
                        n >>= 1
                return weight
            
            def min_n_for_weight(w, limit=10000):
                for n in range(1, limit):
                    if naf_weight(n)==w:
                        return n
                return None
            
            for w in range(1,11):
                print(w, min_n_for_weight(w, limit=2000))
            
