            def f_candidate(n):
                # n odd
                # candidate 1: a=1, d divisor of n-1, d != (n-1)/2
                # choose largest divisor d < (n-1)/2
                m1 = n-1
                # get divisors of m1
                divs = sp.divisors(m1)
                # filter d < m1/2
                d_candidates = [d for d in divs if d < m1/2]
                if d_candidates:
                    d1 = max(d_candidates)
                    cand1 = m1 - d1
                else:
                    cand1 = None
                # candidate 2: a=2, d divisor of n-2 (odd)
                m2 = n-2
                divs2 = sp.divisors(m2)
                # need d proper divisor (< m2)
                d2_candidates = [d for d in divs2 if d < m2]
                if d2_candidates:
