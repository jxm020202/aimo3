            import sys, math, itertools, time
            # Preprocess rows as list of ints modulo 3
            rows = [ [1 if j in tri else 0 for j in range(30)] for tri in tri_edges ]
            
            def add_to_basis(basis, vec):
                # basis: list of vectors in row-echelon form (leading 1 at some column)
                # vec: list of ints 0..2
                v = vec[:]
                for b in basis:
                    # find leading column of b
                    lead = next(i for i, val in enumerate(b) if val != 0)
                    if v[lead] != 0:
                        factor = v[lead]  # since b[lead] == 1
                        # v = v - factor * b (mod 3)
                        v = [(v[i] - factor * b[i]) % 3 for i in range(30)]
                # after elimination, check if zero
                if all(x == 0 for x in v):
                    return False, basis  # dependent, basis unchanged
                # find leading column of new vector
                lead = next(i for i, val in enumerate(v) if val != 0)
                # normalize to make leading 1
                if v[lead] == 2:
                    v = [(2 * val) % 3 for val in v]  # multiply by 2 (inverse of 2)
                # eliminate this column from existing basis rows to maintain reduced echelon form
                new_basis = []
                for b in basis:
                    if b[lead] != 0:
                        factor = b[lead]
                        b = [(b[i] - factor * v[i]) % 3 for i in range(30)]
                    new_basis.append(b)
                new_basis.append(v)
                # sort basis by leading column maybe
                new_basis.sort(key=lambda row: next(i for i,val in enumerate(row) if val!=0))
                return True, new_basis
            
            def count_sum():
                total = 0
                # recursion over rows
                def dfs(idx, basis, rank, sign):
                    nonlocal total
                    if idx == len(rows):
                        total = (total + sign * pow(3, 30 - rank, 1000)) % 1000
                        return
                    # option: exclude row idx
                    dfs(idx+1, basis, rank, sign)
                    # include row idx
                    independent, new_basis = add_to_basis(basis, rows[idx])
                    if independent:
                        dfs(idx+1, new_basis, rank+1, -sign)  # sign flips because include adds (-1) factor
                    else:
                        # rank unchanged
                        dfs(idx+1, basis, rank, -sign)
                dfs(0, [], 0, 1)
                return total
            
            start = time.time()
            res = count_sum()
            print("result", res, "time", time.time()-start)
            
