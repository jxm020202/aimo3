            def f_bruteforce_fast(n):
                # use loops but maybe okay up to 200
                best = None
                for a in range(1, n-1):
                    for b in range(a+1, n):
                        c = n - a - b
                        if c <= b:
                            continue
                        l = sp.ilcm(a,b,c)
                        if best is None or l < best:
                            best = l
                return best
            
            ratios = {}
            for n in range(6, 201):
                best = f_bruteforce_fast(n)
                ratios[n] = best/n
