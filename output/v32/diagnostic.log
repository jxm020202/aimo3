            def random_point_in_tetrahedron(verts):
                # Dirichlet(1,1,1,1) distribution
                r = np.random.rand(4)
                # use -log to get exponential
                t = -np.log(r)
                t = t / t.sum()
                return (t[:,None] * verts).sum(axis=0)
            
            def face_normals_and_offsets(verts):
                # faces: each combination of 3 vertices
                faces = [(0,1,2),(0,1,3),(0,2,3),(1,2,3)]
                normals = []
                offsets = []
                for (i,j,k) in faces:
                    p0 = verts[i]
                    p1 = verts[j]
                    p2 = verts[k]
                    # normal vector (not normalized)
                    n = np.cross(p1-p0, p2-p0)
                    # offset d such that plane equation n·x + d = 0 for points on plane
                    d = -np.dot(n, p0)
                    normals.append(n)
                    offsets.append(d)
                return np.array(normals), np.array(offsets)
            
            normals, offsets = face_normals_and_offsets(verts)
            
            def min_distance_to_faces(p):
                # compute signed distance (positive if n points outward)
                # but we just need absolute distance
                d = np.abs(np.dot(normals, p) + offsets) / np.linalg.norm(normals, axis=1)
                return d.min()
            
