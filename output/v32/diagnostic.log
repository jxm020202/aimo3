            import itertools
            
            def hypercube_adj(d):
                # adjacency list: vertices 0..2^d-1
                n = 1<<d
                adj = {v: [] for v in range(n)}
                for v in range(n):
                    for k in range(d):
                        u = v ^ (1<<k)
                        adj[v].append((u, 1<<k))
                return adj
            
            def all_hamiltonian_paths(d):
                n = 1<<d
                adj = hypercube_adj(d)
                start = 0
                paths = []
                # backtrack
                visited = [False]*n
                visited[start]=True
                path = [start]
                def dfs(v):
                    if len(path)==n:
                        paths.append(list(path))
                        return
                    for u, length in adj[v]:
                        if not visited[u]:
                            visited[u]=True
                            path.append(u)
                            dfs(u)
                            path.pop()
                            visited[u]=False
                dfs(start)
                return paths
            
            def min_T(d):
                adj = hypercube_adj(d)
                start = 0
                n = 1<<d
                best = None
                best_path = None
                visited = [False]*n
                visited[start]=True
                path = [start]
                def dfs(v, total):
                    nonlocal best, best_path
                    if best is not None and total >= best:
                        return
                    if len(path)==n:
                        # completed
                        if best is None or total < best:
                            best = total
                            best_path = list(path)
                        return
                    for u, length in adj[v]:
                        if not visited[u]:
                            visited[u]=True
                            path.append(u)
                            dfs(u, total + 1/length)
                            path.pop()
                            visited[u]=False
                dfs(start, 0)
                return best, best_path
            
            for d in range(1,5):
                best, path = min_T(d)
                print(d, best)
            
