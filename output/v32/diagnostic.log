            def cycles_n3():
                n=3
                N=2**n
                # edges dim2 (value 4) and dim1 (value 2)
                edges = {i:[] for i in range(N)}
                for i in range(N):
                    for k in [2,1]:
                        j = i ^ (1<<k)
                        if i < j:
                            edges[i].append(j)
                            edges[j].append(i)
                # find connected components
                visited=[False]*N
                comps=[]
                for i in range(N):
                    if not visited[i]:
                        stack=[i]
                        comp=[]
                        visited[i]=True
                        while stack:
                            v=stack.pop()
                            comp.append(v)
                            for nb in edges[v]:
                                if not visited[nb]:
                                    visited[nb]=True
                                    stack.append(nb)
                        comps.append(comp)
                return comps
            
            cycles_n3()
            
