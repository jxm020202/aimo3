            import itertools, math
            
            def S_of_perm(p):
                n = len(p)
                s = 0
                for i in range(n):
                    s += abs(p[i] - p[(i+1)%n])
                return s
            
            def canonical(p):
                # p is tuple length 9
                n = len(p)
                # generate rotations
                rots = [p[i:]+p[:i] for i in range(n)]
                # generate reflections: reverse order then rotations
                rev = p[::-1]
                rots_rev = [rev[i:]+rev[:i] for i in range(n)]
                # choose minimal lexicographically
                cand = rots + rots_rev
                return min(cand)
            
            # compute minimal S and count classes
            min_S = None
            class_counts = {}
            for perm in itertools.permutations(range(1,10)):
                s = S_of_perm(perm)
                if min_S is None or s < min_S:
                    min_S = s
                    # reset
                    class_counts = {}
                if s == min_S:
                    can = canonical(perm)
                    class_counts[can] = class_counts.get(can,0)+1
            
            min_S, len(class_counts)
            
