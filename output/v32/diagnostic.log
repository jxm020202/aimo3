            plane_params = [plane_from_points(*face) for face in faces]
            
            def point_in_tetra(p):
                # barycentric method: point inside if it is on same side of each face as opposite vertex
                for (n,d), opposite in zip(plane_params, [v3, v2, v1, v0]):
                    # evaluate signed distance for point and opposite vertex
                    sign_p = np.dot(n, p) + d
                    sign_o = np.dot(n, opposite) + d
                    # inside if sign_p and sign_o have same sign (or zero)
                    if sign_p * sign_o < -1e-12:
                        return False
                return True
            
            def distance_to_face(p, n, d):
                # distance = |n·p + d| / |n|
                return abs(np.dot(n, p) + d) / np.linalg.norm(n)
            
            r = math.sqrt(6)/36
            def reachable(p):
                if not point_in_tetra(p):
                    return False
                # distance to each face must be >= r
                for n,d in plane_params:
                    if distance_to_face(p,n,d) < r - 1e-12:
