            def min_edge_domination(n):
                # build graph for n x n board
                left_vals = list(range(-(n-1), n))
                right_vals = list(range(0, 2*n-1))
                left_index = {v:i for i,v in enumerate(left_vals)}
                right_index = {v:i for i,v in enumerate(right_vals)}
                edges = []
                for i in range(n):
                    for j in range(n):
                        edges.append((left_index[i-j], right_index[i+j]))
                m = len(edges)
                inc_left = collections.defaultdict(list)
                inc_right = collections.defaultdict(list)
                for idx,(l,r) in enumerate(edges):
                    inc_left[l].append(idx)
                    inc_right[r].append(idx)
                # constraints
                rows = []
                lb = []
                ub = []
                # left matching
                for l in range(len(left_vals)):
                    row = np.zeros(m)
                    for idx in inc_left[l]:
                        row[idx]=1
                    rows.append(row); lb.append(-np.inf); ub.append(1)
                for r in range(len(right_vals)):
                    row = np.zeros(m)
                    for idx in inc_right[r]:
                        row[idx]=1
                    rows.append(row); lb.append(-np.inf); ub.append(1)
                for e_idx,(l,r) in enumerate(edges):
                    row = np.zeros(m)
                    for idx in set(inc_left[l] + inc_right[r]):
                        row[idx]=1
                    rows.append(row); lb.append(1); ub.append(np.inf)
                A = np.array(rows,float)
                lb = np.array(lb,float)
                ub = np.array(ub,float)
                c = np.ones(m)
                bounds = Bounds(0,1)
                integrality = np.ones(m,dtype=int)
                res = milp(c=c, constraints=LinearConstraint(A,lb,ub), bounds=bounds, integrality=integrality, options={"disp": False})
                return int(round(res.fun))
            for n in range(2,11):
                print(n, min_edge_domination(n))
            
