            def multiply_factors(f1_vars, f1_table, f2_vars, f2_table, mod=None):
                # Determine new_vars order
                new_vars = list(f1_vars)
                for v in f2_vars:
                    if v not in new_vars:
                        new_vars.append(v)
                # Overlap
                common = set(f1_vars) & set(f2_vars)
                new_table = {}
                if common:
                    # Build lookup for f2 on common vars
                    common_list = list(common)
                    # indices in f2_vars
                    idxs_f2 = [f2_vars.index(v) for v in common_list]
                    lookup = defaultdict(list)
                    for assign2, cnt2 in f2_table.items():
                        key = tuple(assign2[i] for i in idxs_f2)
                        lookup[key].append((assign2, cnt2))
                    # For each assign1
                    idxs_f1 = [f1_vars.index(v) for v in common_list]
                    for assign1, cnt1 in f1_table.items():
                        key = tuple(assign1[i] for i in idxs_f1)
                        for assign2, cnt2 in lookup.get(key, []):
                            # combine assignments
                            # Build new assignment tuple
                            new_assign = [None]*len(new_vars)
                            # fill from assign1
                            for i, v in enumerate(f1_vars):
                                new_assign[new_vars.index(v)] = assign1[i]
                            # fill from assign2
                            for i, v in enumerate(f2_vars):
                                new_assign[new_vars.index(v)] = assign2[i]
                            new_assign = tuple(new_assign)
                            prod = cnt1 * cnt2
                            if mod:
                                prod %= mod
                            new_table[new_assign] = (new_table.get(new_assign, 0) + prod) % mod if mod else new_table.get(new_assign, 0) + prod
                else:
                    # No common vars
                    for assign1, cnt1 in f1_table.items():
                        for assign2, cnt2 in f2_table.items():
                            new_assign = []
                            for v in new_vars:
                                if v in f1_vars:
                                    new_assign.append(assign1[f1_vars.index(v)])
                                else:
                                    new_assign.append(assign2[f2_vars.index(v)])
                            new_assign = tuple(new_assign)
                            prod = cnt1 * cnt2
                            if mod:
                                prod %= mod
                            new_table[new_assign] = (new_table.get(new_assign, 0) + prod) % mod if mod else new_table.get(new_assign, 0) + prod
                return tuple(new_vars), new_table
            
            def sum_out_variable(vars_list, table, var, mod=None):
                idx = vars_list.index(var)
                new_vars = list(vars_list)
                new_vars.pop(idx)
                new_vars = tuple(new_vars)
                new_table = {}
                for assign, cnt in table.items():
                    new_assign = assign[:idx] + assign[idx+1:]
                    if mod:
                        cnt = cnt % mod
                    new_table[new_assign] = (new_table.get(new_assign, 0) + cnt) % mod if mod else new_table.get(new_assign, 0) + cnt
                return new_vars, new_table
            
