            import itertools
            def min_weight_lp(m):
                # solve integer linear program via brute force enumeration of n_k within bounds
                total = 2**m - 1
                max_edge = 2**(m-1)
                best = None
                best_vec = None
                # enumeration with pruning
                def rec(k, current, remaining):
                    nonlocal best, best_vec
                    if k == m:
                        if remaining != 0:
                            return
                        # check crossing constraints
                        for i in range(m):
                            lhs = sum(current[j] * (2**(j - i)) for j in range(i, m))
                            if lhs < 2**(m - i) - 1:
                                return
                        weight = sum(current[i] / (2**i) for i in range(m))
                        if best is None or weight < best:
                            best = weight
                            best_vec = current.copy()
                        return
                    # possible values for n_k
                    # bound by remaining and max_edge
                    max_val = min(max_edge, remaining)
                    for val in range(0, max_val+1):
                        current.append(val)
                        rec(k+1, current, remaining - val)
                        current.pop()
                rec(0, [], total)
                return best, best_vec
            
