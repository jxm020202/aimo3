            def odd_intervals(n):
                """Return list of intervals [k/n, (k+1)/n) where k odd, 0<=k<=n-1."""
                intervals = []
                for k in range(1, n, 2):
                    intervals.append((k/n, (k+1)/n))
                return intervals
            
            def intersect_intervals(A, B):
                """Intersect two lists of intervals (half-open) and return list."""
                i, j = 0, 0
                res = []
                while i < len(A) and j < len(B):
                    a_l, a_r = A[i]
                    b_l, b_r = B[j]
                    l = max(a_l, b_l)
                    r = min(a_r, b_r)
                    if l < r - 1e-15:  # non-empty
                        res.append((l, r))
                    if a_r < b_r:
                        i += 1
                    else:
                        j += 1
                return res
            
            def complement_intervals(intervals, total=(0.0,1.0)):
                """Return complement of intervals within total interval."""
                res = []
                cur = total[0]
                for l,r in intervals:
                    if cur < l:
                        res.append((cur, l))
                    cur = max(cur, r)
                if cur < total[1]:
                    res.append((cur, total[1]))
                return res
            
            def greedy_max_bits(N):
                feasible = [(0.0, 1.0)]
                bits = []
                for n in range(1, N+1):
                    odd_ints = odd_intervals(n)
                    # Intersection with odd intervals
                    feasible_odd = intersect_intervals(feasible, odd_ints)
                    if feasible_odd:
                        bits.append(1)
                        feasible = feasible_odd
                    else:
                        bits.append(0)
                        # even intervals are complement of odd intervals within [0,1)
                        even_ints = complement_intervals(odd_ints, (0.0,1.0))
                        feasible_even = intersect_intervals(feasible, even_ints)
                        feasible = feasible_even
                    # if feasible becomes empty (should not)
                    if not feasible:
                        raise ValueError("No feasible interval at n={}".format(n))
                return bits, feasible
            
            bits, feasible = greedy_max_bits(20)
            bits, feasible[:5]
            
