            import math, itertools
            
            def f_bruteforce(N, limit=10000):
                # search for smallest integer X such that there exist three distinct divisors summing to N
                # We'll search X from 1 upward.
                for X in range(1, limit+1):
                    # compute divisors
                    divs = [d for d in range(1, int(math.isqrt(X))+1) if X % d == 0 for d in (d, X//d)]
                    # remove duplicates
                    divs = sorted(set(divs))
                    # need three distinct
                    for a,b,c in itertools.combinations(divs,3):
                        if a+b+c == N:
                            return X
                return None
            
            def candidate_f(N):
                # compute smallest divisor t of N-1 with t>=3
                n1 = N-1
                t = None
                for d in range(3, int(math.isqrt(n1))+1):
                    if n1 % d == 0:
                        t = d
                        break
                if t is None:
                    # n1 may be prime or 1 or 2
                    # if n1 is 1 or 2, no divisor >=3, then we cannot use this construction
                    # fallback: maybe use other method? return None
                    return None
                X = (t-1)*(n1)//t
                return X
            
            def compute_f(N):
                # compute exact f via brute force up to some limit
                return f_bruteforce(N, limit=5000)
            
            # test for N up to 200
            diffs = []
            for N in range(6,201):
