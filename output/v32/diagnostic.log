            import math, sympy as sp
            
            def f_of_k(k_val):
                k = sp.Rational(k_val)
                # define variable z
                z = sp.symbols('z', real=True, nonnegative=True)
                # compute S
                S = sp.sqrt(k**2*z**2 + 8*(1 - z)**2)
                # compute h(z) = xy + k xz
                # using derived formula: h = (1/16) * sqrt(-k*z + S) * (3*k*z + S)**(sp.Rational(3,2))
                h = sp.Rational(1,16) * sp.sqrt(-k*z + S) * (3*k*z + S)**sp.Rational(3,2)
                # f = 4*h
                f_expr = 4*h
                # find critical points: solve derivative zero (or use derived quadratic)
                # Use derived quadratic to get candidate z
                a = 2*(k**2 - 1)
                b = -(3*k**2 - 4)
                c = k**2 - 2
                # handle k=1 separately (a=0)
                candidates = []
                if a == 0:
                    # linear equation b*z + c = 0
                    if b != 0:
                        z_candidate = -c/b
                        candidates.append(z_candidate)
                else:
                    disc = b**2 - 4*a*c
                    # disc should be perfect square rational
                    sqrt_disc = sp.sqrt(disc)
                    z1 = (-b + sqrt_disc) / (2*a)
                    z2 = (-b - sqrt_disc) / (2*a)
                    candidates.extend([z1, z2])
                # add boundaries
                candidates.extend([sp.Rational(0), sp.Rational(1)])
                # evaluate f for each candidate within [0,1]
                max_val = -sp.oo
                best_z = None
                for cand in candidates:
                    cand = sp.nsimplify(cand)
                    if cand.is_real:
                        # numeric check within [0,1]
                        val = float(cand)
                        if 0 <= val <= 1+1e-9:
                            f_val = sp.N(f_expr.subs(z, cand))
                            if f_val > max_val:
                                max_val = f_val
                                best_z = cand
                return sp.nsimplify(max_val), best_z
            
            for kv in range(1,6):
                val, z_opt = f_of_k(kv)
                print(kv, val, z_opt)
            
