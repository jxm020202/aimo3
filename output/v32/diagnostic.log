                    ok = True
                    for u in range(n):
                        # need neighbor v such that N(u) ∩ N(v) = empty
                        found = False
                        for v in adj[u]:
                            if adj[u].isdisjoint(adj[v]):  # intersection empty
                                found = True
                                break
                        if not found:
                            ok = False
                            break
                    if ok:
                        if ecount > max_m:
                            max_m = ecount
                            best_graphs = [mask]
                        elif ecount == max_m:
                            best_graphs.append(mask)
