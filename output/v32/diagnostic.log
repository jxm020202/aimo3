            def f_candidate(n):
                # compute divisors
                divs = []
                for i in range(1, int(math.isqrt(n))+1):
                    if n % i == 0:
                        divs.append(i)
                        if i != n//i:
                            divs.append(n//i)
                # filter
                best = None
                bestd = None
                for d in divs:
                    if d < n/3:
                        if (n//d) % 2 == 1:  # n/d odd
                            # ensure distinctness
                            if n - 3*d == d or n - 3*d == 2*d:
                                continue
                            cand = n - 3*d
                            if best is None or cand < best:
                                best = cand
                                bestd = d
                if best is not None:
                    return best, bestd
                else:
                    return None, None
            
