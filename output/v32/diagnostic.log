            import random, math
            
            def covers_vertex(xc, yc, theta):
                # square side 1, centered at (xc, yc)
                # compute coordinates of four corners
                half = 0.5
                # rotation matrix
                cos = math.cos(theta)
                sin = math.sin(theta)
                # corners relative to center
                corners = [( half*cos - half*sin,  half*sin + half*cos), # (0.5,0.5) rotated? Actually need to rotate (±0.5,±0.5)
                           (-half*cos - half*sin, -half*sin + half*cos),
                           (-half*cos + half*sin, -half*sin - half*cos),
                           ( half*cos + half*sin,  half*sin - half*cos)]
                # Actually easier: generate all combos of (sx, sy) where sx,sy in {-0.5,0.5}
                corners = []
                for sx in (-half, half):
                    for sy in (-half, half):
                        x = xc + sx*cos - sy*sin
                        y = yc + sx*sin + sy*cos
                        corners.append((x,y))
                # Determine if any integer point lies inside square (including interior)
                # Use point-in-polygon test for each integer point within bounding box
                # bounding box of square:
                xs = [c[0] for c in corners]
                ys = [c[1] for c in corners]
                minx, maxx = min(xs), max(xs)
                miny, maxy = min(ys), max(ys)
                # consider integer points within bounding box (ceil-1 to floor+1)
                imin = math.floor(minx)-1
                imax = math.ceil(maxx)+1
                jmin = math.floor(miny)-1
                jmax = math.ceil(maxy)+1
                # Use winding number or ray crossing algorithm
                def point_in_polygon(px, py, poly):
                    # ray casting
                    inside = False
                    n = len(poly)
                    for i in range(n):
                        x1,y1 = poly[i]
                        x2,y2 = poly[(i+1)%n]
                        # check if edge crosses horizontal line at py
                        if ((y1 > py) != (y2 > py)):
                            # compute x coordinate of intersection
                            xint = x1 + (py - y1)*(x2 - x1)/(y2 - y1)
                            if xint > px:
                                inside = not inside
                    return inside
                for i in range(imin, imax+1):
                    for j in range(jmin, jmax+1):
                        if point_in_polygon(i, j, corners):
                            return True
                return False
            
            def trial(N=100000):
                cnt=0
                for _ in range(N):
                    xc = random.random()
                    yc = random.random()
                    theta = random.random()*2*math.pi
                    if not covers_vertex(xc, yc, theta):
                        cnt+=1
                return cnt/N
            
            print(trial(20000))
            
