            def max_f(n):
                vertices = list(range(n))
                max_f_val = -10**9
                best = None
                # iterate over all graphs? exponential; only for small n up to maybe 6.
                for edges_bits in range(1 << (n*(n-1)//2)):
                    # Build adjacency matrix
                    adj = [[False]*n for _ in range(n)]
                    idx=0
                    for i in range(n):
                        for j in range(i+1,n):
                            if (edges_bits>>idx)&1:
                                adj[i][j]=adj[j][i]=True
                            idx+=1
                    # Check triangle-free
                    triangle=False
                    for i in range(n):
                        for j in range(i+1,n):
                            if not adj[i][j]: continue
                            for k in range(j+1,n):
                                if adj[i][k] and adj[j][k]:
                                    triangle=True
                                    break
                            if triangle: break
                        if triangle: break
                    if triangle: continue
                    # compute E1 size
                    E1 = sum(1 for i in range(n) for j in range(i+1,n) if adj[i][j])
                    # compute P: pairs with common neighbor
                    P=set()
                    for w in range(n):
                        neigh=[v for v in range(n) if adj[w][v]]
                        for u_idx in range(len(neigh)):
                            for v_idx in range(u_idx+1,len(neigh)):
                                u=neigh[u_idx]; v=neigh[v_idx]
                                if u<v:
                                    P.add((u,v))
                                else:
                                    P.add((v,u))
                    f_val = E1 - len(P)
                    if f_val>max_f_val:
                        max_f_val=f_val
                        best=(E1,len(P))
                return max_f_val,best
            
            for n in range(2,9):
                print(n, max_f(n)[0])
            
