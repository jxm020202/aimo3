            def count_colorings_mod(mod=1000):
                n = 20
                # adjacency list of dodecahedron graph
                G = nx.dodecahedral_graph()
                adj = {v:set(G.neighbors(v)) for v in G.nodes()}
                neighbor_mask = [0]*n
                for v in range(n):
                    mask = 0
                    for w in adj[v]:
                        mask |= 1<<w
                    neighbor_mask[v] = mask
                total = 0
                # precompute popcount for 0..2^20-1 maybe using builtin bit_count (Python 3.8+)
                for mask in range(1<<n):
                    sz = mask.bit_count()
                    # compute t(S)
                    visited = 0
                    t = 0
                    # iterate over vertices in mask
                    remaining = mask
                    while remaining:
                        # get least significant set bit
                        v = (remaining & -remaining).bit_length() - 1  # index of LSB
                        # BFS/DFS
                        stack = [v]
                        comp = 0
                        visited |= (1<<v)
                        remaining &= ~(1<<v)
                        while stack:
                            u = stack.pop()
                            comp |= (1<<u)
                            # neighbors within mask
                            neigh = neighbor_mask[u] & mask
                            # iterate over bits
                            while neigh:
                                w = (neigh & -neigh).bit_length() - 1
                                if not (visited >> w) & 1:
                                    visited |= (1<<w)
                                    remaining &= ~(1<<w)
                                    stack.append(w)
                                neigh &= neigh-1
                        # component comp mask ready
                        n_c = comp.bit_count()
                        # count edges in component
                        # sum degrees within component
                        deg_sum = 0
                        temp = comp
                        while temp:
                            u = (temp & -temp).bit_length() - 1
                            deg_sum += (neighbor_mask[u] & comp).bit_count()
                            temp &= temp-1
                        e_c = deg_sum // 2
                        if e_c == n_c - 1:
                            t += 1
                    exponent = 30 - sz + t
                    term = pow(3, exponent, mod)
                    if sz % 2 == 1:
                        term = -term
                    total = (total + term) % mod
                return total
            
            print(count_colorings_mod())
            
