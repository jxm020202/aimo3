            def min_path_sum(n):
                N = 1<<n
                adj = {v: [(v ^ (1<<k), k) for k in range(n)] for v in range(N)}
                best = float('inf')
                best_path = None
                # use backtracking to prune
                visited = [False]*N
                path = [0]
                visited[0]=True
                def dfs(u, depth, total):
                    nonlocal best, best_path
                    if depth == N-1:
                        if total < best:
                            best = total
                            best_path = path.copy()
                        return
                    # prune if total already >= best
                    if total >= best:
                        return
                    for v,k in adj[u]:
                        if not visited[v]:
                            visited[v]=True
                            path.append(v)
                            dfs(v, depth+1, total + 1/(2**k))
                            visited[v]=False
                            path.pop()
                dfs(0,0,0)
                return best, best_path
            
