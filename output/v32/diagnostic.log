            def min_not_representable(L, max_check=200):
                # generate all sums with up to L terms (allow less)
                # brute force for small L using limited exponents up to some bound
                # Since we can use any exponent, we need to consider up to some max exponent.
                # For small L, we can search up to maybe exponent 6.
                from itertools import product, combinations_with_replacement
                # We'll generate all possible sums using up to L terms with exponents up to max_exp.
                max_exp=6
                possible=set()
                # Use recursion to generate sums with up to L terms
                def gen(k, current):
                    if k==0:
                        possible.add(current)
                        return
                    # we can also stop early (use fewer terms)
                    possible.add(current)
                    for b in range(max_exp+1):
                        for s in (1,-1):
                            gen(k-1, current + s*(1<<b))
                gen(L,0)
                # Now find minimal positive integer not in possible
                n=1
                while True:
                    if n not in possible:
                        return n
                    n+=1
            
            for L in range(1,5):
                print(L, min_not_representable(L))
            
