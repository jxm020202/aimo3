            def area_overlap_integral(theta):
                c, s = math.cos(theta), math.sin(theta)
                a = (c + s)/2
                x0 = (c - s)/2 if c>=s else (s - c)/2
                # integration interval
                lo = 1 - a
                hi = a
                # Determine if interval lies in outer region: for theta<=pi/4, lo>=x0
                # Use piecewise integration: L(x) = A - B x
                A = 0.5*(1/s + 1/c)
                B = 1/(s*c)
                # integral of (A - B x) dx = A*(hi-lo) - B*(hi**2 - lo**2)/2
                return A*(hi-lo) - B*(hi**2 - lo**2)/2
            
