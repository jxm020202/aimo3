            a_idx = list(range(n))
            y_idx = list(range(n, n+m))
            S_idx = n+m
            
            # Build constraints list
            A = []
            lb = []
            ub = []
            
            # a_i >= 1
            for i in range(n):
                row = np.zeros(num_vars, dtype=int)
                row[a_idx[i]] = 1
                A.append(row)
                lb.append(1)
                ub.append(np.inf)  # no upper bound yet
            
            # a_{i+1} - a_i >= 1
            for i in range(n-1):
                row = np.zeros(num_vars, dtype=int)
                row[a_idx[i+1]] = 1
                row[a_idx[i]] = -1
                A.append(row)
                lb.append(1)
                ub.append(np.inf)
            
            # sum a_i = total
            row = np.zeros(num_vars, dtype=int)
            for i in range(n):
                row[a_idx[i]] = 1
            A.append(row)
            lb.append(total)
            ub.append(total)
            
            # For each k (1..37) constraints with y_k
            for k in range(1, n):  # k from 1 to 37 inclusive, corresponds to prefix length k
                # compute prefix sum indices 0..k-1
                # First constraint: P_k - S <= M*y_k
                row = np.zeros(num_vars, dtype=int)
                for i in range(k):
                    row[a_idx[i]] = 1
                row[S_idx] = -1
                row[y_idx[k-1]] = -M  # bring M*y_k to left side: P_k - S - M*y_k <= 0
                A.append(row)
                lb.append(-np.inf)
                ub.append(0)
                # Second constraint: total - P_k - S <= M*(1 - y_k)
                row2 = np.zeros(num_vars, dtype=int)
                for i in range(k):
                    row2[a_idx[i]] = -1
                row2[S_idx] = -1
                row2[y_idx[k-1]] = M  # because total - P_k - S - M*(1 - y) <= 0 -> total - P_k - S - M + M*y <= 0 -> -P_k - S + M*y <= -total
                # Actually we need to incorporate constant total. We'll handle constant term by adjusting ub.
                # Let's rewrite: total - P_k - S <= M*(1 - y)
                # => total - P_k - S - M + M*y <= 0
                # => -P_k - S + M*y <= -total + M
                # So left side linear part: -P_k - S + M*y
                # constant term: -total + M
                # So we set ub = -total + M
                A.append(row2)
                lb.append(-np.inf)
                ub.append(-total + M)
            
            # Build LinearConstraint
            A = np.array(A, dtype=float)  # convert to float for milp
            lb = np.array(lb, dtype=float)
            ub = np.array(ub, dtype=float)
            
            lin_con = LinearConstraint(A, lb, ub)
            
            # Bounds for variables: a_i >=1, no explicit upper bound; y binary 0-1; S >=0.
            lower_bounds = np.zeros(num_vars)
            upper_bounds = np.full(num_vars, np.inf)
            
            # a_i lower bound already set via constraints, but set bounds to 0..inf
            for i in a_idx:
                lower_bounds[i] = 0  # we have constraints for >=1
                upper_bounds[i] = total  # cannot exceed total
            
            # y binary bounds
            for i in y_idx:
                lower_bounds[i] = 0
                upper_bounds[i] = 1
            
            # S bound
            lower_bounds[S_idx] = 0
            upper_bounds[S_idx] = total
            
            bounds = Bounds(lower_bounds, upper_bounds)
            
            # integrality: a_i integer, y binary integer, S integer
            integrality = np.ones(num_vars, dtype=int)  # all integer
            
            # Objective: minimize S
            c = np.zeros(num_vars)
            c[S_idx] = 1
            
            # Solve
            res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'disp': True})
            print(res)
            
