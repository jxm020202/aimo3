            import numpy as np, math
            
            def E_sd_val(s,d):
                if d < abs(9*s - 2) - 1e-12:
                    return -1e9
                numerator = d**2 * (288*(d**2 + s**2) + 144*(4*s - 1)**2 - 16)
                denominator = (2*(d**2 + s**2) + (4*s - 1)**2)**3
                return numerator/denominator
            
