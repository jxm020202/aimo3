                remaining = len(cells) - start_idx
                # maximum possible additional pieces = remaining (if each piece occupies 1 cell) but we need pairs; more accurate bound: we can add at most 2 * floor(remaining/2)
                # but also need pairs; we can bound by cur_n + 2* (remaining//2)
                if cur_n + 2*((len(cells)-start_idx)//2) <= best_n:
                    return
                # iterate over next cell not placed
                for idx in range(start_idx, len(cells)):
