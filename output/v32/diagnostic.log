                for _ in range(60):
                    mid = (lo+hi)/2
                    s = sum((ai-mid)**2 for ai in a if ai>mid)
                    if s>1:
                        lo = mid
                    else:
                        hi = mid
                return (lo+hi)/2
            
            def feasible_points(num=100000):
                pts=[]
                for _ in range(num):
                    # random barycentric coordinates for triangle
                    u = random.random()
                    v = random.random()
                    if u+v>1:
                        u=1-u
                        v=1-v
                    # vertices: (2,0,0), (0,4,0), (0,0,6)
                    x = 2*u
                    y = 4*v
                    z = 6*(1-u-v)
                    # ensure positivity (strict >0) but we can allow zero for sampling
                    pts.append((x,y,z))
