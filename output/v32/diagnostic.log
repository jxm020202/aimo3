                    a,b,c = [random.randint(1,6) for _ in range(3)]
                    # choose best die to keep
                    mapping = {1:5,2:4,3:3,4:2,5:1,6:0}
                    # choose die with max mapping
                    # if tie choose any
                    # we just compute probability by enumerating re-roll outcomes
                    # Instead simulate re-roll after picking best die
                    # Determine which die to keep: choose one with max mapping
                    # if multiple, choose first
                    vals = [a,b,c]
                    max_map = max(mapping[v] for v in vals)
                    # choose a die with that max (first)
                    for i,v in enumerate(vals):
                        if mapping[v]==max_map:
                            keep = v
                            break
                    # re-roll two dice
                    x,y = random.randint(1,6), random.randint(1,6)
                    if keep + x + y == 7:
                        success+=1
                return success/N
            
