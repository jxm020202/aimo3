                from sympy import totient
                phi = int(totient(d))
                # compute exponent e = 2025! mod phi (if gcd(3,d)=1)
                if math.gcd(3, d) == 1:
                    e = factorial_mod(2025, phi)
                    # Since exponent may be 0 mod phi, but we need exponent modulo phi, but if e == 0, exponent should be phi
                    # because 3^{phi} ≡1, so 3^{0} ≡1 as well. So we can use pow(3, e, d)
                    return pow(3, e, d)
                else:
