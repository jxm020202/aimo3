            def union_area(theta, N=800):
                # approximate area of union of four squares (R shifted by vertices) intersected with torus [0,1]^2
                # We'll sample grid points in torus and test if point lies in any of the four shifted squares.
                xs = np.linspace(0,1,N,endpoint=False)+0.5/N
                ys = np.linspace(0,1,N,endpoint=False)+0.5/N
                cos = math.cos(theta)
                sin = math.sin(theta)
                count=0
                for x in xs:
                    for y in ys:
                        # point (x,y) in torus; we need to check if it belongs to any shifted square.
                        # Equivalent to check if (x - v) lies in rotated square for some vertex v
                        inside=False
                        for vx,vy in [(0,0),(1,0),(0,1),(1,1)]:
                            # translate point relative to vertex
                            dx = x - vx
                            dy = y - vy
                            # rotate by -theta to align square axes
                            xr = cos*dx + sin*dy
                            yr = -sin*dx + cos*dy
                            if abs(xr) <= 0.5 and abs(yr) <= 0.5:
                                inside=True
                                break
                        if inside:
                            count+=1
                return count/(N*N)
            
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/4]:
                print(th, union_area(th, N=400))
            
