            def f_ab(a,b):
                # a,b >=0
                A2 = (a+b)**2
                num = 64 * (a+b)**2 * (5*a*a + 8*a*b + 5*b*b)
                S = 4*(a*a + b*b) + (1 - 16*(b - a)**2)/9
                if S <= 0:
                    return -1
                return num / (S**3)
            
            def random_search(n=2000000):
