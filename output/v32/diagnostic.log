            def generate_tuples():
                res=set()
                for xs in itertools.product(range(1,11), repeat=4):
                    if sum(xs)%20!=0:
                        continue
                    s0=0
                    s1=xs[0]%20
                    s2=(xs[0]+xs[1])%20
                    s3=(xs[0]+xs[1]+xs[2])%20
                    # distinctness and non-zero
                    if len({s0,s1,s2,s3})!=4 or s1==0 or s2==0 or s3==0:
                        continue
                    # for each a in 1..19 not equal to any of s1,s2,s3
                    for a in range(1,20):
                        if a in {s1,s2,s3}:
                            continue
                        # compute vertices
                        # map residues: we treat a as residue
                        b = (a - xs[0]) % 20
                        c = (b - xs[1]) % 20
                        d = (c - xs[2]) % 20
                        # ensure they are in 1..19 (non-zero)
                        if 0 in (a,b,c,d):
                            continue
                        # convert residues to numbers (they already are 0..19)
                        # but we need 1..19 mapping: residue 0 is excluded.
                        # So just keep as ints.
                        res.add((a,b,c,d))
                return res
            
