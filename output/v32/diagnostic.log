            def area_proj(theta, N=2000):
                # sample grid points in Sθ and map modulo 1
                # We'll generate many random points inside Sθ and approximate area via Monte Carlo.
                # Use rejection sampling: generate points uniformly in bounding box of Sθ.
                # Compute area fraction of unit torus covered by points.
                # Actually we need measure of image set, not probability that a random point in torus is hit.
                # But we can approximate by sampling many points in torus and checking if they are in the image.
                # Equivalent to checking if there exists a point in Sθ that maps to that torus point.
                # This is same as checking if the torus point lies within the projection of Sθ.
                # Since Sθ is convex, we can test by solving for integer translations.
                # Simpler: generate many points in Sθ, map modulo 1, collect them, approximate area via grid.
                M = N
                # generate many points uniformly in Sθ using random convex combination of vertices
                # vertices of Sθ:
                verts = []
                for sx in (-0.5, 0.5):
                    for sy in (-0.5, 0.5):
                        x = sx*math.cos(theta) - sy*math.sin(theta)
                        y = sx*math.sin(theta) + sy*math.cos(theta)
                        verts.append((x,y))
                verts = np.array(verts)
                # Use barycentric coordinates: pick random point as convex combination of two edges? easier: sample uniformly in square before rotation.
                # Sample (u,v) uniform in [-0.5,0.5]^2 then rotate.
                pts = np.random.rand(M,2)-0.5
                rot = np.array([[math.cos(theta), -math.sin(theta)],[math.sin(theta), math.cos(theta)]])
                pts = pts @ rot.T
                # map modulo 1 to [0,1)
                pts_mod = np.mod(pts, 1.0)
                # create grid occupancy
                grid = np.zeros((N,N), dtype=bool)
                ix = (pts_mod[:,0]*N).astype(int) % N
                iy = (pts_mod[:,1]*N).astype(int) % N
                grid[iy, ix] = True
                # approximate area as fraction of cells occupied
                return grid.mean()
            
            def estimate_p(num_theta=200, samples_per_theta=20000, Ngrid=500):
                thetas = np.linspace(0, math.pi/2, num_theta, endpoint=False)
                area_vals = []
                for th in thetas:
                    area = area_proj(th, N=Ngrid)
                    area_vals.append(area)
                avg_area = np.mean(area_vals)
                p = 1 - avg_area
                return p, avg_area, thetas, area_vals
            
            p_est, avg_area, thetas, area_vals = estimate_p(num_theta=40, Ngrid=400)
            p_est, avg_area
