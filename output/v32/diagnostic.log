                if abs(sum(seq))>1e-9:
                    return False
                for i in range(n):
                    diff=seq[i]-seq[(i+1)%n]
                    if abs(diff)>1+1e-9:
                        return False
                return True
            
            # try random walk with step size <=1, then adjust to zero sum by subtracting mean?
            def random_seq():
                n=60
                seq=[0.0]
                for i in range(1,n):
                    step=random.uniform(-1,1)
                    seq.append(seq[-1]+step)
                # Now we have arbitrary values, not necessarily satisfy cyclic diff between last and first.
                # We'll adjust by adding a constant to all to make sum zero? That changes diff zero.
                # Instead we can try to enforce cyclic diff by adjusting final step.
                # Let's compute diff between last and first; we need |seq[-1]-seq[0]| <=1.
                # If not, we can scale down steps.
                return seq
            
            # Let's generate many random sequences and check feasibility.
            def generate_feasible(trials=10000):
                n=60
                for _ in range(trials):
                    seq=[0.0]
                    for i in range(1,n):
                        step=random.uniform(-1,1)
                        seq.append(seq[-1]+step)
                    # Now we have seq; compute diff between last and first
                    if abs(seq[-1]-seq[0])>1:
                        continue
                    # Now adjust to zero sum by subtracting mean
                    mean=sum(seq)/n
                    seq2=[x-mean for x in seq]
                    # This shift does not affect differences, so diff constraints still hold.
                    if feasible(seq2):
                        return seq2
                return None
            
            seq=generate_feasible(200000)
            seq[:10], sum(seq), max(abs(seq[i]-seq[(i+1)%60]) for i in range(60))
            
