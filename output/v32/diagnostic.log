            def construct_solution(n):
                L = 2**n
                # order N = L-1
                N = L-1
                # primitive N-th root of unity
                t = cmath.exp(2j*math.pi/N)
                # r_i = t^{2^{i-1}}
                r = [t**(2**(i)) for i in range(n)]  # careful: exponent 2^{i}
                # Actually we need c_i = 2^{i-1}, i from 1..n
                r = [t**(2**(i-1)) for i in range(1,n+1)]
                return r, t
            
            def check_solution(n, m):
                r, t = construct_solution(n)
                for j in range(1, m+1):
                    prod = 1
                    for val in r:
                        prod *= (val**j + 1)
                    if abs(prod - 1) > 1e-6:
                        return False, j, prod
                return True, None, None
            
            for n in range(1,6):
                L = 2**n
                ok, j, prod = check_solution(n, L-2)
                print(n, ok, j)
            
