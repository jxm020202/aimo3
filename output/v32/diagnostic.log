            for dom_id, block_info in dom_block_constraints.items():
                for dirc, block_cells in block_info:
                    # neighbor set: all dominos covering any of block_cells
                    neighbor_set = set()
                    for cell in block_cells:
                        neighbor_set.update(cell_to_dominos[cell])
                    # ensure neighbor_set does not include dom_id (shouldn't)
                    if dom_id in neighbor_set:
                        neighbor_set.remove(dom_id)
                    # Build inequality: -sum_{j in neighbor_set} d_j + d_i <= 0
                    A = np.zeros(n_vars)
                    A[dom_id] = 1
                    for j in neighbor_set:
                        A[j] -= 1
                    constraints.append(LinearConstraint(A, -np.inf, 0))
            
            len(constraints)
            
