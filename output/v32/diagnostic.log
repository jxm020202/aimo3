            def has_solution_odd(s):
                # s odd
                for x in range(2, s-1, 2):  # x even
                    y = s - x
                    if y < 2:
                        continue
                    # need v odd, v^2 multiple of m = 4s / gcd(x,4s)
                    g = math.gcd(x, 4*s)
                    m = (4*s)//g
                    # compute minimal L such that L^2 divisible by m
                    # factor m
                    fac = sp.factorint(m)
                    L = 1
                    for p, e in fac.items():
                        L *= p**((e+1)//2)  # ceil(e/2)
                    # L must be odd (since v odd) and less than y
                    if L % 2 == 1 and L < y:
                        return True, (x, y, L)
                return False, None
            
            def find_first_odds(start, count):
                res=[]
                s=start
                while len(res)<count:
                    if s%2==1:
                        ok,_=has_solution_odd(s)
                        if ok:
                            res.append(s)
                    s+=1
                return res
            
