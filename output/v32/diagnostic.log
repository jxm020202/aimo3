            import math
            
            def last_nonzero_digit_factorial(n):
                # compute last non-zero digit of n! using known recurrence or direct multiplication ignoring zeros
                # We'll use recurrence for speed
                if n==0:
                    return 1
                # recursion
                # Use iterative approach
                res=1
                while n>0:
                    # n%5 part
                    # precomputed table for last non-zero digit of product of numbers 1..r ignoring multiples of 5
                    # Actually L(n%5) values:
                    table = [1,1,2,6,4]  # last non-zero digit of (r)! for r=0..4
                    res = (res * table[n%5] * pow(2, n//5, 10)) % 10
                    n //= 5
                return res
            
            # test small n
            for i in range(1,21):
                print(i, last_nonzero_digit_factorial(i))
            
