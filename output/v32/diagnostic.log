            def max_edges_bruteforce_limit(n):
                m = n*(n-1)//2
                max_e = 0
                for mask in range(1<<m):
                    ecount = bin(mask).count('1')
                    if ecount <= max_e:
                        continue
                    # adjacency
                    adj = [[0]*n for _ in range(n)]
                    idx=0
                    for i in range(n):
                        for j in range(i+1,n):
                            if mask>>idx & 1:
                                adj[i][j]=adj[j][i]=1
                            idx+=1
                    ok=True
                    for u in range(n):
                        found=False
                        for v in range(n):
                            if u==v: continue
                            if adj[u][v]==1:
                                # check common neighbor
                                common=False
                                for w in range(n):
