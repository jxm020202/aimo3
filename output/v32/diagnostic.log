                    # For d containing factor 3, we can compute directly using exponent reduction using Carmichael lambda for prime powers.
                    # For 3^a, lambda = 2*3^{a-1} for a>=2 (since for odd prime p, lambda(p^a)=phi(p^a)=p^{a-1}(p-1)).
                    # For 3^1=3, lambda=2.
                    # So we can compute exponent mod lambda(3^a) for that component.
                    # Let's factor d.
                    fac = factorint(d)
                    # compute result via CRT
                    mods = []
                    rems = []
                    for prime, exp in fac.items():
                        mod_i = prime**exp
                        if prime == 3:
                            lam = 2 * (3**(exp-1)) if exp>=2 else 2
                            e_i = factorial_mod(2025, lam)
                            rem_i = pow(3, e_i, mod_i)
                        else:
                            phi_i = (prime-1)*(prime**(exp-1))
                            e_i = factorial_mod(2025, phi_i)
                            rem_i = pow(3, e_i, mod_i)
                        mods.append(mod_i)
                        rems.append(rem_i)
                    # combine using CRT
                    from sympy.ntheory.modular import crt
                    result = crt(mods, rems)[0] % d
                    return int(result)
            
