                        path += [a, a+1, a+2, a+1, a+2, a+3, a+2, a+3]
                    # tail length 3
                    a = 4*q+1
                    path += [a, a+1, a+2, a+1]
                else: # n%4==1
                    if n==5:
                        # tail only
                        a = 1
                        path += [a+1, a, a+1, a+2, a+3, a+4, a+3]
                        return path
                    q = (n-5)//4
                    for j in range(q):
                        a = 4*j+1
                        path += [a, a+1, a+2, a+1, a+2, a+3, a+2, a+3]
                    a = 4*q+1
                    # tail length 5 pattern
                    path += [a+1, a, a+1, a+2, a+3, a+4, a+3]
                return path
            
            def verify_path(path, n):
                # simulate flips
                state = [1 if i%2==1 else 0 for i in range(1,n+1)]
                for pos in path:
                    state[pos-1] ^= 1
                return all(s==0 for s in state)
            
            for n in range(1,25,2):
                p = construct_path(n)
                ok = verify_path(p, n)
                print(n, len(p), ok)
            
