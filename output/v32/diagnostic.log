            def estimate_p_batch(total_samples, batch_size=1000000):
                remaining = total_samples
                count_uncovered = 0
                while remaining > 0:
                    n = min(batch_size, remaining)
                    # generate
                    theta = np.random.rand(n) * (math.pi/2)
                    cos = np.cos(theta)
                    sin = np.sin(theta)
                    x = np.random.rand(n)
                    y = np.random.rand(n)
                    covered = np.zeros(n, dtype=bool)
                    for i,j in [(0,0),(1,0),(0,1),(1,1)]:
                        u = (x - i) * cos + (y - j) * sin
                        v = -(x - i) * sin + (y - j) * cos
                        inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)
                        covered |= inside
                    uncovered = ~covered
                    count_uncovered += uncovered.sum()
                    remaining -= n
                return count_uncovered / total_samples
            
            p_est = estimate_p_batch(20000000, batch_size=2000000)
            print(p_est, p_est*1000)
            
