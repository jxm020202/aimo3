            def compute_f_components(seq):
                n=len(seq)
                a=seq
                # compute contributions per gap
                # odd gaps: for k from 1 to G (where G = (n-1)//2)
                G = (n-1)//2
                # odd values list
                odd = [a[2*k] for k in range(G+1)]  # indices 0,2,4,... (0-based)
                # compute deltas
                deltas = [odd[k] - odd[k-1] for k in range(1, len(odd))]
                # compute v_k after each gap (odd value)
                v = odd[1:]  # v_k for k=1..G
                # compute sum 2* v_k * delta_k for k=1..G-1
                sum_2 = sum(2*v[k]*deltas[k] for k in range(G-1))
                # final contribution
                final = v[-1] * deltas[-1]  # v_G * delta_G
                return sum_2, final, sum_2+final+2
            
            seq = build_sequence()
            sum2, final, total = compute_f_components(seq)
            sum2, final, total
            
