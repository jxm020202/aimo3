            def count_tetrahedron():
                # Build tetrahedron graph (K4)
                import itertools
                # edges: list of pairs (i,j) for i<j, vertices 0..3
                edges = [(i,j) for i in range(4) for j in range(i+1,4)]
                edge_index = {e:i for i,e in enumerate(edges)}
                # faces: each combination of 3 vertices forms a triangle
                faces = [tuple(sorted([edge_index[tuple(sorted((a,b)))],
                                     edge_index[tuple(sorted((a,c)))],
                                     edge_index[tuple(sorted((b,c)))])) for a,b,c in itertools.combinations(range(4),3)]
                # compute count via brute force
                count_brute = 0
                for colors in itertools.product(range(3), repeat=len(edges)):
                    ok = True
                    for f in faces:
                        c = [colors[e] for e in f]
                        if len(set(c))==1 or len(set(c))==3:
                            ok=False
                            break
                    if ok:
                        count_brute+=1
                return count_brute
            
            print(count_tetrahedron())
            
