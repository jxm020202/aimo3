            plane_normals = []
            plane_cs = []
            for (a,b,c) in faces:
                # compute normal using cross product (b-a) x (c-a)
                n = sp.Matrix([b.x-a.x, b.y-a.y, b.z-a.z]).cross(sp.Matrix([c.x-a.x, c.y-a.y, c.z-a.z]))
                # orientation: outward normal? Determine by checking that opposite vertex is on opposite side.
                # We'll compute unit normal outward such that n·(opposite vertex - a) < 0 (since interior is opposite side)
                # opposite vertex:
                opp = [v0,v1,v2,v3]
                # find vertex not in face
                opp_vertex = None
                for v in [v0,v1,v2,v3]:
                    if v not in (a,b,c):
                        opp_vertex = v
                        break
                # compute sign
                sign = sp.sign((sp.Matrix([opp_vertex.x-a.x, opp_vertex.y-a.y, opp_vertex.z-a.z]).dot(n)))
                # we want outward normal pointing away from interior, i.e., interior side is opposite of outward.
                # interior side contains centroid (average of vertices)
                centroid = sp.Point3D((v0.x+v1.x+v2.x+v3.x)/4, (v0.y+v1.y+v2.y+v3.y)/4, (v0.z+v1.z+v2.z+v3.z)/4)
                # compute dot for centroid
                interior_dot = sp.Matrix([centroid.x-a.x, centroid.y-a.y, centroid.z-a.z]).dot(n)
                # if interior_dot >0, then n points outward? Actually interior side should satisfy n·(x-a) <= 0 if n outward.
                # Let's set outward normal such that n·(centroid - a) < 0.
                if interior_dot > 0:
                    n = -n
                # unit normal
                n_len = sp.sqrt(n.dot(n))
                n_unit = n / n_len
                # compute c = n_unit·a (plane constant)
                c_val = n_unit.dot(sp.Matrix([a.x, a.y, a.z]))
                plane_normals.append(n_unit)
                plane_cs.append(c_val)
            plane_normals, plane_cs
            
