            def check_solution(selected):
                # compute indegree per vertex
                indeg = collections.Counter()
                for u,v in selected:
                    indeg[v] += 1
                    if indeg[v] > 1:
                        return False, "indegree >1"
                # check pairwise condition
                for i in range(len(selected)):
                    a,b = selected[i]
                    for j in range(i+1, len(selected)):
                        c,d = selected[j]
                        # check linking condition
                        linked = (b == c) or (d == a)
                        if linked:
                            continue
                        # compute Euclidean distance between endpoints b and d
                        dist = math.hypot(b[0]-d[0], b[1]-d[1])
                        if dist < 2 - 1e-9:
                            return False, f"pair {i},{j} distance {dist}"
                return True, "ok"
            
