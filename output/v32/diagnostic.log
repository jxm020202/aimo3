                for _ in range(L):
                    new = set()
                    for val in representable:
                        # add term +2^b for b up to some bound
                        # To bound, we can limit b such that 2^b <= max_val + some margin
                        # We'll just try b up to, say, 10 for small L
                        for b in range(0, 10):
                            new.add(val + (1<<b))
                            new.add(val - (1<<b))
                    representable.update(new)
                # Now find minimal positive integer not in representable up to max_val
                for n in range(1, max_val+1):
                    if n not in representable:
                        return n
                return None
            
