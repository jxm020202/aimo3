            import math
            
            total = 1997
            best = None
            best_info = None
            for m in range(0, 38):  # m = number before a_k
                n = 37 - m  # number after a_k
                # compute L minimal sum of first m numbers
                L = m*(m+1)//2
                # compute T = total - (L + minimal sum of n numbers after a_k, but we need a_k)
                # formula: total = L + a_k + n*a_k + n(n+1)/2 = L + (n+1)*a_k + n(n+1)/2
                # solve for a_k
                RHS = total - L - n*(n+1)//2
                # a_k = RHS / (n+1)
                if (n+1) == 0:
                    continue
                a_k_frac = RHS / (n+1)
                # compute R minimal sum after a_k using a_k value
                R = n * a_k_frac + n*(n+1)/2
                S = max(L, R)
                # check integer a_k and >= m+1
                if RHS % (n+1) == 0:
                    a_k = RHS // (n+1)
                    feasible = a_k >= m+1
                else:
                    feasible = False
                # store best theoretical S
                if best is None or S < best:
                    best = S
                    best_info = (m, n, L, a_k_frac, R, S, feasible)
            best, best_info
            
