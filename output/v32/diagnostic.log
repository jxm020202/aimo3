            import random, math, numpy as np
            
            def proj_area(theta, N=200000):
                # sample points uniformly in square centered at origin side 1 rotated by theta
                # generate points in original axis-aligned square [-0.5,0.5]^2 then rotate
                cos, sin = math.cos(theta), math.sin(theta)
                xs = np.random.rand(N) - 0.5
                ys = np.random.rand(N) - 0.5
                # rotate
                xr = xs * cos - ys * sin
                yr = xs * sin + ys * cos
                # map to [0,1) via modulo
                xr_mod = np.mod(xr, 1.0)
                yr_mod = np.mod(yr, 1.0)
                # approximate area via grid occupancy
                # use 500x500 grid
                M = 500
                # compute indices
                ix = np.floor(xr_mod * M).astype(int)
                iy = np.floor(yr_mod * M).astype(int)
                # unique cells
                cells = set(zip(ix, iy))
                return len(cells) / (M*M)
            
            def estimate_A(theta):
                return proj_area(theta, N=200000)
            
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/4]:
