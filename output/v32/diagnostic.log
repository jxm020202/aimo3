            import numpy as np, math, random, itertools, sys, math, numpy as np
            from scipy.optimize import minimize
            
            def objective(vars):
                x1,y1,z1,x2,y2,z2 = vars
                # we want max absolute diff
                return max(abs(x2-x1), abs(y2-y1), abs(z2-z1))
            
            def constraints():
                cons = []
                # sphere equality
                cons.append({'type':'eq', 'fun': lambda v: v[0]**2 + v[1]**2 + v[2]**2 - 1})
                # plane equality
                cons.append({'type':'eq', 'fun': lambda v: 6*v[3] + 3*v[4] + 2*v[5] - 12})
                # positivity
                for i in range(3,6):
                    cons.append({'type':'ineq', 'fun': lambda v, i=i: v[i]}) # v[i] >0
                return cons
            
            # random initial guesses
            best = 1e9
            best_vars = None
            for _ in range(30):
                # random point on sphere
                a = np.random.normal(size=3)
                a = a/np.linalg.norm(a)
                # random point on plane positive
                # generate random x2,y2 then compute z2
                x2 = random.random()*2 # up to 2 maybe
                y2 = random.random()*4
                # ensure inside triangle: 2x2 + y2 < 4
                if 2*x2 + y2 >= 4:
                    continue
                z2 = 6 - 3*x2 - 1.5*y2
                if z2 <= 0:
                    continue
                init = np.concatenate([a, [x2,y2,z2]])
                res = minimize(objective, init, constraints=constraints(), method='SLSQP')
                if res.success:
                    val = objective(res.x)
                    if val < best:
                        best = val
