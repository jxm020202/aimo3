            def greedy_max_edges_start(n, trials=200):
                # start with perfect matching (n even)
                adj=[set() for _ in range(n)]
                for i in range(0,n,2):
                    adj[i].add(i+1); adj[i+1].add(i)
                # ensure condition holds (matching edges are triangle-free)
                edges=list(itertools.combinations(range(n),2))
                random.shuffle(edges)
                for (i,j) in edges:
                    # skip if already edge
                    if j in adj[i]:
                        continue
                    # try add edge
                    adj[i].add(j); adj[j].add(i)
                    if not condition_ok_adj(adj):
                        adj[i].remove(j); adj[j].remove(i)
                e=sum(len(s) for s in adj)//2
                return e
            
