            def min_interior_sum_analytic(a,b):
                # M=11 interior steps weights w_i = 12-i for i=1..11
                w = np.arange(11,0,-1)  # 11..1
                # total steps 12, last step weight 0
                # we need to choose s_i for i=1..12 with bounds [-1,1] and sum = b-a.
                # Since s_12 weight 0, we can ignore it except for feasibility.
                delta = b - a
                # We'll assign s_i for i=1..11; s_12 = delta - sum_{i=1}^{11} s_i, must be within [-1,1].
                # We'll search over possible number of +1's among first 11 steps.
                best = None
                # Since s_i are at bounds -1 or 1 except possibly one fractional to meet delta and s_12 bound.
                # We'll brute over possible sum S = sum_{i=1}^{11} s_i in feasible range.
                # S must be such that delta - S ∈ [-1,1].
                # So S ∈ [delta-1, delta+1].
                # Also S must be achievable with 11 steps each -1 or 1: S = 2k - 11 for integer k=0..11.
                # If delta is not integer, we may need fractional s_i; but we can also adjust by using fractional for one step.
                # We'll allow fractional by solving linear programming directly using scipy for robustness.
                import itertools, math
                # Use linear programming for exact result
                from scipy.optimize import linprog
                c = w.astype(float)  # objective coefficients for s_1..s_11
                # variables s_1..s_12
                c_full = np.concatenate([c, [0.0]])
                A_eq = np.ones((1,12))
                b_eq = np.array([delta])
                bounds = [(-1,1)]*12
                res = linprog(c_full, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
                if not res.success:
                    raise ValueError("LP failed")
                obj = res.fun
                interior_sum = 11*a + obj
                return interior_sum
            
