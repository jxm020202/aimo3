            import numpy as np, math, time
            
            def estimate_vec(N):
                # generate N random centers and angles
                c = np.random.rand(N,2)  # uniform [0,1)
                theta = np.random.rand(N)*2*math.pi
                cos = np.cos(theta)
                sin = np.sin(theta)
                # points array
                points = np.array([[0,0],[1,0],[0,1],[1,1]])
                # For each point, compute condition
                # We'll compute for each trial whether any point inside
                # Use broadcasting
                # shape (N,4,2) differences
                diff = points[None,:,:] - c[:,None,:]  # N x 4 x 2
                # rotate by -theta: x' = dx*cos + dy*sin, y' = -dx*sin + dy*cos
                xprime = diff[:,:,0]*cos[:,None] + diff[:,:,1]*sin[:,None]
                yprime = -diff[:,:,0]*sin[:,None] + diff[:,:,1]*cos[:,None]
                inside = (np.abs(xprime) <= 0.5) & (np.abs(yprime) <= 0.5)
                any_inside = inside.any(axis=1)
                return 1 - any_inside.mean()
            
            for N in [2000000,5000000,10000000]:
                start=time.time()
                p_est=estimate_vec(N)
                print(N, p_est, "time", time.time()-start)
            
