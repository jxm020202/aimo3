            import itertools
            
            def min_f(n, M):
                # n odd, a_1=1, a_n=M
                # monotone nondecreasing integer sequence
                best = None
                best_seq = None
                # generate all nondecreasing sequences length n with values between 1 and M inclusive, endpoints fixed
                # use recursion/backtracking to prune
                def backtrack(idx, prev, seq):
                    nonlocal best, best_seq
                    if idx == n:
                        # compute f
                        a = seq
                        f = sum(x*x for x in a) - sum(a[i]*a[i+2] for i in range(n-2))
                        if best is None or f < best:
                            best = f
                            best_seq = a[:]
                        return
                    # idx is 0-based; need to set a[idx]
                    # Determine allowed range: from prev to M (if last index)
                    low = prev
                    high = M if idx == n-1 else M
                    for val in range(low, high+1):
                        seq.append(val)
                        backtrack(idx+1, val, seq)
                        seq.pop()
                # start with a1=1
                backtrack(1, 1, [1])
                return best, best_seq
            
