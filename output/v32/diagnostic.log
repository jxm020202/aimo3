            def min_weight_bruteforce(m):
                total = 2**m - 1
                max_edge = 2**(m-1)
                best = None
                best_vec = None
                # enumerate n_k values within bounds
                # Since m up to maybe 11, enumeration may be large (max_edge+1)^m ~ huge.
                # But we can use recursion.
                def rec(k, remaining, current):
                    nonlocal best, best_vec
                    if k == m:
                        if remaining == 0:
                            # compute weight
                            weight = sum(current[i] / (2**i) for i in range(m))
                            if best is None or weight < best:
                                best = weight
                                best_vec = current.copy()
                        return
                    # Determine parity constraint
                    parity = 1 if k == 0 else 0  # need odd for k=0, even for others
                    # possible values for n_k: from parity up to min(max_edge, remaining) step 2
                    start = parity
                    for val in range(start, min(max_edge, remaining)+1, 2):
                        current.append(val)
                        rec(k+1, remaining - val, current)
                        current.pop()
                rec(0, total, [])
                return best, best_vec
            
            for m in range(1,7):
                best, vec = min_weight_bruteforce(m)
                print(m, best, vec)
            
