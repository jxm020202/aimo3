                for assignment_int in range(3**m):
                    # decode base-3
                    colors = []
                    x = assignment_int
                    for _ in range(m):
                        colors.append(x%3)
                        x//=3
                    # map to edge id
                    col_map = dict(zip(edges, colors))
                    ok = True
                    for ti in tri_indices:
