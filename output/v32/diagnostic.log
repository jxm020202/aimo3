            def solve_two_cells():
                N=2
                num_vars = N*N + 1
                import numpy as np
                # constraints: each cell assigned one number
                A_eq = []
                b_eq = []
                # cell0
                row = np.zeros(num_vars, int)
                row[0:2] = 1
                A_eq.append(row); b_eq.append(1)
                # cell1
                row = np.zeros(num_vars, int)
                row[2:4] = 1
                A_eq.append(row); b_eq.append(1)
                # each number assigned to one cell
                row = np.zeros(num_vars, int)
                row[0::2] = 1  # number1 assigned to cell0 or cell1
                A_eq.append(row); b_eq.append(1)
                row = np.zeros(num_vars, int)
                row[1::2] = 1
                A_eq.append(row); b_eq.append(1)
                # edge constraint: S - sum_i - sum_j <= 0
                row = np.zeros(num_vars, int)
                # sum_i = 1*y_i1 + 2*y_i2
                row[0] = -1
                row[1] = -2
                row[2] = -1
                row[3] = -2
                row[-1] = 1
                A_ub = np.array([row])
                b_ub = np.array([0])
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
