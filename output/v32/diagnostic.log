            def upper_bound(N):
                total = N*N
                corners = 4
                edge_noncorner = 4*(N-2)
                interior = total - corners - edge_noncorner
                deg2, deg3, deg4 = 2,3,4
                # assign smallest numbers to corners, next to edges, rest to interior
                nums = list(range(1,total+1))
                # smallest corners
                corner_nums = nums[:corners]
                edge_nums = nums[corners:corners+edge_noncorner]
                interior_nums = nums[corners+edge_noncorner:]
                weighted = sum(deg2*x for x in corner_nums) + sum(deg3*x for x in edge_nums) + sum(deg4*x for x in interior_nums)
                E = 2*total - N - N
                return weighted//E, weighted/E
            
            print(upper_bound(8))
            
