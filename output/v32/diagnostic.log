            from functools import lru_cache
            
            size = 15
            N = size*size
            coords = [(i//size, i%size) for i in range(N)]
            
            def cheb_dist(a,b):
                return max(abs(a[0]-b[0]), abs(a[1]-b[1]))
            
            neighbor_mask = [0]*N
            neighbors = [[] for _ in range(N)]
            for i in range(N):
                mask = 0
                for j in range(N):
                    if cheb_dist(coords[i], coords[j]) <= 2:
                        mask |= 1 << j
                        if i != j:
                            neighbors[i].append(j)
                neighbor_mask[i] = mask
            
            # Precompute neighbor list as tuple for speed
            neighbors = [tuple(lst) for lst in neighbors]
            
            best = 0
            cache = {}
            
            def popcount(x):
                return x.bit_count()
            
            def dfs(available_mask, count):
                global best, cache
                # prune by upper bound
                rem = popcount(available_mask)
                if count + 2*(rem//2) <= best:
                    return
                if available_mask == 0:
                    if count > best:
                        best = count
                    return
                # memoization: if we have seen this mask with >= count, prune
                prev = cache.get(available_mask)
                if prev is not None and prev >= count:
                    return
                cache[available_mask] = count
                # select vertex with minimal available neighbors
                # iterate over bits to find min degree
                # we can get list of vertices in mask
                # but for speed, we can sample first few bits
                # We'll compute degrees for each candidate and pick min
                v = None
                min_deg = None
                m = available_mask
                while m:
                    i = (m & -m).bit_length() - 1
                    # compute degree: number of neighbors (including itself) that are available
                    # neighbor_mask[i] & available_mask
                    deg = popcount(neighbor_mask[i] & available_mask)
                    if min_deg is None or deg < min_deg:
                        min_deg = deg
                        v = i
                        if deg == 1:  # only itself, cannot be paired, we can skip directly
                            break
                    m &= m-1
                # Option 1: skip v
                dfs(available_mask & ~(1 << v), count)
                # Option 2: pair v with each neighbor w (available) where w != v
                # If deg == 1, no neighbor, cannot pair
                if min_deg > 1:
                    # iterate neighbors
                    for w in neighbors[v]:
                        if (available_mask >> w) & 1:
                            # pair v-w
                            new_mask = available_mask & ~ (neighbor_mask[v] | neighbor_mask[w])
                            dfs(new_mask, count+2)
            
            full_mask = (1 << N) - 1
            dfs(full_mask, 0)
            print("best", best)
            
