            def triple_intersect_est(theta, N=200000):
                cos, sin = math.cos(theta), math.sin(theta)
                w = abs(math.cos(theta)) + abs(math.sin(theta))
                L = w/2 + 1
                xs = np.random.uniform(-L, L, N)
                ys = np.random.uniform(-L, L, N)
                # transform to square coordinates
                xr = xs * cos + ys * sin
                yr = -xs * sin + ys * cos
                in_S = (np.abs(xr) <= 0.5) & (np.abs(yr) <= 0.5)
                # shift (1,0)
                xs1 = xs - 1
                ys1 = ys
                xr1 = xs1 * cos + ys1 * sin
                yr1 = -xs1 * sin + ys1 * cos
                in_S1 = (np.abs(xr1) <= 0.5) & (np.abs(yr1) <= 0.5)
                # shift (0,1)
                xs2 = xs
                ys2 = ys - 1
                xr2 = xs2 * cos + ys2 * sin
                yr2 = -xs2 * sin + ys2 * cos
                in_S2 = (np.abs(xr2) <= 0.5) & (np.abs(yr2) <= 0.5)
                in_all = in_S & in_S1 & in_S2
                return np.mean(in_all) * (2*L)*(2*L)
            
            for th in np.linspace(0, math.pi/2, 9):
                print(th, triple_intersect_est(th, N=300000))
            
