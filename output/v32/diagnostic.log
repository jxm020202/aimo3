            import math, itertools
            
            def overlap_polygon_adj(theta):
                # returns list of vertices of intersection polygon (convex) for squares centered at (0,0) and (1,0)
                # define lines as (a,b,c) representing a*x + b*y = c
                lines = []
                # square 0
                a0 = math.cos(theta)
                b0 = math.sin(theta)
                # first pair: a0*x + b0*y = ±0.5
                lines.append(( a0,  b0,  0.5))
                lines.append(( a0,  b0, -0.5))
                # second pair: -sinθ*x + cosθ*y = ±0.5
                a1 = -math.sin(theta)
                b1 =  math.cos(theta)
                lines.append(( a1, b1,  0.5))
                lines.append(( a1, b1, -0.5))
                # square 1 centered at (1,0)
                # (x-1)*cosθ + y*sinθ = ±0.5 => a0*x + b0*y = 0.5 + a0*1 = 0.5 + a0
                lines.append(( a0, b0, 0.5 + a0))
                lines.append(( a0, b0, -0.5 + a0))
                # -(x-1)*sinθ + y*cosθ = ±0.5 => a1*x + b1*y = 0.5 + a1*1? Wait compute:
                # -(x-1)*sinθ + y*cosθ = -x*sinθ + sinθ + y*cosθ = a1*x + b1*y + sinθ = ±0.5
                # So a1*x + b1*y = ±0.5 - sinθ
                lines.append(( a1, b1, 0.5 - math.sin(theta)))
                lines.append(( a1, b1, -0.5 - math.sin(theta)))
                # Now compute intersection points of each pair of lines
                pts = []
                for (i, (a1,b1,c1)) in enumerate(lines):
                    for (j, (a2,b2,c2)) in enumerate(lines):
                        if j <= i:
                            continue
                        det = a1*b2 - a2*b1
                        if abs(det) < 1e-12:
                            continue
                        x = (c1*b2 - c2*b1)/det
                        y = (a1*c2 - a2*c1)/det
                        # check if point satisfies all inequalities (within tolerance)
                        ok = True
                        # inequalities: for each line we have both <= and >= constraints
                        # We'll check using original square constraints:
                        # For square 0:
                        if not (abs(x*math.cos(theta) + y*math.sin(theta)) <= 0.5 + 1e-9 and abs(-x*math.sin(theta) + y*math.cos(theta)) <= 0.5 + 1e-9):
                            ok = False
                        # For square 1:
                        if not (abs((x-1)*math.cos(theta) + y*math.sin(theta)) <= 0.5 + 1e-9 and abs(-(x-1)*math.sin(theta) + y*math.cos(theta)) <= 0.5 + 1e-9):
                            ok = False
                        if ok:
                            pts.append((x,y))
                # Remove duplicates (within tolerance)
                uniq = []
                for p in pts:
                    if not any(math.hypot(p[0]-q[0], p[1]-q[1]) < 1e-8 for q in uniq):
                        uniq.append(p)
                # Compute convex hull (since region convex)
                # Use simple algorithm: sort by angle around centroid
                if len(uniq) < 3:
                    return uniq
                cx = sum(p[0] for p in uniq)/len(uniq)
                cy = sum(p[1] for p in uniq)/len(uniq)
                def angle(p):
                    return math.atan2(p[1]-cy, p[0]-cx)
                uniq.sort(key=angle)
                return uniq
            
            def polygon_area(poly):
                if len(poly) < 3:
                    return 0.0
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2
            
            def overlap_area_adj(theta):
                poly = overlap_polygon_adj(theta)
                return polygon_area(poly)
            
            # test for some angles
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/5, math.pi/4]:
                print(th, overlap_area_adj(th))
            
