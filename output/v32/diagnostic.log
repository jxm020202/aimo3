            def max_edges_of_dim(n, target_dim):
                N = 1<<n
                adj = {v: [] for v in range(N)}
                for v in range(N):
                    for i in range(n):
                        u = v ^ (1<<i)
                        adj[v].append((u,i))
                max_e = 0
                best_path = None
                visited = [False]*N
                visited[0]=True
                path=[0]
                def dfs(cur, e_count):
                    nonlocal max_e, best_path
                    if len(path)==N:
                        if e_count > max_e:
                            max_e = e_count
                            best_path = path.copy()
                        return
                    # prune if even using all remaining steps cannot exceed current max
                    # not needed
                    for (nbr,i) in adj[cur]:
                        if not visited[nbr]:
                            visited[nbr]=True
                            path.append(nbr)
                            dfs(nbr, e_count + (1 if i==target_dim else 0))
                            path.pop()
                            visited[nbr]=False
                dfs(0,0)
                return max_e, best_path
            
