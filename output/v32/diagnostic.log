            def indegree_distribution_pow(n, k=866):
                M = n+1
                indeg = [0]*(M)  # index 0..M-1, we ignore 0
                for x in range(1, M):
                    a = pow(x, k, M)
                    indeg[a] += 1
                # ignore indeg[0] (should be 0 because x in 1..M-1)
                # return dict of indegree value -> count of residues with that indegree (excluding 0)
                from collections import Counter
                cnt = Counter()
                for a in range(1, M):
                    cnt[indeg[a]] += 1
                return cnt
            
            def indegree_distribution_affine(n):
