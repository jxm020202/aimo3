            import math, itertools, sympy as sp
            
            def f_bruteforce(n):
                min_lcm = None
                best = None
                # iterate triples distinct positive ints a<b<c maybe not needed ordering
                for a in range(1, n-1):
                    for b in range(a+1, n-a):
                        c = n - a - b
                        if c <= b:
                            continue
                        # distinct automatically if a<b<c
                        l = sp.ilcm(a,b,c)
                        if min_lcm is None or l < min_lcm:
                            min_lcm = l
                            best = (a,b,c)
                return min_lcm, best
            
            def f_formula(n):
                if n%2==0:
                    # even n
                    # smallest odd prime factor of n-1
                    m = n-1
                    # find smallest prime factor >2 (since m odd)
                    p = sp.factorint(m)
                    # get smallest prime factor (should be odd)
                    spf = min(p.keys())
                    # ensure spf != 2
                    if spf == 2:
                        # not possible since m odd
                        pass
                    return (n-1)*(spf-1)//spf
                else:
                    # odd n
                    m = n-2
                    # smallest prime factor (odd)
                    spf = min(sp.factorint(m).keys())
                    return (n-2)*(spf-1)//spf
            
            def test(N=200):
                mismatches = []
                for n in range(6, N+1):
                    bf,_ = f_bruteforce(n)
                    fm = f_formula(n)
                    if bf != fm:
                        mismatches.append((n,bf,fm))
                return mismatches
            
            mismatches = test(200)
            len(mismatches), mismatches[:10]
            
