            from fractions import Fraction
            def f_rational(p,q):
                # assume 0 <= p < q, gcd(p,q)=1
                # period P = q if p even else 2*q
                if p % 2 == 0:
                    P = q
                else:
                    P = 2*q
                # compute a_n for n=1..P
                a = []
                for n in range(1, P+1):
                    floor_val = (p * n) // q
                    a.append(1 if floor_val % 2 == 0 else 0)
                # compute N = sum a_n * 2^{P-n}
                N = 0
                for idx, val in enumerate(a, start=1):
                    if val:
                        N += 1 << (P - idx)  # 2^{P-idx}
                denom = (1 << P) - 1  # 2^P - 1
                return Fraction(N, denom)
            
            def search_limit(max_q):
                min_val = Fraction(1,1)
                min_pair = None
                for q in range(1, max_q+1):
                    for p in range(0, q):
                        if math.gcd(p,q)!=1:
                            continue
                        val = f_rational(p,q)
                        if val < min_val:
                            min_val = val
                            min_pair = (p,q)
                return min_val, min_pair
            
            min_val, min_pair = search_limit(60)
            min_val, min_pair, float(min_val)
            
