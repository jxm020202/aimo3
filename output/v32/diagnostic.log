            def optimal_for_k(k):
                # Build B_k matrix
                B = np.zeros((k,k))
                for i in range(k):
                    B[i,i]=2
                    if i>0:
                        B[i,i-1]=1
                        B[i-1,i]=1
                # Solve for u = B^{-1} e_k (last basis vector)
                e_k = np.zeros(k)
                e_k[-1]=1
                u = la.solve(B, e_k)
                # Solve for v = B^{-1} 1
