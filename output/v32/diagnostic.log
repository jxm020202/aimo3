            def max_for_sum(S):
                a = sp.symbols('a', real=True)
                b = S - a
                expr = (a**3 + b**3) * S * a * b
                # derivative
                d = sp.diff(expr, a)
                crit = sp.solve(sp.Eq(d,0), a)
                # filter real within (0,S)
                real_vals = [sp.N(val) for val in crit if val.is_real]
                # evaluate expression at critical points and endpoints
                vals = []
                for val in crit:
                    if val.is_real:
                        if 0 < val < S:
                            vals.append(expr.subs(a,val))
                vals.append(expr.subs(a,0))
                vals.append(expr.subs(a,S))
                return sp.simplify(max(vals, key=lambda x: float(x)))
            for eps in [0.1,0.01,0.001]:
                S = 3 - eps
                max_val = max_for_sum(S)
                print(eps, sp.nsimplify(max_val))
            
