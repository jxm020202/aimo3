                factors = []
                for v in verts:
                    vars_v = tuple(v_edges[v])
                    table = np.zeros((3,3,3), dtype=np.int64)
                    for colors in itertools.product(range(3), repeat=3):
                        if len(set(colors)) == 2:
                            table[colors] = 1
                    factors.append((vars_v, table))
