                # compute s = product (1 + (p-1)/d_i) - 1
                prod = 1
                for p in primes:
                    prod *= (1 + (p-1)//d_i[p])
                s = prod - 1
                # core size condition
                if s != n//d:
                    return False
                # indegree uniform condition: For each core node, product over non-zero components of d_i must equal d
                # This must hold for all possible patterns of zeros among primes that correspond to core nodes.
                # Core nodes are residues where each component is either 0 or in H_i (size (p-1)/d_i).
                # For each subset Z of primes (those where component is 0), the indegree is product over p not in Z of d_i[p].
                # This must be constant = d for all subsets Z that actually appear (i.e., there exists at least one core node with that zero pattern).
                # Since for each p, H_i is non-empty, any subset Z is possible (choose 0 for those primes, and a non-zero element from H_i for others).
                # So indegree values are product over complement of Z of d_i[p].
