            def contains_lattice_point_robust(x, y, theta):
                cos = math.cos(theta)
                sin = math.sin(theta)
                # compute rectangle corners in (I,J) space
                A = cos*x + sin*y
                B = -sin*x + cos*y
                # corners of rectangle in (I,J):
                corners = [(A, B),
                           (A+1, B),
                           (A, B+1),
                           (A+1, B+1)]
                # transform to (i,j) coordinates via inverse rotation
                inv = lambda I,J: (cos*I + sin*J, -sin*I + cos*J)  # R_{-θ}
                ij_corners = [inv(I,J) for (I,J) in corners]
                i_vals = [c[0] for c in ij_corners]
                j_vals = [c[1] for c in ij_corners]
                i_min = math.floor(min(i_vals)) - 1
                i_max = math.ceil(max(i_vals)) + 1
                j_min = math.floor(min(j_vals)) - 1
                j_max = math.ceil(max(j_vals)) + 1
                # iterate integer i,j in range
                for i in range(i_min, i_max+1):
                    for j in range(j_min, j_max+1):
                        I = cos*i + sin*j
                        J = -sin*i + cos*j
                        if A <= I <= A+1 and B <= J <= B+1:
                            return True
                return False
            
            # test against brute-force for random samples
            def test_random(N, theta):
                for _ in range(N):
                    x=random.random()
                    y=random.random()
                    brute = contains_lattice_point(x,y,theta)
                    fast = contains_lattice_point_robust(x,y,theta)
                    if brute != fast:
                        print("mismatch", x,y, brute, fast)
                        return False
                return True
            
            print(test_random(1000, math.pi/4))
            
