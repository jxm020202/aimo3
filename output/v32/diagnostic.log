            from fractions import Fraction
            def f_exact_rational(p,q):
                # compute parity sequence for n=1..2q (max period)
                seq = [ ((n*p)//q) % 2 for n in range(1, 2*q+1) ]
                # find minimal period
                per = None
                for per_candidate in range(1, 2*q+1):
                    if all(seq[i]==seq[i+per_candidate] for i in range(2*q-per_candidate)):
                        per = per_candidate
                        break
                if per is None:
                    per = 2*q
                # compute sum over one period
                s = Fraction(0,1)
                for r in range(1, per+1):
                    if seq[r-1]==0:  # even floor => a_n=1
                        s += Fraction(1, 2**r)
                # total sum = s * (1 + 2^{-per} + 2^{-2per}+ ...) = s / (1 - 2^{-per})
                total = s / (Fraction(1,1) - Fraction(1, 2**per))
                return total
            
            def min_f_rational(max_q):
                min_val = Fraction(1,1)
                min_pair = None
                for q in range(1, max_q+1):
                    for p in range(0, q):
                        val = f_exact_rational(p,q)
                        if val < min_val:
                            min_val = val
                            min_pair = (p,q)
                return min_val, min_pair
            
            min_val, min_pair = min_f_rational(200)
            min_val, min_pair, float(min_val)
            
