            def min_edge_domination(n):
                # Build graph for n x n board
                d1_range = list(range(-(n-1), n))
                d2_range = list(range(0, 2*n-1))
                d1_to_idx = {d:i for i,d in enumerate(d1_range)}
                d2_to_idx = {d:i for i,d in enumerate(d2_range)}
                edges = []
                for r in range(n):
                    for c in range(n):
                        i = d1_to_idx[r-c]
                        j = d2_to_idx[r+c]
                        edges.append((i,j))
                m = len(edges)
                A = np.zeros((m,m), dtype=np.int8)
                for e_idx, (i,j) in enumerate(edges):
                    for f_idx, (i2,j2) in enumerate(edges):
                        if i2==i or j2==j:
                            A[e_idx,f_idx]=1
                c = np.ones(m, dtype=int)
                bounds = Bounds(np.zeros(m), np.ones(m))
                lin_con = LinearConstraint(-A, -np.inf, -np.ones(m, dtype=int))
                res = milp(c=c, constraints=[lin_con], integrality=np.ones(m), bounds=bounds, options={'presolve': True, 'disp': False})
                if res.success:
                    return int(round(res.fun))
                else:
                    raise RuntimeError("MILP failed")
            for n in range(1,9):
                print(n, min_edge_domination(n))
            
