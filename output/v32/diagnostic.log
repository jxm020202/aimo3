            def last_nonzero_digit_factorial(n):
                # recurrence using base 5
                # D(0)=1
                # D(n) = D(n//5) * D_small[n%5] * pow(2, n//5, 10) % 10
                # D_small for n%5 factorial last non-zero digit: 0! =1,1!=1,2!=2,3!=6,4!=24->4
                D_small = [1,1,2,6,4]
                if n == 0:
                    return 1
                # iterative approach
                res = 1
                while n > 0:
                    res = (res * D_small[n % 5] * pow(2, n // 5, 10)) % 10
                    n //= 5
                return res
            
            # test small values
            for i in range(1, 21):
                import math
                # compute factorial and strip zeros
                fact = math.factorial(i)
                while fact % 10 == 0:
                    fact //= 10
                print(i, fact % 10, last_nonzero_digit_factorial(i))
            
