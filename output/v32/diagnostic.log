            def clip_polygon_to_unit_square(poly):
                # clip convex polygon to unit square [0,1]x[0,1] using Sutherland-Hodgman
                def clip(poly, edge):
                    # edge: ('left', x=0), ('right', x=1), ('bottom', y=0), ('top', y=1)
                    new_poly = []
                    n = len(poly)
                    for i in range(n):
                        x1,y1 = poly[i]
                        x2,y2 = poly[(i+1)%n]
                        # define inside function
                        if edge == 'left':
                            inside1 = x1 >= 0 - 1e-12
                            inside2 = x2 >= 0 - 1e-12
                            # intersection with x=0 line
                            if x2 != x1:
                                t = (0 - x1)/(x2 - x1)
                                yi = y1 + t*(y2 - y1)
                            else:
                                yi = y1
                            ix, iy = 0, yi
                        elif edge == 'right':
                            inside1 = x1 <= 1 + 1e-12
                            inside2 = x2 <= 1 + 1e-12
                            if x2 != x1:
                                t = (1 - x1)/(x2 - x1)
                                yi = y1 + t*(y2 - y1)
                            else:
                                yi = y1
                            ix, iy = 1, yi
                        elif edge == 'bottom':
                            inside1 = y1 >= 0 - 1e-12
                            inside2 = y2 >= 0 - 1e-12
                            if y2 != y1:
                                t = (0 - y1)/(y2 - y1)
                                xi = x1 + t*(x2 - x1)
                            else:
                                xi = x1
                            ix, iy = xi, 0
                        elif edge == 'top':
                            inside1 = y1 <= 1 + 1e-12
                            inside2 = y2 <= 1 + 1e-12
                            if y2 != y1:
                                t = (1 - y1)/(y2 - y1)
                                xi = x1 + t*(x2 - x1)
                            else:
                                xi = x1
                            ix, iy = xi, 1
                        # Cases
                        if inside1 and inside2:
                            # both inside: add second point
                            new_poly.append((x2,y2))
                        elif inside1 and not inside2:
                            # leaving: add intersection
                            new_poly.append((ix,iy))
                        elif not inside1 and inside2:
                            # entering: add intersection then second point
                            new_poly.append((ix,iy))
                            new_poly.append((x2,y2))
                        # else both outside: add nothing
                    return new_poly
            
