            def rank_mod(matrix, p=3):
                # matrix: list of rows (list of ints)
                m = [row[:] for row in matrix]
                n_rows = len(m)
                n_cols = len(m[0]) if n_rows>0 else 0
                rank = 0
                row = 0
                for col in range(n_cols):
                    # find pivot row with non-zero entry in this column
                    pivot = None
                    for r in range(row, n_rows):
                        if m[r][col] % p != 0:
                            pivot = r
                            break
                    if pivot is None:
                        continue
                    # swap pivot row to current row
                    m[row], m[pivot] = m[pivot], m[row]
                    inv = pow(m[row][col] % p, -1, p)  # modular inverse
                    # normalize pivot row
                    m[row] = [(val * inv) % p for val in m[row]]
                    # eliminate other rows
                    for r in range(n_rows):
                        if r != row and m[r][col] % p != 0:
                            factor = m[r][col] % p
                            m[r] = [ (m[r][c] - factor * m[row][c]) % p for c in range(n_cols) ]
                    row += 1
                    rank += 1
                    if row == n_rows:
                        break
                return rank
            
