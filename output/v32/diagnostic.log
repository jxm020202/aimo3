            import itertools
            
            def count_independent_sets(n):
                # generate valid row patterns (as int)
                patterns = []
                for bits in range(1<<n):
                    # check no adjacent 1s horizontally
                    if bits & (bits<<1):
                        continue
                    patterns.append(bits)
                # precompute compatibility
                compat = {p: [] for p in patterns}
                for p in patterns:
                    for q in patterns:
                        if p & q == 0:  # no vertical adjacency
                            compat[p].append(q)
                # DP
                dp = {p: 1 for p in patterns}  # first row
                for row in range(1, n):  # already have first row, need n-1 more rows
                    newdp = {p: 0 for p in patterns}
                    for p in patterns:
                        total = 0
                        for q in compat[p]:
                            total += dp[q]
                        newdp[p] = total
                    dp = newdp
                total = sum(dp.values())
                return total
            
            for n in range(1,6):
                print(n, count_independent_sets(n))
            
