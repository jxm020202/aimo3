                        for a in range(len(neigh)):
                            for b in range(a+1,len(neigh)):
                                u,v=neigh[a],neigh[b]
                                if u>v: u,v=v,u
                                S.add((u,v))
                    e = bin(mask).count('1')
                    f = e - len(S)
                    if f>max_f:
                        max_f=f
                return max_f
            
