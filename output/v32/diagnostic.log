            def count_colorings_via_elimination():
                # Build initial factors as described
                factors = []
                for v in G.nodes():
                    vars_v = tuple(vertex_edges[v])  # length 3
                    # create table of shape (3,3,3)
                    table = np.zeros((3,3,3), dtype=np.int64)
                    for colors in itertools.product(range(3), repeat=3):
                        if len(set(colors)) == 2:
                            table[colors] = 1
                    factors.append((vars_v, table))
                # elimination order for edge variables (0..29)
                order = min_fill_ordering(L)  # list of edge indices
                # elimination
                for var in order:
                    # collect factors containing var
                    relevant = [f for f in factors if var in f[0]]
                    # remove them from factors
                    factors = [f for f in factors if var not in f[0]]
                    if not relevant:
                        continue  # variable already eliminated? shouldn't happen
                    # compute combined vars
                    combined_vars = sorted(set().union(*[set(f[0]) for f in relevant]))
                    # build combined table
                    k = len(combined_vars)
                    # map var to index in combined_vars
                    var_index = {v:i for i,v in enumerate(combined_vars)}
                    # initialize combined table with zeros
                    shape = (3,)*k
                    combined_table = np.zeros(shape, dtype=np.int64)
                    # iterate over all assignments
                    for assign in itertools.product(range(3), repeat=k):
                        prod = 1
                        # compute product of factor values
                        for vars_f, table_f in relevant:
                            # extract sub-assignment for this factor
                            idx = tuple(assign[var_index[v]] for v in vars_f)
                            prod *= table_f[idx]
                            if prod == 0:
                                break
                        if prod != 0:
                            combined_table[assign] = prod
                    # sum over var (eliminate)
                    idx_elim = var_index[var]
                    # sum over axis idx_elim
                    new_table = combined_table.sum(axis=idx_elim)
                    # new vars = combined_vars without var
                    new_vars = tuple(v for v in combined_vars if v != var)
                    # ensure new_table shape matches len(new_vars)
                    # if new_vars empty, new_table is scalar
                    if len(new_vars) == 0:
                        # final result
                        total = int(new_table)
                        return total
                    else:
                        factors.append((new_vars, new_table))
                # after eliminating all vars, multiply remaining factors (should be none)
                total = 1
                for vars_f, table_f in factors:
                    total *= table_f.sum()
                return total
            
            start = time.time()
            total = count_colorings_via_elimination()
            print("total colorings:", total, "time:", time.time()-start)
            
