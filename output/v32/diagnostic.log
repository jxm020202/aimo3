            def trial_one():
                # sample orientation uniformly in [0, pi/2) due to symmetry
                theta = random.random() * (math.pi/2)
                # sample translation uniform in [0,1)^2
                x = random.random()
                y = random.random()
                # compute rotation matrix components
                cos_t = math.cos(theta)
                sin_t = math.sin(theta)
                # define function to test if integer point (i,j) is inside square
                # condition: after rotating coordinates by -theta, the point relative to center (x,y) must satisfy |dx'| <= 0.5 and |dy'| <= 0.5
                # compute rotated coordinates of vector (i - x, j - y)
                # we can test integer points in a small range around (x,y)
                # bounding box: i in [floor(x-0.5)-1, ceil(x+0.5)+1]
                i_min = math.floor(x - 0.5) - 1
                i_max = math.ceil(x + 0.5) + 1
                j_min = math.floor(y - 0.5) - 1
                j_max = math.ceil(y + 0.5) + 1
                for i in range(i_min, i_max+1):
                    for j in range(j_min, j_max+1):
                        dx = i - x
                        dy = j - y
                        # rotate by -theta: (dx', dy') = (dx*cos + dy*sin, -dx*sin + dy*cos)
                        dxp = dx * cos_t + dy * sin_t
                        dyp = -dx * sin_t + dy * cos_t
                        if abs(dxp) <= 0.5 + 1e-12 and abs(dyp) <= 0.5 + 1e-12:
                            # point inside square
                            return False  # square covers a vertex -> not counted as "no vertex"
                return True  # no integer point inside
            
            def estimate_p(N):
                count = 0
                for _ in range(N):
                    if trial_one():
                        count += 1
                return count / N
            
            # quick test
            print(estimate_p(10000))
            
