                            if S <= 0:
                                continue
                            # case cd = ab + s
                            P = a*b + s
                            D = S*S - 4*P
                            if D >= 0:
                                sqrtD = int(math.isqrt(D))
                                if sqrtD*sqrtD == D:
                                    # roots: (S +/- sqrtD)/2
                                    if (S + sqrtD) % 2 == 0 and (S - sqrtD) % 2 == 0:
