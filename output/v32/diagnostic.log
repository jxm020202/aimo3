            def f_rational_exact(p,q):
                # compute using derived formulas
                if p % 2 == 0:
                    # period q
                    P = q
                    # compute bits a_i for i=1..q
                    N = 0
                    for i in range(1, q+1):
                        floor_val = (p*i)//q
                        if floor_val % 2 == 0:
                            N += 1 << (q - i)  # set bit
                    return Fraction(N, (1<<q)-1)
                else:
                    # odd p
                    # compute bits a_i for i=1..q
                    N = 0
                    for i in range(1, q+1):
                        floor_val = (p*i)//q
                        if floor_val % 2 == 0:
                            N += 1 << (q - i)
                    # value = (N+1)/(2^q+1)
                    return Fraction(N+1, (1<<q)+1)
            
