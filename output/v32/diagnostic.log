            import numpy as np
            nvar = len(placements)
            rows = []
            lb = []
            ub = []
            
            # cell constraints
            for i in range(n):
                for j in range(n):
                    row = np.zeros(nvar, dtype=int)
                    for pid in cell_to_placements[(i,j)]:
                        row[pid] = 1
                    rows.append(row)
                    lb.append(-np.inf)  # no lower bound
                    ub.append(1)       # <=1
            
            # blocking constraints
            for pid in range(nvar):
                for dname, blockers in block_sets[pid].items():
                    row = np.zeros(nvar, dtype=int)
                    row[pid] = 1
                    for q in blockers:
                        row[q] -= 1
                    rows.append(row)
                    lb.append(-np.inf)  # <= constraint
                    ub.append(0)         # row <= 0
            
            A = np.vstack(rows)
            lb = np.array(lb, dtype=float)
            ub = np.array(ub, dtype=float)
            
            # objective: minimize sum x_i
            c = np.ones(nvar)
            
            bounds = Bounds(0, 1)  # binary later via integrality
            
            integrality = np.ones(nvar, dtype=int)
            
            res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': True})
            
