            import itertools, numpy as np
            
            def count_solutions(n):
                k = n//2
                rows = list(itertools.combinations(range(n), k))
                # generate all matrices
                count=0
                mats=[]
                for rows_choice in itertools.product(rows, repeat=n):
                    A = np.zeros((n,n), dtype=int)
                    for i, cols in enumerate(rows_choice):
                        A[i, list(cols)] = 1
                    # check condition
                    if np.all(A.dot(A) + k*A == k*np.ones((n,n), dtype=int)):
                        count+=1
                        mats.append(A.copy())
                return count, mats
            
