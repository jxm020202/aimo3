            def det_root(n):
                lam = sp.symbols('lam')
                size = n-1
                # diagonal entries i(i+1)(i+2) - lam for i=1..size
                diag = [i*(i+1)*(i+2) - lam for i in range(1, size+1)]
                M = sp.Matrix([[diag[i] if i==j else -lam for j in range(size)] for i in range(size)])
                det = sp.factor(M.det())
                # solve det=0 for lam
                sol = sp.solve(det, lam)
                return sol, det
            
