            import itertools, math, numpy as np, sys, time, collections, random, math, itertools, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_S_grid(m,n):
                N=m*n
                # vertex indices
                verts = list(range(N))
                # edges list of pairs (u,v)
                edges=[]
                for i in range(m):
                    for j in range(n):
                        u=i*n+j
                        if i+1<m:
                            v=(i+1)*n+j
                            edges.append((u,v))
                        if j+1<n:
                            v=i*n+(j+1)
                            edges.append((u,v))
                # Precompute adjacency matrix
                # We'll binary search S
                low=0
                high=2*N  # max possible sum
                best=0
                while low<=high:
                    mid=(low+high)//2
                    # Build MILP to test feasibility of S=mid
                    # Variables x_{v,k} for each vertex v and number k (1..N)
                    # Represent as a vector of length N*N
                    # Use integer constraints (binary)
                    # Build constraints:
                    # 1) each vertex assigned exactly one number: sum_k x_{v,k}=1
                    # 2) each number assigned to exactly one vertex: sum_v x_{v,k}=1
                    # 3) for each edge (u,v) and each pair (k,l) with k+l < mid, forbid both: x_{u,k}+x_{v,l} <=1
                    # This third set may be huge: O(|E| * N^2). For N=16, edges ~ 24, N^2=256, total constraints ~ 6000 manageable.
                    # Let's build.
                    V=N
                    K=N
                    var_count=V*K
                    # objective dummy zero
                    c=np.zeros(var_count)
                    # constraints list
                    A=[]
                    b=[]
                    # vertex constraints
                    for v in range(V):
                        row=np.zeros(var_count)
                        for k in range(K):
                            row[v*K + k]=1
                        A.append(row)
                        b.append(1)
                    # number constraints
                    for k in range(K):
                        row=np.zeros(var_count)
                        for v in range(V):
                            row[v*K + k]=1
                        A.append(row)
                        b.append(1)
                    # edge constraints
                    for (u,v) in edges:
                        for k in range(K):
                            for l in range(K):
                                if (k+1)+(l+1) < mid:  # numbers are k+1, l+1
                                    row=np.zeros(var_count)
                                    row[u*K + k]=1
                                    row[v*K + l]=1
                                    A.append(row)
                                    b.append(1)  # <=1
                    # Convert to arrays
                    A=np.array(A)
                    b=np.array(b)
                    # bounds 0-1
                    bounds=Bounds(0,1)
                    # integrality: all variables integer
                    integrality=np.ones(var_count)
                    # Solve MILP
                    try:
                        res=milp(c, constraints=LinearConstraint(A, -np.inf*np.ones_like(b), b), bounds=bounds,
                                  integrality=integrality, options={'disp': False})
                    except Exception as e:
                        print("MILP error", e)
                        return None
                    feasible = res.success
                    if feasible:
                        best=mid
                        low=mid+1
                    else:
                        high=mid-1
                return best
            
            print(max_S_grid(2,3))
            
