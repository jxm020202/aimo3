            import itertools, math, numpy as np
            def min_interior_sum(a,b):
                n=12
                w = np.arange(11,0,-1)  # 11 down to 1
                # linear program: minimize w·s subject to -1<=s_i<=1, sum s_i + s_12 = b-a, s_12 free bound [-1,1]
                # We'll brute force extreme points: s_i at -1 or 1, and maybe one fractional.
                # Since there are 11 variables, we can compute optimal analytically.
                # Approach: sort w descending (already). We want to assign -1 to largest w as much as possible, +1 to smallest w.
                # Let total sum of s_i (i=1..11) be S. Then s_12 = (b-a) - S must be in [-1,1].
                # So S must be within [(b-a)-1, (b-a)+1].
                # Among all S in that interval, we want to minimize w·s.
                # Since w·s is linear in each s_i, we can think of choosing each s_i at -1 or 1 to achieve a certain S.
                # Equivalent to: we have 11 variables each with weight w_i and value s_i ∈ {-1,1} (or possibly fractional for one variable).
                # This is a knap-like problem: choose number of +1's vs -1's to get S close to target.
                # Let k = number of +1's among the 11 variables, then number of -1's = 11 - k, so S = k*1 + (11-k)*(-1) = 2k - 11.
                # So S can take values -11, -9, -7, ..., 11 (odd numbers). For each k we can compute w·s = sum_{i in +} w_i - sum_{i in -} w_i.
                # To minimize w·s for a given k, we should assign +1 to the smallest w_i (since +1 adds weight) and -1 to largest w_i.
                # So for given k, w·s_min = (sum of smallest k w_i) - (sum of largest (11 - k) w_i).
                # Compute for each feasible k such that S within allowed interval.
                # Then also consider possibility of one fractional s_i to achieve exact S if needed (since s_12 can adjust within [-1,1]).
                # Actually we can also use fractional s_i among the 11 to achieve any S within range, but the objective is linear so extreme at bounds.
                # We'll compute minimal w·s for each possible S in allowed interval (including possibly fractional via adjusting one variable).
                w_sorted = sorted(w, reverse=True)  # descending
                # Precompute prefix sums
                prefix = [0]
                for val in w_sorted:
                    prefix.append(prefix[-1]+val)
                total_w = sum(w_sorted)
                best = None
                # Allowed S interval
                lower = (b - a) - 1
                upper = (b - a) + 1
                # Since S must be integer of same parity as 11 (odd) if all s_i are +/-1. But we can also adjust one variable fractionally to achieve any S within +/-1 of integer.
                # We'll consider k from 0..11
                for k in range(0,12):
                    S = 2*k - 11
                    if S < lower - 1e-9 or S > upper + 1e-9:
                        continue
                    # compute w·s with +1 assigned to smallest k w_i (i.e., the last k in descending list)
                    # Since w_sorted descending, smallest k are the last k elements.
                    sum_smallest_k = sum(w_sorted[-k:]) if k>0 else 0
                    sum_largest = total_w - sum_smallest_k
                    # w·s = (+1)*sum_smallest_k + (-1)*sum_largest = sum_smallest_k - sum_largest
                    obj = sum_smallest_k - sum_largest
                    # If S not exactly matching, we could adjust one variable fractionally, which would affect objective proportionally.
                    # But for now treat exact.
                    if best is None or obj < best:
                        best = obj
                # If best still None, maybe need fractional assignment. We'll use linear programming via scipy for safety.
                if best is None:
                    # fallback to linear programming
                    from scipy.optimize import linprog
                    c = w.astype(float)
                    A_eq = np.ones((1,12))
                    b_eq = np.array([b-a])
                    bounds = [(-1,1)]*12
                    res = linprog(c, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
                    best = res.fun
                # interior sum = 11*a + best
                return 11*a + best
            
            # test with a=2,b=3
            print(min_interior_sum(2,3))
            
