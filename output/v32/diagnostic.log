            def can_slide(dom_idx, direction, placed_set):
                # direction: 'L','R','U','D'
                (c1,c2,orient) = dominos[dom_idx]
                i1,j1 = c1
                i2,j2 = c2
                # compute new cells after sliding one unit in direction
                if direction == 'L':
                    # new cells: each cell shifted left by 1
                    new_cells = [(i1, j1-1), (i2, j2-1)]
                elif direction == 'R':
                    new_cells = [(i1, j1+1), (i2, j2+1)]
                elif direction == 'U':
                    new_cells = [(i1-1, j1), (i2-1, j2)]
                elif direction == 'D':
                    new_cells = [(i1+1, j1), (i2+1, j2)]
                else:
                    raise ValueError
                # check within board
                for (i,j) in new_cells:
                    if not (0 <= i < n and 0 <= j < n):
                        return False  # blocked by edge
                # check if any new cell occupied by other domino (excluding current)
                for (i,j) in new_cells:
                    # find if any domino in placed_set covers this cell
                    for d in placed_set:
                        if d == dom_idx:
                            continue
                        (a,b,_) = dominos[d]
                        if (i,j) == a or (i,j) == b:
                            return False
                # also need that the cells vacated (original cells) are not needed? Actually sliding just moves, doesn't require emptiness of original cells (they become empty). So only need new cells empty.
                return True
            
            placed_set = set(placed)
            for idx in placed:
                for dirc in ['L','R','U','D']:
                    if can_slide(idx, dirc, placed_set):
                        print("Domino", idx, "can slide", dirc)
            
