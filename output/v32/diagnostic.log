            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np, math, time, sys
            
            num_vars = N + M
            c = np.zeros(num_vars)
            c[:N] = -1  # maximize sum x_i
            
            # Build constraint matrix A and bounds
            # We'll have 2N constraints: first N for matching, second N for induced condition
            
            A = np.zeros((2*N, num_vars), dtype=int)
            lb = np.zeros(2*N)
            ub = np.zeros(2*N)
            
            # Matching constraints: sum incident edges = x_i
            for i in range(N):
                # x_i coefficient
                A[i, i] = -1  # move to LHS: sum edges - x_i = 0 => sum edges - x_i <= 0 and >=0
                for e_idx in incident_edges[i]:
                    A[i, N + e_idx] = 1
                lb[i] = 0
                ub[i] = 0
            
            # Induced constraints: sum edges near i <= 1 + (1 - x_i) * M_i
            # Rearranged: sum edges near i + x_i <= 1 + M_i
            # Actually we need: sum edges near i <= 1 + (1 - x_i) * M_i
            # => sum edges near i <= 1 + M_i - M_i * x_i
            # => sum edges near i + M_i * x_i <= 1 + M_i
            # We'll implement as: sum edges near i + M_i * x_i <= 1 + M_i
            for i in range(N):
                row = N + i
                for e_idx in edge_near[i]:
                    A[row, N + e_idx] = 1
                A[row, i] = M_i[i]  # coefficient for x_i
                lb[row] = -np.inf  # no lower bound
                ub[row] = 1 + M_i[i]
            
            # Define bounds for variables
            var_lb = np.zeros(num_vars)
            var_ub = np.ones(num_vars)
            
            bounds = Bounds(var_lb, var_ub)
            
            # Linear constraints
            constraints = LinearConstraint(A, lb, ub)
            
            options = {'time_limit': 30}
            res = milp(c=c, constraints=constraints, bounds=bounds, integrality=np.ones(num_vars, dtype=int), options=options)
            print(res.success, res.fun)
            
