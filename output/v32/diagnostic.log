            import random
            
            def greedy_random(iterations=1000):
                best_set = set()
                for _ in range(iterations):
                    cells = list(range(N))
                    random.shuffle(cells)
                    used = set()
                    placed = set()
                    for i in cells:
                        if i in used:
                            continue
                        # try to find neighbor j not used
                        # list neighbors within distance <=2 not used
                        candidates = [j for j in adj[i] if j not in used]
                        random.shuffle(candidates)
                        found = False
                        for j in candidates:
                            # check if placing i and j would violate condition with existing placed pieces
                            # i and j must be within distance <=2 (they are)
                            # also for each existing piece k, distance to i and j must be >2
                            ok = True
                            for k in placed:
                                if cheb_dist(coords[i], coords[k]) <= 2 or cheb_dist(coords[j], coords[k]) <= 2:
                                    ok = False
                                    break
                            if ok:
                                # place pair
                                placed.add(i)
                                placed.add(j)
                                # mark used cells: i and j and all cells within distance <=2 of them (cannot be used later)
                                used.update([i, j])
                                for v in range(N):
                                    if cheb_dist(coords[i], coords[v]) <= 2 or cheb_dist(coords[j], coords[v]) <= 2:
                                        used.add(v)
                                found = True
                                break
                        # if not found, we could still mark i as used? Actually i cannot be used alone, so we just skip.
                    if len(placed) > len(best_set):
                        best_set = placed
                return best_set
            
            best = greedy_random(2000)
            len(best), check_positions(best)
            
