            def is_valid_pairing(subset):
                # subset is list of coordinates
                # need to partition into pairs such that each pair distance <=2 and no cross distances <=2
                # try all perfect matchings
                n=len(subset)
                if n%2!=0:
                    return False
                # generate all pairings using recursion
                used=[False]*n
                def backtrack():
                    # find first unused
                    try:
                        i=used.index(False)
                    except ValueError:
                        return True
                    used[i]=True
                    for j in range(i+1,n):
                        if not used[j]:
                            # check distance condition for this pair
                            if max(abs(subset[i][0]-subset[j][0]),abs(subset[i][1]-subset[j][1]))<=2:
                                # check cross distances: for any already paired vertices (i.e., those used earlier), ensure distance >2
                                # Actually we need to ensure that any vertex from this pair is not within distance <=2 of any vertex from other pairs (including those already paired)
                                # Since we are building pairs incrementally, we can check against all previously paired vertices (those with used=True but not i)
                                ok=True
                                for k in range(n):
                                    if used[k] and k not in (i,j):
                                        # k is already paired
                                        if max(abs(subset[i][0]-subset[k][0]),abs(subset[i][1]-subset[k][1]))<=2:
                                            ok=False
                                            break
                                        if max(abs(subset[j][0]-subset[k][0]),abs(subset[j][1]-subset[k][1]))<=2:
                                            ok=False
                                            break
                                if ok:
                                    used[j]=True
                                    if backtrack():
                                        return True
                                    used[j]=False
                    used[i]=False
                    return False
                return backtrack()
            
            # test all subsets of size 4
            coords5 = [(r,c) for r in range(5) for c in range(5)]
            valid_subsets=[]
            for subset in itertools.combinations(coords5,4):
                if is_valid_pairing(subset):
                    valid_subsets.append(subset)
            len(valid_subsets)
            
