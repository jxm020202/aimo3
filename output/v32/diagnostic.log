            import random, math, itertools, numpy as np, sys, time, math, itertools, random, numpy as np
            def random_config():
                # generate 9 sorted numbers with sum 1
                # generate 9 random numbers from normal, sort, then shift to sum 1
                xs = np.random.randn(9)
                xs.sort()
                # adjust to sum 1 by adding constant to all
                xs = xs - xs.mean() + 1/9
                # now sum is 1, but ordering may be broken due to shift? Actually shift preserves ordering.
                # ensure ordering still holds (it does)
                return xs
            
            def compute_E(xs):
                S2 = np.sum(xs**2)
                median = xs[4] # zero-indexed
                A = np.sum(np.abs(xs - median))
                numerator = A**2 * (9*S2 - 1)
                denominator = S2**3
                return numerator/denominator
            
            def random_search(iterations=200000):
                best = -1
                best_x = None
                for _ in range(iterations):
                    xs = random_config()
                    E = compute_E(xs)
                    if E > best:
                        best = E
                        best_x = xs.copy()
                return best, best_x
            
            best, best_x = random_search(200000)
            best
            
