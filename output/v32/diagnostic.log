            def minimal_sequence_and_interval(N):
                # greedy algorithm to produce minimal bits and interval for x
                # interval represented as (low, high) open? We'll use closed on left, open on right.
                low, high = 0.0, 1.0
                bits = []
                for n in range(1, N+1):
                    # try to set bit 0
                    # condition for a_n = 0: floor(n*x) odd
                    # That means x must lie in union of intervals where floor(n*x) odd.
                    # For each k from 0..n-1, floor(n*x)=k odd => x in [k/n, (k+1)/n) with k odd.
                    # So allowed intervals are union over odd k.
                    allowed = []
                    for k in range(0, n):
                        if k % 2 == 1:
                            allowed.append((k/n, (k+1)/n))
                    # intersect current interval with union of allowed intervals
                    # compute new interval(s) as intersection; we only need to know if nonempty.
                    new_intervals = []
                    for a,b in allowed:
                        lo = max(low, a)
                        hi = min(high, b)
                        if lo < hi - 1e-12:
                            new_intervals.append((lo,hi))
                    if new_intervals:
                        # we can set bit 0, choose intersection as new interval (maybe multiple)
                        # For simplicity, keep the union as a single interval by taking min low and max high? Not correct.
                        # But for greedy we just need existence; we can pick first interval.
                        low, high = new_intervals[0]
                        bits.append(0)
                    else:
                        # must set bit 1: floor(n*x) even
                        allowed = []
                        for k in range(0, n):
                            if k % 2 == 0:
