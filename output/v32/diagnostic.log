                n_edges = len(edges)
                colors = [-1]*n_edges
                assigned = [[] for _ in range(20)]
                # allowed sets for each edge (initially all)
                allowed = [set([0,1,2]) for _ in range(n_edges)]
                steps = 0
                # choose edge order: maybe dynamic selection as before
                def select_edge():
                    # choose unassigned edge with smallest allowed size
                    best = None
                    bestsize = 10
                    for i in range(n_edges):
                        if colors[i]==-1:
                            sz = len(allowed[i])
                            if sz < bestsize:
                                bestsize = sz
                                best = i
                                if sz == 1:
                                    break
                    return best
                # recursion with backtracking using stack (iterative) to avoid recursion depth?
                # We'll use recursion for simplicity but with limit steps.
                found = None
                def backtrack():
                    nonlocal steps, found
                    if found is not None:
                        return True
                    if steps > max_steps:
                        return False
                    steps += 1
                    if all(c != -1 for c in colors):
                        found = colors.copy()
                        return True
                    e = select_edge()
                    # randomize order of colors to maybe find solution faster
                    for col in random.sample(list(allowed[e]), len(allowed[e])):
                        # assign
                        colors[e] = col
