            def compute_total_mod(mod=1000):
                G = nx.dodecahedral_graph()
                n = G.number_of_nodes()  # 20
                m = G.number_of_edges()  # 30
                edges = list(G.edges())
                # row vectors for each vertex
                vertex_rows = []
                for v in range(n):
                    row = [0]*m
                    for idx,(u,w) in enumerate(edges):
                        if v==u or v==w:
                            row[idx] = 1
                    vertex_rows.append(row)
                total = 0
                # precompute popcount for masks maybe using bit_count
                for mask in range(1<<n):
                    sz = mask.bit_count()
                    # collect rows
                    rows = []
                    for v in range(n):
                        if (mask>>v)&1:
                            rows.append(vertex_rows[v][:])  # copy
                    # compute rank over GF(3)
                    # Gaussian elimination
                    rank = 0
                    col = 0
                    rows_len = len(rows)
                    while rank < rows_len and col < m:
                        # find pivot row with non-zero in column col
                        pivot = None
                        for i in range(rank, rows_len):
                            if rows[i][col] % 3 != 0:
                                pivot = i
                                break
                        if pivot is None:
                            col += 1
                            continue
                        # swap pivot row to position rank
                        rows[rank], rows[pivot] = rows[pivot], rows[rank]
                        # normalize pivot row to make entry 1
                        inv = {1:1, 2:2}  # 2*2=4=1 mod3
                        factor = rows[rank][col] % 3
                        if factor != 1:
                            mul = inv[factor]
                            rows[rank] = [(val * mul) % 3 for val in rows[rank]]
                        # eliminate other rows
                        for i in range(rows_len):
                            if i != rank and rows[i][col] % 3 != 0:
                                factor = rows[i][col] % 3
                                rows[i] = [ (rows[i][j] - factor*rows[rank][j]) % 3 for j in range(m) ]
                        rank += 1
                        col += 1
                    exponent = m - rank
                    term = pow(3, exponent, mod)
                    if sz % 2 == 1:
                        term = -term
                    total = (total + term) % mod
                return total
            
            print(compute_total_mod())
            
