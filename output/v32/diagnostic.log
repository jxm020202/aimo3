            def expected_lattice_points(N=200000):
                total=0
                for _ in range(N):
                    cx = random.random()
                    cy = random.random()
                    theta = random.random()*2*math.pi
                    # consider integer points near (cx,cy). Since square side 1, the max distance from center to any point inside is sqrt(2)/2 ≈0.7071
                    # So only integer points with coordinates floor(cx) or ceil(cx) etc.
                    count=0
                    for i in range(-1,2):
                        for j in range(-1,2):
                            # point (i,j) in integer lattice
                            # compute relative vector
                            vx = i - cx
                            vy = j - cy
                            # rotate coordinates by -theta
                            xr = math.cos(theta)*vx + math.sin(theta)*vy
                            yr = -math.sin(theta)*vx + math.cos(theta)*vy
                            if abs(xr) <= 0.5 and abs(yr) <= 0.5:
                                count+=1
                    total+=count
                return total/N
            
            print(expected_lattice_points(100000))
            
