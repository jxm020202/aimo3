            import itertools
            
            def naf_weight(n):
                # compute NAF representation weight (non-zero digits)
                weight = 0
                while n > 0:
                    if n & 1:
                        # n is odd
                        u = 2 - (n % 4)
                        if u == 2:
                            u = -2  # but for odd n, n%4 is 1 or 3, so u is 1 or -1
                        # Actually for odd n, n%4 is 1 or 3, u = 2 - (n%4) => 1 or -1
                        weight += 1
                        n = (n - u) // 2
                    else:
                        n //= 2
                return weight
            
            def min_int_with_weight(w, limit=10000):
                for n in range(1, limit):
                    if naf_weight(n) == w:
                        return n
                return None
            
            for w in range(1, 11):
                print(w, min_int_with_weight(w, limit=100000))
            
