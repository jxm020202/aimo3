                # prune by simple bound
                rem = available_mask.bit_count()
                if count + 2*(rem//2) <= best:
                    return
                if available_mask == 0:
                    if count > best:
                        best = count
                    return
                # compute set of vertices
                avail_set = [i for i in range(N) if (available_mask >> i) & 1]
                # compute tighter bound using max matching
                ub = count + upper_bound_match(set(avail_set))
                if ub <= best:
                    return
                # choose vertex with smallest degree in induced subgraph
                # compute degrees
                min_deg = None
                v = None
                for i in avail_set:
                    deg = sum(1 for j in adj[i] if (available_mask >> j) & 1)
                    if min_deg is None or deg < min_deg:
