            def min_T_hypercube_path(n):
                N = 2**n
                # list of edges (undirected) as pairs (i,j) where i<j and differ by one bit
                edges = []
                for i in range(N):
                    for k in range(n):
                        j = i ^ (1<<k)
                        if i < j:
                            edges.append((i,j,k))
                # directed edges list
                dir_edges = []
                for (i,j,k) in edges:
                    dir_edges.append((i,j,k))
                    dir_edges.append((j,i,k))
                m = len(dir_edges)
                # variable indices
                # x variables binary for each directed edge
                # order variables u_i integer for each vertex
                # end indicator e_i binary for i !=0
                # We'll use scipy milp which expects c (objective), integrality, bounds, constraints.
                # Build matrices for constraints.
                # We'll map variable indices: first m x variables, then N u variables, then (N-1) e variables.
                total_vars = m + N + (N-1)
                # objective coefficients
                c = np.zeros(total_vars)
                for idx, (i,j,k) in enumerate(dir_edges):
                    c[idx] = 1.0 / (2**k)  # weight
                # integrality: x and e are binary (int), u are integer (but can be continuous? need integer)
                integrality = np.array([opt.milp.Integer] * total_vars)
                # bounds
                bounds = [(0,1)] * m + [(0, N-1)] * N + [(0,1)] * (N-1)
                # constraints
                cons = []
                # degree constraints
                # For each vertex i, compute sum of outgoing x and incoming x
                # out_i = sum_{j} x_{i->j}
                # in_i = sum_{j} x_{j->i}
                # We'll create equality constraints.
                # We'll also need edge usage at most once: x_{i->j} + x_{j->i} <= 1 for each undirected edge.
                # Build mapping from undirected edge to indices of directed edges.
                edge_to_dir = {}
                for idx, (i,j,k) in enumerate(dir_edges):
                    edge_to_dir.setdefault((min(i,j), max(i,j)), []).append(idx)
                # edge usage constraints
                for (i,j), idxs in edge_to_dir.items():
                    # idxs length 2
                    A = np.zeros(total_vars)
                    for idx in idxs:
                        A[idx] = 1
                    cons.append(opt.LinearConstraint(A, -np.inf, 1))
                # degree constraints
                for i in range(N):
                    # outgoing sum
                    A_out = np.zeros(total_vars)
                    for idx, (src,dst,k) in enumerate(dir_edges):
                        if src == i:
                            A_out[idx] = 1
                    # incoming sum
                    A_in = np.zeros(total_vars)
                    for idx, (src,dst,k) in enumerate(dir_edges):
                        if dst == i:
                            A_in[idx] = 1
                    # e variable index for i (if i!=0)
                    e_idx = None
                    if i != 0:
                        e_idx = m + N + (i-1)  # after x and u variables
                    # constraints:
                    # out_i = 1 - e_i (if i!=0) else out_0 = 1
                    # in_i = 1 (if i!=0) else in_0 = 0
                    # We'll create two constraints per vertex.
                    # out_i + e_i = 1 (for i!=0)
                    if i == 0:
                        # out_0 = 1
                        cons.append(opt.LinearConstraint(A_out, 1, 1))
                        # in_0 = 0
                        cons.append(opt.LinearConstraint(A_in, 0, 0))
                    else:
                        # out_i + e_i = 1
                        A = A_out.copy()
                        A[e_idx] = 1
                        cons.append(opt.LinearConstraint(A, 1, 1))
                        # in_i = 1
                        cons.append(opt.LinearConstraint(A_in, 1, 1))
                # exactly one end vertex: sum e_i = 1
                A_end = np.zeros(total_vars)
                for i in range(1,N):
                    e_idx = m + N + (i-1)
                    A_end[e_idx] = 1
                cons.append(opt.LinearConstraint(A_end, 1, 1))
                # subtour elimination (MTZ)
                # u variables indices: u_i at position m + i
                for idx, (i,j,k) in enumerate(dir_edges):
                    if i == 0:
                        continue  # skip constraints from start maybe not needed
                    # u_i - u_j + N * x_{i->j} <= N-1
                    A = np.zeros(total_vars)
                    u_i_idx = m + i
                    u_j_idx = m + j
                    A[u_i_idx] = 1
                    A[u_j_idx] = -1
                    A[idx] = N
                    cons.append(opt.LinearConstraint(A, -np.inf, N-1))
                # set u_0 = 0: we can fix by bounds: u_0 lower=upper=0
                bounds[m + 0] = (0,0)
                # also enforce u_i >= 1 for i!=0? Not necessary but can help.
                for i in range(1,N):
                    bounds[m + i] = (1, N-1)
                # Solve MILP
                res = opt.milp(c=c, bounds=bounds, constraints=cons, integrality=integrality, options={"presolve": True, "disp": False})
                return res
            
            print("solving n=3")
            res3 = min_T_hypercube_path(3)
            print(res3.success, res3.fun)
            
