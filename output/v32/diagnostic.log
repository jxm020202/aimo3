            def min_moves_bfs(n, limit=None):
                init = 0
                for i in range(n):
                    if (i+1)%2==1:
                        init |= (1<<i)
                target = 0
                from collections import deque
                q = deque()
                dist = {}
                for i in range(n):
                    config = init ^ (1<<i)
                    state = (config, i)
                    dist[state] = 1
                    q.append(state)
                while q:
                    config, pos = q.popleft()
                    d = dist[(config,pos)]
                    if config == target:
                        return d
                    for nxt in (pos-1, pos+1):
                        if 0 <= nxt < n:
                            new_config = config ^ (1<<nxt)
                            ns = (new_config, nxt)
                            if ns not in dist:
                                dist[ns] = d+1
                                q.append(ns)
                    if limit and len(dist) > limit:
                        return None
                return None
            
