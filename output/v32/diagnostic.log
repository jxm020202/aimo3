            import random, math, numpy as np
            
            def max_E_pattern(p,q,r, trials=200000):
                best = -1
                best_ab = None
                for _ in range(trials):
                    # sample a,b from some range, e.g., uniform [-1,1]
                    a = random.uniform(-1,1)
                    b = random.uniform(-1,1)
                    # enforce ordering constraints
                    if a*(9 - r) + r*b > 1 + 1e-12:
                        continue
                    if p*a + (9 - p)*b < 1 - 1e-12:
                        continue
                    # compute m
                    m = (1 - p*a - r*b)/q
                    # compute S2
                    S2 = p*a*a + q*m*m + r*b*b
                    # compute A
                    A = r*b - p*a
                    # compute E
                    if S2 <= 0:
                        continue
                    E = A*A * (9*S2 - 1) / (S2**3)
                    if E > best:
                        best = E
                        best_ab = (a,b,m,S2,A)
                return best, best_ab
            
            patterns = [(p,9-p-r,r) for p in range(0,5) for r in range(0,5) if p+r<=8]
            # but need q = 9-p-r >=1 and p+q>=5 (median position)
            valid_patterns = []
            for p,r in [(p,r) for p in range(0,5) for r in range(0,5) if p+r<=8]:
                q = 9 - p - r
                if q >= 1 and p+q >=5:
                    valid_patterns.append((p,q,r))
            len(valid_patterns)
            
