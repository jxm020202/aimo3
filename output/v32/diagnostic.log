            def feasible_S(n, S):
                N = n*n
                edges = []
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        if i+1 < n:
                            edges.append((idx, (i+1)*n + j))
                        if j+1 < n:
                            edges.append((idx, i*n + (j+1)))
                num_vars = N*N
                c = np.zeros(num_vars)
                # constraints list
                constraints = []
                # each cell assigned exactly one number
                for v in range(N):
                    row = np.zeros(num_vars)
                    for k in range(N):
                        row[v*N + k] = 1
                    constraints.append(LinearConstraint(row, 1, 1))
                # each number assigned to exactly one cell
                for k in range(N):
                    row = np.zeros(num_vars)
                    for v in range(N):
                        row[v*N + k] = 1
                    constraints.append(LinearConstraint(row, 1, 1))
                # edge constraints: sum >= S -> -sum <= -S
                for (u,v) in edges:
                    row = np.zeros(num_vars)
                    for k in range(N):
                        row[u*N + k] = -(k+1)
                        row[v*N + k] = -(k+1)
                    constraints.append(LinearConstraint(row, -np.inf, -S))
                bounds = Bounds(0, 1)  # binary variables
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                return res.success
            
