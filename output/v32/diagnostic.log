            import numpy as np, itertools, math, random, sys, collections
            def max_edges_milp(n):
                edge_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1, n):
                        edge_index[(i,j)] = idx
                        idx += 1
                m = idx
                total_vars = 2*m
                c = [0]*total_vars
                for i in range(m):
                    c[i] = -1
                A = []
                b = []
                # w <= x
                for (i,j), e_idx in edge_index.items():
                    row = [0]*total_vars
                    row[e_idx] = -1
                    row[m+e_idx] = 1
                    A.append(row); b.append(0)
                # each vertex sum w >=1
                for i in range(n):
                    row = [0]*total_vars
                    for j in range(n):
                        if i<j:
                            e_idx = edge_index[(i,j)]
                            row[m+e_idx] = 1
                        elif j<i:
                            e_idx = edge_index[(j,i)]
                            row[m+e_idx] = 1
                    A.append([-coeff for coeff in row]); b.append(-1)
                # triangle-free condition for private edges
                for (i,j), e_idx in edge_index.items():
                    w_idx = m+e_idx
                    for k in range(n):
                        if k==i or k==j:
                            continue
                        # x_{i,k}
                        if i<k:
                            x_ik = edge_index[(i,k)]
                        else:
                            x_ik = edge_index[(k,i)]
                        # x_{j,k}
                        if j<k:
                            x_jk = edge_index[(j,k)]
                        else:
                            x_jk = edge_index[(k,j)]
                        row = [0]*total_vars
                        row[w_idx] = 1
                        row[x_ik] = 1
                        row[x_jk] = 1
                        A.append(row); b.append(2)
                A = np.array(A, dtype=float)
                b = np.array(b, dtype=float)
                from scipy.optimize import milp, LinearConstraint, Bounds
                lin_con = LinearConstraint(A, -np.inf, b)
                bounds_obj = Bounds([0]*total_vars, [1]*total_vars)
                res = milp(c=c, constraints=lin_con, bounds=bounds_obj, integrality=[1]*total_vars, options={'disp': False})
                if not res.success:
                    raise RuntimeError("MILP failed")
                x_vals = res.x[:m]
                edge_vals = [int(round(v)) for v in x_vals]
                adj = [set() for _ in range(n)]
                for (i,j), e_idx in edge_index.items():
                    if edge_vals[e_idx]==1:
                        adj[i].add(j); adj[j].add(i)
                return adj
            
