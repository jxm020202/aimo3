                sum_abs = np.sum(np.abs(x - x5))
                term1 = sum_abs**2
                # sum over i<j of (xi - xj)^2
                # can compute via variance formula: sum_{i<j} (xi - xj)^2 = n * sum xi^2 - (sum xi)^2
                # Indeed: Σ_{i<j} (xi - xj)^2 = n Σ xi^2 - (Σ xi)^2
                n = len(x)
                sum_sq = np.sum(x**2)
                sum_ = np.sum(x)
                term2 = n*sum_sq - sum_**2
                denom = sum_sq**3
                return (term1 * term2) / denom
            
