            from functools import lru_cache
            
            # board size
            size = 15
            N = size*size
            
            # map index to (x,y)
            coords = [(i//size, i%size) for i in range(N)]
            
            def cheb_dist(a,b):
                return max(abs(a[0]-b[0]), abs(a[1]-b[1]))
            
            # neighbor masks
            neighbor_mask = [0]*N
            neighbors = [[] for _ in range(N)]
            for i in range(N):
                mask = 0
                for j in range(N):
                    if cheb_dist(coords[i], coords[j]) <= 2:
                        mask |= 1 << j
                        if i != j:
                            neighbors[i].append(j)
                neighbor_mask[i] = mask
            
            # sort neighbors maybe
            for i in range(N):
                neighbors[i].sort()
                
            best = 0
            
            def popcount(x):
                return x.bit_count()
            
            def dfs(available_mask, count):
                global best
                # pruning
                rem = popcount(available_mask)
                if count + 2*(rem//2) <= best:
                    return
                if available_mask == 0:
                    if count > best:
                        best = count
                    return
                # choose first vertex
                v = (available_mask & -available_mask).bit_length() - 1  # index of lowest set bit
                # Option 1: skip v
                dfs(available_mask & ~(1 << v), count)
                # Option 2: pair v with neighbor w
                # iterate over neighbors w that are in available_mask and w>v maybe to avoid duplicates
                for w in neighbors[v]:
                    if (available_mask >> w) & 1:
                        # ensure w != v
                        # compute new mask
                        new_mask = available_mask & ~ (neighbor_mask[v] | neighbor_mask[w])
                        dfs(new_mask, count+2)
            
