            import mpmath as mp
            
            def A(theta):
                # formula for 0<=theta<=pi/4
                s = math.sin(theta)
                c = math.cos(theta)
                num = (c + s - 1)**2
                denom = 2 * s * c
                return 1 - num/denom
            
            def avg_A():
                f = lambda th: A(th)
                # integrate over 0 to pi/4 and double
                I = mp.quad(f, [0, mp.pi/4])
                avg = (4/mp.pi) * I
                return avg
            
            print(avg_A())
            print(1 - avg_A())
            
