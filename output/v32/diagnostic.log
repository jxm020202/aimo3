            def find_perm_distinct(N):
                # backtrack
                used = [False]*(N)  # distances 1..N-1
                perm = [0]*N
                def backtrack(i):
                    if i==N:
                        return True
                    for val in range(1,N+1):
                        if val in perm[:i]:
                            continue
                        diff = abs(val-(i+1))
                        if diff==0 or used[diff]:
                            continue
                        used[diff]=True
                        perm[i]=val
                        if backtrack(i+1):
                            return True
                        used[diff]=False
                        perm[i]=0
                    return False
                if backtrack(0):
                    return tuple(perm)
                else:
                    return None
            
