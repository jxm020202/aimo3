            def solve_min_dominos_n_positive(n):
                placements, constraints = build_constraints(n)
                m = len(constraints)
                p = len(placements)
                A = np.zeros((m+1, p), dtype=int)
                b = np.zeros(m+1, dtype=int)
                # constraints rows
                for idx,row in enumerate(constraints):
                    for var,coeff in row.items():
                        A[idx,var] = coeff
                # add sum >= 1 => -sum <= -1 (or we can add as lower bound)
                # We'll add row: -1 * sum x_i <= -1 (i.e., -sum <= -1)
                A[m,:] = -1
                b[m] = -1  # lower bound -inf? Actually we need ub = -1, lb = -inf
                # We'll use LinearConstraint with lower bound -inf and upper bound -1 for this row.
                # So we need to separate this constraint.
                # Instead, we can add as separate LinearConstraint.
                # Let's create constraints list.
                large = np.full(m, 1e9, dtype=float)
                lin_block = LinearConstraint(A[:m,:], lb=b[:m], ub=large)
                # sum >=1 constraint
                sum_con = LinearConstraint(A[m,:], lb=-np.inf, ub=-1)
                bounds = Bounds(0,1)
                c = np.ones(p, dtype=int)
                res = milp(c=c, constraints=[lin_block, sum_con], bounds=bounds, integrality=np.ones(p, dtype=int))
                if not res.success:
                    return None
                x = np.rint(res.x).astype(int)
                m_val = int(res.fun)
                selected = [i for i,xi in enumerate(x) if xi==1]
                return m_val, selected, placements
            
