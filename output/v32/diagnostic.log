            def graph_info(n, a=866):
                # compute A and B maps
                A = [(a * x) % n for x in range(n)]
                mod = n+1
                B = [pow(b, a, mod) for b in range(1, n+1)]
                B = [(val-1) % n for val in B]  # map to 0..n-1
                # indegree
                indegA = [0]*n
                indegB = [0]*n
                for y in A:
                    indegA[y] += 1
                for y in B:
                    indegB[y] += 1
                # compute nodes in cycles via pruning leaves
                def core_nodes(map_func, indeg):
                    n = len(map_func)
                    indeg_cur = indeg[:]
                    removed = [False]*n
                    queue = [i for i in range(n) if indeg_cur[i]==0]
                    while queue:
                        v = queue.pop()
                        removed[v]=True
                        w = map_func[v]
                        indeg_cur[w]-=1
                        if indeg_cur[w]==0:
                            queue.append(w)
                    core = [i for i in range(n) if not removed[i]]
                    return set(core)
                coreA = core_nodes(A, indegA)
                coreB = core_nodes(B, indegB)
                # compute cycles lengths within core
                def cycles_lengths(map_func, core_set):
                    visited=set()
                    cycles=[]
                    for v in core_set:
                        if v not in visited:
                            cur=v
                            length=0
                            while cur not in visited:
                                visited.add(cur)
                                cur=map_func[cur]
                                length+=1
                            cycles.append(length)
                    return cycles
                cyclesA = cycles_lengths(A, coreA)
                cyclesB = cycles_lengths(B, coreB)
                # compute max depth of trees (distance from node to core)
                def max_depth(map_func, core_set):
                    n=len(map_func)
                    depth=[-1]*n
                    # core nodes depth 0
                    for v in core_set:
                        depth[v]=0
                    # compute depth for others by following map until core
                    for v in range(n):
                        if depth[v]==-1:
                            cur=v
                            d=0
                            while depth[cur]==-1:
                                cur=map_func[cur]
                                d+=1
                            # now depth[cur] known
                            base=depth[cur]
                            # backtrack assign depths
                            cur=v
                            while depth[cur]==-1:
                                nxt=map_func[cur]
                                depth[cur]=base+d
                                d-=1
                                cur=nxt
                    return max(depth)
                maxdepthA = max_depth(A, coreA)
                maxdepthB = max_depth(B, coreB)
                # indegree histogram
                histA = collections.Counter(indegA)
                histB = collections.Counter(indegB)
                return {
                    'A':A,'B':B,
                    'indegA':indegA,'indegB':indegB,
                    'histA':histA,'histB':histB,
                    'coreA':coreA,'coreB':coreB,
                    'cyclesA':sorted(cyclesA),'cyclesB':sorted(cyclesB),
                    'maxdepthA':maxdepthA,'maxdepthB':maxdepthB
                }
            
            def candidate_n(limit=2000):
                cand=[]
                for n in range(866, limit+1):
                    info=graph_info(n)
                    if info['histA']==info['histB'] and sorted(info['cyclesA'])==sorted(info['cyclesB']) and info['maxdepthA']==info['maxdepthB']:
                        cand.append((n, info))
                return cand
            
            cand=candidate_n(2000)
            len(cand)
            
