            def rotate_point(p, theta):
                x, y = p
                c, s = math.cos(theta), math.sin(theta)
                return (c*x - s*y, s*x + c*y)
            
            def polygon_area(poly):
                # poly list of (x,y) vertices in order (counterclockwise)
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1, y1 = poly[i]
                    x2, y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2.0
            
            def clip_polygon(poly, edge_start, edge_end):
                # Keep points on left side of edge (including on edge)
                def is_inside(p):
                    # cross product (edge_end - edge_start) x (p - edge_start) >= 0
                    x1, y1 = edge_start
                    x2, y2 = edge_end
                    x, y = p
                    return (x2 - x1)*(y - y1) - (y2 - y1)*(x - x1) >= -1e-12  # tolerance
                
                def intersection(p1, p2):
                    # line segment p1-p2 intersect with infinite line edge_start-edge_end
                    # compute intersection point of lines (p1,p2) and (edge_start,edge_end)
                    x1, y1 = p1
                    x2, y2 = p2
                    x3, y3 = edge_start
                    x4, y4 = edge_end
                    # Solve using parametric form
                    # p1 + t*(p2-p1) intersect line (x3,y3)+(u)*(x4-x3,y4-y3)
                    # Use line intersection formula
                    denom = (x1 - x2)*(y3 - y4) - (y1 - y2)*(x3 - x4)
                    if abs(denom) < 1e-15:
                        return None
                    # Intersection point
                    px = ((x1*y2 - y1*x2)*(x3 - x4) - (x1 - x2)*(x3*y4 - y3*x4)) / denom
                    py = ((x1*y2 - y1*x2)*(y3 - y4) - (y1 - y2)*(x3*y4 - y3*x4)) / denom
                    return (px, py)
                
                output = []
                n = len(poly)
                for i in range(n):
                    cur = poly[i]
                    prev = poly[(i-1)%n]
                    cur_in = is_inside(cur)
                    prev_in = is_inside(prev)
                    if cur_in:
                        if not prev_in:
                            # edge enters region: add intersection
                            inter = intersection(prev, cur)
                            if inter:
                                output.append(inter)
                        output.append(cur)
                    elif prev_in:
                        # edge exits region: add intersection
                        inter = intersection(prev, cur)
                        if inter:
                            output.append(inter)
                return output
            
