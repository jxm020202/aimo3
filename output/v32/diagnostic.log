            def max_pairs_backtrack(board_size=15, max_pairs_target=7):
                n = board_size
                # Precompute neighbor cells within distance <=2 for each cell
                cells = [(i,j) for i in range(n) for j in range(n)]
                index = { (i,j): idx for idx,(i,j) in enumerate(cells) }
                neighbor_dict = {}
                for (i,j) in cells:
                    neigh = []
                    for di in range(-2,3):
                        for dj in range(-2,3):
                            if di==0 and dj==0: continue
                            ii, jj = i+di, j+dj
                            if 0 <= ii < n and 0 <= jj < n:
                                neigh.append((ii,jj))
                    neighbor_dict[(i,j)] = neigh
                
                best = {'pairs': []}
                # Use recursion with ordering: choose smallest index unoccupied cell
                occupied = set()
                # For speed, we can maintain a set of forbidden cells (cannot be used for new pieces)
                forbidden = set()
                
                # Precompute all possible partner choices for each cell (neighbors within distance <=2)
                possible_partners = {}
                for cell in cells:
                    possible_partners[cell] = neighbor_dict[cell]
                
                # Heuristic: sort cells maybe by degree (number of possible partners)
                # Not needed.
                
                def recurse(pairs):
                    # pairs is list of (cell1, cell2)
                    # Update best
                    if len(pairs) > len(best['pairs']):
                        best['pairs'] = pairs.copy()
                        # print progress
                        #print("New best:", len(pairs)*2)
                        if len(pairs) == max_pairs_target:
                            raise StopIteration  # found target
                    # Choose next cell to try: smallest cell not forbidden and not occupied
                    # Actually we need to consider cells not yet occupied and not forbidden.
                    # Since occupied cells are part of pairs, they are also forbidden for other pieces (distance <=2)
                    # We'll maintain a set of allowed cells: those not in forbidden.
                    # If no more allowed cells, backtrack.
                    # Choose cell with smallest index.
                    for cell in cells:
                        if cell not in forbidden:
                            start_cell = cell
                            break
                    else:
                        return  # no more cells
                    
                    # Try to pair start_cell with any neighbor that is also allowed
                    for partner in possible_partners[start_cell]:
                        if partner in forbidden:
                            continue
                        # Ensure partner != start_cell (already)
                        # Pair them
                        # Compute new forbidden cells: all cells within distance <=2 of either piece
                        new_forbidden = set()
                        for p in [start_cell, partner]:
                            for di in range(-2,3):
                                for dj in range(-2,3):
                                    ii, jj = p[0]+di, p[1]+dj
                                    if 0 <= ii < n and 0 <= jj < n:
                                        new_forbidden.add((ii,jj))
                        # Save current forbidden
                        old_forbidden = forbidden.copy()
                        # Update forbidden
                        forbidden.update(new_forbidden)
                        # Add pair
                        pairs.append((start_cell, partner))
                        # Recurse
                        recurse(pairs)
                        # Backtrack
                        pairs.pop()
                        forbidden.clear()
                        forbidden.update(old_forbidden)
                    # Also consider not placing a piece at start_cell (skip it)
                    # Mark start_cell as forbidden (cannot be used) and continue
                    old_forbidden = forbidden.copy()
                    forbidden.add(start_cell)
                    recurse(pairs)
                    forbidden.clear()
                    forbidden.update(old_forbidden)
                
                try:
                    recurse([])
                except StopIteration:
                    pass
                return best['pairs']
            
            pairs = max_pairs_backtrack()
            len(pairs), pairs[:5]
            
