            def solve_max_induced_matching(board_size=15, time_limit=60):
                n = board_size
                N = n*n
                # Build edges list
                edges = []
                edge_index = {}
                for i in range(n):
                    for j in range(n):
                        node = i*n + j
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                if di==0 and dj==0: continue
                                ii, jj = i+di, j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    neighbor = ii*n + jj
                                    if node < neighbor:
                                        idx = len(edges)
                                        edges.append((node, neighbor))
                                        edge_index[(node, neighbor)] = idx
                E = len(edges)
                # Vertex incident edges list
                incident_edges = [[] for _ in range(N)]
                for idx, (u,v) in enumerate(edges):
                    incident_edges[u].append(idx)
                    incident_edges[v].append(idx)
                # Build conflict constraints
                # Precompute vertex_range
                vertex_range = []
                for i in range(n):
                    for j in range(n):
                        v = i*n + j
                        rng = set()
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                ii, jj = i+di, j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    rng.add(ii*n + jj)
                        vertex_range.append(rng)
                edge_range = [vertex_range[u] | vertex_range[v] for (u,v) in edges]
                # Build list of conflict pairs (i,j) with i<j
                conflict_pairs = []
                for i in range(E):
                    u_i, v_i = edges[i]
                    rng_i = edge_range[i]
                    for j in range(i+1, E):
                        u_j, v_j = edges[j]
                        # conflict if share vertex
                        if u_i in (u_j, v_j) or v_i in (u_j, v_j):
                            conflict_pairs.append((i,j))
                            continue
                        # conflict if any endpoint of j in rng_i
                        if u_j in rng_i or v_j in rng_i:
                            conflict_pairs.append((i,j))
                            continue
                        # also need check reverse (but symmetric)
                        # Actually if u_i in rng_j or v_i in rng_j, then also conflict, but this is covered because if not caught above, then u_i not in rng_i? Wait need to compute rng_j
                        # Let's compute rng_j
                        rng_j = edge_range[j]
                        if u_i in rng_j or v_i in rng_j:
                            conflict_pairs.append((i,j))
                            continue
                # Build constraint matrix
                # We'll have constraints:
                # 1) For each vertex v: sum_{e incident to v} y_e <= 1
                # 2) For each conflict pair (i,j): y_i + y_j <= 1
                num_constraints = N + len(conflict_pairs)
                # Build sparse matrix in COO format
                rows = []
                cols = []
                data = []
                b = np.ones(num_constraints, dtype=float)  # RHS = 1 for all constraints
                # Vertex constraints
                for v in range(N):
                    for e_idx in incident_edges[v]:
                        rows.append(v)
                        cols.append(e_idx)
                        data.append(1.0)
                # Conflict constraints
                offset = N
                for idx, (i,j) in enumerate(conflict_pairs):
                    rows.append(offset + idx)
                    cols.append(i)
                    data.append(1.0)
                    rows.append(offset + idx)
                    cols.append(j)
                    data.append(1.0)
                A = sp.coo_matrix((data, (rows, cols)), shape=(num_constraints, E)).tocsc()
                # Objective: maximize sum y => minimize -sum y
                c = -np.ones(E, dtype=float)
                bounds = Bounds(0, 1)
                integrality = np.ones(E, dtype=int)
                constraints = LinearConstraint(A, -np.inf*np.ones(num_constraints), b)  # lower bound -inf, upper bound 1
                start = time.time()
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality,
                           options={"presolve": True, "disp": False, "time_limit": time_limit})
                elapsed = time.time() - start
                print("status:", res.success, res.message, "time:", elapsed)
                if not res.success:
                    return None
                y = np.rint(res.x).astype(int)
                selected_edges = [edges[i] for i, val in enumerate(y) if val==1]
                return selected_edges
            
            selected = solve_max_induced_matching(time_limit=30)
            len(selected)
            
