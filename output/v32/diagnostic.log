            def min_edge_domination(n):
                cells=[(i,j) for i in range(n) for j in range(n)]
                sums=[i+j for i,j in cells]
                diffs=[i-j for i,j in cells]
                N=len(cells)
                A=np.zeros((N,N), dtype=int)
                for e,(i,j) in enumerate(cells):
                    s=sums[e]; d=diffs[e]
                    for f in range(N):
                        if sums[f]==s or diffs[f]==d:
                            A[e,f]=1
                # solve MILP
                c=np.ones(N)
                lin_con=LinearConstraint(A, np.ones(N), np.full(N, np.inf))
                bounds=Bounds(0,1)
                integrality=np.ones(N, dtype=int)
                res=milp(c=c, constraints=[lin_con], bounds=bounds, integrality=integrality, options={'disp': False})
                return int(round(res.fun))
            
