                levelA, in_cycleA, predA = compute_levels(A)
                levelB, in_cycleB, predB = compute_levels(B)
                max_level = max(levelA)
                if max(levelA)!=max(levelB):
                    return None
                # Check multiset of nodes per level
                from collections import Counter
                if Counter(levelA)!=Counter(levelB):
                    return None
                # Now map nodes level by level
                f=[None]*n
                # For level 0 (cycles), need to match cycles preserving structure
                # We'll use same approach as before to map cycles
                def find_cycles(map_func):
                    n=len(map_func)
                    visited=[False]*n
                    cycles=[]
                    node_cycle=[-1]*n
                    for i in range(n):
                        if not visited[i]:
                            cur=i
                            stack=[]
                            while not visited[cur]:
                                visited[cur]=True
                                stack.append(cur)
                                cur=map_func[cur]
                            if cur in stack:
                                idx=stack.index(cur)
                                cycle=stack[idx:]
                                cycles.append(cycle)
                                for v in cycle:
                                    node_cycle[v]=len(cycles)-1
                    return cycles, node_cycle
                cyclesA, node_cycle_A = find_cycles(A)
                cyclesB, node_cycle_B = find_cycles(B)
                # Check cycle length multiset
                lengthsA=sorted([len(c) for c in cyclesA])
                lengthsB=sorted([len(c) for c in cyclesB])
                if lengthsA!=lengthsB:
                    return None
                # Map cycles arbitrarily preserving order
                from collections import defaultdict
                cyclesA_by_len=defaultdict(list)
                cyclesB_by_len=defaultdict(list)
                for c in cyclesA:
                    cyclesA_by_len[len(c)].append(c)
                for c in cyclesB:
                    cyclesB_by_len[len(c)].append(c)
                for L in cyclesA_by_len:
                    listA=cyclesA_by_len[L]
                    listB=cyclesB_by_len[L]
                    if len(listA)!=len(listB):
                        return None
                    for cycA, cycB in zip(listA, listB):
                        for i, vA in enumerate(cycA):
                            vB = cycB[i % len(cycB)]
                            f[vA]=vB
                # Now process levels 1..max_level
                for lev in range(1, max_level+1):
                    # For each node v at this level in A, its image is some node parent = A[v] at level lev-1 (already assigned)
                    # We need to assign f[v] to a node w such that B[w] = f[parent] and w not assigned yet, and w's level = lev
                    # For each parent node p, we can match its children in batch
                    # Build mapping from parent to list of its children at this level
                    parent_children_A=defaultdict(list)
                    for v in range(n):
                        if levelA[v]==lev:
                            parent_children_A[A[v]].append(v)
                    parent_children_B=defaultdict(list)
                    for w in range(n):
                        if levelB[w]==lev:
                            parent_children_B[B[w]].append(w)
                    # For each parent p in A, its image f[p] is known
                    for p, childrenA in parent_children_A.items():
                        target = f[p]  # node in B at level lev-1
                        childrenB = parent_children_B[target]
                        if len(childrenA)!=len(childrenB):
                            return None
                        # assign bijection arbitrarily
                        for u, w in zip(childrenA, childrenB):
                            f[u]=w
                # Verify bijection and condition
                if any(v is None for v in f):
                    return None
                if len(set(f))!=n:
                    return None
                for x in range(n):
                    if f[A[x]] != B[f[x]]:
                        return None
                return f
            
            # test for n=876
            f876 = construct_f_isomorphism_levels(876)
            print(f876 is not None)
            
