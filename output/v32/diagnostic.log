            def count_colorings_dp():
                import networkx as nx
                from functools import lru_cache
                from itertools import product
            
                G = nx.dodecahedral_graph()
                edges = list(G.edges())
                nE = len(edges)
                verts = list(G.nodes())
                nV = len(verts)
                vert_index = {v:i for i,v in enumerate(verts)}
                # edge index mapping
                edge_index = {}
                for idx, (u,v) in enumerate(edges):
                    edge_index[(u,v)] = idx
                    edge_index[(v,u)] = idx
                # incident edges per vertex (list of edge indices)
                vertex_edges = [[] for _ in range(nV)]
                for idx,(u,v) in enumerate(edges):
                    ui, vi = vert_index[u], vert_index[v]
                    vertex_edges[ui].append(idx)
                    vertex_edges[vi].append(idx)
                for lst in vertex_edges:
                    lst.sort()
                # choose vertex order: BFS from vertex 0
                order = list(nx.bfs_tree(G, source=verts[0]))
                # ensure all vertices included (graph is connected)
                # BFS returns nodes in order visited
                # Convert to indices
                order_idx = [vert_index[v] for v in order]
                # recursion with memo
                @lru_cache(maxsize=None)
                def dfs(i, frontier_frozenset):
                    if i == nV:
                        # all vertices processed; frontier should be empty
                        return 1 if not frontier_frozenset else 0
                    v = order_idx[i]
                    incident = vertex_edges[v]
                    # frontier dict
                    frontier = dict(frontier_frozenset)
                    assigned_edges = [e for e in incident if e in frontier]
                    assigned_colors = [frontier[e] for e in assigned_edges]
                    unassigned_edges = [e for e in incident if e not in frontier]
                    total = 0
                    # iterate over color assignments for unassigned edges
                    for colors in product(range(3), repeat=len(unassigned_edges)):
                        all_colors = assigned_colors + list(colors)
                        # check 2+1 condition
                        cnt0 = all_colors.count(0)
                        cnt1 = all_colors.count(1)
                        cnt2 = all_colors.count(2)
                        # sorted counts must be [0,1,2]
                        # faster check:
                        # exactly one count ==2, one count ==1, one count ==0
                        if not ((cnt0==2 and cnt1==1 and cnt2==0) or
                                (cnt0==2 and cnt2==1 and cnt1==0) or
                                (cnt1==2 and cnt0==1 and cnt2==0) or
                                (cnt1==2 and cnt2==1 and cnt0==0) or
                                (cnt2==2 and cnt0==1 and cnt1==0) or
                                (cnt2==2 and cnt1==1 and cnt0==0)):
                            continue
                        # update frontier
                        new_frontier = dict(frontier)
                        # remove assigned edges (now fully processed)
                        for e in assigned_edges:
                            del new_frontier[e]
                        # add unassigned edges with assigned colors
                        for e, col in zip(unassigned_edges, colors):
                            new_frontier[e] = col
                        total += dfs(i+1, frozenset(new_frontier.items()))
                    return total
                result = dfs(0, frozenset())
                return result
            
            print(count_colorings_dp())
            
