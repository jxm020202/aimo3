            import itertools, math
            
            def min_T_n(n):
                N = 2**n
                vertices = list(range(N))
                start = 0
                # generate all permutations of remaining vertices (N-1)! huge for n>4, but for n=3 it's 7! = 5040
                min_T = None
                best_seq = None
                for perm in itertools.permutations(vertices[1:]):  # exclude start
                    seq = (start,) + perm
                    # check if consecutive differ by power of two
                    ok = True
                    T = 0.0
                    for a,b in zip(seq, seq[1:]):
                        diff = abs(a-b)
                        # check if diff is power of two
                        if diff == 0 or (diff & (diff-1)) != 0:
                            ok = False
                            break
                        T += 1/diff
                    if ok:
                        if min_T is None or T < min_T - 1e-12:
                            min_T = T
                            best_seq = seq
                return min_T, best_seq
            
            min_T_n(3)
            
