                    m = (1 - p*a - r*b)/q
                    # ordering constraints
                    if not (a <= m <= b):
                        continue
                    # compute S2
                    S2 = p*a*a + q*m*m + r*b*b
                    A = r*b - p*a
                    if S2 <= 0:
                        continue
                    E = A*A * (9*S2 - 1) / (S2**3)
                    if E > best:
                        best = E
                return best
            
