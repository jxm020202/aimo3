            def construct():
                n=60
                b = np.zeros(n)
                for i in range(n):
                    mod = (i+1) % 12  # i from 0 corresponds to b_1? Actually b_i = a_i - a_{i+1}, i from 1..60.
                    # Let's define i index 0 corresponds to b_1 (a1 - a2)
                    # So (i+1) mod 12 gives remainder of i+1.
                    if (i+1) % 12 in [6,7,8,9,10,11]:
                        b[i] = -1
                    else:
                        b[i] = 1
                # compute a's: set a1 = 0 then compute forward
                a = np.zeros(n)
                a[0] = 0
                for i in range(1,n):
                    a[i] = a[i-1] - b[i-1]  # because b_{i} = a_i - a_{i+1} => a_{i+1}=a_i - b_i
                # Now adjust to make sum zero: add constant c to all a's
                total = a.sum()
                c = -total/ n
                a += c
                return a, b
