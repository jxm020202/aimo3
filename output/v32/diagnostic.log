            def count_colorings():
                # domains: list of sets of possible colors per edge
                domains = [set([0,1,2]) for _ in range(30)]
                # assignment list, None if unassigned
                assign = [None]*30
                # order edges by heuristic: maybe edges with most constrained (i.e., appear in many triangles) - all edges appear in 2 triangles.
                # We'll use recursion with forward checking.
                count = 0
                # Use stack recursion with closure for speed?
                sys.setrecursionlimit(10000)
                def select_unassigned_edge():
                    # choose edge with smallest domain size >1 (MRV)
                    min_size = 4
                    chosen = None
                    for i in range(30):
                        if assign[i] is None:
                            sz = len(domains[i])
                            if sz < min_size:
                                min_size = sz
                                chosen = i
                                if sz == 1:
                                    break
                    return chosen
            
                def backtrack():
                    nonlocal count
                    # find unassigned edge
                    e = select_unassigned_edge()
                    if e is None:
                        # all assigned
                        count += 1
                        return
                    # copy current domains for restoration
                    saved_domains = [domains[i].copy() for i in range(30)]
                    # try each color in domain
                    for col in list(domains[e]):  # iterate over copy
                        assign[e] = col
                        # update domains for triangles containing e
                        consistent = True
                        for ti in edge_triangles[e]:
                            e1,e2,e3 = tri_edges[ti]
                            # get colors of edges if assigned
                            vals = []
                            unassigned = []
                            for ee in (e1,e2,e3):
                                if assign[ee] is not None:
                                    vals.append(assign[ee])
                                else:
                                    unassigned.append(ee)
                            if len(unassigned) == 0:
                                # all assigned, check condition
                                if len(set(vals)) != 2:
                                    consistent = False
                                    break
                            elif len(unassigned) == 1:
                                # two assigned, enforce third's domain to be colors present among assigned (size 2)
                                allowed = set(vals)
                                # if assigned colors are same, allowed is that color's complement (i.e., other two colors)
                                if len(allowed) == 1:
                                    # must be different color, so allowed = {other colors}
                                    allowed = {c for c in (0,1,2) if c != vals[0]}
                                # else allowed already two colors (the two assigned distinct)
                                # intersect with current domain
                                ue = unassigned[0]
                                new_domain = domains[ue] & allowed
                                if not new_domain:
                                    consistent = False
                                    break
                                domains[ue] = new_domain
                            else:
                                # only one assigned, no immediate restriction
                                pass
                        if consistent:
                            backtrack()
                        # restore domains and assignment
                        assign[e] = None
                        for i in range(30):
                            domains[i] = saved_domains[i].copy()
                    # end loop
                backtrack()
                return count
            
            start = time.time()
            cnt = count_colorings()
            elapsed = time.time() - start
            cnt, elapsed
            
