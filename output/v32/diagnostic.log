                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1, y1 = poly[i]
                    x2, y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2.0
            
            def intersect_polygons(poly1, poly2):
