            def max_S_grid(m,n):
                N=m*n
                verts = list(range(N))
                edges=[]
                for i in range(m):
                    for j in range(n):
                        u=i*n+j
                        if i+1<m:
                            edges.append((u,(i+1)*n+j))
                        if j+1<n:
                            edges.append((u,i*n+(j+1)))
                V=N
                K=N
                var_count=V*K
                # Precompute row indices for constraints to speed up? We'll just build each time.
                low=0
                high=2*N
                best=0
                while low<=high:
                    mid=(low+high)//2
                    # Build constraints
                    rows=[]
                    lbs=[]
                    ubs=[]
                    # vertex constraints equality =1
                    for v in range(V):
                        row=np.zeros(var_count)
                        for k in range(K):
                            row[v*K + k]=1
                        rows.append(row)
                        lbs.append(1)
                        ubs.append(1)
                    # number constraints equality =1
                    for k in range(K):
                        row=np.zeros(var_count)
                        for v in range(V):
                            row[v*K + k]=1
                        rows.append(row)
                        lbs.append(1)
                        ubs.append(1)
                    # edge constraints sum <=1 for forbidden pairs
                    for (u,v) in edges:
                        for k in range(K):
                            for l in range(K):
                                if (k+1)+(l+1) < mid:
                                    row=np.zeros(var_count)
                                    row[u*K + k]=1
                                    row[v*K + l]=1
                                    rows.append(row)
                                    lbs.append(-np.inf)
                                    ubs.append(1)
                    A=np.array(rows)
                    lbs=np.array(lbs)
                    ubs=np.array(ubs)
                    c=np.zeros(var_count)
                    bounds=Bounds(0,1)
                    integrality=np.ones(var_count)
                    res=milp(c, constraints=LinearConstraint(A, lbs, ubs), bounds=bounds,
                              integrality=integrality, options={'disp': False})
                    feasible=res.success
                    if feasible:
                        best=mid
                        low=mid+1
                    else:
                        high=mid-1
                return best
            
