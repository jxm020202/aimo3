            def min_edge_dom(color):
                # color: 'black' if (i+j)%2==0? Let's define black as (i+j)%2==0 (even sum)
                # We'll compute for even sum (white?) whichever.
                # We'll treat parity = (i+j)%2
                edges_color=[]
                for i in range(1,n+1):
                    for j in range(1,n+1):
                        if (i+j)%2==color:
                            l=left_index_map[i-j]
                            r=right_index_map[i+j]
                            edges_color.append((l,r))
                # Determine left and right vertices present
                left_vertices=set(l for l,r in edges_color)
                right_vertices=set(r for l,r in edges_color)
                Llist=sorted(left_vertices)
                Rlist=sorted(right_vertices)
                L_index={v:i for i,v in enumerate(Llist)}
                R_index={v:i for i,v in enumerate(Rlist)}
                m=len(edges_color)
                # Build incidence
                edges_idx=[]
                for (l,r) in edges_color:
                    edges_idx.append((L_index[l], R_index[r]))
                Lsize=len(Llist)
                Rsize=len(Rlist)
                # Build constraints similar to before
                num_vars=m
                A=[]
                lb=[]
                ub=[]
                # left vertex constraints
                for li in range(Lsize):
                    row=np.zeros(num_vars)
                    for e_idx,(l_i,r_i) in enumerate(edges_idx):
                        if l_i==li:
                            row[e_idx]=1
                    A.append(row); lb.append(-np.inf); ub.append(1)
                # right vertex constraints
                for ri in range(Rsize):
                    row=np.zeros(num_vars)
                    for e_idx,(l_i,r_i) in enumerate(edges_idx):
                        if r_i==ri:
                            row[e_idx]=1
                    A.append(row); lb.append(-np.inf); ub.append(1)
                # edge maximality constraints
                # need adjacency list per vertex
                edges_by_left=[[] for _ in range(Lsize)]
                edges_by_right=[[] for _ in range(Rsize)]
                for e_idx,(l_i,r_i) in enumerate(edges_idx):
                    edges_by_left[l_i].append(e_idx)
                    edges_by_right[r_i].append(e_idx)
                for e_idx,(l_i,r_i) in enumerate(edges_idx):
                    row=np.zeros(num_vars)
                    for e2 in edges_by_left[l_i]:
                        row[e2]=1
                    for e2 in edges_by_right[r_i]:
                        row[e2]=1
                    A.append(row); lb.append(1); ub.append(np.inf)
                A=np.array(A)
                lb=np.array(lb)
                ub=np.array(ub)
                c=np.ones(num_vars)
                bounds=Bounds(0,1)
                integrality=np.ones(num_vars, dtype=int)
                res=milp(c=c, constraints=LinearConstraint(A,lb,ub), bounds=bounds, integrality=integrality, options={'disp': False})
                return int(round(res.fun))
            # compute for parity 0 and 1
            print(min_edge_dom(0), min_edge_dom(1))
            
