                    incident_edges[u].append(e_idx)
                    incident_edges[v].append(e_idx)
                # conflict pairs between edges
                # conflict if they share a vertex or any endpoint within distance <=2 (i.e., there exists vertex a in edge i, b in edge j with Chebyshev distance <=2)
                # We'll precompute adjacency of vertices within distance <=2 (including same vertex?) Already edges list includes all such pairs.
                # For conflict detection, we can compute for each edge i, the set of vertices within distance <=2 of its endpoints (including endpoints themselves). Then any other edge j that has any vertex in that set conflicts.
                # Simpler: For each pair of edges (i<j), check if any endpoint of i is within distance <=2 of any endpoint of j.
                # This is O(E^2) ~ (2000)^2 ~ 4 million, okay.
                # Precompute coordinates for vertices
                vertex_coords = coords
                # Precompute distance matrix maybe.
                def cheb_dist(a,b):
                    return max(abs(a[0]-b[0]), abs(a[1]-b[1]))
                # Build conflict list
                conflict_pairs = []
                for i in range(E):
                    u1,v1 = edges[i]
                    c1 = vertex_coords[u1]
                    c2 = vertex_coords[v1]
                    for j in range(i+1, E):
                        u2,v2 = edges[j]
                        # quick reject if share vertex
                        if u1==u2 or u1==v2 or v1==u2 or v1==v2:
                            conflict_pairs.append((i,j))
                            continue
                        # check distances
                        if (cheb_dist(c1, vertex_coords[u2]) <= 2 or
                            cheb_dist(c1, vertex_coords[v2]) <= 2 or
                            cheb_dist(c2, vertex_coords[u2]) <= 2 or
                            cheb_dist(c2, vertex_coords[v2]) <= 2):
                            conflict_pairs.append((i,j))
                print("N",N,"V",V,"E",E,"conflict pairs",len(conflict_pairs))
                # MILP
                c = -np.ones(E)  # maximize number of edges selected
                # constraints: for each vertex, sum incident edges <=1
                A_ub = np.zeros((V + len(conflict_pairs), E), dtype=float)
                b_ub = np.ones(V + len(conflict_pairs))
                # vertex constraints
                for v in range(V):
                    for e_idx in incident_edges[v]:
                        A_ub[v, e_idx] = 1.0
                # conflict constraints
                offset = V
                for idx, (i,j) in enumerate(conflict_pairs):
                    A_ub[offset+idx, i] = 1.0
                    A_ub[offset+idx, j] = 1.0
                lin_ub = LinearConstraint(A_ub, -np.inf, b_ub)
                bounds = Bounds(np.zeros(E), np.ones(E))
                integrality = np.full(E, 2, dtype=int)
                res = milp(c=c, constraints=[lin_ub], bounds=bounds, integrality=integrality, options={'disp': False})
                return res, E, len(conflict_pairs)
            
            res15, E15, C15 = max_induced_matching(15)
            print(res15.success, res15.message)
            
