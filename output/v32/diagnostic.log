            def indegree_distribution(n, a=866):
                # A map: x -> a*x mod n, with x in 0..n-1 representing numbers 1..n (0 corresponds to n)
                A = [(a * x) % n for x in range(n)]
                indegA = [0]*n
                for y in A:
                    indegA[y] += 1
                # B map: b -> b^a mod (n+1), for b in 1..n (we map to 0..n-1)
                mod = n+1
                B = [pow(b, a, mod) for b in range(1, n+1)]
                # Convert result to index 0..n-1 (since result is in 1..n)
                B_idx = [(val-1) % n for val in B]  # val cannot be 0, but just in case
                indegB = [0]*n
                for y in B_idx:
                    indegB[y] += 1
                # Return histograms as sorted tuple of counts
                histA = collections.Counter(indegA)
                histB = collections.Counter(indegB)
                return histA, histB, A, B_idx
            
            def check_isomorphic(n):
                histA, histB, A, B = indegree_distribution(n)
                return histA == histB
            
            # test for small n
            for n in range(2, 30):
                if check_isomorphic(n):
                    print("candidate", n)
            
