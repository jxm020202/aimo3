                    if i == 0:
                        row[0] = 1  # a0
                    elif i == N-1:
                        row[n_edges + (N-2)] = 1  # b_{N-2}
                    else:
                        row[i] = 1  # a_i
                        row[n_edges + (i-1)] = 1  # b_{i-1}
                    # in (subtract)
                    if i == 0:
                        row[n_edges + 0] -= 1  # -b0
                    elif i == N-1:
                        row[N-2] -= 1  # -a_{N-2}
                    else:
                        row[n_edges + i] -= 1  # -b_i
                        row[i-1] -= 1  # -a_{i-1}
                    # start - end
                    row[2*n_edges + i] += 1
                    row[2*n_edges + N + i] -= 1
                    rows.append(row); rhs.append(0)
                
                # parity constraints: in_i + start_i - p_i = 2*k_i
                for i in range(N):
                    row = np.zeros(total_vars)
                    # in_i coefficient
                    if i == 0:
                        row[n_edges + 0] = 1  # b0
