            import math, numpy as np
            
            def area_overlap_exact(theta):
                # compute intersection area of two unit squares side 1 rotated by theta, shifted by (1,0)
                # Use polygon clipping as defined earlier
                poly1 = rotated_square_vertices(theta)
                poly2 = [(x+1, y) for x,y in poly1]  # shift right by 1
                inter = intersect_polygons(poly1, poly2)
                return polygon_area(inter)
            
            def compute_p(num_samples=2000):
                # integrate area_overlap from 0 to pi/2
                thetas = np.linspace(0, math.pi/2, num_samples)
                areas = np.array([area_overlap_exact(t) for t in thetas])
                # Simpson's rule (need odd number of intervals)
                # Use composite Simpson: h = (b-a)/n where n even
                n = num_samples - 1
                if n % 2 == 1:
                    # make n even by dropping last point
                    n -= 1
                    thetas = thetas[:n+1]
                    areas = areas[:n+1]
                h = (math.pi/2) / n
                S = areas[0] + areas[-1] + 4*areas[1:-1:2].sum() + 2*areas[2:-2:2].sum()
                integral = h/3 * S
                p = (8/math.pi) * integral
                return p
            
            p_est = compute_p(num_samples=2001)
            p_est
            
