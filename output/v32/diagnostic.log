            def f_bruteforce(n, limit=10000):
                # search N from 1 upwards
                for N in range(1, limit+1):
                    # get divisors of N
                    divs = sp.divisors(N)
                    # need three distinct positive divisors a,b,c such that sum = n
                    # we can just iterate combos of 3 distinct divisors
                    for a in divs:
                        for b in divs:
