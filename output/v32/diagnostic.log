                adj_diff_to_sum[diff_index[d]].append(sum_index[s])
            
            # Use networkx to compute maximum matching? Not allowed? We can implement bipartite matching using simple algorithm.
            def max_bipartite_matching(adj):
                # adj: list of lists from left to right indices
                nL = len(adj)
                nR = max((max(lst) if lst else -1) for lst in adj) + 1
                matchR = [-1]*nR
                def dfs(u, seen):
                    for v in adj[u]:
                        if seen[v]:
                            continue
                        seen[v]=True
                        if matchR[v]==-1 or dfs(matchR[v], seen):
                            matchR[v]=u
                            return True
                    return False
                result=0
                for u in range(nL):
                    seen=[False]*nR
                    if dfs(u, seen):
                        result+=1
                return result
            
