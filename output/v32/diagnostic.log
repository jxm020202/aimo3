            import itertools, cmath, math
            
            def max_m_for_r(r_list, max_j=10):
                # returns max m such that product_{k} (r_k**j + 1) == 1 for all j=1..m (within tolerance)
                eps=1e-9
                for m in range(1, max_j+1):
                    ok=True
                    for j in range(1,m+1):
                        prod=1
                        for r in r_list:
                            prod*= (r**j + 1)
                        if abs(prod-1)>1e-6:
                            ok=False
                            break
                    if not ok:
                        return m-1
                return max_j
            
            def search_n(n, roots_orders=[1,2,3,4,5,6,8,12]):
                # generate candidates r from roots of unity of given orders plus 0
                candidates=[0]
                for order in roots_orders:
                    for k in range(order):
                        candidates.append(cmath.exp(2j*math.pi*1j*k/order))
                best=0
                best_r=None
                for r_tuple in itertools.product(candidates, repeat=n):
