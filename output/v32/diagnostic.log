            import math
            
            def last_nonzero_digit_factorial(n):
                # compute D(n) using recurrence
                # using known algorithm
                # We'll compute directly using multiplication and removing factors of 10.
                # but for n up to maybe 2000 it's fine.
                res = 1
                for i in range(2, n+1):
                    res *= i
                    while res % 10 == 0:
                        res //= 10
                    res %= 100000  # keep manageable
                return res % 10
            
            def D(n):
                return last_nonzero_digit_factorial(n)
            
            # test recurrence formula for verification
            def D_recur(n):
                if n==0:
                    return 1
                # using recursion
                # D(n) = D(n//5) * D(n%5) * pow(2, n//5, 10) % 10
                # but need D for small numbers
                small = [1,1,2,6,4]  # D(0..4)
                if n<5:
                    return small[n]
                else:
                    return (D_recur(n//5) * small[n%5] * pow(2, n//5, 10)) % 10
            
            # test equality for some n
            for n in range(1,101):
                if D(n)!=D_recur(n):
                    print("mismatch", n)
                    break
            else:
                print("all good")
            
