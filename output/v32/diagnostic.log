                path = []
                if n==1:
                    return [1]
                if n%4==3:
                    q = (n-3)//4
                    for j in range(q):
                        a = 4*j+1
                        path += [a, a+1, a+2, a+1, a+2, a+3, a+2, a+3]
                    # tail length 3
                    a = 4*q+1
                    path += [a, a+1, a+2, a+1]
