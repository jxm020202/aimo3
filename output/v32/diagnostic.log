            from fractions import Fraction
            
            def f_rational(a,b, max_terms=2000):
                # compute infinite sum using periodic pattern
                # a/b in lowest terms, 0 <= a < b
                # period p = b if a even else 2*b
                a = a % b
                if a == 0:
                    # x=0 => floor(nx)=0 even for all n => sum = 1 (since sum_{n>=1} 2^{-n}=1)
                    return 1.0
                p = b if a%2==0 else 2*b
                # compute pattern contributions for n=1..p
                pattern_sum = 0.0
                for n in range(1, p+1):
                    if (( (n*a)//b ) % 2 == 0):
                        pattern_sum += 2**-n
                # infinite sum = pattern_sum + 2^{-p}*pattern_sum + 2^{-2p}*pattern_sum + ... = pattern_sum / (1 - 2^{-p})
                total = pattern_sum / (1 - 2**-p)
                return total
            
            def min_f_rational(limit_den):
                min_val = 1.0
                min_frac = None
                for b in range(1, limit_den+1):
                    for a in range(1, b):  # exclude 0
                        if math.gcd(a,b)!=1:
                            continue
                        val = f_rational(a,b)
                        if val < min_val:
                            min_val = val
                            min_frac = Fraction(a,b)
                return min_val, min_frac
            
            min_val, min_frac = min_f_rational(100)
            min_val, min_frac
