            diff_vals = list(range(-(n-1), n))  # -12..12
            sum_vals = list(range(2, 2*n+1))   # 2..26
            diff_index = {d:i for i,d in enumerate(diff_vals)}
            sum_index = {s:i for i,s in enumerate(sum_vals)}
            # adjacency list from diff to sums
            adj_diff_to_sum = [[] for _ in diff_vals]
            for i,j in edges:
