            def exists_g(n, max_k=100):
                # backtracking assign g values for each x in 0..n-1
                # maintain used values set
                # constraints: for each assigned pair (a,b) we must ensure delta not in multiples of (b-a)
                # We'll assign sequentially.
                used=[False]*n
                g=[None]*n
                # Precompute forbidden differences for each d
                forb = {}
                for d in range(1,n):
                    s=set()
                    for k in range(max_k+1):
                        s.add((k*d)%n)
                    forb[d]=s
                
                # order of assignment maybe 0..n-1
                def backtrack(idx):
                    if idx==n:
                        return True
                    # choose next x
                    x=idx
                    for y in range(n):
                        if used[y]:
                            continue
                        # check constraints with previously assigned
                        good=True
                        for a in range(idx):
                            if g[a] is None:
                                continue
                            d = (x - a) % n
                            if d==0: 
                                continue
                            delta = (y - g[a]) % n
                            if delta in forb[d]:
                                good=False
                                break
                            # also check opposite direction? Already covered when a earlier.
                            # Also need check for pair (a,x) where d = a-x? Actually we consider ordered pairs.
                            # Since condition uses difference b-a, we need to check both orders.
                            # We'll also check with a as later? Not needed now.
                        if not good:
                            continue
                        # assign
                        g[x]=y
                        used[y]=True
                        if backtrack(idx+1):
                            return True
                        used[y]=False
                        g[x]=None
                    return False
                return backtrack(0)
            
            def find_small_n(limit):
                good=[]
                for n in range(4, limit+1):
                    # composite only
                    if sp.isprime(n):
                        continue
                    if exists_g(n):
                        good.append(n)
                        print("found", n)
                return good
            
