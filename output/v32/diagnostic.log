                    # So need prefix_sum + a + min_sum_remaining(remaining-1, a) <= T
                    # We'll iterate a up to that limit.
                    a_min = prev + 1
                    # compute max a by solving inequality:
                    # prefix_sum + a + (remaining-1)*a + (remaining-1)*(remaining)/2 <= T
                    # => prefix_sum + remaining*a + (remaining-1)*remaining/2 <= T
                    # => remaining*a <= T - prefix_sum - (remaining-1)*remaining/2
                    # => a <= (T - prefix_sum - (remaining-1)*remaining//2) // remaining
                    max_a = (T - prefix_sum - (remaining-1)*remaining//2) // remaining
                    # ensure max_a >= a_min
                    if max_a < a_min:
