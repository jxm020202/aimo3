            import random, math, time, sys, itertools, numpy as np
            
            def point_in_rotated_square(px, py, theta):
                # square centered at origin, side 1, rotated by theta
                # transform point by inverse rotation
                c, s = math.cos(theta), math.sin(theta)
                # rotate point by -theta
                x = c*px + s*py
                y = -s*px + c*py
                return abs(x) <= 0.5 + 1e-12 and abs(y) <= 0.5 + 1e-12
            
            def overlap_area(theta, N=2000000):
                # Monte Carlo within bounding box [-1,1]x[-1,1]
                count = 0
                for _ in range(N):
                    x = random.uniform(-1,1)
                    y = random.uniform(-1,1)
                    if point_in_rotated_square(x, y, theta) and point_in_rotated_square(x-1, y, theta):
                        count += 1
                # area of bounding box = 4
                return 4*count/N
            
            for th in [0.0, 0.001, 0.01, 0.05, 0.1]:
                print(th, overlap_area(th, N=200000))
            
