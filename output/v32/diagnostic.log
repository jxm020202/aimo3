                for r in range(m):
                    for c in range(n):
                        i=idx[(r,c)]
                        if r+1<m:
                            edges.append((i, idx[(r+1,c)]))
                        if c+1<n:
                            edges.append((i, idx[(r,c+1)]))
                num_vars = N*N + 1
                import numpy as np
                A_eq=[]
                b_eq=[]
                # each cell exactly one number
                for i in range(N):
                    row = np.zeros(num_vars, dtype=int)
                    row[i*N:(i+1)*N] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each number exactly one cell
                for k in range(N):
                    row = np.zeros(num_vars, dtype=int)
                    row[k::N] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                A_ub=[]
                b_ub=[]
                for (i,j) in edges:
                    row = np.zeros(num_vars, dtype=int)
                    for k in range(N):
                        row[i*N + k] = -(k+1)
                        row[j*N + k] = -(k+1)
                    row[-1] = 1
                    A_ub.append(row)
                    b_ub.append(0)
                A_eq=np.array(A_eq)
                b_eq=np.array(b_eq)
                A_ub=np.array(A_ub)
                b_ub=np.array(b_ub)
                from scipy.optimize import milp, LinearConstraint, Bounds
                lin_eq = LinearConstraint(A_eq, b_eq, b_eq)
                lin_ineq = LinearConstraint(A_ub, -np.inf, b_ub)
                c = np.zeros(num_vars)
                c[-1] = -1
                lb = np.zeros(num_vars)
                ub = np.ones(num_vars)
                ub[-1] = 2*N
                bounds = Bounds(lb, ub)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=[lin_eq, lin_ineq], bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
