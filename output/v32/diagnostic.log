            def F_XY(X,Y):
                return -27*X**2 + 18*X*Y + 81*X - 3*Y**2 - 27*Y
            
            def max_F_over_X():
                max_val = 0
                max_point = None
                for X in np.linspace(0.001,3,3001):
                    # compute feasible Y range
                    # lower bound:
                    lower = max(0, (4*X - 9)/3)
                    # upper bound Y_max via two-equal case
