            def min_fill_order(adj):
                n = len(adj)
                remaining = set(range(n))
                order = []
                adj_copy = [set(nei) for nei in adj]
                while remaining:
                    # compute fill count for each candidate
                    best = None
                    best_fill = None
                    for v in remaining:
                        # neighbors within remaining
                        neigh = [u for u in adj_copy[v] if u in remaining]
                        # fill edges needed to make neighbors a clique
                        fill = 0
                        neigh_set = set(neigh)
                        for i in range(len(neigh)):
                            for j in range(i+1, len(neigh)):
                                u = neigh[i]; w = neigh[j]
                                if w not in adj_copy[u]:
                                    fill += 1
                        if best is None or fill < best_fill:
                            best = v
                            best_fill = fill
                    # add v to order
                    order.append(best)
                    # make its neighbors a clique
                    neigh = [u for u in adj_copy[best] if u in remaining]
                    for i in range(len(neigh)):
                        for j in range(i+1, len(neigh)):
                            u = neigh[i]; w = neigh[j]
                            adj_copy[u].add(w)
                            adj_copy[w].add(u)
                    # remove v
                    remaining.remove(best)
                return order
            
