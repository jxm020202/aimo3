            from itertools import product
            
            def count_for_triple(f):
                f1,f2,f3 = f
                L = f1+f2+f3
                total=0
                # positions: 0,1,2,3 correspond to step index where backward occurs
                for pos in range(4):
                    # build list of increments d0..d3
                    d = []
                    idx_f = 0
                    for step in range(4):
                        if step==pos:
                            d.append(-L)
                        else:
                            d.append([f1,f2,f3][idx_f])
                            idx_f+=1
                    # compute partial sums
                    s=0
                    mins=1
                    maxs=19
                    lower=1
                    upper=19
                    # compute bounds for a
                    lower = 1
                    upper = 19
                    # for each prefix sum
                    for inc in d[:-1]:  # we need after each step 1..3
                        s += inc
                        lower = max(lower, 1 - s)
                        upper = min(upper, 19 - s)
                    # also need a itself within 1..19 already accounted
                    if lower <= upper:
                        total += (upper - lower + 1)
                return total
            
            total=0
            for f in product(range(1,10), repeat=3):
                total += count_for_triple(f)
            total
            
