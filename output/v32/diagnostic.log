            def compute_p_integral(num_theta=2001):
                thetas = np.linspace(0, math.pi/2, num_theta)
                areas = np.array([good_area_exact(t) for t in thetas])
                # Simpson's rule
                n = num_theta - 1
                if n % 2 == 1:
                    # make n even
                    thetas = thetas[:-1]
                    areas = areas[:-1]
                    n -= 1
                h = (math.pi/2) / n
                S = areas[0] + areas[-1] + 4*areas[1:-1:2].sum() + 2*areas[2:-2:2].sum()
                integral = h/3 * S
                p = (2/math.pi) * integral
                return p
            
            p_val = compute_p_integral(num_theta=401)  # moderate
            p_val
            
