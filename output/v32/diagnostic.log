            def reachable_upto(k, limit):
                # compute set of integers reachable with at most k terms, using powers up to limit
                # We'll use DP: reachable[t] = set of numbers reachable with exactly t terms
                reachable = {0}
                for _ in range(k):
                    new = set(reachable)
                    # we need to consider powers up to limit (maybe limit)
                    max_exp = limit.bit_length()  # enough
                    powers = [1 << e for e in range(max_exp+1)]
                    for val in reachable:
                        for p in powers:
                            new.add(val + p)
                            new.add(val - p)
                    reachable = new
                # reachable includes numbers reachable with up to k terms (since we kept union)
                return reachable
            
            def minimal_unattainable(k):
                # compute minimal positive integer not reachable with at most k terms
                # we will compute reachable up to some bound maybe (2*4**k+1)//3
                N = (2*4**k + 1)//3
                reachable = reachable_upto(k, N)
                for n in range(1, N):
                    if n not in reachable:
                        return n
                return N
            
            for k in range(1,7):
                print(k, minimal_unattainable(k), (2*4**k + 1)//3)
            
