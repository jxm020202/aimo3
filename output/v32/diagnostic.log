            import itertools, cmath, math
            
            def find_solution(m, max_total=10):
                # candidate r values: 0, primitive roots up to order 12 maybe
                candidates = [0]
                for n in range(1,13):
                    for k in range(n):
                        candidates.append(cmath.exp(2j*math.pi*k/n))
                # remove -1 because leads to zero factor
                candidates = [c for c in candidates if not (abs(c+1) < 1e-9)]
                # search over multisets up to size max_total
                # We'll limit to at most 4 distinct nonzero candidates for tractability
                for size in range(1, max_total+1):
                    # generate combinations with replacement of candidates (order not important)
                    for multiset in itertools.combinations_with_replacement(candidates, size):
                        # compute products for each e
                        ok=True
                        for e in range(1,m+1):
                            prod=1
                            for r in multiset:
                                prod *= (r**e + 1)
                            if abs(prod-1) > 1e-6:
                                ok=False
                                break
                        if ok:
                            # ensure not all zero
                            if any(abs(r)>1e-9 for r in multiset):
                                return multiset
                return None
            
            print(find_solution(3, max_total=6))
            
