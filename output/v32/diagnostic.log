            def find_path(m, target_counts):
                n = 2**m
                adj = {v: [v ^ (1<<k) for k in range(m)] for v in range(n)}
                # Precompute diff bit for each neighbor
                diff_bit = {}
                for v in range(n):
                    for nb in adj[v]:
                        diff = v ^ nb
                        k = diff.bit_length() - 1
                        diff_bit[(v, nb)] = k
                target = target_counts.copy()
                visited = [False]*n
                path = [0]
                visited[0] = True
                # Use recursion with backtracking
                def dfs(v):
                    if len(path) == n:
                        return True
                    # order neighbors maybe by larger jumps first to prune
                    # sort by descending length (i.e., larger k) maybe
                    for nb in sorted(adj[v], key=lambda x: -diff_bit[(v,x)]):
                        if visited[nb]:
                            continue
                        k = diff_bit[(v, nb)]
                        if target[k] == 0:
                            continue
                        # use this edge
                        target[k] -= 1
                        visited[nb] = True
                        path.append(nb)
                        if dfs(nb):
                            return True
                        # backtrack
                        path.pop()
                        visited[nb] = False
                        target[k] += 1
                    return False
                if dfs(0):
                    return path
                else:
                    return None
            
            m=5
            target_counts = {k: 2**k for k in range(m)}
            path = find_path(m, target_counts)
            print("found:", path is not None)
            if path:
                print(path[:20])
                print("counts:", path_counts(path))
            
