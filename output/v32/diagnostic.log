            def count_diag_down(i,j):
                # down-right direction: lines start at (s_i, s_j) where s_i in 0..4, s_j in 0..4
                # line includes cells (s_i+k, s_j+k) for k=0..4
                # cell (i,j) is in line if there exists k such that i = s_i + k, j = s_j + k => s_i = i - k, s_j = j - k
                # Need s_i,s_j in 0..4 and k in 0..4
                count = 0
                for k in range(5):
                    si = i - k
                    sj = j - k
                    if 0 <= si <= 4 and 0 <= sj <= 4:
                        count += 1
                return count
            
            def count_diag_up(i,j):
                # up-right direction: lines start at (s_i, s_j) where s_i in 4..8, s_j in 0..4
                # line includes (s_i - k, s_j + k) for k=0..4
                count = 0
                for k in range(5):
                    si = i + k  # Actually start row s_i = i + k? Let's derive: cell (i,j) belongs to line where start (s_i, s_j) and cell = (s_i - k, s_j + k)
                    # So s_i = i + k, s_j = j - k
                    si = i + k
                    sj = j - k
                    if 4 <= si <= 8 and 0 <= sj <= 4:
                        count += 1
                return count
            
            max_lines = 0
            max_cell = None
            for i in range(9):
                for j in range(9):
                    total = count_horiz(j) + count_horiz(i)  # vertical same as horiz count for row index i
                    total += count_diag_down(i,j) + count_diag_up(i,j)
                    if total > max_lines:
                        max_lines = total
                        max_cell = (i,j,total)
            max_cell
            
