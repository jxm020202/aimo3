        >>> Code:
            V = len(coords)
            E = len(edges)
            # variable ordering: first V x's, then E y's
            # Build incidence list: for each vertex, list of edge indices incident
            incidence = [[] for _ in range(V)]
            for e_idx, (u,v) in enumerate(edges):
                incidence[u].append(e_idx)
                incidence[v].append(e_idx)
            
            # Build constraint matrices
            # We'll use dense matrices? Use scipy's milp expects c vector, A_ub, b_ub, A_eq, b_eq, bounds.
            
            # Objective: maximize sum x_v = maximize c^T var. Since milp solves minimization, we can minimize -sum x_v.
            c = np.zeros(V+E)
            c[:V] = -1  # minimize negative sum => maximize sum
            
            # Equality constraints: for each vertex v: sum_{e incident} y_e - x_v = 0
            A_eq = np.zeros((V, V+E), dtype=int)
            b_eq = np.zeros(V, dtype=int)
            for v in range(V):
                A_eq[v, v] = -1  # -x_v
                for e_idx in incidence[v]:
                    A_eq[v, V + e_idx] = 1  # + y_e
                b_eq[v] = 0
            
            # Inequality constraints: for each edge (u,v): x_u + x_v - y_uv <= 1
            A_ub = np.zeros((E, V+E), dtype=int)
            b_ub = np.ones(E, dtype=int)  # RHS 1
            for e_idx, (u,v) in enumerate(edges):
                A_ub[e_idx, u] = 1
                A_ub[e_idx, v] = 1
                A_ub[e_idx, V + e_idx] = -1  # - y_uv
            
            # Bounds: all variables binary 0-1
            lb = np.zeros(V+E)
            ub = np.ones(V+E)
            
            # Use milp
            from scipy.optimize import milp, LinearConstraint, Bounds
            lin_eq = LinearConstraint(A_eq, b_eq, b_eq)
            lin_ub = LinearConstraint(A_ub, -np.inf, b_ub)  # upper bound constraints
            bounds = Bounds(lb, ub)
            
            res = milp(c=c, constraints=[lin_eq, lin_ub], bounds=bounds, integrality=np.arange(V+E))
            print(res.success, res.message)
            
