            def improve_sequence(seq):
                n = len(seq)
                V = seq[-1]
                improved = True
                while improved:
                    improved = False
                    # iterate over positions where we can increase
                    for k in range(1, n-1):  # 0-indexed positions 1..n-2 (excluding first and last)
                        if seq[k] < seq[k+1]:
                            a_k = seq[k]
