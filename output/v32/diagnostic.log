            def rank_mod3(mat):
                # mat is list of rows (list of ints 0/1)
                rows = [row[:] for row in mat]
                m = len(rows)
                n = len(rows[0]) if rows else 0
                rank = 0
                col = 0
                while col < n and rank < m:
                    # find pivot row with non-zero in this column
                    pivot = None
                    for r in range(rank, m):
                        if rows[r][col] % 3 != 0:
                            pivot = r
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap pivot row to current rank row
                    rows[rank], rows[pivot] = rows[pivot], rows[rank]
                    # normalize pivot row to make leading entry 1 (multiply by inverse mod 3)
                    inv = {1:1, 2:2}[rows[rank][col] % 3]  # since 2*2=4≡1 mod3
                    rows[rank] = [(val*inv) % 3 for val in rows[rank]]
                    # eliminate other rows
                    for r in range(m):
                        if r != rank and rows[r][col] % 3 != 0:
                            factor = rows[r][col] % 3
                            rows[r] = [ (rows[r][c] - factor*rows[rank][c]) % 3 for c in range(n) ]
                    rank += 1
                    col += 1
                return rank
            
            mat = [[int(M[i,j]) for j in range(30)] for i in range(20)]
            print(rank_mod3(mat))
            
