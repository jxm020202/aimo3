                domains = [set([0,1,2]) for _ in range(30)]
                
                # Helper to check triangle condition when fully assigned
                def triangle_ok(tri):
                    c = [colors[e] for e in tri]
                    if -1 in c:
                        return True
                    # exactly two equal
                    s = set(c)
                    if len(s)==1 or len(s)==3:
                        return False
                    return True
                
                # forward checking after assignment
                def propagate():
                    changed = True
                    while changed:
                        changed = False
                        for tri in tri_edges:
                            assigned = [(e, colors[e]) for e in tri if colors[e]!=-1]
                            unassigned = [e for e in tri if colors[e]==-1]
                            if len(unassigned)==0:
                                if not triangle_ok(tri):
