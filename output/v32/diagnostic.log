            import itertools, collections
            
            def hypercube_adj(n):
                # returns adjacency dict: vertex int -> list of neighbor ints
                N = 1<<n
                adj = {v: [] for v in range(N)}
                for v in range(N):
                    for i in range(n):
                        adj[v].append(v ^ (1<<i))
                return adj
            
            def hamiltonian_paths_counts(n):
                adj = hypercube_adj(n)
                start = 0
                N = 1<<n
                paths_counts = set()
                # simple DFS with pruning maybe for n=2,3
                def dfs(v, visited, counts):
                    if len(visited) == N:
                        # path completed
                        paths_counts.add(tuple(counts))
                        return
                    for nb in adj[v]:
                        if nb not in visited:
                            # which bit flipped?
                            diff = v ^ nb
                            bit = (diff.bit_length() - 1)  # index
                            counts2 = counts[:]
                            counts2[bit] += 1
                            dfs(nb, visited | {nb}, counts2)
                dfs(start, {start}, [0]*n)
                return paths_counts
            
            for n in range(2,4):
                pcs = hamiltonian_paths_counts(n)
                print(n, len(pcs))
                for cnt in sorted(pcs):
                    print(cnt)
            
