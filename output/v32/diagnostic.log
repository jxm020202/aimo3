            def verify_solution(N, edges):
                coords = [(i,j) for i in range(N) for j in range(N)]
                # build adjacency within distance <=2
                V = len(coords)
                # map piece to partner
                partner = {}
                for u,v in edges:
                    if u in partner or v in partner:
                        return False, "vertex appears in multiple edges"
                    partner[u]=v
                    partner[v]=u
                # check each piece's neighbors within distance <=2
                for u in partner:
                    x1,y1 = coords[u]
                    count = 0
                    for w in range(V):
                        if w==u: continue
                        x2,y2 = coords[w]
                        if max(abs(x1-x2), abs(y1-y2)) <= 2:
                            if w in partner:
                                # if w is partner of u, count it
                                if partner[u]==w:
                                    count += 1
                                else:
                                    return False, f"piece {u} sees another piece {w} not its partner"
                    if count != 1:
                        return False, f"piece {u} sees {count} partners"
