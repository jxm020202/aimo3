            def minimal_sequence(N):
                # intervals represented as list of (l, r) with l inclusive, r exclusive
                intervals = [(0.0, 1.0)]
                bits = []
                for n in range(1, N+1):
                    # Determine intervals where a_n = 0 (floor(nx) odd) and where a_n = 1 (even)
                    # For n, floor(nx) even => a_n=1
                    # intervals for a_n=1: union over k even of [k/n, (k+1)/n)
                    # for a_n=0: union over k odd of [k/n, (k+1)/n)
                    # We'll compute intersection with current intervals.
                    # Determine if any intersection with a_n=0 is nonempty.
                    zero_intervals = []
                    one_intervals = []
                    for k in range(n):
                        l = k / n
                        r = (k+1) / n
                        if k % 2 == 0:
                            one_intervals.append((l, r))
                        else:
                            zero_intervals.append((l, r))
                    # function to intersect intervals list with a set of intervals
                    def intersect(current, other):
                        res = []
                        i = j = 0
                        # both lists sorted
                        while i < len(current) and j < len(other):
                            a,b = current[i]
                            c,d = other[j]
                            # compute overlap
                            lo = max(a,c)
                            hi = min(b,d)
                            if lo < hi - 1e-15:  # nonempty
