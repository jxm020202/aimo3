            def is_sum_two_powers_of_three(c):
                # find distinct a,b >=0 such that 3**a + 3**b == c
                powers = []
                i=0
                while 3**i <= c:
                    powers.append(3**i)
                    i+=1
                s=set(powers)
                for a in powers:
                    b = c - a
                    if b in s and b!=a:
                        return True, a, b
                return False, None, None
            
