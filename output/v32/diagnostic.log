            def generate_numbers(limit, primes):
                # generate numbers whose prime factors are subset of primes (including 3)
                # We'll generate by BFS multiplication
                nums = {1}
                for p in primes:
                    new_nums = set()
                    for n in nums:
                        k = n
                        while k * p <= limit:
                            k *= p
                            new_nums.add(k)
                    nums.update(new_nums)
                # Actually this may miss combinations of multiple primes; better generate all numbers up to limit with given primes
                # Use recursion
                nums = set([1])
                def rec(current, idx):
                    if idx == len(primes):
                        nums.add(current)
                        return
                    p = primes[idx]
                    val = current
                    while val <= limit:
                        rec(val, idx+1)
                        val *= p
                rec(1, 0)
                return sorted([x for x in nums if x <= limit])
            
            def can_sum_two_numbers(limit, primes):
                S = generate_numbers(limit, primes)
                Sset = set(S)
                for a in S:
                    b = limit - a
                    if b != a and b in Sset:
                        return True, (a,b)
                return False, None
            
