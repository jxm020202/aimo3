                    if sympy.isprime(n):
                        continue
                    # quick check: if n <= 101, need condition for all k in 0..n-1 (since residues repeat)
                    # we can brute force random permutations maybe
                    perm = find_perm_bruteforce(n, limit=200000)
                    if perm is not None:
                        good.append((n, perm))
                return good
            
