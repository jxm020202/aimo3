            def max_pieces_15():
                N=15
                coords = [(i,j) for i in range(N) for j in range(N)]
                index = {c:k for k,c in enumerate(coords)}
                num_vertices = N*N
                # enumerate edges (i<j) with Chebyshev distance <=2
                edges = []
                for i in range(num_vertices):
                    x1,y1 = coords[i]
                    for j in range(i+1, num_vertices):
                        x2,y2 = coords[j]
                        if max(abs(x1-x2), abs(y1-y2)) <= 2:
                            edges.append((i,j))
                num_edges = len(edges)
                print("num_edges:", num_edges)
                # incident edges per vertex
                incident = [[] for _ in range(num_vertices)]
                for e_idx, (i,j) in enumerate(edges):
                    incident[i].append(e_idx)
                    incident[j].append(e_idx)
                # conflict pairs: edges that cannot both be selected
                # conflict if any endpoint of e1 is within distance <=2 of any endpoint of e2, and edges are distinct and not sharing a vertex? Actually if they share a vertex, they already conflict via incident constraint (since vertex can be in at most one edge). So we can ignore sharing vertices (they already conflict). But we still need to add conflict for distance <=2 across different vertices.
                # We'll generate conflict pairs where edges are distinct and have no common vertices, and distance between any endpoint of e1 and any endpoint of e2 <=2.
                conflict_pairs = []
                # To speed up, we can for each edge, compute its "forbidden vertices": all vertices within distance <=2 of its endpoints (including endpoints). Then any other edge whose any endpoint lies in that set (and not sharing endpoint) is conflicting.
                # Precompute neighbor sets for each vertex
                neighbor_set = []
                for v in range(num_vertices):
                    x,y = coords[v]
                    neigh = set()
                    for di in range(-2,3):
                        for dj in range(-2,3):
                            if di==0 and dj==0: continue
                            nx, ny = x+di, y+dj
                            if 0 <= nx < N and 0 <= ny < N:
                                neigh.add(index[(nx,ny)])
                    neighbor_set.append(neigh)
                # For each edge, compute forbidden vertices = endpoints + their neighbors
                forbidden = []
                for (i,j) in edges:
                    forb = set([i,j]) | neighbor_set[i] | neighbor_set[j]
                    forbidden.append(forb)
                # Build conflict pairs
                for e1 in range(num_edges):
                    i1,j1 = edges[e1]
                    forb = forbidden[e1]
                    # iterate over edges with index > e1
                    for e2 in range(e1+1, num_edges):
                        i2,j2 = edges[e2]
                        # if they share a vertex, already conflict via incident constraint; we can skip adding extra constraint
                        if i1==i2 or i1==j2 or j1==i2 or j1==j2:
                            continue
                        # if any endpoint of e2 is in forb, then conflict
                        if i2 in forb or j2 in forb:
                            conflict_pairs.append((e1,e2))
                print("conflict_pairs:", len(conflict_pairs))
                # Build MILP
                # Variables: e_k binary
                # Constraints:
                # 1) For each vertex v: sum_{e incident to v} e <= 1
                # 2) For each conflict pair (e1,e2): e1 + e2 <= 1
                # Objective: maximize sum e_k
                # Build matrix rows
                rows = []
                lbs = []
                ubs = []
                # vertex constraints
                for v in range(num_vertices):
                    row = np.zeros(num_edges, dtype=int)
                    for e_idx in incident[v]:
                        row[e_idx] = 1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(1)
                # conflict constraints
                for (e1,e2) in conflict_pairs:
                    row = np.zeros(num_edges, dtype=int)
                    row[e1] = 1
                    row[e2] = 1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(1)
                A = np.vstack(rows)
                lc = LinearConstraint(A, lbs, ubs)
                c = -np.ones(num_edges)  # maximize sum e
                bounds = Bounds(0,1)
                integrality = np.ones(num_edges, dtype=int)
                # solve with time limit maybe 30 seconds
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality,
                           options={'disp': False, 'presolve': True, 'time_limit': 30})
                return res, edges
            
            res, edges = max_pieces_15()
            print(res.success, res.message)
            
