                                    x4,y4 = pts[l]
                                    if x4!=x3: continue
                                    if abs(y1 - y3) == abs(y2 - y4) or abs(y1 - y4) == abs(y2 - y3):
                                        return False
                return True
            
            for N in [5,7,11]:
