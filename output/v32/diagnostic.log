            indices = [11,23,35,47,59]  # 0-indexed
            c[indices] = -1  # minimize negative sum => maximize sum
            
            # constraints: A_ub x <= b_ub
            A = []
            b = []
            
            for i in range(n):
                j = (i+1)%n
                row = np.zeros(n)
                row[i] = 1
                row[j] = -1
                A.append(row)
                b.append(1)  # x_i - x_j <= 1
                # opposite
                row2 = np.zeros(n)
                row2[i] = -1
                row2[j] = 1
                A.append(row2)
                b.append(1)  # x_j - x_i <= 1
            
            A = np.array(A)
            b = np.array(b)
            
            # Equality sum zero
            A_eq = np.ones((1,n))
            b_eq = np.array([0.0])
            
            res = linprog(c, A_ub=A, b_ub=b, A_eq=A_eq, b_eq=b_eq, method='highs')
            res.success, res.fun, res.x[:10]
