            def count_independent_sets_diagonal(n):
                # generate row masks with no adjacent horizontally (since diagonal also restricts across rows)
                masks = []
                for mask in range(1<<n):
                    if mask & (mask<<1):
                        continue
                    masks.append(mask)
                # compatibility: no vertical adjacency and no diagonal adjacency
                compat = {mask: [] for mask in masks}
                for cur in masks:
                    for prev in masks:
                        if cur & prev:  # vertical adjacency
                            continue
                        # diagonal: if cur has bit j and prev has bit j-1 or j+1
                        if (cur << 1) & prev:  # cur bit j-1 with prev bit j
                            continue
                        if (cur >> 1) & prev:  # cur bit j+1 with prev bit j
                            continue
                        compat[cur].append(prev)
                dp = {mask: 1 for mask in masks}
                for _ in range(1, n):
                    newdp = {mask: 0 for mask in masks}
                    for cur in masks:
                        total = sum(dp[prev] for prev in compat[cur])
                        newdp[cur] = total
                    dp = newdp
                return sum(dp.values())
            
            for n in range(1,6):
                print(n, count_independent_sets_diagonal(n))
            
