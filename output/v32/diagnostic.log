            def min_T_hypercube_path(n, time_limit=30):
                N = 2**n
                # edges
                edges = []
                for i in range(N):
                    for k in range(n):
                        j = i ^ (1<<k)
                        if i < j:
                            edges.append((i,j,k))
                dir_edges = []
                for (i,j,k) in edges:
                    dir_edges.append((i,j,k))
                    dir_edges.append((j,i,k))
                m = len(dir_edges)
                total_vars = m + N + (N-1)
                # objective
                c = np.zeros(total_vars)
                for idx, (i,j,k) in enumerate(dir_edges):
                    c[idx] = 1.0 / (2**k)
                # integrality: all integer
                integrality = np.ones(total_vars, dtype=int)
                # bounds
                from scipy.optimize import Bounds
                # x variables binary 0-1
                bounds = [(0,1)] * m + [(0, N-1)] * N + [(0,1)] * (N-1)
                # constraints list
                cons = []
                from scipy.optimize import LinearConstraint
                # edge usage at most once
                edge_to_dir = {}
                for idx, (i,j,k) in enumerate(dir_edges):
                    key = (min(i,j), max(i,j))
                    edge_to_dir.setdefault(key, []).append(idx)
                for (i,j), idxs in edge_to_dir.items():
                    A = np.zeros(total_vars)
                    for idx in idxs:
                        A[idx] = 1
                    cons.append(LinearConstraint(A, -np.inf, 1))
                # degree constraints
                for i in range(N):
                    # outgoing
                    A_out = np.zeros(total_vars)
                    for idx, (src,dst,k) in enumerate(dir_edges):
                        if src == i:
                            A_out[idx] = 1
                    # incoming
                    A_in = np.zeros(total_vars)
                    for idx, (src,dst,k) in enumerate(dir_edges):
                        if dst == i:
                            A_in[idx] = 1
                    if i == 0:
                        # out_0 = 1
                        cons.append(LinearConstraint(A_out, 1, 1))
                        # in_0 = 0
                        cons.append(LinearConstraint(A_in, 0, 0))
                    else:
                        e_idx = m + N + (i-1)
                        # out_i + e_i = 1
                        A = A_out.copy()
                        A[e_idx] = 1
                        cons.append(LinearConstraint(A, 1, 1))
                        # in_i = 1
                        cons.append(LinearConstraint(A_in, 1, 1))
                # exactly one end
                A_end = np.zeros(total_vars)
                for i in range(1,N):
                    e_idx = m + N + (i-1)
                    A_end[e_idx] = 1
                cons.append(LinearConstraint(A_end, 1, 1))
                # subtour elimination (MTZ)
                for idx, (i,j,k) in enumerate(dir_edges):
                    if i == 0:
                        continue
                    A = np.zeros(total_vars)
                    u_i_idx = m + i
                    u_j_idx = m + j
                    A[u_i_idx] = 1
                    A[u_j_idx] = -1
                    A[idx] = N
                    cons.append(LinearConstraint(A, -np.inf, N-1))
                # fix u_0 = 0
                bounds[m + 0] = (0,0)
                # lower bound for other u_i >= 1
                for i in range(1,N):
                    bounds[m + i] = (1, N-1)
                # solve
                res = opt.milp(c=c, bounds=Bounds(*zip(*bounds)), constraints=cons,
                               integrality=integrality, options={"presolve": True, "disp": False, "time_limit": time_limit})
                return res
            
            print("n=2")
            res2 = min_T_hypercube_path(2, time_limit=10)
            print(res2.success, res2.fun)
            
