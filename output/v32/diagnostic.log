            def max_induced_matching(board_size=15, time_limit=30):
                n = board_size
                # Build list of edges (i,j) where i<j and Chebyshev distance <=2
                edges = []
                for i in range(n):
                    for j in range(n):
                        node = i*n + j
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                if di==0 and dj==0: continue
                                ii, jj = i+di, j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    neighbor = ii*n + jj
                                    if node < neighbor:
                                        edges.append((node, neighbor))
                # Precompute conflict sets for each edge: edges that cannot coexist
                # Conflict if they share a vertex or any endpoint within distance <=2 of any endpoint of other edge
                # We'll compute adjacency matrix for vertices within distance <=2 (including self)
                # Actually we need to know for each vertex, its "range" set (including itself)
                vertex_range = {}
                for i in range(n):
                    for j in range(n):
                        v = i*n + j
                        rng = set()
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                ii, jj = i+di, j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    rng.add(ii*n + jj)
                        vertex_range[v] = rng
                # Build conflict dictionary
                edge_conflict = []
                # We'll create list of sets of conflicting edge indices
                edge_count = len(edges)
                # Build mapping from edge to index
                edge_index = {e:i for i,e in enumerate(edges)}
                # Precompute for each edge the set of vertices in its two ranges (union)
                edge_range_vertices = []
                for (u,v) in edges:
                    rng = vertex_range[u] | vertex_range[v]
                    edge_range_vertices.append(rng)
                # Now compute conflicts
                conflict_sets = [set() for _ in range(edge_count)]
                for i in range(edge_count):
                    u1,v1 = edges[i]
                    rng1 = edge_range_vertices[i]
                    for j in range(i+1, edge_count):
                        u2,v2 = edges[j]
                        # conflict if edges share a vertex
                        if u1==u2 or u1==v2 or v1==u2 or v1==v2:
                            conflict = True
                        else:
                            # conflict if any endpoint of edge2 is within range of edge1 (i.e., distance <=2)
                            # Equivalent to: u2 in rng1 or v2 in rng1
                            if u2 in rng1 or v2 in rng1:
                                conflict = True
                            else:
                                # Also need to check if any endpoint of edge1 is within range of edge2 (symmetric)
                                # But since distance metric symmetric, if u2 not in rng1 and v2 not in rng1, then
                                # also u1 not in rng2 and v1 not in rng2? Not necessarily, but we can compute.
                                # Simpler: compute rng2 and check intersection with {u1,v1}
                                rng2 = edge_range_vertices[j]
                                if u1 in rng2 or v1 in rng2:
                                    conflict = True
                                else:
                                    conflict = False
                        if conflict:
                            conflict_sets[i].add(j)
                            conflict_sets[j].add(i)
                # Now we have conflict graph.
                best = {'size':0, 'solution':[]}
                # Order edges maybe by degree (few conflicts first)
                order = sorted(range(edge_count), key=lambda i: len(conflict_sets[i]))
                # Use recursion with branch and bound
                start_time = time.time()
                # Use bitset representation for remaining edges for speed? We'll use Python sets.
                def recurse(available_set, current_solution):
                    # time check
                    if time.time() - start_time > time_limit:
                        raise TimeoutError
                    # bound: current size + len(available_set) <= best? Actually each edge adds 1, but we cannot select all remaining due to conflicts.
                    # Simple bound: current size + len(available_set) <= best['size'] => prune
                    if len(current_solution) + len(available_set) <= best['size']:
                        return
                    if not available_set:
                        if len(current_solution) > best['size']:
                            best['size'] = len(current_solution)
                            best['solution'] = current_solution.copy()
                        return
                    # Choose edge with smallest conflict degree among available
                    # heuristic: pick edge with minimal conflicts to branch
                    # Let's pick first edge in available_set (maybe using order)
                    # We'll sort available_set by degree
                    edge = min(available_set, key=lambda e: len(conflict_sets[e] & available_set))
                    # Branch 1: include edge
                    new_solution = current_solution + [edge]
                    # Remove edge and its conflicts from available
                    new_available = available_set - {edge} - (conflict_sets[edge] & available_set)
                    recurse(new_available, new_solution)
                    # Branch 2: exclude edge
                    available_without = available_set - {edge}
                    recurse(available_without, current_solution)
                try:
                    recurse(set(range(edge_count)), [])
                except TimeoutError:
                    print("Timeout")
                # Convert edge indices to actual pairs
                best_edges = [edges[i] for i in best['solution']]
                return best['size'], best_edges
            
            size, edges = max_induced_matching(time_limit=20)
            size
            
