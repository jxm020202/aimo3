            import itertools
            
            def count_independent_sets(n):
                # generate all row masks of length n with no adjacent 1s
                masks = []
                for mask in range(1<<n):
                    if mask & (mask<<1) == 0:  # no adjacent 1s horizontally
                        masks.append(mask)
                # compatibility: two masks compatible if no vertical adjacency (no overlapping 1s)
                comp = {}
                for a in masks:
                    comp[a] = [b for b in masks if (a & b) == 0]
                # DP: count number of ways for each row
                # dp[row][mask] = number of ways up to this row ending with mask
                dp = {mask:1 for mask in masks}  # first row any mask
                for _ in range(1, n):  # remaining rows
                    newdp = {mask:0 for mask in masks}
                    for cur in masks:
                        total = 0
                        for prev in comp[cur]:
                            total += dp[prev]
                        newdp[cur] = total
                    dp = newdp
                total = sum(dp.values())
                return total
            
            for n in range(2,6):
                print(n, count_independent_sets(n))
            
