            def greedy_max_B(N):
                # intervals as list of (Fraction left, Fraction right) half-open [l, r)
                intervals = [(Fraction(0), Fraction(1))]
                bits = []
                for n in range(1, N+1):
                    # build odd intervals for n
                    odd_intervals = []
                    k = 0
                    while True:
                        left = Fraction(2*k+1, n)
                        right = Fraction(2*k+2, n)
                        if left >= 1:
                            break
                        if right > 1:
                            right = Fraction(1)
                        odd_intervals.append((left, right))
                        k += 1
                    # even intervals
                    even_intervals = []
                    k = 0
                    while True:
                        left = Fraction(2*k, n)
                        right = Fraction(2*k+1, n)
                        if left >= 1:
                            break
                        if right > 1:
                            right = Fraction(1)
                        even_intervals.append((left, right))
                        k += 1
                    
                    # intersect intervals with odd_intervals
                    def intersect(set1, set2):
                        res = []
                        i=j=0
                        while i < len(set1) and j < len(set2):
                            a1,b1 = set1[i]
                            a2,b2 = set2[j]
                            lo = max(a1,a2)
                            hi = min(b1,b2)
                            if lo < hi:  # nonempty
                                res.append((lo,hi))
                            if b1 <= b2:
                                i+=1
                            else:
                                j+=1
                        return res
                    
                    odd_int = intersect(intervals, odd_intervals)
                    if odd_int:  # feasible to set bit 1
                        bits.append(1)
                        intervals = odd_int
                    else:
                        bits.append(0)
                        intervals = intersect(intervals, even_intervals)
                        # should be nonempty always because at least one parity works
                # compute B value from bits
                B = sum(Fraction(bit, 2**n) for n,bit in enumerate(bits, start=1))
                return B, bits, intervals
            
