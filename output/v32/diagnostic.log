            def f_rational(p,q):
                # compute exact infinite sum using period detection as earlier
                from fractions import Fraction
                # Determine parity sequence for n=1..period
                I = []
                for n in range(1, q*2+1):
                    I.append(((n*p)//q) % 2 == 0)  # True if even
                # Find minimal period
                period = None
                for per in range(1, len(I)//2+1):
                    if I[:per] == I[per:2*per]:
                        period = per
                        break
                if period is None:
                    period = len(I)
                # compute sum
                total = Fraction(0,1)
                for i in range(period):
                    if I[i]:
                        total += Fraction(1, 2**(i+1))
