                        # conflict if share vertex
                        if u_i in (u_j, v_j) or v_i in (u_j, v_j):
                            conflict_pairs += 1
                            continue
                        # conflict if any endpoint of j in rng_i
                        if u_j in rng_i or v_j in rng_i:
                            conflict_pairs += 1
                            continue
                        # also need check if any endpoint of i in rng_j (symmetric)
                        rng_j = edge_range[j]
                        if u_i in rng_j or v_i in rng_j:
                            conflict_pairs += 1
                            continue
                return edge_count, conflict_pairs
            
