                        if len(cset)==1 or len(cset)==3:
                            return 0
                    return 1
                # choose unassigned edge with smallest domain >1
                # find edge with minimal domain size >1
                unassigned = [e for e in range(edges_count) if colors[e]==-1]
                e = min(unassigned, key=lambda x: len(domains[x]))
                total = 0
                for col in list(domains[e]):  # iterate over possible colors
                    new_domains = deepcopy(domains)
                    new_colors = colors[:]  # copy list
                    # assign e to col
                    new_domains[e] = {col}
                    new_colors[e] = -1  # not yet assigned; propagate will assign
                    total += count_solutions(new_domains, new_colors)
                return total
            
