                # search for p even, gcd(p,q)=1, such that N matches target_N
                for p in range(0, q):
                    if p%2!=0:
                        continue
                    if math.gcd(p,q)!=1:
                        continue
                    # compute N
                    N=0
                    for i in range(1,q+1):
                        floor_val = (p*i)//q
                        if floor_val%2==0:
                            N += 1 << (q-i)
                    if N==target_N:
                        return p
                return None
            
