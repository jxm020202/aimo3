            def max_matching_size(n):
                left_vals = list(range(-(n-1), n))
                right_vals = list(range(0, 2*n-1))
                G = nx.Graph()
                for i in range(n):
                    for j in range(n):
                        l = i-j
                        r = i+j
                        G.add_edge(('L',l), ('R',r))
                # compute maximum matching
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=[('L',l) for l in left_vals])
                # matching is dict mapping each vertex to its partner
                # size is number of edges = len(matching)//2
                return len(matching)//2
            
            for n in range(2,14):
                print(n, max_matching_size(n))
            
