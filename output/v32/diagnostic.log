            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def optimal_average_ilp(n):
                # edges indexing
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variable: integer 0..2 representing offset from 1? Let's use integer variable with bounds 1..3
                # We'll set variable as integer with lower bound 1, upper bound 3.
                c = np.ones(m, dtype=int)  # objective minimize sum
                # constraints: for each triangle, sum >=5
                triangles = []
                for a in range(n):
                    for b in range(a+1,n):
                        for c_ in range(b+1,n):
                            triangles.append((a,b,c_))
                A = []
                lb = []
                ub = []
                edge_index = {e:i for i,e in enumerate(edges)}
                for (a,b,c_) in triangles:
                    row = np.zeros(m, dtype=int)
                    row[edge_index[(a,b)]] = 1
                    row[edge_index[(a,c_)]] = 1
                    row[edge_index[(b,c_)]] = 1
                    A.append(row)
                    lb.append(5)
                    ub.append(np.inf)
                A = np.array(A)
                lin_con = LinearConstraint(A, lb, ub)
                bounds = Bounds(1, 3)
                # integrality: all variables integer
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=np.ones(m, dtype=bool), options={'disp': False})
