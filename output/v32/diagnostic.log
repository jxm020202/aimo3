            # Build edge list
            edges = [(i,j) for i in range(N) for j in adj[i] if i<j]  # same as before
            M = len(edges)
            print("M", M)
            # For each vertex, compute list of edge indices where edge touches vertex or neighbor within distance <=2
            vertex_edge_indices = [[] for _ in range(N)]
            # Build mapping from vertex to edges incident directly
            incident_edges = [[] for _ in range(N)]
            for idx, (i,j) in enumerate(edges):
                incident_edges[i].append(idx)
                incident_edges[j].append(idx)
            
            # For each vertex v, collect edges incident to any u in neighbor_mask[v]
            for v in range(N):
                # get vertices within distance <=2 (including v)
                # we can iterate over all vertices u where neighbor_mask[v] has bit set
                mask = neighbor_mask[v]
                # iterate bits
                u = 0
                while mask:
                    # get lowest set bit
                    lsb = mask & -mask
                    u = (lsb.bit_length() - 1)
                    # add incident edges of u
                    vertex_edge_indices[v].extend(incident_edges[u])
                    mask &= mask - 1
                # deduplicate
                vertex_edge_indices[v] = list(set(vertex_edge_indices[v]))
                
            # Build constraint matrix A (N x M)
