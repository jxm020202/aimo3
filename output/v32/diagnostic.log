                for d in range(-8,9):
                    # cells where r-c = d
                    cells = [(r,c) for r in range(9) for c in range(9) if r-c == d]
                    L = len(cells)
                    if L >=5:
                        # sort by r (or c)
                        cells.sort()
                        for i in range(L-5+1):
