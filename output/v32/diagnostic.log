            def D_formula(n):
                # compute product D_small[d_i] * 2^{v5(n!)} mod 10
                D_small = [1,1,2,6,4]
                # compute base-5 digits
                prod = 1
                temp = n
                while temp > 0:
                    d = temp % 5
                    prod = (prod * D_small[d]) % 10
                    temp //= 5
                # compute v5(n!)
                v5 = 0
                t = n
                while t:
                    t //= 5
                    v5 += t
                prod = (prod * pow(2, v5, 10)) % 10
                return prod
            
