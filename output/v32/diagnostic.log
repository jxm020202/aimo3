            import math
            
            def intersect_intervals(intervals, n, want_odd):
                """Given list of intervals (low, high) (low inclusive, high exclusive), 
                intersect with set of x where floor(n*x) odd/even.
                want_odd: True for odd floor (a_n=0), False for even floor (a_n=1)
                Returns new list of intervals.
                """
                new_intervals = []
                # For each k such that parity matches, interval [k/n, (k+1)/n)
                # We can iterate k from 0 to n-1 (since x<1 => n*x < n)
                # Actually k can go up to n-1 inclusive because floor(n*x) max n-1 when x<1.
                for k in range(n):
                    if (k % 2 == 1) == want_odd:  # want odd floor if want_odd True
                        low = k / n
                        high = (k + 1) / n
                        # intersect each current interval with [low,high)
                        for (a,b) in intervals:
                            lo = max(a, low)
                            hi = min(b, high)
                            if lo < hi - 1e-15:  # nonempty
                                new_intervals.append((lo, hi))
                # Merge overlapping intervals (should be disjoint already)
                new_intervals.sort()
                merged = []
                for lo,hi in new_intervals:
                    if not merged or lo > merged[-1][1]:
                        merged.append([lo,hi])
                    else:
                        merged[-1][1] = max(merged[-1][1], hi)
                return [(lo,hi) for lo,hi in merged]
            
            def minimal_sequence(num_bits):
                intervals = [(0.0,1.0)]
                bits = []
                for n in range(1, num_bits+1):
                    # try to set a_n =0 (odd floor)
                    cand = intersect_intervals(intervals, n, want_odd=True)
                    if cand:
                        bits.append(0)
                        intervals = cand
                    else:
                        # must set a_n =1 (even floor)
                        cand = intersect_intervals(intervals, n, want_odd=False)
                        bits.append(1)
                        intervals = cand
                    # debug
                    # print(n, bits[-1], intervals)
                return bits, intervals
            
            bits, intervals = minimal_sequence(30)
            bits, intervals[:5]
            
