            def max_edges_n(n):
                max_edges = -1
                best_graphs = []
                vertices = list(range(n))
                # edges list
                edge_list = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edge_list)
                for mask in range(1<<m):
                    # compute adjacency
                    adj = [[False]*n for _ in range(n)]
                    ecount = 0
                    for idx, (i,j) in enumerate(edge_list):
                        if mask>>idx & 1:
                            adj[i][j] = adj[j][i] = True
                            ecount += 1
                    # check condition
                    ok = True
                    for u in range(n):
                        found = False
                        for v in range(n):
                            if adj[u][v]:
                                # check no common neighbor
                                common = False
                                for w in range(n):
                                    if w!=u and w!=v and adj[u][w] and adj[v][w]:
                                        common = True
                                        break
                                if not common:
                                    found = True
                                    break
                        if not found:
                            ok = False
                            break
                    if ok:
                        if ecount > max_edges:
                            max_edges = ecount
                            best_graphs = [mask]
                        elif ecount == max_edges:
                            best_graphs.append(mask)
                return max_edges, len(best_graphs)
            
            for n in range(2,9,2):
                maxe, cnt = max_edges_n(n)
                print(n, maxe, cnt)
            
