            import sympy as sp
            
            def max_E_for_pattern(p,q,r):
                # variables a,b
                a,b = sp.symbols('a b', real=True)
                # m expressed from sum constraint
                m = (1 - p*a - r*b) / q
                # A = r*(b - m) + p*(m - a)
                A = r*(b - m) + p*(m - a)
                # S2 = p*a**2 + q*m**2 + r*b**2
                S2 = p*a**2 + q*m**2 + r*b**2
                # expression
                E = A**2 * (9*S2 - 1) / S2**3
                # simplify
                E_s = sp.simplify(E)
                # compute partial derivatives
                dEa = sp.diff(E_s, a)
                dEb = sp.diff(E_s, b)
                # solve for stationary points (critical points)
                crit = sp.solve([sp.simplify(sp.factor(dEa)), sp.simplify(sp.factor(dEb))], (a,b), dict=True)
                # filter real solutions
                real_sols = []
                for sol in crit:
                    av = sp.nsimplify(sol[a])
                    bv = sp.nsimplify(sol[b])
                    # compute m
                    mv = m.subs({a:av, b:bv})
                    # check ordering a <= m <= b
                    if av <= mv + 1e-12 and mv <= bv + 1e-12:
                        # compute E value
                        Ev = sp.N(E_s.subs({a:av, b:bv}))
                        real_sols.append((float(Ev), av, mv, bv))
                return real_sols
            
            patterns = []
            for p in range(0,5):
                for r in range(0,5):
                    q = 9 - p - r
                    if q >= 1 and p <=4 and r <=4 and p+q >=5 and p+r+q==9:
                        patterns.append((p,q,r))
            patterns
            
