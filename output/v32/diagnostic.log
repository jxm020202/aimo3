            def bucket_elimination_count():
                MOD = 1000
                # initial factors: list of (vars, dict assignment->count)
                factors = []
                for tri in tri_edge_idxs:
                    vars_tri = tuple(sorted(tri))
                    # allowed assignments: exactly two same, one different
                    allowed = {}
                    for colors in itertools.product(range(3), repeat=3):
                        # check condition
                        if len(set(colors))==1:  # all same
                            continue
                        if len(set(colors))==3:  # all distinct
                            continue
                        # allowed
                        allowed[colors] = 1
                    factors.append((vars_tri, allowed))
                # elimination order
                order = min_fill_order(var_adj)
                # Use list of factors; we will maintain as list
                total = 1
                for v in order:
                    # collect factors containing v
                    involved = [i for i,(vars_f,_) in enumerate(factors) if v in vars_f]
                    if not involved:
                        continue
                    # extract them
                    involved_factors = [factors[i] for i in involved]
                    # remove from factors (by building new list)
                    factors = [f for i,f in enumerate(factors) if i not in involved]
                    # join all involved factors
                    # start with first factor
                    vars_joint, table_joint = involved_factors[0]
                    # ensure vars_joint is tuple
                    for vars_f, table_f in involved_factors[1:]:
                        # join vars_joint and vars_f
                        # new vars = union
                        new_vars = tuple(sorted(set(vars_joint) | set(vars_f)))
                        # mapping from var to position in each factor
                        pos_joint = {var:i for i,var in enumerate(vars_joint)}
                        pos_f = {var:i for i,var in enumerate(vars_f)}
                        # build new table
                        new_table = {}
                        # iterate over assignments in joint and factor f that are compatible
                        for assign_joint, cnt_joint in table_joint.items():
                            # build dict of var->color for joint assignment
                            assign_dict = {var: assign_joint[pos_joint[var]] for var in vars_joint}
                            for assign_f, cnt_f in table_f.items():
                                # check compatibility on overlapping vars
                                compatible = True
                                for var in set(vars_joint) & set(vars_f):
                                    if assign_dict[var] != assign_f[pos_f[var]]:
                                        compatible = False
                                        break
                                if not compatible:
                                    continue
                                # combine assignments
                                # build new assignment tuple for new_vars
                                new_assign = []
                                for var in new_vars:
                                    if var in pos_joint:
                                        new_assign.append(assign_joint[pos_joint[var]])
                                    else:
                                        new_assign.append(assign_f[pos_f[var]])
                                new_assign = tuple(new_assign)
                                new_table[new_assign] = (new_table.get(new_assign, 0) + cnt_joint * cnt_f) % MOD
                        vars_joint, table_joint = new_vars, new_table
                    # now marginalize over v
                    # find position of v in vars_joint
                    pos_v = vars_joint.index(v)
                    # new vars = vars_joint without v
                    new_vars = vars_joint[:pos_v] + vars_joint[pos_v+1:]
                    new_table = {}
                    for assign, cnt in table_joint.items():
                        # drop v
                        new_assign = assign[:pos_v] + assign[pos_v+1:]
                        new_table[new_assign] = (new_table.get(new_assign, 0) + cnt) % MOD
                    if new_vars:
                        factors.append((new_vars, new_table))
                    else:
                        # scalar factor
                        total = (total * sum(new_table.values())) % MOD
                # after all variables eliminated, multiply remaining scalar factors
                for vars_f, table_f in factors:
                    if not vars_f:
                        total = (total * sum(table_f.values())) % MOD
                    else:
                        # should not happen
                        pass
                return total
            
            print(bucket_elimination_count())
            
