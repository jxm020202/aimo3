            import itertools
            
            def max_e_minus_p(n):
                vertices = list(range(n))
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                max_val = -1
                best = None
                for mask in range(1<<m):
                    # Build adjacency list
                    adj = [set() for _ in range(n)]
                    e = 0
                    # early prune: if triangle appears, break
                    # We'll compute edges list
                    for idx, (i,j) in enumerate(edges):
                        if mask>>idx & 1:
                            # add edge
                            adj[i].add(j)
                            adj[j].add(i)
                            e += 1
                    # Check triangle-free
                    triangle = False
                    for i in range(n):
                        for j in adj[i]:
                            if j>i:
                                # check common neighbor k>j
                                common = adj[i].intersection(adj[j])
                                if common:
                                    triangle = True
                                    break
                        if triangle:
                            break
                    if triangle:
                        continue
                    # compute p: pairs with common neighbor
                    p_set = set()
                    for v in range(n):
                        neigh = list(adj[v])
                        for a in range(len(neigh)):
                            for b in range(a+1, len(neigh)):
                                u = neigh[a]; w = neigh[b]
                                pair = (u,w) if u<w else (w,u)
                                p_set.add(pair)
                    p = len(p_set)
                    val = e - p
                    if val > max_val:
                        max_val = val
                        best = (e,p)
                return max_val, best
            
            for n in range(3,9):
                max_val,best = max_e_minus_p(n)
                print(n, max_val, best)
            
