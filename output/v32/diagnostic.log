            def square_vertices_center(cx, cy, theta):
                # side 1, centered at (cx,cy)
                # vertices before rotation: (±0.5, ±0.5)
                verts = [(-0.5, -0.5), (0.5, -0.5), (0.5, 0.5), (-0.5, 0.5)]
                c, s = math.cos(theta), math.sin(theta)
                rot = lambda x,y: (c*x - s*y, s*x + c*y)
                return [(cx + rot(x,y)[0], cy + rot(x,y)[1]) for x,y in verts]
            
            def point_in_polygon(px, py, poly):
                # winding number or ray casting
                inside = False
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    # check if point on edge?
                    # For simplicity, treat boundary as inside
                    # Check if point lies exactly on edge line segment
                    # Compute cross product and bounding box
                    # We'll use tolerance
                    if abs((px - x1)*(y2 - y1) - (py - y1)*(x2 - x1)) < 1e-9:
                        if min(x1,x2)-1e-9 <= px <= max(x1,x2)+1e-9 and min(y1,y2)-1e-9 <= py <= max(y1,y2)+1e-9:
                            return True
                    # ray casting
                    if ((y1 > py) != (y2 > py)):
                        x_intersect = (x2 - x1)*(py - y1)/(y2 - y1) + x1
                        if x_intersect > px:
                            inside = not inside
                return inside
            
            def square_covers_any_lattice(cx, cy, theta):
                poly = square_vertices_center(cx, cy, theta)
                # check integer points near center
                # consider i in floor(cx)-1 .. floor(cx)+1
                ix0 = math.floor(cx)
                iy0 = math.floor(cy)
                for i in range(ix0-1, ix0+3):
                    for j in range(iy0-1, iy0+3):
                        if point_in_polygon(i, j, poly):
                            return True
                return False
            
            def estimate_p(N=200000):
                count_good = 0
                for _ in range(N):
                    theta = random.random() * (math.pi/2)  # uniform orientation
                    cx = random.random()  # uniform in [0,1)
                    cy = random.random()
                    if not square_covers_any_lattice(cx, cy, theta):
                        count_good += 1
                return count_good / N
            
            for N in [20000, 50000, 100000]:
