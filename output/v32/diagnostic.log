            def max_f_ilp(n):
                # variables: x_{i,j} for i<j (edge in G1)
                # y_{i,j} for i<j (pair has common neighbor)
                # total variables = 2 * C(n,2)
                m = n*(n-1)//2
                # mapping from pair to index
                pair_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1,n):
                        pair_index[(i,j)] = idx
                        idx += 1
                total_vars = 2*m
                # objective: maximize sum x - sum y
                c = np.zeros(total_vars)
                for (i,j), ind in pair_index.items():
                    c[ind] = -1  # we will minimize c^T var, so set -1 to maximize sum x
                    c[m+ind] = 1   # minimize sum y (since we are minimizing)
                # constraints:
                # 1) triangle-free: for each triple i<j<k: x_{ij}+x_{ik}+x_{jk} <= 2
                A = []
                b = []
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            row = np.zeros(total_vars)
                            row[pair_index[(i,j)]] = 1
                            row[pair_index[(i,k)]] = 1
                            row[pair_index[(j,k)]] = 1
                            A.append(row)
                            b.append(2)
                # 2) y_{ij} >= x_{ik} + x_{jk} - 1 for all k != i,j
                for i in range(n):
                    for j in range(i+1,n):
                        y_idx = m + pair_index[(i,j)]
                        for k in range(n):
                            if k==i or k==j: continue
                            # constraint: y - x_{ik} - x_{jk} >= -1
                            row = np.zeros(total_vars)
                            row[y_idx] = 1
                            # ensure i<k ordering
                            if i<k:
                                row[pair_index[(i,k)]] = -1
                            else:
                                row[pair_index[(k,i)]] = -1
                            if j<k:
                                row[pair_index[(j,k)]] = -1
                            else:
                                row[pair_index[(k,j)]] = -1
                            A.append(row)
                            b.append(-1)
                # variable bounds: 0 <= var <= 1, integer
                bounds = opt.Bounds(0,1)
                integrality = np.ones(total_vars, dtype=int)
                # convert to linear constraints
                A = np.array(A)
                b = np.array(b)
                # Use milp
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A, -np.inf, b), bounds=bounds,
                               integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("failed", n)
                    return None
                x = res.x[:m]
                y = res.x[m:]
                # compute f
                sum_x = int(round(x.sum()))
                sum_y = int(round(y.sum()))
                f_val = sum_x - sum_y
                return f_val, sum_x, sum_y
            
            for n in range(2,9):
                print(n, max_f_ilp(n))
            
