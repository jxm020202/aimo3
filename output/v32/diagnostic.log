            def max_edges(n):
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(pairs)
                # mapping for edge variable
                edge_idx = {}
                for idx,(i,j) in enumerate(pairs):
                    edge_idx[(i,j)] = idx
                    edge_idx[(j,i)] = idx  # both directions map to same index
                # ordered w variables: index = i*(n-1) + pos where pos is index of j in list of vertices != i
                # precompute mapping
                w_idx = {}
                idx_counter = m
                for i in range(n):
                    pos = 0
                    for j in range(n):
                        if i==j: continue
                        w_idx[(i,j)] = idx_counter
                        idx_counter += 1
                total_vars = idx_counter
                import numpy as np
                c = np.zeros(total_vars)
                c[:m] = -1  # maximize edges
                # bounds binary
                bounds = Bounds(0, 1)
                # constraints
                A = []
                b = []
                # w_{i,j} <= x_{i,j}
                for i in range(n):
                    for j in range(n):
                        if i==j: continue
                        row = np.zeros(total_vars)
                        row[w_idx[(i,j)]] = 1
                        row[edge_idx[(i,j)]] = -1
                        A.append(row)
                        b.append(0)
                # each vertex i must have at least one private edge
                for i in range(n):
                    row = np.zeros(total_vars)
                    for j in range(n):
                        if i==j: continue
                        row[w_idx[(i,j)]] = -1  # we will use >= constraint by multiplying -1
                    # sum w_{i,j} >= 1  => -sum w_{i,j} <= -1
                    A.append(row)
                    b.append(-1)
                # triangle-free condition: for all distinct i,j,k, w_{i,j} + x_{i,k} + x_{j,k} <= 2
                for i in range(n):
                    for j in range(n):
                        if i==j: continue
                        for k in range(n):
                            if k==i or k==j: continue
                            row = np.zeros(total_vars)
                            row[w_idx[(i,j)]] = 1
                            row[edge_idx[(i,k)]] = 1
                            row[edge_idx[(j,k)]] = 1
                            A.append(row)
                            b.append(2)
                # Convert to arrays
                A = np.array(A)
                b = np.array(b)
                # linear constraints: A @ x <= b
                lin_con = LinearConstraint(A, -np.inf*np.ones_like(b), b)
                # integrality: all variables binary
                integrality = np.ones(total_vars)
                res = milp(c, constraints=lin_con, integrality=integrality, bounds=bounds, options={'disp': False})
                if not res.success:
                    print("Failed")
                    return None
                edge_vals = res.x[:m]
                total_edges = int(round(edge_vals.sum()))
                return total_edges
            
            for n in range(4,9):
                print(n, max_edges(n))
            
