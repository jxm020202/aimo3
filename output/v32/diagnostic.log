            def min_fill_ordering(G):
                # G is a networkx graph (mutable copy)
                G = G.copy()
                order = []
                while G.nodes():
                    # choose node with smallest degree (break ties by node id)
                    v = min(G.nodes(), key=lambda x: G.degree[x])
                    order.append(v)
                    # make neighbors a clique
                    nbrs = list(G.neighbors(v))
                    for i in range(len(nbrs)):
                        for j in range(i+1, len(nbrs)):
                            if not G.has_edge(nbrs[i], nbrs[j]):
                                G.add_edge(nbrs[i], nbrs[j])
                    G.remove_node(v)
                return order
            
            order = min_fill_ordering(L)
            len(order)
            
