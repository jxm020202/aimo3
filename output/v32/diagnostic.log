            def construct_f(n):
                p = n+1
                # find primitive root modulo p
                g = sp.primitive_root(p)
                # map 0..n-1 to 1..n via g^x mod p
                f = {}
                for x in range(1, n+1):
                    # x corresponds to x-1 in Z_n
                    val = pow(g, x-1, p)
                    if val == 0:
                        raise ValueError("should not be zero")
                    f[x] = val
                return f
            
            def check_f(n, f):
                for x in range(1, n+1):
                    y = ((866*x - 1) % n) + 1
                    lhs = f[y] % (n+1)
                    rhs = pow(f[x], 866, n+1)
                    if lhs != rhs:
                        return False, (x,y,lhs,rhs)
                return True, None
            
