            def feasible_with_block_min_pieces(block_row, block_col, min_pieces):
                n=15
                N=n*n
                radius=2
                # compute block indices: rows block_row*5 .. block_row*5+4, similarly cols
                rows_range = range(block_row*5, block_row*5+5)
                cols_range = range(block_col*5, block_col*5+5)
                block_cells = set(r*n + c for r in rows_range for c in cols_range)
                # build constraints as before
                coords = [(i//n,i%n) for i in range(N)]
                neighbor_indices = []
                for i,(r,c) in enumerate(coords):
                    neigh=[]
                    for dr in range(-radius,radius+1):
                        for dc in range(-radius,radius+1):
                            rr=r+dr; cc=c+dc
                            if 0<=rr<n and 0<=cc<n:
                                neigh.append(rr*n+cc)
                    neighbor_indices.append(neigh)
                rows=[]; lb=[]; ub=[]
                for i,neigh in enumerate(neighbor_indices):
                    coeff=np.zeros(N,dtype=int); coeff[neigh]=1
                    rows.append(coeff); lb.append(-np.inf); ub.append(2)
                for i,neigh in enumerate(neighbor_indices):
                    coeff=np.zeros(N,dtype=int); coeff[neigh]=-1; coeff[i]+=2
                    rows.append(coeff); lb.append(-np.inf); ub.append(0)
                # add constraint sum_{i in block_cells} x_i >= min_pieces
                A_extra = np.zeros((1,N), dtype=int)
                for idx in block_cells:
                    A_extra[0, idx] = 1
                rows.append(A_extra[0]); lb.append(min_pieces); ub.append(np.inf)
                A = np.vstack(rows)
                lc = LinearConstraint(A, lb, ub)
                c = np.zeros(N)
                bounds = Bounds(0,1)
                integrality = np.ones(N,dtype=int)
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                return res.success, res.fun if res.success else None
            
