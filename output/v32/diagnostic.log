                        rows.append(row_idx); cols.append(idx); data.append(1)
                    # in arcs to v
                    for nb in adj[v]:
                        idx = arc_index[(nb, v)]
                        rows.append(row_idx); cols.append(idx); data.append(-1)
                    b.append(rhs)
                # MTZ constraints for i != 0, j != 0, i != j
