                # generate 9 random numbers, sort, scale to sum 1
                a = np.random.randn(9)  # normal distribution maybe
                a = np.sort(a)
                # shift to make sum positive? We'll just shift to make sum 1: scale factor
                total = np.sum(a)
                # we need sum=1, scaling factor = 1/total
                # but if total is zero or negative, scaling flips sign; we need sum=1 positive.
                # Let's generate positive numbers: use exponential
                a = np.random.exponential(scale=1.0, size=9)
                a = np.sort(a)
                a = a / np.sum(a)
                return a
            
