            import itertools
            
            def gray_code(d):
                # binary reflected Gray code
                n = 1 << d
                seq = [i ^ (i >> 1) for i in range(n)]
                return seq
            
            def count_flips(d):
                seq = gray_code(d)
                flips = [0]*d
                for i in range(len(seq)):
                    a = seq[i]
                    b = seq[(i+1)%len(seq)]  # cycle
                    diff = a ^ b
                    # diff is power of 2
                    k = diff.bit_length()-1
                    flips[k] += 1
                return flips
            
