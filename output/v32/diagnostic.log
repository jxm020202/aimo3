            def is_in_S(s):
                # s >= 4? but we only call for s>=3456
                from math import gcd
                for p in range(2, s-1):  # p = a+b, at least 2, q = s-p >=2 => p <= s-2
                    q = s - p
                    if q < 2:
                        continue
                    g = gcd(s, q)
                    M = s // g
                    # compute residues of X = a*(p-a) modulo M
                    # we can compute set quickly
                    residues_X = set()
                    # iterate a from 1 to p-1
                    for a in range(1, p):
                        residues_X.add((a * (p - a)) % M)
                    # iterate c for Y and check intersection
                    for c in range(1, q):
                        if ((c * (q - c)) % M) in residues_X:
                            # found match, condition satisfied
                            return True
                return False
            
            # quick test for small s values (maybe known)
            print(is_in_S(10))
            
