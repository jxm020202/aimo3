                v_edges = {v: [] for v in verts}
                for idx,(u,v) in enumerate(edge_list):
                    v_edges[u].append(idx)
                    v_edges[v].append(idx)
                # factors per vertex
                factors = []
                for v in verts:
                    vars_v = tuple(v_edges[v])
                    table = np.zeros((3,3,3), dtype=np.int64)
                    for colors in itertools.product(range(3), repeat=3):
                        if len(set(colors)) == 2:
                            table[colors] = 1
                    factors.append((vars_v, table))
                # build line graph of K4 edges
                L = nx.line_graph(nx.complete_graph(4))
                if order is None:
                    order = min_fill_ordering(L)
                for var in order:
                    relevant = [f for f in factors if var in f[0]]
                    factors = [f for f in factors if var not in f[0]]
                    if not relevant:
                        continue
                    combined_vars = sorted(set().union(*[set(f[0]) for f in relevant]))
                    k = len(combined_vars)
                    var_index = {v:i for i,v in enumerate(combined_vars)}
                    combined_table = np.zeros((3,)*k, dtype=np.int64)
                    for assign in itertools.product(range(3), repeat=k):
                        prod = 1
                        for vars_f, table_f in relevant:
                            idx = tuple(assign[var_index[v]] for v in vars_f)
                            prod *= table_f[idx]
                            if prod == 0:
                                break
                        if prod != 0:
                            combined_table[assign] = prod
                    idx_elim = var_index[var]
                    new_table = combined_table.sum(axis=idx_elim)
                    new_vars = tuple(v for v in combined_vars if v != var)
                    if len(new_vars) == 0:
                        return int(new_table)
                    else:
                        factors.append((new_vars, new_table))
                total = 1
                for vars_f, table_f in factors:
                    total *= table_f.sum()
                return total
            
