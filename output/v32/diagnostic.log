            import networkx as nx
            
            def digraph_mul(n):
                G = nx.DiGraph()
                G.add_nodes_from(range(1,n+1))
                for x in range(1,n+1):
                    y = (866*x) % n
                    if y==0:
                        y=n
                    G.add_edge(x,y)
                return G
            
            def digraph_pow(n):
                m = n+1
                G = nx.DiGraph()
                G.add_nodes_from(range(1,n+1))
                for a in range(1,n+1):
                    b = pow(a, 866, m)
                    # b is in 0..m-1; if b==0, map to m which is not in node set; but we need to map to something in 1..n?
                    # However condition only involves f(y) where y in domain, and we need h(f(x)) to be in domain.
                    # Since f maps to 1..n, we need h(f(x)) also be in 1..n (non-zero). So we must ensure pow(a,866,m) != 0 for all a in 1..n.
                    # If pow(a,866,m)==0, then the condition cannot be satisfied because RHS would be n+1, not in domain.
                    # So such n cannot work.
                    if b==0:
                        # assign to None to indicate invalid
                        return None
                    G.add_edge(a,b)
                return G
            
            def isomorphic(n):
                G1 = digraph_mul(n)
                G2 = digraph_pow(n)
                if G2 is None:
                    return False
                # Use DiGraphMatcher with node labels ignored
                GM = nx.isomorphism.DiGraphMatcher(G1, G2)
                return GM.is_isomorphic()
            
            def find_min(limit=2000):
                for n in range(866, limit+1):
                    if isomorphic(n):
                        return n
                return None
            
            print(find_min(2000))
            
