                for p, exp in factors.items():
                    mod = p**exp
                    if p == 3:
                        # M divisible by 3^{2025!} which is huge, so residue 0
                        residues.append(0)
                    else:
                        # gcd(3, mod)=1, exponent multiple of phi(mod) => residue 1
                        residues.append(1 % mod)
