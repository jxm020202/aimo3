            def bishop_domination_color(n, color):
                # color 0 for even sum (white), 1 for odd sum (black)
                squares = [(r,c) for r in range(n) for c in range(n) if (r+c)%2==color]
                N=len(squares)
                idx = {sq:i for i,sq in enumerate(squares)}
                # adjacency within same color (share diagonal)
                adj = [set() for _ in range(N)]
                # Precompute diagonals for this color
                # For each square, compute its two diagonals within board; other squares of same color on same diagonal
                for i,(r,c) in enumerate(squares):
                    for j,(r2,c2) in enumerate(squares):
                        if i!=j and (r-c==r2-c2 or r+c==r2+c2):
                            adj[i].add(j)
                    adj[i].add(i) # include self
                A = np.zeros((N,N), dtype=int)
                for i in range(N):
                    for j in adj[i]:
                        A[i,j]=1
                cvec = np.ones(N)
                lin_con = LinearConstraint(-A, -np.inf, -np.ones(N))
                bounds = Bounds(0,1)
                res = milp(c=cvec, constraints=lin_con, bounds=bounds, integrality=np.ones(N, dtype=int), options={'disp': False})
                return int(round(res.fun))
            for n in range(2,9):
                print("n",n,"white",bishop_domination_color(n,0),"black",bishop_domination_color(n,1))
            
