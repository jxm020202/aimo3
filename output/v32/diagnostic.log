            def min_dominos_blocked(n):
                # generate placements
                placements = []
                for r in range(n):
                    for c in range(n-1):
                        placements.append(((r,c),(r,c+1)))  # horizontal
                for r in range(n-1):
                    for c in range(n):
                        placements.append(((r,c),(r+1,c)))  # vertical
                # mapping
                cell_to_placements = collections.defaultdict(list)
                for i, cells in enumerate(placements):
                    for cell in cells:
                        cell_to_placements[cell].append(i)
                # directions
                dirs = {'up':(-1,0), 'down':(1,0), 'left':(0,-1), 'right':(0,1)}
                constraints = []
                for i, cells in enumerate(placements):
                    for dir_name, (dr,dc) in dirs.items():
                        # compute required new cells not overlapping original
                        orig_set = set(cells)
                        req = []
                        blocked_by_edge = False
                        for (r,c) in cells:
                            nr, nc = r+dr, c+dc
                            if (nr,nc) in orig_set:
                                continue
                            if not (0 <= nr < n and 0 <= nc < n):
                                blocked_by_edge = True
                                break
                            req.append((nr,nc))
                        if blocked_by_edge:
                            continue  # no constraint needed
                        # req may be length 1 or 2
                        covering = set()
                        for cell in req:
                            covering.update(cell_to_placements[cell])
                        # build row
                        row = collections.defaultdict(int)
                        for j in covering:
                            row[j] += 1
                        row[i] -= 1
                        constraints.append(row)
                # Build matrix
                m = len(constraints)
                p = len(placements)
                A = np.zeros((m,p), dtype=int)
                b = np.zeros(m, dtype=int)
                for idx,row in enumerate(constraints):
                    for var,coeff in row.items():
                        A[idx,var] = coeff
                # Solve ILP
                c = np.ones(p, dtype=int)
                lin_con = LinearConstraint(A, lb=b, ub=np.full_like(b, np.inf))
                bounds = Bounds(0,1)
                res = milp(c=c, constraints=[lin_con], bounds=bounds, integrality=np.ones(p, dtype=int))
                if not res.success:
                    return None
                else:
                    return int(res.fun), [i for i,x in enumerate(res.x) if round(x)>0.5]
            
            for n in range(2,6):
                print("n", n, min_dominos_blocked(n))
            
