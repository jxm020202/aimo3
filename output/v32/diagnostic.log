            def bipartite_matrix(n):
                # n must be even, partition size n/2
                half=n//2
                S=set(range(half))  # choose first half as S
                Sc=set(range(n))-S
                A=np.zeros((n,n), dtype=int)
                for i in range(n):
                    if i in S:
                        for j in Sc:
                            A[i,j]=1
                    else:
                        for j in S:
                            A[i,j]=1
                return A
            
            def check_matrix(A):
                n=A.shape[0]
                J=np.ones((n,n), dtype=int)
                return np.array_equal(A.dot(A)+6*A,6*J)
            
            A6=bipartite_matrix(6)
            print(A6)
