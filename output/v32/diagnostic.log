                        arcs.append((v, nb))
                        diff = v ^ nb
                        k = diff.bit_length() - 1
                        weight[(v, nb)] = 1/(2**k)
                m_arc = len(arcs)
                # objective
                c = np.array([weight[arc] for arc in arcs])
                # Build constraints
                # degree constraints: for each vertex v, out - in = rhs (rhs=1 for start 0, else 0)
                rows = []
                cols = []
                data = []
                b = []
                for v in vertices:
                    rhs = 1 if v == 0 else 0
                    row = len(b)
                    # out arcs
                    for nb in adj[v]:
                        idx = arcs.index((v, nb))
                        rows.append(row); cols.append(idx); data.append(1)
                    # in arcs
                    for nb in adj[v]:
                        idx = arcs.index((nb, v))
                        rows.append(row); cols.append(idx); data.append(-1)
                    b.append(rhs)
                # MTZ constraints
                N = n
                for i in vertices:
                    if i == 0: continue
