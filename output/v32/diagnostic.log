            def L_numeric(x, theta, num=10000):
                # compute vertical length by solving constraints
                c, s = math.cos(theta), math.sin(theta)
                # find y range that satisfies both constraints
                # compute lower and upper bounds as earlier
                if s == 0 or c == 0:
                    return None
                upper1 = (0.5 - x*c)/s
                upper2 = (0.5 + x*s)/c
                lower1 = (-0.5 - x*c)/s
                lower2 = (-0.5 + x*s)/c
                upper = min(upper1, upper2)
                lower = max(lower1, lower2)
                return max(0.0, upper - lower)
            
            def L_formula(x, theta):
