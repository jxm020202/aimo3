                # Note: we ignore edge as slide not possible if new squares out of board.
                # We'll check each direction
                dirs = []
                if orient == 'H':
                    # left
                    if c > 0:
                        new = [idx(r, c-1)]
                        dirs.append(('L', new))
                    # right
                    if c+2 < 7:
                        new = [idx(r, c+2)]
                        dirs.append(('R', new))
                    # up
                    if r > 0:
                        new = [idx(r-1, c), idx(r-1, c+1)]
                        dirs.append(('U', new))
                    # down
                    if r+2 < 7:
                        new = [idx(r+2, c), idx(r+2, c+1)]
                        dirs.append(('D', new))
                else:
                    # V
                    # up
                    if r > 0:
                        new = [idx(r-1, c)]
                        dirs.append(('U', new))
                    # down
                    if r+2 < 7:
                        new = [idx(r+2, c)]
                        dirs.append(('D', new))
                    # left
                    if c > 0:
                        new = [idx(r, c-1), idx(r+1, c-1)]
                        dirs.append(('L', new))
                    # right
                    if c+2 < 7:
                        new = [idx(r, c+2), idx(r+1, c+2)]
                        dirs.append(('R', new))
                # Build occupancy set of squares covered by selected placements
                occ = set()
                for i in placements_set:
                    occ.update(placements[i]['squares'])
                # Remove squares of current domino (since they will be vacated)
                occ_without = occ - set(p['squares'])
                # For each direction, slide possible if all new squares are inside board (already ensured) and none are occupied by other dominos
                for d, new_sqs in dirs:
                    # check if any new square is occupied by other dominos
                    if any(sq in occ_without for sq in new_sqs):
                        # blocked
                        continue
                    else:
                        # slide possible
                        return True
                return False
            
            placements_set = set(selected)
            any_slide = any(can_slide(placements[i], placements_set) for i in selected)
            any_slide
            
