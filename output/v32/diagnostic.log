                    # Condition: (y1>0) != (y2>0) and x_intersect > 0
                    if ((y1>0) != (y2>0)):
                        x_intersect = x1 + (0 - y1)*(x2 - x1)/(y2 - y1)
                        if x_intersect > 0:
                            inside = not inside
                return inside
            
            def trial(N=10000):
                cnt=0
                for _ in range(N):
                    pts=[random_point_in_disk() for __ in range(10)]
                    if not origin_inside_convex_hull(pts):
                        cnt+=1
                return cnt/N
            
