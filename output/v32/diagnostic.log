            def is_perm_exponent(m, k=866):
                # returns True if map a->a^k mod m is a permutation of 1..m-1
                images = {}
                for a in range(1, m):
                    v = pow(a, k, m)
                    if v == 0:
                        return False
                    if v in images:
                        return False
                    images[v] = a
                return True
            
