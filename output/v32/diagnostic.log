                        for c2 in range(3):
                            for c3 in range(3):
                                # check condition: exactly two equal
                                if (c1==c2!=c3) or (c1==c3!=c2) or (c2==c3!=c1):
                                    table[(c1,c2,c3)] = 1
                                else:
                                    table[(c1,c2,c3)] = 0
                    factors.append((scope, table))
                # elimination order
                order = list(range(30))
                for var in order:
                    # find factors containing var
                    containing = [i for i,(scope,_) in enumerate(factors) if var in scope]
                    if not containing:
                        continue
                    # multiply all these factors
                    # start with first factor
                    new_scope, new_table = factors[containing[0]]
                    # We'll multiply iteratively
                    for idx in containing[1:]:
                        scope2, table2 = factors[idx]
