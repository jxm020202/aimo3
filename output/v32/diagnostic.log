            def minimal_S_bruteforce_search():
                total = 1997
                best = None
                best_params = None
                for m in range(0, 38):
                    s_min = m*(m+1)//2
                    # s must be <= total//2 = 998
                    if s_min > total//2:
                        continue
                    n = 37 - m  # number of elements after a_{m+1}
                    # compute t_max as before
                    numerator = total - s_min - n*(n+1)//2  # using s_min for bound? Actually t_max derived from total - s_min - n(n+1)/2 >= (n+1)*t
                    # Wait t_max formula uses s (the actual sum of first m). But we used s_min for bound; but t_max may be larger if s larger.
                    # Actually total - s - n(n+1)/2 >= (n+1)*t => t <= (total - s - n(n+1)/2)/(n+1)
                    # Since s >= s_min, the RHS is maximized when s is minimal (makes numerator larger). So using s_min gives an upper bound on t_max.
                    # So t_max_possible = floor((total - s_min - n(n+1)/2)/(n+1)).
                    t_upper = (total - s_min - n*(n+1)//2)//(n+1)
                    # t must be > m
                    for t in range(m+1, t_upper+1):
                        # compute s_max given t
                        s_max = m*t - m*(m+1)//2
                        # feasible s range intersect with [s_min, s_max] and <= 998 and s + t >= 999
                        low = max(s_min, 0)  # s_min already
                        high = min(s_max, total//2)
                        # also need s + t >= 999
                        low = max(low, 999 - t)  # ensure s >= 999 - t
                        if low > high:
                            continue
                        # For given t, we can choose s in [low, high] to minimize max(s, total - s - t)
                        # The function max(s, total - s - t) is decreasing in s while s < (total - t)/2, and increasing after.
                        # So optimal s is as close as possible to (total - t)/2 within interval.
                        target = (total - t)/2
                        # Choose s = clamp(target) to interval [low, high] (but integer)
                        # Since s integer, we can check floor and ceil.
                        candidates_s = []
                        # nearest integer to target within interval
                        s_candidate = int(target)
                        for s in [s_candidate-1, s_candidate, s_candidate+1]:
                            if low <= s <= high:
                                candidates_s.append(s)
                        # also check boundaries low and high
                        candidates_s.extend([low, high])
                        for s in set(candidates_s):
                            S_val = max(s, total - s - t)
                            if best is None or S_val < best:
                                best = S_val
                                best_params = (m, t, s)
                return best, best_params
            
            best_S, params = minimal_S_bruteforce_search()
            best_S, params
            
