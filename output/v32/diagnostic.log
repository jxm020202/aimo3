            import math
            
            def rotate_point(px, py, theta):
                c = math.cos(theta)
                s = math.sin(theta)
                return (px*c - py*s, px*s + py*c)
            
            def square_vertices(center, theta):
                cx, cy = center
                # vertices of axis-aligned square centered at origin: (±0.5, ±0.5)
                verts = [(-0.5, -0.5), (0.5, -0.5), (0.5, 0.5), (-0.5, 0.5)]
                rot = [rotate_point(x, y, theta) for (x,y) in verts]
                return [(cx + x, cy + y) for (x,y) in rot]
            
            def clip_polygon(poly, edge):
                # edge defined as a function inside(p) returns True if point inside half-plane
                # and intersect(p1,p2) returns intersection point of segment p1-p2 with edge line
                # We'll implement generic clipping for axis-aligned rectangle edges.
                # For simplicity, we will implement clipping against each of four lines: x>=0, x<=1, y>=0, y<=1.
                # We'll pass edge as a tuple (axis, bound, keep_greater) where axis='x' or 'y', bound is value, keep_greater bool.
                axis, bound, keep_greater = edge
                new_poly = []
                n = len(poly)
                for i in range(n):
                    p1 = poly[i]
                    p2 = poly[(i+1)%n]
                    # Determine if points are inside
                    if axis == 'x':
                        inside1 = (p1[0] >= bound) if keep_greater else (p1[0] <= bound)
                        inside2 = (p2[0] >= bound) if keep_greater else (p2[0] <= bound)
                    else:
                        inside1 = (p1[1] >= bound) if keep_greater else (p1[1] <= bound)
                        inside2 = (p2[1] >= bound) if keep_greater else (p2[1] <= bound)
                    # Cases
                    if inside1 and inside2:
                        # both inside: add p2
                        new_poly.append(p2)
                    elif inside1 and not inside2:
                        # leaving: add intersection
                        # compute intersection with line axis=bound
                        if axis == 'x':
                            t = (bound - p1[0]) / (p2[0] - p1[0])
                            y = p1[1] + t * (p2[1] - p1[1])
                            new_poly.append((bound, y))
                        else:
                            t = (bound - p1[1]) / (p2[1] - p1[1])
                            x = p1[0] + t * (p2[0] - p1[0])
                            new_poly.append((x, bound))
                    elif not inside1 and inside2:
                        # entering: add intersection then p2
                        if axis == 'x':
                            t = (bound - p1[0]) / (p2[0] - p1[0])
                            y = p1[1] + t * (p2[1] - p1[1])
                            new_poly.append((bound, y))
                            new_poly.append(p2)
                        else:
                            t = (bound - p1[1]) / (p2[1] - p1[1])
                            x = p1[0] + t * (p2[0] - p1[0])
                            new_poly.append((x, bound))
                            new_poly.append(p2)
                    else:
                        # both outside: add nothing
                        pass
                return new_poly
            
            def clip_to_unit(poly):
                # clip against x>=0, x<=1, y>=0, y<=1
                edges = [('x', 0.0, True), ('x', 1.0, False), ('y', 0.0, True), ('y', 1.0, False)]
                res = poly
                for e in edges:
                    res = clip_polygon(res, e)
                    if not res:
                        break
                return res
            
            def polygon_area(poly):
                if len(poly) < 3:
