            def min_adjacent_sum(arr, n):
                # arr is list length n*n
                grid = np.array(arr).reshape((n,n))
                min_sum = float('inf')
                for i in range(n):
                    for j in range(n):
                        v = grid[i,j]
                        if i+1 < n:
                            min_sum = min(min_sum, v + grid[i+1,j])
                        if j+1 < n:
                            min_sum = min(min_sum, v + grid[i,j+1])
                return min_sum
            
            def random_arrangement(n):
                arr = list(range(1, n*n+1))
                random.shuffle(arr)
                return arr
            
            def hill_climb(n, iterations=20000):
                # start with random arrangement
                best_arr = random_arrangement(n)
                best_score = min_adjacent_sum(best_arr, n)
                arr = best_arr[:]
                score = best_score
                for it in range(iterations):
                    # propose swap two cells
                    i,j = random.sample(range(n*n),2)
                    arr[i], arr[j] = arr[j], arr[i]
                    new_score = min_adjacent_sum(arr, n)
                    # accept if not worse
                    if new_score >= score:
                        score = new_score
                        if new_score > best_score:
                            best_score = new_score
                            best_arr = arr[:]
                    else:
                        # revert
                        arr[i], arr[j] = arr[j], arr[i]
                return best_score, best_arr
            
            for n in range(2,6):
                best = 0
                for _ in range(5):
                    sc,_ = hill_climb(n,iterations=20000)
                    best = max(best, sc)
                print(n, best)
            
