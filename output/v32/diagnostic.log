            import numpy as np
            
            def rank_mod3(matrix):
                # Gaussian elimination mod 3
                A = [row[:] for row in matrix]
                m = len(A)
                n = len(A[0]) if m>0 else 0
                rank = 0
                row = 0
                for col in range(n):
                    # find pivot
                    pivot = None
                    for i in range(row, m):
                        if A[i][col] % 3 != 0:
                            pivot = i
                            break
                    if pivot is None:
                        continue
                    # swap
                    A[row], A[pivot] = A[pivot], A[row]
                    # normalize pivot to 1
                    inv = {1:1, 2:2}  # since 2*2=4=1 mod3, inverse of 2 is 2
                    factor = inv[A[row][col] % 3]
                    A[row] = [(val*factor)%3 for val in A[row]]
                    # eliminate other rows
                    for i in range(m):
                        if i != row and A[i][col] % 3 != 0:
                            factor = A[i][col] % 3
                            # row_i = row_i - factor*row_row
                            A[i] = [ (A[i][j] - factor*A[row][j]) % 3 for j in range(n)]
                    row += 1
                    rank += 1
                    if row == m:
                        break
                return rank
            
