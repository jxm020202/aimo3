            import numpy as np, random, math, time
            
            def simulated_anneal(m,n,target,steps=2000000,initial_temp=1.0,cooling=0.9999):
                N=m*n
                # start with random permutation
                perm = list(range(1,N+1))
                random.shuffle(perm)
                grid = np.array(perm).reshape(m,n)
                cur_min = min_adj_sum_grid(grid)
                best_min = cur_min
                best_grid = grid.copy()
                temp = initial_temp
                for step in range(steps):
                    # pick two cells to swap
                    i1,j1 = divmod(random.randrange(N), n)
                    i2,j2 = divmod(random.randrange(N), n)
                    if i1==i2 and j1==j2:
                        continue
                    # compute delta efficiently? compute min before and after for affected edges
                    # For simplicity compute full min after swap
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    new_min = min_adj_sum_grid(grid)
                    delta = new_min - cur_min
                    if delta >= 0 or random.random() < math.exp(delta / temp):
                        cur_min = new_min
                        if cur_min > best_min:
                            best_min = cur_min
                            best_grid = grid.copy()
                            if best_min >= target:
                                return best_grid, best_min
                    else:
                        # revert
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    temp *= cooling
                    if temp < 1e-6:
                        temp = 1e-6
                return best_grid, best_min
            
            best_grid, best_min = simulated_anneal(4,4,16,steps=500000)
            print("best_min",best_min)
            print(best_grid)
            
