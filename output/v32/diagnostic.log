            def representable_with_t(t, max_exp=10):
                # generate all sums with exactly t non-zero signed digits using exponents up to max_exp
                # brute force: choose t distinct exponents from range(0,max_exp+1), assign signs
                from itertools import combinations, product
                reps=set()
                exps = list(range(max_exp+1))
                for comb in combinations(exps, t):
                    for signs in product((-1,1), repeat=t):
                        s=sum(sign* (1<<e) for sign,e in zip(signs, comb))
                        if s>0:
                            reps.add(s)
                return reps
            
            def minimal_missing(t, max_exp=12):
                reps=representable_with_t(t, max_exp)
                n=1
                while True:
                    if n not in reps:
                        return n
                    n+=1
            
            for t in range(1,7):
                print(t, minimal_missing(t, max_exp=12))
            
