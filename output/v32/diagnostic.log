            def uncovered_area_grid(theta, resolution=2000):
                # grid points in [0,1]x[0,1]
                xs = np.linspace(0,1,resolution)
                ys = np.linspace(0,1,resolution)
                xv, yv = np.meshgrid(xs, ys, indexing='ij')
                xv = xv.ravel()
                yv = yv.ravel()
                cos = math.cos(theta)
                sin = math.sin(theta)
                covered = np.zeros_like(xv, dtype=bool)
                for i,j in [(0,0),(1,0),(0,1),(1,1)]:
                    u = (xv - i) * cos + (yv - j) * sin
                    v = -(xv - i) * sin + (yv - j) * cos
                    inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)
                    covered |= inside
                uncovered = ~covered
                area = uncovered.mean()  # fraction of unit square
                return area
            
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/4]:
