            def max_pieces(board_size=15, M=25):
                n = board_size
                N = n*n
                neighbor_indices = []
                for i in range(n):
                    for j in range(n):
                        neigh = []
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                ii = i+di
                                jj = j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    neigh.append(ii*n + jj)
                        neighbor_indices.append(neigh)
                rows = []
                ub = []
                for idx, neigh in enumerate(neighbor_indices):
                    coeff = np.zeros(N, dtype=float)
                    for j in neigh:
                        coeff[j] = 1.0
                    coeff[idx] += M
                    rows.append(coeff)
                    ub.append(M + 2)
                    # second constraint
                    coeff2 = np.zeros(N, dtype=float)
                    for j in neigh:
                        coeff2[j] = -1.0
                    coeff2[idx] += M
                    rows.append(coeff2)
                    ub.append(M - 2)
                A = np.vstack(rows)
                b_l = np.full(A.shape[0], -np.inf)
                b_u = np.array(ub, dtype=float)
                constraints = LinearConstraint(A, b_l, b_u)
                c = -np.ones(N, dtype=float)  # maximize sum
                bounds = Bounds(0, 1)
                integrality = np.ones(N, dtype=int)
                start = time.time()
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={"presolve": True, "disp": False})
                print("status:", res.success, res.message, "time:", time.time()-start)
                if not res.success:
                    return None
                x = np.rint(res.x).astype(int)
                total = int(x.sum())
                return total, x.reshape((n,n))
