            def contains_lattice_point(theta, cx, cy):
                # square side 1, centered at (cx,cy)
                # Check integer points within bounding box
                # Determine min and max integer coordinates to test
                # The square after rotation: points (cx,cy) + Rθ * (u,v) where u,v∈[-0.5,0.5]
                # Equivalent to inverse rotation: for each integer point (i,j), compute (u,v) = R_{-θ} * ((i,j)-(cx,cy))
                # Then check if |u|<=0.5 and |v|<=0.5.
                c, s = math.cos(theta), math.sin(theta)
                # Inverse rotation matrix:
                # [c s; -s c]
                # We'll test integer points in range floor(cx-0.5)-1 .. ceil(cx+0.5)+1
                imin = math.floor(cx - 0.5) - 1
                imax = math.ceil(cx + 0.5) + 1
                jmin = math.floor(cy - 0.5) - 1
                jmax = math.ceil(cy + 0.5) + 1
                for i in range(imin, imax+1):
                    for j in range(jmin, jmax+1):
                        # vector from center to lattice point
                        dx = i - cx
                        dy = j - cy
                        # rotate back
                        u = dx * c + dy * s
                        v = -dx * s + dy * c
                        if abs(u) <= 0.5 + 1e-12 and abs(v) <= 0.5 + 1e-12:
