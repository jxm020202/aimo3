            def is_bipartite_complete(A):
                n=A.shape[0]
                half=n//2
                # Determine partition by looking at row 0's support
                S0 = set(np.where(A[0]==1)[0])
                # Should be size half
                if len(S0)!=half:
                    return False
                # Determine complement
                X=set()
                Y=set()
                # Suppose row 0 is in X, then its support is Y
                X.add(0)
                Y=S0
                # Now for each row i, check if its support equals Y (if i in X) or X (if i in Y)
                for i in range(n):
                    support=set(np.where(A[i]==1)[0])
                    if i in X:
                        if support!=Y:
                            return False
                    elif i in Y:
                        if support!=X:
                            return False
                    else:
                        # Determine which side based on support
                        if support==Y:
                            X.add(i)
                        elif support==X:
                            Y.add(i)
                        else:
                            return False
                # Finally check sizes
                return len(X)==half and len(Y)==half
            
            def random_matrix(n, half):
                rows=[]
                for _ in range(n):
                    comb=random.sample(range(n), half)
                    row=[0]*n
                    for j in comb:
                        row[j]=1
                    rows.append(row)
                return np.array(rows, dtype=int)
            
            def find_nonbipartite(n, trials=10000):
                half=n//2
                for _ in range(trials):
                    A=random_matrix(n, half)
                    if verify(A):
                        if not is_bipartite_complete(A):
                            return A
                return None
            
            print(find_nonbipartite(6, 2000))
            
