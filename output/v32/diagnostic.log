            import random, math, itertools, numpy as np, sys, time, collections, math, copy, itertools, collections, math, random, time, sys, numpy as np
            def random_initial(m,n):
                N=m*n
                arr = list(range(1,N+1))
                random.shuffle(arr)
                return np.array(arr).reshape(m,n)
            
            def min_adj_sum_grid(grid):
                m,n = grid.shape
                mins = 10**9
                for i in range(m):
                    for j in range(n):
                        if i+1<m:
                            s=grid[i,j]+grid[i+1,j]
                            if s<mins: mins=s
                        if j+1<n:
                            s=grid[i,j]+grid[i,j+1]
                            if s<mins: mins=s
                return mins
            
            def improve(grid, target):
                # simple hill climbing: try swapping two cells if it improves min sum
                m,n = grid.shape
                best = min_adj_sum_grid(grid)
                if best >= target:
                    return grid, True
                # attempt many random swaps
                for _ in range(20000):
                    i1,j1 = random.randrange(m), random.randrange(n)
                    i2,j2 = random.randrange(m), random.randrange(n)
                    if i1==i2 and j1==j2: continue
                    # swap
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    new_min = min_adj_sum_grid(grid)
                    if new_min > best:
                        best = new_min
                        if best >= target:
                            return grid, True
                    else:
                        # revert
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                return grid, False
            
            def find_labeling(m,n,target,iterations=200):
                for it in range(iterations):
                    grid = random_initial(m,n)
                    # try hill climbing
                    improved=False
                    for _ in range(100):
                        grid, improved = improve(grid,target)
                        if improved:
                            return grid
                return None
            
            m,n=4,5
            target=m*n
            grid=find_labeling(m,n,target,iterations=100)
            print(grid is not None)
            if grid is not None:
                print(min_adj_sum_grid(grid))
            
