            import itertools, math, collections, sys, time, copy, random, functools
            # Build icosahedron structure
            phi = (1 + 5**0.5) / 2
            verts = [
                (0, 1, phi),
                (0, -1, phi),
                (0, 1, -phi),
                (0, -1, -phi),
                (1, phi, 0),
                (-1, phi, 0),
                (1, -phi, 0),
                (-1, -phi, 0),
                (phi, 0, 1),
                (-phi, 0, 1),
                (phi, 0, -1),
                (-phi, 0, -1)
            ]
            def dist2(a,b):
                return sum((a[i]-b[i])**2 for i in range(3))
            edges = []
            edge_index = {}
            n = len(verts)
            for i in range(n):
                for j in range(i+1, n):
                    if abs(dist2(verts[i], verts[j]) - 4) < 1e-6:
                        idx = len(edges)
                        edges.append((i,j))
                        edge_index[(i,j)] = idx
                        edge_index[(j,i)] = idx
            edges_count = len(edges)
            # faces
            faces_vertices = []
            for a in range(n):
                for b in range(a+1, n):
                    for c in range(b+1, n):
                        if ((a,b) in edge_index) and ((a,c) in edge_index) and ((b,c) in edge_index):
                            faces_vertices.append((a,b,c))
            faces = []
            for (a,b,c) in faces_vertices:
                faces.append((edge_index[(a,b)], edge_index[(a,c)], edge_index[(b,c)]))
            len(faces)
            
