            from functools import lru_cache
            
            def min_T_path(n):
                N = 2**n - 1
                nodes = set(range(1, N+1))
                powers = [2**k for k in range(n)]  # lengths up to 2^{n-1}
                # adjacency: from any node x (including 0) to y if |x-y| in powers
                adj = {}
                for x in [0] + list(nodes):
                    adj[x] = []
                    for p in powers:
                        for y in (x + p, x - p):
                            if y != x and 1 <= y <= N:
                                adj[x].append((y, p))
                # sort adjacency by descending length to prioritize large jumps
                for x in adj:
                    adj[x].sort(key=lambda tup: -tup[1])
                best_T = float('inf')
                best_seq = None
                visited = set()
                def dfs(cur, T, seq):
                    nonlocal best_T, best_seq
                    if T >= best_T:
                        return
                    if len(seq) == N:
                        # visited all nodes
                        best_T = T
                        best_seq = seq.copy()
                        print("found", best_T, best_seq[:10])
                        return
                    for (nbr, p) in adj[cur]:
                        if nbr not in visited:
                            visited.add(nbr)
                            seq.append(nbr)
                            dfs(nbr, T + 1/p, seq)
                            seq.pop()
                            visited.remove(nbr)
                visited.add(0)  # start at 0 but not counted as visited node
                dfs(0, 0.0, [])
                return best_T, best_seq
            
            best_T4, seq4 = min_T_path(4)
            print("best_T4", best_T4)
            
