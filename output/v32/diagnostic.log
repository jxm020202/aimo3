            from functools import lru_cache
            
            def min_T(n):
                N = 2**n
                lengths = [2**k for k in range(n)]
                weights = {l: 1/l for l in lengths}
                @lru_cache(None)
                def dfs(pos, mask):
                    if mask == (1<<N)-1:
                        return 0.0
                    best = float('inf')
                    for l in lengths:
                        for sign in (-1, 1):
                            nxt = pos + sign*l
                            if 0 <= nxt < N and not (mask >> nxt) & 1:
                                val = weights[l] + dfs(nxt, mask | (1<<nxt))
                                if val < best:
                                    best = val
                    return best
                start_mask = 1<<0
                return dfs(0, start_mask)
            
