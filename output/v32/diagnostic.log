                res = milp(c=-c, constraints=LinearConstraint(A, -np.inf*np.ones_like(b), b), bounds=bounds, integrality=np.ones(num_vars))
                if not res.success:
                    print("failed", n, res.message)
                    return None
                x = np.rint(res.x[:m]).astype(int)
                y = np.rint(res.x[m:]).astype(int)
                e = int(x.sum())
                p = int(y.sum())
                return e - p, (e,p)
            
            for n in range(3,9):
                print(n, max_e_minus_p_ilp(n))
            
