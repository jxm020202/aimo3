            # Convert to - (λ + ...) <= -c_j for linprog (which handles <=)
            A_ub = []
            b_ub = []
            for j in range(n):
                row = np.zeros(num_vars)
                # lambda coefficient -1 (since we move to left side)
                row[-1] = -1
                # u_{j-1} coefficient -1 (since we have - (u_{j-1})? Wait we have -(u_{j-1} - u_j) = -u_{j-1}+u_j
                # Actually constraint: λ + (u_{j-1} - u_j) + (v_j - v_{j-1}) >= c_j
                # Multiply by -1: -λ - (u_{j-1} - u_j) - (v_j - v_{j-1}) <= -c_j
                # => -λ - u_{j-1} + u_j - v_j + v_{j-1} <= -c_j
                # So coefficients:
                row[-1] = -1  # -λ
                row[j-1] = -1  # -u_{j-1}
                row[n + j] = 1   # +u_j
                row[n + ((j-1)%n)] = 1  # +v_{j-1}
                row[n + j] -= 1  # -v_j (but we already used u_j at same index; need separate)
            
