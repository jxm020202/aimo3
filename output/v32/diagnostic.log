            def min_fill_ordering(G):
                # G is a copy (undirected)
                G = G.copy()
                ordering = []
                while G.nodes():
                    # compute fill-in count for each node
                    best_node = None
                    best_fill = None
                    for v in G.nodes():
                        nbrs = list(G.neighbors(v))
                        # count missing edges among neighbors
                        missing = 0
                        for i in range(len(nbrs)):
                            for j in range(i+1, len(nbrs)):
                                if not G.has_edge(nbrs[i], nbrs[j]):
                                    missing += 1
                        if best_fill is None or missing < best_fill:
                            best_fill = missing
                            best_node = v
                    # add fill edges among neighbors
                    nbrs = list(G.neighbors(best_node))
                    for i in range(len(nbrs)):
                        for j in range(i+1, len(nbrs)):
                            if not G.has_edge(nbrs[i], nbrs[j]):
                                G.add_edge(nbrs[i], nbrs[j])
                    ordering.append(best_node)
                    G.remove_node(best_node)
                return ordering
            
            ordering = min_fill_ordering(L)
            ordering[:10], len(ordering)
            
