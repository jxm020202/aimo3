            import random, math, itertools, time, sys, numpy as np
            
            def min_adj_sum_grid(grid):
                m,n = grid.shape
                min_sum = 10**9
                for i in range(m):
                    for j in range(n):
                        if i+1 < m:
                            s = grid[i,j] + grid[i+1,j]
                            if s < min_sum:
                                min_sum = s
                        if j+1 < n:
                            s = grid[i,j] + grid[i,j+1]
                            if s < min_sum:
                                min_sum = s
                return min_sum
            
            def try_find(m,n,target,iterations=200000):
                N=m*n
                # start with some pattern: snake alternating low/high
                # We'll generate initial arrangement using simple pattern: fill rows left to right with numbers 1..N
                arr = np.arange(1,N+1).reshape(m,n)
                # maybe shuffle
                best = arr.copy()
                best_min = min_adj_sum_grid(best)
                if best_min >= target:
                    return best
                # random swaps
                start = time.time()
                for it in range(iterations):
                    # random swap two cells
                    i1,j1 = divmod(random.randrange(N), n)
                    i2,j2 = divmod(random.randrange(N), n)
                    if i1==i2 and j1==j2:
                        continue
                    # swap
                    arr[i1,j1], arr[i2,j2] = arr[i2,j2], arr[i1,j1]
                    cur_min = min_adj_sum_grid(arr)
                    if cur_min > best_min:
                        best_min = cur_min
