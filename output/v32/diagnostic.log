            def area_proj_mc(theta, Nsamples=200000):
                # Monte Carlo: sample points uniformly in torus and test if they are in projection
                # Equivalent to checking if there exists integer shift such that point lies in S.
                # Since S width <= sqrt(2), we only need to check shifts of -1,0,1 in each direction.
                # For each torus point (x,y), we can test if (x+dx, y+dy) lies in S for some dx,dy in {-1,0,1}.
                # We'll sample many torus points and compute fraction that are covered.
                pts = np.random.rand(Nsamples,2)
                # precompute rotation matrix
                c, s = math.cos(theta), math.sin(theta)
                # Inverse rotation to map point back to axis-aligned square coordinates
                # Condition: there exists (dx,dy) in {-1,0,1} such that after inverse rotation, the point lies within [-0.5,0.5]^2.
                # Inverse rotation matrix is transpose (since rotation).
                inv_rot = np.array([[c, s],[-s, c]])  # transpose
                covered = np.zeros(Nsamples, dtype=bool)
                shifts = [-1,0,1]
                for dx in shifts:
                    for dy in shifts:
                        shifted = pts + np.array([dx, dy])
                        # apply inverse rotation
                        uv = shifted @ inv_rot.T  # shape (Nsamples,2)
                        # check within square
                        inside = (np.abs(uv[:,0]) <= 0.5) & (np.abs(uv[:,1]) <= 0.5)
                        covered = covered | inside
                return covered.mean()
            
            for th in [0, math.pi/8, math.pi/6, math.pi/4]:
                print(th, area_proj_mc(th, Nsamples=200000))
            
