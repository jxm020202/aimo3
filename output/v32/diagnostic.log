            import sympy as sp
            
            def test_n(n):
                p = n+1
                if not sp.isprime(p):
                    return False
                # find primitive root
                g = sp.primitive_root(p)
                # define f(x) = g**x % p (but we need values 1..n)
                # We'll use x from 1..n inclusive
                f = {}
                for x in range(1, n+1):
                    f[x] = pow(g, x, p)
                    if f[x]==0:
                        return False
                # check bijection
                if len(set(f.values())) != n:
                    return False
                # verify condition
                for x in range(1, n+1):
                    y = (866*x) % n
                    if y==0:
                        y = n
                    # condition: (n+1) divides f(x)^866 - f(y)
                    if (pow(f[x], 866, p) - f[y]) % p != 0:
                        return False
                return True
            
            print(test_n(876))
            
