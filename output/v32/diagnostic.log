            def max_block_sum(n,m):
                # maximize sum of indices r, r+m, r+2m,... (n/m terms)
                # choose r=0 for simplicity
                c = np.zeros(n)
                block = [i for i in range(0,n,m)]
                c[block] = -1  # maximize sum => minimize negative
                # constraints
                A = []
                b = []
                for i in range(n):
                    row = np.zeros(n)
                    row[i] = 1
                    row[(i+1)%n] = -1
                    A.append(row); b.append(1)
                    row2 = np.zeros(n)
                    row2[i] = -1
                    row2[(i+1)%n] = 1
                    A.append(row2); b.append(1)
                A = np.array(A); b = np.array(b)
                A_eq = np.ones((1,n))
                b_eq = np.array([0.0])
                res = linprog(c, A_ub=A, b_ub=b, A_eq=A_eq, b_eq=b_eq, method='highs')
                return res.success, -res.fun, res.x
            
            print(max_block_sum(6,2))
            
