            import math, random, time, numpy as np
            
            def contains_lattice_point_fast(x, y, theta):
                # returns True if square contains any lattice point
                cos = math.cos(theta)
                sin = math.sin(theta)
                # compute A,B = rotated coordinates of (x,y)
                A = cos*x + sin*y
                B = -sin*x + cos*y
                # estimate lattice coordinates of (A,B)
                i_est = cos*A + sin*B
                j_est = -sin*A + cos*B
                i0 = math.floor(i_est)
                j0 = math.floor(j_est)
                # check candidates around (i0,j0)
                for di in range(-1, 2):
                    for dj in range(-1, 2):
                        i = i0 + di
                        j = j0 + dj
                        I = cos*i + sin*j
                        J = -sin*i + cos*j
                        if A <= I <= A+1 and B <= J <= B+1:
                            return True
                return False
            
            def estimate_p(N):
                cnt=0
                for _ in range(N):
                    theta = random.random()*math.pi/2
                    x = random.random()
                    y = random.random()
                    if not contains_lattice_point_fast(x,y,theta):
                        cnt+=1
                return cnt/N
            
            # test small
            print(estimate_p(10000))
            
