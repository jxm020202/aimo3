            def min_f_up_to_N(N):
                # generate sorted breakpoints: all k/n for n=1..N, k=0..n
                points = set([0.0, 1.0])
                for n in range(1, N+1):
                    for k in range(0, n+1):
                        points.add(k/n)
                sorted_pts = sorted(points)
                min_val = 1.0
                min_x = None
                # evaluate at midpoint of each interval (excluding last point 1)
                for i in range(len(sorted_pts)-1):
                    a = sorted_pts[i]
                    b = sorted_pts[i+1]
                    if b - a < 1e-12:
