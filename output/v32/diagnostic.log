            def upper_bound_S(n):
                N=n*n
                interior_cnt = max(0,(n-2)*(n-2))
                edge_cnt = max(0,4*(n-2))
                corner_cnt = 4 if n>=2 else n*n
                # assign numbers
                numbers = list(range(1,N+1))
                # assign largest to interior
                interior_numbers = numbers[-interior_cnt:] if interior_cnt>0 else []
                remaining = numbers[:N-interior_cnt]
                edge_numbers = remaining[-edge_cnt:] if edge_cnt>0 else []
                corner_numbers = remaining[:corner_cnt] if corner_cnt>0 else []
                T = 4*sum(interior_numbers) + 3*sum(edge_numbers) + 2*sum(corner_numbers)
                edges = n*(n-1)*2
                avg = T / edges
                return avg
            
