            def min_moves(n):
                start_bits = tuple(0 if i%2==0 else 1 for i in range(n))
                target_bits = tuple([1]*n)
                start = (start_bits, None)
                q = deque([(start,0)])
                visited = {start}
                while q:
                    (bits,pos),dist = q.popleft()
                    if bits == target_bits:
                        return dist
                    if pos is None:
                        for i in range(n):
                            newbits = list(bits)
                            newbits[i] ^= 1
                            newstate = (tuple(newbits), i)
                            if newstate not in visited:
                                visited.add(newstate)
                                q.append((newstate, dist+1))
                    else:
                        for i in (pos-1, pos+1):
                            if 0 <= i < n:
                                newbits = list(bits)
                                newbits[i] ^= 1
                                newstate = (tuple(newbits), i)
                                if newstate not in visited:
                                    visited.add(newstate)
                                    q.append((newstate, dist+1))
                return None
            
            for n in range(1,22,2):
                M=min_moves(n)
                print(n, M, M - (3*n//2))
            
