            def max_min_adjacent_sum_grid(n):
                N = n*n
                # create list of edges (u,v) as indices 0..N-1
                edges = []
                for i in range(n):
                    for j in range(n):
                        idx = i*n + j
                        if i+1 < n:
                            edges.append((idx, (i+1)*n + j))
                        if j+1 < n:
                            edges.append((idx, i*n + (j+1)))
                # binary search S
                low = 0
                high = 2*N  # max possible sum = (N)+(N-1) maybe 2N-1? Actually max sum of two numbers = N+(N-1) = 2N-1
                # but we can set high = 2*N
                best = 0
                while low <= high:
                    mid = (low+high)//2
                    # set up MILP feasibility for S=mid
                    # Variables: x_{v,k} for v in 0..N-1, k in 1..N (or 0..N-1 representing number k+1)
                    # Flatten index: var_index = v*N + (k-1)
                    num_vars = N*N
                    # Objective zero
                    c = np.zeros(num_vars)
                    # Constraints:
                    A_eq = []
                    b_eq = []
                    # each cell assigned exactly one number
                    for v in range(N):
                        row = np.zeros(num_vars)
                        for k in range(N):
                            row[v*N + k] = 1
                        A_eq.append(row)
                        b_eq.append(1)
                    # each number assigned to exactly one cell
                    for k in range(N):
                        row = np.zeros(num_vars)
                        for v in range(N):
                            row[v*N + k] = 1
                        A_eq.append(row)
                        b_eq.append(1)
                    # Edge constraints: sum_{k} (k+1) * x_{u,k} + sum_{k} (k+1) * x_{v,k} >= mid
                    A_ub = []
                    b_ub = []
                    # Convert >= to <= by multiplying -1
                    for (u,v) in edges:
                        row = np.zeros(num_vars)
                        for k in range(N):
                            row[u*N + k] = -(k+1)
                            row[v*N + k] = -(k+1)
                        A_ub.append(row)
                        b_ub.append(-mid)
                    # Build LinearConstraint objects
                    # Equality constraints
                    A_eq = np.array(A_eq)
                    b_eq = np.array(b_eq)
                    # Inequality constraints (<=)
                    A_ub = np.array(A_ub)
                    b_ub = np.array(b_ub)
                    # Build constraints
                    lin_con = LinearConstraint(np.vstack([A_eq, A_ub]), 
                                                np.hstack([b_eq, -np.inf*np.ones_like(b_ub)]), 
                                                np.hstack([b_eq, b_ub]))
                    # Actually LinearConstraint expects lower and upper bounds arrays.
                    # We'll combine equality constraints as both lower=upper=b_eq.
                    # Simpler: Use milp's constraints argument as list of LinearConstraint? Let's check doc.
            
