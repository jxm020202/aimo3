                # For each G1, compute D = |E1| - |F| where F forced edges.
                # Enumerate all triangle-free graphs via edge subsets.
                # For n up to maybe 7, edges count = n*(n-1)//2 <= 21, subsets 2^21 ~2 million, manageable.
                from itertools import combinations
                vertices = list(range(n))
                edges = list(combinations(vertices,2))
                m = len(edges)
                maxD = -10**9
                best = None
                # iterate subsets using bitmask
                for mask in range(1<<m):
                    # quick prune: we can compute degrees and check triangle-free.
