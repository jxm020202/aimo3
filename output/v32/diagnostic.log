            import cmath, math, itertools
            
            def max_m_for_set(rlist, max_i=10):
                # returns max m such that product=1 for i=1..m
                for m in range(1, max_i+1):
                    prod = 1+0j
                    for r in rlist:
                        prod *= (r**m + 1)
                    if abs(prod-1) > 1e-6:
                        return m-1
                return max_i
            
            def search_two(max_order=11, max_i=10):
                roots = []
                for N in range(3, max_order+1, 2):  # odd orders
                    for k in range(1,N):
                        roots.append(cmath.exp(2j*math.pi*k/N))
                best = 0
                best_pair = None
                for r1, r2 in itertools.combinations(roots,2):
                    m = max_m_for_set([r1,r2], max_i)
                    if m > best:
                        best = m
                        best_pair = (r1,r2)
                return best, best_pair
            
            best, pair = search_two(11, 10)
            print(best)
            
