            def min_missing(t, max_val=200):
                # generate all sums of exactly t terms (allow repeats)
                # each term is +/- 2^b, b up to some limit
                # We'll limit exponent up to maybe 10 for small t.
                max_exp=10
                values=set()
                # generate all combos using recursion
                from itertools import product
                signs = [-1,1]
                for exps in product(range(max_exp+1), repeat=t):
                    # compute sum of signs*2^exp with all sign combos
                    # but we also need sign choices
                    # We'll iterate over sign combos as well
                    for sgns in product(signs, repeat=t):
                        s = sum(sgns[i]* (1<<exps[i]) for i in range(t))
                        if s>0:
                            values.add(s)
                # find minimal missing positive integer up to max_val
                for n in range(1, max_val+1):
                    if n not in values:
                        return n
                return None
            
            print(min_missing(1, max_val=20))
            print(min_missing(2, max_val=200))
            
