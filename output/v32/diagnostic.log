            import networkx as nx
            
            def has_conjugacy(n):
                mod = n+1
                # define g
                g_map = {}
                for x in range(1, n+1):
                    y = (866*x) % n
                    if y == 0:
                        y = n
                    g_map[x] = y
                # define e
                e_map = {}
                for a in range(1, n+1):
                    e_map[a] = pow(a, 866, mod)
                    if e_map[a]==0:
                        # zero not in set, treat as invalid (since map must stay within 1..n)
                        # But if e_map[a]==0, then e_map maps outside set, cannot be conjugate.
                        return False
                # Build directed graphs with edges x->g(x) and a->e(a)
                G = nx.DiGraph()
                G.add_nodes_from(range(1, n+1))
                G.add_edges_from([(x, g_map[x]) for x in range(1, n+1)])
                E = nx.DiGraph()
                E.add_nodes_from(range(1, n+1))
                E.add_edges_from([(a, e_map[a]) for a in range(1, n+1)])
                # Use DiGraphMatcher for isomorphism (preserving edge direction)
                matcher = nx.algorithms.isomorphism.DiGraphMatcher(G, E)
                return matcher.is_isomorphic()
            
            for n in range(866, 876):
                print(n, has_conjugacy(n))
            
