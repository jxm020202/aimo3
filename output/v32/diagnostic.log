                        return prefix_sum == T
                    # remaining positions
                    remaining = n - idx
                    # minimal possible sum for remaining numbers
                    min_rem = min_sum_remaining(remaining, prev)
                    # maximal possible sum? Not needed but we can compute max possible if we set huge numbers, but we have total sum constraint.
                    # The sum of all numbers must be T, so we need prefix_sum + min_rem <= T
                    if prefix_sum + min_rem > T:
