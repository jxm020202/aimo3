            import itertools, math, sys, random, time, collections, itertools, math, functools, fractions, sys, time, math, itertools
            def optimal_average(n):
                # edges index mapping
                vertices = list(range(n))
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # Use ILP via brute force for n <= 6 maybe
                best = None
                best_assign = None
                # iterate all assignments of 1,2,3? that's 3^m huge. For n=5, m=10, 3^10=59049 manageable.
                # for n=6, m=15, 3^15=14 million maybe heavy but okay with pruning maybe.
                # We'll just brute for n up to 5 for now.
                for assign in itertools.product([1,2,3], repeat=m):
                    total = sum(assign)
                    if best is not None and total >= best:
                        continue
                    # check triangles
                    ok = True
                    # map edge to label
                    label = {}
                    for (e,l) in zip(edges, assign):
                        label[e]=l
                    for a in range(n):
                        for b in range(a+1,n):
                            for c in range(b+1,n):
                                s = label[(a,b)] + label[(a,c)] + label[(b,c)]
                                if s < 5:
                                    ok=False
                                    break
                            if not ok:
                                break
                        if not ok:
                            break
                    if ok:
                        best = total
                        best_assign = assign
                return best, best_assign
            
            for n in range(3,6):
                best,total_assign = optimal_average(n)
                E = n*(n-1)//2
                avg = fractions.Fraction(best, E)
                print(n, best, E, avg)
            
