            def max_matching_size(board_size=15):
                n = board_size
                G = nx.Graph()
                # add nodes as integers 0..n*n-1
                for i in range(n):
                    for j in range(n):
                        node = i*n + j
                        G.add_node(node)
                # add edges for Chebyshev distance <=2 and >0
                for i in range(n):
                    for j in range(n):
                        node = i*n + j
                        for di in range(-2,3):
                            for dj in range(-2,3):
                                if di==0 and dj==0:
                                    continue
                                ii, jj = i+di, j+dj
                                if 0 <= ii < n and 0 <= jj < n:
                                    neighbor = ii*n + jj
                                    if node < neighbor:  # avoid duplicate
                                        G.add_edge(node, neighbor)
                matching = nx.max_weight_matching(G, maxcardinality=True)
                # matching is set of edges (tuples)
                size = len(matching)
                return size, matching
            
            size, matching = max_matching_size()
            size
            
