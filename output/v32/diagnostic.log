            def intersection_polygon(constraints):
                # constraints: list of (a,b,c) meaning a*x + b*y <= c
                # returns list of vertices of convex polygon (may be empty)
                pts = []
                n = len(constraints)
                for i in range(n):
                    a1,b1,c1 = constraints[i]
                    for j in range(i+1, n):
                        a2,b2,c2 = constraints[j]
                        det = a1*b2 - a2*b1
                        if abs(det) < 1e-12:
                            continue
                        x = (c1*b2 - c2*b1)/det
                        y = (a1*c2 - a2*c1)/det
                        # check all constraints
