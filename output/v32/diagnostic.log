                    x = dx_flat - sx
                    y = dy_flat - sy
                    # rotate by -theta to test inside axis-aligned square
                    xr = cos*x + sin*y
                    yr = -sin*x + cos*y
                    inside = (np.abs(xr) <= 0.5) & (np.abs(yr) <= 0.5)
                    inside_any |= inside
                allowed = (~inside_any).sum()
                area = allowed / (resolution**2)  # proportion of unit area D
