                ys = np.linspace(-0.5, 0.5, resolution)
                dx, dy = np.meshgrid(xs, ys, indexing='ij')
                # flatten
                dx_flat = dx.ravel()
                dy_flat = dy.ravel()
                cos = math.cos(theta)
                sin = math.sin(theta)
                # For each point, check if inside any Q_i (i.e., (dx,dy) is such that vertex (dx+0.5, dy+0.5) inside S_theta etc.)
                # Equivalent to check if point (dx,dy) lies within Q_i = S_theta shifted by (-0.5,-0.5) etc.
                # We'll compute for each sign combination
                inside_any = np.zeros_like(dx_flat, dtype=bool)
                for sx, sy in [(-0.5, -0.5), (0.5, -0.5), (-0.5, 0.5), (0.5, 0.5)]:
