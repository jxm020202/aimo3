                for bits in range(1<<n):
                    if bits & (bits<<1):
                        continue
                    states.append(bits)
                # compatibility: no vertical or diagonal adjacency
                compat = {}
                for s in states:
                    comp = []
                    for t in states:
                        if s & t:  # same column
                            continue
                        if s & (t<<1):  # s column j, t column j-1 (t shifted left)
                            continue
                        if s & (t>>1):
                            continue
                        comp.append(t)
                    compat[s] = comp
                dp = {s:1 for s in states}
                for _ in range(1,n):
                    newdp = {s:0 for s in states}
                    for s in states:
                        total = sum(dp[t] for t in compat[s])
                        newdp[s] = total
                    dp = newdp
                return sum(dp.values())
            
