            def point_in_rotated_square(px, py, theta):
                # square centered at origin, side 1, rotated by theta
                # transform point by inverse rotation
                c, s = math.cos(theta), math.sin(theta)
                # rotate point by -theta
                x = c*px + s*py
                y = -s*px + c*py
                return abs(x) <= 0.5 + 1e-12 and abs(y) <= 0.5 + 1e-12
            
