            import numpy as np, math, random, itertools, sys, time, mpmath as mp
            
            def E_three(B,T,m):
                C = (B**2 + T**2)/4 + m**2
                A = T - B
                return (A**2)*(9*C - 1)/(C**3)
            
            def feasible(B,T,m):
                # ordering constraints
                return (B/4 <= m <= T/4) and abs(B+T+m-1) < 1e-9
            
            # We'll sample random B,T,m satisfying constraints
            def random_search_three(N=200000):
                best = -1
                best_tuple = None
                for _ in range(N):
                    # sample B,T,m maybe from uniform range [-1,1]
                    B = random.uniform(-1,1)
                    T = random.uniform(-1,1)
                    m = 1 - B - T  # enforce sum constraint exactly
                    # Now check ordering constraints
                    if B/4 <= m <= T/4:
                        val = E_three(B,T,m)
                        if val > best:
                            best = val
                            best_tuple = (B,T,m)
                return best, best_tuple
            
            best, tup = random_search_three(2000000)
            best, tup
            
