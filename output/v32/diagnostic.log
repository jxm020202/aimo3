                            proj1 = tuple(assign_dict[v] for v in new_scope)
                            val1 = new_table[proj1]
                            # for factor2
                            proj2 = tuple(assign_dict[v] for v in scope2)
                            val2 = table2[proj2]
                            new_table2[assign] = val1 * val2
                        new_scope, new_table = union_scope, new_table2
                    # sum out var
                    # new_scope includes var; we need to produce factor without var
                    if len(new_scope) == 1:
                        # after summing out, factor becomes scalar
                        total = sum(new_table[assign] for assign in new_table)
                        # replace all factors with scalar factor (empty scope)
                        # We'll keep scalar as a factor with empty scope
                        new_factors = [((), {(): total})]
                    else:
                        # create new factor without var
                        remaining_scope = tuple(v for v in new_scope if v != var)
                        new_table2 = {}
                        # iterate over assignments to remaining_scope
                        for assign in itertools.product(range(3), repeat=len(remaining_scope)):
                            total = 0
                            for val in range(3):
                                # build full assignment
                                full_assign = list(assign)
                                # need to insert val at appropriate position for var
                                # Build dict for remaining vars
                                assign_dict = dict(zip(remaining_scope, assign))
                                assign_dict[var] = val
                                # order according to new_scope
                                full_tuple = tuple(assign_dict[v] for v in new_scope)
                                total += new_table[full_tuple]
                            new_table2[assign] = total
                        new_factors = [(remaining_scope, new_table2)]
                    # remove old factors (in reverse order)
                    for idx in sorted(containing, reverse=True):
                        del factors[idx]
                    # add new factor(s)
                    factors.extend(new_factors)
                # after eliminating all vars, we should have a single scalar factor
                assert len(factors) == 1
                scope, table = factors[0]
                assert scope == ()
                return table[()]
