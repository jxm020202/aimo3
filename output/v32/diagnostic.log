            import sympy as sp, random, math, itertools, numpy as np, sys, time, math, itertools, collections, statistics, fractions, decimal, heapq, functools, random, mpmath as mp
            def max_E_pr_analytic(p, r):
                q = 9 - p - r
                a, c = sp.symbols('a c', real=True)
                b = (1 - p*a - r*c)/q
                A = p*(b - a) + r*(c - b)
                C = p*a**2 + q*b**2 + r*c**2
                E = sp.simplify(A**2 * (9*C - 1) / C**3)
                # compute partial derivatives
                dEa = sp.diff(E, a)
                dEc = sp.diff(E, c)
                # solve for critical points (excluding boundaries)
                # Use nsolve with multiple starting points
                sols = set()
                for start in [(-0.1,0.2), (-0.5,0.5), (0.0,0.2), (-0.2,0.5), (-0.2,0.1), (-0.5,0.2)]:
                    try:
                        sol = sp.nsolve([dEa, dEc], [a, c], start, tol=1e-14, maxsteps=100)
                        sol = (float(sol[0]), float(sol[1]))
                        sols.add(tuple([round(sol[0],12), round(sol[1],12)]))
                    except Exception as e:
                        pass
                # evaluate E at each solution and also consider boundary cases where a=b or b=c etc.
                candidates = []
                for (aa, cc) in sols:
                    bb = (1 - p*aa - r*cc)/q
                    if aa <= bb <= cc:
                        candidates.append((float(E.subs({a:aa, c:cc})), (aa, bb, cc)))
                # also evaluate boundary a=b (i.e., a = b) case: leads to 5a + r c = 1? Wait a=b => p a + q a + r c = 1 => (p+q) a + r c = 1 => (9 - r) a + r c = 1.
                # We'll compute analytically later.
                return candidates
            
            for p,r in [(4,4),(4,3),(3,4),(2,4),(4,2)]:
                cand = max_E_pr_analytic(p,r)
                print(p,r,cand[:3])
            
