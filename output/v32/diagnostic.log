            def greedy_random(n):
                vertices=list(range(n))
                all_edges=[(i,j) for i in range(n) for j in range(i+1,n)]
                random.shuffle(all_edges)
                adj=[set() for _ in range(n)]
                edges=set()
                for u,v in all_edges:
                    # check if there exists w such that w adjacent to both u and v
                    if adj[u].intersection(adj[v]):
                        continue  # would create triangle
                    # safe to add
                    edges.add((u,v))
                    adj[u].add(v)
                    adj[v].add(u)
                D=compute_D(edges,n)
                return D, len(edges)
            
