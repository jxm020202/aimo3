            def E_from_ac(a,c):
                b = 1 - 4*a - 4*c
                # check ordering constraints
                if not (a <= b <= c):
                    return None
                S2 = 4*a*a + b*b + 4*c*c
                if S2 == 0:
                    return None
                return 16*(c - a)**2 * (9*S2 - 1) / (S2**3)
            
            def random_search_ac(N=2000000):
                best = -1
                best_ac = None
                for _ in range(N):
                    # sample a,c within some range
                    # we can sample a uniformly from -1 to 1, c from -1 to 1, then check constraints
                    a = random.uniform(-1, 1)
                    c = random.uniform(-1, 1)
                    val = E_from_ac(a,c)
                    if val is not None and val > best:
                        best = val
                        best_ac = (a,c)
                return best, best_ac
            
            best, best_ac = random_search_ac(2000000)
            best, best_ac
