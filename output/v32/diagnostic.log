            def indegree_distribution_T(n):
                d = math.gcd(866, n)
                # T(x) = (866*x) % n, with 0 -> n
                indeg = [0]*(n+1)  # 1-indexed
                for x in range(1, n+1):
                    y = (866*x) % n
                    if y == 0:
                        y = n
                    indeg[y] += 1
                # return dict of indegree counts (excluding index 0)
                cnt = collections.Counter(indeg[1:])
                return cnt, indeg[1:]
            
            def indegree_distribution_S(n):
                m = n+1
                indeg = [0]*(n+1)  # index 1..n
                for a in range(1, n+1):
                    b = pow(a, 866, m)
                    if b == 0:
                        # maps to n+1, which is not allowed
                        # we can treat as invalid
                        return None, None
                    indeg[b-1] += 1  # b in 1..n, index b-1
                cnt = collections.Counter(indeg)
                return cnt, indeg
            
            def test_n(n):
                cntT, indegT = indegree_distribution_T(n)
                cntS, indegS = indegree_distribution_S(n)
                if cntS is None:
                    return False, "S maps to 0"
                # compare distributions
                # need that indeg sets are same multiset after some permutation?
                # For isomorphism, we need same multiset of indegrees.
                # Let's compare sorted indegree lists
                return sorted(indegT) == sorted(indegS), (cntT, cntS)
            
            for n in range(866, 900):
                ok, info = test_n(n)
                if ok:
                    print("found", n)
            
