                # check exponentiation map a->a^k mod m is permutation on 1..m-1 (non-zero)
                seen=set()
                for a in range(1,m):
                    r=pow(a,k,m)
                    if r==0: return False
                    if r in seen: return False
                    seen.add(r)
                return True
            
            def list_perm_exp(k,limit=200):
                return [m for m in range(2,limit+1) if is_perm_exp(m,k)]
            
