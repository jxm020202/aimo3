            def min_nk(m, k_target):
                n = 2**m
                adj = {v: [v ^ (1<<k) for k in range(m)] for v in range(n)}
                best = None
                best_counts = None
                visited = [False]*n
                visited[0] = True
                path = [0]
                def dfs(v, counts):
                    nonlocal best, best_counts
                    if len(path) == n:
                        # evaluate
                        n_k = counts.get(k_target,0)
                        if best is None or n_k < best:
                            best = n_k
                            best_counts = counts.copy()
                        return
                    for nb in adj[v]:
                        if visited[nb]:
                            continue
                        diff = v ^ nb
                        k = diff.bit_length()-1
                        # prune if already worse
                        if best is not None and counts.get(k_target,0) >= best:
                            continue
                        visited[nb] = True
                        path.append(nb)
                        counts[k] = counts.get(k,0)+1
                        dfs(nb, counts)
                        counts[k] -= 1
                        if counts[k]==0:
                            del counts[k]
                        path.pop()
                        visited[nb] = False
                dfs(0, {})
                return best, best_counts
            
            for m in range(2,5):
                for k in range(m):
                    best_nk, cnt = min_nk(m, k)
                    print(f"m={m}, k={k}, min n_k={best_nk}")
            
