            import random, itertools, math, time
            
            def random_graph(n, p):
                adj = [set() for _ in range(n)]
                for i in range(n):
                    for j in range(i+1, n):
                        if random.random() < p:
                            adj[i].add(j); adj[j].add(i)
                return adj
            
            def private_condition(adj):
                n=len(adj)
                for u in range(n):
                    if not any(adj[u].isdisjoint(adj[v]) for v in adj[u]):
                        return False
                return True
            
            def edge_count(adj):
                return sum(len(nei) for nei in adj)//2
            
            def improve_graph(n, target_edges):
                # start with complete bipartite K_{a,b}
                a = n//2
                b = n - a
                # assign vertices 0..a-1 in part A, a..n-1 in part B
                adj = [set() for _ in range(n)]
                for i in range(a):
                    for j in range(a, n):
                        adj[i].add(j); adj[j].add(i)
                # now try to add extra edges while maintaining condition, maybe removing some edges
                # simple hill climbing: try random edge addition (or swap) if condition holds and edge count increases
                best = edge_count(adj)
                best_adj = [s.copy() for s in adj]
                start = time.time()
                while time.time() - start < 5:  # 5 seconds search
                    # pick random pair (i,j) not currently edge
                    i,j = random.sample(range(n),2)
                    if j in adj[i]:
                        continue
                    # try adding edge
                    adj[i].add(j); adj[j].add(i)
                    if private_condition(adj):
                        cnt = edge_count(adj)
                        if cnt > best:
                            best = cnt
                            best_adj = [s.copy() for s in adj]
                            # print progress
                            #print("new best", best)
                    else:
                        # revert
                        adj[i].remove(j); adj[j].remove(i)
                    # occasionally random restart
                    if random.random() < 0.001:
                        adj = [set() for _ in range(n)]
                        for i in range(a):
                            for j in range(a, n):
                                adj[i].add(j); adj[j].add(i)
                return best, best_adj
            
            best10, adj10 = improve_graph(10, 30)
            print("best10", best10)
            
