            def interval_for_prefix(bits):
                # bits list of 0/1 for n=1..len(bits)
                # compute interval of x in [0,1) such that floor(n*x) parity matches bits
                # For each n, we have constraints:
                # If bits[n-1]==1 (even), then floor(n*x) ∈ even integers.
                # So n*x ∈ [2k, 2k+1) for some integer k.
                # If bits[n-1]==0 (odd), then n*x ∈ [2k+1, 2k+2) for some integer k.
                # This gives constraints on x: x ∈ [ (2k)/n, (2k+1)/n ) for even case, or [ (2k+1)/n, (2k+2)/n ) for odd case.
                # For each n, we need to take union over k of those intervals.
                # Intersection across n yields feasible set.
                # We'll compute as rational intervals using fractions.
                from fractions import Fraction
                feasible = [(Fraction(0), Fraction(1))]  # list of intervals (inclusive left, exclusive right)
                for n, bit in enumerate(bits, start=1):
                    new_intervals = []
                    # For each possible k, generate interval within [0,1)
                    # k ranges from 0 up to floor(n*1)/2 maybe.
                    max_k = n  # safe bound
                    for k in range(0, max_k+2):
                        if bit == 1:
                            # even: interval [2k/n, (2k+1)/n)
                            left = Fraction(2*k, n)
                            right = Fraction(2*k+1, n)
                        else:
                            # odd: interval [(2k+1)/n, (2k+2)/n)
                            left = Fraction(2*k+1, n)
                            right = Fraction(2*k+2, n)
                        # intersect with [0,1)
                        if left >= 1 or right <= 0:
                            continue
                        left = max(left, Fraction(0))
                        right = min(right, Fraction(1))
                        if left >= right:
                            continue
                        # intersect with each existing feasible interval
                        for (L,R) in feasible:
                            inter_left = max(L, left)
                            inter_right = min(R, right)
                            if inter_left < inter_right:
                                new_intervals.append((inter_left, inter_right))
                    feasible = new_intervals
                    if not feasible:
                        return []  # empty
                return feasible
            
            bits_100 = [1,0,0]*10  # first 30 bits pattern 100
            intervals = interval_for_prefix(bits_100)
            len(intervals), intervals[:5]
            
