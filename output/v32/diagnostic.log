            def upper_bound_n(n):
                N=n*n
                # compute degrees list
                degs=[]
                for i in range(n):
                    for j in range(n):
                        deg=4
                        if i==0 or i==n-1: deg-=1
                        if j==0 or j==n-1: deg-=1
                        degs.append(deg)
                # sort descending for max sum
                degs.sort(reverse=True)
                # assign largest numbers to highest degrees
                total=0
                label=N
                for d in degs:
                    total+=d*label
                    label-=1
                edges = n*(n-1)*2
                return total//edges
            
