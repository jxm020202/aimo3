            from scipy.optimize import milp, LinearConstraint, Bounds
            
            n=12
            # variable ordering: first a_ij (n*n), then w_ikj (n*n*n)
            num_a = n*n
            num_w = n*n*n
            total_vars = num_a + num_w
            
            # objective: zero vector
            c = np.zeros(total_vars)
            
            # constraints list
            A_eq = []
            b_eq = []
            
            # Row sum constraints: sum_j a_ij = 6
            for i in range(n):
                row = np.zeros(total_vars)
                for j in range(n):
                    idx = i*n + j
                    row[idx] = 1
                A_eq.append(row)
                b_eq.append(6)
            
            # For each i,j: sum_k w_ikj = 6*(1 - a_ij)
            for i in range(n):
                for j in range(n):
                    row = np.zeros(total_vars)
                    # sum_k w_ikj
                    for k in range(n):
                        w_idx = num_a + (i*n*n + k*n + j)  # mapping: i*(n*n) + k*n + j
                        row[w_idx] = 1
                    # -6 * a_ij term on RHS: bring to LHS: -6*a_ij
                    a_idx = i*n + j
                    row[a_idx] = -6
                    A_eq.append(row)
                    b_eq.append(6)  # because RHS = 6*(1 - a_ij) => 6 - 6*a_ij => bring -6*a_ij left, constant 6
            
            # Build LinearConstraint
            A_eq = np.array(A_eq)
            b_eq = np.array(b_eq)
            
            # Inequality constraints for w <= a etc.
            A_ub = []
            b_ub = []
            
            # w_ikj <= a_ik
            for i in range(n):
                for k in range(n):
                    for j in range(n):
                        row = np.zeros(total_vars)
                        w_idx = num_a + (i*n*n + k*n + j)
                        a_idx = i*n + k
                        row[w_idx] = 1
                        row[a_idx] = -1
                        A_ub.append(row)
                        b_ub.append(0)
            
            # w_ikj <= a_kj
            for i in range(n):
                for k in range(n):
                    for j in range(n):
                        row = np.zeros(total_vars)
                        w_idx = num_a + (i*n*n + k*n + j)
                        a_idx = k*n + j
                        row[w_idx] = 1
                        row[a_idx] = -1
                        A_ub.append(row)
                        b_ub.append(0)
            
            # w_ikj >= a_ik + a_kj -1 => -w <= -(a_ik + a_kj -1) => -w + a_ik + a_kj <= 1
            for i in range(n):
                for k in range(n):
                    for j in range(n):
                        row = np.zeros(total_vars)
                        w_idx = num_a + (i*n*n + k*n + j)
                        a_idx1 = i*n + k
                        a_idx2 = k*n + j
                        row[w_idx] = -1
                        row[a_idx1] = 1
                        row[a_idx2] = 1
                        A_ub.append(row)
                        b_ub.append(1)
            
            A_ub = np.array(A_ub)
            b_ub = np.array(b_ub)
            
            # Bounds: all variables binary
            lb = np.zeros(total_vars)
            ub = np.ones(total_vars)
            
            integrality = np.ones(total_vars)
            
            # Solve MILP
            res = milp(c=c,
                       constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                                    LinearConstraint(A_ub, -np.inf*np.ones_like(b_ub), b_ub)],
                       bounds=Bounds(lb, ub),
                       integrality=integrality,
                       options={'presolve': True, 'disp': False})
            print(res.success)
            
