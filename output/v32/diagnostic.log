            def count_colorings_fc():
                n_edges = len(edges)
                # adjacency: edge -> vertices
                edge_vertices = [edges[i] for i in range(n_edges)]
                # vertex -> incident edges
                vertex_edges = {v: [] for v in G.nodes()}
                for idx, (u,v) in enumerate(edges):
                    vertex_edges[u].append(idx)
                    vertex_edges[v].append(idx)
                # state
                colors = [-1]*n_edges
                # for each vertex, list of assigned colors
                assigned = [[] for _ in range(20)]
                # allowed colors per edge (set of possible colors)
                allowed = [set([0,1,2]) for _ in range(n_edges)]
                count = 0
                # order selection: choose edge with smallest allowed size >0
                def select_edge():
                    # return index of unassigned edge with smallest allowed set size
                    best = None
                    bestsize = 10
                    for i in range(n_edges):
                        if colors[i]==-1:
                            sz = len(allowed[i])
                            if sz < bestsize:
                                bestsize = sz
                                best = i
                                if sz == 1:
                                    break
                    return best
                def backtrack():
                    nonlocal count
                    # check if all assigned
                    if all(c != -1 for c in colors):
                        # all constraints satisfied automatically
                        count += 1
                        return
                    e = select_edge()
                    # copy allowed for restoration
                    # iterate over allowed colors
                    for col in list(allowed[e]):  # list to avoid modification during iteration
                        # assign
                        colors[e] = col
                        u,v = edge_vertices[e]
                        assigned[u].append(col)
                        assigned[v].append(col)
                        # Save modifications to allowed sets to revert later
                        saved = []
                        consistent = True
                        # For each vertex u and v, update constraints on its remaining edge(s)
                        for vert in (u,v):
                            # if vertex now has 3 assigned, check condition
                            if len(assigned[vert]) == 3:
                                s = set(assigned[vert])
                                if len(s)!=2:
                                    consistent = False
                                    break
                            elif len(assigned[vert]) == 2:
                                # determine allowed colors for the remaining edge
                                colors_assigned = assigned[vert]
                                if colors_assigned[0]==colors_assigned[1]:
                                    # two same, remaining must be different
                                    allowed_colors = {c for c in [0,1,2] if c != colors_assigned[0]}
                                else:
                                    # two distinct, remaining must be one of those two
                                    allowed_colors = set(colors_assigned)
                                # find the remaining edge index (unassigned)
                                for e2 in vertex_edges[vert]:
                                    if colors[e2]==-1:
                                        # intersect allowed[e2] with allowed_colors
                                        old = allowed[e2].copy()
                                        new = old & allowed_colors
                                        if not new:
                                            consistent = False
                                            break
                                        if new != old:
                                            saved.append((e2, old))
                                            allowed[e2] = new
                                if not consistent:
                                    break
                            # else len 1: no constraint yet
                        if consistent:
                            backtrack()
                        # restore
                        for e2, old in saved:
                            allowed[e2] = old
                        # undo assignment
                        assigned[u].pop()
                        assigned[v].pop()
                        colors[e] = -1
                    # end for
                backtrack()
                return count
            
            start = time.time()
            cnt = count_colorings_fc()
            print("count:", cnt, "time:", time.time()-start)
            
