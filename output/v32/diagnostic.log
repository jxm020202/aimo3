            import itertools, numpy as np
            
            def count_n(n):
                half=n//2
                rows = list(itertools.combinations(range(n), half))
                # each row is a tuple of positions of 1's
                # generate all matrices
                count=0
                for rows_choice in itertools.product(rows, repeat=n):
                    A=np.zeros((n,n),int)
                    for i,row in enumerate(rows_choice):
                        for j in row:
                            A[i,j]=1
                    # check condition
                    if np.array_equal(A.dot(A)+half*A, half*np.ones((n,n),int)):
                        count+=1
                return count
            
