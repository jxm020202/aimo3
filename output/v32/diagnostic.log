            def contains_integer_point(cx, cy, theta):
                # square centered at (cx, cy), side length 1, rotated by theta (radians)
                # compute vertices
                # half-diagonal length
                h = 0.5 * math.sqrt(2)  # half diagonal = side/sqrt(2)?? Wait side=1, diagonal = sqrt(2), half diagonal = sqrt(2)/2
                # Actually half-diagonal = sqrt(2)/2
                h = math.sqrt(2)/2
                # direction angles for vertices: theta + pi/4 + k*pi/2
                verts = []
                for k in range(4):
                    ang = theta + math.pi/4 + k*math.pi/2
                    vx = cx + h * math.cos(ang)
                    vy = cy + h * math.sin(ang)
                    verts.append((vx, vy))
                # Determine bounding box
                xs = [v[0] for v in verts]
                ys = [v[1] for v in verts]
                minx, maxx = min(xs), max(xs)
                miny, maxy = min(ys), max(ys)
                # integer points to test: floor(minx) to ceil(maxx)
                ix_min = math.floor(minx)
                ix_max = math.ceil(maxx)
                iy_min = math.floor(miny)
                iy_max = math.ceil(maxy)
                # Use winding number or point-in-polygon test for convex polygon (square)
                # For each integer point in bounding box, test if inside or on edge.
                # Use barycentric: check if point can be expressed as convex combination of vertices.
                # Simpler: use shapely? not available. Use cross product sign test for convex polygon.
                def point_in_polygon(px, py):
                    # For convex polygon given in order (verts)
                    # Compute orientation of each edge with point; all must have same sign (or zero)
                    sign = None
                    n = len(verts)
                    for i in range(n):
                        x1, y1 = verts[i]
                        x2, y2 = verts[(i+1)%n]
                        # cross product (x2-x1, y2-y1) x (px-x1, py-y1)
                        cross = (x2 - x1)*(py - y1) - (y2 - y1)*(px - x1)
                        if abs(cross) < 1e-12:
                            # on edge considered inside
                            continue
                        if sign is None:
                            sign = 1 if cross > 0 else -1
                        else:
                            if (cross > 0 and sign < 0) or (cross < 0 and sign > 0):
                                return False
                    return True
                for ix in range(ix_min, ix_max+1):
                    for iy in range(iy_min, iy_max+1):
                        if point_in_polygon(ix, iy):
                            return True
                return False
            
