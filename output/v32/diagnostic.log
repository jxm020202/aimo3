                        b = min(new_prefix, T - new_prefix)
                        new_max_b = max(max_b, b)
                        if new_max_b > limit:
                            continue
                        if dfs(idx+1, a, new_prefix, new_max_b):
                            return True
                    return False
                
                return dfs(0, 0, 0, 0)
            
