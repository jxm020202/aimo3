            from functools import lru_cache
            
            @lru_cache(maxsize=None)
            def D_rec(n):
                if n==0:
                    return 1
                # compute recursively
                a = D_rec(n//5)
                b = [1,1,2,6,4][n%5]  # D of small remainder
                c = pow(2, n//5, 10)
                return (a * b * c) % 10
            
            def D(n):
                return D_rec(n)
            
