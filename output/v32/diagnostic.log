            def min_f_dp_optimized(n=2025, total_inc=198):
                m = n-1  # number of d_i
                max_inc = total_inc
                INF = 10**12
                # dp[prev][used] = min cost after processing i-1 (i index of next d to choose)
                dp = np.full((max_inc+1, max_inc+1), INF, dtype=np.int64)
                # initialize for d1
                for d1 in range(total_inc+1):
                    used = d1
                    dp[d1, used] = (1 + d1)**2
                # iterate for i = 2..m
                for i in range(2, m+1):
                    new_dp = np.full((max_inc+1, max_inc+1), INF, dtype=np.int64)
                    # For each prev value
                    for prev in range(max_inc+1):
                        # get row dp[prev, :]
                        dp_row = dp[prev]
                        # find used values where cost finite
                        # we can iterate over used where dp_row[used] < INF
                        # use np.where
                        used_idxs = np.where(dp_row < INF)[0]
                        if used_idxs.size == 0:
                            continue
                        for used in used_idxs:
                            base_cost = dp_row[used]
                            remaining = total_inc - used
                            # iterate cur from 0..remaining
                            # vectorize cur loop
                            cur_vals = np.arange(remaining+1, dtype=np.int64)
                            new_used = used + cur_vals
                            # compute cost addition
                            add = (prev + cur_vals)**2
                            total_cost = base_cost + add
                            # update new_dp[cur][new_used] = min
                            # use fancy indexing
                            cur_indices = cur_vals
                            # For each cur, update
                            for cur, nu, tc in zip(cur_indices, new_used, total_cost):
                                if tc < new_dp[cur, nu]:
                                    new_dp[cur, nu] = tc
                    dp = new_dp
                    # optional progress
                    if i % 200 == 0:
                        print("i", i, "states", np.count_nonzero(dp < INF))
                # after processing all d_i (i=m)
                best = INF
                for prev in range(max_inc+1):
                    cost = dp[prev, total_inc]
                    if cost < INF:
                        total_cost = cost + (199 - prev)**2
                        if total_cost < best:
                            best = total_cost
                fixed = 1 + 199**2
                f = 0.5 * best + 0.5 * fixed
                return f, best
            
