            # adjacency list for graph G (distance ≤2, exclude self)
            adj = [[] for _ in range(N)]
            for i in range(N):
                for j in range(i+1, N):
                    if cheb_dist(coords[i], coords[j]) <= 2:
                        adj[i].append(j)
                        adj[j].append(i)
            
            # neighbor mask for removal (including self)
            neighbor_mask = [0]*N
            for i in range(N):
                mask = 1 << i
                for j in adj[i]:
                    mask |= 1 << j
                neighbor_mask[i] = mask
            
            best = 0
            calls = 0
            start_time = time.time()
            
            def upper_bound_match(available_set):
                # compute max matching size on induced subgraph of available vertices
                # Build graph
                G = nx.Graph()
                # add nodes
                G.add_nodes_from(available_set)
                # add edges where both endpoints in available_set
                for i in available_set:
                    for j in adj[i]:
                        if j > i and j in available_set:
                            G.add_edge(i,j)
                matching = nx.algorithms.matching.max_weight_matching(G, maxcardinality=True)
                return len(matching) * 2  # number of vertices matched
            
            def dfs(available_mask, count):
                global best, calls
