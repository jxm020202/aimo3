            import random, math, numpy as np
            
            def max_E_for_pr(p, r, samples=200000, L=10):
                q = 9 - p - r
                best = -1
                best_vals = None
                for _ in range(samples):
                    a = random.uniform(-L, L)
                    c = random.uniform(-L, L)
                    # compute b from sum constraint
                    b = (1 - p*a - r*c)/q
                    # enforce ordering a <= b <= c (if not, swap maybe)
                    if not (a <= b <= c):
                        continue
                    # compute expression
                    A = p*(b - a) + r*(c - b)
                    C = p*a*a + q*b*b + r*c*c
                    if C <= 0:
                        continue
                    E = (A*A * (9*C - 1)) / (C**3)
                    if E > best:
                        best = E
                        best_vals = (a,b,c)
                return best, best_vals
            
            results = {}
            for p in range(0,5):
                for r in range(0,5):
                    if p+r <=8 and (9-p-r)>=1:
                        best, vals = max_E_for_pr(p,r, samples=200000, L=5)
                        results[(p,r)] = (best, vals)
