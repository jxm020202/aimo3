            def max_edges_milp(n):
                edge_list = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edge_list)
                edge_index = {edge:i for i,edge in enumerate(edge_list)}
                num_vars = 2*m
                c = np.zeros(num_vars)
                c[:m] = -1  # maximize sum e
                A = []
                b = []
                # z <= e
                for i in range(m):
                    row = np.zeros(num_vars)
                    row[m+i] = 1
                    row[i] = -1
                    A.append(row); b.append(0)
                # triangle constraint
                for u in range(n):
                    for v in range(u+1,n):
                        idx_uv = edge_index[(u,v)]
                        for w in range(n):
                            if w==u or w==v:
                                continue
                            idx_uw = edge_index[(min(u,w), max(u,w))]
                            idx_vw = edge_index[(min(v,w), max(v,w))]
                            row = np.zeros(num_vars)
                            row[m+idx_uv] = 1
                            row[idx_uw] = 1
                            row[idx_vw] = 1
                            A.append(row); b.append(2)
                # each vertex has at least one triangle-free incident edge
                for u in range(n):
                    row = np.zeros(num_vars)
                    for v in range(n):
                        if v==u: continue
                        idx = edge_index[(min(u,v), max(u,v))]
                        row[m+idx] = 1
                    A.append(-row); b.append(-1)
                A = np.array(A)
                b = np.array(b)
                # bounds
                lb = np.zeros(num_vars)
                ub = np.ones(num_vars)
                bounds = opt.Bounds(lb, ub)
                integrality = np.ones(num_vars, dtype=int)
                res = opt.milp(c, bounds=bounds, constraints=opt.LinearConstraint(A, -np.inf, b), integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("MILP failed", res.message)
                    return None
                e_vals = np.round(res.x[:m])
                total_edges = int(e_vals.sum())
                return total_edges
            
            print(max_edges_milp(6))
            
