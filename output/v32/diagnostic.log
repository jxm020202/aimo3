            def area_in_first_quadrant(theta, N=2000000):
                c = math.cos(theta)
                s = math.sin(theta)
                # sample points in bounding box [-0.5,0.5]x[-0.5,0.5] maybe
                # but we can sample uniformly in square shape and test x>=0,y>=0
                # generate points uniformly in the square via rejection? easier: sample in bounding box and test inside shape
