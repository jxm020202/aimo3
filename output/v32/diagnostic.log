            def max_E_numeric(eps, steps=100000):
                S = 3 - eps
                max_val = 0
                best = None
                for i in range(steps+1):
                    a = S * i / steps
                    b = S - a
                    val = (a**3 + b**3 + eps**3) * (a+b) * (b+eps) * (eps+a)
                    if val > max_val:
                        max_val = val
                        best = (a,b,eps)
                return max_val, best
            
