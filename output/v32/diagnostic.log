            def reversed_gray_sequence(n):
                # generate standard gray code, then reverse bits order
                seq = gray_code_sequence(n)
                rev_seq = []
                for x in seq:
                    # reverse bits of length n
                    rev = 0
                    for i in range(n):
                        if x>>i & 1:
                            rev |= 1 << (n-1-i)
                    rev_seq.append(rev)
                return rev_seq
            
