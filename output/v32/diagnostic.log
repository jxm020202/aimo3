            import itertools
            
            def count_independent_sets(n):
                # generate all row masks with no adjacent 1 bits
                masks = []
                for mask in range(1<<n):
                    # check no adjacent 1 bits horizontally
                    if mask & (mask<<1):
                        continue
                    masks.append(mask)
                # precompute compatibility: masks that have no vertical adjacency (i.e., no overlapping 1 bits)
                compat = {m: [] for m in masks}
                for m1 in masks:
                    for m2 in masks:
                        if m1 & m2 == 0:
                            compat[m1].append(m2)
                # DP over rows
                dp = {m: 1 for m in masks}  # first row can be any mask
                for row in range(1, n):
                    newdp = {m: 0 for m in masks}
                    for m in masks:
                        # sum over previous masks that are compatible
                        total = sum(dp[pm] for pm in compat[m])
                        newdp[m] = total
                    dp = newdp
                total = sum(dp.values())
                return total
            
            for n in range(2,6):
                print(n, count_independent_sets(n))
            
