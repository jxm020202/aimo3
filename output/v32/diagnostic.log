            import math, sympy as sp
            
            def is_squarefree(m):
                fac = sp.factorint(m)
                return all(e==1 for e in fac.values())
            
            def carmichael_squarefree(m):
                # m squarefree, Carmichael lambda = lcm(p-1)
                fac = sp.factorint(m)
                l = 1
                for p in fac:
                    l = sp.ilcm(l, p-1)
                return int(l)
            
            def cycle_type_perm(perm):
                # perm is list mapping i->perm[i] (0-index)
                n = len(perm)
                visited = [False]*n
                lengths = []
                for i in range(n):
                    if not visited[i]:
                        cur = i
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = perm[cur]
                            cnt += 1
                        lengths.append(cnt)
                lengths.sort()
                return tuple(lengths)
            
            def find_min(limit=20000):
                for n in range(866, limit+1):
                    if math.gcd(n, 866) != 1:
                        continue
                    m = n+1
                    if not is_squarefree(m):
                        continue
                    lam = carmichael_squarefree(m)
                    if math.gcd(866, lam) != 1:
                        continue
                    # compute permutations
                    g = [(866*i) % n for i in range(n)]  # 0..n-1
                    # h: domain 1..n, map to 1..n
                    h = [pow(i, 866, m) for i in range(1, n+1)]
                    # ensure no zero
                    if any(v==0 for v in h):
                        continue
                    # convert h to 0-indexed list mapping 0..n-1 -> ...
                    h0 = [v-1 for v in h]  # because v in 1..n
                    # compute cycle types
                    ct_g = cycle_type_perm(g)
                    ct_h = cycle_type_perm(h0)
                    if ct_g == ct_h:
                        return n, ct_g
                return None
            
            result = find_min(20000)
            result
            
