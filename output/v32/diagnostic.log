            import random, math, numpy as np
            
            def contains_point(c, theta, p):
                # c is center (x,y)
                # check if point p inside square of side 1 centered at c, orientation theta
                dx = p[0] - c[0]
                dy = p[1] - c[1]
                # rotate by -theta
                x = dx*math.cos(theta) + dy*math.sin(theta)
                y = -dx*math.sin(theta) + dy*math.cos(theta)
                return abs(x) <= 0.5 + 1e-12 and abs(y) <= 0.5 + 1e-12
            
            def trial():
                # random center uniform in [0,1)^2
                c = (random.random(), random.random())
                theta = random.random()*2*math.pi
                # check four lattice points (0,0),(1,0),(0,1),(1,1)
                points = [(0,0),(1,0),(0,1),(1,1)]
                for p in points:
                    if contains_point(c, theta, p):
                        return False
                return True
            
            def estimate(N):
                cnt=0
                for _ in range(N):
                    if trial():
                        cnt+=1
                return cnt/N
            
            for N in [10000,100000,500000]:
                print(N, estimate(N))
            
