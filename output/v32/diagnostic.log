            def random_feasible_n(n):
                # generate random increments d_i in [-1,1] with sum zero
                # use linear programming to find a feasible point with random objective
                c = np.random.randn(n)
                # constraints: -1 <= d_i <= 1, sum d_i = 0
                # We'll solve for d_i first, then compute a_i as cumulative sum.
                # Variables d_i
                # inequalities: d_i <= 1, -d_i <= 1
                A_ub = np.vstack([np.eye(n), -np.eye(n)])
                b_ub = np.ones(2*n)
                A_eq = np.ones((1,n))
                b_eq = np.array([0.0])
                res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, method='highs')
                if not res.success:
                    return None
                d = res.x
                a = np.cumsum(np.concatenate([[0], d]))[:n]  # start a_0 = 0, then a_i = sum_{j< i} d_j
                # shift to make sum zero
                a = a - a.mean()
                return a
            
            def test_n(n,m, trials=1000):
                for _ in range(trials):
                    a = random_feasible_n(n)
                    if a is None:
                        continue
                    # compute block sums for each residue class modulo m
                    block_sums = [sum(a[i] for i in range(r, n, m)) for r in range(m)]
                    # check if all equal (or zero)
                    if any(abs(s - block_sums[0]) > 1e-6 for s in block_sums):
                        return False, block_sums
                return True, None
            
            print(test_n(6,2,100))
            
