                    xt = x1 + (x2 - x1)*t
                    yt = y1 + (y2 - y1)*t
                    ft = sp.simplify((2*yt - 3)/(2*xt - 1))
                    # derivative w.r.t t
                    dft = sp.diff(ft, t)
                    # Solve for interior critical points (0<t<1)
                    crit = sp.solve(sp.Eq(dft,0), t)
                    # keep those within (0,1)
                    for sol in crit:
                        if sol.is_real:
                            if sol>0 and sol<1:
                                pts.append((sp.simplify(xt.subs(t,sol)), sp.simplify(yt.subs(t,sol)), ft.subs(t,sol)))
                    # also add endpoints
