            def Y_max_given_X(X):
                # solve quadratic for x
                # X = 6x - 3x^2 => 3x^2 - 6x + X = 0
                a=3
                b=-6
                c=X
                disc = b*b - 4*a*c
                if disc < 0:
                    return None
                sqrt_disc = math.sqrt(disc)
                x1 = (-b + sqrt_disc)/(2*a)
                x2 = (-b - sqrt_disc)/(2*a)
                # choose x in (0,1.5)
                candidates = []
                for x in [x1,x2]:
                    if 0 < x < 1.5:
                        Y = 3*x**2 - 2*x**3
                        candidates.append(Y)
                if not candidates:
                    return None
                return max(candidates)
            
