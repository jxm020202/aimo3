            v1 = sp.Matrix([(c - s)/2, (c + s)/2])
            v2 = sp.Matrix([-(c + s)/2, (c - s)/2])
            v4 = sp.Matrix([(c + s)/2, (s - c)/2])
            
            # Edge v1->v2: param t, find t where x=0
