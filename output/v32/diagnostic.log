            def random_grid(m,n):
                N=m*n
                arr=list(range(1,N+1))
                random.shuffle(arr)
                return np.array(arr).reshape(m,n)
            
            def min_adj_sum_grid(grid):
                m,n=grid.shape
                mins=10**9
                for i in range(m):
                    for j in range(n):
                        if i+1<m:
                            mins=min(mins, grid[i,j]+grid[i+1,j])
                        if j+1<n:
                            mins=min(mins, grid[i,j]+grid[i,j+1])
                return mins
            
            def try_optimize(m,n,target,iterations=20000):
                grid=random_grid(m,n)
                best=min_adj_sum_grid(grid)
                if best>=target:
                    return grid, best
                for it in range(iterations):
                    # pick two random cells to swap
                    i1,j1 = random.randrange(m), random.randrange(n)
                    i2,j2 = random.randrange(m), random.randrange(n)
                    if i1==i2 and j1==j2: continue
                    # compute affected edges before swap
                    # We'll compute min before and after quickly by recomputing whole grid (slow but okay small)
                    # swap
                    grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                    cur=min_adj_sum_grid(grid)
                    if cur>best:
                        best=cur
                        if best>=target:
                            return grid,best
                    else:
                        # revert if not better
                        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
                return None, best
            
            m,n=4,4
            target=m*n
            grid,best=try_optimize(m,n,target,iterations=200000)
            print(best)
            
