            import sympy as sp
            # Define vertices
            A = sp.Point3D(0,0,0)
            B = sp.Point3D(1,0,0)
            C = sp.Point3D(sp.Rational(1,2), sp.sqrt(3)/2, 0)
            D = sp.Point3D(sp.Rational(1,2), sp.sqrt(3)/6, sp.sqrt(6)/3)
            
            centroid = sp.Point3D(sp.Rational(1,2), sp.sqrt(3)/6, sp.sqrt(6)/12)
            r = sp.sqrt(6)/36
            
            def unit_normal_and_d(p1,p2,p3):
                n, d = plane_from_points(p1,p2,p3)  # n not unit, d such that n·x + d = 0
                norm = sp.sqrt(n.dot(n))
                n_unit = n / norm
                d_unit = d / norm
                return n_unit, d_unit
            
            faces_pts = [(A,B,C), (A,B,D), (A,C,D), (B,C,D)]
            offset_planes = []
            for pts in faces_pts:
                n_u, d_u = unit_normal_and_d(*pts)
                # ensure interior side negative: compute signed distance of centroid
                signed = n_u.dot(sp.Matrix(centroid)) + d_u
                if signed > 0:
                    # flip orientation
                    n_u = -n_u
                    d_u = -d_u
                # offset inward by r: new d = d_u + r
                d_offset = d_u + r
                offset_planes.append((n_u, d_offset))
            
            offset_planes
            
