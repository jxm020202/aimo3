            def last_nonzero_digit_factorial_fast(n):
                # using recursion
                if n < 5:
                    # compute directly
                    res = 1
                    for i in range(2, n+1):
                        res *= i
                    # remove zeros
                    while res % 10 == 0:
                        res //= 10
                    return res % 10
                # recursion
                # compute D(n) = D(n//5) * D_odd(n%5) * 2^{n//5} mod 10
                a = [1,1,2,6,4]  # last non-zero digit of product 1..m ignoring multiples of 5
                # Actually product of numbers 1..m after removing factors of 5, but for m<5 there are none.
                # So a[m] = last non-zero digit of product_{i=1}^{m} i.
                # Let's compute recursively
                # Use pow(2, n//5, 10)
                return (last_nonzero_digit_factorial_fast(n//5) * a[n%5] * pow(2, n//5, 10)) % 10
            
