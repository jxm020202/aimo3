            def last_nonzero_digit_factorial(n):
                # compute last non-zero digit of n! in base 10
                # using algorithm described
                count2 = 0
                count5 = 0
                res = 1
                for i in range(2, n+1):
                    x = i
                    while x % 2 == 0:
                        x //= 2
                        count2 += 1
                    while x % 5 == 0:
