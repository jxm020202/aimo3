            def f_of_x(x, N=30):
                s=0.0
                for n in range(1,N+1):
                    if math.floor(n*x)%2==0:
                        s+= 1.0/(2**n)
                # add tail bound: max possible tail if all remaining terms are 1 (worst case for f)
                # but we want lower bound of f: we can compute lower bound by assuming remaining terms are 0.
                # For approximation, we just ignore tail.
                return s
            
            def f_lower_bound(x, N=30):
                # lower bound: assume remaining terms are 0
                return f_of_x(x,N)
            
            def f_upper_bound(x, N=30):
                # upper bound: assume remaining terms are 1
                s=f_of_x(x,N)
                s+= 1.0/(2**N)  # sum_{n>N} 1/2^n = 1/2^N
                return s
            
            def search_max_B(N=30, max_den=200):
                best_x=None
                best_f=1.0
                for q in range(1,max_den+1):
                    for k in range(0,q):
                        x=k/q
                        # compute lower bound of f (since we want minimal f)
                        f_lb=f_lower_bound(x,N)
                        if f_lb < best_f:
                            best_f=f_lb
                            best_x=x
                return best_x,best_f
            
            best_x,best_f=search_max_B(N=30, max_den=200)
            best_x,best_f
