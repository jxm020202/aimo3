            def multiply_factors(factors):
                # factors: list of (vars, table) where table is dict mapping assignment tuple to int
                # returns combined factor (vars, table)
                if not factors:
                    return (tuple(), {(): 1})
                # start with first factor
                vars_comb, table_comb = factors[0]
                for vars_f, table_f in factors[1:]:
                    # new vars = union
                    new_vars = tuple(sorted(set(vars_comb) | set(vars_f)))
                    # mapping indices
                    idx_comb = [new_vars.index(v) for v in vars_comb]
                    idx_f = [new_vars.index(v) for v in vars_f]
                    new_table = {}
                    # iterate over assignments of new_vars
                    for assign in itertools.product(range(3), repeat=len(new_vars)):
                        # extract subassignments
                        sub_comb = tuple(assign[i] for i in idx_comb)
                        sub_f = tuple(assign[i] for i in idx_f)
                        val = table_comb.get(sub_comb, 0) * table_f.get(sub_f, 0)
                        if val:
                            new_table[assign] = val
                    vars_comb, table_comb = new_vars, new_table
                return (vars_comb, table_comb)
            
            def sum_out(var, factor):
                vars_f, table_f = factor
                if var not in vars_f:
                    return factor
                idx = vars_f.index(var)
                new_vars = tuple(v for v in vars_f if v != var)
                new_table = {}
                for assign, val in table_f.items():
                    # assign is tuple of length len(vars_f)
                    # sum over var: we need to aggregate over values of var (0,1,2)
                    # We'll create new_assign by removing the coordinate at idx
                    new_assign = assign[:idx] + assign[idx+1:]
                    new_table[new_assign] = new_table.get(new_assign, 0) + val
                return (new_vars, new_table)
            
            def count_K4_elim_dict():
                verts = list(range(4))
