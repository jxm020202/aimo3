            def estimate_p_vectorized(N, batch=1000000):
                # generate in batches to avoid memory issues
                uncovered = 0
                remaining = N
                while remaining > 0:
                    m = min(batch, remaining)
                    # generate arrays
                    thetas = np.random.rand(m) * 2*np.pi
                    cs = np.cos(thetas)
                    ss = np.sin(thetas)
                    a = np.random.rand(m)
                    b = np.random.rand(m)
                    # For each of four points, compute condition
                    # We'll compute mask of covered points
                    covered = np.zeros(m, dtype=bool)
                    for i,j in [(0,0),(1,0),(0,1),(1,1)]:
                        dx = a - i
                        dy = b - j
                        u = dx*cs + dy*ss
                        v = -dx*ss + dy*cs
                        cond = (np.abs(u) <= 0.25) & (np.abs(v) <= 0.25)
                        covered = covered | cond
                    uncovered += np.count_nonzero(~covered)
                    remaining -= m
                return uncovered / N
            
            p_est = estimate_p_vectorized(5000000)
            print(p_est)
            
