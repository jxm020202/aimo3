                    # choose d up to maybe 2
                    for d in np.linspace(d_min, 2, 2001):
                        val = E_sd_val(s,d)
                        if val > best:
                            best = val
                            best_pair = (s,d)
                return best, best_pair
            
            best_val, best_pair = grid_search()
            best_val, best_pair
            
