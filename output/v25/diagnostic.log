from itertools import combinations
import sys

def terminal(state):
    # state is sorted tuple of nonnegative ints
    if all(v==0 for v in state):
        return True
    total = sum(state)
    # check if any number > sum of others
    for i,v in enumerate(state):
        if v > total - v:
            return True
    return False

def value(state):
    # returns final count under optimal play from this state
    # assume both players optimal: A chooses pair to maximize, B chooses result to minimize
    # state is sorted tuple
    if terminal(state):
        return len(state)
    # A's move: choose pair indices i<j
    best = -1  # maximize
    n = len(state)
    # iterate over unordered pairs (i,j)
    for i in range(n):
        for j in range(i+1, n):
            x = state[i]
            y = state[j]
            # remove i,j from list
            newlist = list(state)
            # remove larger index first
            del newlist[j]
            del newlist[i]
            # B's choice: either sum or diff
            # B wants to minimize final count
            # compute resulting state for each choice
            # sum
            sum_val = x + y
            state_sum = tuple(sorted(newlist + [sum_val]))
            val_sum = value(state_sum)
            # diff
            diff_val = abs(x - y)
            state_diff = tuple(sorted(newlist + [diff_val]))
            val_diff = value(state_diff)
            # B chooses min
            val = min(val_sum, val_diff)
            # A wants max over pairs
            if val > best:
                best = val
    return best

# test for small N
def compute(N):
    init = tuple([1]*N)
    return value(init)

for N in range(1,8):
    print(N, compute(N))


