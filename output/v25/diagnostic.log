from itertools import combinations

@lru_cache(maxsize=None)
def value_state(state):
    # state is tuple sorted
    if terminal(state):
        return len(state)
    n = len(state)
    best = -1
    # iterate over pairs
    for i in range(n):
        for j in range(i+1, n):
            x = state[i]
            y = state[j]
            # create new list after removing i,j
            newlist = list(state)
            del newlist[j]
            del newlist[i]
            # B's choices
            sum_state = tuple(sorted(newlist + [x+y]))
            diff_state = tuple(sorted(newlist + [abs(x-y)]))
            val_sum = value_state(sum_state)
            val_diff = value_state(diff_state)
            val = min(val_sum, val_diff)  # B chooses worst for A
            if val > best:
                best = val
    return best

def compute(N):
    init = tuple([1]*N)
    return value_state(init)

