    for a in range(1, N-1):
        for b in range(a+1, N):
            c = N - a - b
            if c <= b:
                continue
            l = sp.ilcm(a,b,c)
            if best is None or l < best:
                best = l
    return best

def compute_g(c, bound=200):
    N_candidates = generate_N_candidates(c, bound)
    # compute minimal ratio
    best_ratio = None
    best_N = None
    best_L = None
    for N in N_candidates:
