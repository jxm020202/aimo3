def max_chain_len(limit):
    # compute max moves for n up to limit (small)
    from functools import lru_cache
    @lru_cache(None)
    def moves(m):
        if m==1:
            return 0
        best=0
        for b in range(2,m+1):
            # compute sum digits
            x=m
            s=0
            while x:
                s+=x%b
                x//=b
            # one move then continue
            best=max(best,1+moves(s))
        return best
    maxlen=0
    bestn=None
    for n in range(1,limit+1):
        l=moves(n)
        if l>maxlen:
            maxlen=l
            bestn=n
    return maxlen,bestn

