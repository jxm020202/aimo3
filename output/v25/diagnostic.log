def reachable_states(state):
    # generate all states reachable in one move (A chooses pair, B chooses op)
    n = len(state)
    res = set()
    for i in range(n):
        for j in range(i+1,n):
            x = state[i]
            y = state[j]
            rest = list(state)
            # remove indices j,i
            del rest[j]
            del rest[i]
            # sum
            res.add(normalize(tuple(rest+[x+y])))
            # diff
            res.add(normalize(tuple(rest+[abs(x-y)])))
    return res

def all_reachable(initial, max_depth=5):
    seen = set([initial])
    frontier = {initial}
    for d in range(max_depth):
        new_frontier=set()
        for st in frontier:
            for nxt in reachable_states(st):
                if nxt not in seen:
                    seen.add(nxt)
                    new_frontier.add(nxt)
        frontier = new_frontier
    return seen

def condition_holds(state):
    return termination(state)

def find_terminal_states(n):
    init = tuple([1]*n)
    # BFS until terminal states found
    from collections import deque
    seen=set([init])
    q=deque([init])
    terminals=set()
    while q:
        st=q.popleft()
        if condition_holds(st):
            terminals.add(st)
            continue
        for nxt in reachable_states(st):
            if nxt not in seen:
                seen.add(nxt)
                q.append(nxt)
    return terminals

for n in range(2,7):
    terminals=find_terminal_states(n)
    print("n",n,"terminals count",len(terminals))
    for t in terminals:
        print(t)
    print()


