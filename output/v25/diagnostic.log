def v3(n):
    cnt = 0
    while n % 3 == 0 and n>0:
        n //= 3
        cnt += 1
    return cnt

def divisors_coprime_to_3(n):
    # return list of divisors of n that are coprime to 3
    divs = sp.divisors(n)
    return [d for d in divs if d % 3 != 0]

def generate_N_candidates(c, bound=200):
    candidates = set()
    if c == 0:
        # any power of 3 up to bound
        k = 0
        while 3**k <= bound:
