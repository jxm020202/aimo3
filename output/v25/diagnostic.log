from itertools import combinations
from collections import Counter

def normalize(state):
    # state is a tuple sorted
    return tuple(sorted(state))

def condition(state):
    # state is tuple of nonnegative ints
    S = sum(state)
    if S == 0:
        return True  # all zeros (but impossible)
    L = max(state)
    return L*2 > S  # L > S/2

@lru_cache(maxsize=None)
def expected_final(state):
    # state is a tuple sorted
    n = len(state)
    # If condition already holds? Actually game would have ended previous round, but we can treat as terminal.
    if condition(state):
        return n
    # else we need to choose pair to maximize expected final count
    best = -1.0
    # enumerate unordered pairs indices
    # Use combinations of indices
    for i,j in combinations(range(n),2):
        x = state[i]
        y = state[j]
        # create new list without i,j
        rest = list(state)
        # remove larger index first
        del rest[j]
        del rest[i]
        # outcome sum
        new_sum = rest + [x+y]
        new_sum = normalize(tuple(new_sum))
        # outcome diff
        new_diff = rest + [abs(x-y)]
        new_diff = normalize(tuple(new_diff))
        # compute expected final count after each outcome
        # if condition holds after outcome, final count = len(new_state)
        # else recursion
        if condition(new_sum):
            exp_sum = len(new_sum)
        else:
            exp_sum = expected_final(new_sum)
        if condition(new_diff):
            exp_diff = len(new_diff)
        else:
            exp_diff = expected_final(new_diff)
        exp = 0.5*exp_sum + 0.5*exp_diff
        if exp > best:
            best = exp
    return best

def compute_expected(N):
    # initial state: N copies of 1
    state = tuple([1]*N)
    return expected_final(state)

for N in range(1,9):
    print(N, compute_expected(N))


