            new_state_diff = tuple(sorted(rest + [diff_val]))
            # B chooses worst for A: min of the two values
            val_sum = value(new_state_sum)
            val_diff = value(new_state_diff)
            worst = min(val_sum, val_diff)
            if worst > best:
                best = worst
    return best

def compute_initial(n):
    state = tuple([1]*n)
    return value(state)

