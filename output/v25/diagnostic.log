            x = state[i]
            y = state[j]
            # remove i,j
            new_list = list(state)
            del new_list[j]
            del new_list[i]
            # sum
            sum_state = tuple(sorted(new_list + [x+y]))
            sum_out = outcome_cached(sum_state)
            # diff
            diff_state = tuple(sorted(new_list + [abs(x-y)]))
            diff_out = outcome_cached(diff_state)
            b_choice = min(sum_out, diff_out)
            if b_choice > best:
                best = b_choice
    return best

def outcome_n(n):
    return outcome_cached(tuple([1]*n))

