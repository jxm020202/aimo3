from itertools import combinations

def normalize(state):
    # state is tuple sorted
    return tuple(sorted(state))

@lru_cache(None)
def solve(state):
    # returns optimal final count (number of numbers) assuming A to move
    # state is tuple of nonnegative ints
    # check termination
    if all(x == 0 for x in state):
        return len(state)  # all zeros condition
    total = sum(state)
    if total == 0:
        return len(state)
    maxv = max(state)
    if maxv > total - maxv:
        return len(state)
    # otherwise, continue
    best = -1  # A wants maximize
    n = len(state)
    # generate all pairs i<j
    for i in range(n):
        for j in range(i+1, n):
            x = state[i]
            y = state[j]
            # remove indices i,j
            new_list = list(state)
            # remove larger index first
            del new_list[j]
            del new_list[i]
            # B's choice: sum or diff
            # B wants minimize final count, so we take min over choices
            # sum
            sum_val = x + y
            state_sum = normalize(tuple(new_list + [sum_val]))
            val_sum = solve(state_sum)
            # diff
            diff_val = abs(x - y)
            state_diff = normalize(tuple(new_list + [diff_val]))
            val_diff = solve(state_diff)
            # B will choose the move that gives smaller final count
            val = min(val_sum, val_diff)
            # A will choose pair that maximizes this
            if val > best:
                best = val
    return best

def result_n(n):
    init = tuple([1]*n)
    return solve(normalize(init))

for n in range(1,9):
    print(n, result_n(n))
```

