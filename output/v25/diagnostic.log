            val_sum = minimax(s_state)
            val_diff = minimax(d_state)
            # B will choose min
            val = min(val_sum, val_diff)
            # A wants max over pairs
            if val > best:
                best = val
    return best

def compute_optimal(n):
    init = tuple([1]*n)
    return minimax(normalize(init))

