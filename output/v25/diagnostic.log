import sympy as sp

def f_bruteforce(n):
    for x in range(1, n+1):
        divs = sp.divisors(x)
        if len(divs) < 3:
            continue
        # check combos
        L = len(divs)
        for i in range(L):
            for j in range(i+1, L):
                for k in range(j+1, L):
                    if divs[i] + divs[j] + divs[k] == n:
                        return x
    return None

def f_formula(n):
    m = n-1
    divs = sp.divisors(m)
    candidates = [d for d in divs if d < m/2]
    if not candidates:
        return None
    d_max = max(candidates)
    return n - 1 - d_max

fails = []
for n in range(6, 101):
    f1 = f_bruteforce(n)
    f2 = f_formula(n)
    if f1 != f2:
        fails.append((n, f1, f2))
print("fails:", fails)
print("total fails:", len(fails))
```

