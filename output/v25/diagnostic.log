def max_matching_15():
    n=15
    G=nx.Graph()
    # add nodes as (i,j) tuples
    for i in range(n):
        for j in range(n):
            G.add_node((i,j))
    # add edges for Chebyshev distance <=2, distinct
    for i in range(n):
        for j in range(n):
            for di in range(-2,3):
                for dj in range(-2,3):
                    if di==0 and dj==0: continue
                    ni=i+di
                    nj=j+dj
                    if 0<=ni<n and 0<=nj<n:
                        # add edge once (i,j) < (ni,nj) to avoid duplicates
                        if (i,j) < (ni,nj):
                            G.add_edge((i,j),(ni,nj))
    matching = nx.algorithms.matching.max_weight_matching(G, maxcardinality=True)
    # matching is a set of frozenset pairs
    # compute number of vertices matched
    matched_vertices = set()
    for u,v in matching:
        matched_vertices.add(u)
        matched_vertices.add(v)
    return len(matched_vertices), matching

