def normalize(state):
    # state is tuple of ints sorted nondecreasing
    return tuple(sorted(state))

def is_terminal(state):
    S = sum(state)
    if not state:
        return True
    M = max(state)
    return M > S - M  # condition (1)

def next_states(state):
    # returns list of possible next states after A chooses pair and B chooses sum/diff
    # A chooses pair (i,j) from indices
    n = len(state)
    res = []
    # generate all unordered pairs of indices
    for i in range(n):
        for j in range(i+1, n):
