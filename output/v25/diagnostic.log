    for exp, coeff in Dpoly.as_dict().items():
        i = exp[0]
        coeffs[t + i] = sign * coeff
    return coeffs

def star(alpha, beta):
    # alpha list length 9 (indices 0..8)
    # beta dict exponent->coeff (finite)
    # compute convolution sum_{i=0..8} alpha[i] * beta[i-n]
    # return dict n->value
    res = {}
    # compute for n in some range where beta nonzero and alpha nonzero
    # Determine range of n where contributions possible: n = i - j where i in [0,8], j in support(beta)
    beta_support = list(beta.keys())
    for i in range(9):
        a = alpha[i]
        if a == 0:
            continue
        for j in beta_support:
            n = i - j
            res[n] = res.get(n, 0) + a * beta[j]
    return res

