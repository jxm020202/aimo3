            y = state[j]
            # remaining numbers after removing i,j
            remaining = list(state)
            # remove elements at j then i (since j>i)
            del remaining[j]
            del remaining[i]
            # B can choose sum or diff
            # sum case
            new_state_sum = remaining + [x+y]
            # diff case
            new_state_diff = remaining + [abs(x-y)]
            # add normalized
            res.append(normalize(tuple(new_state_sum)))
            res.append(normalize(tuple(new_state_diff)))
    return res

@lru_cache(None)
def minimax(state):
    # returns optimal final count (cookies) assuming A maximizes, B minimizes
    # state is tuple sorted
    if is_terminal(state):
