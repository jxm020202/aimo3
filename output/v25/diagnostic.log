from itertools import combinations, product

def normalize(state):
    # state is tuple of sorted numbers
    return tuple(sorted(state))

def game_value(state):
    # returns final number of numbers left under optimal play (A maximize, B minimize)
    # state is tuple sorted
    # if termination condition holds, return len(state)
    total = sum(state)
    # condition (1): exists number > total - number
    for x in state:
        if x > total - x:
            return len(state)
    # condition (2): all zeros
    if total == 0:
        return len(state)
    # else, A chooses pair, B chooses operation to minimize final count
    # A wants to maximize final count, B wants to minimize.
    best = -1
    # A's move: choose unordered pair indices i<j
    n = len(state)
    for i in range(n):
        for j in range(i+1, n):
            x = state[i]
            y = state[j]
            # remaining numbers after removing i,j
            rest = list(state)
            # remove larger index first
            rest.pop(j)
            rest.pop(i)
            # B's choice: either sum or diff
            # B will choose the one that leads to minimal final count (since B wants few cookies)
            # compute both outcomes
            outcomes = []
            # sum
            outcomes.append(game_value(normalize(tuple(rest + [x+y]))))
            # diff
            outcomes.append(game_value(normalize(tuple(rest + [abs(x-y)]))))
            # B chooses min
            val = min(outcomes)
            # A wants max over his choices
            if val > best:
                best = val
    return best

@lru_cache(None)
def game_value_cached(state):
    return game_value(state)

def value_n(n):
    state = tuple([1]*n)
    return game_value_cached(normalize(state))

for n in range(1,11):
    game_value_cached.cache_clear()
    print(n, value_n(n))


