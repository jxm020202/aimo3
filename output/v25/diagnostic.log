def f_via_lcm(n):
    # compute min lcm of distinct a,b,c positive sum=n
    min_l = None
    best = None
    # iterate a<b<c
    for a in range(1, n-2):
        for b in range(a+1, n-a-1):
            c = n - a - b
            if c <= b:
                continue
            # distinct positive automatically
            l = sp.ilcm(a,b,c)
            if min_l is None or l < min_l:
                min_l = l
                best = (a,b,c)
    return min_l, best

