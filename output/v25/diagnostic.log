import math

def termination(state):
    # state is sorted tuple of nonnegative ints
    S = sum(state)
    if S == 0:
        return True
    M = max(state)
    if M > S - M:
        return True
    return False

def expected_opt(state):
    state = tuple(sorted(state))
    @lru_cache(None)
    def f(st):
        # st is tuple sorted
        if termination(st):
            return len(st)
        n = len(st)
        best = -1.0
        # generate all unordered pairs indices i<j (values)
        # Since numbers may repeat, we need to consider pairs of positions; but we can consider pairs of values with multiplicities.
        # Simpler: generate all pairs of indices from range(n)
        for i in range(n):
            for j in range(i+1, n):
                x = st[i]
                y = st[j]
                # remove i and j: create list of remaining
                rem = list(st)
                # remove larger index first to avoid shift
                del rem[j]
                del rem[i]
                # sum case
                new_sum = x + y
                st_sum = tuple(sorted(rem + [new_sum]))
                # diff case
                new_diff = abs(x - y)
                st_diff = tuple(sorted(rem + [new_diff]))
                # expected value
                exp = 0.5 * f(st_sum) + 0.5 * f(st_diff)
                if exp > best:
                    best = exp
        return best
    return f(state)

