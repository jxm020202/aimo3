    n = board_size
    M = (2*range_radius+1)**2  # max sum in a block = 25
    N = n*n
    # Build constraint matrix
    A = []
    b = []
    # Precompute block indices for each cell
    block_cells = []
    for i in range(n):
        for j in range(n):
            cells = []
            for di in range(-range_radius, range_radius+1):
                for dj in range(-range_radius, range_radius+1):
                    ii = i+di
                    jj = j+dj
                    if 0 <= ii < n and 0 <= jj < n:
                        cells.append(ii*n + jj)
            block_cells.append(cells)
    # For each cell i, add two constraints
    for idx, cells in enumerate(block_cells):
        # upper bound: sum_{B} x + M*x_i <= 2 + M
        row = np.zeros(N, dtype=int)
        row[cells] = 1
        row[idx] += M
        A.append(row)
        b.append(2 + M)
        # lower bound: -sum_{B} x + M*x_i <= -2 + M
        row2 = np.zeros(N, dtype=int)
        row2[cells] = -1
        row2[idx] += M
        A.append(row2)
        b.append(-2 + M)
    A = np.array(A)
    b = np.array(b)
    # Objective: maximize sum x_i -> minimize -sum x_i
    c = -np.ones(N, dtype=int)
    # Bounds 0-1
    bounds = opt.Bounds(0, 1)
    # Integrality
    integrality = np.ones(N, dtype=int)
    # Use milp
    start = time.time()
    res = opt.milp(c=c, integrality=integrality, bounds=bounds,
