from collections import Counter
from itertools import combinations

def canonical(state):
    # state as tuple sorted nondecreasing
    return tuple(sorted(state))

@functools.lru_cache(None)
def V(state):
    # state is tuple of numbers
    n = len(state)
    # termination check
    S = sum(state)
    if S == 0:
        return n  # condition (2)
    M = max(state)
    if M > S - M:  # condition (1)
        return n
    # else not terminated
    best = -1e9
    # A chooses any pair indices (i<j)
    # Since numbers may repeat, we can choose by value pairs
    # We'll generate all unordered pairs of indices
    lst = list(state)
    for i in range(n):
        for j in range(i+1, n):
            x = lst[i]
            y = lst[j]
            # remove i and j
            newlist = lst[:i] + lst[i+1:j] + lst[j+1:]
            # heads: add x+y
            state_sum = canonical(tuple(newlist + [x+y]))
            # tails: add |x-y|
            state_diff = canonical(tuple(newlist + [abs(x-y)]))
            # expected value
            ev = 0.5 * V(state_sum) + 0.5 * V(state_diff)
            if ev > best:
                best = ev
    return best

def expected_cookies(n):
    return V(canonical(tuple([1]*n)))

for n in range(1,8):
    print(n, expected_cookies(n))


