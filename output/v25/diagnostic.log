def smallest_divisor_ge3_S(c_type, c_val=None):
    """
    c_type: 'zero', '4M', 'small'
    c_val: integer for 'small' case
    Returns smallest divisor >=3 (prime) of S.
    """
    # generate primes up to some limit
    limit = 20000  # may increase if needed
    primes = list(sp.primerange(3, limit+1))
    # precompute factorial modulo for phi > 2025
    # We'll compute on the fly.
    for p in primes:
        # compute M_mod_p
        if p == 3:
            M_mod = 0
        else:
            phi = p - 1
            if phi <= 2025:
                # factorial multiple of phi => exponent multiple of phi => M_mod = 1
                M_mod = 1 % p
            else:
                # compute factorial modulo phi
                fac_mod = 1
                for i in range(1, 2026):
                    fac_mod = (fac_mod * i) % phi
                exp_mod = fac_mod
                M_mod = pow(3, exp_mod, p)
        # compute S_mod
        if c_type == 'zero':
            S_mod = (M_mod - 1) % p
        elif c_type == '4M':
            S_mod = (5 * M_mod - 1) % p
        elif c_type == 'small':
            c = c_val
            S_mod = (M_mod + (c - 1) % p) % p
        else:
            raise ValueError
        if S_mod == 0:
            return p
    # if not found within limit, increase limit
    raise ValueError("Not found within limit")
    
# Test for each c
