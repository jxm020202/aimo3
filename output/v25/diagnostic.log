from itertools import combinations

def terminal(state):
    # state is tuple sorted nondecreasing
    total = sum(state)
    if total == 0:
        return True
    maxv = state[-1]
    return maxv > total - maxv  # max > sum of others

@lru_cache(None)
def value(state):
    # state is sorted tuple
    if terminal(state):
        return len(state)
    n = len(state)
    best = -1
    # iterate over unordered pairs (i<j)
    for i in range(n):
        for j in range(i+1, n):
            x = state[i]
            y = state[j]
            # create new list without i,j
            rest = list(state)
            # remove larger index first to avoid shifting
            del rest[j]
            del rest[i]
            # sum op
            sum_val = x + y
            new_state_sum = tuple(sorted(rest + [sum_val]))
            # diff op
