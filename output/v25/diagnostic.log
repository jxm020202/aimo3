def worst_expected_steps(state):
    # returns minimal steps A can guarantee (i.e., worst-case steps)
    if is_terminal(state):
        return 0
    n = len(state)
    best = float('inf')
    for i in range(n):
        for j in range(i+1, n):
            x = state[i]; y = state[j]
            remaining = list(state)
            del remaining[j]; del remaining[i]
            new_sum = x + y
            new_state_sum = normalize(tuple(remaining + [new_sum]))
            new_diff = abs(x - y)
            new_state_diff = normalize(tuple(remaining + [new_diff]))
            steps_sum = 0 if is_terminal(new_state_sum) else worst_expected_steps(new_state_sum)
            steps_diff = 0 if is_terminal(new_state_diff) else worst_expected_steps(new_state_diff)
            worst = 1 + max(steps_sum, steps_diff)
            if worst < best:
                best = worst
    return best

def guaranteed_cookies(N):
    init = tuple([1]*N)
    steps = worst_expected_steps(normalize(init))
    return N - steps

