import sympy as sp

def f_bruteforce(n, limit=10000):
    # search for smallest x such that there exist three distinct positive divisors summing to n
    # we can bound x <= n (since sum includes x itself maybe)
    for x in range(1, n+1):
        # get divisors of x
        divs = sp.divisors(x)
        if len(divs) < 3:
            continue
        # need three distinct divisors sum to n
        # iterate combinations
        for a in range(len(divs)):
            for b in range(a+1, len(divs)):
                for c in range(b+1, len(divs)):
                    if divs[a] + divs[b] + divs[c] == n:
                        return x
    return None

def f_formula(n):
    # candidate using divisor of n-1
    # find largest divisor d of n-1 with d < (n-1)/2
    m = n-1
    # get all divisors
    divs = sp.divisors(m)
    # filter d < m/2
    candidates = [d for d in divs if d < m/2]
    if not candidates:
        return None
    d_max = max(candidates)
    x = n - 1 - d_max
    return x

# test for n from 6 to 200
fails = []
for n in range(6, 201):
    f1 = f_bruteforce(n)
    f2 = f_formula(n)
    if f1 != f2:
        fails.append((n, f1, f2))
fails[:20], len(fails)
```

