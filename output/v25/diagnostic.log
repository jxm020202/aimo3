            def check_divisible_by(N, c):
                # check if N divides S = M + c
                # N may have factor 3
                # We'll use condition: N = 3^k * d, d coprime to 3
                # Check c divisible by 3^k and (c+1) divisible by d
                # return True/False
                # factor N
                k = 0
                temp = N
                while temp % 3 == 0:
