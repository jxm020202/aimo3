from itertools import combinations

def guarantee(state):
    state = tuple(sorted(state))
    n = len(state)
    if condition(state):
        return n
    best = -1
    for i,j in combinations(range(n),2):
        x = state[i]; y = state[j]
        rest = list(state)
        del rest[j]; del rest[i]
        sum_state = normalize(tuple(rest + [x+y]))
        diff_state = normalize(tuple(rest + [abs(x-y)]))
        g_sum = guarantee(sum_state)
        g_diff = guarantee(diff_state)
        worst = min(g_sum, g_diff)
        if worst > best:
            best = worst
    return best

def guarantee_N(N):
    return guarantee(tuple([1]*N))

