            import sympy as sp
            
            def is_power_of_p(x, p):
                # returns exponent if x is p^k, else None
                if x <=0:
                    return None
                k=0
                while x%p==0:
                    x//=p
                    k+=1
                if x==1:
                    return k
                return None
            
