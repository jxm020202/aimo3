            def intersect_segment(p1, p2):
                # line y=2x: param t for segment p = p1 + u*(p2-p1)
                x1,y1 = p1
                x2,y2 = p2
                # solve for u such that y1 + u*(y2-y1) = 2*(x1 + u*(x2-x1))
                # => y1 + u*dy = 2x1 + 2u*dx
                # => u*dy - 2u*dx = 2x1 - y1
                # => u*(dy - 2dx) = 2x1 - y1
                dx = x2 - x1
                dy = y2 - y1
                denom = dy - 2*dx
                if abs(denom) < 1e-9:
                    return None
                u = (2*x1 - y1) / denom
                if 0 <= u <= 1:
