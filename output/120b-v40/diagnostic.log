                        # check common neighbor
                        if adj[u] & adj[v]:
                            e3+=1
                return e1 - e3
            
            def random_triangle_free(N, steps=10000):
                edges = set()
                # maintain adjacency
                adj = [set() for _ in range(N)]
                # random order of possible edges
                all_edges = [(i,j) for i in range(N) for j in range(i+1,N)]
                random.shuffle(all_edges)
                for (i,j) in all_edges:
                    # can we add edge without creating triangle?
                    if any(k in adj[i] for k in adj[j]): # there exists common neighbor => triangle
                        continue
                    # add edge
                    edges.add((i,j))
                    adj[i].add(j)
                    adj[j].add(i)
                return edges
            
