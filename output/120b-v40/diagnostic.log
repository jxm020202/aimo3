            import itertools, math, sys, random, time, numpy as np, math, itertools, collections, fractions, functools, sys, math, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            def min_total_sum(n):
                # edges indexed
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variables: for each edge three variables (x1,x2,x3)
                # total variables = 3*m
                c = np.array([1]*m + [2]*m + [3]*m, dtype=float)  # order: first m x1, then m x2, then m x3
                # constraints
                A_eq = []
                b_eq = []
                # each edge sum to 1
                for e_idx in range(m):
                    row = np.zeros(3*m)
                    row[e_idx] = 1
                    row[m+e_idx] = 1
                    row[2*m+e_idx] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # triangle constraints: sum >=5
                A_ub = []
                b_ub = []
                # we will convert >= to <= by multiplying -1
                for (i,j,k) in itertools.combinations(range(n),3):
                    # edges indices
                    def edge_index(a,b):
                        if a>b: a,b=b,a
                        return edges.index((a,b))
                    e1 = edge_index(i,j)
                    e2 = edge_index(i,k)
                    e3 = edge_index(j,k)
                    row = np.zeros(3*m)
                    # coefficients are 1*x1 +2*x2+3*x3
                    for e in (e1,e2,e3):
                        row[e] += 1
                        row[m+e] += 2
                        row[2*m+e] += 3
                    # constraint: row·x >=5 -> -row·x <= -5
                    A_ub.append(-row)
                    b_ub.append(-5)
                # bounds 0/1 integer
                bounds = Bounds(0,1)
                integrality = np.ones(3*m)
                res = milp(c=c, constraints=[LinearConstraint(np.vstack(A_eq), b_eq, b_eq),
                                             LinearConstraint(np.vstack(A_ub), -np.inf, np.array(b_ub))],
                            bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    return None
                total = sum(c[i]*res.x[i] for i in range(3*m))
                return int(round(total))
            
            for n in range(3,9):
                t = min_total_sum(n)
                print(n, t, t/(n*(n-1)/2))
            
