            def min_avg_backtrack(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                edge_index = {e:i for i,e in enumerate(edges)}
                m=len(edges)
                # list of triangles as list of edge indices
                tri_edges=[]
                for a in range(n):
                    for b in range(a+1,n):
                        for c in range(b+1,n):
                            e1=edge_index[(a,b)]
                            e2=edge_index[(a,c)]
                            e3=edge_index[(b,c)]
                            tri_edges.append((e1,e2,e3))
                best_sum = None
                assign = [0]*m
                # order edges maybe heuristics: none
                def backtrack(idx):
                    nonlocal best_sum
                    if idx==m:
                        total=sum(assign)
                        if best_sum is None or total<best_sum:
                            best_sum=total
                        return
                    # try values 1,2,3
                    for val in (1,2,3):
                        assign[idx]=val
