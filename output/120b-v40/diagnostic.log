            import numpy as np, math, itertools
            from scipy.optimize import linprog
            
            def inside_hull(m):
                if m%2!=0:
                    return False
                V = m/2 + 2
                a_avg = m / V
                b_avg = 2*m / V
                # Actually a_avg = m / V, b_avg = 2m / V
                # compute as floats
                a_avg = m / V
                b_avg = 2*m / V
                # Use hull vertices as points
                hull_pts = np.array([[0,3],[3,0],[11,0],[9,1],[4,3],[1,4],[0,4]], dtype=float)
                n = hull_pts.shape[0]
                # variables w_i >=0
                # constraints: sum w_i = 1, sum w_i * a_i = a_avg, sum w_i * b_i = b_avg
                # We'll set up linear programming to find feasible w.
                c = np.zeros(n)  # objective zero
                A_eq = np.vstack([np.ones(n), hull_pts[:,0], hull_pts[:,1]])
                b_eq = np.array([1, a_avg, b_avg])
                bounds = [(0, None)]*n
                res = linprog(c, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
                return res.success
            
            for m in range(2,200,2):
