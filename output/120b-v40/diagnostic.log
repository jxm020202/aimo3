            import math, numpy as np
            
            # define side lengths ratio
            b = 1.0
            a = (math.sqrt(6)+math.sqrt(2))/2 * b
            
            n = 11
            R = b/(2*math.sin(math.pi/n))
            h = math.sqrt(a**2 - R**2)
            # vertices of base regular n-gon in xy-plane
            base_vertices = [(R*math.cos(2*math.pi*k/n), R*math.sin(2*math.pi*k/n), 0) for k in range(n)]
            # apexes
            top = (0,0,h)
            bottom = (0,0,-h)
            
            # Build faces: each base edge (i,i+1) with top and bottom
            faces = []
            for i in range(n):
                j = (i+1)%n
                # triangle top-i-j
                faces.append([top, base_vertices[i], base_vertices[j]])
                # triangle bottom-i-j
                faces.append([bottom, base_vertices[i], base_vertices[j]])
            
            def angle_between(v1,v2):
                dot = np.dot(v1,v2)
                n1 = np.linalg.norm(v1)
                n2 = np.linalg.norm(v2)
                return math.degrees(math.acos(dot/(n1*n2)))
            
            def face_angles(face):
                # compute side lengths
                A,B,C = [np.array(p) for p in face]
                # sides opposite vertices
                a_len = np.linalg.norm(B-C)
                b_len = np.linalg.norm(A-C)
                c_len = np.linalg.norm(A-B)
                # compute angles using law of cosines
                # angle at A opposite a_len
                angleA = math.degrees(math.acos((b_len**2 + c_len**2 - a_len**2)/(2*b_len*c_len))
                angleB = math.degrees(math.acos((a_len**2 + c_len**2 - b_len**2)/(2*a_len*c_len))
                )
                angleC = 180 - angleA - angleB
                return sorted([angleA, angleB, angleC])
            
            angles = [face_angles(f) for f in faces]
            angles[:5]
            
