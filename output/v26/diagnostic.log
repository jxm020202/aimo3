import itertools
import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds

# Board dimensions
R, C = 15, 15
N = R * C

# Helper to convert (r,c) to index
def idx(r, c):
    return r * C + c

# Generate list of neighbor pairs (Chebyshev distance <= 2, excluding self)
neighbors = []
for r in range(R):
    for c in range(C):
        i = idx(r, c)
        for dr in range(-2, 3):
            for dc in range(-2, 3):
                if dr == 0 and dc == 0:
                    continue
                nr, nc = r + dr, c + dc
                if 0 <= nr < R and 0 <= nc < C:
                    j = idx(nr, nc)
                    if i < j:  # store each unordered pair once
                        neighbors.append((i, j))

M = len(neighbors)
print("Number of vertices:", N, "Number of neighbor pairs:", M)

# Variables:
# x_i for each vertex (piece present)
# y_k for each neighbor pair (i,j) indicating they are matched
# We'll order variables as [x_0,...,x_{N-1}, y_0,...,y_{M-1}]
num_vars = N + M

# Objective: maximize sum x_i (or 2*sum y_k)
c = np.zeros(num_vars)
c[:N] = -1.0   # minimize negative to maximize (milp solves min)
# Could also set c[N:] = -2, but maximizing sum x is enough

# Constraints list
A = []
lb = []
ub = []

# 1) For each vertex i: sum_{j neighbor of i} y_{ij} <= 1
# Build adjacency list of neighbor pair indices for each vertex
adj_y_indices = [[] for _ in range(N)]
for k, (i, j) in enumerate(neighbors):
    adj_y_indices[i].append(k)
    adj_y_indices[j].append(k)

for i in range(N):
    row = np.zeros(num_vars)
    for k in adj_y_indices[i]:
        row[N + k] = 1.0
    A.append(row)
    lb.append(-np.inf)
    ub.append(1.0)

# 2) y_{ij} <= x_i and y_{ij} <= x_j
for k, (i, j) in enumerate(neighbors):
    # y - x_i <= 0
    row = np.zeros(num_vars)
    row[N + k] = 1.0
    row[i] = -1.0
    A.append(row); lb.append(-np.inf); ub.append(0.0)
    # y - x_j <= 0
    row = np.zeros(num_vars)
    row[N + k] = 1.0
    row[j] = -1.0
    A.append(row); lb.append(-np.inf); ub.append(0.0)

# 3) For each neighbor pair (i,j): x_i + x_j <= 1 + y_{ij}
# This enforces that if both vertices are selected, they must be matched.
for k, (i, j) in enumerate(neighbors):
    row = np.zeros(num_vars)
    row[i] = 1.0
    row[j] = 1.0
    row[N + k] = -1.0
    A.append(row); lb.append(-np.inf); ub.append(1.0)

# Variable bounds: x_i binary, y_k binary
lb_vars = np.zeros(num_vars)
ub_vars = np.ones(num_vars)

# Convert constraints to arrays
A = np.array(A)
lb = np.array(lb)
ub = np.array(ub)

lin_con = LinearConstraint(A, lb, ub)

bounds = Bounds(lb_vars, ub_vars)

res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=np.arange(num_vars))
print("MILP status:", res.success)
if res.success:
    x_vals = np.round(res.x[:N]).astype(int)
    y_vals = np.round(res.x[N:]).astype(int)
    n_pieces = x_vals.sum()
    print("Maximum number of pieces:", n_pieces)
    # extract pairs
    pairs = [(i, j) for k, (i, j) in enumerate(neighbors) if y_vals[k] == 1]
    print("Number of pairs:", len(pairs))
    # optionally display board
    board = np.full((R, C), '.', dtype=str)
    for i in range(N):
        if x_vals[i]:
            r, c = divmod(i, C)
            board[r, c] = 'X'
    print("\n".join("".join(row) for row in board))
```

