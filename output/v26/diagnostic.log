    N=m*n
    # adjacency edges
    edges=[]
    for i in range(m):
        for j in range(n):
            idx=i*n+j
            if i+1<m:
                edges.append((idx, (i+1)*n+j))
            if j+1<n:
                edges.append((idx, i*n+(j+1)))
    num_vars = N*N
    # Build equality constraints for each cell and each number
    rows_eq=[]
    rhs_eq=[]
    # each cell gets one number
    for cell in range(N):
        row = np.zeros(num_vars, dtype=int)
        for k in range(1,N+1):
            row[cell*N + (k-1)] = 1
        rows_eq.append(row)
        rhs_eq.append(1)
    # each number assigned once
    for k in range(1,N+1):
        row = np.zeros(num_vars, dtype=int)
        for cell in range(N):
            row[cell*N + (k-1)] = 1
        rows_eq.append(row)
        rhs_eq.append(1)
    A_eq = np.array(rows_eq, dtype=float)
    b_eq = np.array(rhs_eq, dtype=float)
    # equality constraints via LinearConstraint with lower=upper=b_eq
    eq_con = LinearConstraint(A_eq, b_eq, b_eq)
    # binary integrality
    integrality = np.ones(num_vars, dtype=int)
    bounds = Bounds(0,1)
    # binary search on S
    low=0
    high=2*N
    best=0
    while low<=high:
        mid=(low+high)//2
        # edge constraints
        rows_edge=[]
        lbs=[]
        ubs=[]
        for (i,j) in edges:
            row = np.zeros(num_vars, dtype=int)
            for k in range(1,N+1):
                row[i*N + (k-1)] = k
                row[j*N + (k-1)] = k
            rows_edge.append(row)
            lbs.append(mid)
            ubs.append(np.inf)
        A_edge = np.array(rows_edge, dtype=float)
        lc_edge = LinearConstraint(A_edge, lbs, ubs)
        # combine constraints
        constraints = [eq_con, lc_edge]
        res = milp(c=np.zeros(num_vars), constraints=constraints, integrality=integrality, bounds=bounds, options={'disp': False})
        if res.success:
            best=mid
            low=mid+1
        else:
            high=mid-1
    return best

