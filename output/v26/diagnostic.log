def max_min_sum(m,n):
    N=m*n
    # generate all permutations (N! huge) - only for very small sizes
    maxS=0
    best=None
    cells=[(i,j) for i in range(m) for j in range(n)]
    # adjacency list
    adj={}
    for i,j in cells:
        neigh=[]
        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
            ni,nj=i+di,j+dj
            if 0<=ni<m and 0<=nj<n:
                neigh.append((ni,nj))
        adj[(i,j)]=neigh
    for perm in itertools.permutations(range(1,N+1)):
        label={}
        for (cell,val) in zip(cells,perm):
            label[cell]=val
        min_sum=math.inf
        for cell in cells:
            for nb in adj[cell]:
                if cell<nb: # each edge once
                    s=label[cell]+label[nb]
                    if s<min_sum:
                        min_sum=s
        if min_sum>maxS:
            maxS=min_sum
            best=perm
    return maxS

