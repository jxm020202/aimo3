from scipy.optimize import milp, LinearConstraint, Bounds

def feasible_grid(m,n,S):
    N=m*n
    cells = [(i,j) for i in range(m) for j in range(n)]
    cell_index = {c: idx for idx,c in enumerate(cells)}
    # variables x_{c,k} flattened: index = c_idx * N + (k-1)
    num_vars = N*N
    # objective: none (just feasibility)
    c = np.zeros(num_vars)
    # constraints list
    A_eq = []
    b_eq = []
    # each cell assigned exactly one number
    for ci in range(N):
        row = np.zeros(num_vars)
        row[ci*N:(ci+1)*N] = 1
        A_eq.append(row)
        b_eq.append(1)
    # each number assigned to exactly one cell
    for k in range(N):
        row = np.zeros(num_vars)
        row[k::N] = 1
        A_eq.append(row)
        b_eq.append(1)
    # edge constraints
    # compute edges
    edges=[]
    for i in range(m):
        for j in range(n):
            if i+1<m:
                edges.append(((i,j),(i+1,j)))
            if j+1<n:
                edges.append(((i,j),(i,j+1)))
    # for each edge, for each pair (a,b) with a+b < S, add constraint
    A_ub = []
    b_ub = []
    for (c1,c2) in edges:
        idx1 = cell_index[c1]
        idx2 = cell_index[c2]
        for a in range(1,N+1):
            for b in range(1,N+1):
                if a+b < S:
                    row = np.zeros(num_vars)
                    row[idx1*N + (a-1)] = 1
                    row[idx2*N + (b-1)] = 1
                    A_ub.append(row)
                    b_ub.append(1)  # at most one of them can be assigned
    # Build constraints
    A_eq = np.array(A_eq)
    b_eq = np.array(b_eq)
    if A_ub:
        A_ub = np.array(A_ub)
        b_ub = np.array(b_ub)
    else:
        A_ub = None
        b_ub = None
    # variable bounds 0-1 integer
    bounds = Bounds(0,1)
    integrality = np.ones(num_vars, dtype=int)
    res = milp(c=c, constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                               LinearConstraint(A_ub, -np.inf, b_ub) if A_ub is not None else None],
                bounds=bounds, integrality=integrality, options={'disp': False})
    return res.success

