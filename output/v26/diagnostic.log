def initial_grid(rows, cols):
    N=rows*cols
    half=N//2
    # compute degrees
    deg={}
    black=[]
    white=[]
    for r in range(rows):
        for c in range(cols):
            d=0
            if r>0: d+=1
            if r<rows-1: d+=1
            if c>0: d+=1
            if c<cols-1: d+=1
            deg[(r,c)]=d
            if (r+c)%2==0:
                black.append((r,c))
            else:
                white.append((r,c))
    # assign smallest numbers to black cells sorted by degree asc
    black_sorted = sorted(black, key=lambda rc: deg[rc])
    grid=[[0]*cols for _ in range(rows)]
    for i, (r,c) in enumerate(black_sorted):
        grid[r][c]=i+1
    # assign remaining numbers to white cells arbitrarily (descending)
    remaining = list(range(half+1, N+1))
    # assign descending to give larger numbers near low black cells?
    # we can assign random for now
    random.shuffle(remaining)
    for (r,c), val in zip(white, remaining):
        grid[r][c]=val
    return grid

def min_adj_sum_grid(grid):
    rows=len(grid); cols=len(grid[0])
    mins=10**9
    for r in range(rows):
        for c in range(cols):
            v=grid[r][c]
            if r+1<rows:
                mins=min(mins, v+grid[r+1][c])
            if c+1<cols:
                mins=min(mins, v+grid[r][c+1])
    return mins

def simulated_annealing_grid(rows, cols, max_iter=200000):
    grid = initial_grid(rows, cols)
    cur_min = min_adj_sum_grid(grid)
    best = cur_min
    best_grid = [row[:] for row in grid]
    positions = [(r,c) for r in range(rows) for c in range(cols)]
    start=time.time()
    for it in range(max_iter):
        # temperature schedule
        t = 1.0 - it/max_iter
        (r1,c1),(r2,c2) = random.sample(positions,2)
        # swap
        grid[r1][c1], grid[r2][c2] = grid[r2][c2], grid[r1][c1]
        new_min = min_adj_sum_grid(grid)
        # accept if better or with probability
