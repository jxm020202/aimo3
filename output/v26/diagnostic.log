    cells_black.sort(key=lambda ij: deg[ij])  # ascending degree
    cells_white.sort(key=lambda ij: -deg[ij])  # descending degree for white (high degree get high numbers)
    # assign numbers
    grid = np.zeros((m,n), dtype=int)
    # assign smallest numbers to black cells (ascending degree)
