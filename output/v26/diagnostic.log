    b_eq = np.array(b_eq, dtype=float)
    # inequality constraints
    rows=[]
    rhs=[]
    for (u_cell, v_cell) in edges:
        u = cell_idx[u_cell]
        v = cell_idx[v_cell]
        for a in range(1,N+1):
            for b in range(1,N+1):
                if a+b < S:
                    row = np.zeros(var_count, dtype=int)
                    row[u*N + (a-1)] = 1
                    row[v*N + (b-1)] = 1
                    rows.append(row)
                    rhs.append(1)
    if rows:
        A_ub = np.array(rows, dtype=float)
        b_ub = np.array(rhs, dtype=float)
    else:
        A_ub = None
        b_ub = None
    bounds = Bounds(0,1)
    integrality = np.ones(var_count, dtype=int)
    constraints = [LinearConstraint(A_eq, b_eq, b_eq)]
    if A_ub is not None:
        constraints.append(LinearConstraint(A_ub, -np.inf, b_ub))
    res = milp(c=np.zeros(var_count), constraints=constraints, integrality=integrality, bounds=bounds)
    if not res.success:
        return None
    # extract assignment
    x = res.x
    assign = {}
    for v in range(N):
        for k in range(N):
            if round(x[v*N + k]) == 1:
                assign[cells[v]] = k+1
                break
    return assign

