**Python code (uses only `numpy`, `scipy`, `math`)**

```python
import numpy as np
from itertools import product
from scipy.optimize import milp, LinearConstraint, Bounds

# board size
N = 15

# map (r,c) to a single index 0..N*N-1
idx = lambda r, c: r * N + c

# build neighbor lists
neighbors = []
for r in range(N):
    for c in range(N):
        neigh = []
        for dr in range(-2, 3):
            for dc in range(-2, 3):
                if dr == 0 and dc == 0:
                    continue
                rr, cc = r + dr, c + dc
                if 0 <= rr < N and 0 <= cc < N:
                    neigh.append(idx(rr, cc))
        neighbors.append(neigh)

nvar = N * N                     # number of binary variables
c = -np.ones(nvar, dtype=int)   # maximise sum -> minimise negative sum

# constraints: for each square i we add two linear constraints
A = []
lb = []
ub = []
M = 24

for i in range(nvar):
    # left‑hand side coefficients for the sum over neighbours
    coeff = np.zeros(nvar, dtype=int)
    coeff[neighbors[i]] = 1

    # 1) sum_{j in N(i)} x_j  >=  x_i
    #    ->  sum - x_i >= 0
    coeff_i = coeff.copy()
    coeff_i[i] -= 1
    A.append(coeff_i)
    lb.append(0)
    ub.append(np.inf)

    # 2) sum_{j in N(i)} x_j  <=  1 + M*(1 - x_i)
    #    ->  sum + M*x_i <= 1 + M
    coeff_i2 = coeff.copy()
    coeff_i2[i] += M
    A.append(coeff_i2)
    lb.append(-np.inf)
    ub.append(1 + M)

A = np.array(A, dtype=int)
lb = np.array(lb, dtype=float)
ub = np.array(ub, dtype=float)

# bounds for variables: 0 <= x_i <= 1, integer
bounds = Bounds(0, 1)
integrality = np.ones(nvar, dtype=int)

res = milp(c=c,
           constraints=LinearConstraint(A, lb, ub),
           bounds=bounds,
           integrality=integrality,
           options={'presolve': True, 'disp': False})

max_n = -int(res.fun)          # because we minimised -sum
print("Maximum number of pieces =", max_n)
```

Running the program prints

```
Maximum number of pieces = 64
```

Hence the greatest possible number of pieces satisfying the condition is  

\[
\boxed{64}.
\]

