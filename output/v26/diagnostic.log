def min_adjacent_sum(grid):
    # grid shape (m,n)
    m,n = grid.shape
    min_sum = 10**9
    # horizontal edges
    hs = grid[:, :-1] + grid[:, 1:]
    min_sum = min(min_sum, hs.min())
    # vertical edges
    vs = grid[:-1, :] + grid[1:, :]
    min_sum = min(min_sum, vs.min())
    return int(min_sum)

def compute_min_sum(grid):
    return min_adjacent_sum(grid)

def random_grid(m=60,n=60):
    nums = np.arange(1,m*n+1)
    np.random.shuffle(nums)
    return nums.reshape((m,n))

def hill_climb(iterations=100000):
    m=n=60
    grid = random_grid(m,n)
    best = compute_min_sum(grid)
    best_grid = grid.copy()
    # Precompute neighbor indices for each cell for quick update
    # We'll compute min sum each time O(E) which is okay for moderate iterations
    start = time.time()
    for it in range(iterations):
        # pick two random cells to swap
        i1,j1 = random.randint(0,m-1), random.randint(0,n-1)
        i2,j2 = random.randint(0,m-1), random.randint(0,n-1)
        if i1==i2 and j1==j2:
            continue
        # swap
        grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
        cur = compute_min_sum(grid)
        if cur >= best:
            best = cur
            best_grid = grid.copy()
            # keep swap
        else:
            # revert swap
            grid[i1,j1], grid[i2,j2] = grid[i2,j2], grid[i1,j1]
        # optionally break if best reaches high value
        if it%10000==0:
            print(it, best, time.time()-start)
    return best, best_grid

best_val, best_grid = hill_climb(20000)
