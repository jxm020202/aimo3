def find_labeling(m,n,S):
    N=m*n
    cells = [(i,j) for i in range(m) for j in range(n)]
    edges=[]
    for i in range(m):
        for j in range(n):
            if i+1<m:
                edges.append(((i,j),(i+1,j)))
            if j+1<n:
                edges.append(((i,j),(i,j+1)))
    # backtrack assign numbers to cells
    # order cells by degree descending to prune early
    deg = {}
    for cell in cells:
        d=0
        i,j=cell
        if i>0: d+=1
        if i<m-1: d+=1
        if j>0: d+=1
        if j<n-1: d+=1
        deg[cell]=d
    cells_sorted = sorted(cells, key=lambda c: -deg[c])
    used = [False]*(N+1)
    assign = {}
    def backtrack(idx):
        if idx==len(cells_sorted):
            return True
        cell = cells_sorted[idx]
        # try numbers from 1..N
        for num in range(1,N+1):
            if not used[num]:
                # check constraints with already assigned neighbors
                ok=True
                i,j=cell
                for di,dj in [(-1,0),(1,0),(0,-1),(0,1)]:
                    ni,nj=i+di,j+dj
                    if 0<=ni<m and 0<=nj<n:
                        neighbor=(ni,nj)
                        if neighbor in assign:
                            if assign[neighbor]+num < S:
                                ok=False
                                break
                if not ok:
                    continue
                # assign
                assign[cell]=num
                used[num]=True
                if backtrack(idx+1):
                    return True
                # undo
                del assign[cell]
                used[num]=False
        return False
    if backtrack(0):
        return assign
    else:
        return None

