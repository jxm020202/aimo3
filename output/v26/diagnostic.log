from scipy.optimize import milp, LinearConstraint, Bounds

def max_S_ilp(m,n):
    N=m*n
    # map cell index to (i,j)
    cells = [(i,j) for i in range(m) for j in range(n)]
    cell_idx = {cell:i for i,cell in enumerate(cells)}
    # adjacency list edges (undirected)
    edges=[]
    dirs=[(1,0),(-1,0),(0,1),(0,-1)]
    for i in range(m):
        for j in range(n):
            for di,dj in [(1,0),(0,1)]:
                ni,nj=i+di,j+dj
                if 0<=ni<m and 0<=nj<n:
                    edges.append(((i,j),(ni,nj)))
    # binary variables x_{v,k} flattened
    # total variables = N*N
    var_count = N*N
    # constraints: each cell gets exactly one number
    A_eq = []
    b_eq = []
    # each cell constraint
    for v in range(N):
        row = [0]*var_count
        for k in range(N):
            row[v*N + k] = 1
        A_eq.append(row)
        b_eq.append(1)
    # each number assigned once
    for k in range(N):
        row = [0]*var_count
        for v in range(N):
            row[v*N + k] = 1
        A_eq.append(row)
        b_eq.append(1)
    # convert to numpy arrays
    A_eq = np.array(A_eq, dtype=float)
    b_eq = np.array(b_eq, dtype=float)
    # bounds 0-1 integer
    bounds = Bounds(0,1)
    integrality = np.ones(var_count, dtype=int)
    # binary search S
    low=0
    high=2*N
    best=0
    while low<=high:
        mid=(low+high)//2
        # edge constraints: for each edge (u,v) and each pair (a,b) with a+b < mid, forbid
        # We'll add constraints: x_{u,a} + x_{v,b} <= 1
        rows=[]
        rhs=[]
        for (cell_u, cell_v) in edges:
            u = cell_idx[cell_u]
            v = cell_idx[cell_v]
            for a in range(1,N+1):
                for b in range(1,N+1):
                    if a+b < mid:
                        row = [0]*var_count
                        row[u*N + (a-1)] = 1
                        row[v*N + (b-1)] = 1
                        rows.append(row)
                        rhs.append(1)
        if rows:
            A_ub = np.array(rows, dtype=float)
            b_ub = np.array(rhs, dtype=float)
        else:
            A_ub = None
            b_ub = None
        # solve MILP
        res = milp(c=np.zeros(var_count), constraints=[LinearConstraint(A_eq, b_eq, b_eq)], bounds=bounds,
                   integrality=integrality, A_ub=A_ub, b_ub=b_ub, options={'presolve': True})
        if res.success:
            best=mid
            low=mid+1
        else:
            high=mid-1
    return best

