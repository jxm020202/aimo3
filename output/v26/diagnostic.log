def max_S_grid(m, n):
    N = m*n
    # colors: parity (i+j)%2 == 0 -> black (high numbers)
    # We'll assign low numbers to white cells (parity 1)
    # Determine white cells list with degree
    white_cells = []
    black_cells = []
    # adjacency directions
    dirs = [(1,0),(-1,0),(0,1),(0,-1)]
    for i in range(m):
        for j in range(n):
            deg = 0
            for di,dj in dirs:
                ni, nj = i+di, j+dj
                if 0 <= ni < m and 0 <= nj < n:
                    deg += 1
            if (i+j) % 2 == 0:
                black_cells.append(((i,j), deg))
            else:
                white_cells.append(((i,j), deg))
    # sort white cells by degree ascending (2,3,4)
    white_cells.sort(key=lambda x: x[1])
    # map from cell to index for black cells
    black_index = {cell: idx for idx, (cell, deg) in enumerate(black_cells)}
    # adjacency list for white to black
    white_adj = []
    for (cell, deg) in white_cells:
        i,j = cell
        neigh = []
        for di,dj in dirs:
            ni, nj = i+di, j+dj
            if 0 <= ni < m and 0 <= nj < n:
                if (ni+nj)%2==0: # black neighbor
                    neigh.append((ni,nj))
        white_adj.append(neigh)
    # binary search S
    low = 0
    high = 2*N  # upper bound maybe 2N
    best = 0
    while low <= high:
        mid = (low+high)//2
        # assign low numbers to white cells in order
        w_vals = {}
        for idx, ((cell, deg), val) in enumerate(zip(white_cells, range(1, len(white_cells)+1))):
            w_vals[cell] = val
        # compute lower bounds for black cells
        L = [ -10**9 ] * len(black_cells)
        for idx, ((cell, deg), neigh) in enumerate(zip(white_cells, white_adj)):
            w = w_vals[cell]
            for bcell in neigh:
                bidx = black_index[bcell]
                L[bidx] = max(L[bidx], mid - w)
        # replace -inf with -inf? Actually if no constraint, L can be -inf, treat as -inf (any number works)
        # We'll set to -inf -> -1e9, but high numbers are >=1801, so fine.
        # Now check feasibility with high numbers
        high_numbers = list(range(N//2 + 1, N+1))  # assuming N even, low numbers 1..N/2, high numbers N/2+1..N
        # sort L ascending
        L_sorted = sorted(L)
        # greedy assign
        feasible = True
        hi_idx = 0
        for bound in L_sorted:
            # find first high number >= bound
            # skip numbers less than bound
            while hi_idx < len(high_numbers) and high_numbers[hi_idx] < bound:
                hi_idx += 1
            if hi_idx == len(high_numbers):
                feasible = False
                break
            # assign this number
            hi_idx += 1
        if feasible:
            best = mid
            low = mid + 1
        else:
            high = mid - 1
    return best

