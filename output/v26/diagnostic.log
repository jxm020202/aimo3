            feasible = res.success
        except Exception as e:
            print("Error", e)
            feasible=False
        if feasible:
            low=mid
        else:
            high=mid-1
        # clean up large arrays to free memory
        del A, A_rows, row, c, constraints, bounds, integrality, res
    return low

