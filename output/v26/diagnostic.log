        new_grid = best.copy()
        new_grid[i1,j1], new_grid[i2,j2] = new_grid[i2,j2], new_grid[i1,j1]
        new_score = min_adj_sum(new_grid)
        if new_score > best_score:
            best = new_grid
            best_score = new_score
            #print("improved", best_score)
