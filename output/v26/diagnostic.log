    # remaining low numbers (if any) assigned to higher-degree cells (should be none)
    # now assign high numbers to white cells: we want largest high numbers to high-degree cells (interior), smallest high numbers to low-degree cells (corners)
    white_cells_sorted = sorted(white_cells, key=lambda cell: degree(cell), reverse=True)  # high degree first
    high_numbers_sorted = sorted(high_numbers)
    # assign largest high numbers to high-degree cells
    idx = len(high_numbers_sorted)-1
    for cell in white_cells_sorted:
        assign[cell] = high_numbers_sorted[idx]
        idx -= 1
    return assign

def min_adjacent_sum(assign, rows, cols):
    edges = []
    for r in range(rows):
