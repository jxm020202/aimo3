def max_S_grid(m,n):
    N=m*n
    positions = [(i,j) for i in range(m) for j in range(n)]
    edges = []
    for i in range(m):
        for j in range(n):
            if i+1<m:
                edges.append(((i,j),(i+1,j)))
            if j+1<n:
                edges.append(((i,j),(i,j+1)))
    maxS=0
    best=None
    for perm in itertools.permutations(range(1,N+1)):
        grid = {}
        for pos,val in zip(positions,perm):
            grid[pos]=val
        min_sum = min(grid[a]+grid[b] for a,b in edges)
        if min_sum>maxS:
            maxS=min_sum
            best=perm
    return maxS, best

