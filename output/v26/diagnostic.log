def min_adj_sum_grid(grid, rows, cols):
    mins = 10**9
    for r in range(rows):
        for c in range(cols):
            v = grid[r][c]
            if r+1<rows:
                mins = min(mins, v + grid[r+1][c])
            if c+1<cols:
                mins = min(mins, v + grid[r][c+1])
    return mins

def simulated_annealing_grid(rows, cols, max_iter=200000):
    N = rows*cols
    # initial assignment: low numbers on black cells, high on white cells
    # create list of positions
    positions = [(r,c) for r in range(rows) for c in range(cols)]
    # color parity
    black_positions = [(r,c) for r,c in positions if (r+c)%2==0]
    white_positions = [(r,c) for r,c in positions if (r+c)%2==1]
    # assign numbers: 1..len(black) to black, rest to white
    perm = [[0]*cols for _ in range(rows)]
    nums = list(range(1,N+1))
    random.shuffle(nums)
    # simple random initial
    idx=0
    for r,c in positions:
        perm[r][c]=nums[idx]; idx+=1
    cur_min = min_adj_sum_grid(perm, rows, cols)
    best = cur_min
    best_grid = [row[:] for row in perm]
    start_time = time.time()
    for it in range(max_iter):
        # temperature schedule
        t = 1.0 - it/max_iter
        # random swap two cells
        (r1,c1),(r2,c2) = random.sample(positions,2)
        # swap
        perm[r1][c1], perm[r2][c2] = perm[r2][c2], perm[r1][c1]
        new_min = min_adj_sum_grid(perm, rows, cols)
        # accept if better or with probability
        if new_min > cur_min or random.random() < math.exp((new_min - cur_min)/ (1 + 1000*t)):
            cur_min = new_min
            if new_min > best:
                best = new_min
                best_grid = [row[:] for row in perm]
        else:
            # revert swap
            perm[r1][c1], perm[r2][c2] = perm[r2][c2], perm[r1][c1]
    return best, best_grid

# test on smaller grid to see performance
