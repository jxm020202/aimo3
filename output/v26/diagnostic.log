def max_min_adj_sum_hc(rows, cols, iterations=20000):
    N=rows*cols
    # initial random assignment
    perm=list(range(1,N+1))
    random.shuffle(perm)
    # compute adjacency list
    adj=[]
    for r in range(rows):
        for c in range(cols):
            idx=r*cols+c
            neigh=[]
            if r>0: neigh.append(((r-1)*cols+c))
            if r<rows-1: neigh.append(((r+1)*cols+c))
            if c>0: neigh.append((r*cols+(c-1)))
            if c<cols-1: neigh.append((r*cols+(c+1)))
            adj.append(neigh)
    def min_adj(p):
        m=10**9
        for i, neigh in enumerate(adj):
            for j in neigh:
                if i<j:
                    s=p[i]+p[j]
                    if s<m:
                        m=s
        return m
    best=min_adj(perm)
    best_perm=perm[:]
    for it in range(iterations):
        # random swap
        i,j=random.sample(range(N),2)
        perm[i],perm[j]=perm[j],perm[i]
        cur=min_adj(perm)
        if cur>best:
            best=cur
            best_perm=perm[:]
        # accept if not worse? simple hill climbing: keep if improves else revert
        if cur<best:
            # revert
            perm[i],perm[j]=perm[j],perm[i]
    return best, best_perm

