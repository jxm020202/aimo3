assistantanalysisdef construct_feasible_debug(m,n,S):
    N=m*n
    dirs = [(1,0),(-1,0),(0,1),(0,-1)]
    black_cells=[]
    white_cells=[]
    for i in range(m):
        for j in range(n):
            deg = sum(0 <= i+di < m and 0 <= j+dj < n for di,dj in dirs)
            if (i+j)%2==0:
                black_cells.append(((i,j), deg))
            else:
                white_cells.append(((i,j), deg))
    black_cells.sort(key=lambda x: x[1])
    # assign low numbers to black cells
    assign={}
    for idx, ((cell, deg), val) in enumerate(zip(black_cells, range(1, len(black_cells)+1))):
        assign[cell]=val
    # compute lower bounds for white cells
    white_index={cell: idx for idx, (cell, deg) in enumerate(white_cells)}
    L=[-10**9]*len(white_cells)
    for (bcell, deg) in black_cells:
        bval=assign[bcell]
        i,j=bcell
        for di,dj in dirs:
            ni,nj=i+di,j+dj
            if 0 <= ni < m and 0 <= nj < n and (ni+nj)%2==1:
                widx=white_index[(ni,nj)]
                L[widx]=max(L[widx], S - bval)
    # assign high numbers
    high_numbers=list(range(N//2+1, N+1))
    order=sorted(range(len(white_cells)), key=lambda i: L[i])
    for idx in order:
        bound=L[idx]
        # find smallest high >= bound
        for i,num in enumerate(high_numbers):
            if num >= bound:
                assign[white_cells[idx][0]] = num
                high_numbers.pop(i)
                break
    return assign

