def generate_configuration():
    pieces = []
    for br in [0,4,8]:
        for bc in [0,4,8]:
            # top-left horizontal pair
            pieces.append((br, bc))
            pieces.append((br, bc+1))
            # bottom-right horizontal pair
            pieces.append((br+3, bc+2))
            pieces.append((br+3, bc+3))
    return pieces

def check(pieces):
    # check each piece has exactly one neighbor within Chebyshev distance <=2
    for p in pieces:
        count = 0
        for q in pieces:
            if p == q: continue
            if max(abs(p[0]-q[0]), abs(p[1]-q[1])) <= 2:
                count += 1
        if count != 1:
            return False
    return True

pts = generate_configuration()
print(len(pts))
print(check(pts))
```

