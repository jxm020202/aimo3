def simulated_annealing(rows, cols, max_iter=200000, start_temp=5.0, end_temp=0.01):
    N=rows*cols
    perm=list(range(1,N+1))
    random.shuffle(perm)
    # adjacency list
    adj=[]
    for r in range(rows):
        for c in range(cols):
            idx=r*cols+c
            neigh=[]
            if r>0: neigh.append(((r-1)*cols+c))
            if r<rows-1: neigh.append(((r+1)*cols+c))
            if c>0: neigh.append((r*cols+(c-1)))
            if c<cols-1: neigh.append((r*cols+(c+1)))
            adj.append(neigh)
    def min_adj(p):
        m=10**9
        for i, neigh in enumerate(adj):
            for j in neigh:
                if i<j:
                    s=p[i]+p[j]
                    if s<m:
                        m=s
        return m
    cur=min_adj(perm)
    best=cur
    best_perm=perm[:]
    for it in range(max_iter):
        t = start_temp * ((end_temp/start_temp) ** (it/max_iter))
        i,j = random.sample(range(N),2)
        # compute delta? just compute new min after swap
        perm[i],perm[j]=perm[j],perm[i]
        new=min_adj(perm)
        # accept if better or with probability
        if new>cur or random.random()<math.exp((new-cur)/t):
            cur=new
            if new>best:
                best=new
                best_perm=perm[:]
        else:
            # revert
            perm[i],perm[j]=perm[j],perm[i]
    return best, best_perm

