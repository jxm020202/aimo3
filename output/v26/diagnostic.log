from scipy.optimize import milp, LinearConstraint, Bounds

def max_S_grid(m,n):
    N = m*n
    # adjacency edges list (i,j) where i<j
    edges = []
    def idx(r,c): return r*n + c
    for r in range(m):
        for c in range(n):
            i = idx(r,c)
            if r+1 < m:
                edges.append((i, idx(r+1,c)))
            if c+1 < n:
                edges.append((i, idx(r,c+1)))
    # Precompute pairs (k,l) with sum < S for each S? We'll binary search.
    # We'll use MILP for each candidate S.
    # Variables x_{i,k} flattened: index = i*N + (k-1)
    total_vars = N*N
    # Build constraints that are independent of S: each cell assigned exactly one number, each number assigned to exactly one cell.
    # We'll build A_eq and b_eq for these.
    # cell constraints
    A_eq = []
    b_eq = []
    # cell assignment
    for i in range(N):
        row = np.zeros(total_vars, dtype=int)
        row[i*N:(i+1)*N] = 1
        A_eq.append(row)
        b_eq.append(1)
    # number assignment
    for k in range(N):
        row = np.zeros(total_vars, dtype=int)
        row[k::N] = 1
        A_eq.append(row)
        b_eq.append(1)
    A_eq = np.array(A_eq)
    b_eq = np.array(b_eq)
    # bounds: binary 0-1
    bounds = Bounds(0,1)
    # We'll binary search S from 2 to 2N (max sum)
    low, high = 2, 2*N
    best = 0
    while low <= high:
        S = (low+high)//2
        # Build inequality constraints for edges: for each edge (i,j) and each pair (k,l) with k+l < S, add x_{i,k}+x_{j,l} <= 1
        rows = []
        lbs = []
        ubs = []
        for (i,j) in edges:
            for k in range(1,N+1):
                # minimal l such that k+l >= S => l >= S - k
                min_l = S - k
                if min_l <= 1:
                    continue
                # l from 1 to min_l-1 are forbidden
                for l in range(1, min_l):
                    # add constraint
                    row = np.zeros(total_vars, dtype=int)
                    row[i*N + (k-1)] = 1
                    row[j*N + (l-1)] = 1
                    rows.append(row)
                    lbs.append(-np.inf)  # not needed, we set ub=1
                    ubs.append(1)
        if rows:
            A_ub = np.array(rows)
            b_ub = np.array(ubs)
        else:
            A_ub = None
            b_ub = None
        # Solve MILP
        res = milp(c=np.zeros(total_vars), constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                                                      LinearConstraint(A_ub, -np.inf*np.ones(len(b_ub)) if A_ub is not None else None,
                                                                        b_ub) if A_ub is not None else None],
                    integrality=np.ones(total_vars), bounds=bounds, options={'disp': False})
        feasible = res.success
        print("S", S, "feasible", feasible)
        if feasible:
            best = S
            low = S+1
        else:
            high = S-1
    return best

# Test for small grid 2x2 (4 cells)
