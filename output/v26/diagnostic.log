from scipy.optimize import milp, LinearConstraint, Bounds

def max_S_milp(rows, cols):
    N = rows*cols
    # map vertex index
    vertices = [(r,c) for r in range(rows) for c in range(cols)]
    V = len(vertices)
    # adjacency edges list (undirected)
    edges = []
    for idx, (r,c) in enumerate(vertices):
        if r+1<rows:
            j = (r+1)*cols + c
            edges.append((idx, j))
        if c+1<cols:
            j = r*cols + (c+1)
            edges.append((idx, j))
    # binary variables x_{v,k} flattened: index = v*N + (k-1)
    total_vars = V * N
    # constraints: each vertex assigned exactly one number
    A_eq = []
    b_eq = []
    for v in range(V):
        row = [0]*total_vars
        for k in range(N):
            row[v*N + k] = 1
        A_eq.append(row)
        b_eq.append(1)
    # each number assigned to exactly one vertex
    for k in range(N):
        row = [0]*total_vars
        for v in range(V):
            row[v*N + k] = 1
        A_eq.append(row)
        b_eq.append(1)
    # We'll binary search S and add edge constraints
    lo=0
    hi=2*N  # max possible sum
    best=0
    while lo<=hi:
        mid=(lo+hi)//2
        # build inequality constraints for edges: for each edge (u,v) and each i,j with i+j < mid, x_{u,i}+x_{v,j} <= 1
        A_ub=[]
        b_ub=[]
        for (u,v) in edges:
            for i in range(N):
                for j in range(N):
                    if (i+1)+(j+1) < mid:
                        row=[0]*total_vars
                        row[u*N + i]=1
                        row[v*N + j]=1
                        A_ub.append(row)
                        b_ub.append(1)
        # convert to numpy arrays
        A_eq_np = np.array(A_eq)
        b_eq_np = np.array(b_eq)
        if A_ub:
            A_ub_np = np.array(A_ub)
            b_ub_np = np.array(b_ub)
        else:
            A_ub_np = None
            b_ub_np = None
        # define bounds 0-1
        bounds = Bounds(0,1)
        # integrality
        integrality = np.ones(total_vars)
        # objective dummy (zero)
        c = np.zeros(total_vars)
        try:
            res = milp(c=c, constraints=[LinearConstraint(A_eq_np, b_eq_np, b_eq_np),
                                        LinearConstraint(A_ub_np, -np.inf, b_ub_np) if A_ub_np is not None else None],
                       integrality=integrality, bounds=bounds, options={'presolve': True, 'disp': False})
        except Exception as e:
            print("MILP error", e)
            return None
        if res.success:
            best=mid
            lo=mid+1
        else:
            hi=mid-1
    return best

