assistantanalysis to=python codeimport itertools

def brute_max_S(m,n):
    N=m*n
    cells=[(i,j) for i in range(m) for j in range(n)]
    best=0
    best_assign=None
    for perm in itertools.permutations(range(1,N+1)):
        assign=dict(zip(cells, perm))
        # compute min edge sum
        min_sum=10**9
        for i in range(m):
            for j in range(n):
                v=assign[(i,j)]
                if i+1<m:
                    min_sum=min(min_sum, v+assign[(i+1,j)])
                if j+1<n:
                    min_sum=min(min_sum, v+assign[(i,j+1)])
        if min_sum>best:
            best=min_sum
            best_assign=assign
    return best, best_assign

