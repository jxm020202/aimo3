assistantanalysis to=python codedef backtrack_assign(rows, cols, target_S):
    N=rows*cols
    # adjacency list
    adj = [[] for _ in range(N)]
    for r in range(rows):
        for c in range(cols):
            idx=r*cols+c
            if r>0: adj[idx].append((r-1)*cols+c)
            if r<rows-1: adj[idx].append((r+1)*cols+c)
            if c>0: adj[idx].append(r*cols+(c-1))
            if c<cols-1: adj[idx].append(r*cols+(c+1))
    # order cells by degree descending
    cells = list(range(N))
    cells.sort(key=lambda v: -len(adj[v]))
    assign = [None]*N
    used = [False]*(N+1)
    # recursion
    def dfs(pos):
        if pos==len(cells):
            return True
        v = cells[pos]
        # try numbers from 1..N
        for num in range(1,N+1):
            if used[num]:
                continue
            # check constraints with already assigned neighbors
            ok=True
            for nb in adj[v]:
                if assign[nb] is not None and assign[nb] + num < target_S:
                    ok=False
                    break
            if not ok:
                continue
            assign[v]=num
            used[num]=True
            if dfs(pos+1):
                return True
            assign[v]=None
            used[num]=False
        return False
    return dfs(0), assign

