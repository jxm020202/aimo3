def max_S(n):
    # n x n grid, n even
    N=n*n
    cells = [(i,j) for i in range(n) for j in range(n)]
    # adjacency edges
    edges=[]
    for i in range(n):
        for j in range(n):
            if i+1<n: edges.append(((i,j),(i+1,j)))
            if j+1<n: edges.append(((i,j),(i,j+1)))
    max_min_sum=0
    best=None
    for perm in itertools.permutations(range(1,N+1)):
        # assign numbers to cells in order
        assign={}
        for idx,cell in enumerate(cells):
            assign[cell]=perm[idx]
        # compute min sum across edges
        min_sum=min(assign[a]+assign[b] for a,b in edges)
        if min_sum>max_min_sum:
            max_min_sum=min_sum
            best=perm
    return max_min_sum

print(max_S(2))


