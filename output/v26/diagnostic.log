def max_min_adj_sum(rows, cols):
    N = rows*cols
    cells = list(range(N))
    # adjacency list
    adj = []
    for r in range(rows):
        for c in range(cols):
            idx = r*cols + c
            neigh = []
            if r>0: neigh.append(((r-1)*cols + c))
            if r<rows-1: neigh.append(((r+1)*cols + c))
            if c>0: neigh.append((r*cols + (c-1)))
            if c<cols-1: neigh.append((r*cols + (c+1)))
            adj.append(neigh)
    best = -1
    best_perm = None
    for perm in itertools.permutations(range(1,N+1)):
        # compute min sum over edges (each edge counted twice)
        min_sum = math.inf
        for i, neighs in enumerate(adj):
            for j in neighs:
                if i<j: # count each edge once
                    s = perm[i] + perm[j]
                    if s < min_sum:
                        min_sum = s
                        if min_sum <= best: # prune
                            break
        if min_sum > best:
            best = min_sum
            best_perm = perm
    return best, best_perm

print(max_min_adj_sum(2,2))


