Let's code brute force for 2x2.assistantanalysis to=python codeimport itertools, math

def max_S_grid(rows, cols):
    N = rows*cols
    cells = [(r,c) for r in range(rows) for c in range(cols)]
    # adjacency edges
    edges = []
    for r in range(rows):
        for c in range(cols):
            if r+1<rows:
                edges.append(((r,c),(r+1,c)))
            if c+1<cols:
                edges.append(((r,c),(r,c+1)))
    maxS = -1
    best = None
    for perm in itertools.permutations(range(1,N+1)):
        # assign perm to cells in order
        assign = dict(zip(cells, perm))
        # compute min sum across edges
        min_sum = min(assign[a]+assign[b] for a,b in edges)
        if min_sum>maxS:
            maxS = min_sum
            best = assign
    return maxS, best

print(max_S_grid(2,2))


