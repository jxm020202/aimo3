assistantanalysis to=python codedef simulated_annealing_grid(rows, cols, steps=500000, start_temp=5.0, end_temp=0.01):
    N = rows*cols
    cells = [(r,c) for r in range(rows) for c in range(cols)]
    # edges
    edges = []
    for r in range(rows):
        for c in range(cols):
            if r+1<rows:
                edges.append(((r,c),(r+1,c)))
            if c+1<cols:
                edges.append(((r,c),(r,c+1)))
    # initial random assignment
    perm = list(range(1,N+1))
    random.shuffle(perm)
    assign = dict(zip(cells, perm))
    def min_edge(assign):
        return min(assign[a]+assign[b] for a,b in edges)
    cur_score = min_edge(assign)
    best_score = cur_score
    best_assign = assign.copy()
    for step in range(steps):
        t = start_temp + (end_temp - start_temp) * (step/steps)
        i,j = random.sample(range(N),2)
        cell_i, cell_j = cells[i], cells[j]
        # swap
        assign[cell_i], assign[cell_j] = assign[cell_j], assign[cell_i]
        new_score = min_edge(assign)
        delta = new_score - cur_score
        if delta >= 0 or random.random() < math.exp(delta / t):
            cur_score = new_score
            if cur_score > best_score:
                best_score = cur_score
                best_assign = assign.copy()
        else:
            # revert
            assign[cell_i], assign[cell_j] = assign[cell_j], assign[cell_i]
    return best_score, best_assign

