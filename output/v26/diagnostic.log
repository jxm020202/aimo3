from scipy.optimize import milp, LinearConstraint, Bounds

def find_labeling_milp(m,n,S):
    N=m*n
    cells = [(i,j) for i in range(m) for j in range(n)]
    cell_index = {cell: idx for idx,cell in enumerate(cells)}
    # binary variable x_{v,n} for each cell v and number n (1..N)
    # Flatten variable index: v*N + (n-1)
    num_vars = N * N
    # Objective: dummy zero
    c = np.zeros(num_vars)
    # Constraints:
    A_eq = []
    b_eq = []
    # each cell gets exactly one number
    for v in range(N):
        row = np.zeros(num_vars)
        for n in range(1,N+1):
            row[v*N + (n-1)] = 1
        A_eq.append(row)
        b_eq.append(1)
    # each number assigned to exactly one cell
    for n in range(1,N+1):
        row = np.zeros(num_vars)
        for v in range(N):
            row[v*N + (n-1)] = 1
        A_eq.append(row)
        b_eq.append(1)
    # inequality constraints for edges: sum >= S
    edges=[]
    for i in range(m):
        for j in range(n):
            if i+1<m:
                edges.append(((i,j),(i+1,j)))
            if j+1<n:
                edges.append(((i,j),(i,j+1)))
    A_ub = []
    b_ub = []
    # We need - (sum) <= -S  i.e., -(sum) <= -S
    for (c1,c2) in edges:
        row = np.zeros(num_vars)
        v1 = cell_index[c1]
        v2 = cell_index[c2]
        for n in range(1,N+1):
            row[v1*N + (n-1)] = -n
            row[v2*N + (n-1)] = -n
        A_ub.append(row)
        b_ub.append(-S)
    # Build constraints
    A_eq = np.array(A_eq)
    b_eq = np.array(b_eq)
    A_ub = np.array(A_ub) if A_ub else None
    b_ub = np.array(b_ub) if b_ub else None
    # bounds: binary variables 0/1
    bounds = Bounds(0,1)
    integrality = np.ones(num_vars, dtype=int)
    # Use milp
    res = milp(c=c, constraints=[LinearConstraint(A_eq, b_eq, b_eq),
                                 LinearConstraint(A_ub, -np.inf*np.ones_like(b_ub), b_ub) if A_ub is not None else None],
                bounds=bounds, integrality=integrality, options={'disp': False})
    if res.success:
        x = np.round(res.x).astype(int)
        assign = {}
        for v in range(N):
            cell = cells[v]
            for n in range(1,N+1):
                if x[v*N + (n-1)] == 1:
                    assign[cell] = n
                    break
        return assign
    else:
        return None

