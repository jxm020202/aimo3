assistantanalysis to=python codefrom scipy.optimize import milp, LinearConstraint, Bounds

def max_S_grid_milp(rows, cols):
    N = rows*cols
    cells = [(r,c) for r in range(rows) for c in range(cols)]
    # adjacency edges list of indices
    idx = {cell:i for i,cell in enumerate(cells)}
    edges = []
    for r in range(rows):
        for c in range(cols):
            if r+1<rows:
                edges.append((idx[(r,c)], idx[(r+1,c)]))
            if c+1<cols:
                edges.append((idx[(r,c)], idx[(r,c+1)]))
    # variables: x[i,k] binary flattened length N*N, plus S variable at end
    n_vars = N*N + 1
    # objective: maximize S -> minimize -S
    c = np.zeros(n_vars, dtype=float)
    c[-1] = -1.0
    # constraints:
    A = []
    lb = []
    ub = []
    # each cell gets exactly one number
    for i in range(N):
        row = np.zeros(n_vars)
        row[i*N:(i+1)*N] = 1
        A.append(row)
        lb.append(1)
        ub.append(1)
    # each number assigned to exactly one cell
    for k in range(N):
        row = np.zeros(n_vars)
        row[k::N] = 1  # positions i*N + k for all i
        A.append(row)
        lb.append(1)
        ub.append(1)
    # edge constraints: sum_k k x_i,k + sum_k k x_j,k >= S
    # rewrite as sum_k k x_i,k + sum_k k x_j,k - S >= 0
    for (i,j) in edges:
        row = np.zeros(n_vars)
        # coefficients for x_i,k
        for k in range(N):
            row[i*N + k] = (k+1)  # number value = k+1
            row[j*N + k] = (k+1)
        row[-1] = -1  # -S
        A.append(row)
        lb.append(0)
        ub.append(np.inf)
    # variable bounds: x binary (0/1), S integer between 2 and 2N
    bounds = Bounds(lb=np.concatenate([np.zeros(N*N), [2]]), ub=np.concatenate([np.ones(N*N), [2*N]]))
    # integrality: all vars integer
    integrality = np.ones(n_vars, dtype=int)
    # Use milp
    res = milp(c=c, constraints=LinearConstraint(np.array(A), np.array(lb), np.array(ub)), bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
    return res

# test small grid 2x3
