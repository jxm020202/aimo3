            import numpy as np
            
            def count_independent_sets_matrix(n):
                patterns = [bits for bits in range(1<<n) if not (bits & (bits<<1))]
                m = len(patterns)
                A = np.zeros((m,m), dtype=object)
                for i,a in enumerate(patterns):
                    for j,b in enumerate(patterns):
                        if (a & b)==0:
                            A[i,j]=1
                        else:
                            A[i,j]=0
                # compute total = sum of entries of A^{n-1}
                if n==1:
                    return len(patterns)  # 2
                M = np.linalg.matrix_power(A, n-1)
                total = M.sum()
                return int(total)
            
            for n in range(2,6):
                print(n, count_independent_sets_matrix(n))
            
