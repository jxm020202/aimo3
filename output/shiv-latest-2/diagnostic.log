            def term_mod_n_at_full(n, idx):
                # compute term a_idx as integer mod n using recurrence with full integer (but we can just compute modulo n)
                # We'll compute using sliding window mod n
                a = [pow(2, k, n) for k in range(n)]
                if idx <= n:
                    return a[idx-1]
                window = a[:]
                window_sum = sum(window) % n
                for i in range(n, idx):
                    next_val = window_sum % n
                    old = window[i % n]
                    window[i % n] = next_val
                    window_sum = (window_sum - old + next_val) % n
                return next_val
            
