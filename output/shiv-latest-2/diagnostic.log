                # inside sqrt for cube sum
                inner = 9*x**4 + (4*x**6)/3 + 9 + 18*x**2
                sqrt_inner = math.sqrt(inner)
                C = ((1+x**2)/2 + sqrt_inner/6)**(1/3) + ((1+x**2)/2 - sqrt_inner/6)**(1/3)
