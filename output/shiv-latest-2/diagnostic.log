            def forced_equal(limit=5000):
                # start with set of known equalities: all indices have unknown values initially.
                # We'll propagate constraints: if we know value at m, then for all k in [m+32, 2m-1024], value must equal that at m.
                # We'll compute equivalence classes via union-find.
                parent = {}
                def find(x):
                    if parent.setdefault(x, x) != x:
                        parent[x] = find(parent[x])
                    return parent[x]
                def union(a,b):
                    ra, rb = find(a), find(b)
                    if ra != rb:
                        parent[rb] = ra
                # We'll consider indices up to limit.
                for m in range(1056, limit+1):
                    low = m+32
                    high = 2*m - 1024
                    if low > high:
                        continue
                    for k in range(low, min(high, limit)+1):
                        union(m, k)
                # compute components
                comps = {}
                for i in range(1056, limit+1):
                    r = find(i)
                    comps.setdefault(r, []).append(i)
                return comps
            
            comps = forced_equal(2000)
            len(comps), max(len(v) for v in comps.values())
            
