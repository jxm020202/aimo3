            # Define symbols and expressions
            B, C = sp.symbols('B C', positive=True, real=True)
            # Points
            D = sp.Matrix([1, 0])
            E = sp.Matrix([sp.cos(2*B), sp.sin(2*B)])
            F = sp.Matrix([sp.cos(2*C), sp.sin(2*C)])
            # side lengths (assume B>C for positivity)
            a = 2*sp.sin(B - C)  # EF
            b = 2*sp.sin(C)      # DF
            c = 2*sp.sin(B)      # DE
            # Incenter I
            I = (a*D + b*E + c*F) / (a + b + c)
            I = sp.simplify(I)
            I
            
