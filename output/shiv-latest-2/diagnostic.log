            def bfs_parities(start, targets):
                # targets: set of Fractions
                # returns dict rational->parity (0 even distance, 1 odd distance)
                visited = {start:0}  # parity
                q = deque([start])
                # store parity distance (mod 2)
                while q:
                    r = q.popleft()
                    parity = visited[r]
                    if set(targets).issubset(visited.keys()):
                        break
                    # generate neighbors
                    neigh = []
                    # -r
                    neigh.append(-r)
                    # 1 - r
                    neigh.append(1 - r)
                    # 1/r if r != 0
                    if r != 0:
                        neigh.append(1 / r)
                    for nr in neigh:
                        if nr not in visited:
                            visited[nr] = parity ^ 1  # flip parity
                            q.append(nr)
                return {t: visited[t] for t in targets if t in visited}
            
