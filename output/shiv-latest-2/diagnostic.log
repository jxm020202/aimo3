            def line_through(p,q):
                # return normalized line coefficients (A,B,C) for line Ax+By+C=0
                (x1,y1),(x2,y2)=p,q
                A = y1 - y2
                B = x2 - x1
                C = x1*y2 - x2*y1
                # Normalize: make sqrt(A^2+B^2)=1 and sign standardized
                norm = math.hypot(A,B)
                if norm==0:
                    return (0,0,0)
                A,B,C = A/norm, B/norm, C/norm
                # Ensure unique sign: make first non-zero coefficient positive
                if abs(A)>1e-9:
                    if A<0:
                        A,B,C = -A,-B,-C
                elif abs(B)>1e-9:
                    if B<0:
