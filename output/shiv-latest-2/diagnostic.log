            def fixes(p,q,mat):
                a,b,c,d = mat
                # rational p/q in lowest terms
                # compute (a*(p/q)+b)/(c*(p/q)+d) == p/q
                # cross-multiply: (a p + b q) * q == p * (c p + d q)
                return (a*p + b*q)*q == p*(c*p + d*q)
            
