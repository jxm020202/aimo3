            def ratio_to_point(u,v,point):
                a = math.hypot(u-1, v)
                b = math.hypot(u, v)
                s = a+b+1
                y0 = ((u-0.5)**2 + v**2 - 0.25) / (2*v)
                P = np.array([0.5, y0])
                Q = np.array([(b+u)/s, v/s])
                dPQ = P - Q
                v_dir = np.array([-dPQ[1], dPQ[0]])
                # compute N as intersection of line through Q with direction v_dir and line through F with direction ext_dir
                vFD = np.array([-u, -v])
                vFE = np.array([1-u, -v])
                normFD = np.linalg.norm(vFD)
                normFE = np.linalg.norm(vFE)
                uFD = vFD/normFD
                uFE = vFE/normFE
                ext_dir = uFD - uFE
                A = np.column_stack((v_dir, -ext_dir))
                b_vec = np.array([u - Q[0], v - Q[1]])
                tN = np.linalg.solve(A, b_vec)[0]
                N = Q + tN*v_dir
                # compute distance from Q to point
                return np.linalg.norm(N - Q), np.linalg.norm(point - Q)
            
