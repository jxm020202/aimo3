                        # So a_{a_{a_r}} = x_{ a_{a_r} mod d } = x[ x[ x[r] ] % d ]
                        lhs = x[ (x[ (x[r]) % d ]) % d ]  # Actually a_r = x[r]; a_{a_r} = x[ a_r % d ]; a_{a_{a_r}} = x[ a_{a_r} % d ]
