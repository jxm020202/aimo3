            # Define variables
            x2, y2, z2, t, lam1, lam2 = sp.symbols('x2 y2 z2 t lam1 lam2', real=True)
            
            def solve_for_signs(s1, s2, s3):
                eqs = []
                # plane
                eqs.append(6*x2 + 3*y2 + 2*z2 - 12)
