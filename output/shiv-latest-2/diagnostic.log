                # excenters
                I_D = (-a*d + b*e + c*f)/(-a + b + c)
                I_E = (a*d - b*e + c*f)/(a - b + c)
                # side I_D I_E vector
                side = I_E - I_D
                # OI vector
                OI = I - O
                # compute dot product
                return np.dot(side, OI)
            
