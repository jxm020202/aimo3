            import numpy as np, math, random
            
            def circumcenter(A,B,C):
                A = np.array(A,float)
                B = np.array(B,float)
                C = np.array(C,float)
                BA = B - A
                CA = C - A
                M = np.vstack([BA, CA])
                rhs = np.array([(np.dot(B,B)-np.dot(A,A))/2.0,
                                (np.dot(C,C)-np.dot(A,A))/2.0])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter(A,B,C):
                A = np.array(A,float)
                B = np.array(B,float)
                C = np.array(C,float)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C)/(a+b+c)
                return I
            
            def external_bisector_at_F(D,E,F):
                FD = np.array(D) - np.array(F)
                FE = np.array(E) - np.array(F)
                uFD = FD/np.linalg.norm(FD)
                uFE = FE/np.linalg.norm(FE)
                dir_ext = uFD - uFE
                return dir_ext
            
