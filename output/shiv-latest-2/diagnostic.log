            import functools
            
            def last_nonzero_digit_factorial(n):
                # compute using recurrence
                # D(0)=1
                if n==0:
                    return 1
                # recursion using known formula
                # D(n) = D(n//5) * D(n%5) * pow(2, n//5, 10) % 10
                # D(0..4) = [1,1,2,6,4]
                base = [1,1,2,6,4]
                def D(m):
                    if m<5:
                        return base[m]
                    q, r = divmod(m,5)
                    return (D(q) * base[r] * pow(2, q, 10)) % 10
                return D(n)
            
