            def random_move(points, step=0.05):
                new = points.copy()
                i = random.randrange(len(points))
                angle = random.random()*2*math.pi
                dx = step*math.cos(angle)
                dy = step*math.sin(angle)
                x,y = new[i]
                x2 = x+dx
                y2 = y+dy
                if x2*x2 + y2*y2 > 1.0:
                    r = math.sqrt(x2*x2 + y2*y2)
                    x2, y2 = x2/r, y2/r
                new[i] = (x2,y2)
                return new
            
            def hill_climb(initial_pts, step=0.2, iterations=500):
                best = compute_sum(initial_pts)
                best_pts = initial_pts
                for it in range(iterations):
                    cand = random_move(best_pts, step=step)
                    val = compute_sum(cand)
                    if val > best:
                        best = val
                        best_pts = cand
                return best, best_pts
            
            def points_on_chord(n, offset=0.5):
                d = offset
                L = 2*math.sqrt(max(0,1-d*d))
                pts=[]
                for k in range(n):
                    t = -L/2 + L * k/(n-1) if n>1 else 0
                    x = d
                    y = t
                    pts.append((x,y))
                return pts
            
            def improve_from_chord(offset=0.5, step=0.2, iterations=2000):
                pts = points_on_chord(100, offset=offset)
                best, best_pts = hill_climb(pts, step=step, iterations=iterations)
                return best, best_pts
            
