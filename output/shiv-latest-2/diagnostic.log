            def compute_k(p,q):
                from fractions import Fraction
                t = Fraction(p,q)
                # compute a = (t^2 - 2t - 1)/(3 t^2 + 2 t - 3)
                a = (t*t - 2*t - 1) / (3*t*t + 2*t - 3)
                # compute b = (1 - 3 t^2)/(1 + t^2)
                b = (1 - 3*t*t) / (1 + t*t)
                # ensure a,b positive and <1
                if not (0 < a < 1 and 0 < b < 1):
                    return None
                x = (1 - a*a) / 2
                y = (1 - b*b) / 2
                # ensure x,y positive < 0.5
                if not (0 < x < Fraction(1,2) and 0 < y < Fraction(1,2)):
                    return None
                # compute lcm of denominators
                from math import gcd
                denom_x = x.denominator
                denom_y = y.denominator
                lcm = denom_x * denom_y // gcd(denom_x, denom_y)
                return (lcm, x, y, a, b, t)
            
            def search(limit_q):
                best = None
                sols = []
                for q in range(1, limit_q+1):
                    for p in range(-limit_q, limit_q+1):
                        if p==0 and q==0: continue
                        # reduce fraction to lowest terms
                        from math import gcd
                        g = gcd(p,q)
                        if g!=0:
