            def compute_sequence_mod_n(n, mod, steps):
                # returns list of first steps terms (1-indexed)
                seq = [pow(2, k-1, mod) for k in range(1, n+1)]
                window_sum = sum(seq) % mod
                for k in range(n+1, steps+1):
                    next_val = window_sum % mod
                    seq.append(next_val)
                    removed = seq[-n-1]  # this is the element leaving window
                    window_sum = (window_sum - removed + next_val) % mod
                return seq
            
