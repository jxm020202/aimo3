            def longest_zero_run_limit(n, max_terms):
                # generate using deque for efficiency
                from collections import deque
                # initial terms
                a = [pow(2, k, n) for k in range(n)]
                # track longest
                longest = 0
                cur = 0
                # check initial
                for val in a:
                    if val == 0:
                        cur += 1
                        longest = max(longest, cur)
                    else:
                        cur = 0
                # sliding window sum
                window = deque(a, maxlen=n)
                sum_window = sum(window) % n
                # generate further terms
                for idx in range(n, max_terms):
                    next_val = sum_window % n
                    # update longest
                    if next_val == 0:
                        cur += 1
                        longest = max(longest, cur)
                    else:
                        cur = 0
                    # update window
                    oldest = window.popleft()
                    sum_window = (sum_window - oldest + next_val) % n
                    window.append(next_val)
                return longest
            
            print(longest_zero_run_limit(100, 5000000))
            
