            def find_t_solutions(max_den=30):
                sols = []
                import math, fractions, sympy as sp
                for b in range(1, max_den+1):
                    for a in range(0, b+1):
                        t = Fraction(a, b)
                        if t <= 0 or t >= 1:
                            continue
                        # compute D
                        # Use rational arithmetic via Fraction
                        D = Fraction(5*a*a, b*b) - Fraction(2*a, b) + 1
                        # compute numerator N = 2*(t+1)^2
                        N = 2 * (Fraction(a, b) + 1)**2
                        # Need N/D to be a perfect square rational.
                        # Compute fraction N/D
                        frac = N / D
                        # simplify
                        # Check if numerator and denominator are perfect squares
                        num = frac.numerator
                        den = frac.denominator
                        # check perfect squares
                        if int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den:
                            s = Fraction(math.isqrt(num), math.isqrt(den))
                            # compute f = (t+1)^2 / D
                            f = (Fraction(a, b) + 1)**2 / D
                            # compute y = s - f
                            y = s - f
                            # compute x = (1 - t^2)/2
                            x = (1 - Fraction(a*a, b*b)) / 2
                            # ensure x,y positive
                            if x > 0 and y > 0:
                                sols.append((t, x, y, s, f))
                return sols
            
            sols = find_t_solutions(30)
            sols[:10], len(sols)
            
