                alpha = L - beta
                gamma = L - delta
                # points
                w = -alpha * d
                y = beta * d
                x = -gamma * e
                z = delta * e
                # compute N: intersection of perp bisectors of WX and YZ
                # define function to compute intersection of two lines given point+direction
                def perp_bisector(p1,p2):
                    mid = (p1+p2)/2
                    dir_vec = p2-p1
                    # direction of perp bisector is perpendicular to dir_vec
                    # we can represent line as (mid, normal = dir_vec)
                    # line equation: (X - mid)·dir_vec = 0
                    return (mid, dir_vec)
                # line L1: perp bisector of WX
                mid1, norm1 = perp_bisector(w, x)
                # line L2: perp bisector of YZ
                mid2, norm2 = perp_bisector(y, z)
                # Solve for intersection point N: find X such that (X-mid1)·norm1=0 and (X-mid2)·norm2=0
