            def point_in_polygon(pt, verts):
                # assumes verts are CCW order, convex polygon
                x,y = pt
                n = len(verts)
                # compute cross product sign for each edge
                # allow points on boundary (cross >= -eps)
                eps = 1e-9
                prev = None
                for i in range(n):
                    x1,y1 = verts[i]
                    x2,y2 = verts[(i+1)%n]
                    # edge vector
                    ex, ey = x2-x1, y2-y1
                    # vector from vertex to point
                    vx, vy = x - x1, y - y1
                    # cross product z = ex*vy - ey*vx
                    cross = ex*vy - ey*vx
                    if cross < -eps:
                        return False
                return True
            
