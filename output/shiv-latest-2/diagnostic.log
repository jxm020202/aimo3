            import random, math, numpy as np, sympy as sp
            
            def ratio_for_triangle(D, E, F):
                D = sp.Point(D)
                E = sp.Point(E)
                F = sp.Point(F)
                # circumcenter P
                P = sp.geometry.Triangle(D,E,F).circumcenter
                # incenter Q
                Q = sp.geometry.Triangle(D,E,F).incenter
                # line PQ
                linePQ = sp.Line(P, Q)
                # line through Q perpendicular to PQ
                perp_line = linePQ.perpendicular_line(Q)
                # line DE
                lineDE = sp.Line(D, E)
                M = perp_line.intersection(lineDE)[0]
                # external angle bisector at F: external bisector of angle DFE.
                # internal bisector direction is sum of unit vectors from F to D and F to E.
                # external bisector is direction sum of unit vectors from F to D and opposite of unit vector to E? Actually external bisector is line that bisects the external angle at F, i.e., angle between extensions of FD and FE outward.
                # It can be obtained as line through F with direction vector = (u_D - u_E) where u_D = unit vector FD, u_E = unit vector FE.
                # Let's compute unit vectors from F to D and F to E.
                FD = sp.Point(D) - sp.Point(F)
                FE = sp.Point(E) - sp.Point(F)
                uFD = FD/FD.distance(sp.Point(0,0))
                uFE = FE/FE.distance(sp.Point(0,0))
                # internal bisector direction = uFD/|uFD| + uFE/|uFE|
                # external bisector direction = uFD/|uFD| - uFE/|uFE|
                dir_ext = uFD - uFE
                line_ext = sp.Line(F, F + dir_ext)  # line through F with direction dir_ext
                N_candidates = perp_line.intersection(line_ext)
                if not N_candidates:
                    # maybe opposite direction? line_ext extends both ways, intersection should exist.
                    return None
                N = N_candidates[0]
                QM = Q.distance(M)
                QN = Q.distance(N)
                return sp.nsimplify(QM/QN)
            
            def random_triangle():
                # ensure non-collinear
                while True:
                    D = (random.uniform(-5,5), random.uniform(-5,5))
                    E = (random.uniform(-5,5), random.uniform(-5,5))
                    F = (random.uniform(-5,5), random.uniform(-5,5))
                    # check area non-zero
                    area = abs((E[0]-D[0])*(F[1]-D[1]) - (E[1]-D[1])*(F[0]-D[0]))
                    if area > 1e-3:
                        return D,E,F
            
