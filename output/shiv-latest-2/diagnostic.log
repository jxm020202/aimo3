            import math, itertools, sys, sympy as sp
            
            def lcm_range(k, n):
                # compute lcm of integers k..k+n-1
                res = 1
                for i in range(k, k+n):
                    res = math.lcm(res, i)
                return res
            
            def seq(n, limit=200):
                return [lcm_range(k, n) for k in range(1, limit+1)]
            
            def is_eventually_strictly_increasing(n, limit=500):
                # check if after some point up to limit, monotone increasing strictly holds
                # find N such that for all k>=N, x_{k+1} > x_k
                xs = seq(n, limit+1)
                # find earliest N where all later steps increase
                for N in range(1, limit):
                    good = True
                    for k in range(N, limit):
                        if xs[k] <= xs[k-1]:
                            good = False
                            break
                    if good:
                        return True, N
                return False, None
            
            for n in range(1,11):
                ok,N = is_eventually_strictly_increasing(n, 200)
                print(n, ok, N)
            
