            def polygon_area(P, Q, R, S):
                return 0.5*((P[0]*Q[1] - Q[0]*P[1]) + (Q[0]*R[1] - R[0]*Q[1]) + (R[0]*S[1] - S[0]*R[1]) + (S[0]*P[1] - P[0]*S[1]))
            
            def interior_angle_at_P(alpha_val):
                sol = find_solution(alpha_val)
                if sol is None:
                    return None
                d_val = float(sol[0])
                xS_val = float(sol[1])
                yS_val = float(sol[2])
                Q = (math.cos(alpha_val), math.sin(alpha_val))
                S = (xS_val, yS_val)
                P = (0.0,0.0)
                # compute interior angle using angle between vectors PQ and PS but taking the smaller angle that lies inside polygon.
                # Since polygon is convex, interior angle = angle between vectors (Q-P) and (S-P) measured inside.
                # We can compute angle using atan2 of cross and dot: angle = atan2(|cross|, dot)
                v1 = (Q[0]-P[0], Q[1]-P[1])
                v2 = (S[0]-P[0], S[1]-P[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                cross = v1[0]*v2[1] - v1[1]*v2[0]
                angle = math.degrees(abs(math.atan2(cross, dot)))  # returns angle between -pi and pi, absolute gives magnitude
                # Ensure angle is between 0 and 180
                if angle > 180:
                    angle = 360 - angle
                return angle, sol
            
