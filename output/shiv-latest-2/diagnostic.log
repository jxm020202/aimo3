            import math
            from fractions import Fraction
            import sympy as sp
            
            def lcm(a,b):
                return a*b//math.gcd(a,b)
            
            def compute_k_branch(p, branch=1):
                p_sym = sp.Rational(p.numerator, p.denominator)
                y = sp.simplify(4*p_sym**2*(1 - p_sym**2) / (p_sym**2 + 1)**2)
                if branch == 1:
                    x = sp.simplify(4*(p_sym-1)*(p_sym+1)*(p_sym**2 - 2*p_sym - 1) / (3*p_sym**2 - 2*p_sym - 3)**2)
                else:
                    x = sp.simplify(4*(p_sym-1)*(p_sym+1)*(p_sym**2 + 2*p_sym - 1) / (3*p_sym**2 + 2*p_sym - 3)**2)
                x_num, x_den = x.as_numer_denom()
                y_num, y_den = y.as_numer_denom()
                k = lcm(int(x_den), int(y_den))
                return int(k), x, y
            
            def is_valid(p, branch):
                # domain constraints
                if abs(p) >= 1/math.sqrt(3):
                    return False
                if p <= (1 - math.sqrt(2)):
                    return False
                if p == 0:
                    return False
                k, x, y = compute_k_branch(p, branch)
                # ensure positive
                if x <= 0 or y <= 0:
                    return False
                return True
            
