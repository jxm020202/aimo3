            import numpy as np, math, random
            
            def random_quadrilateral():
                # random angle between diagonals
                theta = random.uniform(0.2, math.pi-0.2)  # avoid near 0 or pi
                d = np.array([1.0, 0.0])
                e = np.array([math.cos(theta), math.sin(theta)])
