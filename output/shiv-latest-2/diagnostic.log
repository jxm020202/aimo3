            # define function to get perpendicular bisector line given two points
            def perp_bisector(P, Q):
                # midpoint
                mid = sp.Point((P.x + Q.x)/2, (P.y + Q.y)/2)
                # direction vector perpendicular to PQ
                # vector PQ = Q - P
                dx = Q.x - P.x
                dy = Q.y - P.y
                # direction vector perpendicular: (dy, -dx) or (-dy, dx)
                # choose (dy, -dx)
                dir_vec = sp.Matrix([dy, -dx])
                # line param: mid + t * dir_vec
                # sympy line representation
                return sp.Line(mid, sp.Point(mid.x + dir_vec[0], mid.y + dir_vec[1]))
            
