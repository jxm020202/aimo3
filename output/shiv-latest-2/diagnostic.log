            import random, math, sympy as sp, numpy as np
            
            def circumcenter(A,B,C):
                # using sympy geometry maybe easier
                Ax,Ay = A
                Bx,By = B
                Cx,Cy = C
                D = 2*(Ax*(By-Cy) + Bx*(Cy-Ay) + Cx*(Ay-By))
                if abs(D) < 1e-12:
                    raise ValueError("collinear")
                Ux = ((Ax**2+Ay**2)*(By-Cy) + (Bx**2+By**2)*(Cy-Ay) + (Cx**2+Cy**2)*(Ay-By))/D
                Uy = ((Ax**2+Ay**2)*(Cx-Bx) + (Bx**2+By**2)*(Ax-Cx) + (Cx**2+Cy**2)*(Bx-Ax))/D
                return (Ux, Uy)
            
            def incenter(A,B,C):
                # lengths
                a = math.hypot(B[0]-C[0], B[1]-C[1])
                b = math.hypot(C[0]-A[0], C[1]-A[1])
                c = math.hypot(A[0]-B[0], A[1]-B[1])
                p = a+b+c
                Ix = (a*A[0] + b*B[0] + c*C[0]) / p
                Iy = (a*A[1] + b*B[1] + c*C[1]) / p
                return (Ix, Iy)
            
            def unit(v):
                x,y=v
                norm=math.hypot(x,y)
                if norm==0: return (0,0)
                return (x/norm, y/norm)
            
            def external_bisector(F, D, E):
                # vectors from F to D and F to E
                v1 = (D[0]-F[0], D[1]-F[1])
                v2 = (E[0]-F[0], E[1]-F[1])
                u1 = unit(v1)
                u2 = unit(v2)
                # external bisector direction = u1 - u2 (or -u1 + u2)
                # Choose direction that is not zero
                dir_vec = (u1[0] - u2[0], u1[1] - u2[1])
                # If zero (unlikely), use u1+u2?
                if math.hypot(dir_vec[0], dir_vec[1]) < 1e-9:
                    dir_vec = (u1[0] + u2[0], u1[1] + u2[1])
                return dir_vec
            
            def line_intersection(p1, d1, p2, d2):
                # lines p1 + t*d1, p2 + s*d2
                # solve p1 + t d1 = p2 + s d2
                # 2 equations
                x1,y1 = p1
                x2,y2 = p2
                dx1,dy1 = d1
                dx2,dy2 = d2
                # solve for t using cross product method
                # (p2-p1) x d2 = t (d1 x d2)
                # if d1 x d2 = 0 lines parallel
                denom = dx1*dy2 - dy1*dx2
                if abs(denom) < 1e-12:
                    return None
                t = ((x2 - x1)*dy2 - (y2 - y1)*dx2) / denom
                return (x1 + t*dx1, y1 + t*dy1)
            
            def ratio_QM_QN(D,E,F):
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line L through Q perpendicular to PQ
                dx = P[0]-Q[0]
                dy = P[1]-Q[1]
                # direction perpendicular: (-dy, dx)
                L_dir = (-dy, dx)
                # intersection with DE
                M = line_intersection(Q, L_dir, D, (E[0]-D[0], E[1]-D[1]))
                # external bisector line at F
                N_dir = external_bisector(F, D, E)
                N = line_intersection(Q, L_dir, F, N_dir)
                if M is None or N is None:
                    return None
                QM = math.hypot(M[0]-Q[0], M[1]-Q[1])
                QN = math.hypot(N[0]-Q[0], N[1]-Q[1])
                return QM/QN
            
            def test_random(num=10):
                ratios=[]
                for i in range(num):
                    # random triangle coordinates
                    D = (random.uniform(-5,5), random.uniform(-5,5))
                    E = (random.uniform(-5,5), random.uniform(-5,5))
                    F = (random.uniform(-5,5), random.uniform(-5,5))
                    # ensure non-collinear
                    area = (E[0]-D[0])*(F[1]-D[1]) - (E[1]-D[1])*(F[0]-D[0])
                    if abs(area) < 1e-3:
                        continue
                    r=ratio_QM_QN(D,E,F)
                    if r is not None:
                        ratios.append(r)
                return ratios
            
            ratios = test_random(30)
            ratios[:10], len(ratios)
            
