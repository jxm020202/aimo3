            def max_zero_run_n_fast(n, max_terms):
                a = [pow(2, k, n) for k in range(n)]
                max_run = 0
                cur_run = 0
                for val in a:
                    if val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                window_sum = sum(a) % n
                # we will maintain a circular buffer of size n for sliding window
                from collections import deque
                dq = deque(a, maxlen=n)
                for _ in range(max_terms - n):
                    next_val = window_sum
                    # update run
                    if next_val == 0:
                        cur_run += 1
                        if cur_run > max_run:
                            max_run = cur_run
                    else:
                        cur_run = 0
                    # slide
                    out = dq.popleft()
                    dq.append(next_val)
                    window_sum = (window_sum - out + next_val) % n
                return max_run
            
            print(max_zero_run_n_fast(100, 10000000))
            
