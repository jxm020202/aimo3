            import itertools
            
            def max_break(A,B,N):
                # brute force all possible assignments of g[1..N] values from small set e.g., {0,1}
                # We'll try to find any assignment where condition holds for all n>=A,d>=B with indices <=N
                # and maximize last index where g[i]!=g[i+1].
                # We'll limit values to small range to keep search feasible.
                max_n = -1
                best_seq = None
                # Use small domain {0,1}
                for vals in itertools.product([0,1], repeat=N):
                    g = [None] + list(vals)  # 1-indexed
                    ok = True
                    for n in range(A, N+1):
                        for d in range(B, N+1):
                            idx = 2*n + d
                            if idx > N:
                                continue
                            # condition: g[idx] must equal g[n+d] or g[n]
                            if not (g[idx] == g[n+d] or g[idx] == g[n]):
                                ok = False
                                break
                        if not ok:
                            break
                    if ok:
                        # compute last break
                        last_break = 0
                        for i in range(1,N):
                            if g[i] != g[i+1]:
                                last_break = i
                        if last_break > max_n:
                            max_n = last_break
                            best_seq = g[:]
                return max_n, best_seq
            
            print(max_break(2,3,10))
            
