            def d_chebyshev_to_sphere(p):
                # p is tuple of positive coordinates (x2,y2,z2)
                # Compute minimal t such that sum_i max(p_i - t, 0)^2 <= 1
                # Equivalent to solve piecewise.
                p_vals = sorted(p, reverse=True)  # descending
                p1, p2, p3 = p_vals
                # region 0: t in [0, p3]
                # F(t) = sum p_i^2 - 2t sum p_i + 3 t^2
                # Solve quadratic =1
                import math
                # Helper to solve quadratic a t^2 + b t + c =0
                def solve_quad(a,b,c):
                    disc = b*b - 4*a*c
                    if disc < 0:
                        return []
                    sqrt_disc = math.sqrt(disc)
                    t1 = (-b - sqrt_disc)/(2*a)
                    t2 = (-b + sqrt_disc)/(2*a)
                    return [t1,t2]
                # Region 0
                a0 = 3
                b0 = -2*sum(p_vals)
                c0 = sum(v*v for v in p_vals) - 1
                roots0 = solve_quad(a0,b0,c0)
                # we need t in [0, p3]
                candidates = []
                for t in roots0:
                    if t >= 0 - 1e-12 and t <= p3 + 1e-12:
                        candidates.append(t)
                # Region 1: t in [p3, p2], only first two > t
                # F(t) = (p1 - t)^2 + (p2 - t)^2
                a1 = 2
                b1 = -2*(p1 + p2)
                c1 = p1**2 + p2**2 - 1
                roots1 = solve_quad(a1,b1,c1)
                for t in roots1:
                    if t >= p3 - 1e-12 and t <= p2 + 1e-12:
                        candidates.append(t)
                # Region 2: t in [p2, p1], only first > t
                # F(t) = (p1 - t)^2
                # Solve (p1 - t)^2 = 1 => p1 - t = ±1 => t = p1 ± 1
                t_candidate = p1 - 1
                if t_candidate >= p2 - 1e-12 and t_candidate <= p1 + 1e-12:
                    candidates.append(t_candidate)
                t_candidate2 = p1 + 1  # this would be > p1, not in region
                # Also consider t = p1 (where F=0) if 0 <=1? Not needed.
                # If no candidate found, then maybe t > p1 (F=0) which satisfies <=1, so minimal t is p1? Actually if F(p1) =0 <=1, then minimal t is the smallest t where F <=1, which could be less than p1.
                # So we need to also consider boundary points: t = p3, p2, p1
                for t in [p3, p2, p1]:
                    # compute F(t) piecewise manually
                    def F(t):
