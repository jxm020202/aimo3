                    N = 2*(a+b)**2
                    M = 5*a*a - 2*a*b + b*b
                    if M<=0: continue
                    g = math.gcd(N,M)
                    Np = N//g
                    Mp = M//g
                    if is_square(Np) and is_square(Mp):
                        p = int(math.isqrt(Np))
                        q = int(math.isqrt(Mp))
                        # w = p/q
                        # ensure p/q in [1,2)
                        if not (p >= q and p < 2*q):
