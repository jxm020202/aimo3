            import random, math, time
            
            def total_sum_points_fast(points):
                # same as before but maybe optimized using numpy? keep simple
                limit=math.radians(100)
                n=len(points)
                total=0
                for i in range(n):
                    xi, yi = points[i]
                    angles=[]
                    for j in range(n):
                        if j==i: continue
                        xj, yj = points[j]
                        ang=math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                    angles.sort()
                    angles2=angles+[a+2*math.pi for a in angles]
                    m=n-1
                    maxcnt=0
                    j=0
                    for k in range(m):
                        while j<k+m and angles2[j]-angles2[k]<=limit+1e-9:
                            j+=1
                        cnt=j-k
                        if cnt>maxcnt:
                            maxcnt=cnt
                    total+=maxcnt
                return total
            
            def simulated_anneal(n, time_limit=20):
                start=time.time()
                # initialize points randomly within square [-10,10]^2
                pts=[(random.uniform(-10,10), random.uniform(-10,10)) for _ in range(n)]
                best=total_sum_points_fast(pts)
                best_pts=pts[:]
                cur=best
                cur_pts=pts[:]
                T=1.0
                while time.time()-start < time_limit:
                    # random move
                    i=random.randrange(n)
                    x,y=cur_pts[i]
                    nx=x+random.uniform(-1,1)
                    ny=y+random.uniform(-1,1)
                    new_pts=cur_pts[:]
                    new_pts[i]=(nx,ny)
                    val=total_sum_points_fast(new_pts)
                    delta=val-cur
                    if delta>0 or random.random()<math.exp(delta/T):
                        cur=val
                        cur_pts=new_pts
                        if val>best:
                            best=val
                            best_pts=new_pts[:]
                    # cooling
                    T*=0.9995
                return best, best_pts
            
            best100, pts100 = simulated_anneal(100, time_limit=15)
            best100
            
