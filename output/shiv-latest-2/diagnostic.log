            def covers_vertex(x, y, theta):
                # center (x,y) in [0,1) range
                # orientation theta in [0, pi/2)
                # check integer points near center
                # compute rotation matrix for -theta
                cos_t = math.cos(-theta)
                sin_t = math.sin(-theta)
                # Actually cos(-θ)=cosθ, sin(-θ)=-sinθ
                cos_t = math.cos(theta)
                sin_t = -math.sin(theta)
                # bounding box: integer points with coordinates within 1 of center
                ix_min = math.floor(x - 1)
                ix_max = math.ceil(x + 1)
                iy_min = math.floor(y - 1)
                iy_max = math.ceil(y + 1)
                for i in range(ix_min, ix_max+1):
                    for j in range(iy_min, iy_max+1):
                        # vector from center to integer point
                        dx = i - x
                        dy = j - y
                        # rotate by -theta: (dx', dy') = R(-θ)*(dx,dy)
                        # R(-θ) = [[cosθ, sinθ], [-sinθ, cosθ]]
                        dxp = cos_t*dx + sin_t*dy
                        dyp = -sin_t*dx + cos_t*dy
                        if abs(dxp) <= 0.5 + 1e-12 and abs(dyp) <= 0.5 + 1e-12:
                            return True
                return False
            
