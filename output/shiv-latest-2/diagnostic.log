            import sympy as sp
            from collections import deque, defaultdict
            
            # Known values
            known = {0: 9, 1: 27, 2: 3, 10: 63}
            # Represent each g(x) as sympy expression (linear in unknown symbols)
            expr = {}
            # For known, set expression as constant
            for k,v in known.items():
                expr[k] = sp.Integer(v)
            
            # Unknown symbols dictionary
            sym_vars = {}
            def get_sym(x):
                if x not in sym_vars:
                    sym_vars[x] = sp.Symbol(f'g_{x}')
                return sym_vars[x]
            
            # BFS queue of a's to process (where we know expression for g(a))
            queue = deque(known.keys())
            processed = set()
            
            while queue:
                a = queue.popleft()
                if a in processed:
                    continue
                processed.add(a)
                ga = expr[a]  # sympy expression (maybe constant or symbolic)
                # compute nodes p = a + ga, q = a - ga
                # Since ga may be symbolic, p and q may be symbolic expressions, not integers.
                # But a and ga are integers? ga may be symbolic variable, not integer, can't compute p.
                # So we can only generate edges when ga is known integer constant.
                if not ga.is_number:
                    continue
                ga_int = int(ga)
                p = a + ga_int
                q = a - ga_int
                const = 2*ga_int
                # Equation: g(p) + g(q) = const
                # If both unknown, we can set one as new symbol and express other.
                if p not in expr and q not in expr:
                    # introduce symbol for p, express q
                    gp = get_sym(p)
                    expr[p] = gp
                    expr[q] = const - gp
                    queue.append(p)
                    queue.append(q)
                elif p in expr and q not in expr:
                    # compute q from equation
                    gp = expr[p]
                    gq = const - gp
                    expr[q] = sp.simplify(gq)
                    queue.append(q)
                elif q in expr and p not in expr:
                    gq = expr[q]
                    gp = const - gq
                    expr[p] = sp.simplify(gp)
                    queue.append(p)
                else:
                    # both known, check consistency
                    if sp.simplify(expr[p] + expr[q] - const) != 0:
                        print("Inconsistency!", a, p, q, const, expr[p], expr[q])
                        raise ValueError
            
            len(expr)
            
