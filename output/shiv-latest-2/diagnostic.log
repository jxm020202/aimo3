            import random, math, numpy as np, sympy as sp
            
            def ratio_for_triangle(D, E, F):
                # D,E,F are tuples (x,y)
                D = np.array(D, dtype=float)
                E = np.array(E, dtype=float)
                F = np.array(F, dtype=float)
                # circumcenter P: intersection of perpendicular bisectors of DE and DF
                # Use formula via solving linear equations.
                # Solve for center O = (x,y) such that |O-D|^2 = |O-E|^2 and |O-D|^2 = |O-F|^2
                A = np.array([
                    [2*(E[0]-D[0]), 2*(E[1]-D[1])],
                    [2*(F[0]-D[0]), 2*(F[1]-D[1])]
                ])
                b = np.array([
                    (E[0]**2+E[1]**2 - D[0]**2 - D[1]**2),
                    (F[0]**2+F[1]**2 - D[0]**2 - D[1]**2)
                ])
                P = np.linalg.solve(A,b)
                # incenter Q: intersection of angle bisectors. Coordinates: weighted average of vertices by side lengths.
                a = np.linalg.norm(E-F)  # side opposite D
                b_len = np.linalg.norm(D-F)  # opposite E
                c = np.linalg.norm(D-E)  # opposite F
                Q = (a*D + b_len*E + c*F) / (a+b_len+c)
                # line PQ direction vector
                v = P - Q
                # line L direction perpendicular to v: rotate 90 degrees
                # Choose perpendicular vector w = ( -v[1], v[0] )
                w = np.array([-v[1], v[0]])
                # param eq: X = Q + t*w
                # Intersection with line DE: solve for t such that point lies on line through D and E.
                # Solve (Q + t w - D) cross (E-D) = 0 (2D cross product scalar)
                DE = E - D
                # cross product in 2D: (a,b) x (c,d) = a*d - b*c
                def cross(a,b):
                    return a[0]*b[1] - a[1]*b[0]
                tM = cross(D - Q, DE) / cross(w, DE)  # because cross(Q + t w - D, DE) = 0 => cross(Q-D, DE) + t cross(w, DE)=0 => t = -cross(Q-D, DE)/cross(w,DE)
                # Actually compute: cross(Q + t w - D, DE) = 0 => cross(Q-D, DE) + t cross(w, DE) = 0 => t = -cross(Q-D, DE)/cross(w, DE)
                tM = -cross(Q - D, DE) / cross(w, DE)
                M = Q + tM * w
                # External angle bisector at F: line that bisects external angle at F.
                # Internal angle bisector direction is sum of unit vectors along sides FA and FB? Actually at vertex F, internal bisector direction is normalized sum of unit vectors along sides FD and FE.
                # External bisector direction is difference of those unit vectors (or sum of one with negative of other). More precisely, external bisector is line through F that bisects angle between extensions of sides beyond F.
                # For external bisector, direction vector can be normalized difference of unit vectors along FD and FE (one of them reversed).
                # Let's compute unit vectors along FD (from F to D) and FE (from F to E).
                uFD = (D - F) / np.linalg.norm(D - F)
                uFE = (E - F) / np.linalg.norm(E - F)
                # Internal bisector direction = uFD + uFE (assuming both point away from F). External bisector direction = uFD - uFE (or uFE - uFD) whichever gives line external.
                # Both are perpendicular? Not necessarily.
                # The external bisector is perpendicular to internal bisector? Actually internal and external bisectors are perpendicular.
                # Indeed internal bisector direction vector = uFD + uFE (sum). External bisector direction vector = uFD - uFE (difference). They are orthogonal because (uFD+uFE)·(uFD-uFE)=|uFD|^2 - |uFE|^2 = 1-1=0.
                # So we can use direction w_ext = uFD - uFE.
                w_ext = uFD - uFE
                # Intersection of line L (Q + t w) with external bisector line (F + s w_ext)
                # Solve Q + t w = F + s w_ext
                # 2 equations 2 unknowns.
                A_mat = np.column_stack((w, -w_ext))  # columns for t and s
                b_vec = F - Q
                # Solve for t,s
                try:
                    ts = np.linalg.solve(A_mat, b_vec)
                except np.linalg.LinAlgError:
                    return None
                tN = ts[0]
                N = Q + tN * w
                # Compute distances QM, QN (positive lengths)
                QM = np.linalg.norm(M - Q)
                QN = np.linalg.norm(N - Q)
                return QM/QN
            
            def test_random():
