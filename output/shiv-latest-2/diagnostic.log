            def find_matrix_target(u, v, det_target=1, max_t=1000, max_s=1000):
                # Solve 11a + 3b = u
                # Find particular solution via extended Euclid
                from math import gcd
                g = gcd(11,3)
                assert g == 1
                # Use extended Euclid to find x0,y0 such that 11*x0 + 3*y0 = 1
                # Then multiply by u
                def egcd(a,b):
                    if b==0:
                        return (1,0,a)
                    else:
                        x,y,g = egcd(b, a%b)
                        return (y, x - (a//b)*y, g)
                x0,y0,_ = egcd(11,3)  # 11*x0 + 3*y0 = 1
                a0 = x0 * u
                b0 = y0 * u
                # general: a = a0 + 3t, b = b0 - 11t
                # Solve 11c + 3d = v
                c0 = x0 * v
                d0 = y0 * v
                # general: c = c0 + 3s, d = d0 - 11s
                for t in range(-max_t, max_t+1):
                    a = a0 + 3*t
                    b = b0 - 11*t
                    for s in range(-max_s, max_s+1):
                        c = c0 + 3*s
                        d = d0 - 11*s
                        if a*d - b*c == det_target:
                            return (a,b,c,d)
                return None
            
            def test_target(frac):
                u = frac.numerator
                v = frac.denominator
                mat1 = find_matrix_target(u,v,det_target=1, max_t=200, max_s=200)
                mat_minus = find_matrix_target(u,v,det_target=-1, max_t=200, max_s=200)
                return mat1 is not None, mat_minus is not None
            
            for t in targets:
                print(t, test_target(t))
            
