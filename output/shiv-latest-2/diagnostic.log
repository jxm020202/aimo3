            import random, math, itertools, sys, time, numpy as np
            
            def max_in_wedge(angles, width):
                # angles sorted in [0, 2pi)
                n = len(angles)
                if n == 0:
                    return 0
                # duplicate list with +2pi for wrap-around
                angles2 = angles + [a+2*math.pi for a in angles]
                maxcnt = 0
                j = 0
                for i in range(n):
                    while j < i+n and angles2[j] - angles2[i] <= width + 1e-12:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
            def total_sum(points, width_deg=100):
