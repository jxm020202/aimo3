                B = np.array([mid_YZ[0]-mid_WX[0], mid_YZ[1]-mid_WX[1]], dtype=float)
                a,b = np.linalg.solve(A,B)
                N = (mid_WX[0] + a*perp_WX[0], mid_WX[1] + a*perp_WX[1])
