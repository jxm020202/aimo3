            import math, sympy as sp
            
            def is_inside(x,y,s):
                # inside triangle if y>=0 and y <= sqrt3*x and y <= -sqrt3*(x-s)
                sqrt3 = math.sqrt(3)
                if y < -1e-9: 
                    return False
                if x < -1e-9 or x > s+1e-9:
                    return False
                # left side condition if x <= s/2
                if x <= s/2 + 1e-9:
                    if y - sqrt3*x > 1e-9:
                        return False
                else:
                    if y - (-sqrt3*(x - s)) > 1e-9:
                        return False
                return True
            
