            import random, math, cmath, numpy as np
            
            def angle_NMO(theta1, theta2, a, c, d):
                # direction vectors
                d1 = np.array([math.cos(theta1), math.sin(theta1)])
                d2 = np.array([math.cos(theta2), math.sin(theta2)])
                w = a * d1
                y = (a - d) * d1
                x = c * d2
                z = (c - d) * d2
                # compute N: intersection of perp bisectors of WX and YZ
                # Solve linear equations: (N - w).(x - w) = (|x|^2 - |w|^2)/2? Actually condition |N-w|=|N-x|
                # Equivalent: (N).(x - w) = (|x|^2 - |w|^2)/2
                # Similarly for YZ: N.(z - y) = (|z|^2 - |y|^2)/2
                A = np.vstack([x - w, z - y])
                b = np.array([(np.dot(x, x) - np.dot(w, w))/2.0,
                              (np.dot(z, z) - np.dot(y, y))/2.0])
                N = np.linalg.solve(A, b)
                # O: perp bisectors of XY and WZ
                A2 = np.vstack([y - x, z - w])
                b2 = np.array([(np.dot(y, y) - np.dot(x, x))/2.0,
                              (np.dot(z, z) - np.dot(w, w))/2.0])
                O = np.linalg.solve(A2, b2)
                # angle between N and O
                dot = np.dot(N, O)
                normN = np.linalg.norm(N)
                normO = np.linalg.norm(O)
                ang = math.degrees(math.acos(dot/(normN*normO)))
                return ang
            
            def random_test():
                for _ in range(10):
                    theta1 = random.uniform(0, 2*math.pi)
                    theta2 = random.uniform(0, 2*math.pi)
                    # ensure not collinear
                    while abs(math.sin(theta2 - theta1)) < 1e-3:
                        theta2 = random.uniform(0, 2*math.pi)
                    a = random.uniform(-5,5)
                    c = random.uniform(-5,5)
                    dlen = random.uniform(0.5,5)
                    ang = angle_NMO(theta1, theta2, a, c, dlen)
                    print(ang)
            
            random_test()
            
