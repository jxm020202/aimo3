            def order_of_2_mod_n(n):
                # compute smallest t>0 such that 2^t ≡ 1 mod n, if gcd(2,n)=1
                if math.gcd(2, n) != 1:
                    return None
                t = 1
                cur = 2 % n
                while cur != 1:
                    cur = (cur * 2) % n
                    t += 1
                    if t > 10000:
                        return None
                return t
            
