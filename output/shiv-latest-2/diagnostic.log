                uy = ((x1**2+y1**2)*(x3-x2)+(x2**2+y2**2)*(x1-x3)+(x3**2+y3**2)*(x2-x1))/d
                return (ux, uy)
            
            def incenter(A,B,C):
                # side lengths opposite each vertex
                a = math.hypot(B[0]-C[0], B[1]-C[1])  # opposite A
                b = math.hypot(A[0]-C[0], A[1]-C[1])  # opposite B
                c = math.hypot(A[0]-B[0], A[1]-B[1])  # opposite C
                p = a+b+c
                x = (a*A[0] + b*B[0] + c*C[0])/p
                y = (a*A[1] + b*B[1] + c*C[1])/p
                return (x,y)
            
            def external_bisector_line(F, D, E):
                # direction vector = unit(FD) - unit(FE)
                v1 = (D[0]-F[0], D[1]-F[1])
                v2 = (E[0]-F[0], E[1]-F[1])
                len1 = math.hypot(*v1)
                len2 = math.hypot(*v2)
                u1 = (v1[0]/len1, v1[1]/len1)
                u2 = (v2[0]/len2, v2[1]/len2)
                v = (u1[0]-u2[0], u1[1]-u2[1])
                # line param: F + t*v
                return (F, v)
            
            def line_intersection(P1, d1, P2, d2):
                # solve P1 + t*d1 = P2 + s*d2
                x1,y1 = P1; dx1,dy1 = d1
                x2,y2 = P2; dx2,dy2 = d2
                # solve for t,s using 2x2 linear system
                # t*dx1 - s*dx2 = x2 - x1
                # t*dy1 - s*dy2 = y2 - y1
                det = dx1*(-dy2) - (-dx2)*dy1  # actually determinant of [[dx1, -dx2],[dy1,-dy2]]
                # compute using matrix:
                det = dx1*(-dy2) - (-dx2)*dy1
                # but easier: solve using numpy? We'll compute manually.
                # Let's compute using linear algebra:
                # [dx1, -dx2][t] = [x2-x1]
                # [dy1, -dy2][s]   [y2-y1]
                A = [[dx1, -dx2],[dy1, -dy2]]
                B = [x2-x1, y2-y1]
                # compute determinant
                det = A[0][0]*A[1][1] - A[0][1]*A[1][0]
                if abs(det) < 1e-12:
                    raise ValueError("parallel")
                t = (B[0]*A[1][1] - B[1]*A[0][1]) / det
                # s = (A[0][0]*B[1] - A[1][0]*B[0]) / det
                # point = P1 + t*d1
                return (x1 + t*dx1, y1 + t*dy1)
            
            def ratio_for_triangle(D,E,F):
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line PQ direction
                dPQ = (P[0]-Q[0], P[1]-Q[1])
                # line through Q perpendicular to PQ: direction perpendicular to dPQ
                # rotate 90 degrees: ( -dy, dx )
                d_perp = (-dPQ[1], dPQ[0])
                # intersection with DE (line from D to E)
                # DE direction:
                dDE = (E[0]-D[0], E[1]-D[1])
                M = line_intersection(Q, d_perp, D, dDE)
                # external bisector line at F
                F_point, v_ext = external_bisector_line(F, D, E)
                N = line_intersection(Q, d_perp, F_point, v_ext)
                # distances
                QM = math.hypot(Q[0]-M[0], Q[1]-M[1])
                QN = math.hypot(Q[0]-N[0], Q[1]-N[1])
                return QM/QN
            
