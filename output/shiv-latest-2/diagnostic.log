            def compute_info(n, max_terms=5000000):
                a = [pow(2, k, n) for k in range(n)]
                # initial state corresponds to indices 0..n-1, last index = n-1
                seen = {}
                state = tuple(a[-n:])
                seen[state] = n-1
                idx = n  # next index to compute
                while idx < max_terms:
                    next_term = sum(a[-n:]) % n
                    a.append(next_term)
                    # new state after adding next_term: indices idx-n+1 .. idx
                    state = tuple(a[-n:])
                    if state in seen:
                        prev_idx = seen[state]
                        period_len = idx - prev_idx
                        # period sequence: from prev_idx - n + 1 + 1? Let's compute start index of period
                        # The state repeats at idx, meaning the vector of last n terms at idx equals that at prev_idx.
                        # So the sequence from (prev_idx+1) to idx is a period (inclusive of idx?).
                        # Actually at prev_idx we had same state, meaning the terms ending at prev_idx are same as ending at idx.
                        # So the next term after prev_idx will be same as term after idx, etc.
                        # So period length = idx - prev_idx.
                        start = prev_idx - n + 1  # first index of the period? Let's check with small n.
