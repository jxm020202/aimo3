            def max_zero_run_fast(n, max_terms):
                # generate initial a[0..n-1]
                a = [pow(2, k, n) for k in range(n)]
                # sliding window sum
                window_sum = sum(a) % n
                max_run = 0
                current = 0
                # check initial terms
                for val in a:
                    if val % n == 0:
                        current += 1
                        max_run = max(max_run, current)
                    else:
