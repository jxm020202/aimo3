            import random, math, sympy as sp
            
            def angle_NMO(params):
                # params: (u,v,s,t)
                u,v,s,t = params
                # Points
                W = sp.Point(-1,0)
                X = sp.Point(1,0)
                Y = sp.Point(u,v)
                Z = sp.Point(s,t)
                # Diagonal lengths equality condition: (u+1)^2+v^2 = (s-1)^2+t^2
                # We'll assume they satisfy.
                # Intersection M of WY and XZ
                # Solve param eqs
                lam, mu = sp.symbols('lam mu')
                sol = sp.solve([
                    -1 + lam*(u+1) - (1 + mu*(s-1)),
                    lam*v - mu*t
                ], (lam, mu), dict=True)
                if not sol:
                    return None
                sol = sol[0]
                lam_val = sol[lam]
                mu_val = sol[mu]
                M = sp.Point(-1 + lam_val*(u+1), lam_val*v)
                # N: intersection of x=0 and perp bisector of YZ
                # compute y_N
                yN = (v+t)/2 + ((s - u)*(u+s))/(2*(t - v))
                N = sp.Point(0, yN)
                # O: intersection of perp bisectors of XY and WZ
                # Solve linear equations
                x, y = sp.symbols('x y')
                # eq1: (y - v/2) = -(u-1)/v * (x - (1+u)/2)
                eq1 = sp.Eq(y - v/2, -(u-1)/v * (x - (1+u)/2))
                # eq2: (y - t/2) = -(s+1)/t * (x - (-1+s)/2)
                eq2 = sp.Eq(y - t/2, -(s+1)/t * (x - (-1+s)/2))
                solO = sp.solve([eq1, eq2], (x, y), dict=True)
                if not solO:
                    return None
                O = sp.Point(solO[0][x], solO[0][y])
                # Compute vectors
                MN = sp.Matrix([N.x - M.x, N.y - M.y])
                MO = sp.Matrix([O.x - M.x, O.y - M.y])
                # dot product and norms
                dot = MN.dot(MO)
                normMN = sp.sqrt(MN.dot(MN))
                normMO = sp.sqrt(MO.dot(MO))
                # angle
                # Use sympy acos
                angle = sp.acos(dot/(normMN*normMO))
                # simplify numeric
                angle_val = float(angle.evalf())
                return angle_val
            
            def random_params():
                # generate random u,v,s,t satisfying equal diagonal condition
                # Choose u,v,s randomly then compute t to satisfy equality.
                # Condition: (u+1)^2+v^2 = (s-1)^2 + t^2 => t^2 = (u+1)^2+v^2 - (s-1)^2
                # Need RHS >=0.
                while True:
                    u = random.uniform(-2,2)
                    v = random.uniform(-2,2)
                    s = random.uniform(-2,2)
                    rhs = (u+1)**2 + v**2 - (s-1)**2
