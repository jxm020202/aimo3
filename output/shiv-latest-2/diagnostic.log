                        cur = 0
                        for val in period_seq:
                            if val % n == 0:
                                cur += 1
                                max_within = max(max_within, cur)
                            else:
                                cur = 0
                        # leading zeros
                        lead = 0
                        for val in period_seq:
                            if val % n == 0:
                                lead += 1
                            else:
                                break
                        # trailing zeros
                        trail = 0
                        for val in reversed(period_seq):
                            if val % n == 0:
                                trail += 1
                            else:
                                break
                        max_cross = lead + trail
                        max_total = max(max_within, max_cross)
                        # overall max up to idx
                        max_overall = 0
                        cur = 0
                        for val in a[:idx+1]:
                            if val % n == 0:
                                cur += 1
                                max_overall = max(max_overall, cur)
                            else:
                                cur = 0
                        return {
                            "n": n,
                            "max_overall": max_overall,
                            "max_within": max_within,
