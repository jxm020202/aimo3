            import random, math
            
            def ratio_from_radii(r):
                # r list of 4 positive radii
                k = [1/ri for ri in r]  # curvatures positive
                S = sum(k)
                Q = sum(ki**2 for ki in k)
                D = 3*(S**2 - 2*Q)
                if D <= 0:
                    return None
                sqrtD = math.sqrt(D)
                k5_pos = (S + sqrtD)/2  # positive solution
                k5_neg = (S - sqrtD)/2  # could be negative
                # ensure k5_neg negative
                # ratio largest radius to smallest radius:
                # largest radius = -1/k5_neg (if k5_neg negative)
                # smallest radius = 1/k5_pos
                if k5_neg >= 0:
                    # maybe outer is the positive one? Actually outer must be negative curvature.
                    # If both positive, then maybe configuration not as described.
                    return None
                ratio = (-1/k5_neg) / (1/k5_pos)
                return ratio
            
