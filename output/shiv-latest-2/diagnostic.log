            import itertools
            def max_product_n(n):
                total = n*(n+1)//2
                max_val = -1e9
                best = None
                for mask in range(1, 1<<n):  # A non-empty
                    A = [i+1 for i in range(n) if mask & (1<<i)]
                    B = [i+1 for i in range(n) if not (mask & (1<<i))]
                    a = len(A)
                    b = len(B)
                    if a<1 or a>n-2: # ensure B size >=2? For n=10, constraints: 1<=|A|<=n-2, 2<=|B|<=n-1
