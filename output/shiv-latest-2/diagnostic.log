            def max_zero_run_fast(n, max_terms):
                # maintain circular buffer of last n terms
                from collections import deque
                buf = deque(maxlen=n)
                # initial terms
                for k in range(1, n+1):
                    val = pow(2, k-1, n)
                    buf.append(val)
                # compute sum of buffer
                cur_sum = sum(buf) % n
                max_run = 0
                cur_len = 0
                # check initial terms for zeros
                # Actually we need to check each term as we generate
                # We'll generate terms from 1 to max_terms
                # We'll store last n terms in buffer; for k <= n, we already have them
                # We'll iterate k from 1 to max_terms
                # For k <= n, we already have term in buffer at position k-1
                # Let's just generate sequentially
                # We'll use list to store terms for checking zeros
                # But we can just check on the fly
                # We'll generate terms sequentially using buffer and sum
                # For k from 1 to max_terms:
                #   term = buf[-1] if k <= n else next_term
                #   check zero
                #   update buffer and sum
                # Actually easier: generate terms in a loop
                terms = []
                # generate first n terms
                for k in range(1, n+1):
                    val = pow(2, k-1, n)
                    terms.append(val)
                    if val == 0:
                        cur_len += 1
                        max_run = max(max_run, cur_len)
                    else:
                        cur_len = 0
                # now buffer holds last n terms
                buf = deque(terms[-n:], maxlen=n)
                cur_sum = sum(buf) % n
                # generate further terms
                for k in range(n+1, max_terms+1):
                    next_val = cur_sum % n
                    terms.append(next_val)
                    if next_val == 0:
                        cur_len += 1
                        max_run = max(max_run, cur_len)
                    else:
                        cur_len = 0
                    # update buffer and sum
                    oldest = buf.popleft()
                    cur_sum = (cur_sum - oldest + next_val) % n
                    buf.append(next_val)
                return max_run
            
            print(max_zero_run_fast(100, 2000000))
            
