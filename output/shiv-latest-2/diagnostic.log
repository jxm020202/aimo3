            import random, math, numpy as np, sympy as sp
            
            def circumcenter(A,B,C):
                # using sympy geometry maybe easier
                Ax,Ay = A
                Bx,By = B
                Cx,Cy = C
                D = 2*(Ax*(By-Cy) + Bx*(Cy-Ay) + Cx*(Ay-By))
                if abs(D) < 1e-9:
                    return None
                Ux = ((Ax**2+Ay**2)*(By-Cy) + (Bx**2+By**2)*(Cy-Ay) + (Cx**2+Cy**2)*(Ay-By))/D
                Uy = ((Ax**2+Ay**2)*(Cx-Bx) + (Bx**2+By**2)*(Ax-Cx) + (Cx**2+Cy**2)*(Bx-Ax))/D
                return np.array([Ux, Uy], dtype=float)
            
            def incenter(A,B,C):
                # lengths
                a = np.linalg.norm(np.array(B)-np.array(C))
                b = np.linalg.norm(np.array(C)-np.array(A))
                c = np.linalg.norm(np.array(A)-np.array(B))
                P = a*np.array(A) + b*np.array(B) + c*np.array(C)
                return P/(a+b+c)
            
            def external_angle_bisector(F, D, E):
                # external bisector at angle DFE (i.e., angle formed by DF and EF)
                # internal bisector direction = normalized sum of unit vectors along FD and FE
                # external bisector direction = normalized difference of unit vectors? Actually external bisector is line that bisects supplementary angle, i.e., direction = normalized (u - v) where u,v are unit vectors along FD and FE.
                # Let's compute unit vectors from F to D and F to E.
                FD = np.array(D)-np.array(F)
                FE = np.array(E)-np.array(F)
                u = FD/np.linalg.norm(FD)
                v = FE/np.linalg.norm(FE)
                # internal bisector direction = u/|u| + v/|v| (both unit) = u+v
                # external bisector direction = u - v (or v - u) whichever gives external side. Both are opposite directions; line is same.
                dir_ext = u - v
                # line passes through F with direction dir_ext.
                return np.array(F, dtype=float), dir_ext/np.linalg.norm(dir_ext)
            
            def line_intersection(P1, d1, P2, d2):
                # Solve P1 + t*d1 = P2 + s*d2
                # 2 equations, 2 unknowns t,s
                A = np.column_stack((d1, -d2))
                b = np.array(P2) - np.array(P1)
                # solve linear system
                try:
                    t_s = np.linalg.lstsq(A, b, rcond=None)[0]
                except Exception as e:
                    return None
                t = t_s[0]
                # intersection point
                return P1 + t*d1
            
            def compute_ratio(D,E,F):
                D=np.array(D,float);E=np.array(E,float);F=np.array(F,float)
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line through Q perpendicular to PQ
                v = P - Q
                # direction of line ℓ is perpendicular to v, so rotate 90 degrees
                # choose direction w = ( -v[1], v[0] )
                w = np.array([-v[1], v[0]])
                # intersection with DE line
                M = line_intersection(Q, w, D, E-D)
                # external bisector at F
                F0, dir_ext = external_angle_bisector(F, D, E)
                N = line_intersection(Q, w, F0, dir_ext)
                if M is None or N is None:
                    return None
                QM = np.linalg.norm(M-Q)
                QN = np.linalg.norm(N-Q)
                return QM/QN
            
            def random_triangle():
                # generate random points not collinear
                while True:
                    A = np.random.rand(2)*10
                    B = np.random.rand(2)*10
                    C = np.random.rand(2)*10
                    # area not too small
                    if abs(np.cross(B-A, C-A)) > 1e-2:
                        return A,B,C
            
            ratios=[]
            for _ in range(100):
                D,E,F = random_triangle()
                r = compute_ratio(D,E,F)
                ratios.append(r)
            ratios[:10], np.mean(ratios), np.std(ratios)
            
