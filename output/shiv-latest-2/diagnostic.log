            import random, math, itertools
            
            def exists_config_poly(coeffs, d, n, M=5):
                # coeffs list from highest degree to constant, degree < d
                # evaluate polynomial
                def eval_poly(x):
                    res = 0
                    for i,c in enumerate(coeffs):
                        res = res*x + c
                    return res
                # search k from 0..n
                for k in range(0, n+1):
                    # choose k+1 distinct ints in range
                    for combo in itertools.permutations(range(-M, M+1), k+1):
                        if len(set(combo)) != k+1:
                            continue
                        a_vals = combo
                        lhs = eval_poly(a_vals[-1]) - sum(eval_poly(x) for x in a_vals[:-1])
                        rhs = a_vals[-1]**d - sum(x**d for x in a_vals[:-1])
                        if lhs == rhs:
                            return True
                return False
            
            def test_n(n, trials=200, coeff_range=3, M=5):
                for d in range(1, n+1):
                    # generate random polynomials of degree < d
                    for _ in range(trials):
                        deg = random.randint(0, d-1)
                        coeffs = [random.randint(-coeff_range, coeff_range) for _ in range(deg+1)]
                        # ensure leading coeff non-zero if deg>0
                        if deg>0 and coeffs[0]==0:
                            coeffs[0]=random.choice([i for i in range(-coeff_range, coeff_range+1) if i!=0])
