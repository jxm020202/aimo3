            import random, math, numpy as np
            def allowed_area_mc_fast(theta, N=200000):
                xs = np.random.rand(N)
                ys = np.random.rand(N)
                cos = math.cos(-theta)
                sin = math.sin(-theta)
                dx = np.stack([-xs, 1 - xs, -xs, 1 - xs])
                dy = np.stack([-ys, -ys, 1 - ys, 1 - ys])
                u = cos*dx - sin*dy
                v = sin*dx + cos*dy
                inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)
                covered = inside.any(axis=0)
                return (~covered).mean()
            
            def allowed_area_formula(theta):
                w = abs(math.cos(theta)) + abs(math.sin(theta))
                return max(0.0, (w - 1)**2)
            
