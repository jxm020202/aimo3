            import math
            
            def last_nonzero_digit_fact(n):
                # compute n! removing factors of 10
                # naive but okay for n up to maybe 2000
                res = 1
                for i in range(2, n+1):
                    x = i
                    while x % 5 == 0:
                        x //= 5
                        # will later balance with 2s
                    while x % 2 == 0:
                        x //= 2
                    res = (res * x) % 10
                # now need to multiply by appropriate power of 2 to account for removed 2s from factors of 5
                # count number of 2s removed vs 5s removed
                # Actually we removed all 2s from each i; we need to add back the excess 2s after pairing with 5s.
                # Simpler: compute factorial normally, strip trailing zeros, mod 10.
                # Let's just compute using big integers for n up to 2000.
            def last_nonzero_digit_fact_big(n):
                res = 1
                for i in range(2, n+1):
                    res *= i
                    while res % 10 == 0:
                        res //= 10
                    res %= 100000  # keep manageable
                return res % 10
            
            def f(n):
                return last_nonzero_digit_fact_big(n)
            
            # test
            print([f(i) for i in range(1,21)])
            
