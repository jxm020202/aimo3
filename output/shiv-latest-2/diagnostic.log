            import random, math, numpy as np
            def circumcenter(A,B,C):
                # using formula based on perpendicular bisectors
                # coordinates as tuples
                ax, ay = A
                bx, by = B
                cx, cy = C
                d = 2*(ax*(by-cy) + bx*(cy-ay) + cx*(ay-by))
                if abs(d) < 1e-9:
                    return None
                ux = ((ax**2+ay**2)*(by-cy) + (bx**2+by**2)*(cy-ay) + (cx**2+cy**2)*(ay-by))/d
                uy = ((ax**2+ay**2)*(cx-bx) + (bx**2+by**2)*(ax-cx) + (cx**2+cy**2)*(bx-ax))/d
                return (ux, uy)
            
            def incenter(A,B,C):
                # side lengths
                a = math.hypot(B[0]-C[0], B[1]-C[1]) # opposite A
                b = math.hypot(A[0]-C[0], A[1]-C[1]) # opposite B
                c = math.hypot(A[0]-B[0], A[1]-B[1]) # opposite C
                px = (a*A[0] + b*B[0] + c*C[0])/(a+b+c)
                py = (a*A[1] + b*B[1] + c*C[1])/(a+b+c)
                return (px, py)
            
            def line_through_point_perp_to_vec(Q, vec):
                # returns line in param form: point Q + t * v_perp, where v_perp is perpendicular to vec
                # choose v_perp = (-vec[1], vec[0])
                vx, vy = -vec[1], vec[0]
                return (Q, (vx, vy))
            
            def intersect_line_line(p1, d1, p2, d2):
                # solve p1 + t1*d1 = p2 + t2*d2
                # 2D solve linear equations
                x1,y1 = p1
                dx1,dy1 = d1
                x2,y2 = p2
                dx2,dy2 = d2
                # solve for t1:
                # (x1 + t1*dx1) = (x2 + t2*dx2)
                # (y1 + t1*dy1) = (y2 + t2*dy2)
                # rewrite as t1*dx1 - t2*dx2 = x2 - x1
                # t1*dy1 - t2*dy2 = y2 - y1
                # solve linear system for t1,t2
                A = np.array([[dx1, -dx2],[dy1, -dy2]], dtype=float)
                b = np.array([x2 - x1, y2 - y1], dtype=float)
                try:
                    t1, t2 = np.linalg.solve(A,b)
                except np.linalg.LinAlgError:
                    return None
                return (x1 + t1*dx1, y1 + t1*dy1)
            
            def ratio_for_triangle(D,E,F):
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line ℓ through Q perpendicular to PQ
                vec_PQ = (P[0]-Q[0], P[1]-Q[1])
                # direction v = perpendicular to PQ
                v = (-vec_PQ[1], vec_PQ[0])
                # ℓ param: Q + t*v
                # side DE line
                # direction for DE:
                d_DE = (E[0]-D[0], E[1]-D[1])
                M = intersect_line_line(Q, v, D, d_DE)
                # external bisector at F: line through F perpendicular to FQ
                vec_FQ = (Q[0]-F[0], Q[1]-F[1])
                # direction for external bisector = perpendicular to FQ
                d_ext = (-vec_FQ[1], vec_FQ[0])
                N = intersect_line_line(Q, v, F, d_ext)
                # distances
                QM = math.hypot(M[0]-Q[0], M[1]-Q[1])
                QN = math.hypot(N[0]-Q[0], N[1]-Q[1])
                return QM/QN
            
            # test random triangles
            for i in range(10):
                D = (random.uniform(-5,5), random.uniform(-5,5))
                E = (random.uniform(-5,5), random.uniform(-5,5))
                F = (random.uniform(-5,5), random.uniform(-5,5))
                # ensure non-collinear
                area = abs((E[0]-D[0])*(F[1]-D[1]) - (E[1]-D[1])*(F[0]-D[0]))
                if area < 1e-3:
                    continue
                r = ratio_for_triangle(D,E,F)
                print(r)
            
