            def berlekamp_massey(sequence, mod):
                # returns minimal linear recurrence coefficients c such that
                # s[n] = - sum_{i=1}^{L} c[i-1] * s[n-i] (mod mod)
                n = len(sequence)
                C = [1] + [0]*n
                B = [1] + [0]*n
                L = 0
                m = -1
                for i in range(n):
                    # compute discrepancy
                    d = sequence[i]
                    for j in range(1, L+1):
                        d = (d + C[j]*sequence[i-j]) % mod
                    if d == 0:
                        continue
                    T = C[:]
                    coeff = d * pow(B[0], -1, mod) % mod
                    for j in range(i-m, n):
                        C[j] = (C[j] - coeff * B[j-(i-m)]) % mod
                    if 2*L <= i:
                        L = i+1-L
                        B = T
                        m = i
                # return recurrence of length L (excluding leading 1)
                return [(-c) % mod for c in C[1:L+1]]
            
            seq25 = generate_mod_seq(25, 100, 500)
            rec = berlekamp_massey(seq25, 25)
