            def last_nonzero_digit_fact(n):
                # compute n! removing factors of 10, then mod 10
                res=1
                for i in range(2,n+1):
                    x=i
                    while x%5==0:
                        x//=5
                        # will need to balance with 2 later
                    while x%2==0:
                        x//=2
                    res = (res*x)%10
                # after removing all 2s and 5s, need to multiply back extra 2s (since there are more 2s than 5s)
                # Count total number of 2s and 5s removed
                # Actually we removed all 2s from each i, but we need to re-add the excess 2s (difference between count of 2s and 5s)
                # Let's compute counts
            def last_nonzero_digit_fact2(n):
                # using known algorithm: multiply numbers 1..n, removing factors of 10 each step
                res=1
                for i in range(1,n+1):
                    x=i
                    while x%10==0:
                        x//=10
                    while x%5==0:
                        x//=5
                        res = (res*2)%10  # replace factor 5 with 2 (since we need to keep product of 2s and 5s balanced)
                    res = (res*(x%10))%10
                return res
            
