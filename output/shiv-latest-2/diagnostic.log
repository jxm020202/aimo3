            import random, math, cmath, itertools, sys, numpy as np
            
            def compute_angle(A,B,k):
                # compute l from condition (1+k)A = (1+l)B => 1+l = (1+k)A/B => l = (1+k)A/B - 1
                l = (1+k)*A/B - 1
                if l <= 0:
                    return None
                # points
                W = np.array([A,0.0])
                X = np.array([0.0,B])
                Y = np.array([-k*A,0.0])
                Z = np.array([0.0,-l*B])
                M = np.array([0.0,0.0])
                # function to compute intersection of two lines given point+direction
                def intersect(p1,d1,p2,d2):
                    # solve p1 + s*d1 = p2 + t*d2
                    # 2x2 linear
                    A_mat = np.column_stack((d1, -d2))
                    b_vec = p2 - p1
                    # solve for s,t
                    try:
                        sol = np.linalg.solve(A_mat, b_vec)
                    except np.linalg.LinAlgError:
                        return None
                    s = sol[0]
                    return p1 + s*d1
                # perpendicular direction function (rotate 90 deg)
                def perp(v):
                    return np.array([-v[1], v[0]])
                # N: perp bisectors of WX and YZ
                mid_WX = (W+X)/2
                dir_WX = X-W
                perp_WX = perp(dir_WX)
                mid_YZ = (Y+Z)/2
                dir_YZ = Z-Y
                perp_YZ = perp(dir_YZ)
                N = intersect(mid_WX, perp_WX, mid_YZ, perp_YZ)
                # O: perp bisectors of XY and WZ
                mid_XY = (X+Y)/2
                dir_XY = Y-X
                perp_XY = perp(dir_XY)
                mid_WZ = (W+Z)/2
                dir_WZ = Z-W
                perp_WZ = perp(dir_WZ)
                O = intersect(mid_XY, perp_XY, mid_WZ, perp_WZ)
                # compute angle NMO
                vN = N - M
                vO = O - M
                # angle between vectors
                dot = np.dot(vN, vO)
                normN = np.linalg.norm(vN)
                normO = np.linalg.norm(vO)
                angle = math.degrees(math.acos(dot/(normN*normO)))
                return angle, N, O, l
            
