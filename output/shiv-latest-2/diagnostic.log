            import math
            from fractions import Fraction
            def compute_solution(m):
                # m is Fraction
                # compute u
                num = 3*m.numerator**2 - 8*m.numerator*m.denominator - 48*m.denominator**2
                den = 2*(m.numerator**2 + 16*m.denominator**2)
                u = Fraction(num, den)
                # compute w = 2 + m*(u - 3/2)
                w = Fraction(2,1) + m * (u - Fraction(3,2))
                # compute t possibilities
                # t = (2u ± w)/(10u)
                sols = []
                if u != 0:
                    t1 = Fraction(2*u + w, 10*u)
                    t2 = Fraction(2*u - w, 10*u)
                    sols.append(t1)
                    sols.append(t2)
                else:
                    return []  # avoid division by zero
                results = []
                for t in sols:
                    # need t positive rational and less than 1
                    if t <= 0 or t >= 1:
                        continue
                    # compute s = u*(t+1) - 1
                    s = u*(t+1) - 1
                    # need s positive rational and less than 1
                    if s <= 0 or s >= 1:
                        continue
                    # compute x = (1 - t^2)/2, y = (1 - s^2)/2
                    x = Fraction(1,1) - t*t
                    x = x / 2
                    y = Fraction(1,1) - s*s
                    y = y / 2
                    # ensure positive
                    if x <= 0 or y <= 0:
                        continue
                    # compute denominators
                    denx = x.denominator
                    deny = y.denominator
                    k = math.lcm(denx, deny)
                    results.append((k, x, y, t, s, m))
                return results
            
            def search(limit):
                best = None
                for p in range(-limit, limit+1):
                    for q in range(1, limit+1):
                        m = Fraction(p, q)
                        sols = compute_solution(m)
                        for sol in sols:
                            k = sol[0]
                            if best is None or k < best[0]:
                                best = sol
                return best
            
            best = search(10)
            best
            
