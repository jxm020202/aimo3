            import random, math
            
            def angle_NMO(u,s,t,theta):
                v = s + t - u
                # points
                W = (-u, 0)
                Y = (v, 0)
                X = (t*math.cos(theta), t*math.sin(theta))
                Z = (-s*math.cos(theta), -s*math.sin(theta))
                # midpoints
                mid_WX = ((W[0]+X[0])/2, (W[1]+X[1])/2)
                mid_YZ = ((Y[0]+Z[0])/2, (Y[1]+Z[1])/2)
                mid_XY = ((X[0]+Y[0])/2, (X[1]+Y[1])/2)
                mid_WZ = ((W[0]+Z[0])/2, (W[1]+Z[1])/2)
                # direction vectors for perpendicular bisectors
                perp_WX = (-t*math.sin(theta), t*math.cos(theta)+u)
                perp_YZ = (s*math.sin(theta), -s*math.cos(theta)-v)
                # solve for intersection N: mid_WX + a*perp_WX = mid_YZ + b*perp_YZ
                # Solve linear equations for a,b
                import numpy as np
                A = np.array([[perp_WX[0], -perp_YZ[0]],
                              [perp_WX[1], -perp_YZ[1]]], dtype=float)
                B = np.array([mid_YZ[0]-mid_WX[0], mid_YZ[1]-mid_WX[1]], dtype=float)
                a,b = np.linalg.solve(A,B)
                N = (mid_WX[0] + a*perp_WX[0], mid_WX[1] + a*perp_WX[1])
                # O: perp_XY and perp_WZ
                perp_XY = (t*math.sin(theta), v - t*math.cos(theta))
                perp_WZ = (s*math.sin(theta), s*math.cos(theta)-u)
                A2 = np.array([[perp_XY[0], -perp_WZ[0]],
                               [perp_XY[1], -perp_WZ[1]]], dtype=float)
                B2 = np.array([mid_WZ[0]-mid_XY[0], mid_WZ[1]-mid_XY[1]], dtype=float)
                c,d = np.linalg.solve(A2,B2)
                O = (mid_XY[0] + c*perp_XY[0], mid_XY[1] + c*perp_XY[1])
                # angle between vectors N and O
                dot = N[0]*O[0] + N[1]*O[1]
                normN = math.hypot(N[0], N[1])
                normO = math.hypot(O[0], O[1])
                cosphi = dot/(normN*normO)
                # clamp due to numerical errors
                cosphi = max(-1,min(1,cosphi))
                phi = math.degrees(math.acos(cosphi))
                return phi
            
            # test random values
            for i in range(10):
                u = random.uniform(1,5)
                s = random.uniform(1,5)
                t = random.uniform(1,5)
                # ensure v positive: v = s + t - u > 0 => u < s+t
                if u >= s+t:
                    u = (s+t)/2
                theta = random.uniform(0.2, 2.5) # not too close to 0 or pi
                phi = angle_NMO(u,s,t,theta)
                print(phi)
            
