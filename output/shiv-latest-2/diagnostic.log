            def compute_S(alpha):
                b = 2*math.cos(alpha)
                r = float(r_expr.subs(α_sym, alpha).evalf())
                xS = r*math.cos(3*alpha)
                yS = -r*math.sin(3*alpha)
                return (xS, yS, r)
            
            def triangle_angles_PR_S(alpha):
                # compute triangle PRS angles
                b = 2*math.cos(alpha)
                R = (b*math.cos(alpha), b*math.sin(alpha))
                P = (0.0, 0.0)
                xS, yS, r = compute_S(alpha)
                S = (xS, yS)
                # side lengths
                a = math.hypot(R[0]-S[0], R[1]-S[1])  # RS opposite P
                b_len = math.hypot(P[0]-S[0], P[1]-S[1])  # PS opposite R
                c = math.hypot(P[0]-R[0], P[1]-R[1])  # PR opposite S (same as earlier)
                # compute angles using law of cosines
                # angle at P (between PR and PS) = δ
                cos_delta = (c*c + b_len*b_len - a*a)/(2*c*b_len)
                delta = math.acos(cos_delta)
                # angle at R (between RP and RS) = ε
                cos_eps = (c*c + a*a - b_len*b_len)/(2*c*a)
                eps = math.acos(cos_eps)
                # angle at S = ζ = π - δ - ε
                zeta = math.pi - delta - eps
                return delta, eps, zeta
            
            def is_convex_quad(alpha):
                # compute orientation signs for consecutive triples
                P = (0.0,0.0)
                Q = (1.0,0.0)
                b = 2*math.cos(alpha)
                R = (b*math.cos(alpha), b*math.sin(alpha))
                xS, yS, _ = compute_S(alpha)
                S = (xS, yS)
                # compute cross product z-component of (B-A) x (C-B) for each vertex
                def cross(A,B,C):
                    return (B[0]-A[0])*(C[1]-B[1]) - (B[1]-A[1])*(C[0]-B[0])
                cp1 = cross(P,Q,R)
                cp2 = cross(Q,R,S)
                cp3 = cross(R,S,P)
                cp4 = cross(S,P,Q)
                # For convex quadrilateral with consistent orientation, all cross products should have same sign (positive for CCW)
                return cp1, cp2, cp3, cp4
            
            candidates = [math.radians(60), math.radians(77.14285714065224), math.radians(84)]
            for a in candidates:
                delta, eps, zeta = triangle_angles_PR_S(a)
                print("alpha deg:", math.degrees(a))
                print("delta, eps, zeta (deg):", [math.degrees(x) for x in (delta, eps, zeta)])
                print("convex cross signs:", is_convex_quad(a))
                print()
            
