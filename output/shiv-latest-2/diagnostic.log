            import numpy as np, math
            
            def f_spherical(alpha,beta):
                a = math.sqrt(3)*math.sin(alpha)*math.cos(beta)
                b = math.sqrt(3)*math.sin(alpha)*math.sin(beta)
                c = math.sqrt(3)*math.cos(alpha)
                return (a*b - c**2)*(b*c - a**2)*(c*a - b**2)
            
            def grid_search(N=200):
                min_val = 1e9
                min_ab = None
                for i in range(N+1):
                    alpha = math.pi * i / N
                    for j in range(N+1):
                        beta = 2*math.pi * j / N
                        val = f_spherical(alpha,beta)
                        if val < min_val:
                            min_val = val
                            min_ab = (alpha,beta)
                return min_val, min_ab
            
