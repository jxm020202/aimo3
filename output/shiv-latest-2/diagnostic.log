            def ratio_outer_to_smallest(b):
                S = sum(b)
                Q = sum([x*x for x in b])
                D = 3*S*S - 6*Q
                if D <= 0:
                    return None
                sqrtD = math.sqrt(D)
                b5_pos = (S + sqrtD)/2  # positive solution (inner sphere)
                b5_neg = (S - sqrtD)/2  # could be negative (outer sphere)
                # ensure signs
                # outer sphere curvature negative
                b5_outer = b5_neg if b5_neg < 0 else b5_pos if b5_pos < 0 else None
                b5_inner = b5_pos if b5_pos > 0 else b5_neg if b5_neg > 0 else None
                if b5_outer is None or b5_inner is None:
                    return None
                R_outer = -1.0/b5_outer
                R_inner = 1.0/b5_inner
                radii = [1.0/bi for bi in b] + [R_outer, R_inner]
                # largest radius
                R_max = max(radii)
                R_min = min(radii)
                return R_max / R_min, R_outer, R_inner, radii
            
