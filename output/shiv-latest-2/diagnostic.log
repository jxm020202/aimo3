            def find_cycle(start, max_depth=9):
                # BFS storing path
                start_frac = start
                # each node: (fraction, path list of generators)
                # generators: 'A','B','C'
                gen_funcs = {'A': lambda r: -r,
                             'B': lambda r: 1 - r,
                             'C': lambda r: Fraction(1, r) if r != 0 else None}
                q = deque()
                q.append((start_frac, []))
                visited = {}
                while q:
                    r, path = q.popleft()
                    depth = len(path)
                    if depth >= max_depth:
                        continue
                    for gen, func in gen_funcs.items():
                        nb = func(r)
                        if nb is None:
