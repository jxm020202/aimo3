            def eventually_increasing_n(n, Kmax=2000):
                # returns True if eventually strictly increasing within Kmax
                prev = lcm_range(1,n)
                # we need to find a point after which monotonic holds
                # We'll just check for any decreasing after some point.
                # We'll find the maximum index where a decrease occurs.
                decreasing_indices=[]
                for k in range(2, Kmax+1):
                    cur = lcm_range(k,n)
                    if cur <= prev:
                        decreasing_indices.append(k-1) # index where previous > current
                    prev = cur
                # If there are any decreasing indices after some point, not eventually increasing
                # Actually we need that there exists N such that for all k>N, cur > prev.
                # So we need that decreasing indices are bounded; i.e., there is a max decreasing index.
                # If there are no decreasing indices after some point, we can set N = max(decreasing_indices)
                # If decreasing_indices is empty, it's always increasing.
                # But we also need to ensure that after max decreasing index, monotonic holds.
                # We'll check from N+1 onward.
                if not decreasing_indices:
                    return True
                N = max(decreasing_indices)
                # verify monotonic after N
                prev = lcm_range(N+1, n)
                for k in range(N+2, Kmax+1):
                    cur = lcm_range(k, n)
                    if cur <= prev:
                        return False
                    prev = cur
                return True
            
