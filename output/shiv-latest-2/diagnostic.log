                # solve 3 t^2 + 2 Q t + (S - 1) >= 0
                # Find smallest t >= 0 satisfying.
                if S >= 1:
                    t1 = 0.0
                else:
                    # quadratic roots
                    a = 3.0
                    b = 2.0*Q
                    c = S - 1.0
                    disc = b*b - 4*a*c
                    # disc >0 because c<0
                    sqrt_disc = math.sqrt(disc)
                    t_root = (-b + sqrt_disc) / (2*a)  # larger root (since a>0)
                    t1 = max(0.0, t_root)
                # compute t2: ensure min_norm <= 1
                # need sum_{i: q_i > t} (q_i - t)^2 <= 1
                # This is decreasing in t, we can solve via binary search.
