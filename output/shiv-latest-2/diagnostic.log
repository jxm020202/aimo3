            import random, math, itertools, numpy as np
            
            def compute_ratio(a,b,c,d):
                # compute the two possible e solutions
                S4 = a+b+c+d
                Q4 = a*a+b*b+c*c+d*d
                # quadratic: e^2 - S4 e + (3*Q4 - S4**2)/2 = 0
                C = (3*Q4 - S4**2)/2
                disc = S4**2 - 4*C
                if disc < 0:
                    return None
                sqrt_disc = math.sqrt(disc)
                e1 = (S4 + sqrt_disc)/2
                e2 = (S4 - sqrt_disc)/2
                # one will be negative (outer), the other positive (inner)
                # choose negative
                e_neg = e1 if e1 < 0 else e2
                # largest positive curvature among a,b,c,d and possibly the other e (inner)
                e_pos = e2 if e1 < 0 else e1
                # compute ratio outer radius / smallest inner radius
                # outer radius = -1/e_neg
                # smallest inner radius = 1 / max positive curvature
                max_pos = max(a,b,c,d,e_pos)
                ratio = (-1/e_neg) / (1/max_pos)
                return ratio
            
            def random_ratio():
                # random positive curvatures
                a,b,c,d = [random.uniform(0.1,5) for _ in range(4)]
                return compute_ratio(a,b,c,d)
            
            ratios = [random_ratio() for _ in range(10)]
            ratios
