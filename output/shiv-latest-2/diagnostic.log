            def ratio_tuple(t):
                S = sum(t)
                g = math.gcd(t[0], t[1])
                for v in t[2:]:
                    g = math.gcd(g, v)
                # compute T
                T = 0
                n = len(t)
                for i in range(n):
                    a = t[i]
                    b = t[(i+1)%n]
                    c = t[(i+2)%n]
                    g_ab = math.gcd(a,b)
                    l_bc = (b*c)//math.gcd(b,c)  # lcm
                    T += g_ab * l_bc
                # ratio = S^3 / (g * T)
                # g is gcd of all
                return (S**3) / (g * T)
            
