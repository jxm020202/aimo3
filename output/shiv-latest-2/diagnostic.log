            import numpy as np, math, random
            
            def intersect_line(P1, d1, P2, d2):
                # Solve P1 + a d1 = P2 + b d2
                A = np.column_stack((d1, -d2))
                b = P2 - P1
                # Solve linear system; if determinant zero, return None
                try:
                    sol = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    return None
                a = sol[0]
                # Intersection point
                return P1 + a * d1
            
            def angle_NMO_general(W, X, Y, Z):
                # Intersection M of WY and XZ
                # Solve for parameters t,s
                v1 = Y - W
                v2 = Z - X
                A = np.column_stack((v1, -v2))
                b = X - W
                try:
                    t, s = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    return None
                M = W + t * v1
                # N: perp bisectors of WX and YZ
                mid_WX = (W + X) / 2
                dir_WX = X - W
                perp_WX = np.array([-dir_WX[1], dir_WX[0]])
                mid_YZ = (Y + Z) / 2
                dir_YZ = Z - Y
                perp_YZ = np.array([-dir_YZ[1], dir_YZ[0]])
                N = intersect_line(mid_WX, perp_WX, mid_YZ, perp_YZ)
                if N is None:
                    return None
                # O: perp bisectors of XY and WZ
                mid_XY = (X + Y) / 2
                dir_XY = Y - X
                perp_XY = np.array([-dir_XY[1], dir_XY[0]])
                mid_WZ = (W + Z) / 2
                dir_WZ = Z - W
                perp_WZ = np.array([-dir_WZ[1], dir_WZ[0]])
                O = intersect_line(mid_XY, perp_XY, mid_WZ, perp_WZ)
                if O is None:
                    return None
                # angle NMO
                vNM = N - M
                vOM = O - M
                dot = np.dot(vNM, vOM)
                normNM = np.linalg.norm(vNM)
                normOM = np.linalg.norm(vOM)
                if normNM*normOM == 0:
                    return None
                cosang = dot/(normNM*normOM)
                cosang = max(-1, min(1, cosang))
                ang = math.degrees(math.acos(cosang))
                return ang
            
            def random_quad_general():
                W = np.array([random.uniform(-5,5), random.uniform(-5,5)])
