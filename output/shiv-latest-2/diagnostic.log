            import math, random
            
            def max_covered(points, idx, angle_deg=100):
                x0,y0 = points[idx]
                angles = []
                for j,(x,y) in enumerate(points):
                    if j==idx: continue
                    ang = math.atan2(y-y0, x-x0)
                    angles.append(ang)
                angles.sort()
                angles2 = angles + [a+2*math.pi for a in angles]
                target = math.radians(angle_deg)
                maxcnt = 0
                i=0
                n=len(angles)
                for j in range(n):
                    while i < len(angles2) and angles2[i] - angles2[j] <= target + 1e-12:
                        i+=1
                    cnt = i - j
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
