            from fractions import Fraction
            from collections import deque
            
            def bfs_distance(start, target, max_depth=30, bound=5000):
                start_f = Fraction(start)
                target_f = Fraction(target)
                visited = {start_f: 0}
                q = deque([start_f])
                while q:
                    cur = q.popleft()
                    d = visited[cur]
                    if cur == target_f:
                        return d
                    if d >= max_depth:
                        continue
                    # generate neighbors
                    # neg
                    nxt = -cur
                    if abs(nxt.numerator) <= bound and abs(nxt.denominator) <= bound and nxt not in visited:
                        visited[nxt] = d+1
                        q.append(nxt)
                    # one_minus
                    nxt = 1 - cur
                    if abs(nxt.numerator) <= bound and abs(nxt.denominator) <= bound and nxt not in visited:
                        visited[nxt] = d+1
                        q.append(nxt)
                    # inv
                    if cur != 0:
                        nxt = Fraction(1, cur)
