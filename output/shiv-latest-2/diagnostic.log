            import math, random
            
            def total_sum(angles):
                n=len(angles)
                L = math.radians(100)  # interval length
                total=0
                for i in range(n):
                    psi=[]
                    theta_i=angles[i]
                    for j in range(n):
                        if i==j: continue
                        delta = (angles[j] - theta_i) % (2*math.pi)
                        if delta <= math.pi:
                            sign=1
                            minor=delta
                        else:
                            sign=-1
                            minor=2*math.pi - delta
                        # signed angle
                        ang = sign * (math.pi/2 - minor/2)
                        psi.append(ang)
                    psi.sort()
                    # duplicate with +2π to handle wrap-around
                    m=len(psi)
                    psi2 = psi + [x+2*math.pi for x in psi]
                    # sliding window
                    best=0
                    left=0
                    for right in range(len(psi2)):
                        while psi2[right] - psi2[left] > L:
                            left+=1
                        count = right - left + 1
                        if count>best:
                            best=count
                    total+=best
                return total
            
            def two_cluster_config(c=50, arc_width_deg=5):
                # cluster A centered at 0, cluster B centered at pi (opposite)
                # distribute points uniformly within arc width
                angles=[]
                for k in range(c):
                    # uniform within [-arc/2, +arc/2] around 0
                    ang = math.radians(-arc_width_deg/2 + arc_width_deg * (k+0.5)/c)
                    angles.append(ang)
                for k in range(100-c):
                    ang = math.pi + math.radians(-arc_width_deg/2 + arc_width_deg * (k+0.5)/(100-c))
                    angles.append(ang)
                return angles
            
