            def count_using_matrix(n):
                masks=valid_masks(n)
                k=len(masks)
                # map mask to index
                idx={m:i for i,m in enumerate(masks)}
                # build adjacency matrix
                import numpy as np
                M=np.zeros((k,k), dtype=object)  # use Python int objects
                for i,m in enumerate(masks):
                    for j,p in enumerate(masks):
                        if (m & p)==0:
                            M[i,j]=1
                # initial vector v0 = [1]*k
                v=np.array([1]*k, dtype=object)
                if n==1:
                    return sum(v)
                # compute M^{n-1} * v0
                # exponentiate via repeated squaring
                def mat_pow(mat, power):
                    result=np.identity(k, dtype=object)
                    base=mat.copy()
                    while power>0:
                        if power%2==1:
                            result=np.dot(result, base)
                        base=np.dot(base, base)
                        power//=2
                    return result
                Mp=mat_pow(M, n-1)
                vn=np.dot(Mp, v)
                return int(sum(vn))
            
            for n in range(1,6):
                print(n, count_using_matrix(n))
            
