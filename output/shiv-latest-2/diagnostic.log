            def num_cycles_nonzero(m):
                # m not divisible by 3
                # compute sum_{d|m, d>1} phi(d) / ord_d(3)
                total = 0
                for d in sp.divisors(m):
                    if d == 1:
                        continue
                    # compute order of 3 modulo d
                    # if gcd(3,d)!=1, but m not divisible by 3 ensures d also not divisible by 3? Actually d may be divisor of m, so also not divisible by 3.
                    # So gcd(3,d)=1.
                    ord = sp.n_order(3, d)  # multiplicative order
                    total += sp.totient(d) // ord
                return total
            
            def cycles_total(m):
                # total cycles including 0
                total = 1  # for 0
                for d in sp.divisors(m):
                    if d == 1:
                        continue
                    ord = sp.n_order(3, d)
                    total += sp.totient(d) // ord
                return total
            
