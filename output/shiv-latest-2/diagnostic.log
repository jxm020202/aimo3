            def uncovered_area_grid(phi, N=2000):
                # compute uncovered area by grid sampling inside Q
                c = math.cos(phi)
                s = math.sin(phi)
                # generate grid points in unit square [0,1]^2 in (a,b) coordinates (barycentric)
                # map to (x,y) = a*v1 + b*v2
                a = np.linspace(0,1,N)
                b = np.linspace(0,1,N)
                aa, bb = np.meshgrid(a,b, indexing='ij')
                x = aa*c + bb*(-s)
                y = aa*s + bb*c
                # Now test if point (x,y) is inside any S_i
                # define squares
                # S0: [-0.5,0.5]×[-0.5,0.5]
                # S1: [c-0.5,c+0.5]×[s-0.5,s+0.5]
                # S2: [-s-0.5,-s+0.5]×[c-0.5,c+0.5]
                # S3: [c-s-0.5,c-s+0.5]×[s+c-0.5,s+c+0.5]
                inside = ((np.abs(x) <= 0.5) & (np.abs(y) <= 0.5) | \
                         ((np.abs(x - c) <= 0.5) & (np.abs(y - s) <= 0.5)) | \
                         ((np.abs(x + s) <= 0.5) & (np.abs(y - c) <= 0.5)) | \
                         ((np.abs(x - (c - s)) <= 0.5) & (np.abs(y - (s + c)) <= 0.5))
                uncovered = ~inside
                # area approx = fraction * area of Q (which is 1)
                return uncovered.mean()
            
