                for a in range(1, n):
                    for p in range(1, n+1):
                        L = a*(a+1)//2 if p > a else (a+1)*(a+2)//2 - p
                        U = a*(2*n - a +1)//2 if p <= n - a else a*(2*n - a +1)//2 + (n - a) - p
                        # compute actual min and max from combos
                        sums = achievable_sums(n, a, p)
                        if not sums:
