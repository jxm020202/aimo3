            import itertools
            
            def steps_to_zero(state):
                # state is tuple of bits (0/1) length n, index 0 is position 1 (least significant)
                n = len(state)
                steps = 0
                seen = set()
                while True:
                    k = sum(state)
                    if k == 0:
                        return steps
                    # detect loops (should not happen)
                    if (state, k) in seen:
                        # loop
                        return None
                    seen.add((state, k))
                    # flip bit at position k (1-indexed)
                    idx = k-1  # zero-indexed
                    # toggle
                    lst = list(state)
                    lst[idx] ^= 1
                    state = tuple(lst)
                    steps += 1
            
            def avg_steps(n):
                total = 0
                count = 0
                max_steps = 0
                for bits in itertools.product([0,1], repeat=n):
                    steps = steps_to_zero(bits)
                    total += steps
                    count += 1
                    max_steps = max(max_steps, steps)
                return total/count, max_steps
            
            for n in range(1,7):
                avg, maxs = avg_steps(n)
                print(n, avg, maxs)
            
