            def find_min_k_via_a(limit):
                best = None
                best_data = None
                for n in range(1, limit+1):
                    for m in range(1, n):
                        if math.gcd(m,n)!=1:
                            continue
                        a = Fraction(m, n)
                        D_num = 5*m*m - 2*m*n + n*n
                        D_den = n*n
                        # compute 2/D = 2 * D_den / D_num
                        num = 2 * D_den
                        den = D_num
                        if den <= 0:
                            continue
                        g = math.gcd(num, den)
                        num_red = num // g
                        den_red = den // g
                        # check if both are perfect squares
                        if int(math.isqrt(num_red))**2 == num_red and int(math.isqrt(den_red))**2 == den_red:
                            # compute p/q = sqrt(2/D) = sqrt(num_red/den_red) = sqrt(num_red)/sqrt(den_red)
                            # p = sqrt(num_red), q = sqrt(den_red)
                            p = int(math.isqrt(num_red))
                            q = int(math.isqrt(den_red))
                            # compute b = -1 + (a+1) * p/q
                            b = Fraction(-1,1) + (a + 1) * Fraction(p, q)
                            if b < 0 or b >= 1:
                                continue
                            x = Fraction(n*n - m*m, 2*n*n)
                            y = Fraction(1,1) - Fraction(b.numerator*b.numerator, b.denominator*b.denominator)
                            y = y / 2
                            if y <= 0:
                                continue
                            k = math.lcm(x.denominator, y.denominator)
                            if best is None or k < best:
                                best = k
                                best_data = (k, a, b, x, y, (m,n,p,q))
                return best, best_data
            
