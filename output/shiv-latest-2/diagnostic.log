            from fractions import Fraction
            import math
            
            def cf_parity(r):
                # r is Fraction
                # compute simple continued fraction
                p, q = r.numerator, r.denominator
                # handle negative numbers: we can treat sign separately? The algorithm works with floor division.
                # We'll compute using math.floor for rational.
                a = []
                while q != 0:
                    a0 = math.floor(p / q)  # floor division for possibly negative?
                    a.append(a0)
                    p, q = q, p - a0 * q
                    if q == 0:
                        break
                # a is list of partial quotients
                # Number of terms after integer part = len(a) - 1
                n = len(a) - 1
                return n % 2
            
            def f_via_parity(r):
                return (cf_parity(r) + 1) % 2
            
