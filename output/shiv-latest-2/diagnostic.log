            def ratio_for_triangle(A, B, C):
                # A,B,C are tuples (x,y)
                A = sp.Point(A)
                B = sp.Point(B)
                C = sp.Point(C)
                # circumcenter O
                O = sp.geometry.Triangle(A,B,C).circumcircle.center
                # incenter I
                I = sp.geometry.Triangle(A,B,C).incenter
                # line through I perpendicular to OI
                OI_vec = sp.Matrix(O - I)
                # direction perpendicular: rotate 90 deg: ( -y, x )
                perp_dir = sp.Matrix([-OI_vec[1], OI_vec[0]])
                # line ℓ
                line_l = sp.Line(I, I + sp.Point(perp_dir[0], perp_dir[1]))
                # side AB line
                line_AB = sp.Line(A, B)
                M = line_l.intersection(line_AB)[0]
                # external bisector at C
                # unit vectors from C to A and C to B
                CA = sp.Matrix(A - C)
