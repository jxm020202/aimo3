                sols = []
                for bprime in range(-limit, limit+1):
                    for cprime in range(-limit, limit+1):
                        # compute discriminant for quadratic in d
                        A = 1
                        B = 11*cprime - 3*bprime
                        C = -33*bprime*cprime + 1
                        # discriminant D = B^2 - 4AC
                        D = B*B - 4*A*C
                        if D < 0:
                            continue
                        sqrtD = int(math.isqrt(D))
                        if sqrtD*sqrtD != D:
                            continue
                        # solutions: d = (-B ± sqrtD)/2
                        for sign in [1, -1]:
