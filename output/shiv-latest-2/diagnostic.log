            def simulated_annealing_points(N, steps=20000, init_temp=1.0, cooling=0.9995):
                pts = random_points_in_circle(N)
                cur_score = sum_ai(pts)
                best_score = cur_score
                best_pts = pts[:]
                temp = init_temp
                for step in range(steps):
                    i = random.randrange(N)
                    old = pts[i]
                    # propose new point near old (small move)
                    dx = (random.random()*2-1)*0.05
                    dy = (random.random()*2-1)*0.05
                    new = (old[0]+dx, old[1]+dy)
                    if new[0]**2 + new[1]**2 > 1:
