            def is_independent(mask, n):
                # mask is integer of size n*n bits, row-major
                # check no two 1s are adjacent side or diagonal
                # get coordinates
                for i in range(n):
                    for j in range(n):
                        if not (mask >> (i*n + j) & 1):
                            continue
                        # check neighbors
                        for di in (-1,0,1):
                            for dj in (-1,0,1):
                                if di==0 and dj==0:
                                    continue
                                ni, nj = i+di, j+dj
                                if 0 <= ni < n and 0 <= nj < n:
                                    if mask >> (ni*n + nj) & 1:
                                        return False
                return True
            
            def independent_sets_n(n):
                total = []
                for mask in range(1<<(n*n)):
                    if bin(mask).count('1') >= 2 and is_independent(mask,n):
