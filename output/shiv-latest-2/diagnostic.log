            def max_side(x, y, s):
                # coordinates
                A = np.array([x, 0.0])
                B = np.array([0.0, y])
                C = np.array([s, math.sqrt(3)*(1 - s)])
                # distances
                dAB = np.linalg.norm(A - B)
                dBC = np.linalg.norm(B - C)
                dCA = np.linalg.norm(C - A)
                return max(dAB, dBC, dCA)
            
