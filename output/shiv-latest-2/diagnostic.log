            def count_independent_sets_king_small(n):
                # brute force enumeration for small n
                cells = [(i,j) for i in range(n) for j in range(n)]
                N = 0
                sets = []
                for r in range(1<< (n*n)):
                    # generate set
                    # check size >=2
                    if bin(r).count('1') < 2:
                        continue
                    # check independence
                    ok=True
                    for i in range(n*n):
                        if not (r>>i)&1: continue
                        xi, yi = divmod(i, n)
                        for j in range(i+1, n*n):
                            if not (r>>j)&1: continue
                            xj, yj = divmod(j, n)
                            if max(abs(xi-xj), abs(yi-yj)) <= 1:
                                ok=False
                                break
                        if not ok:
                            break
                    if ok:
                        N+=1
                        sets.append(r)
                return N, sets
            
