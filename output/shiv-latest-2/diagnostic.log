            def excenters(u,v):
                # original triangle D(0,0), E(1,0), F(u,v)
                # side lengths a=EF, b=DF, c=DE=1
                a = math.hypot(u-1, v)
                b = math.hypot(u, v)
                c = 1.0
                # excenter opposite D: intersection of external bisectors at E and F, internal at D? Actually formula: coordinates weighted by -a, b, c? Let's compute using angle bisector formula.
                # Incenter: (a*D + b*E + c*F)/(a+b+c)
                # Excenter opposite D (I_D): (-a*D + b*E + c*F)/(-a+b+c)
                # Similarly for I_E, I_F.
                I_D = ((-a*0 + b*1 + c*u)/(-a+b+c), (-a*0 + b*0 + c*v)/(-a+b+c))
                I_E = ((a*0 + -b*1 + c*u)/(a - b + c), (a*0 + -b*0 + c*v)/(a - b + c))
                I_F = ((a*0 + b*1 + -c*u)/(a + b - c), (a*0 + b*0 + -c*v)/(a + b - c))
                return I_D, I_E, I_F
            
