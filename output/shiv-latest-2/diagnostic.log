            def circumcenter_coords(A,B,C):
                # using linear equations
                import numpy as np
                A = np.array(A); B = np.array(B); C = np.array(C)
                # Solve for O
                # (O - (A+B)/2)·(B-A) = 0
                # (O - (A+C)/2)·(C-A) = 0
                M = np.array([B-A, C-A])
                rhs = np.array([np.dot((A+B)/2, B-A), np.dot((A+C)/2, C-A)])
                # Actually equation: O·(B-A) = ((A+B)/2)·(B-A)
                # O·(C-A) = ((A+C)/2)·(C-A)
                # Solve linear system
                O = np.linalg.solve(M, rhs)
                return tuple(O)
            
