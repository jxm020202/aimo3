                    angles.sort()
                    # duplicate with +2π for circular sliding
                    m = len(angles)
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window
                    maxcnt = 0
                    j = 0
                    for k in range(m):
                        while j < k+m and angles2[j] - angles2[k] <= math.radians(angle_deg) + 1e-9:
                            j += 1
                        cnt = j - k
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
