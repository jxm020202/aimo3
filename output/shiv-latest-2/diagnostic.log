            def compute_external_angles(poly):
                # compute external (turn) angles in degrees
                n = len(poly)
                angles = []
                for i in range(n):
                    prev = poly[(i-1)%n]
                    cur = poly[i]
                    nxt = poly[(i+1)%n]
                    # vectors: cur - prev (incoming direction), nxt - cur (outgoing)
                    v_in = sp.Matrix([cur.x - prev.x, cur.y - prev.y])
                    v_out = sp.Matrix([nxt.x - cur.x, nxt.y - cur.y])
                    # compute angle from v_in to v_out (CCW) between 0 and 2π
                    dot = v_in.dot(v_out)
                    norm_in = sp.sqrt(v_in.dot(v_in))
                    norm_out = sp.sqrt(v_out.dot(v_out))
                    cos_theta = sp.simplify(dot/(norm_in*norm_out))
                    # due to numeric issues, use acos
                    theta = sp.acos(cos_theta)
                    # determine sign via cross product
                    cross = v_in[0]*v_out[1] - v_in[1]*v_out[0]
                    if cross < 0:
                        theta = 2*sp.pi - theta
                    angles.append(sp.N(theta*180/sp.pi))
                return angles
            
            T1 = sp.Point(0, sp.sqrt(3) - 1)
            poly_T1 = [P, Q, R, S, T1]
            ext_angles_T1 = compute_external_angles(poly_T1)
