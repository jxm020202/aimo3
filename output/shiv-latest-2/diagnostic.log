            import sympy as sp, random, math, itertools, fractions, sys, mpmath as mp
            
            def ratio_for_triangle(D, E, F):
                # D,E,F as sympy Points or vectors (list)
                D = sp.Matrix(D)
                E = sp.Matrix(E)
                F = sp.Matrix(F)
                # circumcenter P is origin (0,0) because we will place them on circle centered at origin
                # Ensure they lie on circle radius R
                # Compute side lengths
                a = (E - F).norm()  # opposite D
                b = (D - F).norm()  # opposite E
                c = (D - E).norm()  # opposite F
                # Incenter Q
                Q = (a*D + b*E + c*F) / (a + b + c)
                # vector v perpendicular to Q (rotate 90 deg)
                v = sp.Matrix([-Q[1], Q[0]])
                # line L: Q + t v
                # intersect with line DE: param s: D + u*(E-D)
                u = sp.symbols('u')
                t = sp.symbols('t')
                sol = sp.solve(Q + t*v - (D + u*(E-D)), (t, u), dict=True)
                if not sol:
                    return None
                sol = sol[0]
                tM = sol[t]
                # external bisector at F
                # unit vectors along FD and FE (pointing away from F)
                FD = D - F
                FE = E - F
                uFD = FD / FD.norm()
                uFE = FE / FE.norm()
                w = uFD + uFE  # internal bisector direction (not normalized)
                # external bisector direction = rotate w by 90 deg
                w_perp = sp.Matrix([-w[1], w[0]])
                # line through F: F + s * w_perp
                s = sp.symbols('s')
                sol2 = sp.solve(Q + t*v - (F + s*w_perp), (t, s), dict=True)
                if not sol2:
                    return None
                tN = sol2[0][t]
                # ratio = |tM|/|tN|
                ratio = sp.simplify(abs(tM)/abs(tN))
                return sp.nsimplify(ratio, [sp.sqrt(2), sp.sqrt(3), sp.sqrt(5), sp.Rational(1,1)])
            
            # test with a random triangle on unit circle
            def random_triangle():
                # random angles
                angs = sorted([random.random()*2*math.pi for _ in range(3)])
                pts = [(math.cos(a), math.sin(a)) for a in angs]
                return pts
            
            for i in range(5):
                D,E,F = random_triangle()
                r = ratio_for_triangle(D,E,F)
                print(r)
            
