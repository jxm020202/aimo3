            def ratio(u,v):
                # D=(0,0), E=(1,0), F=(u,v)
                # side lengths
                a = math.hypot(u-1, v)  # EF
                b = math.hypot(u, v)    # DF
                c = 1.0                 # DE
                s = a + b + c
                # circumcenter P
                y0 = ((u-0.5)**2 + v**2 - 0.25) / (2*v)
                P = np.array([0.5, y0])
                Q = np.array([(b+u)/s, v/s])
                # line PQ direction
                dPQ = P - Q
                # perpendicular direction (rotate 90 deg)
                # direction vector for line through Q perpendicular to PQ: rotate dPQ by 90 degrees
                # (dx, dy) -> (-dy, dx) (counterclockwise)
                perp_dir = np.array([-dPQ[1], dPQ[0]])
                # Intersection with DE (y=0)
                # param t such that Q + t*perp_dir has y=0
                tM = -Q[1] / perp_dir[1]  # solve Qy + t*dy = 0
                M = Q + tM * perp_dir
                # external bisector at F
                # vectors from F to D and E
                vFD = np.array([0 - u, 0 - v])
                vFE = np.array([1 - u, 0 - v])
                # unit vectors
                normFD = np.linalg.norm(vFD)
                normFE = np.linalg.norm(vFE)
                uFD = vFD / normFD
                uFE = vFE / normFE
                # external bisector direction = uFD - uFE (could also be uFE - uFD)
                ext_dir = uFD - uFE
                # line through F: F + s*ext_dir
                # Intersection with line through Q + t*perp_dir
                # Solve Q + t*perp_dir = F + s*ext_dir
                A = np.column_stack((perp_dir, -ext_dir))  # 2x2 matrix
                b_vec = np.array([u - Q[0], v - Q[1]])
                # Solve for t,s
                try:
                    sol = np.linalg.solve(A, b_vec)
                except np.linalg.LinAlgError:
                    return None
                tN = sol[0]
                N = Q + tN * perp_dir
                # distances
                QM = np.linalg.norm(M - Q)
                QN = np.linalg.norm(N - Q)
                return QM/QN
            
