            mid_WX = sp.Point((W.x+X.x)/2, (W.y+X.y)/2)
            mid_YZ = sp.Point((Y.x+Z.x)/2, (Y.y+Z.y)/2)
            mid_XY = sp.Point((X.x+Y.x)/2, (X.y+Y.y)/2)
            mid_WZ = sp.Point((W.x+Z.x)/2, (W.y+Z.y)/2)
            
            perp_WX = sp.Matrix([-t*sp.sin(theta), t*sp.cos(theta)+u])
            perp_YZ = sp.Matrix([s*sp.sin(theta), -s*sp.cos(theta)-v])
            a,b = sp.symbols('a b')
            sol_ab = sp.solve([sp.Eq(mid_WX.x + a*perp_WX[0], mid_YZ.x + b*perp_YZ[0]),
                               sp.Eq(mid_WX.y + a*perp_WX[1], mid_YZ.y + b*perp_YZ[1])], (a,b), dict=True)[0]
            N = sp.Point(mid_WX.x + sol_ab[a]*perp_WX[0], mid_WX.y + sol_ab[a]*perp_WX[1])
            # O
            perp_XY = sp.Matrix([t*sp.sin(theta), v - t*sp.cos(theta)])
            perp_WZ = sp.Matrix([s*sp.sin(theta), s*sp.cos(theta)-u])
