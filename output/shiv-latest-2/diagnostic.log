                return False
            
            def is_simple(poly):
                n = len(poly)
                # check each pair of non-adjacent edges
                for i in range(n):
                    p1 = poly[i]
                    p2 = poly[(i+1)%n]
                    for j in range(i+2, n):
                        # skip adjacent edges and same edge
                        if (j+1)%n == i:  # edges share a vertex
                            continue
                        q1 = poly[j]
                        q2 = poly[(j+1)%n]
                        if segments_intersect(p1,p2,q1,q2):
                            return False
                return True
            
