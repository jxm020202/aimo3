            import math, sympy as sp
            
            def compute_W(s_val, u_val):
                Zx = (s_val-1)/2
                Zy = (s_val-1)*math.sqrt(3)/2
                Xx, Xy = 2, 0
                Yx = s_val*(1 - u_val/2)
                Yy = s_val*math.sqrt(3)/2 * u_val
                Wx = Zx + Xx - Yx
                Wy = Zy + Xy - Yy
                return (Wx, Wy)
            
            def point_in_triangle(P, s_val):
                # vertices D(0,0), E(s,0), F(s/2, sqrt(3)/2 s)
                D = (0,0)
                E = (s_val,0)
                F = (s_val/2, math.sqrt(3)/2 * s_val)
                # barycentric using area signs
                def area(a,b,c):
                    return (a[0]*(b[1]-c[1]) + b[0]*(c[1]-a[1]) + c[0]*(a[1]-b[1]))/2
                A = abs(area(D,E,F))
                A1 = abs(area(P,E,F))
                A2 = abs(area(D,P,F))
                A3 = abs(area(D,E,P))
                return abs(A - (A1+A2+A3)) < 1e-6  # inside or on edge
            
            for s_val in [3,4,5,6]:
