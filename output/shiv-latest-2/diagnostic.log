            # Compute distance using cross product formula
            def distance_point_to_line(P, A, B):
                # P, A, B are sympy Points
                # distance = |(B-A) x (P-A)| / |B-A|
                BA = sp.Matrix([B.x - A.x, B.y - A.y])
