            def max_zero_run(n, max_terms=20000):
                # compute sequence modulo n
                a = [pow(2, k, n) for k in range(n)]  # a[0]=a1 etc
                # a list of terms modulo n
                # compute further terms
                # keep track of longest run of zeros
                longest = 0
                current = 0
                # we can also detect state repetition: tuple of last n terms
                seen = {}
                # initial state
                state = tuple(a[-n:])  # last n terms
                seen[state] = 0
                for idx in range(n, max_terms):
                    # compute next term as sum of previous n terms modulo n
                    next_term = sum(a[-n:]) % n
                    a.append(next_term)
                    # update zero run
                    if next_term == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                    # update state
                    state = tuple(a[-n:])
                    if state in seen:
                        # cycle detected
                        # break
                        break
                    else:
                        seen[state] = idx - n + 1  # maybe store step index
                return longest, len(seen)
            
