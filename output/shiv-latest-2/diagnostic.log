            from fractions import Fraction
            from collections import deque
            
            def bfs_find_path(start, target, max_depth=12):
                start = Fraction(start)
                target = Fraction(target)
                q = deque()
                q.append((start, []))
                visited = {start}
                while q:
                    r, path = q.popleft()
                    if r == target:
                        return path
                    if len(path) >= max_depth:
                        continue
                    for op_name, nb in [('neg', -r), ('one_minus', Fraction(1)-r), ('inv', Fraction(1, r) if r != 0 else None)]:
                        if nb is None:
                            continue
                        if nb not in visited:
                            visited.add(nb)
                            q.append((nb, path + [op_name]))
                return None
            
