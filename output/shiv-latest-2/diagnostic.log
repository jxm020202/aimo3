            def estimate_numpy(N):
                # generate random arrays
                theta = np.random.rand(N) * 2*np.pi
                x = np.random.rand(N)
                y = np.random.rand(N)
                cos = np.cos(-theta)
                sin = np.sin(-theta)
                # points to check: (0,0), (0,1), (1,0), (1,1)
                # compute dx,dy arrays for each point
                # shape (4,N)
                dx = np.stack([ -x, -x, 1 - x, 1 - x])  # (4,N)
                dy = np.stack([ -y, 1 - y, -y, 1 - y])
                # rotate: u = cos*dx - sin*dy, v = sin*dx + cos*dy
                # need broadcasting: cos, sin shape (N,)
                u = cos * dx - sin * dy
                v = sin * dx + cos * dy
                # check condition for each point
                inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)  # shape (4,N)
                any_inside = inside.any(axis=0)  # shape (N,)
                # probability of not covering any vertex
                prob = 1.0 - any_inside.mean()
                return prob
            
