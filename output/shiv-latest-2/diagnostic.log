            def max_zero_run_scan(n, max_terms):
                # initial terms
                a = [pow(2, k, n) for k in range(n)]  # a[0] = a_1
                max_run = 0
                cur = 0
                # check initial
                for val in a:
                    if val == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                # sliding window sum
                window = a[:]  # list of length n
                s = sum(window) % n
                for i in range(n, max_terms):
                    next_val = s
                    # update run
                    if next_val == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                    # update sliding window sum
                    # remove oldest, add new
                    old = window.pop(0)
                    s = (s - old + next_val) % n
                    window.append(next_val)
                    # optional early break if max_run reaches n-1 (99)
                    if max_run >= n-1:
                        break
                return max_run
            
