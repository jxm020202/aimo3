            def bidir_bfs(start, target, max_depth=20):
                if start == target:
                    return 0
                # frontiers
                front_start = {start}
                front_target = {target}
                visited_start = {start:0}
                visited_target = {target:0}
                depth = 0
                while front_start and front_target and depth < max_depth:
                    # expand the smaller frontier
                    if len(front_start) <= len(front_target):
                        new_front = set()
                        for u in front_start:
                            for v in neighbors(u):
                                if v not in visited_start:
                                    visited_start[v] = visited_start[u] + 1
                                    new_front.add(v)
                                    if v in visited_target:
                                        return visited_start[v] + visited_target[v]
                        front_start = new_front
                    else:
                        new_front = set()
                        for u in front_target:
                            for v in neighbors(u):
                                if v not in visited_target:
                                    visited_target[v] = visited_target[u] + 1
                                    new_front.add(v)
                                    if v in visited_start:
                                        return visited_start[v] + visited_target[v]
                        front_target = new_front
                    depth += 1
                return None
            
