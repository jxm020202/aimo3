            import random, math
            
            def angle_NMO(a,b,c,d,theta):
                # compute N and O using formulas
                # using sympy? Let's compute numerically using formulas derived.
                # We'll compute using the derived expressions.
                # Use float.
                sin_t = math.sin(theta)
                cos_t = math.cos(theta)
                # N
                denomN = 2*(a*d - b*c)
                nx = (-a**2*d - b**2*c + c**2*d + c*d**2) / denomN
                ny = (-a**2*b + a**2*d*cos_t - a*b**2 + a*d**2 + b**2*c*cos_t + b*c**2 - c**2*d*cos_t - c*d**2*cos_t) / (denomN * sin_t)
                # O
                denomO = 2*(a*c - b*d)
                ox = (-a**2*c - b**2*d + c**2*d + c*d**2) / denomO
                oy = (a**2*b + a**2*c*cos_t + a*b**2 - a*c**2 + b**2*d*cos_t - b*d**2 - c**2*d*cos_t - c*d**2*cos_t) / (denomO * sin_t)
                # vectors N, O
                dot = nx*ox + ny*oy
                normN = math.hypot(nx, ny)
                normO = math.hypot(ox, oy)
                cosphi = dot/(normN*normO)
                # clamp
                cosphi = max(-1.0, min(1.0, cosphi))
                phi = math.degrees(math.acos(cosphi))
                return phi
            
