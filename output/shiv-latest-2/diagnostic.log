            def f_rule(num,den):
                from math import gcd
                g=gcd(num,den)
                num//=g; den//=g
                # bring to [0,1)
                # compute integer part
                int_part = num//den
                num = num - int_part*den
                # now 0 <= num < den
                if num==0:
                    # f(0) = 1
                    return 1
                # compute continued fraction length
                p=num; q=den
                count=0
                while p!=0:
                    a = q//p
                    q, p = p, q - a*p
                    count+=1
                return 1 if count%2==0 else 0
            
            # test constraints randomly
            import random, math
            def test_random(N=1000, max_den=50):
                for _ in range(N):
                    # pick random rationals r, r'
                    den1 = random.randint(1,max_den)
                    num1 = random.randint(-max_den*2, max_den*2)
                    den2 = random.randint(1,max_den)
                    num2 = random.randint(-max_den*2, max_den*2)
                    # ensure distinct
                    if num1*den2 == num2*den1:
