            def sum_ai(points, angle_deg=100):
                n = len(points)
                angle_rad = math.radians(angle_deg)
                total = 0
                for i, (xi, yi) in enumerate(points):
                    # compute angles to other points
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i == j: continue
                        ang = math.atan2(yj-yi, xj-xi)  # range -pi to pi
                        angles.append(ang)
                    # sort angles
                    angles.sort()
                    # duplicate with +2π for circular sliding window
                    angles2 = angles + [a + 2*math.pi for a in angles]
                    # sliding window to find max count within angle_rad
                    maxcnt = 0
                    left = 0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > angle_rad + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
