            xr, yr, xs, ys = sp.symbols('xr yr xs ys', real=True)
            
            # Points
            P = sp.Point(0,0)
            Q = sp.Point(1,0)
            R = sp.Point(xr, yr)
            S = sp.Point(xs, ys)
            
            def circumcenter(A,B,C):
                # Solve for O such that distances squared equal
                ox, oy = sp.symbols('ox oy', real=True)
                O = sp.Point(ox, oy)
                eq1 = O.distance(A)**2 - O.distance(B)**2
                eq2 = O.distance(A)**2 - O.distance(C)**2
                sol = sp.solve([eq1, eq2], (ox, oy), dict=True)
                # Should be unique
                return sp.Point(sol[0][ox], sol[0][oy])
            
            def incenter(A,B,C):
                # side lengths opposite vertices
                a = B.distance(C)  # opposite A
                b = C.distance(A)  # opposite B
                c = A.distance(B)  # opposite C
                # Weighted sum
                x = (a*A.x + b*B.x + c*C.x) / (a+b+c)
                y = (a*A.y + b*B.y + c*C.y) / (a+b+c)
                return sp.Point(sp.simplify(x), sp.simplify(y))
            
            # Compute centers
            CcA = circumcenter(P, Q, R)
            InA = incenter(P, Q, R)
            
            CcB = circumcenter(P, R, S)
            InB = incenter(P, R, S)
            
            CcA, InA, CcB, InB
