            import math, random, numpy as np
            
            def covers_any_lattice(c, theta):
                # c is (x,y) in R^2
                # theta orientation of square (rotation of square relative to axes)
                # square side 1, centered at c, rotated by theta
                # Determine if any integer lattice point lies inside the square.
                # We'll check integer points within distance <= sqrt(2)/2 + 0.5? Actually max distance from center to vertex is sqrt(2)/2 ~0.707.
                # So we need to check points with coordinates within +-1 of c.
                x, y = c
                # compute rotation matrix for -theta
                ct = math.cos(-theta)
                st = math.sin(-theta)
                # For each candidate integer point near c
                # Determine range of i: floor(x-0.5) to ceil(x+0.5) maybe plus 1
                i_min = math.floor(x - 0.6)
                i_max = math.ceil(x + 0.6)
                j_min = math.floor(y - 0.6)
                j_max = math.ceil(y + 0.6)
                for i in range(i_min, i_max+1):
                    for j in range(j_min, j_max+1):
                        # vector from center to point
                        dx = i - x
                        dy = j - y
                        # rotate by -theta
                        xr = ct*dx - st*dy
                        yr = st*dx + ct*dy
                        if abs(xr) <= 0.5 + 1e-12 and abs(yr) <= 0.5 + 1e-12:
                            return True
                return False
            
            def uncovered_fraction(theta, N=200000):
                count = 0
                for _ in range(N):
                    c = (random.random(), random.random())
                    if not covers_any_lattice(c, theta):
