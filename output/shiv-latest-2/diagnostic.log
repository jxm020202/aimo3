            def angle_ZXY(s_val):
                import math
                D = (0,0)
                E = (s_val,0)
                F = (s_val/2, math.sqrt(3)/2*s_val)
                X = (2,0)
                # Y as earlier: (s/2 + 1, sqrt(3)/2*(s-2))
                Y = (s_val/2 + 1, math.sqrt(3)/2*(s_val-2))
                # Z as earlier: ((s-1)/2, sqrt(3)/2*(s-1))
                Z = ((s_val-1)/2, math.sqrt(3)/2*(s_val-1))
                # vectors
                v1 = (Z[0]-X[0], Z[1]-X[1])
                v2 = (Y[0]-X[0], Y[1]-X[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                cosang = dot/(norm1*norm2)
                ang = math.degrees(math.acos(round(cosang,12)))
                return ang
            
