            def matrix_power_mod(order, mod, power):
                import numpy as np
                M = np.zeros((order, order), dtype=int)
                for i in range(order-1):
                    M[i+1,i] = 1
                M[-1,:] = 1
                # compute power
                result = np.identity(order, dtype=int) % mod
                base = M % mod
                p = power
                while p:
                    if p & 1:
                        result = (result @ base) % mod
                    base = (base @ base) % mod
                    p >>= 1
                return result
            
