            import collections, itertools, math
            
            def generate_closure(x, y, bound=200):
                # BFS closure up to bound absolute value
                S = set([x, y])
                changed = True
                while changed:
                    changed = False
                    # list of current elements to avoid infinite loop while iterating
                    elems = list(S)
                    for a,b in itertools.product(elems, repeat=2):
                        # compute all possible values a^2 + i a b + b^2 that fall within bound
                        # i can be any integer, but we can solve for i that yields value within bound
                        # value = a*a + b*b + i*a*b
                        # i = (value - a*a - b*b) / (a*b)
                        # For each possible i that yields value within bound, we can add.
                        # Instead of iterating i, we can compute range of i that yields value within bound.
                        if a*b == 0:
                            # then value = a^2 + b^2 independent of i
                            val = a*a + b*b
                            if abs(val) <= bound and val not in S:
                                S.add(val); changed=True
                            continue
                        # compute i range
                        min_i = math.ceil((-bound - (a*a + b*b)) / (a*b))
                        max_i = math.floor((bound - (a*a + b*b)) / (a*b))
                        for i in range(min_i, max_i+1):
                            val = a*a + b*b + i*a*b
                            if abs(val) <= bound and val not in S:
                                S.add(val); changed=True
                return S
            
            def contains_one(x,y):
                S = generate_closure(x,y, bound=500)
                return 1 in S
            
