            import random, math, time, sys, numpy as np
            
            def covers_lattice_point(x, y, theta):
                c = math.cos(theta)
                s = math.sin(theta)
                # check four lattice points
                for i,j in [(0,0),(1,0),(0,1),(1,1)]:
                    dx = x - i
                    dy = y - j
                    # rotate by -theta
                    dxp = dx*c + dy*s
                    dyp = -dx*s + dy*c
                    if abs(dxp) <= 0.5 + 1e-12 and abs(dyp) <= 0.5 + 1e-12:
                        return True
                return False
            
            def estimate(N):
                cnt=0
                for _ in range(N):
                    x = random.random()
                    y = random.random()
                    theta = random.random()*2*math.pi
                    if not covers_lattice_point(x,y,theta):
                        cnt+=1
                return cnt/N
            
            for N in [10000, 50000, 200000]:
                p_est = estimate(N)
