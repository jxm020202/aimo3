            def circumcenter(A,B,C):
                Ax,Ay = A
                Bx,By = B
                Cx,Cy = C
                D = 2*(Ax*(By-Cy) + Bx*(Cy-Ay) + Cx*(Ay-By))
                Ux = ((Ax**2+Ay**2)*(By-Cy) + (Bx**2+By**2)*(Cy-Ay) + (Cx**2+Cy**2)*(Ay-By))/D
                Uy = ((Ax**2+Ay**2)*(Cx-Bx) + (Bx**2+By**2)*(Ax-Cx) + (Cx**2+Cy**2)*(Bx-Ax))/D
                return np.array([Ux, Uy], dtype=float)
            
            def incenter(A,B,C):
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                return (a*np.array(A) + b*np.array(B) + c*np.array(C))/(a+b+c)
            
            def line_intersection(P1, d1, P2, d2):
                A = np.column_stack((d1, -d2))
                b = np.array(P2) - np.array(P1)
                t_s = np.linalg.lstsq(A, b, rcond=None)[0]
                return P1 + t_s[0]*d1
            
            def compute_ratio_vector(D,E,F):
                D=np.array(D,float);E=np.array(E,float);F=np.array(F,float)
                P = circumcenter(D,E,F)  # O
                Q = incenter(D,E,F)      # I
                v = P - Q
                w = np.array([-v[1], v[0]])  # direction of line ℓ
                M = line_intersection(Q, w, D, E-D)
                # excenter opposite D
                a = np.linalg.norm(E-F)  # side opposite D
                b = np.linalg.norm(F-D)  # opposite E
                c = np.linalg.norm(D-E)  # opposite F
                I_D = (-a*D + b*E + c*F)/(-a + b + c)
                N = line_intersection(Q, w, F, I_D - F)
                QM = np.linalg.norm(M-Q)
                QN = np.linalg.norm(N-Q)
                return QM/QN
            
