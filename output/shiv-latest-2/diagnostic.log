            def generate_independent_sets(n):
                cells = [(i,j) for i in range(n) for j in range(n)]
                # adjacency: king moves (dx,dy) with max(|dx|,|dy|)=1 and not both zero
                adj = {}
                for c in cells:
                    i,j = c
                    neighbors = set()
                    for di in (-1,0,1):
                        for dj in (-1,0,1):
                            if di==0 and dj==0: continue
                            ni, nj = i+di, j+dj
                            if 0 <= ni < n and 0 <= nj < n:
                                neighbors.add((ni,nj))
                    adj[c] = neighbors
                # generate independent sets via recursion
                indep_sets = []
                def backtrack(start, current):
                    # add current if size>=2
                    if len(current) >= 2:
                        indep_sets.append(set(current))
                    # try adding further cells
                    for idx in range(start, len(cells)):
                        c = cells[idx]
                        # check if c adjacent to any in current
                        if any(c in adj[other] for other in current):
                            continue
                        # also need to ensure c not adjacent to any in current (sym)
                        # Already covered because adjacency symmetric.
                        backtrack(idx+1, current+[c])
                backtrack(0, [])
                return indep_sets
            
            sets4 = generate_independent_sets(4)
            len(sets4)
            
