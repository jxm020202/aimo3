            def minimal_k_bruteforce(max_den):
                min_k = None
                best = None
                for den_t in range(1, max_den+1):
                    for num_t in range(1, den_t):  # t in (0,1)
                        t = Fraction(num_t, den_t)
                        # compute D = 2/(5 t^2 - 2 t + 1)
                        denom_expr = 5*t*t - 2*t + 1
                        # D rational
                        D = Fraction(2,1) / denom_expr
                        # D must be a perfect square rational: numerator and denominator both perfect squares
                        num, den = D.numerator, D.denominator
                        # check perfect squares
                        if int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den:
                            # u = sqrt(D)
                            u = Fraction(int(math.isqrt(num)), int(math.isqrt(den)))
                            # compute s = u*(t+1) - 1
                            s = u*(t+1) - 1
                            if s <= 0 or s >= 1:
                                continue
                            # compute x,y
                            x = Fraction(1,1) - t*t
                            x = x / 2
                            y = Fraction(1,1) - s*s
                            y = y / 2
                            if x <= 0 or y <= 0:
                                continue
                            k = math.lcm(x.denominator, y.denominator)
                            if min_k is None or k < min_k:
                                min_k = k
                                best = (t, u, s, x, y, k)
                return min_k, best
            
