            def equally_spaced_arc(n, L_deg):
                # place n points equally spaced within central angle L (starting at 0)
                L = math.radians(L_deg)
                # points at angles 0, L/(n-1), 2L/(n-1), ..., L
                return [i * L/(n-1) for i in range(n)]
            
