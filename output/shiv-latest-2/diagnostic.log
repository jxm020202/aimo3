            import sympy as sp
            
            def rank_mod(matrix, mod):
                # compute rank over Z_mod using Gaussian elimination
                M = [list(row) for row in matrix.tolist()]
                rows = len(M)
                cols = len(M[0])
                r = 0
                for c in range(cols):
                    # find pivot row with non-zero in column c
                    pivot = None
                    for i in range(r, rows):
                        if M[i][c] % mod != 0:
                            # need to ensure pivot is invertible modulo mod (i.e., gcd(pivot, mod)=1)
                            # For composite mod, we may need to handle non-invertible pivots.
                            # We'll just try to find a pivot with gcd(pivot, mod)=1.
                            if sp.gcd(M[i][c], mod) == 1:
                                pivot = i
                                break
                    if pivot is None:
                        continue
                    # swap rows
                    M[r], M[pivot] = M[pivot], M[r]
                    inv = sp.mod_inverse(M[r][c] % mod, mod)
                    # normalize pivot row
                    M[r] = [(val * inv) % mod for val in M[r]]
                    # eliminate other rows
                    for i in range(rows):
                        if i != r and M[i][c] % mod != 0:
                            factor = M[i][c] % mod
                            M[i] = [(M[i][j] - factor * M[r][j]) % mod for j in range(cols)]
                    r += 1
                    if r == rows:
                        break
                return r
            
            def max_m_rank(n, mod):
                # build matrix rows e_n^T M^k for k=1..m
                # compute M as described
                M = sp.zeros(n)
                for i in range(n-1):
                    M[i, i+1] = 1
                for j in range(n):
                    M[n-1, j] = 1
                rows = []
                cur = sp.eye(n)
                for k in range(1, n+5):
                    cur = (cur * M) % mod
                    row = cur[n-1, :]  # last row
                    rows.append(row)
                    # compute rank
                    mat = sp.Matrix(rows)
                    rank = rank_mod(mat, mod)
                    # print(k, rank)
                    if rank == n:
                        return k  # after k rows rank full, cannot have longer block
                return None
            
            print(max_m_rank(100, 25))
            
