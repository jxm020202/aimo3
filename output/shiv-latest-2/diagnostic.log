            sol_cd = sp.solve([sp.Eq(mid_XY.x + c*perp_XY[0], mid_WZ.x + d*perp_WZ[0]),
                               sp.Eq(mid_XY.y + c*perp_XY[1], mid_WZ.y + d*perp_WZ[1])], (c,d), dict=True)[0]
            O = sp.Point(mid_XY.x + sol_cd[c]*perp_XY[0], mid_XY.y + sol_cd[c]*perp_XY[1])
            
            Nx, Ny = sp.simplify(N.x), sp.simplify(N.y)
            Ox, Oy = sp.simplify(O.x), sp.simplify(O.y)
            
            dot = sp.simplify(Nx*Ox + Ny*Oy)
            normN_sq = sp.simplify(Nx**2 + Ny**2)
