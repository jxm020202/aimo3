            import sympy as sp
            
            def ratio_for_triangle(D, E, F):
                D = sp.Point(D)
                E = sp.Point(E)
                F = sp.Point(F)
                # circumcenter P
                P = sp.geometry.Triangle(D, E, F).circumcenter
                # incenter Q
                Q = sp.geometry.Triangle(D, E, F).incenter
                # line PQ
                line_PQ = sp.Line(P, Q)
                # direction vector of PQ
                v_PQ = sp.Matrix([Q.x - P.x, Q.y - P.y])
                # perpendicular direction vector (rotate 90 degrees)
                v_perp = sp.Matrix([-v_PQ[1], v_PQ[0]])  # rotate CCW
                # line through Q with direction v_perp
                L = sp.Line(Q, Q + sp.Point(v_perp[0], v_perp[1]))
                # line DE
                line_DE = sp.Line(D, E)
                M = L.intersection(line_DE)[0]
                # external bisector at F
                u1 = sp.Matrix([D.x - F.x, D.y - F.y])  # vector FD
                u2 = sp.Matrix([E.x - F.x, E.y - F.y])  # vector FE
                # unit vectors
                norm1 = sp.sqrt(u1.dot(u1))
                norm2 = sp.sqrt(u2.dot(u2))
                u1_hat = u1 / norm1
                u2_hat = u2 / norm2
                v_ext = u1_hat - u2_hat  # external bisector direction
                # line through F with direction v_ext
                # convert to point direction
                dir_point = sp.Point(v_ext[0], v_ext[1])
                line_ext = sp.Line(F, F + dir_point)
                N = L.intersection(line_ext)[0]
                # distances
                QM = Q.distance(M)
                QN = Q.distance(N)
                # simplify ratio
                ratio = sp.simplify(QM / QN)
                return sp.nsimplify(ratio), QM, QN, P, Q, M, N
            
            # test with random triangle
            ratio, QM, QN, P, Q, M, N = ratio_for_triangle((0,0), (5,0), (2,3))
            ratio, QM.evalf(), QN.evalf()
            
