            from fractions import Fraction
            import mpmath as mp
            
            def original_eq(x, y):
                # compute left side
                L = 1 + mp.sqrt(1 - 2*y)
                # compute cubic root terms
                term = (1 + x**2)/2
                sqrt_inside = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                cubic = mp.sign(term + sqrt_inside/6) * abs(term + sqrt_inside/6)**(1/3) + mp.sign(term - sqrt_inside/6) * abs(term - sqrt_inside/6)**(1/3)
                # compute fraction term
                B = mp.sqrt(1 - 2*x)
                frac = (4*x - 2 + 2*B) / (3 - 5*x - B)
                R = y + frac + cubic
                return L, R
            
