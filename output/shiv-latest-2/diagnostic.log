            def greedy_all_sequences(nums):
                # returns list of sequences (as tuples) that can be produced by greedy algorithm (including all tie-breaking)
                # start: choose any number with minimal absolute value
                nums = list(nums)
                # find min absolute value
                min_abs = min(abs(x) for x in nums)
                start_choices = [i for i,x in enumerate(nums) if abs(x)==min_abs]
                sequences = []
                for idx in start_choices:
                    a = nums[idx]
                    remaining = nums[:idx]+nums[idx+1:]
                    # recursively build
                    def dfs(seq, rem, cur_sum):
                        if not rem:
                            sequences.append(tuple(seq))
                            return
                        # find numbers that minimize |cur_sum + x|
                        best_val = None
                        best_idxs = []
                        for i,x in enumerate(rem):
                            val = abs(cur_sum + x)
                            if best_val is None or val < best_val - 1e-12:
                                best_val = val
                                best_idxs = [i]
                            elif abs(val - best_val) < 1e-12:
                                best_idxs.append(i)
                        for i in best_idxs:
                            x = rem[i]
                            new_seq = seq + [x]
                            new_rem = rem[:i]+rem[i+1:]
                            dfs(new_seq, new_rem, cur_sum + x)
                    dfs([a], remaining, a)
                return sequences
            
            def greedy_worst_price(nums):
                seqs = greedy_all_sequences(nums)
                # compute price for each
                return max(price_of_seq(seq) for seq in seqs)
            
            def greedy_best_price(nums):
                seqs = greedy_all_sequences(nums)
                return min(price_of_seq(seq) for seq in seqs)
            
