            import math, random, numpy as np
            
            def square_contains_lattice(theta, cx, cy):
                # compute half-diagonal vectors of square
                # vertices relative to center: rotate (±0.5, ±0.5)
                # We'll check integer points within bounding box
                # Compute bounding box extents:
                # The rotated square's max x deviation = 0.5*abs(cosθ) + 0.5*abs(sinθ) = 0.5*(cos+sin)
                # same for y.
                w = 0.5*(math.cos(theta) + math.sin(theta))
                # bounding box: [cx - w, cx + w] for both x and y (since symmetric)
                # integer points to check:
                imin = math.floor(cx - w - 1e-12)
                imax = math.ceil(cx + w + 1e-12)
                jmin = math.floor(cy - w - 1e-12)
                jmax = math.ceil(cy + w + 1e-12)
                # Precompute rotation matrix
                c = math.cos(theta)
                s = math.sin(theta)
                # For each integer point, test if inside square:
                for i in range(imin, imax+1):
                    for j in range(jmin, jmax+1):
                        # Transform point to square's local coordinates: rotate by -theta
                        dx = i - cx
                        dy = j - cy
                        # rotate by -theta: (x', y') = (dx*c + dy*s, -dx*s + dy*c)
                        x_local = dx*c + dy*s
                        y_local = -dx*s + dy*c
                        if abs(x_local) <= 0.5 + 1e-12 and abs(y_local) <= 0.5 + 1e-12:
                            # point inside or on boundary
                            return True
                return False
            
            def estimate_p(samples=200000):
                count_no = 0
                for _ in range(samples):
                    theta = random.random() * (math.pi/2)  # uniform orientation
                    cx = random.random()
                    cy = random.random()
                    if not square_contains_lattice(theta, cx, cy):
                        count_no += 1
                return count_no / samples
            
            print(estimate_p(20000))
            
