                return np.array([float(sol[x]), float(sol[y])])
            
            def M_point(u,v,p,q):
                A = np.array([[u, -(p-1)], [v, -q]], dtype=float)
                b = np.array([1.0, 0.0])
                t,s = np.linalg.solve(A, b)
                return np.array([t*u, t*v])
            
            def angle_NMO(u,v,p,q):
                N = N_analytic(u,v,p,q)
                O = O_analytic(u,v,p,q)
                M = M_point(u,v,p,q)
                if N is None or O is None:
                    return None
                v1 = N - M
                v2 = O - M
                dot = np.dot(v1, v2)
                ang = math.degrees(math.acos(dot/(np.linalg.norm(v1)*np.linalg.norm(v2))))
                return ang, dot
            
