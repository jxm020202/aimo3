            def cross_scalar(Pt, A, B):
                # (B-A) x (A-Pt) = (x2-x1)*(y1-yp) - (y2-y1)*(x1-xp)
                return (B.x - A.x)*(A.y - Pt.y) - (B.y - A.y)*(A.x - Pt.x)
            
            def line_length_sq(A, B):
