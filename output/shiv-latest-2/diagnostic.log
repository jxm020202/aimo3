            def uncovered_area(theta, N=800):
                # compute uncovered area for given theta via fine grid in fundamental parallelogram
                # We'll sample points in the unit square (0,1)^2 and map to parallelogram via linear transform
                # Actually easier: sample points (x,y) in [0,1)^2, treat as coordinates in basis e1,e2:
                e1 = np.array([math.cos(theta), math.sin(theta)])
                e2 = np.array([-math.sin(theta), math.cos(theta)])
                count_no=0
                total=N*N
                for i in range(N):
                    a = (i+0.5)/N
                    for j in range(N):
                        b = (j+0.5)/N
                        # point in plane:
                        pt = a*e1 + b*e2
                        # compute L∞ distance to nearest lattice point of rotated lattice (i.e., to points of form m*e1 + n*e2)
                        # Since we are in fundamental cell, nearest lattice point is either (0,0), e1, e2, e1+e2
                        # Compute distances:
                        # distance to origin:
                        def linf_dist(p):
                            return max(abs(p[0]), abs(p[1]))
                        d0 = linf_dist(pt)
                        d1 = linf_dist(pt - e1)
                        d2 = linf_dist(pt - e2)
                        d3 = linf_dist(pt - (e1+e2))
                        dmin = min(d0,d1,d2,d3)
                        if dmin > 0.5 + 1e-12:
                            count_no+=1
                return count_no/total
            
            def avg_uncovered(num_theta=200, N=400):
                total=0.0
                for ti in range(num_theta):
                    theta = (ti+0.5)/num_theta * (math.pi/2)
                    total += uncovered_area(theta, N)
                return total/num_theta
            
