            def t_for_point(a,b,c):
                # compute minimal t >=0 such that sum max(0, a-t)^2 + ... <= 1
                # Since function decreasing, we can binary search.
                lo=0.0
                hi=max(a,b,c) # at hi, sum=0 <=1
                for _ in range(60):
                    mid=(lo+hi)/2
                    s = sum(max(0, coord-mid)**2 for coord in (a,b,c))
