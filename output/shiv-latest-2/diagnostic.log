            def eventually_increasing(n, K=2000):
                # check if there exists N such that for all k > N up to K, seq strictly increasing.
                # We'll search for any decrease after some point.
                seq = [lcm_range(k, n) for k in range(1, K+1)]
                # find last index where seq[i+1] <= seq[i]
                last_bad = -1
                for i in range(len(seq)-1):
                    if seq[i+1] <= seq[i]:
                        last_bad = i+1  # index of later term (1-indexed)
                # If last_bad == -1, strictly increasing throughout.
                # If after last_bad there are no further non-increases (i.e., last_bad is the final index), we need to ensure monotonic after that.
                # But we only have finite K. We'll approximate: if after some point (say after last_bad) there are no more non-increases up to K, assume eventual.
                # We'll also check that after last_bad, sequence is strictly increasing (i.e., no more non-increases).
                if last_bad == -1:
                    return True, None
                # Check if any non-increase after last_bad
                for i in range(last_bad, len(seq)-1):
                    if seq[i+1] <= seq[i]:
                        return False, None
                # If none after last_bad up to K, we assume eventual.
                return True, last_bad
            
            candidates = []
            for n in range(1, 31):
                ok, N = eventually_increasing(n, K=2000)
                print(n, ok, N)
                if ok:
                    candidates.append(n)
            print("candidates:", candidates)
            
