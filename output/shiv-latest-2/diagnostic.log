            def monotone_two_step(n):
                B = n+1
                for config in range(1<<n):
                    cur = config
                    while True:
                        k = bin(cur).count('1')
                        if k == 0:
                            break
                        nxt = cur ^ (1 << (k-1))
                        # compute V
                        def V(state):
                            val = 0
                            for i in range(n):
