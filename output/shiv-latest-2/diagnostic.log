            def random_points_in_disk(center, radius, n):
                pts=[]
                for _ in range(n):
                    # uniform in disk
                    r=radius*math.sqrt(random.random())
                    theta=random.random()*2*math.pi
                    x=center[0]+r*math.cos(theta)
                    y=center[1]+r*math.sin(theta)
                    pts.append((x,y))
                return pts
            
            def compute_ai_points(points):
                n=len(points)
                a_vals=[]
                for i in range(n):
                    vi=np.array(points[i])
                    dirs=[]
                    for j in range(n):
                        if i==j: continue
                        vj=np.array(points[j])
                        vec=vj-vi
                        ang=math.degrees(math.atan2(vec[1],vec[0]))
                        if ang<0: ang+=360
                        dirs.append(ang)
                    dirs.sort()
                    dirs2=dirs+[d+360 for d in dirs]
                    maxcnt=0
                    l=0
                    for r in range(len(dirs2)):
