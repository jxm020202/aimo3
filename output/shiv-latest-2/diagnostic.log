            import numpy as np, math, itertools, random, sys, collections, itertools, math, numpy as np
            def convex_hull(points):
                # monotonic chain
                pts=sorted(points)
                if len(pts)<=1:
                    return pts
                def cross(o,a,b):
                    return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])
                lower=[]
                for p in pts:
                    while len(lower)>=2 and cross(lower[-2], lower[-1], p) <= 0:
                        lower.pop()
                    lower.append(p)
                upper=[]
                for p in reversed(pts):
                    while len(upper)>=2 and cross(upper[-2], upper[-1], p) <= 0:
                        upper.pop()
                    upper.append(p)
                return lower[:-1]+upper[:-1]
            
            hull = convex_hull(best_pts)
            len(hull)
            
