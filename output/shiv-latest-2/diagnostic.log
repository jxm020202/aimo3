            def line_intersection(p1,p2,q1,q2):
                # Solve p1 + t*(p2-p1) = q1 + s*(q2-q1)
                x1,y1 = p1.real, p1.imag
                x2,y2 = p2.real, p2.imag
                x3,y3 = q1.real, q1.imag
                x4,y4 = q2.real, q2.imag
                # compute denominator
                den = (x1-x2)*(y3-y4) - (y1-y2)*(x3-x4)
                if abs(den) < 1e-12:
                    return None  # parallel or coincident
                # intersection coordinates
                ix = ((x1*y2 - y1*x2)*(x3 - x4) - (x1 - x2)*(x3*y4 - y3*x4)) / den
                iy = ((x1*y2 - y1*x2)*(y3 - y4) - (y1 - y2)*(x3*y4 - y3*x4)) / den
                return complex(ix, iy)
            
            def point_on_segment(p, a, b, eps=1e-9):
                # check if p lies between a and b (including endpoints)
                # using dot product and distance
                # compute projection parameter t
                ax, ay = a.real, a.imag
                bx, by = b.real, b.imag
                px, py = p.real, p.imag
                # vector ab
                vx, vy = bx-ax, by-ay
                # vector ap
                wx, wy = px-ax, py-ay
                # compute dot product
                dot = vx*wx + vy*wy
                if dot < -eps:
                    return False
                sq_len = vx*vx + vy*vy
                if dot > sq_len + eps:
                    return False
                # also check collinearity (cross product near zero)
                cross = vx*wy - vy*wx
                if abs(cross) > eps:
                    return False
                return True
            
