            def max_multiplicity(theta, N=200):
                # grid points in [0,1) x [0,1)
                xs = np.linspace(0,1, N, endpoint=False) + 0.5/N
                ys = np.linspace(0,1, N, endpoint=False) + 0.5/N
                X, Y = np.meshgrid(xs, ys, indexing='ij')
                points = np.stack([X.ravel(), Y.ravel()], axis=1)
                # define square vertices relative to center (0,0)
                # half side = 0.5
                # square region: |u| <= 0.5, |v| <= 0.5 after rotating coordinates by -theta
                c = math.cos(-theta)
                s = math.sin(-theta)
                # rotation matrix for -theta
                R = np.array([[c, -s],[s, c]])
                # For each lattice point (i,j) in -1..1, compute if point is inside that square
                mult = np.zeros(points.shape[0], dtype=int)
                for i in (-1,0,1):
                    for j in (-1,0,1):
                        # translate points by -(i,j) to bring square centered at (i,j) to origin
                        shifted = points - np.array([i,j])
                        # rotate coordinates
                        uv = shifted @ R.T  # shape (n,2)
                        inside = (np.abs(uv[:,0]) <= 0.5+1e-12) & (np.abs(uv[:,1]) <= 0.5+1e-12)
                        mult[inside] += 1
                return mult.max()
            
            for th in [0, math.pi/8, math.pi/4, math.pi/3, math.pi/2]:
                print(th, max_multiplicity(th, N=400))
            
