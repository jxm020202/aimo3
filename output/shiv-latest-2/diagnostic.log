            def angle(p,q,r):
                # angle pqr (at q) between qp and qr
                v1 = np.array(p) - np.array(q)
                v2 = np.array(r) - np.array(q)
                dot = np.dot(v1, v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                if norm==0:
                    return 0
                cosang = dot/norm
                # clamp
                cosang = max(-1,min(1,cosang))
                return math.degrees(math.acos(cosang))
            
            def perp(v):
                return np.array([-v[1], v[0]])
            
            def line_from_perp_bisector(A,B):
                # returns point (midpoint) and direction (perp vector)
                mid = (np.array(A)+np.array(B))/2.0
                dir = perp(np.array(B)-np.array(A))
                return mid, dir
            
            def intersect_lines(p1, d1, p2, d2):
                # solve p1 + t*d1 = p2 + s*d2
                # 2D
                A = np.column_stack((d1, -d2))
                b = np.array(p2)-np.array(p1)
                # solve A*[t,s]^T = b
                # use least squares
                try:
                    sol = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    # parallel
                    return None
                t = sol[0]
                return p1 + t*d1
            
            def compute_N_O(w,x,y,z):
                # N: intersection of perp bisectors of WX and YZ
                mid_WX, dir_WX = line_from_perp_bisector(w,x)
                mid_YZ, dir_YZ = line_from_perp_bisector(y,z)
                N = intersect_lines(mid_WX, dir_WX, mid_YZ, dir_YZ)
                # O: intersection of perp bisectors of XY and WZ
                mid_XY, dir_XY = line_from_perp_bisector(x,y)
                mid_WZ, dir_WZ = line_from_perp_bisector(w,z)
                O = intersect_lines(mid_XY, dir_XY, mid_WZ, dir_WZ)
                return N, O
            
            def random_quadrilateral_equal_diagonals():
                # generate random points w,y collinear, x,z collinear, equal diagonal lengths
                # Choose random direction vectors u and v (non-parallel)
                theta = random.uniform(0, math.pi)
                u = np.array([math.cos(theta), math.sin(theta)])
                phi = random.uniform(0, math.pi)
                # ensure not parallel: phi not equal to theta or theta+pi
                while abs(math.sin(phi-theta)) < 1e-3:
                    phi = random.uniform(0, math.pi)
                v = np.array([math.cos(phi), math.sin(phi)])
                # Choose scalars a,b,c,d such that |b-a| = |d-c|
                a = random.uniform(-5,5)
                b = random.uniform(-5,5)
                # Choose length L = |b-a|
                L = abs(b-a)
                # Choose c random, then set d = c +/- L
                c = random.uniform(-5,5)
                sign = random.choice([1,-1])
                d = c + sign*L
                w = a*u
                y = b*u
                x = c*v
                z = d*v
                return w,x,y,z
            
