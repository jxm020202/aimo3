            def is_good_prime(p):
                # returns True if p does NOT divide any a_n (i.e., good)
                if p == 2:
                    return False
                if p == 3:
                    # check if any n gives zero mod 3
                    for n in range(1, 10):
                        if (8*pow(6,n-1,p) + pow(2,n,p) + pow(3,n-1,p) - 1) % p == 0:
                            return False
                    return True
                # compute order of 2 and 3 modulo p
                ord2 = sp.n_order(2, p)
                ord3 = sp.n_order(3, p)
                L = sp.ilcm(ord2, ord3)
                # iterate k from 0 to L-1
                for k in range(L):
                    n = k+1
                    if (8*pow(6,k,p) + pow(2,n,p) + pow(3,k,p) - 1) % p == 0:
                        return False
                return True
            
