                    x2, y2 = edge_end
                    # compute cross product (edge vector) x (point - edge_start)
                    return (x2 - x1)*(y - y1) - (y2 - y1)*(x - x1) >= -1e-12  # allow tolerance
            
                def compute_intersection(p1, p2, edge_start, edge_end):
                    # line segment p1-p2 intersect with line edge_start-edge_end (infinite line)
                    x1, y1 = p1
                    x2, y2 = p2
                    x3, y3 = edge_start
                    x4, y4 = edge_end
                    # compute intersection of lines (p1-p2) and (edge_start-edge_end)
                    # using parametric form
                    denom = (x1 - x2)*(y3 - y4) - (y1 - y2)*(x3 - x4)
                    if abs(denom) < 1e-12:
                        return None
                    ix = ((x1*y2 - y1*x2)*(x3 - x4) - (x1 - x2)*(x3*y4 - y3*x4)) / denom
                    iy = ((x1*y2 - y1*x2)*(y3 - y4) - (y1 - y2)*(x3*y4 - y3*x4)) / denom
                    return (ix, iy)
            
                output = poly1[:]
                n2 = len(poly2)
                for i in range(n2):
