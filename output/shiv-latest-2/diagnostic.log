            import random, math, numpy as np
            
            def compute_angle(a,b,c,d,theta):
                # u = (1,0), v = (cosθ, sinθ)
                u = np.array([1.0, 0.0])
                v = np.array([math.cos(theta), math.sin(theta)])
                W = a * u
                Y = -b * u
                X = c * v
                Z = -d * v
                # Solve for N: equidistant from W and X, and from Y and Z.
                # Solve linear equations: (N-W)·(N-W) = (N-X)·(N-X) => expand: N·N -2N·W + W·W = N·N -2N·X + X·X => -2N·W + W·W = -2N·X + X·X => 2N·(X-W) = X·X - W·W
                # So N·(X-W) = (X·X - W·W)/2
                # Similarly from Y,Z: N·(Z-Y) = (Z·Z - Y·Y)/2
                A = np.array([X - W, Z - Y])  # 2x2 matrix rows
                b_vec = np.array([(np.dot(X,X) - np.dot(W,W))/2.0,
                                  (np.dot(Z,Z) - np.dot(Y,Y))/2.0])
                # Solve A N = b_vec (but A rows are vectors, need to treat as linear equations: dot(N, row_i) = b_i)
                # This is a linear system: row_i · N = b_i.
                # Represent as matrix with rows = row_i components.
                M = np.vstack(A)  # shape (2,2)
                # Solve M N = b_vec
                N = np.linalg.solve(M, b_vec)
                # Solve for O: equidistant from X and Y, and from W and Z.
                # O·(Y-X) = (Y·Y - X·X)/2
                # O·(Z-W) = (Z·Z - W·W)/2
                A2 = np.array([Y - X, Z - W])
                b2 = np.array([(np.dot(Y,Y) - np.dot(X,X))/2.0,
                               (np.dot(Z,Z) - np.dot(W,W))/2.0])
                M2 = np.vstack(A2)
                O = np.linalg.solve(M2, b2)
                # angle between N and O
                dot = np.dot(N, O)
                normN = np.linalg.norm(N)
                normO = np.linalg.norm(O)
                angle = math.degrees(math.acos(dot/(normN*normO)))
                return angle, N, O
            
            def test_random():
                for i in range(10):
                    # random lengths
                    a = random.uniform(0.5, 2.0)
                    b = random.uniform(0.5, 2.0)
                    D = a + b
                    # choose c,d such that c+d = D
                    c = random.uniform(0.5, D-0.5)
                    d = D - c
                    theta = random.uniform(0.1, math.pi-0.1)
                    ang, N, O = compute_angle(a,b,c,d,theta)
                    print(i, ang)
            test_random()
            
