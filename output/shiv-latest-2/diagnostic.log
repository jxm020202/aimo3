            import numpy as np, random, math
            
            def circumcenter(D,E,F):
                # Solve linear system for center (Ux, Uy)
                # Using formula based on perpendicular bisectors
                D = np.array(D); E = np.array(E); F = np.array(F)
                # Midpoints
                mid_DE = (D+E)/2
                mid_DF = (D+F)/2
                # direction vectors of DE and DF
                v_DE = E - D
                v_DF = F - D
                # perpendicular directions
                perp_DE = np.array([-v_DE[1], v_DE[0]])
                perp_DF = np.array([-v_DF[1], v_DF[0]])
                # Solve for intersection: mid_DE + s*perp_DE = mid_DF + t*perp_DF
                A = np.column_stack((perp_DE, -perp_DF))
                b = mid_DF - mid_DE
                # Solve for s,t
                sol = np.linalg.lstsq(A, b, rcond=None)[0]
                s = sol[0]
                center = mid_DE + s*perp_DE
                return center
            
            def incenter(D,E,F):
                D = np.array(D); E = np.array(E); F = np.array(F)
                a = np.linalg.norm(E-F) # opposite D
                b = np.linalg.norm(D-F) # opposite E
                c = np.linalg.norm(D-E) # opposite F
                Q = (a*D + b*E + c*F) / (a+b+c)
                return Q
            
            def unit(v):
                return v/np.linalg.norm(v)
            
            def ratio_numeric(D,E,F):
                D=np.array(D);E=np.array(E);F=np.array(F)
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line PQ direction
                v_PQ = P - Q
                # perpendicular direction
                v_perp = np.array([-v_PQ[1], v_PQ[0]])
                # param eq for line through Q: Q + t * v_perp
                # Intersection with DE line: D + s*(E-D)
                # Solve Q + t*v_perp = D + s*(E-D)
                A = np.column_stack((v_perp, -(E-D)))
                b = D - Q
                sol = np.linalg.lstsq(A, b, rcond=None)[0]
                t_M = sol[0]; s_M = sol[1]
                M = Q + t_M * v_perp
                # external bisector at F: direction = unit(FD) - unit(FE)
                FD = D - F
                FE = E - F
                v_ext = unit(FD) - unit(FE)
                # line through F: F + u * v_ext
                # Intersection with same line: Q + t*v_perp = F + u*v_ext
                A2 = np.column_stack((v_perp, -v_ext))
                b2 = F - Q
                sol2 = np.linalg.lstsq(A2, b2, rcond=None)[0]
                t_N = sol2[0]; u_N = sol2[1]
                N = Q + t_N * v_perp
                QM = np.linalg.norm(M - Q)
                QN = np.linalg.norm(N - Q)
                return QM/QN
            
            # test on the integer triangle
            print(ratio_numeric((0,0),(6,0),(2,4)))
            
