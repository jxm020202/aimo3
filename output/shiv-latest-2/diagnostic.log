                        # Solve for t rational: treat as quadratic in t.
                        a = w*w * 5 - 2
                        b = - w*w * 2 - 4
                        c = w*w * 1 - 2
                        # Actually expand: w^2*(5 t^2 - 2 t +1) - 2(t^2 + 2t +1) = 0
                        # => (5 w^2) t^2 - (2 w^2) t + w^2 - 2 t^2 - 4 t - 2 = 0
                        # => (5 w^2 - 2) t^2 + (-2 w^2 - 4) t + (w^2 - 2) = 0
                        a = 5*w*w - 2
