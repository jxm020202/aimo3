            import mpmath as mp
            
            def original_eq(x,y):
                term1 = 1 + mp.sqrt(1 - 2*y)
                term2 = y + (4*x - 2 + 2*mp.sqrt(1 - 2*x)) / (3 - 5*x - mp.sqrt(1 - 2*x))
                # cube root term
                A = (1 + x**2)/2 + (1/6)*mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                B = (1 + x**2)/2 - (1/6)*mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                term3 = mp.sign(A)*abs(A)**(1/3) + mp.sign(B)*abs(B)**(1/3)  # real cube roots
                return term1, term2+term3
            
