            def find_pairing(n):
                # variable list: (d,i) where i is the smaller element, d is difference
                var_list = []
                for d in range(1, n+1):
                    for i in range(1, 2*n - d + 1):
                        var_list.append((d,i))
                m = len(var_list)
                # objective: none, just feasibility, set zero cost
                c = np.zeros(m)
                # constraints:
                # 1) each difference used exactly once
                A_diff = np.zeros((n, m))
                for idx, (d,i) in enumerate(var_list):
                    A_diff[d-1, idx] = 1
                b_diff = np.ones(n)
                # 2) each number appears exactly once
                # numbers from 1..2n
                A_num = np.zeros((2*n, m))
                for idx, (d,i) in enumerate(var_list):
                    # small element i
                    A_num[i-1, idx] = 1
                    # large element i+d
                    A_num[i+d-1, idx] = 1
                b_num = np.ones(2*n)
                # combine constraints
                A = np.vstack([A_diff, A_num])
                lb = np.zeros(A.shape[0])
                ub = np.concatenate([b_diff, b_num])
                # constraints: equality, so set both lb and ub to same value
                # Actually we need equality constraints: each sum == 1
                # Use LinearConstraint with both lower and upper equal to RHS
                lc = LinearConstraint(A, ub, ub)  # both lower and upper = ub
                bounds = Bounds(0, 1)  # binary variables but milp will enforce integrality later
                # integrality vector
                integrality = np.ones(m, dtype=int)
                res = milp(c, integrality=integrality, bounds=bounds, constraints=lc, options={'disp': False})
                if res.success:
                    x = res.x.round().astype(int)
                    pairs = []
                    for val, (d,i) in zip(x, var_list):
                        if val:
                            pairs.append((i, i+d))
                    return pairs
                else:
                    return None
            
