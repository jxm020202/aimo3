            def max_side(p,q,t):
                # compute side lengths
                pq = math.hypot(p, q)  # sqrt(p^2 + q^2)
                pr = math.hypot(t - p, math.sqrt(3)*(1 - t))
                qr = math.hypot(t, math.sqrt(3)*(1 - t) - q)
                return max(pq, pr, qr)
            
            def search_grid(n):
