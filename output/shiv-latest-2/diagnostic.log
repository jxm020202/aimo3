            def king_neighbors(pos, n):
                x,y = pos
                neigh = []
                for dx in (-1,0,1):
                    for dy in (-1,0,1):
                        if dx==0 and dy==0: continue
                        nx, ny = x+dx, y+dy
                        if 0 <= nx < n and 0 <= ny < n:
                            neigh.append((nx,ny))
                return neigh
            
            def independent_sets(n):
                # generate all independent sets (including empty) for n x n board with king adjacency
                positions = [(i,j) for i in range(n) for j in range(n)]
                # Use recursion with backtracking
                adj = {p:set(king_neighbors(p,n)) for p in positions}
                indep_sets = []
                def backtrack(idx, current, forbidden):
                    if idx == len(positions):
                        indep_sets.append(set(current))
                        return
                    p = positions[idx]
                    # option: skip p
                    backtrack(idx+1, current, forbidden)
                    # option: include p if not forbidden
                    if p not in forbidden:
                        new_forbidden = forbidden.union(adj[p]).union({p})
                        backtrack(idx+1, current+[p], new_forbidden)
                backtrack(0, [], set())
                return indep_sets
            
