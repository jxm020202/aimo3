            import numpy as np, math, random
            
            def excenter_C(A,B,C):
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c_len = np.linalg.norm(A-B)
                I_c = (a*A + b*B - c_len*C) / (a + b - c_len)
                return I_c
            
            def incenter(A,B,C):
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c_len = np.linalg.norm(A-B)
                I = (a*A + b*B + c_len*C) / (a+b+c_len)
                return I
            
            def test_one():
                A = np.random.rand(2)*10
                B = np.random.rand(2)*10
                C = np.random.rand(2)*10
                I = incenter(A,B,C)
                I_c = excenter_C(A,B,C)
                # compute area of triangle I-C-Ic to see collinearity
                area = np.linalg.norm(np.cross(I-C, I_c-C))
                return area
            
