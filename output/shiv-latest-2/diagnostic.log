            import random, math, numpy as np
            
            def angle(p, q, r):
                # angle pqr (at q) in radians
                v1 = np.array(p) - np.array(q)
                v2 = np.array(r) - np.array(q)
                dot = np.dot(v1, v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                if norm == 0:
                    return 0
                cos = dot/norm
                # clamp
                cos = max(-1, min(1, cos))
                return math.acos(cos)
            
            def compute_angle(theta, u, v, p, q):
                # a = (1,0), b = (cosθ, sinθ)
                a = np.array([1.0, 0.0])
                b = np.array([math.cos(theta), math.sin(theta)])
                W = a * u
                Y = -a * v
                X = b * p
                Z = -b * q
                # compute perpendicular bisector lines
                # line defined as (point, direction)
                def perp_bisector(P, Q):
                    mid = (np.array(P)+np.array(Q))/2
                    # direction vector is perpendicular to PQ
                    d = np.array(Q)-np.array(P)
                    # perpendicular direction
                    perp = np.array([-d[1], d[0]])
                    return (mid, perp)
                # N: intersection of bisectors of WX and YZ
                mid1, dir1 = perp_bisector(W, X)
                mid2, dir2 = perp_bisector(Y, Z)
                # solve for intersection: mid1 + t1*dir1 = mid2 + t2*dir2
                A = np.column_stack((dir1, -dir2))
                bvec = mid2 - mid1
                try:
                    t = np.linalg.solve(A, bvec)
                except np.linalg.LinAlgError:
                    return None
                N = mid1 + t[0]*dir1
                # O: bisectors of XY and WZ
                mid3, dir3 = perp_bisector(X, Y)
                mid4, dir4 = perp_bisector(W, Z)
                A2 = np.column_stack((dir3, -dir4))
                bvec2 = mid4 - mid3
                try:
                    t2 = np.linalg.solve(A2, bvec2)
                except np.linalg.LinAlgError:
                    return None
                O = mid3 + t2[0]*dir3
                M = np.array([0.0,0.0])
                ang = angle(N, M, O) # angle NMO in radians
                return math.degrees(ang)
            
            def test_random():
                for i in range(10):
                    theta = random.uniform(0.2, math.pi-0.2) # not too small
                    # choose u,v,p,q positive such that u+v = p+q
                    total = random.uniform(1,5)
                    u = random.uniform(0.1,total-0.1)
                    v = total - u
                    p = random.uniform(0.1,total-0.1)
                    q = total - p
                    ang = compute_angle(theta, u, v, p, q)
                    print(i, theta, u, v, p, q, ang)
            test_random()
            
