            import math, numpy as np
            
            def center_of_parallelogram(theta):
                # basis vectors
                e1 = np.array([math.cos(theta), math.sin(theta)])
                e2 = np.array([-math.sin(theta), math.cos(theta)])
                # vertices: 0, e1, e2, e1+e2
                verts = np.array([[0,0], e1, e2, e1+e2])
                center = verts.mean(axis=0)
                return center
            
            def transformed_center(theta):
                c = center_of_parallelogram(theta)
                # rotate by -theta
                R = np.array([[math.cos(-theta), -math.sin(-theta)],
                              [math.sin(-theta),  math.cos(-theta)]])
                return R @ c
            
