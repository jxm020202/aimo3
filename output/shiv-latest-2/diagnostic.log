                    S = Fraction(2,1) + Fraction(8,1)*a*(1 - a) / D
                    # reduce fraction
                    num = S.numerator
                    den = S.denominator
                    # check if both numerator and denominator are perfect squares
                    if is_square(num) and is_square(den):
                        s = Fraction(int(math.isqrt(num)), int(math.isqrt(den)))
