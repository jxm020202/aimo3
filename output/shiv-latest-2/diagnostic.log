            def test_seq(seq, N=30):
                # seq is list of values for indices 0..len(seq)-1, assumed periodic
                L = len(seq)
                def f(i):
                    return seq[i % L]
                for p in range(N):
                    lhs = f(f(f(p)))
                    rhs = f(p+1) + 1
                    if lhs != rhs:
                        return False, p, lhs, rhs
                return True, None, None, None
            
