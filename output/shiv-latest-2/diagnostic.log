            def circumradius(A,B,C):
                # R = a/(2 sin A) etc. Use formula: R = abc/(4K)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                # area
                K = 0.5*abs(np.cross(B-A, C-A))
                R = a*b*c/(4*K)
                return R
            
            def inradius(A,B,C):
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                K = 0.5*abs(np.cross(B-A, C-A))
                s = (a+b+c)/2
                r = K/s
                return r
            
