            def count_nonmutual(points):
                n=len(points)
                a,_=max_in_wedge(points)
                # compute for each i the set of j in optimal wedge
                # need to also get the actual wedge orientation to know which j are counted.
                # We'll compute for each i the interval achieving max count (choose first found)
                n=len(points)
                seen=[set() for _ in range(n)]
                rad=math.radians(100)
                for i in range(n):
                    angles=[]
                    vecs=[]
                    xi,yi=points[i]
                    for j in range(n):
                        if i==j: continue
                        xj,yj=points[j]
                        ang=math.atan2(yj-yi, xj-xi)
                        angles.append(ang)
                        vecs.append(j)
                    # sort angles with indices
                    paired=sorted(zip(angles,vecs))
                    angs=[p[0] for p in paired]
                    idxs=[p[1] for p in paired]
                    m=len(angs)
                    angs2=angs+[a+2*math.pi for a in angs]
                    idxs2=idxs+idxs
                    left=0
                    best_set=set()
                    best=0
                    for right in range(len(angs2)):
                        while angs2[right]-angs2[left] > rad+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>best:
                            best=cnt
                            best_set=set(idxs2[left:right+1])
                    seen[i]=best_set
                # count unordered pairs where neither sees each other
                neither=0
                one=0
                both=0
                for i in range(n):
                    for j in range(i+1,n):
                        i_sees_j = (j in seen[i])
                        j_sees_i = (i in seen[j])
                        if i_sees_j and j_sees_i:
                            both+=1
                        elif i_sees_j or j_sees_i:
                            one+=1
                        else:
                            neither+=1
                return both, one, neither
            
