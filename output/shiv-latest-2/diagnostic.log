            import numpy as np, random, math
            
            def circumcenter_np(A,B,C):
                # using formula for circumcenter of triangle in 2D
                A = np.array(A); B = np.array(B); C = np.array(C)
                # compute perpendicular bisectors intersection
                # Using linear algebra: solve for center O such that |O-A|^2 = |O-B|^2 = |O-C|^2
                # Equivalent to solving linear equations:
                # 2*(B-A)·O = |B|^2 - |A|^2
                # 2*(C-A)·O = |C|^2 - |A|^2
                BA = B - A
                CA = C - A
                rhs1 = np.dot(B,B) - np.dot(A,A)
                rhs2 = np.dot(C,C) - np.dot(A,A)
                M = np.array([2*BA, 2*CA])
                rhs = np.array([rhs1, rhs2])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter_np(A,B,C):
                A = np.array(A); B = np.array(B); C = np.array(C)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C) / (a+b+c)
                return I
            
            def excenter_np(A,B,C, opposite='A'):
                A = np.array(A); B = np.array(B); C = np.array(C)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                if opposite == 'A':
                    num = -a*A + b*B + c*C
                    den = -a + b + c
                elif opposite == 'B':
                    num = a*A - b*B + c*C
                    den = a - b + c
                elif opposite == 'C':
                    num = a*A + b*B - c*C
                    den = a + b - c
                else:
                    raise ValueError
                return num/den
            
            def line_perp_through_point_np(O, I):
                # direction vector v perpendicular to OI
                OI = O - I
                v = np.array([-OI[1], OI[0]])  # rotate 90 deg
                return I, v
            
            def intersect_line_with_segment(I, v, P1, P2):
                # solve I + t v = P1 + s (P2-P1)
                # 2 equations, 2 unknowns t,s
                P1 = np.array(P1); P2 = np.array(P2)
                w = P2 - P1
                # Solve [v, -w] [t; s] = P1 - I
                A = np.column_stack((v, -w))
                rhs = P1 - I
                try:
                    sol = np.linalg.solve(A, rhs)
                except np.linalg.LinAlgError:
                    return None
                t = sol[0]
                # s = sol[1]
                return I + t*v, t
            
            def external_bisector_direction_np(D,E,F):
                # external bisector at F direction w = (D-F)/|D-F| - (E-F)/|E-F|
                D = np.array(D); E = np.array(E); F = np.array(F)
                u1 = (D - F) / np.linalg.norm(D - F)
                u2 = (E - F) / np.linalg.norm(E - F)
                w = u1 - u2
                return w
            
            def intersect_line_with_external_bisector(I, v, D,E,F):
                w = external_bisector_direction_np(D,E,F)
                # Solve I + t v = F + s w
                A = np.column_stack((v, -w))
                rhs = np.array(F) - I
                try:
                    sol = np.linalg.solve(A, rhs)
                except np.linalg.LinAlgError:
                    return None
                t = sol[0]
                return I + t*v, t
            
            def compute_ratio_np(D,E,F):
                O = circumcenter_np(D,E,F)
                I = incenter_np(D,E,F)
