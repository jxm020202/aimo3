            def find_points_for_Q(n, d, Q, bound=5):
                # Q is sympy poly with integer coeffs, degree < d
                # Need to find k<=n and distinct integers a1..a_{k+1} such that
                # Q(a_{k+1}) - sum_{i=1}^k Q(a_i) = a_{k+1}**d - sum_{i=1}^k a_i**d
                # Equivalent: R(a_{k+1}) = sum_{i=1}^k R(a_i) where R(x)=Q(x)-x**d
                R = sp.expand(Q - sp.Symbol('x')**d)
                xs = sp.Symbol('x')
                # search k from 1 to n
                for k in range(1, n+1):
                    # choose k+1 distinct integers from range -bound..bound
                    # to limit, we can iterate combos of size k+1
                    for combo in itertools.combinations(range(-bound, bound+1), k+1):
                        # need distinct, combos already distinct
                        # try each possible choice of which element is the "last" a_{k+1}
                        for idx in range(k+1):
                            a_last = combo[idx]
                            others = combo[:idx] + combo[idx+1:]
                            # compute equality
                            val_last = R.subs(xs, a_last)
                            sum_others = sum(R.subs(xs, a) for a in others)
                            if val_last == sum_others:
                                return True, (k, combo, idx)
                return False, None
            
            def test_n(n, bound=5, coeff_range=2):
                x = sp.Symbol('x')
                for d in range(1, n+1):
                    # generate some Q polynomials degree < d with coefficients in -coeff_range..coeff_range
                    # iterate all combos for small degree
                    for coeffs in itertools.product(range(-coeff_range, coeff_range+1), repeat=d):
                        # degree < d, so highest coefficient may be zero; we can include all combos
                        # Build polynomial
                        Q = sum(coeffs[i]*x**i for i in range(d))
                        ok, _ = find_points_for_Q(n, d, Q, bound)
                        if not ok:
                            print(f"Failed for n={n}, d={d}, Q={Q}")
                            return False
                return True
            
            for n in range(1,6):
                print("Testing n", n)
                res = test_n(n, bound=5, coeff_range=1)
                print("Result:", res)
            
