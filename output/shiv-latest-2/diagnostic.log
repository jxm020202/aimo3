            import numpy as np, math, time
            
            def estimate_vectorized(N):
                # generate N random values
                thetas = np.random.rand(N) * (math.pi/2)
                cxs = np.random.rand(N)
                cys = np.random.rand(N)
                # compute condition for each sample: check if any integer point lies inside
                # We'll approximate by checking only nearest integer points: floor and ceil of cx +/- half width
                # However we need exact condition; we can compute using vectorized approach for each sample with loop over small set of candidate integer points.
                # For each sample, compute half width L/2 = (cosθ+sinθ)/2
                cos_t = np.cos(thetas)
                sin_t = np.sin(thetas)
                half = (cos_t + sin_t) / 2.0
                # Determine candidate integer points: for each sample, i can be floor(cx - half) to ceil(cx + half)
                # We'll just check the 4 integer points around the center: floor and ceil of cx, floor and ceil of cy.
                # This may miss some points when half > 0.5 (i.e., L > 1). But half max = (cosθ+sinθ)/2 ≤ (1+1)/2 = 1. So half up to 1.
                # So integer points within distance half may be up to 2 away. We'll check a 3x3 grid around nearest integer.
                i0 = np.floor(cxs).astype(int)
                j0 = np.floor(cys).astype(int)
                # We'll check points (i0 + di, j0 + dj) for di,dj in {-1,0,1}
                covered = np.zeros(N, dtype=bool)
                for di in (-1,0,1):
                    for dj in (-1,0,1):
                        i = i0 + di
                        j = j0 + dj
                        dx = i - cxs
                        dy = j - cys
                        u = dx * cos_t + dy * sin_t
                        v = -dx * sin_t + dy * cos_t
                        inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)
                        covered = covered | inside
                # uncovered if not covered
                uncovered = ~covered
                return uncovered.mean()
            
