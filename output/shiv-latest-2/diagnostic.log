            import math
            
            def triangle_angles(alpha):
                # alpha in radians
                b = 2*math.cos(alpha)
                # coordinates of R
                Rx = b*math.cos(alpha)
                Ry = b*math.sin(alpha)
                # side lengths
                a = math.hypot(Rx-1, Ry-0)  # QR
                c = 1.0  # PQ
                # b is PR length
                # compute angles using law of cosines
                # angle at P = alpha
                # angle at Q using law of cosines: cos β = (a^2 + c^2 - b^2)/(2*a*c)
                cos_beta = (a*a + c*c - b*b)/(2*a*c)
                beta = math.acos(cos_beta)
                # angle at R: γ = π - α - β
                gamma = math.pi - alpha - beta
                return alpha, beta, gamma
            
            candidates = [0.4487989505, 0.6283185307, 1.0471975512, 1.3463968515, 1.4660765717]
            for a in candidates:
                al, be, ga = triangle_angles(a)
                print(a, "deg:", math.degrees(al), math.degrees(be), math.degrees(ga))
            
