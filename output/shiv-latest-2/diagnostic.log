            import math, itertools, fractions, sys, random, time, functools, collections, itertools, math, sys, sympy as sp
            def R_of_tuple(t):
                S = sum(t)
                # compute denominator sum_i gcd(y_i, y_{i+1}) * lcm(y_{i+1}, y_{i+2})
                den = 0
                for i in range(6):
                    a = t[i]
                    b = t[(i+1)%6]
                    c = t[(i+2)%6]
                    g = math.gcd(a,b)
                    # lcm(b,c) = b*c//gcd(b,c)
                    l = b*c // math.gcd(b,c)
                    den += g * l
                return (S**3, den)  # numerator, denominator
            
