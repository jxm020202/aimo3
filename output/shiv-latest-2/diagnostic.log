                M, tM = intersect_line_with_segment(I_pt, v, D, E)
                N, tN = intersect_line_with_external_bisector(I_pt, v, D,E,F)
                # distances
                QM = abs(tM) * np.linalg.norm(v)
                QN = abs(tN) * np.linalg.norm(v)
                return QM/QN, tM, tN
            
