                        # For p such that a_{a_{a_p}} index equals i, we need to know LHS now? Hard.
                        # We'll just assign and continue.
                        vals.append(v)
                        # optional prune: if i>0 we can check condition for p=i-1 if all needed indices known.
                        p = i-1
                        if p >=0 and p <= N-1:
                            # need a_{a_{a_p}} known: need indices a_p, a_{a_p}
