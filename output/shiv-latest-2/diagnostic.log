            def excenter_opposite_vertex(A,B,C, opposite='A'):
                # A,B,C are points (tuples). opposite indicates which vertex excenter opposite to.
                # side lengths: a = BC opposite A, b = CA opposite B, c = AB opposite C
                A_pt = sp.Point(A); B_pt = sp.Point(B); C_pt = sp.Point(C)
                a = B_pt.distance(C_pt)
                b = C_pt.distance(A_pt)
                c = A_pt.distance(B_pt)
                if opposite == 'A':
                    # excenter opposite A: barycentric (-a : b : c)
                    num = (-a)*A_pt + b*B_pt + c*C_pt
                    den = -a + b + c
                elif opposite == 'B':
                    # (a : -b : c)
                    num = a*A_pt + (-b)*B_pt + c*C_pt
                    den = a - b + c
                elif opposite == 'C':
                    # (a : b : -c)
                    num = a*A_pt + b*B_pt + (-c)*C_pt
                    den = a + b - c
                else:
                    raise ValueError
                return sp.Point(num.x/den, num.y/den)
            
