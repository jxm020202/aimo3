            import random, math, numpy as np
            
            def angle_NMO(p,q,alpha,beta,theta):
                # coordinates
                w = np.array([-p, 0.0])
                y = np.array([ q, 0.0])
                v = np.array([math.cos(theta), math.sin(theta)])
                x = -alpha * v
                z =  beta * v
                # M is origin (0,0)
                # Midpoints
                m_WX = (w + x)/2.0
                m_YZ = (y + z)/2.0
                # Direction vectors
                d_WX = x - w
                d_YZ = z - y
                # Perpendicular direction vectors (rotate 90 deg)
                # For line L1: direction vector perpendicular to d_WX
                # We can solve intersection of two lines: each defined by point + t * perp(d)
                # But easier: compute line equations: (p - w) dot d = 0 where p is point on line.
                # We'll solve linear system for N = (nx, ny)
                # Equation: (N - m_WX)·d_WX = 0
                #           (N - m_YZ)·d_YZ = 0
                A = np.array([d_WX, d_YZ])
                b = np.array([np.dot(d_WX, m_WX), np.dot(d_YZ, m_YZ)])
                # Solve A N = b
                N = np.linalg.solve(A, b)
                # Similarly O: perpendicular bisectors of XY and WZ
                m_XY = (x + y)/2.0
                d_XY = y - x
                m_WZ = (w + z)/2.0
                d_WZ = z - w
                A2 = np.array([d_XY, d_WZ])
                b2 = np.array([np.dot(d_XY, m_XY), np.dot(d_WZ, m_WZ)])
                O = np.linalg.solve(A2, b2)
                # Compute angle between N and O vectors (both from origin)
                dot = np.dot(N, O)
                normN = np.linalg.norm(N)
                normO = np.linalg.norm(O)
                cosang = dot/(normN*normO)
                # Clip due to numerical errors
                cosang = max(min(cosang,1),-1)
                ang = math.degrees(math.acos(cosang))
                return ang, N, O
            
            def test_random():
                for _ in range(10):
                    p = random.uniform(1,5)
                    q = random.uniform(1,5)
                    # diagonal length L = p+q
                    L = p+q
                    # Choose alpha,beta positive with sum = L
                    alpha = random.uniform(0.5, L-0.5)
                    beta = L - alpha
                    theta = random.uniform(0.1, math.pi-0.1)
                    ang, N, O = angle_NMO(p,q,alpha,beta,theta)
                    print(p,q,alpha,beta,theta, ang)
            test_random()
            
