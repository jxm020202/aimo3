            import math
            
            def compute_polygon(theta, phi, k, e=1.0):
                d = math.cos(theta) + 2*k*math.sin(theta)
                P = (0.0, 0.0)
                Q = (1.0, 0.0)
                R = (d*math.cos(theta), d*math.sin(theta))
                S = (e*math.cos(theta+phi), e*math.sin(theta+phi))
                return [P, Q, R, S]
            
            def signed_area(poly):
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return area/2
            
