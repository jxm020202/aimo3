            from fractions import Fraction
            import math
            
            def find_det_parity(p,q):
                # find any integer solution for a,b,c,d with determinant +/-1
                # returns set of possible determinants
                # Solve 11a+3b = p
                # Use extended Euclid to find particular solution
                def particular_solution(A,B,C):
                    # solve A*x + B*y = C
                    # returns one solution (x0,y0)
                    g = math.gcd(A,B)
                    if C % g != 0:
                        return None
                    # use extended Euclid
                    def egcd(a,b):
                        if b==0:
                            return (1,0,a)
                        else:
                            x,y,g = egcd(b, a%b)
                            return (y, x - (a//b)*y, g)
                    x0,y0,g = egcd(A,B)
                    x0 *= C//g
                    y0 *= C//g
                    return (x0,y0)
                sol_ab = particular_solution(11,3,p)
                sol_cd = particular_solution(11,3,q)
                if sol_ab is None or sol_cd is None:
                    return set()
                a0,b0 = sol_ab
                c0,d0 = sol_cd
                # general solutions:
                # a = a0 + 3*t, b = b0 - 11*t
                # c = c0 + 3*s, d = d0 - 11*s
                dets = set()
                # search t,s within some range
                for t in range(-10,11):
                    a = a0 + 3*t
                    b = b0 - 11*t
                    for s in range(-10,11):
                        c = c0 + 3*s
                        d = d0 - 11*s
                        det = a*d - b*c
                        if abs(det) == 1:
                            dets.add(det)
                return dets
            
            targets = [(7,3),(11,4),(2024,5),(109,11),(3,71),(5,204)]
            for p,q in targets:
                dets = find_det_parity(p,q)
                print(p,q,dets)
            
