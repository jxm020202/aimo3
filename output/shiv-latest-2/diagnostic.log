            def max_zero_run_with_limit(n, limit=20000):
                # compute until we detect a repeat of the state of length n (tuple)
                # We'll store seen states in dict mapping tuple to index
                a = [pow(2, k, n) for k in range(n)]  # a[0..n-1] corresponds to a1..an
                # compute sliding sum
                s = sum(a) % n
                # track max run
                max_run = 0
                cur = 0
                # initial
                for val in a:
                    if val % n == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                # store state (last n terms) as tuple
                state = tuple(a[-n:])
                seen = {state: n-1}  # index of last element (k=n)
                # generate further
                k = n  # next index (0-based) corresponds to term a_{k+1}
                while True:
                    val = s
                    # update run
                    if val % n == 0:
                        cur += 1
                        max_run = max(max_run, cur)
