            def count_independent_sets_matrix(n):
                # generate valid rows
                valid_rows = [bits for bits in range(1<<n) if not (bits & (bits<<1))]
                m=len(valid_rows)
                # adjacency matrix: allowed transitions if no overlapping 1s
                import numpy as np
                A = np.zeros((m,m), dtype=object)  # use Python int for big numbers
                for i,cur in enumerate(valid_rows):
                    for j,prev in enumerate(valid_rows):
                        if cur & prev == 0:
                            A[i,j]=1
                # initial vector: all rows allowed
                v = np.ones((m,1), dtype=object)
                # multiply A^(n-1) * v
                if n==1:
                    return int(v.sum())
                else:
                    # exponentiate
                    def mat_pow(mat, power):
                        result = np.identity(mat.shape[0], dtype=object)
                        base = mat.copy()
                        while power>0:
                            if power%2==1:
                                result = result @ base
                            base = base @ base
                            power//=2
                        return result
                    M = mat_pow(A, n-1)
                    final = M @ v
                    return int(final.sum())
