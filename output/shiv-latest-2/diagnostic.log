            def angle_between(p,q):
                dot = p[0]*q[0] + p[1]*q[1]
                normp = math.hypot(p[0], p[1])
                normq = math.hypot(q[0], q[1])
                cos = dot/(normp*normq)
                cos = max(-1,min(1,cos))
                return math.degrees(math.acos(cos))
            
