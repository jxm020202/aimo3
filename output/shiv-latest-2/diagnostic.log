            import itertools
            
            def generate_configs(n):
                # n is board size (even), we consider blocks of size 2x2
                # positions are (i,j) 0-indexed
                blocks = []
                for bi in range(0, n, 2):
                    for bj in range(0, n, 2):
                        # block cells
                        cells = [(bi, bj), (bi, bj+1), (bi+1, bj), (bi+1, bj+1)]
                        blocks.append(cells)
                configs = []
                # each block can be empty or one of its 4 cells
                # generate all combos
                # but we need at least 2 selected cells overall
                for choices in itertools.product(range(5), repeat=len(blocks)):
                    # 0 means empty, 1-4 means which cell in block
                    selected = []
                    for block_idx, choice in enumerate(choices):
                        if choice == 0:
                            continue
                        cell = blocks[block_idx][choice-1]
                        selected.append(cell)
                    if len(selected) >= 2:
                        configs.append(set(selected))
                return configs
            
            def min_separating_set(n):
                configs = generate_configs(n)
                cells = [(i,j) for i in range(n) for j in range(n)]
                # precompute pattern for each config for each cell
                # pattern is 1 if cell in config else 0
                # we need subset Q such that for any two configs, pattern on Q differs
                # brute force search increasing size
                for size in range(1, len(cells)+1):
                    for Q in itertools.combinations(cells, size):
                        # compute signatures
                        sigs = {}
                        ok = True
                        for idx, cfg in enumerate(configs):
                            sig = tuple(1 if cell in cfg else 0 for cell in Q)
                            if sig in sigs:
                                ok = False
                                break
                            sigs[sig] = idx
                        if ok:
                            return size, Q
                return None
            
            print(min_separating_set(4))
            
