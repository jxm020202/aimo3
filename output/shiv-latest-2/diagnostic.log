                    # Determine if all edges for vertex v are assigned:
                    ok = True
                    for v in range(4):
                        # edges incident to v:
                        incident = [(min(v,w), max(v,w)) for w in range(4) if w!=v]
                        assigned_vals = []
                        all_assigned = True
                        for e in incident:
                            if e in assign:
