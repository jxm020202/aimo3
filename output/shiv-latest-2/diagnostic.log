                # Use extended Euclid to find one solution to 11a + 3b = p*s.
                # Solve 11a + 3b = RHS.
                def particular_solution(R):
                    # find a0,b0 such that 11 a0 + 3 b0 = R
                    # Use extended Euclid: 11*? + 3*? = 1 => 11*? + 3*? = 1
                    # Compute using egcd
                    from math import gcd
                    # compute inverse of 11 mod 3 or 3 mod 11
                    # Since 11 mod 3 = 2, we can solve.
                    # We'll use sympy's diophantine? Let's just brute small.
                    for a0 in range(-abs(R)-5, abs(R)+5):
                        if (R - 11*a0) % 3 == 0:
                            b0 = (R - 11*a0)//3
                            return a0,b0
                    return None
            
                # Actually we can compute using extended Euclid: 11*? + 3*? = gcd(11,3)=1.
                # Use egcd to get u,v such that 11*u + 3*v = 1.
                def egcd(a,b):
                    if b==0:
                        return (1,0,a)
                    x,y,g = egcd(b, a%b)
                    return (y, x - (a//b)*y, g)
                u,v,g = egcd(11,3)
                # u*11 + v*3 = 1
                # Then multiply by R: a0 = u*R, b0 = v*R is a particular solution.
                # But might be large; okay.
