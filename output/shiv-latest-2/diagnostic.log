            def interior_angle(prev, vertex, nxt):
                # angle between vectors vertex->prev and vertex->nxt inside polygon (assuming ccw)
                v1 = sp.Matrix([prev.x-vertex.x, prev.y-vertex.y])
                v2 = sp.Matrix([nxt.x-vertex.x, nxt.y-vertex.y])
                # compute angle using dot product
                dot = v1.dot(v2)
                norm1 = sp.sqrt(v1.dot(v1))
