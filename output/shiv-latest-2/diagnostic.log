            def O_correct(u,v,p,q):
                # Intersection of perp bisectors of XY and WZ
                # XY: endpoints X(1,0), Y(u,v)
                # WZ: endpoints W(0,0), Z(p,q)
                # Midpoints
                Mxy = np.array([(1+u)/2.0, v/2.0])
                dxy = np.array([u-1, v-0])  # vector X->Y
                perp_xy = np.array([-dxy[1], dxy[0]])  # perpendicular
                Mwz = np.array([p/2.0, q/2.0])
                dwz = np.array([p-0, q-0])  # vector W->Z
                perp_wz = np.array([-dwz[1], dwz[0]])
                # Solve Mxy + a*perp_xy = Mwz + b*perp_wz
                A = np.column_stack((perp_xy, -perp_wz))
                try:
                    a,b = np.linalg.solve(A, Mwz - Mxy)
                except np.linalg.LinAlgError:
                    return None
                O = Mxy + a*perp_xy
                return O
            
