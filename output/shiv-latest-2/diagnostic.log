            def is_convex(points):
                n = len(points)
                sign = None
                for i in range(n):
                    p0 = sp.Point(points[i])
                    p1 = sp.Point(points[(i+1)%n])
                    p2 = sp.Point(points[(i+2)%n])
                    # compute cross product (p1-p0) x (p2-p1)
                    v1 = sp.Matrix([p1.x-p0.x, p1.y-p0.y])
                    v2 = sp.Matrix([p2.x-p1.x, p2.y-p1.y])
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    cross = sp.simplify(cross)
                    if cross == 0:
                        continue
                    cur_sign = sp.sign(cross)
                    if sign is None:
                        sign = cur_sign
