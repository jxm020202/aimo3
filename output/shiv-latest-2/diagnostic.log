            import random, math, itertools, sys, time, numpy as np
            
            def sum_a(angles, sector_deg=100):
                n = len(angles)
                sector = math.radians(sector_deg)
                # convert angles to coordinates
                pts = [(math.cos(a), math.sin(a)) for a in angles]
                total = 0
                for i in range(n):
                    xi, yi = pts[i]
                    dir_angles = []
                    for j in range(n):
                        if i==j: continue
                        xj, yj = pts[j]
                        dx, dy = xj - xi, yj - yi
                        ang = math.atan2(dy, dx)  # range -pi..pi
                        dir_angles.append(ang)
                    # sort angles
                    dir_angles.sort()
                    m = len(dir_angles)
                    # duplicate with +2π for circular wrap
                    extended = dir_angles + [a + 2*math.pi for a in dir_angles]
                    # sliding window
                    best = 0
                    left = 0
                    for right in range(len(extended)):
                        while extended[right] - extended[left] > sector + 1e-12:
                            left += 1
                        # count points in window = right-left+1
                        cnt = right - left + 1
                        if cnt > best:
                            best = cnt
                    total += best
                return total
            
            def random_angles(n):
                # generate n distinct angles uniformly random
                return sorted([random.random()*2*math.pi for _ in range(n)])
            
            def test_random(n, trials=1000):
                best = 0
                best_conf = None
                for _ in range(trials):
                    ang = random_angles(n)
                    s = sum_a(ang)
                    if s > best:
                        best = s
                        best_conf = ang
                return best, best_conf
            
            print(test_random(10, 200))
            
