            def check_xy_real(x_frac, y_frac, tol=1e-10):
                x_val = float(x_frac)
                y_val = float(y_frac)
                if 1 - 2*x_val < -1e-12 or 1 - 2*y_val < -1e-12:
                    return False
                lhs = 1 + math.sqrt(1 - 2*y_val)
                term = (4*x_val - 2 + 2*math.sqrt(1 - 2*x_val)) / (3 - 5*x_val - math.sqrt(1 - 2*x_val))
                inner = 9*x_val**4 + (4*x_val**6)/3 + 9 + 18*x_val**2
                B = math.sqrt(inner)/6
                A = (1 + x_val**2)/2
                cuberoot_sum = real_cuberoot(A + B) + real_cuberoot(A - B)
                rhs = y_val + term + cuberoot_sum
