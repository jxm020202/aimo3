            import math
            
            def order_mod(a, n):
                # compute multiplicative order of a modulo n, assuming gcd(a,n)=1
                # naive: find smallest k such that a**k % n == 1
                # use pow with modulo
                if math.gcd(a, n) != 1:
                    return None
                # compute phi(n) to bound
                phi = sympy.totient(n)
                # find divisors of phi and test
