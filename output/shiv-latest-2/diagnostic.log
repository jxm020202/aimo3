            import math
            
            def compute_xy(p_frac):
                p = Fraction(p_frac)
                # compute rational expressions using Fraction arithmetic
                # x_plus
                num_xp = 8 * p * (-p**2 + 2*p + 1)
                den_xp = p**4 - 12*p**3 + 34*p**2 + 12*p + 1
                # x_minus
                num_xm = 8 * p * (p**2 + 2*p - 1)
                den_xm = p**4 + 12*p**3 + 34*p**2 - 12*p + 1
                # y
                num_y = 4 * p**2 * (1 - p**2)
                den_y = p**4 + 2*p**2 + 1
                # return as Fractions if denominator non-zero
                xy = {}
                if den_xp != 0:
                    xy['x_plus'] = Fraction(num_xp, den_xp)
                else:
                    xy['x_plus'] = None
                if den_xm != 0:
                    xy['x_minus'] = Fraction(num_xm, den_xm)
                else:
                    xy['x_minus'] = None
                if den_y != 0:
                    xy['y'] = Fraction(num_y, den_y)
                else:
