            def find_solutions(N, V):
                max_idx = max(N, V) + 5  # extra buffer
                a = [None]*(max_idx+1)
                solutions=[]
                def dfs(p):
                    if p == N:
                        # record first N+1 values (0..N)
                        solutions.append(a[:N+1])
                        return
                    # ensure a[p] defined
                    if a[p] is None:
                        for val in range(V+1):
                            a[p]=val
                            dfs(p)
                            a[p]=None
                        return
                    ap = a[p]
                    if ap > max_idx:
                        return
                    # ensure a[ap] defined
                    if a[ap] is None:
                        for val in range(V+1):
                            a[ap]=val
                            dfs(p)
                            a[ap]=None
                        return
                    aap = a[ap]
                    if aap > max_idx:
                        return
                    # ensure a[aap] defined
                    if a[aap] is None:
                        for val in range(V+1):
                            a[aap]=val
                            dfs(p)
                            a[aap]=None
                        return
                    # compute rhs
                    rhs = a[aap] - 1
                    if rhs < 0 or rhs > V:
                        return
                    # set a[p+1]
                    if a[p+1] is None:
                        a[p+1]=rhs
                        dfs(p+1)
                        a[p+1]=None
                    else:
                        if a[p+1]==rhs:
                            dfs(p+1)
                        else:
                            return
                dfs(0)
