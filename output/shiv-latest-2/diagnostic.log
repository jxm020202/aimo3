            import math
            from math import gcd
            
            def find_solutions(limit):
                sols=[]
                for n in range(1,limit+1):
                    for m in range(1,n):
                        if math.gcd(m,n)!=1:
                            continue
                        A = n*n + 6*m*n - 3*m*m
                        B = 5*m*m - 2*m*n + n*n
                        if B==0:
                            continue
                        # need A/B positive? Since a in (0,1), compute F maybe positive.
                        # check positivity
                        if A*B <=0:
                            continue
                        g = math.gcd(A,B)
                        A_red = A//g
                        B_red = B//g
                        # check perfect squares
                        if int(math.isqrt(A_red))**2 == A_red and int(math.isqrt(B_red))**2 == B_red:
                            # compute a,m/n
                            a = sp.Rational(m,n)
                            # compute t = sqrt(F) = sqrt(A/B) = sqrt(A_red/B_red) = sqrt(A_red)/sqrt(B_red)
                            t = sp.sqrt(A_red)/sp.sqrt(B_red)  # rational
                            # compute b = -1 + t
                            b = -1 + t
                            # compute x,y
                            x = (1 - a**2)/2
                            y = (1 - b**2)/2
                            # ensure x,y positive rational
                            if x>0 and y>0:
                                # compute denominators
                                x_num, x_den = sp.fraction(x)
                                y_num, y_den = sp.fraction(y)
                                # compute minimal k = lcm of denominators
                                from math import lcm
                                k = lcm(int(x_den), int(y_den))
                                sols.append((k,m,n,a,b,x,y))
                return sols
            
            sols = find_solutions(30)
            len(sols)
            
