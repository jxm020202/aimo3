            import math, random
            
            def random_points(n, radius=1.0):
                pts = []
                for _ in range(n):
                    r = radius * math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def sum_a(points, angle_deg=100):
                n = len(points)
                max_angle = math.radians(angle_deg)
                total = 0
                for i in range(n):
                    xi, yi = points[i]
                    angles = []
                    for j in range(n):
                        if i == j: continue
                        xj, yj = points[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        if ang < 0:
                            ang += 2*math.pi
                        angles.append(ang)
                    angles.sort()
                    angles2 = angles + [a+2*math.pi for a in angles]
                    best = 0
                    left = 0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > max_angle + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > best:
                            best = cnt
                    total += best
                return total
            
            def random_optimize(n, steps=3000, radius=1.0):
                pts = random_points(n, radius=radius)
                best = sum_a(pts)
                best_pts = pts[:]
                for _ in range(steps):
                    i = random.randrange(n)
                    angle = random.random()*2*math.pi
                    r = math.sqrt(random.random())*radius
                    new_pt = (r*math.cos(angle), r*math.sin(angle))
                    old_pt = pts[i]
                    pts[i] = new_pt
                    s = sum_a(pts)
                    if s > best:
                        best = s
                        best_pts = pts[:]
                    else:
                        pts[i] = old_pt
                return best, best_pts
            
