            def N_analytic(u,v,p,q):
                # compute n using derived formula
                if abs(q - v) < 1e-12:
                    return None
                n = (v+q)/2 - (p - u)*(1 - u - p) / (2*(q - v))
                return np.array([0.5, n])
            
            def O_analytic(u,v,p,q):
                # Solve linear equations for O
                # eq1: (u-1)*(2x - (1+u)) + v*(2y - v) = 0
                # eq2: p*(2x - p) + q*(2y - q) = 0
                # Solve for x,y
                x,y = sp.symbols('x y')
                eq1 = sp.Eq((u-1)*(2*x - (1+u)) + v*(2*y - v), 0)
                eq2 = sp.Eq(p*(2*x - p) + q*(2*y - q), 0)
                sol = sp.solve((eq1, eq2), (x, y), dict=True)[0]
                return np.array([float(sol[x]), float(sol[y])]
            
            def M_point(u,v,p,q):
                # intersection of lines WY and XZ
                # Solve t*u = 1 + s*(p-1), t*v = s*q
                # Solve linear equations
                A = np.array([[u, -(p-1)], [v, -q]], dtype=float)
                b = np.array([1.0, 0.0])
                t,s = np.linalg.solve(A, b)
                return np.array([t*u, t*v])
            
            def angle_NMO(u,v,p,q):
                N = N_analytic(u,v,p,q)
                O = O_analytic(u,v,p,q)
                M = M_point(u,v,p,q)
                if N is None or O is None:
                    return None
                v1 = N - M
                v2 = O - M
                dot = np.dot(v1, v2)
                ang = math.degrees(math.acos(dot/(np.linalg.norm(v1)*np.linalg.norm(v2))))
                return ang, dot
            
            # test random example
