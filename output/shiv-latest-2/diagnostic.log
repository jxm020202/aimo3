            from fractions import Fraction
            def compute_solution(t_val):
                t = Fraction(t_val)
                # compute u
                denom_u = 3*(t*t - 40)
                if denom_u == 0:
                    return None
                u = Fraction(t*t - 16*t - 8, denom_u)
                # compute v candidates
                denom_v = t*t - 4*t + 40
                if denom_v == 0:
                    return None
                v1 = Fraction(3*(-t*t + 4*t + 8), denom_v)
                v2 = Fraction(t*t - 4*t - 104, denom_v)
                # check each
                solutions = []
                for v in (v1, v2):
                    # conditions: 0 <= u < 1, 0 <= v < 1
                    if not (0 <= u < 1):
                        continue
                    if not (0 <= v < 1):
                        continue
                    # compute x,y
                    x = Fraction(1 - u*u, 2)
                    y = Fraction(1 - v*v, 2)
                    if x <= 0 or y <= 0:
