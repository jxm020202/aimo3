            def min_L_AB_eq_BC(grid_n=401):
                best = 1e9
                best_params = None
                for ti in range(1, grid_n):  # t from small to 1
                    t = ti / (grid_n-1)
                    # c range 0 to sqrt(3)
                    for ci in range(grid_n):
