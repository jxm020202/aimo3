            def real_cuberoot(z):
                # assume z is real (mp.mpf) possibly negative
                if isinstance(z, mp.mpc):
                    # if complex, use real part? Not needed
                    raise ValueError('Complex input')
                if z >= 0:
                    return z ** (mp.mpf(1)/3)
                else:
                    return -((-z) ** (mp.mpf(1)/3))
            
            def G_of_x_real(x):
                s = mp.sqrt(1 - 2*x)
                term1 = (4*x - 2 + 2*s) / (3 - 5*x - s)
                A = (1 + x**2) / 2
                B = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2) / 6
                c1 = real_cuberoot(A + B)
                c2 = real_cuberoot(A - B)
                term2 = c1 + c2
                return term1 + term2
            
