            import mpmath as mp
            
            def f_val(x):
                sqrt1 = mp.sqrt(1 - 2*x)
                frac = (4*x - 2 + 2*sqrt1) / (3 - 5*x - sqrt1)
                # compute cube roots: use real cube root
                A = (1 + x**2)/2
                B = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2) / 6
                # real cube root: mp.sign? Use mp.nthroot? mp.sign?
                # Use mp.sign to handle negative values
                def real_cuberoot(z):
                    return mp.sign(z) * abs(z)**(1/3)
                cube_sum = real_cuberoot(A + B) + real_cuberoot(A - B)
                return frac + cube_sum
            
