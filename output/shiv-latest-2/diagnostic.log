                seqs = []
                # We'll generate recursively.
                def backtrack(seq):
                    i = len(seq)  # next index to assign
                    if i > N:
                        # we have assigned up to N, but need to check all constraints p=0..N-1 that involve indices up to maybe beyond N.
                        # For any p where a_{a_{a_p}} index > N, we cannot verify. So we need to ensure that for all p <= N-1, a_{a_{a_p}} <= N.
                        # For simplicity, we restrict to sequences where all such indices <= N.
                        # Check constraints:
                        for p in range(N):
                            idx = seq[seq[seq[p]]]
                            if idx > N:
                                return
                            if seq[idx] != seq[p+1] + 1:
                                return
                        seqs.append(seq[:])
                        return
                    # assign value for a_i
                    for val in range(max_val+1):
                        # quick prune: if i>0, we may have constraints where p = i-1 involves a_{i} as RHS: a_{a_{a_{i-1}}} = a_i + 1
                        # but a_{a_{a_{i-1}}} may not be known yet if its index > i. So cannot prune much.
                        seq.append(val)
                        # early check for any p < i such that all needed indices are assigned and constraint fails.
                        ok = True
                        for p in range(i):  # constraints up to p where RHS index p+1 <= i
                            if p+1 > i: continue
                            # need a_{a_{a_p}} index <= i to evaluate
                            # compute indices if possible
                            # need a_p, a_{a_p}, a_{a_{a_p}}
                            if seq[p] <= i and seq[seq[p]] <= i and seq[seq[seq[p]]] <= i:
                                # all indices known
                                if seq[seq[seq[p]]] != seq[p+1] + 1:
                                    ok = False
                                    break
                        if ok:
                            backtrack(seq)
                        seq.pop()
                backtrack([])
                return seqs
            
