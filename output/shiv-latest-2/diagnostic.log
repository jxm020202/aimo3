            cos_angle1 = angle_cos(ZP, ZY)
            eq1 = sp.Eq(cos_angle1, sp.cos(20*deg))
            
            # angle QPZ = 40°
            PQ = Q - P
            PZ = Z - P
            cos_angle2 = angle_cos(PQ, PZ)
