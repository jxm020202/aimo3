            def covered_fraction(theta, N=200000):
                # Monte Carlo estimate of A(theta)
                # Sample points uniformly in [0,1)^2 and test if covered by rotated square
                # Use center reference: square centered at integer points; condition: exists integer shift such that point is within rotated square centered at that integer.
                # Equivalent to checking point relative to nearest integer lattice points.
                # We'll test the four possible shifts as discussed.
                cos = math.cos(theta)
                sin = math.sin(theta)
                # rotation matrix columns: e1' = (cos, sin), e2' = (-sin, cos) ??? Actually rotation matrix for angle theta:
                # R = [[cos, -sin],[sin, cos]]
                # The square's local axes are e1' = (cos, sin) (the image of (1,0) after rotation)
                # e2' = (-sin, cos) (image of (0,1)).
                # For a point p relative to center c, condition: |(p-c)·e1'| <= 0.5 and |(p-c)·e2'| <= 0.5.
                # We'll implement a function to test if a point (x,y) is inside a rotated square centered at (cx,cy).
                def inside_rotated_square(px, py, cx, cy):
                    dx = px - cx
                    dy = py - cy
                    # compute dot products
                    d1 = dx*cos + dy*sin  # dot with e1'
                    d2 = -dx*sin + dy*cos  # dot with e2'
                    return abs(d1) <= 0.5 + 1e-12 and abs(d2) <= 0.5 + 1e-12
                count = 0
                for _ in range(N):
                    x = random.random()
                    y = random.random()
                    # check four integer centers: (0,0), (-1,0), (0,-1), (-1,-1)
                    if (inside_rotated_square(x, y, 0, 0) or
                        inside_rotated_square(x, y, -1, 0) or
                        inside_rotated_square(x, y, 0, -1) or
                        inside_rotated_square(x, y, -1, -1)):
                        count += 1
                return count / N
            
            def estimate_p(num_theta=200, samples_per_theta=20000):
                # integrate over theta using simple trapezoidal rule
                thetas = np.linspace(0, math.pi/2, num_theta)
