            import math, random, numpy as np
            
            def circumcenter(A,B,C):
                Ax,Ay=A; Bx,By=B; Cx,Cy=C
                D = ((Ax+Bx)/2, (Ay+By)/2)
                E = ((Ax+Cx)/2, (Ay+Cy)/2)
                vAB = (Bx-Ax, By-Ay)
                vAC = (Cx-Ax, Cy-Ay)
                perpAB = (-vAB[1], vAB[0])
                perpAC = (-vAC[1], vAC[0])
                M = np.array([[perpAB[0], -perpAC[0]],
                              [perpAB[1], -perpAC[1]]], dtype=float)
                b = np.array([E[0]-D[0], E[1]-D[1]], dtype=float)
                s,t = np.linalg.solve(M,b)
                center = (D[0] + s*perpAB[0], D[1] + s*perpAB[1])
                return center
            
            def incenter(A,B,C):
                a = math.hypot(B[0]-C[0], B[1]-C[1])
                b = math.hypot(A[0]-C[0], A[1]-C[1])
                c = math.hypot(A[0]-B[0], A[1]-B[1])
                px = (a*A[0] + b*B[0] + c*C[0])/(a+b+c)
                py = (a*A[1] + b*B[1] + c*C[1])/(a+b+c)
                return (px,py)
            
            def line_through(p1,p2):
                x1,y1=p1; x2,y2=p2
                A=y1-y2; B=x2-x1; C=x1*y2 - x2*y1
                return (A,B,C)
            
            def intersect_lines(L1,L2):
                A1,B1,C1=L1; A2,B2,C2=L2
                det=A1*B2 - A2*B1
                if abs(det)<1e-12:
                    return None
                x=(B1*C2 - B2*C1)/det
                y=(C1*A2 - C2*A1)/det
                return (x,y)
            
            def check_perpendicular():
                for i in range(5):
                    while True:
                        D = (random.uniform(-5,5), random.uniform(-5,5))
                        E = (random.uniform(-5,5), random.uniform(-5,5))
                        F = (random.uniform(-5,5), random.uniform(-5,5))
                        area = (E[0]-D[0])*(F[1]-D[1]) - (E[1]-D[1])*(F[0]-D[0])
                        if abs(area)>1e-3:
