            def max_side(t,b,c):
                # coordinates
                A = np.array([t, math.sqrt(3)*(1 - t)])
                B = np.array([b, 0.0])
                C = np.array([0.0, c])
                # distances
                AB = np.linalg.norm(A - B)
                BC = np.linalg.norm(B - C)
                CA = np.linalg.norm(C - A)
                return max(AB, BC, CA)
            
