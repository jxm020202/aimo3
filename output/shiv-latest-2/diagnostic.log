            def max_zero_run(n, max_terms=100000):
                # compute sequence modulo n
                a = [pow(2, k, n) for k in range(n)]  # a[0]=a1=2^0, a[1]=2^1,... a[n-1]=2^{n-1}
                # Actually a_k = 2^{k-1} for k=1..n, so a[0]=1, a[1]=2, etc.
                # Already correct: pow(2, k, n) for k=0..n-1
                # Now compute further terms up to max_terms
                # We'll store modulo values only
                max_run = 0
                current = 0
                # Check initial terms for zero runs
                for val in a:
                    if val % n == 0:
                        current += 1
                        max_run = max(max_run, current)
                    else:
                        current = 0
                # Now compute further terms
                # Use sliding window sum modulo n
                from collections import deque
                window = deque(a, maxlen=n)
                sum_window = sum(window) % n
                for k in range(n, max_terms):
                    # a_k = sum of previous n terms modulo n
                    next_val = sum_window % n
                    # update max run
                    if next_val == 0:
                        current += 1
                        max_run = max(max_run, current)
                    else:
                        current = 0
                    # update sliding window
                    # remove oldest
                    oldest = window.popleft()
                    sum_window = (sum_window - oldest) % n
                    # add new
                    window.append(next_val)
                    sum_window = (sum_window + next_val) % n
                return max_run
            
