            import random, math, numpy as np
            
            def circumcenter(A,B,C):
                # returns circumcenter coordinates
                # using perpendicular bisectors
                D = np.array(A)
                E = np.array(B)
                F = np.array(C)
                # compute using formula
                a = np.linalg.norm(E-F)
                b = np.linalg.norm(F-D)
                c = np.linalg.norm(D-E)
                # barycentric coordinates for circumcenter: a^2*(B+C-A)?? Not.
                # Use linear algebra: solve for center O such that |O-A|^2 = |O-B|^2 = |O-C|^2
                # Solve (O-A).(A-B) = (|A|^2 - |B|^2)/2 etc.
                # We'll solve using np.linalg
                # Set up equations: (O - A)·(B - A) = (|B|^2 - |A|^2)/2
                # (O - A)·(C - A) = (|C|^2 - |A|^2)/2
                A = np.array(A); B = np.array(B); C = np.array(C)
                BA = B - A
                CA = C - A
                rhs1 = (np.dot(B,B) - np.dot(A,A))/2.0
                rhs2 = (np.dot(C,C) - np.dot(A,A))/2.0
                M = np.column_stack((BA, CA))
                # Solve M^T O = rhs? Actually (O·BA) = rhs1 + A·BA? Wait:
                # (O - A)·BA = rhs1 => O·BA = rhs1 + A·BA
                # similarly O·CA = rhs2 + A·CA
                rhs_vec = np.array([rhs1 + np.dot(A, BA), rhs2 + np.dot(A, CA)])
                # Solve linear system M^T O = rhs_vec
                O = np.linalg.solve(M.T, rhs_vec)
                return O
            
            def incenter(A,B,C):
                # using side lengths
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*np.array(A) + b*np.array(B) + c*np.array(C)) / (a+b+c)
                return I
            
            def external_angle_bisector_at_C(A,B,C):
                # returns line direction vector for external bisector at C
                # internal bisector direction is normalized sum of unit vectors along CA and CB.
                # external bisector direction is normalized difference of those unit vectors.
                # Actually external bisector is line that bisects the external angle at C, i.e., angle between extensions of CA and CB.
                # Direction vector can be unit vector along (u - v) where u = unit vector from C to A, v = unit vector from C to B.
                u = (np.array(A)-np.array(C))
                v = (np.array(B)-np.array(C))
                u_norm = u/np.linalg.norm(u)
                v_norm = v/np.linalg.norm(v)
                # external bisector direction is u_norm - v_norm (or v_norm - u_norm) whichever.
                dir_vec = u_norm - v_norm
                # Ensure not zero
                return dir_vec
            
            def line_intersection(p1, d1, p2, d2):
                # lines p1 + t d1, p2 + s d2. Solve for intersection (if not parallel)
                # Solve p1 + t d1 = p2 + s d2 => t d1 - s d2 = p2 - p1
                # 2 equations, 2 unknowns.
                A = np.column_stack((d1, -d2))
                b = np.array(p2) - np.array(p1)
                # Solve for t,s
                try:
                    ts = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    return None
                t = ts[0]
                # intersection point
                return p1 + t*d1
            
            def compute_ratio(A,B,C):
                O = circumcenter(A,B,C)
                I = incenter(A,B,C)
                # line through I perpendicular to OI
                dir_perp = np.array([-(O[1]-I[1]), O[0]-I[0]])  # rotate OI by 90 deg
                # intersection with side AB (DE)
                M = line_intersection(I, dir_perp, np.array(A), np.array(B)-np.array(A))
                # external bisector at C
                dir_ext = external_angle_bisector_at_C(A,B,C)
                N = line_intersection(I, dir_perp, np.array(C), dir_ext)
                if M is None or N is None:
                    return None
                QM = np.linalg.norm(M - I)
                QN = np.linalg.norm(N - I)
                return QM/QN
            
            def random_triangle():
                # generate non-degenerate triangle
                while True:
                    A = np.random.rand(2)*10
                    B = np.random.rand(2)*10
