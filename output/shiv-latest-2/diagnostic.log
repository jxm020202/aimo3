            def objective(vars):
                # vars = [phi, theta, u, v, d]
                phi, theta, u, v, d = vars
                # enforce bounds inside constraints
                # compute x1,y1,z1
                x1 = math.sin(phi)*math.cos(theta)
                y1 = math.sin(phi)*math.sin(theta)
                z1 = math.cos(phi)
                # compute x2,y2,z2
                x2 = 2*u
                y2 = 4*v
                w = 1 - u - v
                if w < 0:
                    # penalty large
                    return 1e6 + d
                z2 = 6*w
                # we want minimize d, but constraints will enforce d >= differences
                return d
            
            def cons_f(vars):
                phi, theta, u, v, d = vars
                x1 = math.sin(phi)*math.cos(theta)
                y1 = math.sin(phi)*math.sin(theta)
                z1 = math.cos(phi)
                x2 = 2*u
                y2 = 4*v
                w = 1 - u - v
                z2 = 6*w
                # constraints: x2 - x1 - d <= 0, -(x2 - x1) - d <=0, etc.
                return [
                    d - (x2 - x1),   # d >= x2 - x1
                    d + (x2 - x1),   # d >= -(x2 - x1)
                    d - (y2 - y1),
                    d + (y2 - y1),
                    d - (z2 - z1),
                    d + (z2 - z1),
                    # positivity constraints: u>0, v>0, w>0, phi in [0, pi/2], theta in [0, pi/2]
                    u, v, w,
                    # also phi>=0, phi<=pi/2, theta>=0, theta<=pi/2
                    phi, (math.pi/2 - phi),
                    theta, (math.pi/2 - theta)
