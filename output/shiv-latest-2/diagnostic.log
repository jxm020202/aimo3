            def test_midpoint_I_Ia(D,E,F):
                D,E,F = sp.Point(D), sp.Point(E), sp.Point(F)
                # compute I (incenter), O (circumcenter)
                tri = sp.geometry.Triangle(D,E,F)
                I = tri.incenter
                O = tri.circumcenter
                # line through I perpendicular to OI
                v = sp.Matrix([I.x - O.x, I.y - O.y])
                v_perp = sp.Matrix([-v[1], v[0]])
                L = sp.Line(I, I + sp.Point(v_perp[0], v_perp[1]))
                # external bisector at A (F)
                u1 = sp.Matrix([D.x - F.x, D.y - F.y])
                u2 = sp.Matrix([E.x - F.x, E.y - F.y])
                n1 = sp.sqrt(u1.dot(u1))
                n2 = sp.sqrt(u2.dot(u2))
                v_ext = u1/n1 - u2/n2
                line_ext = sp.Line(F, F + sp.Point(v_ext[0], v_ext[1]))
                N = L.intersection(line_ext)[0]
                # excenter opposite A (F)
                a = E.distance(F)
                b = D.distance(F)
                c = D.distance(E)
                I_A = sp.Point((a*D.x + b*E.x - c*F.x)/(a + b - c),
                               (a*D.y + b*E.y - c*F.y)/(a + b - c))
                # midpoint of I and I_A
                mid = sp.Point((I.x + I_A.x)/2, (I.y + I_A.y)/2)
                # distance between N and midpoint
                return sp.simplify(N.distance(mid)), N, I_A, I
            
