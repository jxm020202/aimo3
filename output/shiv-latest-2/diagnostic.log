            def polygon_intersection(poly1, poly2):
                # Sutherland–Hodgman polygon clipping: clip poly1 by each edge of poly2
                def inside(p, edge_start, edge_end):
                    # edge defines half-plane to the left of edge (assuming poly2 vertices are CCW)
                    x, y = p
