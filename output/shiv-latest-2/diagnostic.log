            import itertools
            
            def count_independent_sets(n=18):
                # precompute valid row masks: no adjacent bits
                valid_masks = []
                for mask in range(1<<n):
                    if mask & (mask<<1):
                        continue
                    valid_masks.append(mask)
                # precompute compatibility: two masks are compatible if no bits are within distance 1 vertically/diagonally
                # i.e., for any bit in mask1 at column c, mask2 cannot have bits at c-1, c, c+1
                compat = {}
                for m1 in valid_masks:
                    compat[m1] = []
                    for m2 in valid_masks:
                        # check no vertical adjacency: m1 & m2 == 0 (same column)
                        # check diagonal adjacency: (m1<<1) & m2 ==0 and (m1>>1) & m2 ==0
                        if (m1 & m2) != 0:
                            continue
                        if ((m1<<1) & m2) != 0:
                            continue
                        if ((m1>>1) & m2) != 0:
                            continue
                        compat[m1].append(m2)
                # DP
                from collections import defaultdict
                dp = defaultdict(int)
                # first row
                for m in valid_masks:
                    dp[m] = 1
                for row in range(1, n):
                    newdp = defaultdict(int)
                    for prev_mask, cnt in dp.items():
                        for cur_mask in compat[prev_mask]:
                            newdp[cur_mask] += cnt
                    dp = newdp
                total = sum(dp.values())
                return total
            
            total = count_independent_sets(18)
            total
            
