            import mpmath as mp
            
            def equation(theta):
                # theta in radians
                yA = (1 - 2*mp.cos(theta)**2) / (2*mp.sin(theta))
                yB = (mp.cos(theta)*mp.sin(theta)) / (mp.cos(theta) + 1)
                R2 = mp.cos(theta)**2 + yB**2
                R = mp.sqrt(R2)
                r = yA
                return (yB - yA)**2 - R*(R - 2*r)
            
            # Find roots in (0, pi/2)
            roots = []
            for guess in [i*0.1 for i in range(1,15)]:
                try:
                    root = mp.findroot(equation, guess)
                    if 0 < root < mp.pi/2:
                        # round to tolerance
                        root_rounded = round(root, 10)
                        if all(abs(root_rounded - r) > 1e-6 for r in roots):
                            roots.append(root_rounded)
                except Exception as e:
                    pass
            
            roots
            
