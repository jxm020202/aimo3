            from functools import lru_cache
            
            def independent_sets_n(n):
                # generate all independent sets (king adjacency) for n x n board
                # using DP similar to earlier but also collect sets
                valid_masks = []
                for mask in range(1<<n):
                    if mask & (mask<<1):
                        continue
                    valid_masks.append(mask)
                compat = {}
                for m1 in valid_masks:
                    compat[m1] = []
                    for m2 in valid_masks:
                        if (m1 & m2) != 0:
                            continue
                        if ((m1<<1) & m2) != 0:
                            continue
                        if ((m1>>1) & m2) != 0:
                            continue
                        compat[m1].append(m2)
                # DP to generate sets
                # Represent a set as a tuple of row masks
                sets = set()
                # start with first row
                for m in valid_masks:
                    sets.add((m,))
                for row in range(1, n):
                    newsets = set()
                    for prev in sets:
                        prev_mask = prev[-1]
                        for cur_mask in compat[prev_mask]:
                            newsets.add(prev + (cur_mask,))
                    sets = newsets
                # convert each set to a bitmask of size n*n (row-major)
                result = []
                for rows in sets:
                    # compute full mask
                    full = 0
                    for i,mask in enumerate(rows):
                        for j in range(n):
                            if (mask>>j) & 1:
                                pos = i*n + j
                                full |= 1<<pos
                    result.append(full)
                return result
            
            def optimal_depth(F, n):
                # F is frozenset of integer masks (size up to 2^(n*n))
                @lru_cache(None)
                def solve(state):
                    # state is frozenset of masks (represented as tuple sorted)
                    s = set(state)
                    # if only one possible configuration, depth 0
                    if len(s) <= 1:
                        return 0
                    # if all configurations have same set of positions? Not needed
                    best = float('inf')
                    # consider each element (position) as query
                    # we can prune: if element appears in all or none, skip
                    # Represent positions 0..n*n-1
                    # compute set of configs as list
                    configs = list(s)
                    # compute frequency of each position
                    freq = [0]*(n*n)
                    for cfg in configs:
                        for pos in range(n*n):
                            if (cfg>>pos)&1:
                                freq[pos]+=1
                    # order positions by closeness to half
                    candidates = [pos for pos in range(n*n) if 0<freq[pos]<len(s)]
                    # if no candidate (should not happen), return large
                    for pos in candidates:
                        yes = frozenset([cfg for cfg in configs if (cfg>>pos)&1])
                        no = frozenset([cfg for cfg in configs if not ((cfg>>pos)&1)])
                        # worst-case depth after this query
                        depth = 1 + max(solve(tuple(sorted(yes))), solve(tuple(sorted(no))))
                        if depth < best:
                            best = depth
                            # early break if best equals lower bound ceil(log2(len(s)))
                            if best == math.ceil(math.log2(len(s))):
                                break
                    return best
                return solve(tuple(sorted(F)))
            
            def compute_optimal_depth(n):
                all_sets = independent_sets_n(n)
                # filter size >=2
                F = frozenset([s for s in all_sets if bin(s).count('1')>=2])
                return optimal_depth(F, n)
            
            for n in range(2,5):
                print(n, compute_optimal_depth(n))
            
