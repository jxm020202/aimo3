            import math, random, itertools
            
            def compute_ai(points, i, angle_width=100):
                # points: list of (x,y) coordinates on unit circle
                # i: index of observer
                # angle_width in degrees
                # compute all angles from i to other points relative to tangent direction at i (vertical upward)
                # Use angle between chord and tangent (0 to 180)
                xi, yi = points[i]
                # tangent direction: rotate radius by +90 deg (counterclockwise) gives direction vector (-yi, xi)
                # Actually radius vector from center O(0,0) to point is (xi, yi). Tangent direction is perpendicular: (-yi, xi) (counterclockwise)
                tx, ty = -yi, xi
                # compute angle between chord vector to each other point and tangent direction
                angles = []
                for j, (xj, yj) in enumerate(points):
                    if j == i: continue
                    vx, vy = xj - xi, yj - yi
                    # compute signed angle from tangent to chord, in range [0, 360) maybe using atan2 of cross/dot
                    dot = tx*vx + ty*vy
                    cross = tx*vy - ty*vx
                    # angle = atan2(cross, dot) in radians, convert to degrees, ensure positive
                    ang = math.degrees(math.atan2(cross, dot))
                    if ang < 0:
                        ang += 360
                    # Since viewing sector is 100°, we only need angles modulo 360
                    angles.append(ang)
                # Now we need to find max number of angles that fit within any interval of length angle_width (including endpoints)
                # Since angles wrap around, duplicate with +360
                sorted_angles = sorted(angles)
                n = len(sorted_angles)
                extended = sorted_angles + [a+360 for a in sorted_angles]
                maxcnt = 0
                # sliding window
                left = 0
                for right in range(len(extended)):
                    while extended[right] - extended[left] > angle_width + 1e-9:
                        left += 1
                    cnt = right - left + 1
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
