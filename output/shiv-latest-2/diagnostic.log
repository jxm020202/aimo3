                o = np.linalg.solve(M2, rhs2)
                # compute angle between n and o
                dot = np.dot(n, o)
                norm_n = np.linalg.norm(n)
                norm_o = np.linalg.norm(o)
                angle = math.degrees(math.acos(dot/(norm_n*norm_o)))
                return angle
            
