            def incenter(A,B,C):
                a = dist(B,C)  # side opposite A
                b = dist(A,C)  # opposite B
                c = dist(A,B)  # opposite C
                # coordinates weighted by side lengths
                x = (a*A.x + b*B.x + c*C.x) / (a+b+c)
                y = (a*A.y + b*B.y + c*C.y) / (a+b+c)
