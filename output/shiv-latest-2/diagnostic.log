            def seq_mod_n(n, terms):
                a = [pow(2, k, n) for k in range(n)]  # a_1..a_n
                from collections import deque
                window = deque(a, maxlen=n)
                seq = a.copy()
                for idx in range(n, terms):
                    next_val = sum(window) % n
                    seq.append(next_val)
                    window.append(next_val)
                return seq
            
