            def hill_climb_incremental(n, steps=20000, max_move=0.05):
                pts = random_points(n)
                best = sum_a(pts)
                best_pts = pts[:]
                for step in range(steps):
                    i = random.randrange(n)
                    # small move
                    dx = (random.random()*2-1)*max_move
                    dy = (random.random()*2-1)*max_move
                    old = pts[i]
                    new_pt = (old[0]+dx, old[1]+dy)
                    # ensure inside unit circle
                    if new_pt[0]**2 + new_pt[1]**2 > 1.0:
