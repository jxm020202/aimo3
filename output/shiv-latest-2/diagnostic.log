            import math
            from fractions import Fraction
            import sympy as sp
            
            def rational_roots_of_cubic(p, q):
                # a = p/q reduced, assume gcd(p,q)=1
                # polynomial: 4 q^4 t^3 + (p^2 - q^2)^2 t - (p^4 - 2 p^2 q^2 + 5 q^4) = 0
                # integer coefficients
                A = 4 * q**4
                B = (p**2 - q**2)**2
                C = -(p**4 - 2 * p**2 * q**2 + 5 * q**4)
                # polynomial in t: A t^3 + B t + C = 0
                # rational root theorem: possible roots = factors of C / factors of A
                # compute divisors of C and A
                # Use sympy's rational_root_test? Let's just use sp.nroots and rational_approx maybe.
                t = sp.symbols('t')
                poly = sp.Poly(A*t**3 + B*t + C, t, domain='ZZ')
                # factor over rationals
                fac = sp.factor(poly.as_expr())
                # get roots via sp.roots
                roots = sp.roots(poly)  # returns dict {root: multiplicity}
                rational_roots = []
                for root, mult in roots.items():
                    # root may be rational (sympy Rational) or algebraic
                    if isinstance(root, sp.Rational):
                        rational_roots.append(root)
                return rational_roots
            
            def find_solutions(max_q=20):
                sols = []
                for q in range(1, max_q+1):
                    for p in range(-q+1, q):  # ensure |a|<1 => |p|<q
                        if math.gcd(p, q) != 1:
                            continue
                        a = Fraction(p, q)
                        # skip a=0? Could be allowed but then sqrt(1-2x)=0 => x=1/2, but then denominator? Let's include a=0? a=0 => x=1/2 rational.
                        # We'll include a=0 as well.
                        # Compute rational roots t
                        roots = rational_roots_of_cubic(p, q)
                        if not roots:
                            continue
                        for t in roots:
                            # compute RHS = 2t + 8a(1 - a)/(1 - 2a + 5 a^2)
                            a_sym = sp.Rational(p, q)
                            t_sym = sp.Rational(t)  # t is Rational already
                            RHS = 2*t_sym + 8*a_sym*(1 - a_sym)/(1 - 2*a_sym + 5*a_sym**2)
                            # RHS must be non-negative rational square
                            if RHS < 0:
                                continue
                            # Check if RHS is perfect square rational: sqrt(RHS) rational
                            sqrtR = sp.sqrt(RHS)
                            if sqrtR.is_rational:
                                b_plus_1 = sqrtR
                                b = b_plus_1 - 1
                                # b must be >=0 rational
                                if b >= 0 and b.is_rational:
                                    # compute x,y
                                    x = (1 - a_sym**2)/2
                                    y = (1 - b**2)/2
                                    if x > 0 and y > 0:
                                        # compute minimal k = lcm(denom(x), denom(y))
                                        kx = sp.denom(x)
                                        ky = sp.denom(y)
                                        k = sp.ilcm(kx, ky)
                                        sols.append((a_sym, b, x, y, k, t_sym))
                return sols
            
            sols = find_solutions(30)
            len(sols)
            
