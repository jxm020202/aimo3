            def triangular_set(n):
                # generate n points as triangular numbers: t_i = i*(i+1)//2 for i=0..n-1
                return [i*(i+1)//2 for i in range(n)]
            
            def diffs(S):
                d=set()
                for i in range(len(S)):
                    for j in range(len(S)):
                        if i!=j:
                            d.add(S[i]-S[j])
                return d
            
            def covers_up_to(N, n):
                S=triangular_set(n)
                d=diffs(S)
                return all(k in d for k in range(1,N+1))
            
            for n in range(2,10):
