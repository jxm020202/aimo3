            def max_product_bruteforce(N):
                from itertools import combinations
                total_set = set(range(1,N+1))
                max_val = None
                max_info = None
                for n in range(1,N-1):  # A size at least 1, B size at least 2
                    for A in combinations(range(1,N+1), n):
                        A = set(A)
                        B = total_set - A
                        if len(B) < 2:
                            continue
                        s_A = sum(A)
                        s_B = sum(B)
                        for p in B:
                            nA = len(A)
                            nB = len(B)
                            # compute product directly
                            fA = s_A / nA
                            fAp = (s_A + p) / (nA + 1)
                            fB = s_B / nB
                            fBp = (s_B - p) / (nB - 1)
                            P = (fAp - fA) * (fBp - fB)
                            if max_val is None or P > max_val:
                                max_val = P
                                max_info = (A, B, p, P)
                return max_val, max_info
            
            def max_product_algorithm(N):
                max_val = None
                max_info = None
                total_sum = N*(N+1)//2
                for n in range(1,N-1):
                    m = N - n
                    denom = n*(n+1)*m*(m-1)
                    for p in range(1,N+1):
                        # x_min
                        if p > n:
                            x_min = n*(n+1)//2
                        else:
                            x_min = (n+1)*(n+2)//2 - p
                        # x_max
                        if p <= N - n:
                            x_max = n*(2*N - n + 1)//2  # sum of top n numbers: n*(first+last)/2 = n*((N - n + 1)+N)/2 = n*(2N - n + 1)/2
                        else:
                            x_max = (n+1)*(2*N - (n+1) + 1)//2 - p  # sum top n+1 minus p
                        for x in (x_min, x_max):
                            Nnum = (n*p - x)*(total_sum - x - m*p)
                            P = Nnum/denom
                            if max_val is None or P > max_val:
                                max_val = P
                                max_info = (n,m,p,x)
                return max_val, max_info
            
