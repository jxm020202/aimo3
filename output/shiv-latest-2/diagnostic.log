            import math, fractions, itertools, sys, sympy as sp
            
            def find_solutions(limit):
                sols=[]
                for n in range(1,limit+1):
                    for m in range(0,n): # a=m/n, 0<=a<1
                        # ensure reduced fraction
                        if math.gcd(m,n)!=1:
                            continue
                        num = 2*(m+n)**2
                        den = 5*m*m - 2*m*n + n*n
                        if den<=0:
                            continue
                        # reduce fraction
                        g=math.gcd(num,den)
                        num_r=num//g
                        den_r=den//g
                        # check if both numerator and denominator are perfect squares
                        if int(math.isqrt(num_r))**2 == num_r and int(math.isqrt(den_r))**2 == den_r:
                            # compute a,m,n
                            a = sp.Rational(m,n)
                            S = sp.Rational(num,den)
                            # compute b = -1 + sqrt(S)
                            b = -1 + sp.sqrt(S)
                            # check if b rational (i.e., sqrt(S) rational)
                            if b.is_rational:
                                # compute x,y
                                x = (1 - a**2)/2
                                y = (1 - b**2)/2
                                # check rational positivity and denominators
                                if x>0 and y>0:
                                    # compute minimal k such that kx,ky integers
                                    # find denominators of x and y in lowest terms
                                    x_frac = sp.nsimplify(x)
                                    y_frac = sp.nsimplify(y)
                                    # denominators
                                    kx = sp.denom(x_frac)
                                    ky = sp.denom(y_frac)
                                    k = sp.ilcm(kx, ky)
                                    sols.append((m,n,a,b,x,y,k))
                return sols
            
