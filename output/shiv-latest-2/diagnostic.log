            def exists_skolem(n, time_limit=10):
                N = 2*n
                # variables x_{i,d} for i=1..N-d, d=1..n
                var_indices = {}
                idx = 0
                for d in range(1, n+1):
                    for i in range(1, N - d + 1):
                        var_indices[(i,d)] = idx
                        idx += 1
                num_vars = idx
                # objective zero
                c = np.zeros(num_vars, dtype=int)
                # constraints
                A_eq = []
                b_eq = []
                # each vertex i appears exactly once
                for i in range(1, N+1):
                    row = np.zeros(num_vars, dtype=int)
                    # edges where i is the smaller endpoint
                    for d in range(1, n+1):
                        if i <= N - d:
                            if (i,d) in var_indices:
                                row[var_indices[(i,d)]] = 1
                    # edges where i is the larger endpoint (i = j+d)
                    for d in range(1, n+1):
                        j = i - d
                        if j >= 1:
                            if (j,d) in var_indices:
                                row[var_indices[(j,d)]] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each difference used exactly once
                for d in range(1, n+1):
                    row = np.zeros(num_vars, dtype=int)
                    for i in range(1, N - d + 1):
                        row[var_indices[(i,d)]] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # bounds: 0 <= x <= 1
                from scipy.optimize import milp, LinearConstraint, Bounds
                constraints = LinearConstraint(A_eq, b_eq, b_eq)
                bounds = Bounds(0, 1)
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=np.ones(num_vars, dtype=int), options={'presolve': True, 'time_limit': time_limit})
                return res.success
            
            for n in range(1,9):
                print(n, exists_skolem(n, time_limit=5))
            
