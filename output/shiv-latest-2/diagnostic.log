            import random, math, itertools, numpy as np, sympy as sp
            
            def compute_R(r):
                # r is list of 4 inner radii
                b = [1/ri for ri in r]
                S = sum(b)
                Q = sum([bi**2 for bi in b])
                # Solve R^2 (S^2 - 3 Q) - 2 R S - 2 = 0 for positive R
                a = (S**2 - 3*Q)
                # a may be negative; but we can solve quadratic anyway.
                # Equation: a R^2 - 2 S R - 2 = 0
                # Solve: R = (2S ± sqrt(4S^2 + 8a))/ (2a) = (S ± sqrt(S**2 + 2a))/a
                # Use positive root that yields positive R.
                # If a == 0, then equation reduces to -2 S R - 2 = 0 => R = -1/S (negative), not possible.
                if abs(a) < 1e-12:
                    return None
                disc = S**2 + 2*a
                if disc < 0:
                    return None
                R1 = (S + math.sqrt(disc)) / a
                R2 = (S - math.sqrt(disc)) / a
                # Choose positive R
                candidates = [R for R in (R1,R2) if R>0]
                if not candidates:
                    return None
                # Should be only one positive
                return candidates[0]
            
