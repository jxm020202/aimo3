            def separating_set_min_bruteforce(n):
                positions = [(i,j) for i in range(n) for j in range(n)]
                configs = indep_sets_size_ge2(n)
                # Precompute for each position the set of config indices where it's selected
                pos_selected = {p: set(i for i,s in enumerate(configs) if p in s) for p in positions}
                # For each pair of configs (i<j), we need a position where membership differs
                pairs = [(i,j) for i in range(len(configs)) for j in range(i+1,len(configs))]
                # Represent each position as covering set of pairs it separates
                cover = {}
                for p in positions:
                    sel = pos_selected[p]
                    not_sel = set(range(len(configs))) - sel
                    # pairs where one in sel and other not in sel
                    pair_set = set()
                    for i in sel:
                        for j in not_sel:
                            if i<j:
                                pair_set.add((i,j))
                            else:
                                pair_set.add((j,i))
                    cover[p]=pair_set
                # Use greedy to approximate minimal cover
                uncovered = set(pairs)
                chosen = set()
