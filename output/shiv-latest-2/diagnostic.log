            def compute_ratio(D, E, F):
                # D, E, F are tuples or arrays
                D = np.array(D, dtype=float)
                E = np.array(E, dtype=float)
                F = np.array(F, dtype=float)
                # circumcenter O of triangle D,E,F
                # Use formula via perpendicular bisectors solving linear equations
                # Solve for O: |O-D|^2 = |O-E|^2 and |O-D|^2 = |O-F|^2
                # This yields linear equations.
                A = np.array([2*(E-D), 2*(F-D)])  # each row is 2*(point - D)
                b = np.array([np.dot(E, E) - np.dot(D, D), np.dot(F, F) - np.dot(D, D)])
                # Solve linear system A * O = b
                O = np.linalg.solve(A, b)
                # incenter I: intersection of angle bisectors. Coordinates: weighted average of vertices by side lengths.
                a = np.linalg.norm(E-F)  # opposite D
                b_len = np.linalg.norm(D-F)  # opposite E
                c = np.linalg.norm(D-E)  # opposite F
                I = (a*D + b_len*E + c*F) / (a + b_len + c)
                # line through I perpendicular to OI
                # direction vector v = rotate 90 deg of OI
                OI = O - I
                # perpendicular direction (dx, dy) -> (-dy, dx)
                v = np.array([-OI[1], OI[0]])
                # param equation: I + t*v
                # Intersection with line DE: solve for t such that point lies on line through D,E.
                # DE line param: D + s*(E-D)
                # Solve I + t*v = D + s*(E-D)
                # 2 equations, 2 unknowns t,s
                M = None
                N = None
                # Solve linear system for t,s
                A2 = np.column_stack((v, -(E-D)))  # I + t*v = D + s*(E-D) => t*v + s*(E-D) = D - I
                # Actually we want I + t*v = D + s*(E-D) => t*v - s*(E-D) = D - I
                # So columns: v, -(E-D)
                rhs = D - I
                try:
                    sol = np.linalg.solve(A2, rhs)
                    tM = sol[0]
                    # s = sol[1]
                    M = I + tM * v
                except np.linalg.LinAlgError:
                    # degenerate (parallel) case; skip
                    return None
                # Intersection with external bisector at F.
                # Compute unit vectors along FD and FE (from F)
                u1 = D - F
                u2 = E - F
                u1_norm = u1 / np.linalg.norm(u1)
                u2_norm = u2 / np.linalg.norm(u2)
                # internal bisector direction = u1_norm + u2_norm
                # external bisector direction = u1_norm - u2_norm (or opposite)
                ext_dir = u1_norm - u2_norm
                # line: F + r*ext_dir
                # Solve I + t*v = F + r*ext_dir
                A3 = np.column_stack((v, -ext_dir))
                rhs2 = F - I
                try:
                    sol2 = np.linalg.solve(A3, rhs2)
                    tN = sol2[0]
                    N = I + tN * v
                except np.linalg.LinAlgError:
                    return None
                # distances
                QM = np.linalg.norm(M - I)
                QN = np.linalg.norm(N - I)
                return QM / QN
            
