                # Compute u,v.
                def egcd(a,b):
                    if b==0:
                        return (1,0,a)
                    else:
                        x,y,g = egcd(b, a%b)
                        return (y, x - (a//b)*y, g)
                u,v,g = egcd(11,3)  # 11*u + 3*v = g = 1
                # verify
                # print(11*u+3*v)
