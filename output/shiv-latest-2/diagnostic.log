            def max_zero_block_mod(mod, order, max_terms=500000):
                # compute sequence modulo mod with recurrence order = order
                a = [pow(2, k, mod) for k in range(order)]  # a_1..a_order
                max_len = cur_len = 0
                for val in a:
                    if val == 0:
                        cur_len += 1
                        max_len = max(max_len, cur_len)
                    else:
                        cur_len = 0
                from collections import deque
                window = deque(a, maxlen=order)
                for k in range(order, max_terms):
                    next_val = sum(window) % mod
                    if next_val == 0:
                        cur_len += 1
                        max_len = max(max_len, cur_len)
                        if cur_len >= order:
                            return float('inf')
                    else:
                        cur_len = 0
                    window.append(next_val)
