            import sympy as sp
            def compute_angle_and_W(s_val):
                s_val = sp.nsimplify(s_val)
                h_val = sp.sqrt(3)/2 * s_val
                X = sp.Point(2,0)
                Z = sp.Point(s_val/2 - sp.Rational(1,2), h_val - sp.sqrt(3)/2)
                # solutions for Yy
                Yy1 = sp.sqrt(3)*(s_val - 2)/2
                Yy2 = sp.sqrt(3)*(s_val + 1)/4
                # compute Yx using line equation x = s - y/sqrt(3)
                Yx1 = s_val - Yy1/sp.sqrt(3)
                Yx2 = s_val - Yy2/sp.sqrt(3)
                Y1 = sp.Point(Yx1, Yy1)
                Y2 = sp.Point(Yx2, Yy2)
                # compute angle ZXY for each
                def angle_ZXY(Y):
                    v1 = Z - X  # vector X->Z? Actually Z - X = vector from X to Z
                    v2 = Y - X  # vector from X to Y
                    # angle between v1 and v2
                    dot = v1.dot(v2)
                    norm1 = sp.sqrt(v1.dot(v1))
                    norm2 = sp.sqrt(v2.dot(v2))
                    cosang = dot/(norm1*norm2)
                    # simplify
                    return sp.acos(sp.nsimplify(cosang))
                ang1 = angle_ZXY(Y1)
                ang2 = angle_ZXY(Y2)
                # compute W = Z + (X - Y)
                W1 = Z + (X - Y1)
                W2 = Z + (X - Y2)
                return (sp.N(ang1*180/sp.pi), sp.N(ang2*180/sp.pi), W1, W2)
            
