            def closure(x, y, bound=200):
                # compute reachable numbers within [-bound,bound] using BFS of operation
                # start with set {x,y}
                S = set([x, y])
                changed = True
                while changed:
                    changed = False
                    new_vals = set()
                    for a in S:
                        for b in S:
                            # generate values for i such that result within bound
                            # compute base = a*a + b*b
                            base = a*a + b*b
                            step = a*b
                            # we can generate values base + k*step for k in range such that within bound
                            # compute k range
                            if step == 0:
                                # only base
                                if -bound <= base <= bound:
                                    new_vals.add(base)
                            else:
                                # compute min k to get within bound
                                k_min = math.ceil((-bound - base)/step)
                                k_max = math.floor((bound - base)/step)
                                for k in range(k_min, k_max+1):
                                    val = base + k*step
                                    if -bound <= val <= bound:
                                        new_vals.add(val)
                    # add new_vals to S
                    for v in new_vals:
                        if v not in S:
                            S.add(v)
                            changed = True
                return S
            
