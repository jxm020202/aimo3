            def point_in_triangle(P, A, B, C):
                # using barycentric technique: compute signs of areas
                def area(p1,p2,p3):
                    return (p1.x*(p2.y-p3.y) + p2.x*(p3.y-p1.y) + p3.x*(p1.y-p2.y))/2
                area_total = abs(area(A,B,C))
                area1 = abs(area(P,B,C))
                area2 = abs(area(A,P,C))
                area3 = abs(area(A,B,P))
                return abs(area_total - (area1+area2+area3)) < 1e-9
            
            def compute_W(sval, tval):
                X = sp.Point(2,0)
                Y = sp.Point(sval*(1 - tval/2), sval*tval*sp.sqrt(3)/2)
                Z = sp.Point((sval-1)/2, sp.sqrt(3)/2*(sval-1))
                W = sp.Point(Z.x + Y.x - 2, Z.y + Y.y)
                return W
            
            def is_W_outside(sval, tval):
                D = sp.Point(0,0)
                E = sp.Point(sval,0)
                F = sp.Point(sval/2, sp.sqrt(3)/2*sval)
                W = compute_W(sval, tval)
                # check if inside triangle (including boundary)
                inside = point_in_triangle(W, D, E, F)
                return not inside
            
            for sval in np.linspace(2.01,3.12,10):
                tval = compute_t(sval)[1]
                print(sval, tval, is_W_outside(sval, tval))
            
