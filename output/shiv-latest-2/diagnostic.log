            def longest_zero_run_mod_n_fast(n, max_terms):
                # initialize list of first n terms
                a = [pow(2, k, n) for k in range(n)]  # a_1..a_n
                longest = 0
                current = 0
                for val in a:
                    if val == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                # sliding window sum
                window = a[:]  # list of length n
                window_sum = sum(window) % n
                for i in range(n, max_terms):
                    next_val = window_sum % n
                    # update longest
                    if next_val == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                    # update sliding sum
                    old = window[i % n]  # element leaving window
                    window[i % n] = next_val
                    window_sum = (window_sum - old + next_val) % n
                return longest
            
