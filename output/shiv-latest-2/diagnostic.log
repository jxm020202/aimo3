                eqs.append(lam1*2*(z2 - s3*t) + lam2*2)  # dL/dz2 = 0
                eqs.append(1 - 2*lam1*(s1*(x2 - s1*t) + s2*(y2 - s2*t) + s3*(z2 - s3*t)))  # dL/dt = 0
            
                # Solve system
