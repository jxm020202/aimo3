            import itertools, numpy as np, math, sys, random, collections, sympy as sp
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            # recompute values and required
            def fib(n):
                a,b=0,1
                for _ in range(n):
                    a,b=b,a+b
                return a
            def lucas(n):
                a,b=2,1
                for _ in range(n):
                    a,b=b,a+b
                return a
            
            required = [fib(k) for k in range(2,126)]
            required.append(lucas(100))
            values = [0] + required
            n = len(values)
            pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
            pair_index = {pair: idx for idx, pair in enumerate(pairs)}
            # map diff to pairs
            diff_to_pairs = {}
            for (i,j) in pairs:
                d = abs(values[j] - values[i])
                if d in required:
                    diff_to_pairs.setdefault(d, []).append((i,j))
            
            num_x = n
            num_p = len(pairs)
            total_vars = num_x + num_p
            
            c = np.zeros(total_vars)
            c[:num_x] = 1
            
            A_rows = []
            b_rows = []
            
            # pair constraints
            for idx_pair, (i,j) in enumerate(pairs):
                # p - x_i <= 0
                row = np.zeros(total_vars)
                row[num_x + idx_pair] = 1
                row[i] = -1
                A_rows.append(row); b_rows.append(0)
                # p - x_j <= 0
                row = np.zeros(total_vars)
                row[num_x + idx_pair] = 1
                row[j] = -1
                A_rows.append(row); b_rows.append(0)
                # -p + x_i + x_j <= 1
                row = np.zeros(total_vars)
                row[num_x + idx_pair] = -1
                row[i] = 1
                row[j] = 1
                A_rows.append(row); b_rows.append(1)
            
            # coverage constraints
            for d, pairlist in diff_to_pairs.items():
                row = np.zeros(total_vars)
                for (i,j) in pairlist:
                    idx = pair_index[(i,j)]
                    row[num_x + idx] = -1
                A_rows.append(row); b_rows.append(-1)
            
            A = np.array(A_rows)
            b = np.array(b_rows)
            
            lb = np.zeros(total_vars)
            ub = np.ones(total_vars)
            
            integrality = np.ones(total_vars, dtype=int)
            
            res = milp(c=c, constraints=LinearConstraint(A, -np.inf*np.ones_like(b), b), bounds=Bounds(lb, ub), integrality=integrality, options={'disp': True})
            print("objective:", res.fun)
            print("x sum:", sum(res.x[:num_x]))
            
