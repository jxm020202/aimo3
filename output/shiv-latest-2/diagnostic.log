            def exsimilicenter(P, Q, r, R):
                # P is circumcenter O, Q is incenter I
                O = sp.Point(P)
                I = sp.Point(Q)
                # external homothety center X lies on line OI beyond I such that OX / IX = R / r, and OX = OI + IX
                # Let vector v = I - O
                # Let X = O + t * v, with t > 1 (since beyond I)
                # Then OX = t*|v|, IX = (t-1)*|v|
                # Ratio OX/IX = t/(t-1) = R/r => solve t = R/(R - r)
                t = R/(R - r)
                X = O + t * (I - O)
                return sp.Point(X)
            
