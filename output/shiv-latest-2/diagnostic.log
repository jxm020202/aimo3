            import math, random, sys, itertools, numpy as np, sympy as sp
            def rotated_square_vertices(theta):
                a = 0.5
                verts = []
                for sx in (-a, a):
                    for sy in (-a, a):
                        x = sx*math.cos(theta) - sy*math.sin(theta)
                        y = sx*math.sin(theta) + sy*math.cos(theta)
                        verts.append((x,y))
                # order them (convex hull). Let's sort by angle around centroid.
                cx = sum(v[0] for v in verts)/4
                cy = sum(v[1] for v in verts)/4
                verts.sort(key=lambda v: math.atan2(v[1]-cy, v[0]-cx))
                return verts
            
            def clip_polygon(poly, axis, bound):
                # axis = 'x' or 'y', keep side >= bound
                newpoly = []
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    v1 = x1 if axis=='x' else y1
                    v2 = x2 if axis=='x' else y2
                    inside1 = v1 >= bound - 1e-12
                    inside2 = v2 >= bound - 1e-12
                    if inside1:
                        newpoly.append((x1,y1))
                    # Edge intersect?
                    if inside1 != inside2:
                        # compute intersection with line axis=bound
                        if axis=='x':
                            # line x = bound, param t from p1 to p2
                            t = (bound - x1) / (x2 - x1)
                            y = y1 + t*(y2 - y1)
                            newpoly.append((bound, y))
                        else:
                            t = (bound - y1) / (y2 - y1)
                            x = x1 + t*(x2 - x1)
                            newpoly.append((x, bound))
                return newpoly
            
            def area_polygon(poly):
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2
            
