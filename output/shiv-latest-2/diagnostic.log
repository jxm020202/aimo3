            import random, math, cmath, itertools, sys, numpy as np, math, sympy as sp
            def compute_angle(Y, t):
                x1, y1 = Y
                # W=(0,0), X=(1,0)
                # compute s
                numerator = (t*x1 - 1)**2 + (t*y1)**2
                denominator = x1**2 + y1**2
                if denominator == 0:
                    return None
                s = math.sqrt(numerator/denominator)
                # choose sign for s? s positive.
                # compute Z
                x2 = 1 + (t*x1 - 1)/s
                y2 = t*y1 / s
                # Points
                W = np.array([0.0,0.0])
                X = np.array([1.0,0.0])
                Yp = np.array([x1,y1])
                Z = np.array([x2,y2])
                # Intersection M of WY and XZ (should be at parameters t and s)
                M = W + t*(Yp - W)  # also = X + s*(Z-X)
                # Compute N: intersection of perp bisectors of WX and YZ
                # Perp bisector of WX: vertical line x=0.5
                # Represent as line: x = 0.5
                # Perp bisector of YZ:
                # midpoint
                mid_YZ = (Yp + Z)/2
                # direction vector of YZ
                v_YZ = Z - Yp
                # slope of perpendicular bisector: if v = (dx, dy), then perp direction = (-dy, dx)
                # line param: mid + u * perp_dir
                perp_dir_YZ = np.array([-v_YZ[1], v_YZ[0]])
                # Intersection with x=0.5: solve for u such that x-coordinate =0.5
                if perp_dir_YZ[0]==0:
                    # line vertical, cannot intersect? but then N not defined uniquely
                    return None
                u = (0.5 - mid_YZ[0]) / perp_dir_YZ[0]
                N = mid_YZ + u*perp_dir_YZ
                # Compute O: intersection of perp bisectors of XY and ZW
                # Perp bisector of XY:
                mid_XY = (X + Yp)/2
                v_XY = Yp - X
                perp_dir_XY = np.array([-v_XY[1], v_XY[0]])
                # Perp bisector of ZW:
                mid_ZW = (Z + W)/2
                v_ZW = W - Z
                perp_dir_ZW = np.array([-v_ZW[1], v_ZW[0]])
                # Solve intersection of two lines: mid_XY + a*perp_dir_XY = mid_ZW + b*perp_dir_ZW
                # Solve for a,b.
                A = np.column_stack((perp_dir_XY, -perp_dir_ZW))
                b_vec = mid_ZW - mid_XY
                # Solve linear system if invertible
                if np.linalg.matrix_rank(A) < 2:
                    return None
                sol = np.linalg.lstsq(A, b_vec, rcond=None)[0]
                a = sol[0]
                O = mid_XY + a*perp_dir_XY
                # Compute angle NMO
                v1 = N - M
                v2 = O - M
                # compute angle between v1 and v2
                dot = np.dot(v1, v2)
                norm1 = np.linalg.norm(v1)
                norm2 = np.linalg.norm(v2)
                if norm1==0 or norm2==0:
                    return None
                cosang = dot/(norm1*norm2)
                # numeric safety
                cosang = max(-1.0, min(1.0, cosang))
                angle = math.degrees(math.acos(cosang))
                return angle
            
            def test_random():
                for i in range(1000):
                    # random Y not collinear with WX
                    x1 = random.uniform(-2,2)
                    y1 = random.uniform(-2,2)
                    if abs(y1) < 1e-6 and abs(x1) < 1e-6:
                        continue
                    t = random.uniform(0.2,0.8) # choose interior ratio
                    ang = compute_angle((x1,y1), t)
                    if ang is not None:
                        return ang
                return None
            
            print(test_random())
            
