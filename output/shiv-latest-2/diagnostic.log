            import numpy as np, math, random, sys, time
            
            def sum_max_counts_numpy(points, angle_deg=100):
                n = len(points)
                angle_rad = math.radians(angle_deg)
                total = 0
                pts = np.array(points)
                for i in range(n):
                    diffs = pts - pts[i]  # shape (n,2)
                    # exclude self
                    diffs_i = np.delete(diffs, i, axis=0)
                    angles = np.arctan2(diffs_i[:,1], diffs_i[:,0])
                    angles = np.mod(angles, 2*math.pi)
                    angles.sort()
                    angles2 = np.concatenate((angles, angles + 2*math.pi))
                    # sliding window using two pointers
                    maxcnt = 0
                    left = 0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > angle_rad + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def random_points_in_circle_np(n, radius=1.0):
                r = radius * np.sqrt(np.random.rand(n))
                theta = np.random.rand(n) * 2*math.pi
                x = r * np.cos(theta)
                y = r * np.sin(theta)
                return list(zip(x, y))
            
