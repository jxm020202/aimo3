            import functools
            
            def last_nonzero_digit_factorial(n):
                # using recurrence
                if n == 0:
                    return 1
                # compute recursively
                # D(n) = D(n//5) * D(n%5) * 2^{n//5} mod 10
                # D(0..4) known: 1,1,2,6,4 (last non-zero digit of 0!,1!,2!,3!,4!)
                # Actually D(0)=1, D(1)=1, D(2)=2, D(3)=6, D(4)=4
                # D(5)=2? Let's compute using recurrence.
                # We'll compute recursively.
                if n < 5:
                    base = [1,1,2,6,4]
                    return base[n]
                else:
                    d = last_nonzero_digit_factorial(n//5)
                    r = n % 5
                    base = [1,1,2,6,4]
                    d_r = base[r]
                    # compute 2^{n//5} mod 10
                    pow2 = pow(2, n//5, 10)
                    return (d * d_r * pow2) % 10
            
