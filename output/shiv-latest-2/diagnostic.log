            def compute_excenter_F(D,E,F):
                # side lengths
                a = np.linalg.norm(E-F)
                b = np.linalg.norm(F-D)
                c = np.linalg.norm(D-E)
                # excenter opposite F: (a*D + b*E - c*F)/(a + b - c)
                return (a*D + b*E - c*F) / (a + b - c)
            
