            def sum_a(points, angle_deg=100):
                n = len(points)
                max_angle = math.radians(angle_deg)
                total = 0
                for i in range(n):
                    xi, yi = points[i]
                    angles = []
                    for j in range(n):
                        if i == j: continue
                        xj, yj = points[j]
                        ang = math.atan2(yj-yi, xj-xi)
                        if ang < 0:
                            ang += 2*math.pi
                        angles.append(ang)
                    angles.sort()
                    # duplicate with +2π
                    m = len(angles)
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # sliding window
                    best = 0
                    left = 0
                    for right in range(len(angles2)):
                        while angles2[right] - angles2[left] > max_angle + 1e-12:
                            left += 1
                        # number of points in window = right-left+1
                        cnt = right - left + 1
                        if cnt > best:
                            best = cnt
                    total += best
                return total
            
            def random_points(n, radius=1.0):
