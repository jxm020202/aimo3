            import math
            from fractions import Fraction
            from math import gcd
            
            def is_square(n):
                if n < 0:
                    return False
                r = int(math.isqrt(n))
                return r*r == n
            
            def minimal_k(limit=50):
                best = None
                best_data = None
                for q in range(1, limit+1):
                    for p in range(1, q+1):
                        if gcd(p,q)!=1:
                            continue
                        # s = p/q <=1 automatically
                        # compute x
                        x_num = q*q - p*p
                        x_den = 2*q*q
                        g = gcd(x_num, x_den)
                        x_num //= g
                        x_den //= g
                        # x positive? need p<q else x=0. If p==q, x=0 (not positive). So require p<q.
                        if p==q:
                            continue
                        # compute D
                        D = 5*p*p - 2*p*q + q*q
                        N = 2*(p+q)*(p+q)
                        g2 = gcd(N, D)
                        N1 = N // g2
                        D1 = D // g2
                        if not (is_square(N1) and is_square(D1)):
                            continue
                        a = int(math.isqrt(N1))
                        b = int(math.isqrt(D1))
                        # compute F rational
                        F = Fraction(4*p*(q-p), D)
                        # compute y = a/b - (F+1)
                        y = Fraction(a, b) - (F + 1)
                        # check y positive rational and <= 0.5
                        if y <= 0 or y > Fraction(1,2):
                            continue
                        # compute denominator of y reduced
                        den_y = y.denominator
                        # compute denominator of x reduced
                        den_x = x_den
                        # compute k = lcm
                        k = den_x * den_y // gcd(den_x, den_y)
                        if best is None or k < best:
                            best = k
                            best_data = (p,q,x_num,x_den,F,a,b,y,k)
                return best, best_data
            
            best_k, data = minimal_k(200)
            best_k, data[:10]
            
