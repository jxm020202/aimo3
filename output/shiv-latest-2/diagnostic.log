            import math
            def order_mod(a, m):
                if math.gcd(a,m)!=1:
                    return None
                phi = sympy.totient(m)
                # find smallest d dividing phi such that a^d ≡ 1 mod m
                for d in sympy.divisors(phi):
                    if pow(a, d, m) == 1:
                        return d
                return None
            
