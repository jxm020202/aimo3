            def min_dist_sq_on_edges(verts):
                n = len(verts)
                min_sq = float('inf')
                min_point = None
                for i in range(n):
                    x1,y1 = verts[i]
                    x2,y2 = verts[(i+1)%n]
                    # param t in [0,1]
                    # squared distance function f(t) = |(1-t)v1 + t v2|^2 = ((1-t)*x1 + t*x2)^2 + ((1-t)*y1 + t*y2)^2
                    # derivative set to zero yields linear equation; we can solve analytically.
                    # Use calculus: derivative of f(t) = 2*((1-t)*x1 + t*x2)*(x2 - x1) + 2*((1-t)*y1 + t*y2)*(y2 - y1) = 0
                    # Solve for t.
                    dx = x2 - x1
                    dy = y2 - y1
                    # Solve ((1-t)*x1 + t*x2)*dx + ((1-t)*y1 + t*y2)*dy = 0
                    # Let a = x1*dx + y1*dy
                    # Let b = (x2 - x1)*dx + (y2 - y1)*dy = dx*dx + dy*dy = |v2-v1|^2
                    # Actually compute directly.
                    a = x1*dx + y1*dy
                    b = dx*dx + dy*dy
                    # Equation: ( (x1 + t*dx) * dx + (y1 + t*dy) * dy ) = 0? Wait (1-t)*x1 + t*x2 = x1 + t*dx.
                    # So expression: (x1 + t*dx)*dx + (y1 + t*dy)*dy = 0
                    # => (x1*dx + y1*dy) + t*(dx*dx + dy*dy) = 0
                    # => a + t*b = 0 => t = -a/b
                    t = -a / b
                    # clamp to [0,1]
                    if t < 0: t = 0
                    if t > 1: t = 1
                    px = x1 + t*dx
                    py = y1 + t*dy
                    d2 = px*px + py*py
                    if d2 < min_sq:
                        min_sq = d2
                        min_point = (px,py)
                return min_sq, min_point
            
            min_sq, min_pt = min_dist_sq_on_edges(verts)
            min_sq, min_pt
            
