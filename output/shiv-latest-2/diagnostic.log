            def original_eq(x,y):
                # compute LHS
                lhs = 1 + mp.sqrt(1 - 2*y)
                # compute RHS components
                term1 = (4*x - 2 + 2*mp.sqrt(1 - 2*x)) / (3 - 5*x - mp.sqrt(1 - 2*x))
