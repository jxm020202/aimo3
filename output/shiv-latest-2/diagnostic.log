            def max_zero_run_fast(n, max_iter=20000000):
                # initial terms a[1..n] = 2^{k-1} mod n
                a = [pow(2, k-1, n) for k in range(1, n+1)]
                # track longest zero run
                max_run = 0
                cur_run = 0
                for val in a:
                    if val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # rolling sum of last n terms
                from collections import deque
                window = deque(a, maxlen=n)
                roll_sum = sum(window) % n
                # iterate
                for k in range(n+1, max_iter+1):
                    next_val = roll_sum % n
                    # update run
                    if next_val == 0:
                        cur_run += 1
                        if cur_run > max_run:
                            max_run = cur_run
                    else:
                        cur_run = 0
                    # update rolling sum: subtract oldest, add new
                    oldest = window.popleft()
                    roll_sum = (roll_sum - oldest + next_val) % n
                    window.append(next_val)
                return max_run
            
