            import random, math, cmath, numpy as np
            
            def incenter(D,E,F):
                # D,E,F are complex numbers coordinates
                # side lengths opposite vertices: a = |EF|, b = |FD|, c = |DE|
                a = abs(E-F)
                b = abs(F-D)
                c = abs(D-E)
                # incenter = (a*D + b*E + c*F) / (a+b+c) (weighted by side lengths)
                return (a*D + b*E + c*F) / (a+b+c)
            
            def intersect_line(p1, p2, q1, q2):
                # lines p1-p2 and q1-q2 (complex). Return intersection point.
                # Solve using cross product method.
                x1,y1 = p1.real, p1.imag
                x2,y2 = p2.real, p2.imag
                x3,y3 = q1.real, q1.imag
                x4,y4 = q2.real, q2.imag
                # compute intersection of lines (not segments)
                denom = (x1-x2)*(y3-y4) - (y1-y2)*(x3-x4)
                if abs(denom) < 1e-12:
                    return None
                ix = ((x1*y2 - y1*x2)*(x3-x4) - (x1-x2)*(x3*y4 - y3*x4))/denom
                iy = ((x1*y2 - y1*x2)*(y3-y4) - (y1-y2)*(x3*y4 - y3*x4))/denom
                return complex(ix, iy)
            
            def ratio_for_triangle(D,E,F):
                P = 0+0j  # circumcenter at origin
                Q = incenter(D,E,F)
                # line L: through Q perpendicular to PQ (i.e., line direction is rotate 90 deg of vector PQ)
                # direction vector v = i*(P-Q) maybe? Actually perpendicular to PQ: vector PQ = P - Q = -Q
                # So direction vector d = rotate 90 deg of PQ: d = (P-Q)*i (multiply by i)
                d = (P - Q) * 1j  # multiply by i
                # line L passes through Q, direction d
                # param: Q + t*d
                # Intersection with DE: line through D and E
                M = intersect_line(Q, Q+d, D, E)
                # external bisector at F: line through F perpendicular to QF (internal bisector)
                # internal bisector direction is Q - F (since Q lies on internal bisector)
                # external bisector direction is rotate 90 deg: (Q-F)*i
                # Actually line through F perpendicular to QF: direction e = (Q-F)*1j
                e = (Q - F) * 1j
                N = intersect_line(Q, Q+d, F, F+e)
                if M is None or N is None:
                    return None
                QM = abs(M - Q)
                QN = abs(N - Q)
                return QM/QN
            
            def random_triangle():
                # random angles distinct
                ang = sorted([random.random()*2*math.pi for _ in range(3)])
                D = cmath.rect(1, ang[0])
                E = cmath.rect(1, ang[1])
                F = cmath.rect(1, ang[2])
                return D,E,F
            
            for _ in range(5):
                D,E,F = random_triangle()
                print(ratio_for_triangle(D,E,F))
            
