            def order_mod_coprime(a, mod):
                if math.gcd(a, mod) != 1:
                    return None
                # compute multiplicative order
                phi = sympy.totient(mod)
                # find smallest divisor d of phi such that a**d ≡ 1 mod mod
                # naive
                for d in range(1, phi+1):
                    if pow(a, d, mod) == 1:
                        return d
                return None
            
