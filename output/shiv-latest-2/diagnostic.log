                x, y = v
                phi = math.atan2(x, y)  # angle to rotate clockwise to bring onto y-axis
                cos_phi = math.cos(-phi)
                sin_phi = math.sin(-phi)
                # rotation matrix for angle -phi
                R = np.array([[cos_phi, -sin_phi],[sin_phi, cos_phi]])
                return R @ np.array(v)
            
