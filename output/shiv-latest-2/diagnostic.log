            def angle_between(v1,v2):
                # return angle between vectors in radians (0 to pi)
                dot = np.dot(v1,v2)
                norm = np.linalg.norm(v1)*np.linalg.norm(v2)
                return math.acos(max(-1,min(1,dot/norm)))
            
            def test_angle():
                D = (0,0)
                E = (4,0)
                F = (1,3)
                D_np = np.array(D,float);E_np=np.array(E,float);F_np=np.array(F,float)
                # circumcenter O
                A = np.array([[2*(E_np[0]-D_np[0]), 2*(E_np[1]-D_np[1])],
                              [2*(F_np[0]-D_np[0]), 2*(F_np[1]-D_np[1])]])
                b = np.array([E_np[0]**2+E_np[1]**2 - D_np[0]**2 - D_np[1]**2,
                              F_np[0]**2+F_np[1]**2 - D_np[0]**2 - D_np[1]**2])
                O = np.linalg.solve(A,b)
                a = np.linalg.norm(E_np-F_np)
                b_len = np.linalg.norm(D_np-F_np)
                c = np.linalg.norm(D_np-E_np)
                I = (a*D_np + b_len*E_np + c*F_np)/(a+b_len+c)
                # direction of DE
                v_DE = E_np - D_np
                # external bisector direction at F
                uFD = (D_np - F_np)/b_len
                uFE = (E_np - F_np)/a
                v_ext = uFD - uFE
                # angle between DE and external bisector
                ang = angle_between(v_DE, v_ext)
                # angle between OI and DE
                ang_OI_DE = angle_between(O - I, v_DE)
                # angle between OI and external bisector
                ang_OI_ext = angle_between(O - I, v_ext)
                return ang, ang_OI_DE, ang_OI_ext
            
            test_angle()
            
