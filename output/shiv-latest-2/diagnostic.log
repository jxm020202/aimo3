            import math
            from fractions import Fraction
            from math import gcd
            def lcm(a,b):
                return a*b//gcd(a,b)
            
            def compute_solution(b_frac):
                # b_frac is Fraction
                b = b_frac
                # compute sqrt(4 - b^2) rational? Need to ensure it's rational.
                # We'll compute discriminant sqrt rational if 4 - b^2 is a rational square.
                # We'll just compute a using formula with sqrt rational if possible.
                # We'll compute a using both signs and check rational.
                # Since we need sqrt rational, we will compute sqrt rational by checking if numerator and denominator are perfect squares.
                # Represent 4 - b^2 as Fraction.
                four = Fraction(4,1)
                val = four - b*b
                # check if val is non-negative and perfect square rational
                if val < 0:
                    return []
                # val = p/q in lowest terms
                p = val.numerator
                q = val.denominator
                # check perfect squares
                import math
                sqrt_p = int(math.isqrt(p))
                sqrt_q = int(math.isqrt(q))
                if sqrt_p*sqrt_p != p or sqrt_q*sqrt_q != q:
                    return []  # not perfect square rational
                sqrt_val = Fraction(sqrt_p, sqrt_q)
                # compute sqrtΔ = 4*b*sqrt_val
                sqrtΔ = Fraction(4,1) * b * sqrt_val
                # compute a candidates
                numerator_plus = 2*b*b + 4 + sqrtΔ
                numerator_minus = 2*b*b + 4 - sqrtΔ
                denom = 2*(5*b*b - 2)
                a_candidates = []
                for num in [numerator_plus, numerator_minus]:
                    if denom != 0:
                        a = num / denom
                        # simplify
                        a = Fraction(a.numerator, a.denominator)  # ensure reduced
                        # check 0 < a < 1
                        if a > 0 and a < 1:
                            a_candidates.append(a)
                return a_candidates
            
            # Let's search for small denominators for b (denominator up to maybe 10)
            solutions = []
            max_den = 10
            for num in range(1, max_den*2+1):  # b between 1 and 2
                for den in range(1, max_den+1):
                    b = Fraction(num, den)
                    if b < 1 or b > 2:
                        continue
                    a_list = compute_solution(b)
                    for a in a_list:
                        # compute x, y
                        x = Fraction(1,2) - a*a/2  # (1 - a^2)/2
                        # compute f = (a+1)^2 / (5 a^2 - 2 a + 1)
                        f = (a+1)*(a+1) / (5*a*a - 2*a + 1)
                        y = b - f
                        # ensure y positive rational
                        if y <= 0:
                            continue
                        # ensure y <= 1/2 (since sqrt(1-2y) defined)
                        if y > Fraction(1,2):
                            continue
                        # compute denominators
                        den_x = x.denominator
                        den_y = y.denominator
                        k = lcm(den_x, den_y)
                        solutions.append((k, x, y, a, b))
            len(solutions)
            
