            def ratio(xs):
                S = sum(xs)
                # compute T
                T = 0
                n = len(xs)
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    g = math.gcd(a,b)
                    l = (b*c)//math.gcd(b,c)
                    T += g * l
                g_all = functools.reduce(math.gcd, xs)
                # ratio = (S**3) / (g_all * T)
                # return as Fraction
                return fractions.Fraction(S**3, g_all * T)
            
