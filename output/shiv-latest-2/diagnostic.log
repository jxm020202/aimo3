            def compute_L(p,q):
                s = math.sqrt(3)
                A = 4*p**2 - 6*p + 3
                # compute r from eq A - q^2 = 2 s (1-p) r
                if abs(1-p) < 1e-12:
                    return None
                r = (A - q**2) / (2*s*(1-p))
                # verify Eq2: r^2 - 2 s (1-p) r - q^2 + 2 p q ≈ 0
                if abs(r**2 - 2*s*(1-p)*r - q**2 + 2*p*q) > 1e-6:
                    return None
                if not (0 <= r <= math.sqrt(3)+1e-6):
                    return None
                L = math.sqrt(q**2 + r**2)
                # also compute other sides to confirm equality
                side1 = L
                side2 = math.sqrt(p**2 + (s*(1-p)-r)**2)
                side3 = math.sqrt((p-q)**2 + 3*(1-p)**2)
                if max(abs(side1-side2), abs(side1-side3)) > 1e-5:
                    return None
                return L, r
            
            def search_grid(n=401):
                minL = 10
                best = None
                for i in range(n):
                    p = i/(n-1)
                    for j in range(n):
