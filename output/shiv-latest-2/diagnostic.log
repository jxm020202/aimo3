            def longest_zero_run(n, max_steps=2000000):
                # compute sequence modulo n
                # initial terms a_k = 2^{k-1} mod n for k=1..n
                b = [pow(2, k-1, n) for k in range(1, n+1)]
                # sliding window sum of last n terms modulo n
                window_sum = sum(b) % n
                longest = 0
                current = 0
                # check initial terms for zeros
                for val in b:
                    if val % n == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                # iterate further
                seen_states = {}
                # store state as tuple of last n values maybe for detection
                # but that is huge; we can store hash?
                # For now we just iterate up to max_steps
                for step in range(n+1, max_steps+1):
                    # next term = window_sum mod n
                    next_val = window_sum % n
                    # update longest run
                    if next_val == 0:
                        current += 1
                        if current > longest:
                            longest = current
                    else:
                        current = 0
                    # update sliding window
                    # remove b[0], add next_val
                    removed = b.pop(0)
                    b.append(next_val)
                    window_sum = (window_sum - removed + next_val) % n
                return longest
            
