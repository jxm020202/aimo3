                ax = Zx - Xx
                ay = Zy - Xy
                bx = Yx - Xx
                by = Yy - Xy
                dot = ax*bx + ay*by
                norm_a = math.hypot(ax, ay)
                norm_b = math.hypot(bx, by)
                cos_theta = dot/(norm_a*norm_b)
                # clamp
                cos_theta = max(-1, min(1, cos_theta))
                theta = math.degrees(math.acos(cos_theta))
                return theta
            
