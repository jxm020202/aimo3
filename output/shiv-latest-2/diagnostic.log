                            row[pos*q + i] = 1
                        A.append(row)
                        b_lb.append(1)
                        b_ub.append(m)  # no upper bound needed, just set large
                A = np.array(A, dtype=int)
                lb = np.zeros(n_vars, dtype=int)
                ub = np.ones(n_vars, dtype=int)
                # define constraints
                lin_con = LinearConstraint(A, b_lb, b_ub)
                bounds = Bounds(lb, ub)
                # solve
                start_time = time.time()
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=np.ones(n_vars, dtype=bool), options={'presolve': True, 'time_limit': time_limit})
