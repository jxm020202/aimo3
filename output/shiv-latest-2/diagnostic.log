            import random, math
            
            def compute_k4(k1,k2,k3):
                B = k1 + k2 + k3 - 1
                A = k1**2 + k2**2 + k3**2
                D = 3*B**2 - 6*A - 6
                if D < 0:
                    return None
                sqrtD = math.sqrt(D)
                # two possible solutions
                k4a = (B + sqrtD)/2
                k4b = (B - sqrtD)/2
                # we need positive k4
                sols = []
                if k4a > 0:
                    sols.append(k4a)
                if k4b > 0:
                    sols.append(k4b)
                return sols
            
            def random_solution():
                for _ in range(10000):
