            import math, numpy as np
            
            def angle_between(p, q):
                # angle between vectors p and q
                dot = np.dot(p,q)
                norm = np.linalg.norm(p)*np.linalg.norm(q)
                return math.degrees(math.acos(max(-1,min(1,dot/norm))))
            
            def directions_at_angle(theta):
                # point on unit circle at angle theta (degrees)
                x = math.cos(math.radians(theta))
                y = math.sin(math.radians(theta))
                return np.array([x,y])
            
            def angle_at_point(point_angle, other_angle):
                p = directions_at_angle(point_angle)
                q = directions_at_angle(other_angle) - p
                return math.degrees(math.atan2(q[1], q[0]))
                
            def angle_between_dirs(point_angle, ang1, ang2):
                p = directions_at_angle(point_angle)
                v1 = directions_at_angle(ang1) - p
                v2 = directions_at_angle(ang2) - p
                return angle_between(v1, v2)
            
