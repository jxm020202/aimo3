            def max_zero_run_fast(n, N):
                # generate sequence modulo n efficiently using sliding window sum
                # a[0] = a1 = 2^0 mod n, a[1] = 2^1 mod n, ..., a[n-1] = 2^{n-1} mod n
                a = [pow(2, k, n) for k in range(n)]
                # compute initial sum of last n terms (i.e., sum of a[0..n-1])
                window_sum = sum(a) % n
                max_run = cur = 0
                # check initial part
                for val in a:
                    if val == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                # generate further terms
                for k in range(n, N):
                    new_val = window_sum % n
                    a.append(new_val)
                    # update sliding sum: add new_val, subtract a[k-n] (the term leaving window)
                    window_sum = (window_sum + new_val - a[k-n]) % n
                    if new_val == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                return max_run
            
            # test for n=10 up to 500k
            print(max_zero_run_fast(10, 500000))
            
