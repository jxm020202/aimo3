            import itertools
            
            def valid_assign(m):
                # assign values 0 or 1 to residues 0..m-1
                for assign in itertools.product([0,1], repeat=m):
                    # skip all equal assignments? we want any
                    ok=True
                    for p in range(m):
                        for a in range(m):
                            lhs = assign[(a+p)%m]
                            if lhs != assign[a] and lhs != assign[p]:
                                ok=False
                                break
                        if not ok:
                            break
                    if ok:
                        # return assignment
                        return assign
                return None
            
            for m in range(2,9):
                assign = valid_assign(m)
