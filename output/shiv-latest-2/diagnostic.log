            def regular_polygon_vertices(m, radius=1):
                return [(radius*math.cos(2*math.pi*k/m), radius*math.sin(2*math.pi*k/m)) for k in range(m)]
            
            def edge_midpoint(p1, p2):
                return ((p1[0]+p2[0])/2, (p1[1]+p2[1])/2)
            
            def line_from_points(p,q):
                # return (A,B,C) for line Ax+By+C=0
                (x1,y1),(x2,y2)=p,q
                A = y1 - y2
                B = x2 - x1
                C = x1*y2 - x2*y1
                return (A,B,C)
            
            def intersect_lines(l1,l2):
                A1,B1,C1 = l1
                A2,B2,C2 = l2
                det = A1*B2 - A2*B1
                if abs(det) < 1e-9:
                    return None
                x = (B1*C2 - B2*C1)/det
                y = (C1*A2 - C2*A1)/det
                return (x,y)
            
            def point_inside_polygon(pt, poly):
                # ray casting
                x,y = pt
                inside=False
                n=len(poly)
                for i in range(n):
                    x1,y1=poly[i]
                    x2,y2=poly[(i+1)%n]
                    if ((y1>y) != (y2>y)):
                        xinters = (x2-x1)*(y-y1)/(y2-y1)+x1
                        if x < xinters:
                            inside = not inside
                return inside
            
