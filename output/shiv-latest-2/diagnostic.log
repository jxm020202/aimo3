            def excenter_opposite_F(D,E,F):
                # excenter opposite F: intersection of external bisectors at D and E, internal bisector at F.
                # Use sympy geometry for excenter? We'll compute using formula: excenter coordinates ( -a*D + b*E + c*F ) / (-a+b+c) ??? Not.
                # General formula: excenter opposite A (vertex A) is (-a*Ax + b*Bx + c*Cx)/(-a+b+c) etc.
                # For triangle with vertices D,E,F, side lengths opposite D,E,F are a,b,c as before.
                D = sp.Point(D); E = sp.Point(E); F = sp.Point(F)
                a = sp.sqrt((E.x-F.x)**2 + (E.y-F.y)**2)  # opposite D
                b = sp.sqrt((D.x-F.x)**2 + (D.y-F.y)**2)  # opposite E
                c = sp.sqrt((D.x-E.x)**2 + (D.y-E.y)**2)  # opposite F
                # excenter opposite F (I_F) coordinates:
                # I_F = (a*D + b*E - c*F) / (a + b - c)
                # Wait sign: excenter opposite A (vertex A) uses -a for that vertex.
                I_F = (a*D + b*E - c*F) / (a + b - c)
                return I_F
            
