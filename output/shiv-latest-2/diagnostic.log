            def max_visible(points, i, angle_deg=100):
                # points: list of (x,y)
                # compute directions from point i to all other points
                xi, yi = points[i]
                dirs = []
                for j, (xj, yj) in enumerate(points):
                    if j == i: continue
                    dx, dy = xj - xi, yj - yi
                    theta = math.atan2(dy, dx)  # -pi to pi
                    dirs.append(theta)
                # sort angles
                dirs.sort()
                # duplicate with +2π for wrap-around
                dirs2 = dirs + [theta + 2*math.pi for theta in dirs]
                maxcnt = 0
                angle = math.radians(angle_deg)
                # sliding window
                j = 0
                n = len(dirs)
                for i_start in range(n):
                    while j < i_start + n and dirs2[j] - dirs2[i_start] <= angle + 1e-12:
                        j += 1
                    cnt = j - i_start
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
