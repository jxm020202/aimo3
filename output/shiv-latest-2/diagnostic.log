                e = np.array([math.cos(angles[1]), math.sin(angles[1])])
                f = np.array([math.cos(angles[2]), math.sin(angles[2])])
                # side lengths
                a = np.linalg.norm(e - f)  # opposite D
                b = np.linalg.norm(d - f)  # opposite E
                c = np.linalg.norm(d - e)  # opposite F
                # incenter Q
                Q = (a*d + b*e + c*f) / (a + b + c)
                # line L: Q·X = |Q|^2
                # Intersection with DE line
                # param t: X = d + t*(e-d)
                # Solve Q·(d + t*(e-d)) = |Q|^2
                v_de = e - d
                t = (np.dot(Q, Q) - np.dot(Q, d)) / np.dot(Q, v_de)
                M = d + t * v_de
                # Intersection with external bisector at F
