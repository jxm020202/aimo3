            import math
            from fractions import Fraction
            
            def find_solutions(limit):
                sols = []
                for p in range(1, limit+1):
                    for q in range(1, limit+1):
                        # compute RHS for m^2
                        val = 10*q*q - 4*p*p
                        if val < 0:
                            continue
                        m = int(math.isqrt(val))
                        if m*m != val:
                            continue
                        # we have integer m >=0
                        # consider both signs
                        for sign in (-1, 1):
                            # compute s
                            if sign == -1:
                                # case A: s = (p - m)/(5p)
                                if p <= m:
                                    continue
                                s = Fraction(p - m, 5*p)
                            else:
                                # case B: s = (p + m)/(5p)
                                if m >= 4*p:
                                    continue
                                s = Fraction(p + m, 5*p)
                            # ensure 0 < s < 1
                            if not (0 < s < 1):
                                continue
                            # compute t = (s+1)*(p/q) - 1
                            t = (s + 1) * Fraction(p, q) - 1
                            if not (0 < t < 1):
                                continue
                            # compute x,y
                            x = Fraction(1,2) - s*s/2  # (1 - s^2)/2
                            y = Fraction(1,2) - t*t/2
                            # compute denominators
                            den_x = x.denominator
                            den_y = y.denominator
                            # compute k minimal = lcm of denominators
                            k = math.lcm(den_x, den_y)
                            sols.append((k, p,q,m,sign,s,t,x,y))
                return sols
            
            sols = find_solutions(30)
            len(sols)
            
