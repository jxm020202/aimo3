            def max_angle_spread(points, i):
                # compute angles of vectors from point i to others
                xi, yi = points[i]
                angles = []
                for j, (xj, yj) in enumerate(points):
                    if j == i: continue
                    ang = math.atan2(yj-yi, xj-xi)
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate with +2π for wrap-around
                angles2 = angles + [a+2*math.pi for a in angles]
                # find minimal interval length covering all points (i.e., max gap)
                max_gap = 0
                n = len(angles)
                for k in range(n):
