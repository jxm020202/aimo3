            def is_convex(poly):
                n = len(poly)
                sign = None
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    x3,y3 = poly[(i+2)%n]
                    # vectors
                    v1 = (x2 - x1, y2 - y1)
                    v2 = (x3 - x2, y3 - y2)
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    if cross == 0:
                        continue
                    cur_sign = cross > 0
                    if sign is None:
                        sign = cur_sign
                    elif sign != cur_sign:
