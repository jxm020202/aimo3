            import sympy as sp, math, sys, itertools, collections, time, functools, random, math, numpy as np, sys, math, itertools, collections, time, math
            def lcm_sliding(n, max_k):
                # compute x_k for k=1..max_k
                # maintain max exponents dict
                max_exp = collections.defaultdict(int)
                # also maintain for each prime a multiset of exponents counts per number in window
                # We'll keep list of factorizations for numbers in current window
                factorizations = [sp.factorint(i) for i in range(1, n+1)]  # index 0 corresponds to number 1
                # initialize max_exp
                for f in factorizations:
                    for p, e in f.items():
                        if e > max_exp[p]:
                            max_exp[p] = e
                xs = []
                # compute lcm from max_exp
                def compute_lcm_from_max():
                    res = 1
                    for p, e in max_exp.items():
                        res *= p**e
                    return res
                xs.append(compute_lcm_from_max())
                # slide window
                for k in range(2, max_k+1):
                    # remove number k-1, add number k+n-1
                    out_num = k-1
                    in_num = k+n-1
                    out_f = factorizations.pop(0)  # factorization of out_num
                    # recompute max_exp for primes that might be affected
                    # We'll recompute max_exp for each prime p in out_f by scanning remaining window
                    for p, e in out_f.items():
                        if max_exp[p] == e:
                            # need to recompute max exponent for p among current window
                            max_e = 0
                            for f in factorizations:
                                if p in f and f[p] > max_e:
                                    max_e = f[p]
                            max_exp[p] = max_e
                    # add new number factorization
                    in_f = sp.factorint(in_num)
                    factorizations.append(in_f)
                    for p, e in in_f.items():
                        if e > max_exp[p]:
                            max_exp[p] = e
                    xs.append(compute_lcm_from_max())
                return xs
            
            def is_eventually_strict_increasing_sliding(n, max_k=5000):
                xs = lcm_sliding(n, max_k)
                last_eq = -1
                for i in range(1, len(xs)):
                    if xs[i] < xs[i-1]:
                        return False, None
                    if xs[i] == xs[i-1]:
                        last_eq = i
                return True, last_eq+1
            
            def find_good_ns(limit_n=150, max_k=5000):
                good = []
