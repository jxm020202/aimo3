                Q = sp.geometry.Triangle(D,E,F).incenter
                # direction vector v = P - Q
                v = sp.Matrix([P.x - Q.x, P.y - Q.y])
                # perpendicular direction w = rotate v by 90 deg (counterclockwise)
                w = sp.Matrix([-v[1], v[0]])
                # line L: Q + t*w
