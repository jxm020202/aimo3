            def find_cycle_length(n, max_steps=20000000):
                # Floyd's cycle detection
                # initial state: a_1..a_n
                init = tuple(pow(2, k, n) for k in range(n))
                tortoise = next_state(init, n)
                hare = next_state(next_state(init, n), n)
                steps = 0
                while tortoise != hare and steps < max_steps:
                    tortoise = next_state(tortoise, n)
                    hare = next_state(next_state(hare, n), n)
                    steps += 1
                if steps >= max_steps:
                    return None
                # find mu (start of cycle)
                mu = 0
                tortoise = init
                while tortoise != hare:
                    tortoise = next_state(tortoise, n)
                    hare = next_state(hare, n)
                    mu += 1
                # find lambda (cycle length)
                lam = 1
                hare = next_state(tortoise, n)
                while tortoise != hare:
                    hare = next_state(hare, n)
                    lam += 1
                return mu, lam
            
