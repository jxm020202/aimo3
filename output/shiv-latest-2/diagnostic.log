                        u = dx*cos + dy*sin
                        v = -dx*sin + dy*cos
                        inside = (np.abs(u) <= 0.5) & (np.abs(v) <= 0.5)
                        covered |= inside
                    covered_total += covered.sum()
                    remaining -= n
                uncovered_frac = 1 - covered_total/total_samples
