                r = ratio_for_triangle(D,E,F)
                # compute coordinates of M,N as earlier
                D = np.array(D,float);E=np.array(E,float);F=np.array(F,float)
                # circumcenter
                A = np.array([[2*(E[0]-D[0]), 2*(E[1]-D[1])],
                              [2*(F[0]-D[0]), 2*(F[1]-D[1])]])
                b = np.array([E[0]**2+E[1]**2 - D[0]**2 - D[1]**2,
                              F[0]**2+F[1]**2 - D[0]**2 - D[1]**2])
                P = np.linalg.solve(A,b)
                a = np.linalg.norm(E-F)
                b_len = np.linalg.norm(D-F)
                c = np.linalg.norm(D-E)
                Q = (a*D + b_len*E + c*F)/(a+b_len+c)
                v = P - Q
                w = np.array([-v[1], v[0]])
                # M
                DE = E-D
                cross = lambda a,b: a[0]*b[1] - a[1]*b[0]
                tM = -cross(Q - D, DE) / cross(w, DE)
                M = Q + tM*w
                # N
                uFD = (D - F)/np.linalg.norm(D-F)
                uFE = (E - F)/np.linalg.norm(E-F)
                w_ext = uFD - uFE
                A_mat = np.column_stack((w, -w_ext))
                b_vec = F - Q
                ts = np.linalg.solve(A_mat, b_vec)
                tN = ts[0]
                N = Q + tN*w
                return Q,M,N, tM, tN
            
