            import math
            
            def ord_mod(a, n):
                # compute multiplicative order of a modulo n, assuming gcd(a,n)=1
                # return order
                if math.gcd(a,n)!=1:
                    return None
                # compute using Euler's theorem: order divides phi(n)
                phi = sympy.totient(n)
                # factor phi
                # We'll compute smallest d dividing phi such that a**d % n == 1
                # factor phi into divisors
                # Use sympy divisors
                import sympy as sp
                for d in sorted(sp.divisors(phi)):
                    if pow(a, d, n) == 1:
                        return d
                return None
            
            def count_cycles(m):
                # m not divisible by 3
                total = 0
                import sympy as sp
                for e in sp.divisors(m):
                    if e == 1:
                        continue
                    # compute order of 3 modulo e
                    if math.gcd(3, e) != 1:
                        # but m not divisible by 3, so e not divisible by 3 either
                        continue
                    ord_e = ord_mod(3, e)
                    total += sp.totient(e) // ord_e
                return total
            
            # test for m=10
            print(count_cycles(10))
            
