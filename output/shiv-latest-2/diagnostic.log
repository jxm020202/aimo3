            def circumcenter(A, B, C):
                # using sympy for exact? Let's use numpy floats for now.
                # Compute intersection of perpendicular bisectors.
                # Solve linear equations for center (x,y)
                Ax,Ay = A
                Bx,By = B
                Cx,Cy = C
                # Midpoints
                D = ((Ax+Bx)/2, (Ay+By)/2)
                E = ((Ax+Cx)/2, (Ay+Cy)/2)
                # direction vectors of AB and AC
                vAB = (Bx-Ax, By-Ay)
                vAC = (Cx-Ax, Cy-Ay)
                # perpendicular directions
                perpAB = (-vAB[1], vAB[0])
                perpAC = (-vAC[1], vAC[0])
                # Solve for intersection: D + s*perpAB = E + t*perpAC
                # => s*perpAB - t*perpAC = E - D
                import numpy.linalg as la
                M = np.array([[perpAB[0], -perpAC[0]],
                              [perpAB[1], -perpAC[1]]], dtype=float)
                b = np.array([E[0]-D[0], E[1]-D[1]], dtype=float)
                s,t = la.solve(M,b)
                center = (D[0] + s*perpAB[0], D[1] + s*perpAB[1])
                return center
            
            def incenter(A, B, C):
                # using side lengths
                a = math.hypot(B[0]-C[0], B[1]-C[1])
                b = math.hypot(A[0]-C[0], A[1]-C[1])
                c = math.hypot(A[0]-B[0], A[1]-B[1])
                px = (a*A[0] + b*B[0] + c*C[0])/(a+b+c)
                py = (a*A[1] + b*B[1] + c*C[1])/(a+b+c)
                return (px, py)
            
            def line_through(p1, p2):
                # returns (A,B,C) for line Ax + By + C = 0
                x1,y1 = p1
                x2,y2 = p2
                A = y1 - y2
                B = x2 - x1
                C = x1*y2 - x2*y1
                return (A,B,C)
            
            def intersect_lines(L1, L2):
                A1,B1,C1 = L1
                A2,B2,C2 = L2
                det = A1*B2 - A2*B1
                if abs(det) < 1e-12:
                    return None
                x = (B1*C2 - B2*C1)/det
                y = (C1*A2 - C2*A1)/det
                return (x,y)
            
            def external_bisector_at_F(A, B, C):
                # external bisector of angle at C (i.e., F). Input triangle vertices D,E,F as A,B,C.
                # external bisector direction vector is sum of unit vectors along CA and CB but one with opposite sign?
                # For internal bisector, direction = unit(CA) + unit(CB). For external bisector, direction = unit(CA) - unit(CB) (or opposite).
                # Actually external bisector is line through C that bisects angle between extensions of CA and CB outward.
                # Vector directions: from C to A (CA) and from C to B (CB). Internal bisector direction = unit(CA) + unit(CB).
                # External bisector direction = unit(CA) - unit(CB) (or unit(CB) - unit(CA)). Both give same line.
                import numpy as np
                CA = np.array([A[0]-C[0], A[1]-C[1]], dtype=float)
                CB = np.array([B[0]-C[0], B[1]-C[1]], dtype=float)
                # Normalize
                normCA = np.linalg.norm(CA)
                normCB = np.linalg.norm(CB)
                if normCA==0 or normCB==0:
                    return None
                uCA = CA/normCA
                uCB = CB/normCB
                dir_vec = uCA - uCB
                # line through C with direction dir_vec
                # param: C + t*dir_vec
                # Convert to line equation
                # direction (dx,dy) = dir_vec
                dx,dy = dir_vec
                # line equation: (dy)*(x - Cx) - (dx)*(y - Cy) = 0 => dy*x - dx*y + ( -dy*Cx + dx*Cy) =0
                Acoeff = dy
                Bcoeff = -dx
                Ccoeff = -dy*C[0] + dx*C[1]
                return (Acoeff, Bcoeff, Ccoeff)
            
            def ratio_QM_QN(D,E,F):
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line L through Q perpendicular to PQ
                # direction of PQ: (P - Q)
                dx = P[0]-Q[0]
                dy = P[1]-Q[1]
                # perpendicular direction: (-dy, dx)
                # line through Q with direction (-dy,dx)
                # line equation:
                A = -dx  # because direction vector (dx,dy) normal to line is (dx,dy). For line perpendicular to PQ, normal vector is direction of PQ.
                B = -dy
                # Wait: line L is perpendicular to PQ, so its direction vector is perpendicular to vector PQ. So line L's normal vector is direction of L's perpendicular? Let's compute properly.
                # L direction = (-dy, dx)
                # So line equation: (dx)*x + (dy)*y + C = 0? Actually normal vector to line L is perpendicular to direction vector (-dy,dx), which is (dx,dy). So line L's equation: dx*x + dy*y + C =0.
                # Determine C such that passes through Q: dx*Qx + dy*Qy + C =0 => C = -(dx*Qx + dy*Qy)
                Ccoeff = -(dx*Q[0] + dy*Q[1])
                L = (dx, dy, Ccoeff)
                # Intersection with DE
                L_DE = line_through(D,E)
                M = intersect_lines(L, L_DE)
                # External bisector at F
                L_extF = external_bisector_at_F(D,E,F)
                N = intersect_lines(L, L_extF)
                if M is None or N is None:
                    return None
                QM = math.hypot(M[0]-Q[0], M[1]-Q[1])
                QN = math.hypot(N[0]-Q[0], N[1]-Q[1])
                return QM/QN
            
