            def interior_angle_oriented(prev, vertex, nxt):
                # vectors: prev->vertex (incoming), vertex->nxt (outgoing)
                v_in = sp.Matrix([vertex.x - prev.x, vertex.y - prev.y])  # direction into vertex
                v_out = sp.Matrix([nxt.x - vertex.x, nxt.y - vertex.y])  # direction out
                dot = v_in.dot(v_out)
                norm_in = sp.sqrt(v_in.dot(v_in))
                norm_out = sp.sqrt(v_out.dot(v_out))
                angle = sp.acos(dot/(norm_in*norm_out))  # between 0 and pi
                # cross product to determine turn direction
                cross = v_in[0]*v_out[1] - v_in[1]*v_out[0]
                if cross >= 0:
                    # left turn, interior angle = angle
                    return angle
                else:
                    # right turn, interior angle = 2*pi - angle
                    return 2*sp.pi - angle
            
            def interior_angles(poly):
                n = len(poly)
                angles = []
                for i in range(n):
                    prev = poly[(i-1)%n]
                    vertex = poly[i]
                    nxt = poly[(i+1)%n]
                    angles.append(interior_angle_oriented(prev, vertex, nxt))
                return angles
            
