            import sympy as sp
            
            def ratio_for_triangle(D,E,F):
                # D,E,F are sympy Point2D
                # circumcenter P
                P = sp.geometry.Triangle(D,E,F).circumcircle.center
                # incenter Q
                Q = sp.geometry.Triangle(D,E,F).incenter
                # line PQ
                line_PQ = sp.Line(P, Q)
                # line through Q perpendicular to PQ
                perp_line = line_PQ.perpendicular_line(Q)
                # intersection with DE
                M = perp_line.intersection(sp.Line(D,E))[0]
                # external bisector of angle F: need line through F that bisects external angle at F.
                # internal angle bisector direction: sum of unit vectors along FD and FE.
                # external bisector direction: difference of unit vectors? Actually external bisector is perpendicular to internal bisector.
                # But we can compute using angle bisector theorem: internal bisector divides opposite side proportionally to adjacent sides.
                # For external bisector, direction vector is normalized difference of unit vectors along FD and FE.
                # Let's compute unit vectors from F to D and F to E.
                FD = D - F
                FE = E - F
                # unit vectors
                FD_u = FD / sp.sqrt(FD.dot(FD))
                FE_u = FE / sp.sqrt(FE.dot(FE))
                # internal bisector direction = FD_u + FE_u
                # external bisector direction = FD_u - FE_u (or FE_u - FD_u) whichever points outward.
                ext_dir = FD_u - FE_u
                # line through F with direction ext_dir
                line_ext = sp.Line(F, F + ext_dir)
                N = perp_line.intersection(line_ext)[0]
                QM = Q.distance(M)
                QN = Q.distance(N)
                return sp.simplify(QM/QN)
            
            # test with random triangle
            D = sp.Point(0,0)
            E = sp.Point(5,0)
            F = sp.Point(2,3)
            ratio = ratio_for_triangle(D,E,F)
            ratio
            
