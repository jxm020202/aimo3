            def compute_points(D,E,F):
                D = np.array(D); E=np.array(E); F=np.array(F)
                # side lengths
                a = np.linalg.norm(E-F)
                b = np.linalg.norm(D-F)
                c = np.linalg.norm(D-E)
                # circumcenter O
                A = np.array([2*(E-D), 2*(F-D)], float)
                B = np.array([np.dot(E,E)-np.dot(D,D), np.dot(F,F)-np.dot(D,D)], float)
                O = np.linalg.solve(A,B)
                # incenter I
                I = (a*D + b*E + c*F)/(a+b+c)
                # excenter opposite D (I_D): intersection of external bisectors at D and internal at others? formula: I_D = (-a*D + b*E + c*F)/(-a+b+c)
                # General excenter opposite vertex A: I_A = (-a*A + b*B + c*C)/(-a+b+c)
                I_D = (-a*D + b*E + c*F)/(-a+b+c)
                I_E = (a*D - b*E + c*F)/(a-b+c)
                I_F = (a*D + b*E - c*F)/(a+b-c)
                return O,I,I_D,I_E,I_F
            
            def test_midpoint_on_radical(D,E,F):
                O,I,I_D,I_E,_ = compute_points(D,E,F)
                # radical axis line: through I, direction perpendicular to OI
