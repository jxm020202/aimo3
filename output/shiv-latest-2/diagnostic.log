            def order_mod(a, mod):
                # return multiplicative order of a modulo mod, assuming gcd(a,mod)=1
                if math.gcd(a, mod) != 1:
                    return None
                phi = sp.totient(mod)
                # find smallest divisor d of phi such that a^d ≡ 1 mod mod
                for d in sp.divisors(phi):
                    if pow(a, d, mod) == 1:
                        return d
                return None
            
