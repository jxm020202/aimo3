            import mpmath as mp
            mp.mp.dps = 50
            
            def G_of_x(x):
                # x is mp.mpf
                # compute sqrt term
                s = mp.sqrt(1 - 2*x)
                term1 = (4*x - 2 + 2*s) / (3 - 5*x - s)
                # compute cube root terms
                A = (1 + x**2) / 2
                B = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2) / 6
                # real cube roots: use mp.sign? mp.nthroot?
                # mp.nthroot returns principal root (complex). For real, we can use mp.sign?
                # For real numbers, cube root of real is real. A+B and A-B should be positive? Not sure.
                # Use mp.nthroot with exponent 1/3.
                c1 = mp.nthroot(A + B, 3)
                c2 = mp.nthroot(A - B, 3)
                term2 = c1 + c2
                return term1 + term2
            
