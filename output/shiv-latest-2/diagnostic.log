            def excenter_opposite_F(D,E,F):
                # excenter opposite vertex F: intersection of external bisectors at D and E and internal bisector at F
                # Using formula: excenter coordinates = (-a*D + b*E + c*F)/(-a+b+c) where a=|EF| opposite D, etc.
                a = np.linalg.norm(E-F) # opposite D
                b = np.linalg.norm(D-F) # opposite E
                c = np.linalg.norm(D-E) # opposite F
                # excenter opposite F uses signs: (-a, -b, c)?? Let's recall formula:
                # Incenter: (a*D + b*E + c*F)/(a+b+c)
                # Excenter opposite A (here D) uses (-a*D + b*E + c*F)/(-a+b+c)
                # So excenter opposite F uses (a*D + b*E - c*F)/(a+b-c)
                I_F = (a*D + b*E - c*F)/(a+b-c)
                return I_F
            
            def compute_N(D,E,F):
                a = np.linalg.norm(E-F)
                b = np.linalg.norm(D-F)
                c = np.linalg.norm(D-E)
                I = (a*D + b*E + c*F)/(a+b+c)
                v = np.array([-I[1], I[0]])
                # external bisector at F direction w = u1 - u2
                u1 = (D-F)/np.linalg.norm(D-F)
                u2 = (E-F)/np.linalg.norm(E-F)
                w = u1 - u2
                # solve for intersection
                A2 = np.column_stack((v, -w))
                rhs2 = F - I
                t_N = np.linalg.solve(A2, rhs2)[0]
                N = I + t_N * v
                return N, I
            
            def test():
                angles = sorted([random.random()*2*math.pi for _ in range(3)])
                D = np.array([math.cos(angles[0]), math.sin(angles[0])])
                E = np.array([math.cos(angles[1]), math.sin(angles[1])])
                F = np.array([math.cos(angles[2]), math.sin(angles[2])])
                N, I = compute_N(D,E,F)
                I_F = excenter_opposite_F(D,E,F)
                # compute distance between N and I_F
                return np.linalg.norm(N - I_F)
            
            for _ in range(5):
