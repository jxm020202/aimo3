            def find_cycle_mod_n(n, max_steps=5000000):
                # returns (preperiod length, period length) if found, else None
                # state is tuple of last n terms
                a = [pow(2, k, n) for k in range(n)]
                window_sum = sum(a) % n
                # dictionary mapping state to index (the index of the last term)
                # we can store state after each step (i.e., after computing term at position idx)
                seen = {}
                # initial state: tuple of a[-n:] (which is a itself)
                state = tuple(a[-n:])
                seen[state] = n-1  # index of last term (0-indexed)
                idx = n-1
                while idx < max_steps-1:
                    # compute next term
                    next_val = window_sum
                    # update sliding window
                    out_val = a[idx - n + 1]  # the term that will be removed (a_{idx-n+2}?) Let's verify.
                    # Actually a list a currently length idx+1 (since idx is last index)
                    # We will append next_val
                    a.append(next_val)
                    idx += 1
                    # update window sum: add next_val, subtract the term that is n positions before new term
                    # The term that slides out is a[idx - n] (since after appending, new term at idx)
                    out_val = a[idx - n]
                    window_sum = (window_sum + next_val - out_val) % n
                    # new state is last n terms
                    state = tuple(a[-n:])
                    if state in seen:
                        start_idx = seen[state]
                        preperiod = start_idx + 1  # index of first occurrence of state
                        period = idx - start_idx
                        return preperiod, period, a
                    seen[state] = idx
                return None
            
