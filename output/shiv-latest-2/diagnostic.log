            def count_independent_sets(n_rows=18, n_cols=18):
                # generate all row masks with no adjacent 1s (horizontal adjacency)
                masks = []
                for mask in range(1<<n_cols):
                    # check no adjacent bits
                    if mask & (mask<<1):
                        continue
                    masks.append(mask)
                # precompute compatibility between rows: no vertical or diagonal adjacency
                compat = {}
                for m1 in masks:
                    comp = []
                    for m2 in masks:
                        # vertical adjacency: same column
                        if m1 & m2:
                            continue
                        # diagonal adjacency: shift left/right
                        if (m1<<1) & m2:
                            continue
                        if (m1>>1) & m2:
                            continue
                        comp.append(m2)
                    compat[m1] = comp
                # DP: dp[row][mask] = number of ways up to this row ending with mask
                dp = {mask: 1 for mask in masks}  # first row
                for _ in range(1, n_rows):
                    newdp = {mask: 0 for mask in masks}
                    for prev_mask, cnt in dp.items():
                        for mask in compat[prev_mask]:
                            newdp[mask] += cnt
                    dp = newdp
                total = sum(dp.values())
                return total
            
            print(count_independent_sets())
            
