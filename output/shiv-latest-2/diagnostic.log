            import math, itertools, random, fractions
            
            def compute_G(xs):
                G = xs[0]
                for x in xs[1:]:
                    G = math.gcd(G, x)
                return G
            
            def compute_T(xs):
                n = len(xs)
                total = 0
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    g = math.gcd(a,b)
                    l = (b*c)//math.gcd(b,c)
                    total += g*l
                return total
            
            def ratio(xs):
                S = sum(xs)
                G = compute_G(xs)
                T = compute_T(xs)
                return fractions.Fraction(S**3, G * T)
            
            def random_search_min(iterations, max_val):
                best = None
                best_tuple = None
                for _ in range(iterations):
                    xs = [random.randint(1, max_val) for _ in range(6)]
                    G = compute_G(xs)
                    if G > 1:
                        xs = [x//G for x in xs]
                    r = ratio(xs)
                    if best is None or r < best:
                        best = r
                        best_tuple = xs[:]
                return best, best_tuple
            
            best, tup = random_search_min(500000, 2000)
            print(best, float(best), tup)
            
