            import numpy as np, random, math
            
            def ratio_numeric(D,E,F):
                D = np.array(D, dtype=float)
                E = np.array(E, dtype=float)
                F = np.array(F, dtype=float)
                # side lengths
                a = np.linalg.norm(E-F) # opposite D
                b = np.linalg.norm(D-F) # opposite E
                c = np.linalg.norm(D-E) # opposite F
                # circumcenter P: using formula via perpendicular bisectors
                # Solve linear equations for center (x,y) such that distances to D,E,F equal.
                # Use matrix method.
                # (x - D)^2 = (x - E)^2 => 2*(E-D).dot(x) = |E|^2 - |D|^2
                # similarly with F.
                A = np.array([2*(E-D), 2*(F-D)])
                B = np.array([np.dot(E,E)-np.dot(D,D), np.dot(F,F)-np.dot(D,D)])
                P = np.linalg.solve(A, B)
                # incenter Q: weighted average by side lengths
                Q = (a*D + b*E + c*F) / (a+b+c)
                v = P - Q
                # perpendicular direction w
                w = np.array([-v[1], v[0]])
                # Solve for intersection with DE: Q + t*w = D + s*(E-D)
                # 2 equations, unknown t,s
                M = np.column_stack((w, -(E-D)))  # Q + t*w = D + s*(E-D) => t*w + s*(D-E) = D - Q
                rhs = D - Q
                # Solve linear system M*[t,s]^T = rhs
                sol = np.linalg.lstsq(M, rhs, rcond=None)[0]
                tM = sol[0]
                # external bisector direction at F
                u1 = D - F
                u2 = E - F
                norm_u1 = np.linalg.norm(u1)
                norm_u2 = np.linalg.norm(u2)
                u1 = u1 / norm_u1
                u2 = u2 / norm_u2
                ext_dir = u1 - u2
                # Solve Q + t*w = F + s2*ext_dir
                M2 = np.column_stack((w, -ext_dir))
                rhs2 = F - Q
                sol2 = np.linalg.lstsq(M2, rhs2, rcond=None)[0]
                tN = sol2[0]
                ratio = abs(tM)/abs(tN)
                return ratio
            
            def test_random(n=20):
                ratios = []
                for i in range(n):
                    while True:
                        D = (random.uniform(-5,5), random.uniform(-5,5))
                        E = (random.uniform(-5,5), random.uniform(-5,5))
