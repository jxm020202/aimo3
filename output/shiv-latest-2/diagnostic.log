            def max_zero_run_mod_n(n, max_terms=2000000):
                # compute sequence modulo n, track max zero run
                # Use list for last n values as circular buffer
                from collections import deque
                # initial terms
                a = [0]*(n+1)  # 1-indexed
                for k in range(1, n+1):
                    a[k] = pow(2, k-1, n)
                # track last n terms in deque
                last = deque([a[k] for k in range(1, n+1)], maxlen=n)
                max_run = 0
                cur = 0
                # check initial terms for zeros
                for k in range(1, n+1):
                    if a[k]==0:
                        cur+=1
                        max_run = max(max_run, cur)
                    else:
                        cur=0
                # iterate further
                for k in range(n+1, max_terms+1):
                    s = sum(last) % n
                    # update run
                    if s==0:
                        cur+=1
                        max_run = max(max_run, cur)
                    else:
                        cur=0
                    # update deque
                    last.append(s)
                return max_run
            
