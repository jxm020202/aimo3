            def contains_integer_point(cx, cy, theta):
                # compute bounding box half-extent in x,y after rotation
                # Actually we can just iterate over integer points near center
                # Determine range of i and j to check
                # The square's half-diagonal length is sqrt(2)/2 ~0.7071, but due to rotation, the max distance along x or y is (cosθ+sinθ)/2
                L = math.cos(theta) + math.sin(theta)  # width of bounding box
                half = L/2.0
                i_min = math.floor(cx - half) - 1
                i_max = math.ceil(cx + half) + 1
                j_min = math.floor(cy - half) - 1
                j_max = math.ceil(cy + half) + 1
                cos_t = math.cos(theta)
                sin_t = math.sin(theta)
                for i in range(i_min, i_max+1):
                    dx = i - cx
                    for j in range(j_min, j_max+1):
                        dy = j - cy
                        # rotate by -theta: u = dx*cos + dy*sin, v = -dx*sin + dy*cos
                        u = dx * cos_t + dy * sin_t
                        v = -dx * sin_t + dy * cos_t
                        if abs(u) <= 0.5 + 1e-12 and abs(v) <= 0.5 + 1e-12:
                            return True
                return False
            
