            import itertools
            
            def independent_sets(n):
                # generate all subsets of cells (0..n*n-1) that are independent (no adjacency including diagonal)
                cells = [(i,j) for i in range(n) for j in range(n)]
                # adjacency function
                def adjacent(c1,c2):
                    return max(abs(c1[0]-c2[0]), abs(c1[1]-c2[1])) <= 1
                indep=[]
                for r in range(1<< (n*n)):
                    # quick prune: if size <2 skip? We'll include all for now.
                    subset=[cells[i] for i in range(n*n) if (r>>i)&1]
                    ok=True
                    for i in range(len(subset)):
                        for j in range(i+1,len(subset)):
                            if adjacent(subset[i], subset[j]):
                                ok=False
                                break
                        if not ok:
                            break
                    if ok:
                        indep.append(set(subset))
                return indep
            
            def min_distinguishing_set(n):
                indep=independent_sets(n)
                # filter to size>=2
                indep2=[s for s in indep if len(s)>=2]
                cells=[(i,j) for i in range(n) for j in range(n)]
                N=len(cells)
                best=N+1
                bestsets=[]
                for k in range(N+1):
                    # iterate subsets of size k
                    for combo in itertools.combinations(range(N), k):
                        Q=[cells[i] for i in combo]
                        # compute signatures
                        sigs={}
                        ok=True
                        for s in indep2:
                            # signature: tuple of 0/1 for each q in Q
                            sig=tuple(1 if q in s else 0 for q in Q)
                            if sig in sigs:
                                ok=False
                                break
                            sigs[sig]=s
                        if ok:
                            best=k
                            bestsets=[Q]
                            print(f"found size {k}")
                            return best, bestsets
                    # if not found, continue
                return None
            
