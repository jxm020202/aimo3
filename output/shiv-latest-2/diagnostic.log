            import math
            
            def point_inside_triangle(P, D, E, F):
                # using barycentric coordinates via cross product sign
                # Compute vectors
                def area(a,b,c):
                    return (b[0]-a[0])*(c[1]-a[1]) - (b[1]-a[1])*(c[0]-a[0])
                # Compute signs
                a1 = area(P, D, E)
                a2 = area(P, E, F)
                a3 = area(P, F, D)
                # For point inside (including boundary), all have same sign (>=0) or (<=0)
                # Since triangle orientation? Let's compute orientation of triangle D,E,F
                orient = area(D,E,F)
                if orient > 0:
