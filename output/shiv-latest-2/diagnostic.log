            def max_zero_run_limit(n, max_steps=2000000):
                # fast sliding sum
                window = [pow(2, k-1, n) for k in range(1, n+1)]
                sum_window = sum(window) % n
                maxrun = 0
                cur = 0
                # initial
                for val in window:
                    if val == 0:
                        cur += 1
                        maxrun = max(maxrun, cur)
                    else:
                        cur = 0
                for step in range(n+1, max_steps+1):
                    s = sum_window % n
                    out = window.pop(0)
                    sum_window = (sum_window - out + s) % n
                    window.append(s)
                    if s == 0:
