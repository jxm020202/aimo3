            import numpy as np, math, random
            
            def angle(v,w):
                # angle between vectors v,w (0 to pi)
                dot = np.dot(v,w)
                return math.acos(dot/(np.linalg.norm(v)*np.linalg.norm(w)))
            
            def compute_angles():
                D,E,F = random_triangle()
                O = circumcenter(D,E,F)
                I = incenter(D,E,F)
                # rename: A=D, B=E, C=F
                # compute angle OIC
                v1 = O - I
                v2 = F - I
                ang = angle(v1, v2)
                # compute C angle of triangle
                # using law of cos
                a = np.linalg.norm(E-F) # side opposite D (A)
                b = np.linalg.norm(F-D) # side opposite E (B)
                c = np.linalg.norm(D-E) # side opposite F (C)
                # angle at C (F)
                cosC = (a**2 + b**2 - c**2)/(2*a*b)
                Cang = math.acos(cosC)
                return ang, Cang
            
            for i in range(5):
                ang, C = compute_angles()
