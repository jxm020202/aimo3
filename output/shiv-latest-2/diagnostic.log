            def oriented_angle(v_from, v_to):
                a = math.atan2(v_from[1], v_from[0])
                b = math.atan2(v_to[1], v_to[0])
                ang = b - a
                # normalize to (-pi, pi)
                while ang <= -math.pi:
                    ang += 2*math.pi
                while ang > math.pi:
                    ang -= 2*math.pi
                return ang
            
