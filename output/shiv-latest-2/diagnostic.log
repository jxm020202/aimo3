                # we will generate all possible assignments within 0..max_val
                # but prune using condition gradually
                # Use recursion
                def backtrack(vals):
                    i = len(vals)  # next index to assign
                    if i == N+1:
                        # all assigned, check condition for all p=0..N-1
                        ok = True
                        for p in range(N):
                            a_p = vals[p]
                            # need indices a_p, a_{a_p}, a_{a_{a_p}}
                            if a_p > N:
                                ok=False; break
                            a_ap = vals[a_p]
                            if a_ap > N:
                                ok=False; break
                            a_aap = vals[a_ap]
                            # RHS: a_{p+1}+1
                            rhs = vals[p+1] + 1
                            if a_aap != rhs:
                                ok=False; break
                        if ok:
                            solutions.append(vals.copy())
                        return
                    # assign value for index i
                    for v in range(max_val+1):
                        # early pruning: for any p where condition depends on this new value, check if possible
