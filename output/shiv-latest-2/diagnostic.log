            def triangle_angles(a,b,c):
                # sides lengths a,b,c opposite A,B,C
                # compute angles using law of cos
                A = math.acos((b*b + c*c - a*a)/(2*b*c))
                B = math.acos((a*a + c*c - b*b)/(2*a*c))
                C = math.pi - A - B
                return A,B,C
            
