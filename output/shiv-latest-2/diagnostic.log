                verts = rotated_square_vertices(theta)
                # clip with x>=0, y>=0
                poly = verts
                poly = clip_polygon(poly, 'x', 0.0)
                poly = clip_polygon(poly, 'y', 0.0)
                return area_polygon(poly)
            
