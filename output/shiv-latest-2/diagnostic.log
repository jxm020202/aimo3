            from collections import deque
            
            # Define generator matrices
            import numpy as np
            A = np.array([[-1,0],[0,1]])  # -r
            B = np.array([[-1,1],[0,1]])  # 1 - r
            C = np.array([[0,1],[1,0]])   # 1/r
            
            generators = [A,B,C]
            
            def mat_mul(m1,m2):
                return np.dot(m1,m2)
            
            def mat_to_tuple(m):
                return (int(m[0,0]), int(m[0,1]), int(m[1,0]), int(m[1,1]))
            
            def apply_mat(m, r):
                a,b,c,d = m[0,0], m[0,1], m[1,0], m[1,1]
                return Fraction(a*r + b, c*r + d)
            
            def bfs_matrices(max_len=6):
                start = np.identity(2, dtype=int)
                visited = {mat_to_tuple(start): (start,0)}  # matrix: (matrix, parity)
                q = deque([start])
                while q:
                    m = q.popleft()
                    depth = visited[mat_to_tuple(m)][1]
