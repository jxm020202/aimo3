            import sympy as sp
            
            def primes_up_to(N):
                return list(sp.primerange(2, N+1))
            
            def has_solution(p, max_n=None):
                # returns True if exists n>=1 such that a_n ≡0 mod p
                if p == 2:
                    # compute a_n mod 2: 6^n+2^n+3^n-1 mod2
                    # 6 mod2 =0, 2 mod2=0, 3 mod2=1 => 0+0+1^n-1 = 1-1=0 mod2 for any n
                    # Actually 1^n =1 => 0 => so a_n ≡0 mod2 for all n
                    return True
                if p == 3:
                    # 6 mod3 =0, 2 mod3=2, 3 mod3=0 => a_n ≡ 0 + 2^n + 0 -1 = 2^n -1 mod3
                    # 2 mod3 = -1, so 2^n = (-1)^n. Then a_n ≡ (-1)^n -1.
                    # For n even, (-1)^n=1 => a_n ≡0 mod3. So p=3 divides a_n for even n.
                    return True
                # else
                # compute orders
                ord2 = sp.n_order(2, p)
                ord3 = sp.n_order(3, p)
                ord6 = sp.n_order(6 % p, p)
                L = sp.ilcm(ord2, ord3, ord6)
                # iterate n from 1 to L
                for n in range(1, L+1):
                    a = pow(6, n, p) + pow(2, n, p) + pow(3, n, p) - 1
                    if a % p == 0:
                        return True
                return False
            
            def primes_without_solution(limit):
                res = []
