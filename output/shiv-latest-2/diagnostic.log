            def compute_MN(D, E, F):
                D = np.array(D, dtype=float)
                E = np.array(E, dtype=float)
                F = np.array(F, dtype=float)
                # circumcenter O
                A = np.array([2*(E-D), 2*(F-D)])
                b_vec = np.array([np.dot(E,E)-np.dot(D,D), np.dot(F,F)-np.dot(D,D)])
                O = np.linalg.solve(A, b_vec)
                # side lengths
                a = np.linalg.norm(E-F)
                b_len = np.linalg.norm(D-F)
                c_len = np.linalg.norm(D-E)
                I = (a*D + b_len*E + c_len*F) / (a + b_len + c_len)
                OI = O - I
                v = np.array([-OI[1], OI[0]])  # perpendicular direction
                # Intersection with DE (y=0)
                # Solve I + t*v = D + s*(E-D)
                A2 = np.column_stack((v, -(E-D)))
                rhs = D - I
                tM, sM = np.linalg.solve(A2, rhs)
                M = I + tM * v
                # external bisector direction at F
                u1 = D - F
                u2 = E - F
