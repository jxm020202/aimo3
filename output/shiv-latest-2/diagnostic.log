            def both_inside(points):
                n=len(points)
                rad=100*math.pi/180
                # compute optimal intervals for each i (store which directions are inside)
                # We'll compute for each i the set of j that are inside optimal wedge.
                inside = [set() for _ in range(n)]
                for i in range(n):
                    # compute angles and sort
                    angles=[]
                    dirs=[]
                    xi,yi=points[i]
                    for j in range(n):
                        if i==j: continue
                        xj,yj=points[j]
                        ang=math.atan2(yj-yi,xj-xi)
                        angles.append(ang)
                        dirs.append(j)
                    # sort by angle
                    sorted_idx = sorted(range(len(angles)), key=lambda k: angles[k])
                    sorted_angles = [angles[k] for k in sorted_idx]
                    sorted_dirs = [dirs[k] for k in sorted_idx]
                    # duplicate
                    m=len(sorted_angles)
                    angles2 = sorted_angles + [a+2*math.pi for a in sorted_angles]
                    dirs2 = sorted_dirs + sorted_dirs
                    # sliding window to find max count and record which set
                    left=0
                    maxcnt=0
                    best_set=set()
                    for right in range(len(angles2)):
                        while angles2[right]-angles2[left] > rad+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>maxcnt:
                            maxcnt=cnt
                            best_set=set(dirs2[left:right+1])
                    inside[i]=best_set
                both=0
                for i in range(n):
                    for j in range(i+1,n):
                        if (j in inside[i]) and (i in inside[j]):
                            both+=1
                return both
            
