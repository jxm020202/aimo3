            def rational_sqrt(num, den):
                # returns True if sqrt(num/den) rational
                # Equivalent to sqrt(num)/sqrt(den) rational
                # We'll check if num*den is perfect square after simplifying fraction?
                from math import isqrt
                # compute fraction reduced
                from fractions import Fraction
                f = Fraction(num, den)
                n = f.numerator
                d = f.denominator
                # sqrt rational iff both n and d are perfect squares
                return int(isqrt(n))**2 == n and int(isqrt(d))**2 == d
            
            def rational_sqrt_1001_over_a(a):
                from math import isqrt
                # sqrt(1001/a) rational?
                # Equivalent to 1001/a = p^2/q^2 => 1001 q^2 = a p^2
                # We'll just test rational via fraction reduction
                from fractions import Fraction
                f = Fraction(1001, a)
                n = f.numerator
                d = f.denominator
                return int(isqrt(n))**2 == n and int(isqrt(d))**2 == d
            
            def find_a(limit):
                res=[]
                for a in range(1,limit+1):
                    if rational_sqrt_1001_over_a(a):
