            import sympy as sp
            import random, math, itertools, sys, numpy as np, fractions, decimal, collections, itertools, math, sympy as sp
            def circumcenter(A,B,C):
                # using sympy geometry
                # but implement formula: intersection of perpendicular bisectors
                # Use sympy's geometry
                A=sp.Point(A); B=sp.Point(B); C=sp.Point(C)
                return sp.geometry.Triangle(A,B,C).circumcenter
            
            def incenter(A,B,C):
                A=sp.Point(A); B=sp.Point(B); C=sp.Point(C)
                return sp.geometry.Triangle(A,B,C).incenter
            
            def line_perp_through_point(P, Q):
                # line through Q perpendicular to line PQ
                # direction vector of PQ: P - Q
                # perpendicular direction: rotate 90 deg
                # In 2D, if v = (dx, dy), perpendicular direction = (-dy, dx)
                dx = P.x - Q.x
                dy = P.y - Q.y
                # direction vector for perpendicular line:
                dir_vec = sp.Matrix([-dy, dx])
                # line param: Q + t*dir_vec
                return sp.Line(Q, Q + sp.Point(dir_vec[0], dir_vec[1]))
            
            def external_bisector_at_F(A,B,F):
                # internal bisector direction: sum of unit vectors along FA and FB
                # external bisector is perpendicular to internal bisector (or difference of unit vectors)
                # Actually internal bisector direction vector = u1/|u1| + u2/|u2|
                # external bisector direction = u1/|u1| - u2/|u2|
                # where u1 = A - F, u2 = B - F
                u1 = sp.Matrix([A.x - F.x, A.y - F.y])
                u2 = sp.Matrix([B.x - F.x, B.y - F.y])
                norm1 = sp.sqrt(u1.dot(u1))
                norm2 = sp.sqrt(u2.dot(u2))
                dir_vec = u1/norm1 - u2/norm2
                # line through F with direction dir_vec
                return sp.Line(F, sp.Point(F.x + dir_vec[0], F.y + dir_vec[1]))
            
            def compute_ratio(D,E,F):
                O = circumcenter(D,E,F)
