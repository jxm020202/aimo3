            from fractions import Fraction
            import math
            
            def rational_solutions(limit_den=20):
                sols = []
                # iterate over m = a/b with b up to limit_den, a up to maybe limit_den*2
                for b in range(1, limit_den+1):
                    for a in range(-limit_den*2, limit_den*2+1):
                        m = Fraction(a, b)
                        # compute n^2 = 5/2 - m^2
                        n2 = Fraction(5,2) - m*m
                        if n2 <= 0:
                            continue
                        # check if n2 is a perfect square rational: numerator and denominator are perfect squares
                        num, den = n2.numerator, n2.denominator
                        # check perfect squares
                        sqrt_num = int(math.isqrt(num))
                        sqrt_den = int(math.isqrt(den))
                        if sqrt_num*sqrt_num == num and sqrt_den*sqrt_den == den:
                            n = Fraction(sqrt_num, sqrt_den)
                            # we have m,n rational solution
                            # compute D = 2 / m^2
                            if m == 0:
                                continue
                            D = Fraction(2,1) / (m*m)
                            # solve quadratic 5 s^2 - 2 s + 1 = D
                            # i.e., 5 s^2 - 2 s + (1 - D) = 0
                            a = Fraction(5,1)
                            b_coef = Fraction(-2,1)
                            c = Fraction(1,1) - D
                            disc = b_coef*b_coef - 4*a*c
                            # check disc is perfect square rational
                            if disc < 0:
                                continue
                            numd, dend = disc.numerator, disc.denominator
                            sqrt_numd = int(math.isqrt(numd))
                            sqrt_dend = int(math.isqrt(dend))
                            if sqrt_numd*sqrt_numd != numd or sqrt_dend*sqrt_dend != dend:
                                continue
                            sqrt_disc = Fraction(sqrt_numd, sqrt_dend)
                            # compute s solutions
                            s1 = (-b_coef + sqrt_disc) / (2*a)
                            s2 = (-b_coef - sqrt_disc) / (2*a)
                            for s in (s1, s2):
                                if s <= 0:
                                    continue
                                # compute x = (1 - s^2)/2
                                x = (Fraction(1,1) - s*s) / 2
                                if x <= 0 or x > Fraction(1,2):
                                    continue
                                # compute t = m*s + (m - 1)
                                t = m*s + (m - 1)
                                if t < 0:
                                    continue
                                # compute y = (1 - t^2)/2
                                y = (Fraction(1,1) - t*t) / 2
                                if y <= 0 or y > Fraction(1,2):
                                    continue
                                # compute k = lcm of denominators of x and y
                                def lcm(a,b):
                                    return a*b // math.gcd(a,b)
                                k = lcm(x.denominator, y.denominator)
                                sols.append((k, x, y, m, s, t))
                return sols
            
            sols = rational_solutions(20)
            len(sols)
            
