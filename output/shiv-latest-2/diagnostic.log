            def is_convex(poly):
                # poly list of points in order
                n = len(poly)
                # compute cross product z of edges (i->i+1) x (i+1->i+2)
                signs = []
                for i in range(n):
                    a = sp.Matrix(poly[i])
                    b = sp.Matrix(poly[(i+1)%n])
                    c = sp.Matrix(poly[(i+2)%n])
                    v1 = b - a
