            import random, math, numpy as np
            
            def random_point_on_sphere():
                # generate normal distribution and normalize
                x = np.random.normal(size=3)
                norm = np.linalg.norm(x)
                return x / norm
            
            def compute_P(a,b,c):
                return (a*b - c*c)*(b*c - a*a)*(c*a - b*b)
            
            def compute_Q(u,v,w):
                return (u*v - w*w)*(v*w - u*u)*(w*u - v*v)
            
            def sample(n):
                best = None
                best_pt = None
                for _ in range(n):
                    u,v,w = random_point_on_sphere()
                    Q = compute_Q(u,v,w)
                    P = 27*Q
                    if best is None or P < best:
                        best = P
                        best_pt = (u,v,w)
                return best, best_pt
            
            best, pt = sample(2000000)
            best, pt
