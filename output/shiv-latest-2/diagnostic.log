            def find_repeat_state(n, max_steps=2000000):
                # returns (preperiod_len, period_len) if repeat found, else None
                a = [pow(2, k, n) for k in range(n)]
                # initial state is last n terms: a[-n:] (which is whole list)
                state = tuple(a[-n:])
                seen = {state: 0}
                window_sum = sum(a) % n
                for step in range(1, max_steps+1):
                    # compute next term
                    next_val = window_sum
                    # update sliding window
                    out_val = a[-n]
                    a.append(next_val)
                    window_sum = (window_sum - out_val + next_val) % n
                    # new state
                    state = tuple(a[-n:])
                    if state in seen:
                        start = seen[state]
                        period = step - start
                        return start, period
                    seen[state] = step
                return None
            
            print(find_repeat_state(100, max_steps=500000))
            
