            import random, math, numpy as np, sympy as sp
            
            def circumcenter(A,B,C):
                # Using sympy for exact? Use numpy for numeric
                # compute intersection of perpendicular bisectors
                # Use formula via linear algebra
                A = np.array(A, dtype=float)
                B = np.array(B, dtype=float)
                C = np.array(C, dtype=float)
                # Solve for center O: |O-A|^2 = |O-B|^2 and |O-A|^2 = |O-C|^2
                # This yields linear equations: 2*(B-A).O = |B|^2 - |A|^2, etc.
                M = np.vstack([2*(B-A), 2*(C-A)])
                rhs = np.array([np.dot(B,B)-np.dot(A,A), np.dot(C,C)-np.dot(A,A)])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter(A,B,C):
                # using side lengths
                A = np.array(A, dtype=float)
                B = np.array(B, dtype=float)
                C = np.array(C, dtype=float)
                a = np.linalg.norm(B-C) # opposite A
                b = np.linalg.norm(C-A) # opposite B
                c = np.linalg.norm(A-B) # opposite C
                I = (a*A + b*B + c*C) / (a+b+c)
                return I
            
            def unit(v):
                norm = np.linalg.norm(v)
                return v/norm
            
            def external_bisector_line(F, D, E):
                # internal bisector direction:
                v1 = unit(D-F)  # direction from F to D
                v2 = unit(E-F)  # direction from F to E
                v_int = v1 + v2
                # external bisector direction is perpendicular to internal bisector
                # rotate by 90 degrees: ( -v_int[1], v_int[0] )
                v_ext = np.array([-v_int[1], v_int[0]])
                # Ensure that external bisector indeed bisects external angle: we can also use difference of unit vectors
                # But perpendicular should work.
                return (F, v_ext)
            
            def line_intersection(P1, d1, P2, d2):
                # Solve P1 + t*d1 = P2 + s*d2
                # 2 equations, 2 unknowns
                A = np.column_stack((d1, -d2))
                b = P2 - P1
                # Solve for t,s
                try:
                    sol = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    # lines parallel
                    return None
                t = sol[0]
                return P1 + t*d1
            
            def ratio_for_triangle(D,E,F):
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line through Q perpendicular to PQ
                PQ = P - Q
                # direction of line L is perpendicular to PQ: rotate 90 deg
                dL = np.array([-PQ[1], PQ[0]])
                # Intersection with DE line
                M = line_intersection(Q, dL, np.array(D), np.array(E)-np.array(D))
                # External bisector line at F
                Fpt, dExt = external_bisector_line(np.array(F), np.array(D), np.array(E))
                N = line_intersection(Q, dL, Fpt, dExt)
                if M is None or N is None:
                    return None
                QM = np.linalg.norm(M - Q)
                QN = np.linalg.norm(N - Q)
                return QM/QN
            
            # test with random triangles
            for i in range(5):
                D = (random.random()*10, random.random()*10)
                E = (random.random()*10, random.random()*10)
                F = (random.random()*10, random.random()*10)
                # ensure not collinear
                # compute ratio
                r = ratio_for_triangle(D,E,F)
                print(r)
            
