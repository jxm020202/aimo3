            def cubic_sum_real(x):
                # compute using real cubic root of real numbers (maybe using sympy real_root)
                # We'll use sympy real_root to get real root.
                expr_inside = (1 + x**2)/2
                sqrt_part = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                # For real numbers inside, the expression inside sqrt is positive.
                # The terms inside cubic root may be positive or negative.
                # Use mp.sign to get real cube root.
                a = expr_inside + sqrt_part/6
                b = expr_inside - sqrt_part/6
                # real cube root:
                def real_cuberoot(z):
                    if z >= 0:
                        return z**(1/3)
                    else:
                        return -((-z)**(1/3))
                return real_cuberoot(a) + real_cuberoot(b)
            
