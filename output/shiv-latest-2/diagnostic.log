            import numpy as np, math, itertools, random, sys, math, time, itertools, collections, fractions, decimal, functools, sympy as sp, sys, math, random, itertools, collections, fractions, decimal, math
            def max_side(s,y,x):
                # coordinates
                P = np.array([math.sqrt(3)*(1-s), s])
                Q = np.array([0.0, y])
                R = np.array([x, 0.0])
                # compute distances
                dPQ = np.linalg.norm(P-Q)
                dQR = np.linalg.norm(Q-R)
                dRP = np.linalg.norm(R-P)
                return max(dPQ,dQR,dRP)
            
            def brute_grid(N=200):
                best = 1e9
                best_tuple = None
                for s in np.linspace(0,1,N):
                    for y in np.linspace(0,1,N):
                        for x in np.linspace(0, math.sqrt(3), N):
                            L = max_side(s,y,x)
                            if L < best:
                                best = L
                                best_tuple = (s,y,x)
                return best,best_tuple
            
