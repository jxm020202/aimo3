            import numpy as np, math, random
            
            def circumcenter(A, B, C):
                # using perpendicular bisectors
                # Solve for center O = (ox, oy)
                # (O-A).(B-A) = (|B|^2 - |A|^2)/2? Actually using linear equations.
                # Use formula based on determinants.
                D = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                if abs(D) < 1e-12:
                    return None
                Ux = ((np.dot(A,A))*(B[1]-C[1]) + (np.dot(B,B))*(C[1]-A[1]) + (np.dot(C,C))*(A[1]-B[1]))/D
                Uy = ((np.dot(A,A))*(C[0]-B[0]) + (np.dot(B,B))*(A[0]-C[0]) + (np.dot(C,C))*(B[0]-A[0]))/D
                return np.array([Ux, Uy])
            
            def incenter(A, B, C):
                # side lengths opposite vertices
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C)/(a+b+c)
                return I
            
            def external_bisector_point(F, D, E):
                # returns direction vector of external bisector at F (unit not needed)
                FD = D - F
                FE = E - F
                lenFD = np.linalg.norm(FD)
                lenFE = np.linalg.norm(FE)
                u1 = FD/lenFD
                u2 = FE/lenFE
                w = u1 - u2
                return w
            
            def ratio_general(A, B, C):
                # D=A, E=B, F=C
                D, E, F = A, B, C
                O = circumcenter(D, E, F)
                I = incenter(D, E, F)
                # direction v perpendicular to OI
                OI = I - O
                # perpendicular direction v = rotate 90 deg
                v = np.array([-OI[1], OI[0]])
                # line L: I + t v
                # intersect with DE
                A_mat = np.column_stack((v, -(E-D)))  # t v - s (E-D) = D - I
                bvec = D - I
                sol = np.linalg.lstsq(A_mat, bvec, rcond=None)[0]
                tM = sol[0]
                # external bisector at F
                w = external_bisector_point(F, D, E)
                A_mat2 = np.column_stack((v, -w))
                bvec2 = F - I
                sol2 = np.linalg.lstsq(A_mat2, bvec2, rcond=None)[0]
                tN = sol2[0]
                ratio = abs(tM)/abs(tN)
                return ratio
            
            # test random triangles
            for i in range(10):
                # random points not collinear
                A = np.random.rand(2)*10
                B = np.random.rand(2)*10
                C = np.random.rand(2)*10
                # ensure not degenerate
                if abs(np.linalg.det(np.column_stack((B-A, C-A)))) < 1e-6:
                    continue
                r = ratio_general(A,B,C)
                print(r)
            
