                # Solve linear equations
                A = np.array([norm1, norm2])
                b = np.array([np.dot(norm1, mid1), np.dot(norm2, mid2)])
                N = np.linalg.solve(A, b)
                # O: intersection of perp bisectors of XY and WZ
                mid3, norm3 = perp_bisector(x, y)
                mid4, norm4 = perp_bisector(w, z)
                A2 = np.array([norm3, norm4])
                b2 = np.array([np.dot(norm3, mid3), np.dot(norm4, mid4)])
                O = np.linalg.solve(A2, b2)
                # compute angle NMO
                vN = N  # M is origin
                vO = O
                # angle between vectors
                dot = np.dot(vN, vO)
                ang = math.degrees(math.acos(dot / (np.linalg.norm(vN)*np.linalg.norm(vO))))
                return ang
            
