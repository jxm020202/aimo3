            def bfs_parity(start, target, max_depth=12):
                start = Fraction(start)
                target = Fraction(target)
                visited = {start:0} # parity (distance mod 2)
                q = deque([start])
                depth = {start:0}
                while q:
                    r = q.popleft()
                    d = depth[r]
                    if r == target:
                        return visited[r] % 2
                    if d >= max_depth:
                        continue
                    # generate neighbors
                    for nb in [ -r, 1 - r, 1/r if r != 0 else None]:
                        if nb is None:
                            continue
                        nb = Fraction(nb)
                        if nb not in visited:
                            visited[nb] = (visited[r] + 1) % 2
                            depth[nb] = d + 1
                            q.append(nb)
