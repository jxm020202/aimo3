            def generate_independent_sets(n):
                # returns list of masks (int) for independent sets (any size)
                valid_row_masks = [mask for mask in range(1<<n) if (mask & (mask<<1))==0]
                compat = {}
                for m1 in valid_row_masks:
                    compat[m1]=[]
                    for m2 in valid_row_masks:
                        if m1 & m2: continue
                        if (m1<<1) & m2: continue
                        if (m1>>1) & m2: continue
                        compat[m1].append(m2)
                dp = {0: [0]}
                for row in range(n):
                    newdp={}
                    for prev_mask, sets in dp.items():
                        for cur_mask in valid_row_masks:
                            if cur_mask not in compat[prev_mask]:
                                continue
                            cur_bits = cur_mask << (row*n)
                            for s in sets:
                                newmask = s | cur_bits
                                newdp.setdefault(cur_mask, []).append(newmask)
                    dp = newdp
                indep_sets=set()
                for mask, lst in dp.items():
                    indep_sets.update(lst)
                return list(indep_sets)
            
            def greedy_separating_set(n):
                indep_sets = generate_independent_sets(n)
                # filter size >=2
                indep_sets = [s for s in indep_sets if bin(s).count('1')>=2]
                total_cells = n*n
                Q = set()
                # compute patterns dict for current Q
                # We'll maintain mapping from pattern to list of sets
                # Initially pattern is empty tuple for all sets
                pattern_to_sets = {(): indep_sets}
                while True:
                    # find any pattern with more than 1 set (i.e., indistinguishable)
                    ambiguous = None
                    for pat, lst in pattern_to_sets.items():
                        if len(lst) > 1:
                            ambiguous = (pat, lst)
                            break
                    if ambiguous is None:
                        break
                    # choose a cell that splits this list best
                    pat, lst = ambiguous
                    # compute for each cell the number of sets with black at that cell
                    best_cell = None
                    best_balance = None
                    for cell in range(total_cells):
                        if cell in Q:
                            continue
                        # compute count of sets where cell is black
                        cnt_black = sum(1 for s in lst if (s>>cell)&1)
                        if cnt_black==0 or cnt_black==len(lst):
                            continue
                        # we want near half split
                        balance = abs(cnt_black - (len(lst)-cnt_black))
                        if best_balance is None or balance < best_balance:
                            best_balance = balance
                            best_cell = cell
                    if best_cell is None:
                        # no cell separates this list (should not happen)
                        # just add any remaining cell
                        for cell in range(total_cells):
                            if cell not in Q:
                                best_cell = cell
                                break
                    Q.add(best_cell)
                    # update pattern_to_sets
                    new_map={}
                    for pat, lst in pattern_to_sets.items():
                        # split each list by new cell
                        part0=[]
                        part1=[]
                        for s in lst:
                            bit = (s>>best_cell)&1
                            if bit:
                                part1.append(s)
                            else:
                                part0.append(s)
                        if part0:
                            new_map[pat+(0,)] = part0
                        if part1:
                            new_map[pat+(1,)] = part1
                    pattern_to_sets = new_map
                return len(Q)
            
            print(greedy_separating_set(5))
            
