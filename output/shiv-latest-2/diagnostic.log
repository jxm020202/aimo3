            import itertools
            
            def exists_config(Qcoeffs, d, n, M=5):
                a,b = Qcoeffs
                # Q(x) = a*x + b
                # search k=0..n
                for k in range(0, n+1):
                    # need k+1 distinct integers
                    # choose from range -M..M
                    for combo in itertools.permutations(range(-M, M+1), k+1):
                        # ensure distinct
                        if len(set(combo)) != k+1:
                            continue
                        a_vals = combo
                        # compute LHS and RHS
                        lhs = a*a_vals[-1] + b - sum(a*x + b for x in a_vals[:-1])
                        rhs = a_vals[-1]**d - sum(x**d for x in a_vals[:-1])
                        if lhs == rhs:
                            return True
                return False
            
            def test_n2():
                n=2
                d=2
                # test Q with a,b in range -3..3
                for a in range(-3,4):
                    for b in range(-3,4):
                        if not exists_config((a,b), d, n, M=5):
                            print("counterexample", a,b)
                            return False
                print("all passed")
                return True
            
            test_n2()
            
