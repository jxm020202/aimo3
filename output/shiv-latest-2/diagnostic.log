            def max_a_for_config(angles):
                # angles: list of positions in degrees on circle [0,360)
                n=len(angles)
                # compute signed half-angles for each i to each j
                total=0
                for i in range(n):
                    ai=0
                    # compute signed half-angles
                    signed=[]
                    for j in range(n):
                        if i==j: continue
                        # central angle between points i and j (smallest)
                        diff=abs(angles[i]-angles[j])%360
                        if diff>180:
                            diff=360-diff
                        # determine sign: positive if j is counterclockwise from i (i.e., angles[j] - angles[i] mod 360 in (0,180))
                        # compute oriented difference
                        oriented = (angles[j]-angles[i])%360
                        if oriented>180:
                            oriented-=360
                        # oriented in (-180,180)
                        # signed half-angle:
                        signed_angle = oriented/2.0
                        signed.append(signed_angle)
                    # find max number in any interval of length 100
                    signed.sort()
                    # sliding window
                    m=len(signed)
                    maxcnt=0
                    for idx in range(m):
                        start=signed[idx]
                        cnt=0
                        for val in signed:
                            if start <= val <= start+100:
                                cnt+=1
                        maxcnt=max(maxcnt,cnt)
                    total+=maxcnt
                return total
            
