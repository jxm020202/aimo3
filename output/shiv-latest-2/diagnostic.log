            def exists_solution(b,c,limit=20):
                # search for distinct integers x0,x1,x2 within [-limit,limit]
                vals = range(-limit, limit+1)
                for x0,x1,x2 in itertools.permutations(vals,3):
                    if len({x0,x1,x2})<3: continue
                    # check P(x0) = P(x1)+P(x2)
