            def covers_any(theta, t):
                # t is translation vector in [0,1)^2
                # check if any lattice point (0,0),(1,0),(0,1),(1,1) lies in square t + Rθ*[0,1]^2
                cos = math.cos(theta)
                sin = math.sin(theta)
                # For each lattice point n, solve if n - t is in rotated square
                # Equivalent to check if R_{-theta} (n - t) lies in [0,1]^2
                for i in (0,1):
                    for j in (0,1):
                        nx = i - t[0]
                        ny = j - t[1]
                        # apply inverse rotation: u = R_{-theta} * (n - t)
                        ux = cos*nx + sin*ny
                        uy = -sin*nx + cos*ny
                        if 0 <= ux <= 1 and 0 <= uy <= 1:
