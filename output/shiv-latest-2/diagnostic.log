            import random, math
            def random_point():
                # generate random point on sphere radius sqrt(3)
                # sample normal distribution
                import random, math
                a = random.gauss(0,1)
                b = random.gauss(0,1)
                c = random.gauss(0,1)
                norm = math.sqrt(a*a + b*b + c*c)
                scale = math.sqrt(3)/norm
                return a*scale, b*scale, c*scale
            
            def E_val(a,b,c):
                return (a*b - c*c)*(b*c - a*a)*(c*a - b*b)
            
            def search(n=200000):
                best = 1e9
                best_pt = None
                for _ in range(n):
                    a,b,c = random_point()
                    val = E_val(a,b,c)
                    if val < best:
                        best = val
                        best_pt = (a,b,c)
                return best, best_pt
            
            best, pt = search(200000)
            best, pt
