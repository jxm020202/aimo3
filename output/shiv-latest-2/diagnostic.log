            def count_independent_sets_king(n):
                # returns list counts[k] = number of independent sets of size k
                valid_masks=[]
                for mask in range(1<<n):
                    if mask & (mask<<1):
                        continue
                    valid_masks.append(mask)
                # Precompute compatibility between masks of consecutive rows
                compat = {}
                for m1 in valid_masks:
                    compat[m1]=[]
                    for m2 in valid_masks:
                        # no vertical adjacency: same column
                        if m1 & m2: continue
                        # no diagonal adjacency
                        if (m1<<1) & m2: continue
                        if (m1>>1) & m2: continue
                        compat[m1].append(m2)
                # DP
                # dp[prev_mask][k] = count
                dp = {0: {0:1}}  # before first row, prev_mask=0 (no previous)
                for row in range(n):
                    newdp = {}
                    for prev_mask, cnts in dp.items():
                        for cur_mask in valid_masks:
                            # check compatibility with prev_mask
                            if cur_mask not in compat[prev_mask]:
                                continue
                            # update
                            occ = bin(cur_mask).count('1')
                            for k, ways in cnts.items():
                                nk = k+occ
                                newdp.setdefault(cur_mask, {})
                                newdp[cur_mask][nk] = newdp[cur_mask].get(nk,0) + ways
                    dp = newdp
                # sum over final masks
                total_counts = {}
                for mask, cnts in dp.items():
                    for k, ways in cnts.items():
                        total_counts[k] = total_counts.get(k,0)+ways
                # include empty set? Already counted for k=0
                # return list up to max k
                maxk = max(total_counts.keys())
                counts = [0]*(maxk+1)
                for k, ways in total_counts.items():
                    counts[k]=ways
                return counts
            
            counts = count_independent_sets_king(9)
            len(counts), sum(counts)
            
