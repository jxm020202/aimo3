            from scipy.optimize import milp, LinearConstraint, Bounds
            def exists_skolem(n, time_limit=30):
                # Build variable index mapping
                # variables x_{i,d} where i from 1 to 2n-d
                var_indices = {}
                idx = 0
                for d in range(1, n+1):
                    for i in range(1, 2*n - d + 1):
                        var_indices[(i,d)] = idx
                        idx += 1
                num_vars = idx
                # Objective: dummy zero
                c = np.zeros(num_vars)
                # Constraints:
                # 1) For each d, sum_i x_{i,d} = 1
                rows = []
                lbs = []
                ubs = []
                for d in range(1, n+1):
                    row = np.zeros(num_vars)
                    for i in range(1, 2*n - d + 1):
                        row[var_indices[(i,d)]] = 1
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(1)
                # 2) For each number j, sum of x where j is left endpoint + sum where j is right endpoint = 1
                for j in range(1, 2*n+1):
                    row = np.zeros(num_vars)
                    # left endpoint: i=j, need d such that j <= 2n-d => d <= 2n-j
                    for d in range(1, n+1):
                        if j <= 2*n - d:
                            row[var_indices[(j,d)]] += 1
                    # right endpoint: j = i+d => i = j-d, need i>=1 and i <= 2n-d
                    for d in range(1, n+1):
                        i = j - d
                        if i >= 1 and i <= 2*n - d:
                            row[var_indices[(i,d)]] += 1
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(1)
                A = np.vstack(rows)
                lc = LinearConstraint(A, lbs, ubs)
                # bounds: 0 <= x <= 1
                bounds = Bounds(0, 1)
                # integrality: all variables integer
                integrality = np.ones(num_vars, dtype=int)
                # Solve
                res = milp(c, integrality=integrality, bounds=bounds, constraints=lc, options={'disp': False, 'max_iter': 100000})
                return res.success
            
            print(exists_skolem(100))
            
