            import math, itertools
            
            # vertices of regular 12-gon radius 1
            verts = [(math.cos(math.radians(i*30)), math.sin(math.radians(i*30))) for i in range(12)]
            
            def line_from_points(p1, p2):
                (x1,y1), (x2,y2) = p1, p2
                # line ax + by + c = 0
                a = y1 - y2
                b = x2 - x1
                c = x1*y2 - x2*y1
                # normalize (a,b) to unit length for direction comparison
                norm = math.hypot(a,b)
                if norm == 0:
                    raise ValueError
                a /= norm
                b /= norm
                c /= norm
                # ensure a,b direction sign canonical: make first non-zero positive
                if abs(a) > 1e-9:
                    if a < 0:
                        a,b,c = -a,-b,-c
                else:
                    if b < 0:
                        a,b,c = -a,-b,-c
                return (a,b,c)
            
            def direction_angle_from_line(line):
                a,b,_ = line
                # direction vector perpendicular to normal (a,b) is (b,-a)
                dx, dy = b, -a
                ang = math.degrees(math.atan2(dy,dx))
                if ang < 0:
                    ang += 180
                return round(ang,6)
            
            # generate lines
            lines = []
            for i in range(12):
                for j in range(i+1,12):
                    line = line_from_points(verts[i], verts[j])
                    lines.append((i,j,line))
            len(lines)
            
