            def uncovered_fraction(theta, N=200000):
                # define square vertices relative to some reference point (e.g., lower-left corner at (0,0) before rotation)
                # We'll define square as set of points (x,y) = (u, v) * rotation + (0,0) where (u,v) in [0,1]x[0,1] (axis-aligned unit square)
                # rotation matrix
                c, s = math.cos(theta), math.sin(theta)
                # vertices of unit square before rotation: (0,0), (1,0), (1,1), (0,1)
                verts = [(0,0), (1,0), (1,1), (0,1)]
                # rotate each vertex
                rot_verts = [(c*x - s*y, s*x + c*y) for x,y in verts]
                # shape is convex hull of these points (still square)
                # We'll test point coverage: point p is covered if exists integer shift (i,j) such that p in rotated square + (i,j)
                # Use barycentric or point-in-polygon test for convex quadrilateral.
                # Use shapely? Not available. We'll implement using cross product signs.
                def point_in_polygon(p, poly):
                    # poly list of vertices in order (convex)
                    x, y = p
                    # compute cross product sign for each edge
                    sign = None
                    n = len(poly)
                    for i in range(n):
                        x1,y1 = poly[i]
                        x2,y2 = poly[(i+1)%n]
                        # edge vector (x2-x1, y2-y1), vector to point (x - x1, y - y1)
                        cross = (x2-x1)*(y - y1) - (y2-y1)*(x - x1)
                        if cross != 0:
                            cur = cross > 0
                            if sign is None:
                                sign = cur
                            elif sign != cur:
                                return False
                    return True
                # precompute polygon for each shift (i,j) in -1..1
                shifts = [(i,j) for i in (-1,0,1) for j in (-1,0,1)]
                polys = {}
                for i,j in shifts:
                    shifted = [(x+i, y+j) for (x,y) in rot_verts]
                    polys[(i,j)] = shifted
                count_uncovered = 0
                for _ in range(N):
                    p = (random.random(), random.random())
                    covered = False
                    for (i,j), poly in polys.items():
                        if point_in_polygon(p, poly):
                            covered = True
                            break
                    if not covered:
                        count_uncovered += 1
                return count_uncovered / N
            
            for theta in [0, math.pi/8, math.pi/6, math.pi/4]:
                print(theta, uncovered_fraction(theta, N=50000))
            
