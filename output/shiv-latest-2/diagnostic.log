            def max_zero_run(n, max_iter=1000000):
                # initial terms a_1..a_n
                a = [pow(2, k-1, n) for k in range(1, n+1)]  # modulo n
                # store sequence list for zero detection
                seq = a.copy()
                # dictionary mapping state tuple to index (position of last element)
                # state is tuple of last n terms (mod n)
                state = tuple(a[-n:])  # length n
                seen = {state: n}  # index of last term (k=n)
                max_run = 0
                current_run = 0
                # compute zero runs for initial terms
                for val in seq:
                    if val % n == 0:
                        current_run += 1
                        max_run = max(max_run, current_run)
                    else:
                        current_run = 0
                # iterate
                k = n
                while True:
                    # compute next term
                    next_val = sum(seq[-n:]) % n
                    seq.append(next_val)
                    k += 1
                    # update zero run
                    if next_val == 0:
                        current_run += 1
                        max_run = max(max_run, current_run)
                    else:
                        current_run = 0
                    # update state
                    state = tuple(seq[-n:])
                    if state in seen:
                        # period detected
                        # break
                        # print("period detected at k", k, "first seen at", seen[state])
                        break
                    seen[state] = k
                    if k > max_iter:
                        print("max_iter reached")
                        break
                return max_run, len(seq), k, len(seen)
            
