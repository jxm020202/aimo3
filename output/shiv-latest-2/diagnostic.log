            def det_mod_n(n):
                import sympy as sp
                M = sp.zeros(n)
                # first row all ones
                for j in range(n):
                    M[0,j] = 1
                # subdiagonal identity
                for i in range(1,n):
                    M[i,i-1] = 1
                det = int(M.det())
                return det
            
