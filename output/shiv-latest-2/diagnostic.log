            def eventual_increasing_check(n, max_k=20000):
                # returns True if after some point (maybe after first decrease) the sequence is strictly increasing forever up to max_k
                # we can check that there is no decrease after some threshold, i.e., the sequence is monotone increasing from some index onward.
                xs = [lcm_range(k,n) for k in range(1, max_k+1)]
                # find the largest index where xs[k] <= xs[k-1] (non-increase)
                bad = -1
                for i in range(1, len(xs)):
                    if xs[i] <= xs[i-1]:
                        bad = i  # index i (0-based) corresponds to k=i+1
                # if no bad found, return True
                return bad == -1
            
            def find_last_nonincrease(n, max_k=20000):
                xs = [lcm_range(k,n) for k in range(1, max_k+1)]
