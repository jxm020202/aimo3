            def max_in_wedge(points, idx, angle=100):
                # points: list of (x,y)
                x0,y0 = points[idx]
                # compute angles from point i to others
                angles = []
                for j,(x,y) in enumerate(points):
                    if j==idx: continue
                    ang = math.atan2(y-y0, x-x0)  # range -pi..pi
                    angles.append(ang)
                # sort angles
                angles.sort()
                # duplicate angles + 2π to handle wrap-around
                angles2 = angles + [a+2*math.pi for a in angles]
                # sliding window
