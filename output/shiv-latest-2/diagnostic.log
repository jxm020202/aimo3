            from fractions import Fraction
            import math
            
            def is_square_fraction(fr):
                # fr is Fraction positive
                num = fr.numerator
                den = fr.denominator
                # check perfect squares
                return int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den
            
            def find_min_k(limit=20):
                min_k = None
                best = None
                for q in range(1, limit+1):
                    for p in range(-limit, limit+1):
                        a = Fraction(p, q)
                        # a must be in [0,1] (since sqrt(1-2x) range)
                        if a < 0 or a > 1:
                            continue
                        D = 5*a*a - 2*a + 1
                        if D <= 0:
                            continue
                        S = Fraction(2)*(a+1)*(a+1) / D
                        # check if S is a perfect square rational
                        if not is_square_fraction(S):
                            continue
                        # compute b = -1 + sqrt(S)
                        sqrt_num = int(math.isqrt(S.numerator))
                        sqrt_den = int(math.isqrt(S.denominator))
                        b = Fraction(-1,1) + Fraction(sqrt_num, sqrt_den)
                        if b < 0:
                            continue
                        # compute x,y
                        x = Fraction(1,1) - a*a
                        x = x / 2
                        y = Fraction(1,1) - b*b
                        y = y / 2
                        if x <= 0 or y <= 0:
                            continue
                        # denominators
                        den_x = x.denominator
                        den_y = y.denominator
                        k = math.lcm(den_x, den_y)
                        if min_k is None or k < min_k:
                            min_k = k
                            best = (a,b,x,y,den_x,den_y,k)
                return min_k, best
            
            min_k, best = find_min_k(30)
            min_k, best
            
