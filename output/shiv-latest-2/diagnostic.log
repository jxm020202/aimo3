            def last_nonzero_digit_fact(n):
                # compute last non-zero digit of n! using recurrence
                # using known algorithm
                # We'll compute directly using modular arithmetic removing 2 and 5 factors.
                # Approach: multiply numbers 1..n, at each step remove factors of 10 (i.e., remove 2 and 5)
                # Keep mod maybe 100000 to avoid overflow.
                res = 1
                for i in range(2, n+1):
                    x = i
                    while x % 5 == 0:
                        x //= 5
                    while x % 2 == 0:
                        x //= 2
                    res = (res * x) % 10  # we only need last digit mod 10, but need to keep track of extra 2's from removed 5s?
                # Actually we removed all 2s, but we need to reintroduce the extra 2s from unmatched 2s (since we removed all 2s).
                # This naive approach fails. Let's use known recurrence.
                return res
            
            def D(n):
                # using recurrence: D(0)=1
                # D(n) = D(n//5) * D(n%5) * pow(2, n//5, 10) % 10
                if n == 0:
