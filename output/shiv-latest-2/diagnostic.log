            import numpy as np
            from fractions import Fraction
            
            def max_product_bound_for_a(a, num_samples=10000):
                b = 200 - a
                den = a*(a+1)*b*(b-1)
                # continuous x range
                L = a*(a+1)/2
                U = a*(401 - a)/2
                # sample many points
                xs = np.linspace(L, U, num_samples)
                max_val = -1e9
                for x in xs:
                    # compute p_star
                    p_star = (a * (T - x) + b * x) / (2 * a * b)
                    # clamp to [1,200]
                    if p_star < 1:
                        p_opt = 1
                    elif p_star > 200:
                        p_opt = 200
                    else:
                        p_opt = p_star
                    # compute numerator N = (a p - x)*(T - x - b p)
                    N = (a * p_opt - x) * (T - x - b * p_opt)
                    val = N / den
                    if val > max_val:
