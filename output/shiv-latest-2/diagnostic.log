            def k_clusters_sum(n, k, cluster_sizes=None, eps=0.001):
                # place k clusters equally spaced around circle (angles separated by 360/k)
                if cluster_sizes is None:
                    # equal sizes
                    base = n // k
                    sizes = [base]*k
                    for i in range(n - base*k):
                        sizes[i] += 1
                else:
                    sizes = cluster_sizes
                assert sum(sizes)==n
                angles=[]
                for idx,size in enumerate(sizes):
                    base_angle = 2*math.pi*idx/k
                    for i in range(size):
                        # small spread within cluster
                        angles.append(base_angle + i*eps)
                return sum_a(angles)
            
