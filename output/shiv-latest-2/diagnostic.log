            def get_terms_mod(n, start, length):
                # compute terms up to start+length-1
                # using sliding window
                b = [pow(2, k-1, n) for k in range(1, n+1)]
                window_sum = sum(b) % n
                terms = {}
                # store terms for indices 1..n
                for i in range(1, n+1):
                    terms[i] = b[i-1]
                for step in range(n+1, start+length):
                    next_val = window_sum % n
                    terms[step] = next_val
                    # update sliding window
                    removed = b.pop(0)
                    b.append(next_val)
                    window_sum = (window_sum - removed + next_val) % n
                # return list of terms from start to start+length-1
                return [terms[i] for i in range(start, start+length)]
            
