                Y = sp.Point(b, 0)
                X = sp.Point(c*math.cos(theta), c*math.sin(theta))
                Z = sp.Point(-d*math.cos(theta), -d*math.sin(theta))
                M = sp.Point(0,0)
                # perp bisectors
                mid_WX = sp.Point((W.x+X.x)/2, (W.y+X.y)/2)
                line_WX = sp.Line(W, X)
                perp_WX = line_WX.perpendicular_line(mid_WX)
                mid_YZ = sp.Point((Y.x+Z.x)/2, (Y.y+Z.y)/2)
                line_YZ = sp.Line(Y, Z)
                perp_YZ = line_YZ.perpendicular_line(mid_YZ)
                N = perp_WX.intersection(perp_YZ)[0]
                # O from XY and WZ
                mid_XY = sp.Point((X.x+Y.x)/2, (X.y+Y.y)/2)
