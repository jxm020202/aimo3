            import math
            from fractions import Fraction
            def find_min_k(limit):
                best = None
                best_data = None
                for n in range(1, limit+1):
                    for m in range(1, n):  # m<n
                        if math.gcd(m,n)!=1:
                            continue
                        a = Fraction(m, n)
                        # compute D numerator: 5m^2 -2mn + n^2
                        D_num = 5*m*m - 2*m*n + n*n
                        D_den = n*n
                        # D = D_num / D_den
                        # Need D = 2 q^2 / p^2
                        # So D_num/D_den = 2 q^2 / p^2
                        # => D_num * p^2 = 2 q^2 * D_den
                        # iterate p,q small
                        for p in range(1, limit+1):
                            for q in range(1, limit+1):
                                # Check equality
                                if D_num * p*p == 2 * q*q * D_den:
                                    # compute b = -1 + (a+1) * p/q
                                    b = Fraction(-1,1) + (a + 1) * Fraction(p, q)
                                    if b < 0 or b >= 1:
                                        continue
                                    # compute x,y
                                    x = Fraction(n*n - m*m, 2*n*n)  # (1 - a^2)/2
                                    # y = (1 - b^2)/2
                                    y = Fraction(1,1) - Fraction(b.numerator*b.numerator, b.denominator*b.denominator)
                                    y = y / 2
                                    # ensure positive rational
                                    if y <= 0:
                                        continue
                                    # compute denominators after reduction
                                    x_num, x_den = x.numerator, x.denominator
                                    y_num, y_den = y.numerator, y.denominator
                                    k = math.lcm(x_den, y_den)
