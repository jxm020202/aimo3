            def point_in_triangle(P, D, E, F):
                # using barycentric coordinates
                x, y = P.x, P.y
                # compute vectors
                v0 = sp.Matrix([F.x - D.x, F.y - D.y])
                v1 = sp.Matrix([E.x - D.x, E.y - D.y])
                v2 = sp.Matrix([x - D.x, y - D.y])
                # compute dot products
                dot00 = v0.dot(v0)
                dot01 = v0.dot(v1)
                dot02 = v0.dot(v2)
                dot11 = v1.dot(v1)
                dot12 = v1.dot(v2)
                # Compute barycentric coordinates
                denom = dot00 * dot11 - dot01 * dot01
                u = (dot11 * dot02 - dot01 * dot12) / denom
                v = (dot00 * dot12 - dot01 * dot02) / denom
                # inside if u>=0, v>=0, u+v <=1
                return sp.simplify(u), sp.simplify(v), sp.simplify(u+v)
            
