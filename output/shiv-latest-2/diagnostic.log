            def point_in_rotated_square(p, theta):
                # Using barycentric coordinates: p = a*e1 + b*e2 with a,b in [0,1]
                c, s = math.cos(theta), math.sin(theta)
                # Solve for a,b: p = a*e1 + b*e2 where e1=(c,s), e2=(-s,c)
                # Solve linear system:
                # x = a*c + b*(-s)
                # y = a*s + b*c
                # Matrix [[c, -s],[s, c]] invertible (rotation)
                # Inverse is [[c, s],[-s, c]]
                a = c * p[0] + s * p[1]
                b = -s * p[0] + c * p[1]
                return 0 <= a <= 1 and 0 <= b <= 1
            
            def rectangle_inside_R(theta):
                c, s = math.cos(theta), math.sin(theta)
                x0, y0 = c-0.5, s-0.5
                x1, y1 = 0.5, 0.5
                # test corners and maybe midpoints
                corners = [(x0,y0),(x0,y1),(x1,y0),(x1,y1)]
                for p in corners:
                    if not point_in_rotated_square(p, theta):
                        return False
                # also test center
                center = ((x0+x1)/2, (y0+y1)/2)
                if not point_in_rotated_square(center, theta):
                    return False
                return True
            
