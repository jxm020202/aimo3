            import mpmath as mp
            
            def equation(t):
                # compute RHS
                rhs = 8*t*(1-t)/(5*t**2 - 2*t + 1)
                # we need s satisfying s^2 + 2s - 1 = rhs
                # Solve quadratic for s: s^2 + 2s - (1+rhs) = 0? Wait:
                # s^2 + 2s - 1 = rhs => s^2 + 2s - (1+rhs) = 0
                disc = 4 + 4*(1+rhs)  # discriminant: 4 - 4*(-(1+rhs)) = 4 + 4*(1+rhs)
                # Actually for ax^2+bx+c=0, discriminant = b^2 - 4ac.
                # Here a=1, b=2, c=-(1+rhs)
                disc = 4 - 4*(-(1+rhs))  # = 4 + 4*(1+rhs) = 4*(2+rhs)
                disc = 4*(2+rhs)
                if disc < 0:
                    return None
                s = (-2 + mp.sqrt(disc))/2  # we need non-negative s; choose root with + sqrt? Actually solutions: s = (-2 +- sqrt(disc))/2.
                # Since disc>0, sqrt(disc) >0, so (-2 + sqrt(disc))/2 could be >=0 if sqrt(disc) >=2.
                # Let's compute both and pick non-negative.
                s1 = (-2 + mp.sqrt(disc))/2
                s2 = (-2 - mp.sqrt(disc))/2
                s = s1 if s1>=0 else s2
                return s
            
            # find t such that s in (0,1) and also s^2 rational? We'll just find numeric solutions.
            sols=[]
            for t in [i/1000 for i in range(1,999)]:
                s=equation(t)
                if s is not None and 0<s<1:
                    # compute x,y
                    x=(1 - t**2)/2
                    y=(1 - s**2)/2
                    sols.append((t,s,x,y))
            len(sols)
            
