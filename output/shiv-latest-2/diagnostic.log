            import random, math
            def t_from_point(a,b,c):
                # compute sum of squared differences
                sd = (a-b)**2 + (a-c)**2 + (b-c)**2
                Delta = 3 - sd
                if Delta < 0:
                    return None
                S = a+b+c
                t = (S - math.sqrt(Delta)) / 3
                return t
            
            def random_point_in_triangle():
                # barycentric
                u = random.random()
                v = random.random()
                if u+v>1:
                    u = 1-u
                    v = 1-v
                V1 = (2.0,0.0,0.0)
                V2 = (0.0,4.0,0.0)
                V3 = (0.0,0.0,6.0)
                a = u*V1[0] + v*V2[0] + (1-u-v)*V3[0]
                b = u*V1[1] + v*V2[1] + (1-u-v)*V3[1]
                c = u*V1[2] + v*V2[2] + (1-u-v)*V3[2]
                return a,b,c
            
