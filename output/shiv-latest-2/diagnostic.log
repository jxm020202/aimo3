            def t_min_for_point(a,b,c):
                # compute minimal t such that sum_i max(0, a_i - t)^2 <= 1
                # piecewise: sort coordinates
                vals = sorted([a,b,c])
                # We'll try solving for each region: 
                # region 0: t <= vals[0]
                # region 1: vals[0] <= t <= vals[1]
                # region 2: vals[1] <= t <= vals[2]
                # region 3: t >= vals[2]
                # For region 3, all terms zero => sum = 0 <=1 always, so t can be as low as max(vals)?? Actually if t >= max(a,b,c), condition holds trivially, but we want minimal t, so region 3 not minimal.
                # We'll compute candidate t for each region where equality holds.
                candidates = []
                # Region 0: all three active
                S = a+b+c
                Q = a*a + b*b + c*c
                # solve 3 t^2 - 2 S t + (Q - 1) = 0
                # discriminant
                disc = 4*S*S - 12*(Q - 1)
                if disc >= 0:
                    sqrt_disc = math.sqrt(disc)
                    t1 = (2*S - sqrt_disc) / (6)  # smaller root
                    t2 = (2*S + sqrt_disc) / (6)  # larger root
                    # we need t <= min(a,b,c)
                    if t1 <= vals[0] + 1e-12:
                        candidates.append(t1)
                # Region 1: smallest coordinate a0 = vals[0] is <= t, so its term zero, other two active
                # Identify which coordinate is smallest
                # We'll treat generically: assume a is smallest; but we need to handle permutations.
                # Let's handle each permutation separately
                # We'll just brute force solve for each combination of which coordinates are active.
                # Active set = indices where a_i > t. Since t unknown, we can assume a particular set and solve.
                # We'll try all subsets of {0,1,2} non-empty.
                import itertools
                for active in [(0,1,2), (0,1), (0,2), (1,2), (0,), (1,), (2,)]:
                    # active indices where a_i - t > 0 => t < a_i for those i.
                    # For inactive indices, term zero.
                    # Let active list = indices where a_i > t.
                    # We need to solve sum_{i in active} (a_i - t)^2 = 1, with t <= min_{i in active} a_i, and t >= max_{j not in active} a_j (since for inactive, a_j <= t).
                    # We'll solve quadratic for t.
                    act_vals = [ [a,b,c][i] for i in active ]
                    # Solve sum (val - t)^2 = 1
                    n = len(act_vals)
                    # Expand: n t^2 - 2 t sum val + sum val^2 - 1 = 0
                    sum_val = sum(act_vals)
                    sum_sq = sum(v*v for v in act_vals)
                    # quadratic: n t^2 - 2 sum_val t + (sum_sq - 1) = 0
                    disc2 = 4*sum_val*sum_val - 4*n*(sum_sq - 1)
                    if disc2 < -1e-12:
                        continue
                    disc2 = max(disc2,0)
                    sqrt_disc2 = math.sqrt(disc2)
                    # smaller root
                    t_candidate = (2*sum_val - sqrt_disc2) / (2*n)
                    # Check feasibility:
                    # t must satisfy: for i in active, t <= a_i
                    # for j not active, t >= a_j
                    ok = True
                    for i in active:
                        if t_candidate > [a,b,c][i] + 1e-9:
                            ok = False
                    for j in set([0,1,2]) - set(active):
                        if t_candidate < [a,b,c][j] - 1e-9:
                            ok = False
                    if ok and t_candidate >= 0:
                        candidates.append(t_candidate)
                if not candidates:
                    return None
                return min(candidates)
            
