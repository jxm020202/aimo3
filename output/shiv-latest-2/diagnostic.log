            def max_zero_run(n, max_terms=10000):
                # compute sequence modulo n
                a = [0] * (max_terms+1)  # 1-indexed
                # initial terms
                for k in range(1, n+1):
                    a[k] = pow(2, k-1, n)
                # compute further terms
                for k in range(n+1, max_terms+1):
                    s = sum(a[k-i] for i in range(1, n+1))
                    a[k] = s % n
                # find longest run of zeros
                max_run = 0
                cur = 0
                for k in range(1, max_terms+1):
                    if a[k] % n == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                return max_run, a[:max_terms+1]
            
