                D = np.array(D, dtype=float)
                E = np.array(E, dtype=float)
                F = np.array(F, dtype=float)
                # compute circumcenter P
                # Using formula: intersection of perpendicular bisectors
                # Solve linear equations.
                # Let's use sympy for simplicity but numeric.
                import sympy as sp
                Dp = sp.Point(*D)
                Ep = sp.Point(*E)
                Fp = sp.Point(*F)
                tri = sp.Triangle(Dp, Ep, Fp)
                P = tri.circumcenter
                Q = tri.incenter
                # line PQ
                line_PQ = sp.Line(P, Q)
                line_perp = line_PQ.perpendicular_line(Q)
                M = line_perp.intersection(sp.Line(Dp, Ep))[0]
                # external bisector direction using difference of unit vectors
                FD = sp.Matrix(Dp - Fp)
                FE = sp.Matrix(Ep - Fp)
                uFD = FD / sp.sqrt(FD.dot(FD))
                uFE = FE / sp.sqrt(FE.dot(FE))
                dir_ext = uFD - uFE
                line_ext = sp.Line(Fp, Fp + sp.Point(dir_ext[0], dir_ext[1]))
                N = line_perp.intersection(line_ext)[0]
                QM = Q.distance(M)
                QN = Q.distance(N)
                return sp.nsimplify(QM/QN)
            
