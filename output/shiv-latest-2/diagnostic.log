            def max_in_wedge(points, angle=100):
                # points: list of (x,y)
                n=len(points)
                a=[0]*n
                rad=math.radians(angle)
                for i in range(n):
                    angles=[]
                    xi,yi=points[i]
                    for j in range(n):
                        if i==j: continue
                        xj,yj=points[j]
                        ang=math.atan2(yj-yi, xj-xi)  # -pi to pi
                        angles.append(ang)
                    # sort angles
                    angles.sort()
                    # duplicate with +2pi for circular wrap
                    m=len(angles)
                    angles2=angles+[ang+2*math.pi for ang in angles]
                    # sliding window
                    best=0
                    left=0
                    for right in range(len(angles2)):
                        while angles2[right]-angles2[left] > rad+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>best:
