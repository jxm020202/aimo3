            import random, math
            def compute_angle(theta, s, t):
                # Choose A = 1 for simplicity
                A = 1.0
                # compute B from diagonal equality condition: (t+1)A = (s+1)B
                B = (t+1)*A/(s+1)
                # define points
                a = (A, 0.0)
                b = (B*math.cos(theta), B*math.sin(theta))
                W = a
                X = b
                Y = (-t*a[0], -t*a[1])
                Z = (-s*b[0], -s*b[1])
                # define helper functions
                def midpoint(P, Q):
                    return ((P[0]+Q[0])/2.0, (P[1]+Q[1])/2.0)
                def perp_bisector(P, Q):
                    # returns (point on line, direction vector) for perpendicular bisector
                    mid = midpoint(P, Q)
                    # direction vector of original segment
                    dx = Q[0] - P[0]
                    dy = Q[1] - P[1]
                    # perpendicular direction
                    # we can use ( -dy, dx )
                    return (mid, (-dy, dx))
                # compute N as intersection of two lines
                # line1: point p1, direction v1
                # line2: point p2, direction v2
                def intersect(p1, v1, p2, v2):
                    # solve p1 + t*v1 = p2 + u*v2
                    # 2 equations
                    # Use linear algebra
                    import numpy as np
                    A_mat = np.array([[v1[0], -v2[0]], [v1[1], -v2[1]]], dtype=float)
                    b_vec = np.array([p2[0]-p1[0], p2[1]-p1[1]], dtype=float)
                    # solve for t, u
                    try:
                        sol = np.linalg.solve(A_mat, b_vec)
                    except np.linalg.LinAlgError:
                        return None
                    t = sol[0]
                    return (p1[0] + t*v1[0], p1[1] + t*v1[1])
                # N
                p1, v1 = perp_bisector(W, X)
                p2, v2 = perp_bisector(Y, Z)
                N = intersect(p1, v1, p2, v2)
                # O
                p3, v3 = perp_bisector(X, Y)
                p4, v4 = perp_bisector(W, Z)
                O = intersect(p3, v3, p4, v4)
                # compute angle NMO
                M = (0.0, 0.0) # intersection of diagonals (origin)
                # vectors
                vNM = (N[0]-M[0], N[1]-M[1])
                vOM = (O[0]-M[0], O[1]-M[1])
                # angle between
                dot = vNM[0]*vOM[0] + vNM[1]*vOM[1]
                norm1 = math.hypot(vNM[0], vNM[1])
                norm2 = math.hypot(vOM[0], vOM[1])
                angle = math.degrees(math.acos(dot/(norm1*norm2)))
                return angle, N, O
            
