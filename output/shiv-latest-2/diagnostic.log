            def barycentric_coords(W, s):
                # D(0,0), E(s,0), F(s/2, sqrt3/2*s)
                sqrt3 = sp.sqrt(3)
                D = sp.Point(0,0)
                E = sp.Point(s,0)
                F = sp.Point(s/2, sqrt3/2 * s)
                # Solve W = a*D + b*E + c*F, a+b+c=1
                a,b,c = sp.symbols('a b c')
                equations = [
                    sp.Eq(W.x, a*D.x + b*E.x + c*F.x),
                    sp.Eq(W.y, a*D.y + b*E.y + c*F.y),
                    sp.Eq(a+b+c, 1)
                ]
                sol = sp.solve(equations, (a,b,c), dict=True)[0]
                return sp.simplify(sol[a]), sp.simplify(sol[b]), sp.simplify(sol[c])
            
            def W_point(s, case):
                sqrt3 = sp.sqrt(3)
                X = sp.Point(2,0)
                Z = sp.Point((s-1)/2, sqrt3/2 * (s-1))
                if case == 1:
                    t = 1 - 2/s
                else:
                    t = sp.Rational(1,2) + 1/(2*s)
                h = sqrt3/2 * s
                Y = sp.Point(s - t*s/2, t*h)
                a = X - Y
                W = Z + a
                return sp.simplify(W)
            
