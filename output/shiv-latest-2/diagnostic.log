            import math, random
            def compute_FZ(s):
                D = (0,0)
                E = (s,0)
                F = (s/2, math.sqrt(3)/2*s)
                X = (2,0)
                # direction FD
                dir_FD = (-s/2, -math.sqrt(3)/2*s)
                # line through X parallel to FD intersect EF
                # param u for line X + u*dir_FD = point on EF
                # EF param t: E + t*(F-E)
                # solve linear equations
                # We'll solve using sympy for general s but compute numeric
                # Use earlier formulas:
                Y = (s/2 + 1, math.sqrt(3)/2*(s-2))
                # perp direction
                perp = (math.sqrt(3)/2*s, -s/2)
                # line through Y: Y + v*perp intersect FD (line from D to F)
                # Solve for v,w
                # Solve linear equations:
                # Y + v*perp = w*F
                # two equations:
                # Yx + v*perp_x = w*F_x
                # Yy + v*perp_y = w*F_y
                # solve:
                import numpy as np
                A = np.array([[perp[0], -F[0]],
                              [perp[1], -F[1]]], float)
                b = np.array([-Y[0], -Y[1]], float)
                # Actually we need Y + v*perp = w*F => v*perp - w*F = -Y
                # Solve for v,w
                sol = np.linalg.solve(A, b)
                v_val, w_val = sol
                Z = (w_val*F[0], w_val*F[1])
                # distance FZ
                dist = math.hypot(F[0]-Z[0], F[1]-Z[1])
                return dist
            
            for s_test in [3,4,5,10]:
                print(s_test, compute_FZ(s_test))
            
