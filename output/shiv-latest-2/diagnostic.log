            def estimate_p(N, batch=1000000, seed=0):
                rng = np.random.default_rng(seed)
                total_success = 0
                total = 0
                for _ in range((N + batch - 1)//batch):
                    m = min(batch, N - total)
                    theta = rng.random(m) * (math.pi/2)
                    x = rng.random(m)
                    y = rng.random(m)
                    c = np.cos(theta)
                    s = np.sin(theta)
                    g0x = c*x - s*y
                    g0y = s*x + c*y
                    g1x = c*(x+1) - s*y
                    g1y = s*(x+1) + c*y
                    g2x = c*x - s*(y+1)
                    g2y = s*x + c*(y+1)
                    g3x = c*(x+1) - s*(y+1)
                    g3y = s*(x+1) + c*(y+1)
                    cover0 = (g0x >= 0) & (g0x <= 1) & (g0y >= 0) & (g0y <= 1)
