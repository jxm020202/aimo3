            import random, math
            def compute_angle(a,b,c,e,theta):
                # compute N and O numeric
                # define points
                W = (-a, 0)
                Y = (b, 0)
                X = (c*math.cos(theta), c*math.sin(theta))
                Z = (-e*math.cos(theta), -e*math.sin(theta))
                # Solve for N: intersection of perp bisectors of WX and YZ
                # Use linear equations derived earlier: N·(X-W) = (X·X - W·W)/2, N·(Z-Y) = (Z·Z - Y·Y)/2
                import numpy as np
                # Build matrix A*N = RHS
                A = np.array([[X[0]-W[0], X[1]-W[1]],
                              [Z[0]-Y[0], Z[1]-Y[1]]], dtype=float)
                rhs = np.array([ (X[0]**2+X[1]**2 - (W[0]**2+W[1]**2))/2,
                                 (Z[0]**2+Z[1]**2 - (Y[0]**2+Y[1]**2))/2 ], dtype=float)
                N = np.linalg.solve(A, rhs)
                # O: O·(Y-X) = (Y·Y - X·X)/2, O·(W-Z) = (W·W - Z·Z)/2
                A2 = np.array([[Y[0]-X[0], Y[1]-X[1]],
                               [W[0]-Z[0], W[1]-Z[1]]], dtype=float)
                rhs2 = np.array([ (Y[0]**2+Y[1]**2 - (X[0]**2+X[1]**2))/2,
                                  (W[0]**2+W[1]**2 - (Z[0]**2+Z[1]**2))/2 ], dtype=float)
                O = np.linalg.solve(A2, rhs2)
                # compute angle between N and O
                dot = N[0]*O[0] + N[1]*O[1]
                normN = math.hypot(N[0], N[1])
                normO = math.hypot(O[0], O[1])
                cosang = dot/(normN*normO)
                # clamp
                cosang = max(min(cosang,1),-1)
                ang = math.degrees(math.acos(cosang))
                return ang
            
            def test_random():
                for i in range(10):
                    a = random.uniform(0.5, 5)
                    b = random.uniform(0.5, 5)
                    d = a+b
                    # choose c random, then e = d - c
                    c = random.uniform(0.5, d-0.5)
                    e = d - c
                    theta = random.uniform(0.2, 2.5) # not 0 or pi
                    ang = compute_angle(a,b,c,e,theta)
                    print(i, a,b,c,e,theta, ang)
            test_random()
            
