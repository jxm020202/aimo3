            def A_bad(theta, N=200000):
                # Monte Carlo estimate of area of translations t in [0,1)^2 that cause origin inside rotated square
                # Equivalent to probability that random t in unit square is in projection.
                # We'll sample t uniformly and test if origin in t + R_theta * [0,1]^2.
                # Equivalent to checking if -t is in R_theta * [0,1]^2.
                # So we can rotate -t by -theta and check if coordinates lie in [0,1]^2.
                count = 0
                cos = math.cos(theta)
                sin = math.sin(theta)
                for _ in range(N):
                    tx = random.random()
                    ty = random.random()
                    # compute point p = -t
                    px = -tx
                    py = -ty
                    # rotate by -theta: apply inverse rotation (transpose)
                    # R_theta = [[cos, -sin],[sin, cos]]
                    # Inverse = transpose = [[cos, sin],[-sin, cos]]
                    ux = cos*px + sin*py
                    uy = -sin*px + cos*py
                    if 0 <= ux <= 1 and 0 <= uy <= 1:
                        count += 1
                return count/N
            
            for th in [0, math.pi/12, math.pi/8, math.pi/6, math.pi/4]:
                print(th, A_bad(th, N=200000))
            
