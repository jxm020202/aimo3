            import math
            
            def edge_pair_for_angle(N, P, theta):
                # line through P with direction angle theta
                # param: P + t*(cosθ, sinθ)
                # find intersection with polygon edges
                verts = [(math.cos(2*math.pi*i/N), math.sin(2*math.pi*i/N)) for i in range(N)]
                edges = [(verts[i], verts[(i+1)%N]) for i in range(N)]
                # compute intersection of line with each edge segment
                # line param: x = Px + t*dx, y = Py + t*dy
                dx = math.cos(theta)
                dy = math.sin(theta)
                inters = []
                for i, (A,B) in enumerate(edges):
                    # edge param: A + u*(B-A), u in [0,1]
                    ex = B[0]-A[0]
                    ey = B[1]-A[1]
                    # solve P + t*d = A + u*e
                    # two equations:
                    # Px + t*dx = Ax + u*ex
                    # Py + t*dy = Ay + u*ey
                    # solve for t,u
                    # Use linear equations
                    det = dx*(-ey) - dy*(-ex)  # dx*(-ey) - dy*(-ex) = -dx*ey + dy*ex
                    # Actually matrix [[dx, -ex],[dy, -ey]] * [t,u]^T = [Ax-Px, Ay-Py]
                    det = dx*(-ey) - dy*(-ex)
                    if abs(det) < 1e-9:
                        continue
                    rhsx = A[0]-P[0]
                    rhsy = A[1]-P[1]
                    t = (rhsx*(-ey) - rhsy*(-ex))/det
                    u = (dx*rhsy - dy*rhsx)/det
                    if 0 <= u <= 1:
                        # intersection point
                        inters.append((i, t))
                # we should have exactly two intersections (enter and exit)
                if len(inters) != 2:
                    return None
                # sort by t (enter then exit)
                inters.sort(key=lambda x: x[1])
                return (inters[0][0], inters[1][0])
            
            def distinct_pairs(N, P):
                pairs = set()
                for k in range(0, 7200):
                    theta = 2*math.pi*k/7200
                    pair = edge_pair_for_angle(N, P, theta)
                    if pair:
                        pairs.add(tuple(sorted(pair)))
                return pairs
            
