            def feasible(L, trials=200000):
                L2 = L*L
                for _ in range(trials):
                    p = random.random()*math.sqrt(3)
                    q = random.random()*1.0
                    s = random.random()
                    if (p*p + q*q <= L2 and 
                        (p - math.sqrt(3)*(1 - s))**2 + s*s <= L2 and
                        3*(1 - s)**2 + (s - q)**2 <= L2):
                        return True, (p,q,s)
                return False, None
            
            def binary_search(low, high, eps=1e-6):
                while high - low > eps:
                    mid = (low + high)/2
                    ok, _ = feasible(mid, trials=20000)
                    if ok:
                        high = mid
                    else:
                        low = mid
                return high
            
