            S = sp.Point(x2, y2)
            
            def circumcenter(A, B, C):
                # Solve linear equations for O = (ox, oy)
                ox, oy = sp.symbols('ox oy', real=True)
                O = sp.Point(ox, oy)
                # Perpendicular bisector conditions: (O - midpoint) dot (B - A) = 0, (O - midpoint) dot (C - A) = 0
                eq1 = (O - (A+B)/2).dot(B - A)
                eq2 = (O - (A+C)/2).dot(C - A)
                sol = sp.solve([eq1, eq2], (ox, oy), dict=True)
                # Should be unique
                sol = sol[0]
                return sp.Point(sol[ox], sol[oy])
            
            def incenter(A, B, C):
                # side lengths opposite vertices
                a = B.distance(C)
                b = C.distance(A)
                c = A.distance(B)
                I = (a*A + b*B + c*C) / (a + b + c)
                return sp.Point(sp.simplify(I.x), sp.simplify(I.y))
            
            O1 = circumcenter(P, Q, R)
            O2 = circumcenter(P, R, S)
            I1 = incenter(P, Q, R)
