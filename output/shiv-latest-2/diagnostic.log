            def circumcenter_coords(A,B,C):
                # Solve linear equations for O = (ox, oy)
                ox, oy = sp.symbols('ox oy')
                O = sp.Matrix([ox, oy])
                A = sp.Matrix(A)
                B = sp.Matrix(B)
                C = sp.Matrix(C)
                # Midpoints
                M_AB = (A + B)/2
                M_AC = (A + C)/2
                # direction vectors
                d_AB = B - A
                d_AC = C - A
                # perpendicular conditions: (O - M_AB)·d_AB = 0, (O - M_AC)·d_AC = 0
                eq1 = (O - M_AB).dot(d_AB)
                eq2 = (O - M_AC).dot(d_AC)
                sol = sp.solve([eq1, eq2], (ox, oy), dict=True)[0]
                return sp.Point(sol[ox], sol[oy])
            
            def incenter_coords(A,B,C):
                # side lengths opposite vertices
                a = sp.sqrt(((B[0]-C[0])**2 + (B[1]-C[1])**2))
                b_len = sp.sqrt(((A[0]-C[0])**2 + (A[1]-C[1])**2))
                c_len = sp.sqrt(((A[0]-B[0])**2 + (A[1]-B[1])**2))
                # coordinates weighted
                x = (a*A[0] + b_len*B[0] + c_len*C[0])/(a+b_len+c_len)
                y = (a*A[1] + b_len*B[1] + c_len*C[1])/(a+b_len+c_len)
                return sp.Point(sp.simplify(x), sp.simplify(y))
            
