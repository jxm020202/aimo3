            def max_zero_run_mod_n(n, max_steps=5000000):
                mod = n
                # initial terms a_k = 2^{k-1} mod n for k=1..n
                a = [pow(2, k, mod) for k in range(n)]  # a[0] corresponds to a1
                max_run = 0
                cur_run = 0
                # compute initial run
                for val in a:
                    if val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # sliding window sum
                from collections import deque
                window = deque(a, maxlen=n)
                window_sum = sum(window) % mod
                for step in range(n, max_steps):
                    nxt = window_sum % mod
                    # update run
