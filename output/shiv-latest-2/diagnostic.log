            def perturb(points, step=0.1):
                # move a random point slightly
                n=len(points)
                i=random.randrange(n)
                x,y=points[i]
                # random direction
                angle=random.random()*2*math.pi
                r=step*random.random()
                newx=x+r*math.cos(angle)
                newy=y+r*math.sin(angle)
                # keep within unit circle
                if newx**2+newy**2>1:
                    # reflect inside
                    newx, newy = newx/(math.sqrt(newx**2+newy**2)), newy/(math.sqrt(newx**2+newy**2))
                    newx*=0.99
                    newy*=0.99
                new_points=points.copy()
                new_points[i]=(newx,newy)
                return new_points
            
