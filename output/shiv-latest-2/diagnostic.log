            import math
            
            def angle_at(A,B,C):
                # angle ABC (at B) between BA and BC
                BA = (A[0]-B[0], A[1]-B[1])
                BC = (C[0]-B[0], C[1]-B[1])
                dot = BA[0]*BC[0] + BA[1]*BC[1]
                normBA = math.hypot(BA[0], BA[1])
                normBC = math.hypot(BC[0], BC[1])
                cosang = dot/(normBA*normBC)
                # clamp
                cosang = max(-1,min(1,cosang))
                return math.degrees(math.acos(cosang))
            
            P = (0.0,0.0)
            Q = (2.0,0.0)
            R = ((3+math.sqrt(3))/2, (1+math.sqrt(3))/2)
