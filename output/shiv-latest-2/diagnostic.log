                while changed:
                    changed = False
                    # iterate over all pairs a,b in X (including equal)
                    for a in list(X):
                        for b in list(X):
                            # generate numbers for i such that result within bound
                            # we can generate for i in range where result within bound
                            # compute base = a*a + b*b
                            base = a*a + b*b
                            step = a*b
                            # i such that base + i*step within [-bound,bound]
                            if step == 0:
                                # only base
                                if -bound <= base <= bound and base not in X:
                                    X.add(base); changed=True
                            else:
