            import math, itertools
            
            def rotate_point(px, py, theta):
                c = math.cos(theta)
                s = math.sin(theta)
                return (c*px - s*py, s*px + c*py)
            
            def unit_square_polygon():
                return [(0.0,0.0),(1.0,0.0),(1.0,1.0),(0.0,1.0)]
            
            def square_polygon_centered(theta):
                # unit square side 1 centered at origin, rotated by theta
                # vertices of axis-aligned square centered at origin: (±0.5, ±0.5)
                verts = [(-0.5,-0.5),(0.5,-0.5),(0.5,0.5),(-0.5,0.5)]
                return [rotate_point(x,y,theta) for (x,y) in verts]
            
            def translate(poly, dx, dy):
                return [(x+dx, y+dy) for (x,y) in poly]
            
            def polygon_area(poly):
                # shoelace formula
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2.0
            
            def clip_polygon(poly, a, b, c, keep_le=True):
                # keep points satisfying a*x + b*y <= c if keep_le else >= c
                new_poly = []
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    v1 = a*x1 + b*y1 - c
                    v2 = a*x2 + b*y2 - c
                    inside1 = v1 <= 1e-12 if keep_le else v1 >= -1e-12
                    inside2 = v2 <= 1e-12 if keep_le else v2 >= -1e-12
                    if inside1:
                        new_poly.append((x1,y1))
                    # edge intersects the line?
                    if inside1 != inside2:
                        # compute intersection point with line a*x + b*y = c
                        t = v1/(v1 - v2)  # fraction from p1 to p2 where line is crossed
                        xi = x1 + t*(x2 - x1)
                        yi = y1 + t*(y2 - y1)
                        new_poly.append((xi, yi))
                return new_poly
            
            def intersect_polygons(poly_list):
                # intersect all polygons in list sequentially
                if not poly_list:
                    return []
                inter = poly_list[0][:]
                for poly in poly_list[1:]:
                    # clip inter by each halfplane of poly
                    m = len(poly)
                    for i in range(m):
                        x1,y1 = poly[i]
                        x2,y2 = poly[(i+1)%m]
                        # edge from (x1,y1) to (x2,y2). interior is to left of edge (assuming CCW order)
                        # compute line equation a*x + b*y <= c for interior
                        # For edge from p1 to p2, outward normal is (dy, -dx) for left side interior? Let's compute.
                        # For CCW polygon, interior is left of each directed edge.
                        dx = x2 - x1
                        dy = y2 - y1
                        # left normal (pointing interior) is (-dy, dx) (since cross product with edge gives outward?). Actually for edge direction (dx,dy), the left side is given by inequality ( -dy)*(x - x1) + dx*(y - y1) >= 0.
                        a = -dy
                        b = dx
                        c = a*x1 + b*y1
                        # keep points where a*x + b*y >= c
                        # We'll use keep_le=False to keep >=
                        inter = clip_polygon(inter, a, b, c, keep_le=False)
                        if not inter:
                            return []
                return inter
            
            def intersect_polygon_with_unit_square(poly):
                # clip with x>=0, x<=1, y>=0, y<=1
                # x >= 0 => -x <= 0 => a=-1,b=0,c=0 keep_le=True
                poly = clip_polygon(poly, -1, 0, 0, keep_le=True)
                # x <= 1 => x <= 1 => a=1,b=0,c=1 keep_le=True
                poly = clip_polygon(poly, 1, 0, 1, keep_le=True)
                # y >= 0 => -y <= 0
                poly = clip_polygon(poly, 0, -1, 0, keep_le=True)
                # y <= 1 => y <= 1
                poly = clip_polygon(poly, 0, 1, 1, keep_le=True)
                return poly
            
            def union_area_theta(theta):
                # compute area of union of four rotated squares intersected with unit square
                base = square_polygon_centered(theta)
                # corners
                corners = [(0,0),(1,0),(0,1),(1,1)]
                polys = [translate(base, cx, cy) for (cx,cy) in corners]
                # compute area of each intersected with unit square
                inters = [intersect_polygon_with_unit_square(p) for p in polys]
                areas = [polygon_area(p) for p in inters]
                total = sum(areas)
                # pairwise intersections
                for i,j in itertools.combinations(range(4),2):
                    inter = intersect_polygons([polys[i], polys[j], unit_square_polygon()])
                    total -= polygon_area(inter)
                # triple intersections
                for i,j,k in itertools.combinations(range(4),3):
                    inter = intersect_polygons([polys[i], polys[j], polys[k], unit_square_polygon()])
                    total += polygon_area(inter)
                # quadruple
                inter = intersect_polygons([polys[0], polys[1], polys[2], polys[3], unit_square_polygon()])
                total -= polygon_area(inter)
                return total
            
            def safe_area_theta(theta):
                return 1 - union_area_theta(theta)
            
            # test for some angles
