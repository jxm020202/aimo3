            import numpy as np, math, random
            def circumcenter(A,B,C):
                # using perpendicular bisectors intersection
                D = B - A
                E = C - A
                # solve for center O: (O-A).dot(D) = |B|^2 - |A|^2 /2? Actually use linear equations.
                # Use formula based on determinants.
                a = np.linalg.norm(B-C)**2
                b = np.linalg.norm(C-A)**2
                c = np.linalg.norm(A-B)**2
                # barycentric coordinates of circumcenter: a*sin(2A) etc? easier: use circumcenter via solving.
                # Solve for O: (O - A)·(B-A) = (|B|^2 - |A|^2)/2 etc.
                # Let's use linear algebra.
                M = np.array([B-A, C-A])
                rhs = np.array([ (np.dot(B,B)-np.dot(A,A))/2 , (np.dot(C,C)-np.dot(A,A))/2 ])
                # Solve M^T O = rhs + M^T A? Actually we have O·(B-A) = (|B|^2 - |A|^2)/2 and O·(C-A) = (|C|^2 - |A|^2)/2
                # So solve for O.
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter(A,B,C):
                # side lengths a=BC, b=CA, c=AB
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                return (a*A + b*B + c*C)/(a+b+c)
            
            def ratio_triangle(A,B,C):
                P = circumcenter(A,B,C)
                Q = incenter(A,B,C)
                # direction perp to PQ
                v = np.array([-(Q[1]-P[1]), Q[0]-P[0]])  # perpendicular to vector Q-P
                # line L: Q + t*v
                # intersect with DE (line through D= A? Wait triangle vertices are D,E,F. Let's map D=A, E=B, F=C
                D = A; E = B; F = C
                # Solve Q + t*v = D + u*(E-D)
                A_mat = np.column_stack((v, -(E-D)))
                b_vec = D - Q
                sol = np.linalg.lstsq(A_mat, b_vec, rcond=None)[0]
                tM = sol[0]
                # external bisector at F
                FD = D - F
                FE = E - F
                u_int = FD/np.linalg.norm(FD) + FE/np.linalg.norm(FE)
                v_ext = np.array([-u_int[1], u_int[0]])  # perp
                A_mat2 = np.column_stack((v, -v_ext))
                b_vec2 = F - Q
                sol2 = np.linalg.lstsq(A_mat2, b_vec2, rcond=None)[0]
                tN = sol2[0]
                return abs(tM)/abs(tN)
            
            for i in range(5):
                A = np.random.rand(2)*10
                B = np.random.rand(2)*10
                C = np.random.rand(2)*10
                # ensure non-collinear
                if abs(np.linalg.det(np.column_stack((B-A, C-A))))<1e-3:
                    continue
                print(ratio_triangle(A,B,C))
            
