            import numpy as np, math, sympy as sp, itertools, random, sys, time, math, numpy as np
            lam = sp.symbols('lam', real=True)
            x = sp.symbols('x', real=True)
            sqrt3 = sp.sqrt(3)
            a = sqrt3*(1 - lam)
            eq = (a**2 + lam**2 - x**2)**2 - 4*lam**2*(a**2 + lam**2 - 2*a*x)
            # solve for x given lam numerically
            def solve_for_x(lam_val):
                # substitute lam
                eq_num = sp.N(eq.subs(lam, lam_val))
                # convert to polynomial in x
                poly = sp.Poly(eq_num, x)
                coeffs = [float(c) for c in poly.all_coeffs()]  # highest degree first
                roots = np.roots(coeffs)
                real_roots = [r.real for r in roots if abs(r.imag) < 1e-8]
                return real_roots
            
            def compute_L2(lam_val, x_val):
                a_val = math.sqrt(3)*(1 - lam_val)
                y_val = (a_val**2 + lam_val**2 - x_val**2) / (2*lam_val) if lam_val != 0 else None
                # compute L2 = x^2 + y^2
                L2 = x_val**2 + y_val**2
                return L2, y_val
            
            def feasible(lam_val, x_val, y_val):
                # constraints
                if not (0 <= lam_val <= 1): return False
                if not (0 <= x_val <= math.sqrt(3)+1e-9): return False
                if not (0 <= y_val <= 1+1e-9): return False
                return True
            
            def find_min():
                best = 1e9
                best_tuple = None
                for lam_val in np.linspace(0.001, 0.999, 200):
                    roots = solve_for_x(lam_val)
                    for xv in roots:
                        y_val = ( (math.sqrt(3)*(1-lam_val))**2 + lam_val**2 - xv**2 )/(2*lam_val) if lam_val!=0 else None
                        if feasible(lam_val, xv, y_val):
                            L2 = xv**2 + y_val**2
                            if L2 < best:
                                best = L2
                                best_tuple = (lam_val, xv, y_val)
                return best, best_tuple
            
            best, tup = find_min()
            best, tup
