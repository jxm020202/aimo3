            def is_point_inside_triangle(P, A, B, C):
                # barycentric technique using signs of areas
                # compute vectors
                v0 = C - A
                v1 = B - A
                v2 = P - A
                # Compute dot products
                dot00 = v0.dot(v0)
                dot01 = v0.dot(v1)
                dot02 = v0.dot(v2)
                dot11 = v1.dot(v1)
                dot12 = v1.dot(v2)
                # Compute barycentric coordinates
                denom = dot00 * dot11 - dot01 * dot01
                if denom == 0:
                    return False
                u = (dot11 * dot02 - dot01 * dot12) / denom
                v = (dot00 * dot12 - dot01 * dot02) / denom
                # Check if point is inside triangle (including edges)
                return (u >= 0) and (v >= 0) and (u + v <= 1)
            
            def test_solution(s_val):
                s_val = sp.nsimplify(s_val)
                t = sp.symbols('t')
                eq = 2*s_val**2 - 6*s_val*t - 2*s_val + 4*t**2 + 6*t - 4
                sols = sp.solve(eq, t)
                X = sp.Point(2,0)
                Z = sp.Point((s_val-1)/2, sp.sqrt(3)/2 * (s_val-1))
                D = sp.Point(0,0)
                E = sp.Point(s_val,0)
                F = sp.Point(s_val/2, sp.sqrt(3)/2 * s_val)
                results = []
                for sol in sols:
                    sol_val = sp.N(sol)
                    if not sol_val.is_real:
                        continue
                    if not (0 <= sol_val <= s_val):
                        continue
                    Y = sp.Point(s_val - sol/2, sp.sqrt(3)/2 * sol)
                    # compute W
                    W = Z + (X - Y)  # ZW = YX
                    # check if W outside triangle (i.e., not inside)
                    inside = is_point_inside_triangle(W, D, E, F)
                    # compute angle ZXY
                    vZX = Z - X
                    vYX = Y - X
                    angle = sp.acos( (vZX.dot(vYX)) / (sp.sqrt(vZX.dot(vZX))*sp.sqrt(vYX.dot(vYX))) )
                    angle_deg = float(angle*180/sp.pi)
                    results.append((float(sol_val), angle_deg, inside))
                return results
            
