            def is_convex_polygon(verts):
                # verts list of Points in order, closed polygon
                n = len(verts)
                # compute cross product z-component of successive edges
                signs = []
                for i in range(n):
                    p0 = verts[i]
                    p1 = verts[(i+1)%n]
                    p2 = verts[(i+2)%n]
                    # vectors
                    v1 = sp.Matrix([p1.x - p0.x, p1.y - p0.y])
                    v2 = sp.Matrix([p2.x - p1.x, p2.y - p1.y])
                    cross_z = v1[0]*v2[1] - v1[1]*v2[0]
                    signs.append(sp.sign(cross_z))
                # All signs should be same (non-zero)
                # Use numeric evaluation
                signs_num = [float(s) for s in signs]
                # Check if all >0 or all <0
                return all(s > 0 for s in signs_num) or all(s < 0 for s in signs_num)
            
