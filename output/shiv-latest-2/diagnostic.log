            import math
            
            def point_in_triangle(P, s):
                # barycentric coordinates method: compute areas
                D = sp.Point(0,0)
                E = sp.Point(s,0)
                F = sp.Point(s/2, sp.sqrt(3)/2 * s)
                # Using sympy for sign? We'll compute using cross products.
                # Compute vectors
                def sign(p1, p2, p3):
                    return (p1.x - p3.x)*(p2.y - p3.y) - (p2.x - p3.x)*(p1.y - p3.y)
                b1 = sign(P, D, E) < 0.0
                b2 = sign(P, E, F) < 0.0
                b3 = sign(P, F, D) < 0.0
                return (b1 == b2) and (b2 == b3)
            
