            def solve_range_M(M):
                xs = list(range(-M, M+1))
                var = {x: sp.Symbol(f'g{x}') for x in xs}
                equations = []
                givens = {0:9,1:27,2:3,10:63}
                for x,val in givens.items():
                    equations.append(sp.Eq(var[x], val))
                a_vals = {0:9,1:27,2:3,10:63}
                for a,ga in a_vals.items():
                    for b in xs:
                        i1 = a + ga + b
                        i2 = a + b
                        i3 = a - b
                        i4 = a - ga - b
                        if i1 in var and i2 in var and i3 in var and i4 in var:
                            equations.append(sp.Eq(var[i1] - var[i2], var[i3] - var[i4]))
                unknowns = [var[x] for x in xs]
                A,bvec = sp.linear_eq_to_matrix(equations, unknowns)
                sol = sp.linsolve((A,bvec), unknowns)
                return sol, unknowns
            
