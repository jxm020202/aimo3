            def symbolic_ratio():
                α, β, γ = sp.symbols('α β γ', real=True)
                d = sp.Matrix([sp.cos(α), sp.sin(α)])
                e = sp.Matrix([sp.cos(β), sp.sin(β)])
                f = sp.Matrix([sp.cos(γ), sp.sin(γ)])
                a = 2*sp.sin((β-γ)/2)
                b = 2*sp.sin((γ-α)/2)
                c = 2*sp.sin((α-β)/2)
                I = (a*d + b*e + c*f) / (a + b + c)
                # direction of line L: J*I
                J = sp.Matrix([[0,-1],[1,0]])
                dirL = J*I
                # Intersection with DE: solve d + s*(e-d) = I + t*dirL
                s, t = sp.symbols('s t')
                eqs = sp.Eq(d + s*(e-d), I + t*dirL)
                # This is vector equality; solve componentwise
                sol = sp.solve([eqs.lhs[0]-eqs.rhs[0], eqs.lhs[1]-eqs.rhs[1]], (s, t), dict=True)[0]
                tM = sp.simplify(sol[t])
                # excenter opposite D: I_D = (-a*d + b*e + c*f)/(-a + b + c)
                I_D = (-a*d + b*e + c*f) / (-a + b + c)
                dirF = I_D - f
                # Intersection with line L: f + u*dirF = I + t2*dirL
                u, t2 = sp.symbols('u t2')
                eqs2 = sp.Eq(f + u*dirF, I + t2*dirL)
                sol2 = sp.solve([eqs2.lhs[0]-eqs2.rhs[0], eqs2.lhs[1]-eqs2.rhs[1]], (u, t2), dict=True)[0]
                tN = sp.simplify(sol2[t2])
                ratio = sp.simplify(tM / tN)
                return ratio
            
            ratio_sym = symbolic_ratio()
            ratio_sym
            
