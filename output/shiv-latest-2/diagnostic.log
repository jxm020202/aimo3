            import sympy as sp
            B, C = sp.symbols('B C', real=True)
            # Points on unit circle
            D = sp.Matrix([1, 0])
            E = sp.Matrix([sp.cos(2*B), sp.sin(2*B)])
            F = sp.Matrix([sp.cos(2*C), sp.sin(2*C)])
            # side lengths (chord lengths)
            a = 2*sp.sin(sp.Abs(B-C))  # but we can assume B>C maybe; use sin(B-C) with sign? We'll use sin(B-C) assuming B>C.
            # To avoid absolute, assume B > C and use sin(B-C)
            a = 2*sp.sin(B - C)
            b = 2*sp.sin(C)  # DF chord length
            c = 2*sp.sin(B)  # DE chord length
            # Incenter I
            I = (a*D + b*E + c*F) / (a + b + c)
            sp.simplify(I)
            
