            def reflect_point(X, A, B):
                # vector AB
                AB = sp.Matrix([B.x - A.x, B.y - A.y])
                AB_len2 = AB.dot(AB)
                # projection scalar t = dot(X-A, AB) / |AB|^2
                t = ((sp.Matrix([X.x - A.x, X.y - A.y])).dot(AB)) / AB_len2
                # projection point
