            pairs = [(i,j) for i in range(4) for j in range(i+1,4)]
            
            def backtrack(assign, idx):
                if idx == len(pairs):
                    # check condition
                    if valid_assignment(assign):
                        return assign
                    return None
                i,j = pairs[idx]
                allowed = [k for k in range(4) if k not in (i,j)]
                for k in allowed:
                    assign[(i,j)] = k
                    # early pruning: check partial condition for i and j if possible
                    # For each vertex v, if we have assigned all its three incident edges, we can check the set condition.
