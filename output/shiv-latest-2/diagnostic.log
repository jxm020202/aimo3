            import math, itertools
            
            def max_spread_on_arc(theta, n=100):
                # points on unit circle from angle 0 to theta inclusive
                angles = [i*theta/(n-1) for i in range(n)]
                max_spread = 0
                for i, phi in enumerate(angles):
                    dirs = []
                    for j, psi in enumerate(angles):
                        if i==j: continue
                        dx = math.cos(psi)-math.cos(phi)
                        dy = math.sin(psi)-math.sin(phi)
                        ang = math.atan2(dy,dx)
                        dirs.append(ang)
                    # normalize angles to range [0,2π)
                    dirs = [(a+2*math.pi)%(2*math.pi) for a in dirs]
                    # compute minimal angular interval covering all dirs (circular)
                    dirs.sort()
                    # compute gaps
                    max_gap = max((dirs[(k+1)%len(dirs)] - dirs[k]) % (2*math.pi) for k in range(len(dirs)))
                    # minimal covering interval length = 2π - max_gap
                    spread = 2*math.pi - max_gap
                    max_spread = max(max_spread, spread)
                return max_spread
            
            def find_theta():
                # binary search for theta such that max_spread <= 100°
                target = math.radians(100)
                lo, hi = 0, 2*math.pi
                for _ in range(30):
                    mid = (lo+hi)/2
                    spread = max_spread_on_arc(mid)
                    if spread <= target:
                        lo = mid
                    else:
                        hi = mid
                return lo, max_spread_on_arc(lo)
            
            theta_opt, spread_opt = find_theta()
            theta_opt_deg = math.degrees(theta_opt)
            spread_opt_deg = math.degrees(spread_opt)
