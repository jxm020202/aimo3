            def solve_modular_linear(A, b, mod):
                # Solve A x = b (mod mod) using Gaussian elimination, returns a solution list or None if no solution.
                import copy
                n = len(A)
                m = len(A[0])
                # augment matrix
                aug = [[(A[i][j] % mod) for j in range(m)] + [b[i] % mod] for i in range(n)]
                row = 0
                col = 0
                while row < n and col < m:
                    # find pivot
                    pivot = None
                    for r in range(row, n):
                        if aug[r][col] % mod != 0:
                            pivot = r
                            break
                    if pivot is None:
                        col += 1
                        continue
                    # swap rows
                    aug[row], aug[pivot] = aug[pivot], aug[row]
                    inv = pow(aug[row][col], -1, mod)  # modular inverse
                    # normalize pivot row
                    for c in range(col, m+1):
                        aug[row][c] = (aug[row][c] * inv) % mod
