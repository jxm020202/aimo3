            import math
            def angle_theta(sval):
                tval = (sval**2 - sval + 4)/(sval*(sval+1))
                X = (2,0)
                Y = (sval*(1 - tval/2), sval*tval*math.sqrt(3)/2)
                Z = ((sval-1)/2, math.sqrt(3)/2*(sval-1))
                # vectors
                ZX = (X[0]-Z[0], X[1]-Z[1])
                XY = (Y[0]-X[0], Y[1]-X[1])
                dot = ZX[0]*XY[0] + ZX[1]*XY[1]
                normZX = math.hypot(*ZX)
                normXY = math.hypot(*XY)
                cos = dot/(normZX*normXY)
                theta = math.degrees(math.acos(cos))
                return theta
            
