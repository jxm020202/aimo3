            def check_incenter(alpha_val):
                # Solve for S and d
                guess = [1.0, 0.5, 0.5]
                sol = solve_alpha(alpha_val, guess)
                if sol is None:
                    return None
                d_val = float(sol[0])
                xS_val = float(sol[1])
                yS_val = float(sol[2])
                # compute O
                Ox = d_val/2
                Oy = (1 - d_val*math.cos(alpha_val)) / (2*math.sin(alpha_val))
                # points
                P = (0.0, 0.0)
                R = (d_val, 0.0)
                S = (xS_val, yS_val)
                O = (Ox, Oy)
                # cross product function for 2D (z-component)
                def cross(ax, ay, bx, by):
                    return ax*by - ay*bx
                # line RS: vector RS = S - R
                RS = (S[0]-R[0], S[1]-R[1])
                # vector from R to P
                RP_vec = (P[0]-R[0], P[1]-R[1])
                # vector from R to O
                RO_vec = (O[0]-R[0], O[1]-R[1])
                cross_R = cross(RS[0], RS[1], RP_vec[0], RP_vec[1])
                cross_O = cross(RS[0], RS[1], RO_vec[0], RO_vec[1])
                # line PS: vector PS = S - P
                PS = (S[0]-P[0], S[1]-P[1])
                # vector from P to R
                PR_vec = (R[0]-P[0], R[1]-P[1])
                # vector from P to O
                PO_vec = (O[0]-P[0], O[1]-P[1])
                cross_P = cross(PS[0], PS[1], PR_vec[0], PR_vec[1])
                cross_O2 = cross(PS[0], PS[1], PO_vec[0], PO_vec[1])
                # O is inside if cross_O has same sign as cross_R and cross_O2 same sign as cross_P
                inside = (cross_R * cross_O > 0) and (cross_P * cross_O2 > 0) and (Oy > 0)
                return inside, (Ox,Oy), (d_val, xS_val, yS_val)
            
