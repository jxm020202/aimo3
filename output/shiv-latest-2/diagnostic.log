            import random, math, numpy as np
            
            def angle_NMO(W, X, Y, Z):
                # compute intersection M of WY and XZ
                # Solve for t,s such that W + t*(Y-W) = X + s*(Z-X)
                # W = (0,0) for convenience
                # Use linear equations
                Wx, Wy = W
                Xx, Xy = X
                Yx, Yy = Y
                Zx, Zy = Z
                # vectors
                v1 = np.array([Yx - Wx, Yy - Wy])  # WY direction
                v2 = np.array([Zx - Xx, Zy - Xy])  # XZ direction
                # Solve Wx + t*v1 = Xx + s*v2
                # Two equations:
                # t*v1[0] - s*v2[0] = Xx - Wx
                # t*v1[1] - s*v2[1] = Xy - Wy
                A = np.array([[v1[0], -v2[0]],
                              [v1[1], -v2[1]]], dtype=float)
                b = np.array([Xx - Wx, Xy - Wy], dtype=float)
                try:
                    t, s = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    return None
                M = np.array([Wx + t*v1[0], Wy + t*v1[1]])
                # N: intersection of perp bisector of WX (vertical line x=0.5) and perp bisector of YZ
                # perp bisector of WX: x = (Wx+Xx)/2
                x_mid_WX = (Wx + Xx)/2.0
                # YZ midpoint
                mid_YZ = np.array([(Yx+Zx)/2.0, (Yy+Zy)/2.0])
                # direction of YZ
                d_YZ = np.array([Zx - Yx, Zy - Yy])
                # perpendicular direction
                perp_YZ = np.array([-d_YZ[1], d_YZ[0]])  # rotate 90 deg
                # line param: mid_YZ + u*perp_YZ
                # find u such that x = x_mid_WX
                if perp_YZ[0] == 0:
                    # vertical line, then x is constant = mid_YZ[0]; need equality
                    if abs(mid_YZ[0] - x_mid_WX) > 1e-9:
                        return None
                    # infinite solutions; choose y=mid_YZ[1]
                    N = np.array([x_mid_WX, mid_YZ[1]])
                else:
                    u = (x_mid_WX - mid_YZ[0]) / perp_YZ[0]
                    N = mid_YZ + u*perp_YZ
                # O: intersection of perp bisector of XY and WZ
                # perp bisector of XY
                mid_XY = np.array([(Xx+Yx)/2.0, (Xy+Yy)/2.0])
                d_XY = np.array([Yx - Xx, Yy - Xy])
                perp_XY = np.array([-d_XY[1], d_XY[0]])
                # perp bisector of WZ
                mid_WZ = np.array([(Wx+Zx)/2.0, (Wy+Zy)/2.0])
                d_WZ = np.array([Zx - Wx, Zy - Wy])
                perp_WZ = np.array([-d_WZ[1], d_WZ[0]])
                # Solve for intersection of two lines: mid_XY + a*perp_XY = mid_WZ + b*perp_WZ
                A2 = np.column_stack((perp_XY, -perp_WZ))
                b2 = mid_WZ - mid_XY
                # Solve linear system for a,b
