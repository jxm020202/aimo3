            def original_eq_rhs(x_val, y_val):
                import math
                def real_cuberoot(z):
                    if z >= 0:
                        return z**(1/3)
                    else:
                        return -((-z)**(1/3))
                sqrt1_2x = math.sqrt(1 - 2*x_val)
                A = (1 + x_val**2)/2 + (1/6) * math.sqrt(9*x_val**4 + (4/3)*x_val**6 + 9 + 18*x_val**2)
