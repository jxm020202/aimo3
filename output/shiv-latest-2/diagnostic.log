            def has_solution_mod_p(p, max_n=None):
                # returns True if exists n>=1 such that a_n ≡ 0 mod p
                # We'll test n from 1 to period = p-1 (or lcm of orders)
                if p==2:
                    # compute a_n mod 2: a_n = 2^n+3^n+6^n-1 mod2
                    # 2^n ≡0, 3^n≡1, 6^n≡0 => a_n ≡ 0+1+0-1 =0 mod2 for any n.
                    return True
                if p==3:
                    # 2^n mod3 cycles 2,1; 3^n≡0; 6^n≡0; a_n ≡ 2^n -1 mod3.
                    # Need 2^n ≡1 mod3 => n even. So solution exists.
                    return True
                # else p odd >3
                # compute orders
                # We can just iterate n up to p-1
                for n in range(1, p):
