            import random, math, itertools, sys, numpy as np, sympy as sp
            
            def compute_angle_NMO(W, X, Y, Z):
                # Convert to sympy Matrix
                w = sp.Matrix(W)
                x = sp.Matrix(X)
                y = sp.Matrix(Y)
                z = sp.Matrix(Z)
                # Intersection M of diagonals WY and XZ
                # Solve for M as intersection of lines (W + t*(Y-W)) and (X + s*(Z-X))
                t, s = sp.symbols('t s')
                M_eq = w + t*(y-w) - (x + s*(z-x))
                sol = sp.solve(M_eq, (t, s), dict=True)
                if not sol:
                    return None
                sol = sol[0]
                M = w + sol[t]*(y-w)
                # N: intersection of perp bisectors of WX and YZ
                # Solve linear equations: (N - m_wx)·(x-w)=0, (N - m_yz)·(z-y)=0
                N = sp.symbols('Nx Ny')
                Nx, Ny = N
                Nvec = sp.Matrix([Nx, Ny])
                m_wx = (w + x)/2
                d_wx = x - w
                m_yz = (y + z)/2
                d_yz = z - y
                eq1 = (Nvec - m_wx).dot(d_wx)
                eq2 = (Nvec - m_yz).dot(d_yz)
                solN = sp.solve([eq1, eq2], (Nx, Ny), dict=True)[0]
                Npt = sp.Matrix([solN[Nx], solN[Ny]])
                # O: intersection of perp bisectors of XY and WZ
                O = sp.symbols('Ox Oy')
                Ox, Oy = O
                Ovec = sp.Matrix([Ox, Oy])
                m_xy = (x + y)/2
                d_xy = y - x
                m_wz = (w + z)/2
                d_wz = z - w
                eq3 = (Ovec - m_xy).dot(d_xy)
                eq4 = (Ovec - m_wz).dot(d_wz)
                solO = sp.solve([eq3, eq4], (Ox, Oy), dict=True)[0]
                Opt = sp.Matrix([solO[Ox], solO[Oy]])
                # Compute angle NMO
                v1 = Npt - M
                v2 = Opt - M
                # angle = arccos( (v1·v2) / (|v1||v2|) )
                dot = sp.simplify(v1.dot(v2))
                norm1 = sp.sqrt(sp.simplify(v1.dot(v1)))
                norm2 = sp.sqrt(sp.simplify(v2.dot(v2)))
                cosang = sp.simplify(dot/(norm1*norm2))
                # numeric value
                cosang_n = float(cosang.evalf())
                angle = math.degrees(math.acos(cosang_n))
                return angle, float(cosang_n), M, Npt, Opt
            
            def random_quadrilateral():
                # Choose W=(0,0), Y=(1,0)
                W = np.array([0.0, 0.0])
                Y = np.array([1.0, 0.0])
                # Choose M on WY (0<t<1)
                t = random.uniform(0.2, 0.8)
                M = W + t*(Y-W)  # point on line
                # Choose X randomly not collinear, distance to M <= 1
                while True:
                    X = np.array([random.uniform(-0.5, 1.5), random.uniform(0.1, 1.5)])  # avoid collinear
                    d1 = np.linalg.norm(X - M)
                    if d1 <= 1.0 and d1>1e-6:
                        break
                # Compute Z such that XZ passes through M and |XZ| = |WY| = 1
                # s = d1 / 1 = d1
                s = d1
                # direction d = (M - X)/s
                d = (M - X)/s
                Z = X + d
                return W, X, Y, Z
            
            # test many random quadrilaterals
            angles = []
