            def best_product_for_a_p(a, p):
                b = 200 - a
                if b < 2:
                    return Fraction(0,1)
                # compute interval of possible sums for subsets of size a not containing p
                min_s = min_sum_a_excluding_p(a, p)
                max_s = max_sum_a_excluding_p(a, p)
                # vertex S_opt
                S_opt = (a - 100) * p + 10050
                # candidate integer sums: nearest integer(s) to S_opt within interval
                candidates = []
                # consider floor and ceil
                for S in [math.floor(S_opt), math.ceil(S_opt)]:
                    if S < min_s:
                        S = min_s
                    if S > max_s:
                        S = max_s
                    candidates.append(S)
                # also consider endpoints just in case
                candidates.append(min_s)
                candidates.append(max_s)
                # deduplicate
                candidates = set(candidates)
                best = Fraction(0,1)
                for S in candidates:
                    # compute product given S_A = S
                    # compute Δ_A and Δ_B using formulas
                    # Δ_A = (a * p - S) / (a*(a+1))
