            import random, math, numpy as np
            
            def circumcenter(A,B,C):
                # returns circumcenter coordinates
                # using perpendicular bisectors intersection
                # formula using linear algebra
                D = 2*(A[0]*(B[1]-C[1]) + B[0]*(C[1]-A[1]) + C[0]*(A[1]-B[1]))
                if abs(D) < 1e-9:
                    return None
                Ux = ((np.dot(A,A))*(B[1]-C[1]) + (np.dot(B,B))*(C[1]-A[1]) + (np.dot(C,C))*(A[1]-B[1]))/D
                Uy = ((np.dot(A,A))*(C[0]-B[0]) + (np.dot(B,B))*(A[0]-C[0]) + (np.dot(C,C))*(B[0]-A[0]))/D
                return np.array([Ux, Uy])
            
            def incenter(A,B,C):
                # side lengths
                a = np.linalg.norm(B-C) # opposite A
                b = np.linalg.norm(C-A) # opposite B
                c = np.linalg.norm(A-B) # opposite C
                P = a + b + c
                return (a*A + b*B + c*C)/P
            
            def external_bisector_point(F, D, E):
                # external angle bisector at F: line through F that bisects external angle between FD and FE.
                # direction vector can be obtained as normalized difference of unit vectors along FD and FE (one with opposite sign)
                # internal bisector direction = (u1/|u1| + u2/|u2|) where u1 = D-F, u2 = E-F.
                # external bisector direction = (u1/|u1| - u2/|u2|) (or opposite)
                u1 = D - F
                u2 = E - F
                u1n = u1/np.linalg.norm(u1)
                u2n = u2/np.linalg.norm(u2)
                # external bisector direction vector:
                v = u1n - u2n
                # line: F + t*v
                return v
            
            def intersect_line_line(p1, d1, p2, d2):
                # lines p1 + t*d1, p2 + s*d2
                # solve for t,s
                # 2D cross product method
                # d1 x d2 !=0
                A = np.array([d1, -d2]).T
                b = p2 - p1
                # solve A*[t,s]^T = b
                try:
                    ts = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    return None
                t = ts[0]
                return p1 + t*d1
            
            def ratio_for_triangle(D,E,F):
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line PQ direction
                dir_PQ = P - Q
                # perpendicular direction
                perp = np.array([-dir_PQ[1], dir_PQ[0]])  # rotate 90 deg
                # line through Q with direction perp
                # intersect with DE
                M = intersect_line_line(Q, perp, D, E-D)
                # external bisector at F direction
                v_ext = external_bisector_point(F, D, E)
                N = intersect_line_line(Q, perp, F, v_ext)
                # distances
                QM = np.linalg.norm(M - Q)
                QN = np.linalg.norm(N - Q)
                return QM/QN
            
            def random_triangle():
                # generate non-collinear random points
                while True:
                    D = np.random.rand(2)*10
                    E = np.random.rand(2)*10
                    F = np.random.rand(2)*10
                    # area not zero
                    if abs(np.cross(E-D, F-D)) > 1e-3:
                        return D,E,F
            
            for i in range(10):
                D,E,F = random_triangle()
                r = ratio_for_triangle(D,E,F)
                print(r)
            
