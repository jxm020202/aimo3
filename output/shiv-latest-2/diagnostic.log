            def cf_terms(fr):
                # return list of continued fraction terms (positive)
                a = fr.numerator
                b = fr.denominator
                terms = []
                while b != 0:
                    q = a // b
                    terms.append(q)
                    a, b = b, a - q*b
                return terms
            
            def test_cf_parity(data):
                mismatches = 0
                for p,q,val in data:
                    fr = Fraction(p,q)
                    terms = cf_terms(fr)
                    parity = len(terms) % 2
                    if parity != val:
                        mismatches += 1
                return mismatches
            
            test_cf_parity(data)
            
