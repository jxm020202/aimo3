            import sympy as sp
            
            # define symbols
            d,e,f = sp.symbols('d e f', real=True)
            # points on unit circle
            D = sp.exp(sp.I*d)
            E = sp.exp(sp.I*e)
            F = sp.exp(sp.I*f)
            # side lengths (chord lengths)
            a = sp.Abs(E - F)  # but sympy may keep sqrt
            b = sp.Abs(F - D)
            c = sp.Abs(D - E)
            # However using unit circle radius 1, chord length = 2*sin(angle/2)
            a = 2*sp.sin((e-f)/2)
            b = 2*sp.sin((f-d)/2)
            c = 2*sp.sin((d-e)/2)
            
            I = (a*D + b*E + c*F)/(a+b+c)  # incenter complex
            # line direction perpendicular to OI: multiply by I*i (rotate 90)
            dir_perp = sp.I*I
            # param s for line through I: I + s*dir_perp
            s = sp.symbols('s', real=True)
            # param t for DE line: D + t*(E-D)
            t = sp.symbols('t', real=True)
            
            eq = sp.Eq(I + s*dir_perp, D + t*(E-D))
            # This is complex equation; separate real and imag
            eq_real = sp.Eq(sp.re(eq.lhs), sp.re(eq.rhs))
            eq_imag = sp.Eq(sp.im(eq.lhs), sp.im(eq.rhs))
            sol = sp.solve([eq_real, eq_imag], (s,t), dict=True)
            sol
            
