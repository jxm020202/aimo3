            def next_state(state):
                h=sum(state)
                if h==0:
                    return None
                new=state.copy()
                new[h-1]=1-new[h-1]
                return new
            
            def all_transitions(n):
                trans={}
                for bits in itertools.product([0,1], repeat=n):
                    s=list(bits)
                    nxt=next_state(s)
                    trans[bits]=tuple(nxt) if nxt else None
                return trans
            
            def check_monotonic(n):
                # try lexicographic order (from leftmost position1 to n)
                # i.e., compare tuples directly
                trans=all_transitions(n)
                for s,t in trans.items():
                    if t is None: continue
                    if not (s>t): # want s > t lexicographically?
                        return False, s, t
                return True, None, None
            
