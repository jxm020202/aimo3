            import math
            def angle_deg(L_val):
                L_val = float(L_val)
                # compute coordinates
                X = (2.0, 0.0)
                Z = ((L_val-1)/2.0, math.sqrt(3)/2.0*(L_val-1))
                # compute b1 using formula with D = L-5 (since L>=5)
                D = L_val - 5.0
                b1x = 1 - math.sqrt(3)*(1 - L_val - D)/8.0
                b1y = math.sqrt(3)*(1 - L_val - D)/8.0
                Y = (Z[0] + b1x, Z[1] + b1y)
                # vectors
                ZX = (Z[0] - X[0], Z[1] - X[1])
                XY = (Y[0] - X[0], Y[1] - X[1])
                dot = ZX[0]*XY[0] + ZX[1]*XY[1]
                normZX = math.hypot(ZX[0], ZX[1])
                normXY = math.hypot(XY[0], XY[1])
                cos_theta = dot/(normZX*normXY)
                # clamp
                cos_theta = max(-1.0, min(1.0, cos_theta))
                theta = math.degrees(math.acos(cos_theta))
                return theta
            
            for L in [5,6,7,8,10,20]:
                print(L, angle_deg(L))
            
