            # Build graph for rationals with numerator, denominator bounded
            from fractions import Fraction
            
            def build_graph(limit):
                # include rationals with |num|,|den| <= limit, den>0, gcd=1
                verts = []
                for num in range(-limit, limit+1):
                    for den in range(1, limit+1):
                        if math.gcd(num, den) == 1:
                            verts.append(Fraction(num, den))
                # map to index
                idx = {v:i for i,v in enumerate(verts)}
                adj = [[] for _ in verts]
                for v in verts:
                    i = idx[v]
                    for w in neighbors(v):
                        if w in idx:
                            adj[i].append(idx[w])
                return verts, adj
            
