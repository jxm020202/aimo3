            def find_matrix_for_target(p,q, max_s=5000):
                # target = p/q in lowest terms (p,q positive? could be any sign)
                # search for integer s, t1, t2 to satisfy equations and determinant +/-1
                # We'll search for s in range -max_s..max_s excluding 0.
