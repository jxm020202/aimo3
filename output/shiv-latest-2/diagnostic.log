            from sympy.geometry import Polygon, Point
            def rotated_square(center, theta):
                cx, cy = center
                # vertices of unit square centered at origin before rotation
                verts = [(-0.5, -0.5), (0.5, -0.5), (0.5, 0.5), (-0.5, 0.5)]
                c = sp.cos(theta)
                s = sp.sin(theta)
                rot_verts = []
                for x,y in verts:
                    xr = x*c - y*s + cx
                    yr = x*s + y*c + cy
                    rot_verts.append((xr, yr))
                return Polygon(*[Point(v) for v in rot_verts])
            
            theta = sp.pi/4
            sq0 = rotated_square((0,0), theta)
            sq1 = rotated_square((1,0), theta)
            inter = sq0.intersection(sq1)
            inter
            
