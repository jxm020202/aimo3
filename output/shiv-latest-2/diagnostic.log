            import math
            
            def last_nonzero_digit_fact(n):
                # compute n! as int, remove trailing zeros, get last digit
                # but factorial grows huge quickly; for n up to maybe 2000 it's okay.
                # Use iterative multiplication with removal of factors of 10 to keep size manageable.
                res = 1
                for i in range(2, n+1):
                    res *= i
                    # remove factors of 10
                    while res % 10 == 0:
                        res //= 10
                    # keep only some digits to avoid overflow
                    res %= 10**12  # keep enough digits
                return res % 10
            
            def test_k(k, N=200):
                for n in range(2, N+1):
                    if last_nonzero_digit_fact(k*n) != last_nonzero_digit_fact(n):
                        return False
                return True
            
            candidates = []
