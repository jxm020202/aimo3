            def random_point_on_sphere():
                # generate random point uniformly on sphere
                while True:
                    x = random.gauss(0,1)
                    y = random.gauss(0,1)
                    z = random.gauss(0,1)
                    norm = math.sqrt(x*x+y*y+z*z)
                    if norm>0:
                        return (x/norm, y/norm, z/norm)
            
            def random_point_in_triangle():
                # barycentric coordinates for triangle vertices (2,0,0),(0,4,0),(0,0,6)
                u = random.random()
                v = random.random()
                if u+v>1:
                    u = 1-u
                    v = 1-v
                # point = u*V1 + v*V2 + (1-u-v)*V3? Actually we need three vertices.
                V1 = np.array([2.0,0.0,0.0])
                V2 = np.array([0.0,4.0,0.0])
                V3 = np.array([0.0,0.0,6.0])
                # barycentric coordinates: w = 1-u-v for V3
                w = 1-u-v
                return u*V1 + v*V2 + w*V3
            
            def chebyshev_dist(p,q):
                return max(abs(p[0]-q[0]),abs(p[1]-q[1]),abs(p[2]-q[2]))
            
            def estimate_min(samples=200000):
                best = 1e9
                best_pair = None
                for _ in range(samples):
                    A = random_point_on_sphere()
                    B = random_point_in_triangle()
                    d = chebyshev_dist(A,B)
                    if d < best:
                        best = d
                        best_pair = (A,B)
                return best,best_pair
            
