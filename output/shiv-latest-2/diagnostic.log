            import sympy as sp
            
            x = sp.symbols('x')
            sqrt_term = sp.sqrt(1 - 2*x)
            term = (4*x - 2 + 2*sqrt_term) / (3 - 5*x - sqrt_term)
            inner_sqrt = sp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
            A_plus = (1 + x**2)/2 + sp.Rational(1,6)*inner_sqrt
            A_minus = (1 + x**2)/2 - sp.Rational(1,6)*inner_sqrt
            # cube roots: sympy's real_root?
            C1 = sp.real_root(A_plus, 3)
            C2 = sp.real_root(A_minus, 3)
            f_expr = sp.simplify(term + C1 + C2)
            f_expr
            
