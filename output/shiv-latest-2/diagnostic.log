            def bfs_parities_distinct(start, targets, max_depth=30):
                visited = {start:0}
                q = deque([start])
                while q:
                    r = q.popleft()
                    parity = visited[r]
                    # generate neighbors distinct
                    # -r (distinct unless r=0)
                    if r != 0:
                        nr = -r
                        if nr not in visited:
                            visited[nr] = parity ^ 1
                            q.append(nr)
                    # 1 - r (distinct unless r=1/2)
                    if r != Fraction(1,2):
