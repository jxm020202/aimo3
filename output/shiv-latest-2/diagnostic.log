                    # compute minimal k: denominator of x and y
                    # denominators in reduced form
                    kx = x.denominator
                    ky = y.denominator
                    # minimal k is lcm of denominators
                    import math
                    k = math.lcm(kx, ky)
                    solutions.append((k, x, y, u, v, t_val))
                return solutions
            
