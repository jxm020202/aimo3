                A2,B2 = np.linalg.solve(np.array([[-b, -c],[a, d]], dtype=float), np.array([(b**2 - c**2)/2, (a**2 - d**2)/2], dtype=float))
                # Solve for alpha',beta' similarly
                alpha2,beta2 = np.linalg.solve(M, np.array([A2,B2]))
                o = alpha2*u + beta2*v
                
                # compute angle between n and o
                dot = np.dot(n,o)
                norm_n = np.linalg.norm(n)
                norm_o = np.linalg.norm(o)
                if norm_n==0 or norm_o==0:
                    return None
                cos_angle = dot/(norm_n*norm_o)
                # clamp
                cos_angle = max(-1, min(1, cos_angle))
                angle = math.degrees(math.acos(cos_angle))
                return angle
            
            # test many random cases
            angles = []
            for _ in range(200):
                ang = compute_angle()
                if ang is not None:
                    angles.append(ang)
            len(angles), angles[:10]
            
