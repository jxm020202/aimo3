                # initialize
                a = [pow(2, i, n) for i in range(n)]  # a[0]=2^0 mod n, ..., a[n-1]=2^{n-1} mod n
                # note: a_k for k=1..n correspond to a[0..n-1]
                # compute sliding sum
                window_sum = sum(a) % n
                # track max zero run
                max_run = 0
                cur_run = 0
                # check initial terms
                for val in a:
                    if val % n == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # store state: tuple of last n terms
                seen = {tuple(a): 0}
                # iterate
                k = n  # next index (0-based) corresponds to term a_{k+1}
                while k < max_iter:
                    # compute next term
                    next_val = window_sum % n
                    # update sliding window sum: add next_val, subtract a[0]
                    window_sum = (window_sum + next_val - a[0]) % n
                    # shift list
                    a = a[1:] + [next_val]
                    # update zero run
                    if next_val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
