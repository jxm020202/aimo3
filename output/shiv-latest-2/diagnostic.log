            def covering_radius(theta, samples=200000):
                # sample points in unit cell [0,1)^2
                # compute min L∞ distance to lattice L (rotated integer lattice)
                # L points: R_{-theta} * (i,j) for integer i,j
                # For each sample point y, compute min over lattice points of max(|y - R_{-theta}(i,j)|)
                # Equivalent to rotate point by theta to get coordinates in lattice basis? Let's compute directly.
                cos_t = math.cos(theta)
                sin_t = math.sin(theta)
                # basis vectors of lattice L: v1 = (cos, -sin), v2 = (sin, cos)
                # To find nearest lattice point to y, we can compute coordinates in basis: solve y = a*v1 + b*v2 + residual
                # Since v1,v2 are orthonormal (rotation), we can compute a = dot(y, v1), b = dot(y, v2)
                # Actually v1 and v2 form orthonormal basis (rotation matrix). So coordinates (a,b) = (dot(y, v1), dot(y, v2)).
                # Then nearest lattice point corresponds to rounding a,b to nearest integers (i,j)
                # Then lattice point = i*v1 + j*v2.
                # Then L∞ distance = max(|(y - (i*v1 + j*v2))_x|, |(y - ...)_y|)
                # Let's implement.
                max_dist = 0.0
                for _ in range(samples):
                    yx = random.random()
                    yy = random.random()
                    # coordinates in basis
                    a = yx * cos_t + yy * (-sin_t)  # dot(y, v1) = y·v1 = x*cos + y*(-sin)
                    b = yx * sin_t + yy * cos_t      # dot(y, v2)
                    i = round(a)  # nearest integer
                    j = round(b)
                    # lattice point
                    lx = i * cos_t + j * sin_t
                    ly = -i * sin_t + j * cos_t
                    dx = yx - lx
                    dy = yy - ly
                    dist = max(abs(dx), abs(dy))
                    if dist > max_dist:
                        max_dist = dist
                return max_dist
            
            for th in [0, math.pi/8, math.pi/6, math.pi/4]:
                print(th, covering_radius(th, samples=200000))
