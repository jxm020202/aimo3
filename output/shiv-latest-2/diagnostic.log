            def excenter_opposite_vertex(D,E,F, vertex='D'):
                # compute excenter opposite D: intersection of external bisectors at E and F, internal at D
                # Use formula: excenter coordinates = (-a*Ax + b*Bx + c*Cx)/(-a+b+c) etc? Actually excenter opposite A uses side lengths a=BC, b=CA, c=AB with signs.
                # For triangle with vertices A,B,C, excenter opposite A: ( -a*A + b*B + c*C ) / (-a+b+c)
                # where a = BC length opposite A, etc.
                # So for opposite D, treat D as A, E as B, F as C.
                a = np.linalg.norm(E-F)  # opposite D
                b_len = np.linalg.norm(D-F)  # opposite E
                c = np.linalg.norm(D-E)  # opposite F
                # excenter opposite D:
                if vertex == 'D':
                    # (-a*D + b*E + c*F)/(-a+b+c)
                    return (-a*np.array(D) + b_len*np.array(E) + c*np.array(F))/(-a + b_len + c)
                elif vertex == 'E':
                    # (-b*E + a*D + c*F)/ (a - b + c)
                    return (-b_len*np.array(E) + a*np.array(D) + c*np.array(F))/(a - b_len + c)
                elif vertex == 'F':
                    # (-c*F + a*D + b*E)/(a + b - c)
                    return (-c*np.array(F) + a*np.array(D) + b_len*np.array(E))/(a + b_len - c)
                else:
                    raise ValueError
            
