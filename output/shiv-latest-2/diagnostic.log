                a = np.linalg.norm(E-F) # opposite D
                b = np.linalg.norm(D-F) # opposite E
                c = np.linalg.norm(D-E) # opposite F
                I = (a*D + b*E + c*F)/(a+b+c)  # incenter
                # line direction v perpendicular to OI (O=0)
                v = np.array([-I[1], I[0]])  # rotate 90 deg
                # line DE param: D + u*(E-D)
                # find t where I + t*v = D + u*(E-D)
                # solve 2 equations for t,u
                A = np.column_stack((v, -(E-D)))  # I + t v = D + u (E-D) => t v + u (-(E-D)) = D - I
                rhs = D - I
                try:
                    sol = np.linalg.solve(A, rhs)
                except np.linalg.LinAlgError:
                    return None
                t_M = sol[0]
                # external bisector at F
                # unit vectors along FD and FE
                u1 = (D-F)/np.linalg.norm(D-F)
