            def longest_zero_run(n, max_terms=10000):
                # generate sequence modulo n
                a = [pow(2, k, n) for k in range(n)]  # a[0]=2^0,... a[n-1]=2^{n-1}
                # compute further terms
                # we will store as list of ints modulo n
                # we need to keep last n terms for recurrence
                # we can compute up to max_terms
                # note: a currently length n
                longest = 0
                current = 0
                # check first n terms
                for val in a:
                    if val % n == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                # generate further terms
                for k in range(n, max_terms):
                    next_val = sum(a[-n:]) % n
                    a.append(next_val)
                    if next_val == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                    # optionally break if we see infinite zeros? if we have n zeros, then infinite
                    if current >= n:
                        # reached n consecutive zeros -> infinite
                        return float('inf')
                return longest
            
            # test for small n
            results = {}
            for n in range(2, 21):
                m = longest_zero_run(n, max_terms=5000)
                results[n] = m
            results
            
