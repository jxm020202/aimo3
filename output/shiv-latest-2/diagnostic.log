            def L(n,k):
                # compute lcm of range(k, k+n)
                # using math.lcm (Python 3.9+)
                # but we can compute iteratively
                res = 1
                for i in range(k, k+n):
                    res = math.lcm(res, i)
                return res
            
            def seq(n, K=200):
                return [L(n,k) for k in range(1, K+1)]
            
            def is_eventually_strictly_increasing(n, K=200):
                # check if there exists N such that for all k > N up to K-1, L(k+1)>L(k)
                # We'll check monotonic after some point up to K.
                # Find smallest N such that for all k>=N, L(k+1)>L(k)
                # If not found within K, return False (maybe later)
                vals = seq(n, K+1)
                # find N
                for N in range(1, K):
                    ok = True
                    for k in range(N, K):
                        if vals[k] <= vals[k-1]:
                            ok = False
                            break
                    if ok:
                        return True, N
                return False, None
            
            for n in range(1,11):
                ok,N = is_eventually_strictly_increasing(n, K=200)
                print(n, ok, N)
            
