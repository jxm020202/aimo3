            def contains_integer_point(theta, cx, cy):
                # Check four lattice points (0,0),(1,0),(0,1),(1,1)
                c = math.cos(theta)
                s = math.sin(theta)
                # rotation matrix R_{-theta}
                # For each lattice point (m,n), compute vector (cx - m, cy - n)
                # Compute rotated coordinates (u,v) = R_{-theta} * (dx, dy)
                # Then check max(|u|,|v|) <= 0.5
                for m,n in [(0,0),(1,0),(0,1),(1,1)]:
                    dx = cx - m
                    dy = cy - n
                    u = c*dx + s*dy   # because R_{-theta} = [[c, s], [-s, c]]
                    v = -s*dx + c*dy
                    if max(abs(u), abs(v)) <= 0.5 + 1e-12:
