            def max_zero_run_fast(n, limit=2000000):
                # initial terms a_1..a_n modulo n
                a = [pow(2, k-1, n) for k in range(1, n+1)]
                # sliding sum of last n terms
                cur_sum = sum(a) % n
                max_run = 0
                cur_run = 0
                # check initial terms
                for val in a:
                    if val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # generate further terms
                from collections import deque
                dq = deque(a, maxlen=n)
                for k in range(n+1, limit+1):
                    next_val = cur_sum  # sum of last n terms modulo n
                    # update zero run
                    if next_val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                    # update sliding sum
                    oldest = dq[0]  # leftmost
                    cur_sum = (cur_sum - oldest + next_val) % n
                    # push new term
                    dq.append(next_val)
                return max_run
            
