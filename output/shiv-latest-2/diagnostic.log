            def is_convex(poly):
                # poly list of points in order, closed
                n = len(poly)
                sign = None
                for i in range(n):
                    p0 = np.array(poly[i])
                    p1 = np.array(poly[(i+1)%n])
                    p2 = np.array(poly[(i+2)%n])
                    cross = np.cross(p1-p0, p2-p1)
                    # cross product z-component (2D)
                    if cross != 0:
                        if sign is None:
