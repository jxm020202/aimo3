            def find_uv(limit_den):
                sols = []
                import math
                for b in range(1, limit_den+1):
                    for a in range(0, b):
                        if math.gcd(a,b)!=1:
                            continue
                        u = Fraction(a,b)
                        if not (0 < u < 1):
                            continue
                        # compute discriminant condition
                        expr = 8*(5*u*u - 2*u + 1)
                        # check if expr is a perfect square rational
                        # expr = p/q reduced
                        p = expr.numerator
                        q = expr.denominator
                        sp = int(math.isqrt(p))
                        sq = int(math.isqrt(q))
                        if sp*sp != p or sq*sq != q:
                            continue
                        w = Fraction(sp, sq)
                        # compute v candidates
                        A = 5*u*u - 2*u + 1
                        B = 10*u*u - 4*u + 2
                        # sqrt(D) = (u+1) * w
                        sqrtD = (u + 1) * w
                        v1 = Fraction(-B + sqrtD, 2*A)
                        v2 = Fraction(-B - sqrtD, 2*A)
                        for v in (v1, v2):
                            if not (0 < v < 1):
                                continue
                            # compute x,y
                            x = Fraction(1 - u*u, 2)
                            y = Fraction(1 - v*v, 2)
                            if x <= 0 or y <= 0:
                                continue
                            k = math.lcm(x.denominator, y.denominator)
