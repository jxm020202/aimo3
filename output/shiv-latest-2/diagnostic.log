                v2 = (Y[0]-X[0], Y[1]-X[1])
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(*v1)
                norm2 = math.hypot(*v2)
                angle = math.degrees(math.acos(dot/(norm1*norm2)))
                # compute W = Z + X - Y
