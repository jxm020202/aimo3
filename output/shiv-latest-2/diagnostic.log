            def find_period(n, max_steps=2000000):
                # store state as tuple of length n
                a = [pow(2, k, n) for k in range(n)]
                s = sum(a) % n
                # state is the last n terms (a[-n:])
                state = tuple(a[-n:])
                seen = {state: 0}
                steps = 0
                while True:
                    # compute next term
                    val = s
