            import numpy as np, math, random
            
            def circumcenter(A,B,C):
                # Using formula from coordinates
                # Solve for O: |O-A|^2 = |O-B|^2 and |O-A|^2 = |O-C|^2
                # This gives linear equations: 2*(B-A).dot(O) = |B|^2 - |A|^2 etc.
                A = np.array(A); B = np.array(B); C = np.array(C)
                # Build matrix
                M = np.array([2*(B-A), 2*(C-A)])
                rhs = np.array([np.dot(B,B)-np.dot(A,A), np.dot(C,C)-np.dot(A,A)])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter(A,B,C):
                A = np.array(A); B = np.array(B); C = np.array(C)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C) / (a+b+c)
                return I
            
            def line_intersection(p1, d1, p2, d2):
                # lines: p1 + t*d1, p2 + s*d2
                # solve p1 + t*d1 = p2 + s*d2
                # 2 equations 2 unknowns
                A = np.column_stack((d1, -d2))
                b = p2 - p1
                # solve for t,s
                t_s = np.linalg.lstsq(A, b, rcond=None)[0]
                t = t_s[0]
                # intersection point
                return p1 + t*d1
            
            def ratio_numeric(A,B,C):
                O = circumcenter(A,B,C)
                I = incenter(A,B,C)
                # direction perpendicular to OI
                OI = O - I
                perp = np.array([-OI[1], OI[0]])  # rotate 90 deg
                # line ℓ: I + t*perp
                # side AB line
                AB_dir = np.array(B) - np.array(A)
                M = line_intersection(I, perp, A, AB_dir)
                # external bisector at C
                # unit vectors from C to A and C to B
                CA = np.array(A) - np.array(C)
                CB = np.array(B) - np.array(C)
                CA_len = np.linalg.norm(CA)
                CB_len = np.linalg.norm(CB)
                u_CA = CA / CA_len
                u_CB = CB / CB_len
                ext_dir = u_CA - u_CB
                N = line_intersection(I, perp, C, ext_dir)
                IM = np.linalg.norm(I - M)
                IN = np.linalg.norm(I - N)
                return IM/IN
            
            def test_random(n=10):
                ratios = []
                for _ in range(n):
                    A,B,C = random_triangle()
                    r = ratio_numeric(A,B,C)
                    ratios.append(r)
                return ratios
            
            def random_triangle():
                while True:
                    A = (random.uniform(-5,5), random.uniform(-5,5))
                    B = (random.uniform(-5,5), random.uniform(-5,5))
                    C = (random.uniform(-5,5), random.uniform(-5,5))
                    # area
                    area = abs((B[0]-A[0])*(C[1]-A[1]) - (C[0]-A[0])*(B[1]-A[1]))
                    if area > 1e-3:
                        return A,B,C
            
            ratios = test_random(10)
            ratios
            
