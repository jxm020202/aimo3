            def find_period_scalar(mod, n, max_steps=200000):
                a = [pow(2, i, mod) for i in range(n)]
                seen = {}
                for i, val in enumerate(a):
                    seen[(i, val)] = i  # not helpful
                # Instead track state of last n terms as tuple
                from collections import deque
                dq = deque(a, maxlen=n)
                seen_state = {tuple(dq): 0}
                for step in range(1, max_steps+1):
                    nxt = sum(dq) % mod
                    dq.append(nxt)
                    state = tuple(dq)
                    if state in seen_state:
                        return step - seen_state[state], seen_state[state]
                    seen_state[state] = step
