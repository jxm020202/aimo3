            import sympy as sp
            α,β,γ = sp.symbols('α β γ', real=True)
            # points on unit circle
            D = sp.Matrix([sp.cos(2*α), sp.sin(2*α)])
            E = sp.Matrix([sp.cos(2*β), sp.sin(2*β)])
            F = sp.Matrix([sp.cos(2*γ), sp.sin(2*γ)])
            
            # side lengths (chord lengths)
            a = 2*sp.sin(β-γ)  # opposite D
            b = 2*sp.sin(γ-α)  # opposite E
            c = 2*sp.sin(α-β)  # opposite F
            
            I = (a*D + b*E + c*F) / (a+b+c)  # incenter vector
            # line direction perpendicular to OI (O at origin)
            v = sp.Matrix([-I[1], I[0]])  # rotate 90 deg CCW
            
            # param for line through I: I + t*v
            t = sp.symbols('t', real=True)
            P_line = I + t*v
            
            # line DE param: D + s*(E-D)
            s = sp.symbols('s', real=True)
            DE_line = D + s*(E-D)
            
            # solve for intersection (two equations)
            sol = sp.solve(P_line - DE_line, (t,s), dict=True)
            sol
            
