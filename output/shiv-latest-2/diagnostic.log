            def period_mod_n(n, max_iter=500000):
                a = [pow(2, k, n) for k in range(n)]
                seen = {}
                # store tuple of last n terms as state
                state = tuple(a[-n:])
                seen[state] = n
                for k in range(n, max_iter):
                    next_val = sum(state) % n
                    # shift
                    state = state[1:] + (next_val,)
                    if state in seen:
                        return k+1 - seen[state]  # period length
                return None
            
