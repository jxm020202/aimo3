            import random, math, numpy as np, sympy as sp
            
            def ratio_for_triangle(D,E,F):
                D = sp.Point(D)
                E = sp.Point(E)
                F = sp.Point(F)
                # circumcenter P: intersection of perpendicular bisectors
                # sympy has circumcenter method for Triangle? Use geometry.
                triangle = sp.Triangle(D,E,F)
                P = triangle.circumcenter
                Q = triangle.incenter
                # line PQ
                line_PQ = sp.Line(P,Q)
                # line through Q perpendicular to PQ
                line_perp = line_PQ.perpendicular_line(Q)
                # intersection with DE -> M
                line_DE = sp.Line(D,E)
                M = line_perp.intersection(line_DE)[0]
                # external bisector at F
                # compute unit vectors FD, FE
                FD = sp.Matrix(D - F)
                FE = sp.Matrix(E - F)
                # unit vectors
                uFD = FD / sp.sqrt(FD.dot(FD))
                uFE = FE / sp.sqrt(FE.dot(FE))
                # internal bisector direction = uFD + uFE
                # external bisector direction = uFD - uFE
                dir_ext = uFD - uFE
                # line through F with direction dir_ext
                line_ext = sp.Line(F, F + sp.Point(dir_ext[0], dir_ext[1]))
                N = line_perp.intersection(line_ext)[0]
                # distances
                QM = Q.distance(M)
                QN = Q.distance(N)
                # ratio
                return sp.nsimplify(QM/QN)
            
            def random_triangle():
                # generate non-collinear points
                while True:
                    D = (random.uniform(-5,5), random.uniform(-5,5))
                    E = (random.uniform(-5,5), random.uniform(-5,5))
