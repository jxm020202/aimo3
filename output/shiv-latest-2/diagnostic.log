                for th in thetas:
                    A_vals.append(covered_fraction(th, samples_per_theta))
                # integrate using Simpson or trapezoid
                # p = 1 - (2/pi) * integral A(theta) dtheta
                # approximate integral
                integral = np.trapz(A_vals, thetas)
                p_est = 1 - (2/math.pi)*integral
                return p_est, thetas, A_vals
            
