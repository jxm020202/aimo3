            def compute_angle(u,v,p,q):
                # Points
                W = np.array([0.0,0.0])
                X = np.array([1.0,0.0])
                Y = np.array([u,v])
                Z = np.array([p,q])
                # Intersection M of WY and XZ
                # Solve linear equations using numpy
                # param t for WY: W + t*(Y-W) = t*Y
                # param s for XZ: X + s*(Z-X)
                # Solve for t,s
                A = np.column_stack((Y, -(Z-X)))  # 2x2 matrix: t*Y + s*(-(Z-X)) = X
                # Actually we want t*Y = X + s*(Z-X) => t*Y - s*(Z-X) = X
                # So A @ [t, s] = X
                try:
                    ts = np.linalg.solve(A, X)
                except np.linalg.LinAlgError:
                    return None
                t, s = ts
                M = t*Y
                # N: intersection of perp bisector of WX (x=0.5) and YZ
                # Perp bisector of YZ: line through midpoint Myz = (Y+Z)/2, direction perpendicular to (Z-Y)
                # Solve for intersection with x=0.5
                Myz = (Y+Z)/2.0
                dz = Z - Y
                # direction vector of perp bisector is perpendicular to dz: perp = np.array([-dz[1], dz[0]])
                # param u2: Myz + u2*perp, set x=0.5
                perp = np.array([-dz[1], dz[0]])
                # Solve Myz[0] + u2*perp[0] = 0.5
                if abs(perp[0]) < 1e-12:
                    return None
                u2 = (0.5 - Myz[0]) / perp[0]
                N = Myz + u2*perp
                # O: intersection of perp bisectors of XY and WZ
                # Perp bisector of XY:
                Mxy = (W+Y)/2.0
                dxy = Y - W
                perp_xy = np.array([-dxy[1], dxy[0]])
                # Perp bisector of WZ:
                Mwz = (W+Z)/2.0
                dwz = Z - W
                perp_wz = np.array([-dwz[1], dwz[0]])
                # Solve Mxy + a*perp_xy = Mwz + b*perp_wz
                # 2 equations, 2 unknowns a,b
                A2 = np.column_stack((perp_xy, -perp_wz))
                try:
                    ab = np.linalg.solve(A2, Mwz - Mxy)
                except np.linalg.LinAlgError:
                    return None
                a,b = ab
                O = Mxy + a*perp_xy
                # Compute angle NMO
                v1 = N - M
                v2 = O - M
                # angle between vectors
                dot = np.dot(v1, v2)
                norm1 = np.linalg.norm(v1)
                norm2 = np.linalg.norm(v2)
                if norm1*norm2 == 0:
                    return None
                cosang = dot/(norm1*norm2)
                # clamp
                cosang = max(-1.0, min(1.0, cosang))
                ang = math.degrees(math.acos(cosang))
                return ang
            
            def random_example():
                while True:
