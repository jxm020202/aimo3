            def circumcenter_np(A,B,C):
                A = np.array(A); B = np.array(B); C = np.array(C)
                BA = B - A
                CA = C - A
                rhs1 = np.dot(B,B) - np.dot(A,A)
                rhs2 = np.dot(C,C) - np.dot(A,A)
                M = np.array([2*BA, 2*CA])
                rhs = np.array([rhs1, rhs2])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter_np(A,B,C):
                A = np.array(A); B = np.array(B); C = np.array(C)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C) / (a+b+c)
                return I
            
            def external_bisector_direction_np(D,E,F):
                D = np.array(D); E = np.array(E); F = np.array(F)
                u1 = (D - F) / np.linalg.norm(D - F)
                u2 = (E - F) / np.linalg.norm(E - F)
                w = u1 - u2
                return w
            
            def compute_ratio_np2(D,E,F):
                O = circumcenter_np(D,E,F)
                I = incenter_np(D,E,F)
                OI = O - I
                v = np.array([-OI[1], OI[0]])  # perpendicular
                # Intersection with DE
                D_arr = np.array(D); E_arr = np.array(E)
                w_DE = E_arr - D_arr
                A = np.column_stack((v, -w_DE))
                rhs = D_arr - I
                tM = np.linalg.solve(A, rhs)[0]
                # Intersection with external bisector at F
                w_ext = external_bisector_direction_np(D,E,F)
                A2 = np.column_stack((v, -w_ext))
                rhs2 = np.array(F) - I
                tN = np.linalg.solve(A2, rhs2)[0]
                QM = abs(tM) * np.linalg.norm(v)
                QN = abs(tN) * np.linalg.norm(v)
                return QM/QN
            
            def test_many(n=10):
                ratios = []
                for i in range(n):
