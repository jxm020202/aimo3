            def max_zero_run(n, max_terms=10000):
                # compute sequence modulo n
                a = [pow(2, k, n) for k in range(n)]  # a[0]=a1=2^0=1, a[1]=2^1=2, ..., a[n-1]=2^{n-1}
                # compute further terms up to max_terms
                # we will store as list of ints modulo n
                # a_k for k>=n: sum of previous n terms
                # we have a[0] corresponds to a1
                # compute up to index max_terms-1 (0-index)
                for k in range(n, max_terms):
                    s = sum(a[k-n:k]) % n
                    a.append(s)
                # find longest run of zeros
                max_run = 0
                cur = 0
                for val in a:
                    if val % n == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                return max_run, a[:max_terms]
            
            for n in range(2, 21):
                mr, seq = max_zero_run(n, max_terms=2000)
                print(n, mr)
            
