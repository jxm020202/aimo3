                # position constraints: each position exactly one flavor
                for p in range(m):
                    row = np.zeros(n_vars, dtype=int)
                    for i in range(q):
                        row[p*q + i] = 1
                    A.append(row)
                    b_lb.append(1)
                    b_ub.append(1)
                # window constraints: each flavor appears at least once in each window
                for start in range(m):
                    for i in range(q):
                        row = np.zeros(n_vars, dtype=int)
                        for offset in range(window):
