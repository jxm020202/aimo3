                    ang = direction_angle(p1,p2)
                    # round angle to nearest multiple of pi/6
                    # compute integer multiple
                    mult = round(ang / (math.pi/6))
                    ang_rounded = mult * (math.pi/6)
                    # adjust to be within [0, pi)
                    ang_rounded %= math.pi
                    lines.append((a,b,c, ang_rounded, (i,j)))
            len(lines)
            
