            def max_zero_run_mod_n_recurrence(mod, n=100, max_terms=2000000):
                # recurrence with window size n, but reduce modulo mod
                # initial terms a_k = 2^{k-1} mod mod
                a = [0]*(max_terms+1)
                for k in range(1, n+1):
                    a[k] = pow(2, k-1, mod)
                cur_sum = sum(a[1:n+1]) % mod
                max_run = 0
                cur_len = 0
                # check initial terms
                for k in range(1, n+1):
                    if a[k] == 0:
                        cur_len += 1
                        max_run = max(max_run, cur_len)
                    else:
                        cur_len = 0
                # generate further terms
                for k in range(n+1, max_terms+1):
                    next_val = cur_sum % mod
                    a[k] = next_val
                    if next_val == 0:
                        cur_len += 1
                        max_run = max(max_run, cur_len)
                    else:
                        cur_len = 0
                    # update sum
                    cur_sum = (cur_sum - a[k-n] + next_val) % mod
