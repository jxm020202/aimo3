                # using backtracking
                solutions = []
                # We'll store partial sequences as list
                def backtrack(a):
                    i = len(a)  # next index to assign
                    if i == max_len+1:  # we have indices 0..max_len
                        solutions.append(tuple(a))
                        return
                    # possible values for a_i: 0..max_val
                    for val in range(max_val+1):
                        a.append(val)
                        # check constraints that involve index i (as a_{i} just assigned)
                        ok = True
                        # Check for each p where p+1 == i (i.e., p = i-1) if a_{a_{a_p}} known
                        p = i-1
                        if p >= 0:
                            # need a_{a_{a_p}} known
                            idx1 = a[p]
                            if idx1 <= max_len:
