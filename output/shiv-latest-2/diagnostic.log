            def reflect_point_across_line(P, A, B):
                # reflect point P across line AB
                # formula using projection
                AB = B - A
                AP = P - A
                proj = A + (AP.dot(AB) / AB.dot(AB)) * AB
                return proj*2 - P
            
            def test_reflection(alpha,beta,gamma):
                d = np.array([math.cos(alpha), math.sin(alpha)])
                e = np.array([math.cos(beta), math.sin(beta)])
                f = np.array([math.cos(gamma), math.sin(gamma)])
                a = np.linalg.norm(e-f)
                b = np.linalg.norm(f-d)
                c = np.linalg.norm(d-e)
                I = (a*d + b*e + c*f)/(a+b+c)
                # line L direction
                dirL = np.array([-I[1], I[0]])
                # reflect I across DE
                I_ref = reflect_point_across_line(I, d, e)
                # check if I_ref lies on line L (i.e., vector (I_ref - I) parallel to dirL)
                cross = np.cross(dirL, I_ref - I)  # 2D cross product scalar
                return cross
            
