            def constraints_for_centers_fixed(centers, theta):
                c = math.cos(theta)
                s = math.sin(theta)
                cons = []
                # unit cell bounds
                cons += [(1,0,1), (-1,0,0), (0,1,1), (0,-1,0)]
                for i,j in centers:
                    # a = (x-i)c + (y-j)s
                    # a <= 0.5
                    cons.append((c, s, 0.5 + i*c + j*s))
                    # a >= -0.5 => -a <= 0.5
                    cons.append((-c, -s, 0.5 - i*c - j*s))
                    # b = -(x-i)s + (y-j)c
                    # b <= 0.5 => (-s, c)·(x,y) <= 0.5 - i*s + j*c
                    cons.append((-s, c, 0.5 - i*s + j*c))
                    # b >= -0.5 => -b <= 0.5 => (s, -c)·(x,y) <= 0.5 + i*s - j*c
                    cons.append((s, -c, 0.5 + i*s - j*c))
                return cons
            
