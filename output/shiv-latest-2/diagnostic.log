            import random, math
            def compute_ratio(beta_val, gamma_val):
                # compute points
                D = sp.Matrix([1,0])
                E = sp.Matrix([math.cos(2*beta_val), math.sin(2*beta_val)])
                F = sp.Matrix([math.cos(2*gamma_val), math.sin(2*gamma_val)])
                a = 2*math.sin(gamma_val - beta_val)
                b = 2*math.sin(gamma_val)
                c = 2*math.sin(beta_val)
                Q = (a*D + b*E + c*F) / (a+b+c)
                Qx, Qy = float(Q[0]), float(Q[1])
                # perp direction
                Q_perp = sp.Matrix([-Qy, Qx])
                # line DE param solve for t,u
                # Solve linear equations using numpy
                import numpy as np
                D_np = np.array([1.0,0.0])
                E_np = np.array([math.cos(2*beta_val), math.sin(2*beta_val)])
                F_np = np.array([math.cos(2*gamma_val), math.sin(2*gamma_val)])
                Q_np = np.array([Qx, Qy])
                Q_perp_np = np.array([-Qy, Qx])
                # Solve Q + t*Q_perp = D + u*(E-D)
                A = np.column_stack((Q_perp_np, -(E_np-D_np)))  # t*Q_perp - u*(E-D) = D - Q
                b_vec = D_np - Q_np
                sol = np.linalg.lstsq(A, b_vec, rcond=None)[0]
                tM = sol[0]
                # external bisector at F
                # internal bisector direction = unit(FD) + unit(FE)
                FD = D_np - F_np
                FE = E_np - F_np
                def unit(v):
                    return v/np.linalg.norm(v)
                u_int = unit(FD) + unit(FE)
                # external bisector direction is perpendicular to internal bisector
                v_ext = np.array([-u_int[1], u_int[0]])  # rotate 90 deg
                # Solve Q + t*Q_perp = F + s*v_ext
                A2 = np.column_stack((Q_perp_np, -v_ext))
                b2 = F_np - Q_np
                sol2 = np.linalg.lstsq(A2, b2, rcond=None)[0]
                tN = sol2[0]
                return abs(tM)/abs(tN)
            
            for i in range(10):
                beta_val = random.uniform(0.2, 1.0)
                gamma_val = random.uniform(beta_val+0.1, 1.5)  # ensure gamma>beta
                ratio = compute_ratio(beta_val, gamma_val)
                print(beta_val, gamma_val, ratio)
            
