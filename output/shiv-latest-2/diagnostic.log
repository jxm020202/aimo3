            from fractions import Fraction
            
            def min_sum(n,p):
                base = n*(n+1)//2
                if p <= n:
                    return base - p + (n+1)
                else:
                    return base
            
            def max_sum(n,p):
                base = n*(401 - n)//2  # sum of n largest numbers from 200 downwards
                # largest n numbers are from 200 down to 200-n+1 inclusive
                # smallest among them is 200-n+1
                if p >= 200 - n + 1:
                    # replace p with next lower number not used: 200-n
                    return base - p + (200 - n)
                else:
                    return base
            
            T = 20100
