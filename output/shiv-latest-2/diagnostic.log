            import random, math, numpy as np, sympy as sp
            
            def circumcenter(A,B,C):
                # using sympy for exact? Use numpy for numeric.
                # Compute circumcenter of triangle A,B,C.
                # Solve intersection of perpendicular bisectors.
                # Use formula via linear algebra.
                A = np.array(A); B = np.array(B); C = np.array(C)
                # Midpoints
                D = (A+B)/2
                E = (A+C)/2
                # direction vectors
                AB = B-A
                AC = C-A
                # perpendicular directions
                d1 = np.array([-AB[1], AB[0]])
                d2 = np.array([-AC[1], AC[0]])
                # Solve D + t1*d1 = E + t2*d2
                # [d1, -d2] [t1, t2]^T = E - D
                M = np.column_stack((d1, -d2))
                try:
                    t = np.linalg.solve(M, E-D)
                except np.linalg.LinAlgError:
                    return None
                O = D + t[0]*d1
                return O
            
            def incenter(A,B,C):
                A = np.array(A); B = np.array(B); C = np.array(C)
                # side lengths
                a = np.linalg.norm(B-C) # opposite A
                b = np.linalg.norm(C-A) # opposite B
                c = np.linalg.norm(A-B) # opposite C
                I = (a*A + b*B + c*C) / (a+b+c)
                return I
            
            def unit(v):
                norm = np.linalg.norm(v)
                if norm==0: return v
                return v/norm
            
            def external_bisector_line(C, A, B):
                # returns point C and direction vector v for external bisector at C.
                # internal bisector direction = unit(A-C) + unit(B-C)
                u_CA = unit(A-C)
                u_CB = unit(B-C)
                v = u_CA - u_CB  # external
                # ensure non-zero
                return C, v
            
            def line_intersection(P1, d1, P2, d2):
                # Solve P1 + t*d1 = P2 + s*d2
                # 2 equations 2 unknowns
                M = np.column_stack((d1, -d2))
                try:
                    t_s = np.linalg.solve(M, P2-P1)
                except np.linalg.LinAlgError:
                    return None
                t = t_s[0]
                return P1 + t*d1
            
            def ratio_for_triangle(A,B,C):
                O = circumcenter(A,B,C)
                I = incenter(A,B,C)
                # line L: through I perpendicular to OI
                dir_OI = O - I
                dir_L = np.array([-dir_OI[1], dir_OI[0]])  # rotate 90 deg
                # Intersection with side AB (A,B)
                M = line_intersection(I, dir_L, A, B-A)
                # External bisector at C
                C_pt, dir_ext = external_bisector_line(C, A, B)
                N = line_intersection(I, dir_L, C_pt, dir_ext)
                if M is None or N is None:
                    return None
                QM = np.linalg.norm(M - I)
                QN = np.linalg.norm(N - I)
                return QM/QN
            
            def test_random():
                for i in range(10):
                    # random non-collinear points
                    A = np.random.rand(2)*10
                    B = np.random.rand(2)*10
                    C = np.random.rand(2)*10
                    # ensure not collinear
                    if abs(np.linalg.det(np.column_stack((B-A, C-A))))<1e-6:
                        continue
                    r = ratio_for_triangle(A,B,C)
                    print(r)
            test_random()
            
