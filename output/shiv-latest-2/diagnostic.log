            import random, math, itertools, sys, time, numpy as np
            
            def max_side(x,y,t):
                # coordinates
                # D (sqrt3,0), E (0,1), F (0,0)
                # Q on EF: (0,y)
                # R on FD: (x,0)
                # P on DE: (sqrt3*(1-t), t)
                sqrt3 = math.sqrt(3)
                P = (sqrt3*(1-t), t)
                Q = (0,y)
                R = (x,0)
                d1 = math.hypot(x, y)  # QR
                d2 = math.hypot(x - P[0], -P[1])  # RP
                d3 = math.hypot(P[0], t - y)  # PQ
                return max(d1,d2,d3)
            
