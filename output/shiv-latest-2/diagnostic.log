            def is_convex(L):
                P = sp.Point(0,0)
                Q = sp.Point(2,0)
                R = sp.Point((3+sp.sqrt(3))/2, (1+sp.sqrt(3))/2)
                S = sp.Point(1, sp.sqrt(3))
                T = sp.Point(0, L)
                # list vertices in order
                verts = [P,Q,R,S,T]
                # compute cross product z-component of vectors (vi->vi+1) x (vi+1->vi+2)
                # For convex CCW, all cross products should have same sign (positive)
                signs = []
                n = len(verts)
                for i in range(n):
                    a = verts[i]
                    b = verts[(i+1)%n]
                    c = verts[(i+2)%n]
                    # vector ab = b-a, bc = c-b
                    ab = sp.Matrix([b.x - a.x, b.y - a.y])
                    bc = sp.Matrix([c.x - b.x, c.y - b.y])
                    cross = ab[0]*bc[1] - ab[1]*bc[0]
                    signs.append(sp.simplify(cross))
                return signs
            
            for val in [sp.sqrt(3)+1, sp.sqrt(3)-1]:
                print(val, is_convex(val))
            
