            def solve_lambda_external(D,E,F):
                D = np.array(D,float)
                E = np.array(E,float)
                c = E[0] - D[0]
                x = F[0] - D[0]
                y = F[1] - D[1]
                a = math.hypot(x-c, y)
                b = math.hypot(x, y)
                I = np.array([c*(x + b) / (a+b+c), c*y/(a+b+c)])
                y0 = (x**2 + y**2 - c*x) / (2*y)
                O = np.array([c/2, y0])
                u = O - I
                v = np.array([-u[1], u[0]])
                # outward normals
                n1 = np.array([-y, x])   # for FD
                n2 = np.array([-y, -(c - x)])  # for FE
                I_minus_F = I - np.array([x,y])
                # condition: a*(I+lam*v - F)·n1 + b*(I+lam*v - F)·n2 = 0
                # => a*(I-F)·n1 + b*(I-F)·n2 + lam*(a*v·n1 + b*v·n2) = 0
                num = a * np.dot(I_minus_F, n1) + b * np.dot(I_minus_F, n2)
                den = a * np.dot(v, n1) + b * np.dot(v, n2)
                lam = - num / den
                # t1
                t1 = - I[1] / u[0]
                return lam, t1
            
