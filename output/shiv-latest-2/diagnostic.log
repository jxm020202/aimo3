            def find_skolem(n):
                # backtrack search for Skolem sequence: positions 1..2n
                # store array pos[1..2n] = assigned number or 0
                pos = [0]*(2*n+1)  # 1-indexed
                # numbers to place: each k appears twice, distance k apart
                # we will place numbers from n down to 1 for pruning
                def backtrack(k):
                    if k == 0:
                        return True
                    # try to place k in positions i and i+k
                    for i in range(1, 2*n - k + 1):
                        if pos[i]==0 and pos[i+k]==0:
                            pos[i]=pos[i+k]=k
                            if backtrack(k-1):
                                return True
                            pos[i]=pos[i+k]=0
                    return False
                if backtrack(n):
                    return pos[1:]
                else:
                    return None
            
            for n in range(1,13):
                seq = find_skolem(n)
                print(n, seq is not None)
            
