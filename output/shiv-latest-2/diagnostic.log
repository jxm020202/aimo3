            def find_parity(s, t, max_k=5000, max_param=500):
                p,q = s.numerator, s.denominator
                u,v = t.numerator, t.denominator
                # extended Euclid to find particular solution for p a + q b = u k
                # We'll loop over k
                for k in range(-max_k, max_k+1):
                    # Solve p a + q b = u k
                    # Use extended Euclid to get one solution (a0,b0) for RHS = u*k
                    # Since gcd(p,q)=1, we can find x0,y0 such that p*x0 + q*y0 = 1
                    # Then multiply by u*k
                    # Compute using pow with mod? Let's compute using extended Euclid.
                    # Use sympy? We'll implement simple extended Euclid.
                    def egcd(a,b):
                        if b==0:
                            return (1,0,a)
                        else:
                            x,y,g = egcd(b, a%b)
                            return (y, x - (a//b)*y, g)
                    x0,y0,g = egcd(p,q)
                    # g should be 1
                    a0 = x0 * u * k
                    b0 = y0 * u * k
                    # General solution: a = a0 + q*t, b = b0 - p*t
                    # Similarly solve q d + p c = v k
                    x1,y1,g1 = egcd(q,p)  # solves q*x1 + p*y1 = 1
                    d0 = x1 * v * k
                    c0 = y1 * v * k
                    # General: d = d0 + p*s, c = c0 - q*s
                    # Now iterate over t,s within bounds
                    for t_param in range(-max_param, max_param+1):
                        a = a0 + q*t_param
                        b = b0 - p*t_param
                        for s_param in range(-max_param, max_param+1):
                            d = d0 + p*s_param
                            c = c0 - q*s_param
                            det = a*d - b*c
                            if det == 1:
                                return 0  # even parity
                            if det == -1:
