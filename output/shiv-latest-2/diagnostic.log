            def longest_zero_run_mod_factor(n, mod_factor, max_steps=5000000):
                # n is the order of recurrence (original n)
                # compute sequence modulo mod_factor using recurrence sum of previous n terms
                # initial terms a_k = 2^{k-1} mod mod_factor for k=1..n
                b = [pow(2, k-1, mod_factor) for k in range(1, n+1)]
                window_sum = sum(b) % mod_factor
                longest = 0
                current = 0
                for i, val in enumerate(b, start=1):
                    if val % mod_factor == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                for step in range(n+1, max_steps+1):
                    next_val = window_sum % mod_factor
                    if next_val == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                    # update sliding window
                    removed = b.pop(0)
                    b.append(next_val)
                    window_sum = (window_sum - removed + next_val) % mod_factor
                return longest
            
