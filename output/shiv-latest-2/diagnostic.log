                u2_norm = u2 / np.linalg.norm(u2)
                ext_dir = u1_norm - u2_norm
                # Intersection with line L
                A3 = np.column_stack((v, -ext_dir))
                rhs2 = F - I
                tN, sN = np.linalg.solve(A3, rhs2)
                N = I + tN * v
                return I, M, N, O
            
