            import math, itertools, numpy as np
            from scipy.spatial import ConvexHull
            
            def feasible_polygon_area(constraints, eps=1e-9):
                # constraints: list of (a,b,c) meaning a*x + b*y <= c
                points = []
                n = len(constraints)
                for i in range(n):
                    a1,b1,c1 = constraints[i]
                    for j in range(i+1, n):
                        a2,b2,c2 = constraints[j]
                        det = a1*b2 - a2*b1
                        if abs(det) < 1e-12:
                            continue
                        # Solve linear equations a1*x + b1*y = c1, a2*x + b2*y = c2
                        x = (c1*b2 - c2*b1)/det
                        y = (a1*c2 - a2*c1)/det
                        # Check constraints
                        ok = True
                        for a,b,c in constraints:
                            if a*x + b*y > c + eps:
                                ok = False
                                break
                        if ok:
                            points.append((x,y))
                # Also consider corners of unit cell maybe? But they are already included via constraints x>=0, x<=1 etc.
                # If no points, area zero
                if not points:
                    return 0.0
                # Remove duplicates
                pts = np.unique(np.array(points), axis=0)
                if len(pts) < 3:
                    return 0.0
                hull = ConvexHull(pts)
                return hull.volume  # area for 2D
            
            def constraints_for_centers(centers, theta):
                c = math.cos(theta)
                s = math.sin(theta)
                cons = []
                # bounds for unit cell
                cons += [(1,0,1)]   # x <= 1
                cons += [(-1,0,0)]  # -x <= 0  => x >= 0
                cons += [(0,1,1)]   # y <= 1
                cons += [(0,-1,0)]  # -y <= 0 => y >=0
                for i,j in centers:
                    # (x-i) c + (y-j) s <= 0.5
                    cons.append((c, s, 0.5 + i*c + j*s))
                    # -(x-i) c - (y-j) s <= 0.5  => -c*x - s*y <= 0.5 - i*c - j*s
                    cons.append((-c, -s, 0.5 - i*c - j*s))
                    # -(x-i) s + (y-j) c <= 0.5
                    cons.append((-s, c, 0.5 + i*s - j*c))
                    # (x-i) s - (y-j) c <= 0.5  (from >= -0.5)
                    cons.append((s, -c, 0.5 - i*s + j*c))
                return cons
            
            def area_I_h(theta):
                # horizontal pair (0,0) and (1,0)
                return feasible_polygon_area(constraints_for_centers([(0,0),(1,0)], theta))
            
            def area_I_d(theta):
                return feasible_polygon_area(constraints_for_centers([(0,0),(1,1)], theta))
            
            def area_I_l(theta):
                return feasible_polygon_area(constraints_for_centers([(0,0),(1,0),(0,1)], theta))
            
            def area_I_q(theta):
                return feasible_polygon_area(constraints_for_centers([(0,0),(1,0),(0,1),(1,1)], theta))
            
            def p_theta(theta):
                Ih = area_I_h(theta)
                Id = area_I_d(theta)
                Il = area_I_l(theta)
                Iq = area_I_q(theta)
                return 4*Ih + 2*Id - 4*Il + Iq
            
            # test at some angles
