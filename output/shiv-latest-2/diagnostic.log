            O1 = sp.Point(sp.Rational(1,2), u)
            
            # circumcenter O2 of PRS: intersection of perpendicular bisectors
            # line1: through midpoint of PR, direction perpendicular to PR
            M1 = sp.Point(xR/2, yR/2)
            dir1 = sp.Matrix([-yR, xR])  # direction vector
            # line2: through midpoint of PS, direction perpendicular to PS
            M2 = sp.Point(xS/2, yS/2)
            dir2 = sp.Matrix([-yS, xS])
            
            # Solve for intersection O2 = M1 + t1*dir1 = M2 + t2*dir2
