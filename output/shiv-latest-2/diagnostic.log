            def exhaustive_grid(step=0.05):
                min_val = 1e9
                min_pt = None
                # sample a,b in range [-sqrt(3), sqrt(3)]
                import numpy as np, math
                R = math.sqrt(3)
                xs = np.arange(-R, R+step, step)
                for a in xs:
                    for b in xs:
                        # compute c^2 = 3 - a^2 - b^2, must be >=0
                        c2 = 3 - a*a - b*b
                        if c2 < -1e-9:
                            continue
                        c = math.sqrt(c2) if c2 >= 0 else 0
                        # consider both signs of c
                        for sign in [1,-1]:
                            cc = sign*c
                            val = P_val(a,b,cc)
                            if val < min_val:
