            import math, random, sys, itertools, time, numpy as np
            
            def rotate_point(px, py, theta):
                c = math.cos(theta)
                s = math.sin(theta)
                return (c*px - s*py, s*px + c*py)
            
            def square_vertices(theta, dx=0.0, dy=0.0):
                # vertices of unit square centered at origin, side length 1, rotated by theta, then translated
                verts = []
                for sx, sy in [(-0.5,-0.5), (0.5,-0.5), (0.5,0.5), (-0.5,0.5)]:
                    x, y = rotate_point(sx, sy, theta)
                    verts.append((x+dx, y+dy))
                return verts
            
            def polygon_area(poly):
                # poly list of (x,y) in order (closed not needed)
                area = 0.0
                n = len(poly)
                for i in range(n):
                    x1,y1 = poly[i]
                    x2,y2 = poly[(i+1)%n]
                    area += x1*y2 - x2*y1
                return abs(area)/2.0
            
            def is_left(p0, p1, p2):
                # return True if p2 is on left side of edge p0->p1 (i.e., cross product >=0)
                # compute cross product (p1-p0) x (p2-p0)
                return ((p1[0]-p0[0])*(p2[1]-p0[1]) - (p1[1]-p0[1])*(p2[0]-p0[0])) >= -1e-12
            
            def line_intersection(p1, p2, p3, p4):
                # intersection point of lines p1-p2 and p3-p4 (assuming they are not parallel)
                # using parametric form
                x1,y1 = p1
                x2,y2 = p2
                x3,y3 = p3
                x4,y4 = p4
                # solve for intersection
                denom = (x1-x2)*(y3-y4) - (y1-y2)*(x3-x4)
                if abs(denom) < 1e-12:
                    return None
                px = ((x1*y2 - y1*x2)*(x3 - x4) - (x1 - x2)*(x3*y4 - y3*x4)) / denom
                py = ((x1*y2 - y1*x2)*(y3 - y4) - (y1 - y2)*(x3*y4 - y3*x4)) / denom
                return (px, py)
            
            def polygon_clip(subjectPolygon, clipEdgeStart, clipEdgeEnd):
                # clip subject polygon with half-plane defined by edge from clipEdgeStart to clipEdgeEnd (keep left side)
                outputList = []
                n = len(subjectPolygon)
                for i in range(n):
                    current_point = subjectPolygon[i]
                    prev_point = subjectPolygon[i-1]
                    cur_inside = is_left(clipEdgeStart, clipEdgeEnd, current_point)
                    prev_inside = is_left(clipEdgeStart, clipEdgeEnd, prev_point)
                    if cur_inside:
                        if not prev_inside:
                            # entering, add intersection
                            inter = line_intersection(prev_point, current_point, clipEdgeStart, clipEdgeEnd)
                            if inter:
                                outputList.append(inter)
                        outputList.append(current_point)
                    elif prev_inside:
                        # exiting, add intersection
                        inter = line_intersection(prev_point, current_point, clipEdgeStart, clipEdgeEnd)
                        if inter:
                            outputList.append(inter)
                return outputList
            
            def polygon_intersection(poly1, poly2):
                # use Sutherland-Hodgman: clip poly1 against each edge of poly2
                output = poly1[:]
                n2 = len(poly2)
                for i in range(n2):
                    a = poly2[i]
                    b = poly2[(i+1)%n2]
                    output = polygon_clip(output, a, b)
                    if not output:
                        return []  # empty
                return output
            
            def O_x(theta):
                poly = square_vertices(theta)
                poly_shift = square_vertices(theta, dx=1.0, dy=0.0)
                inter = polygon_intersection(poly, poly_shift)
                return polygon_area(inter)
            
            def O_xy(theta):
                poly = square_vertices(theta)
                poly_shift_x = square_vertices(theta, dx=1.0, dy=0.0)
                poly_shift_y = square_vertices(theta, dx=0.0, dy=1.0)
                inter1 = polygon_intersection(poly, poly_shift_x)
                inter2 = polygon_intersection(inter1, poly_shift_y)
                return polygon_area(inter2)
            
            def area_S(theta):
                # compute area of image (probability of covering) = 1 - 4*O_x + 4*O_xy
                ox = O_x(theta)
                oxy = O_xy(theta)
                return 1 - 4*ox + 4*oxy
            
            # test for some angles
            for th in [0.0, math.pi/12, math.pi/6, math.pi/4]:
                print(th, O_x(th), O_xy(th), area_S(th))
            
