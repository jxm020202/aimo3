            def construct(sign_q, sign_r):
                theta_q = sign_q * sp.pi*105/180
                QR_dir = sp.sqrt(2) * sp.Matrix([sp.cos(theta_q), sp.sin(theta_q)])
                R = sp.Point(2,0) + sp.Point(QR_dir[0], QR_dir[1])
                # rotate QR_dir by sign_r*90° (CCW if sign_r=+1)
                if sign_r == 1:
                    RS_dir = sp.Matrix([-QR_dir[1], QR_dir[0]])  # CCW 90
                else:
                    RS_dir = sp.Matrix([QR_dir[1], -QR_dir[0]])  # CW 90
                S = R + sp.Point(RS_dir[0], RS_dir[1])
                # compute cos_phi from S.x + sqrt2*cos_phi = 0
                cos_phi = -S.x / sp.sqrt(2)
                # choose sin_phi positive (to get T above S?) We'll compute both
                sin_phi_pos = sp.sqrt(1 - cos_phi**2)
                sin_phi_neg = -sp.sqrt(1 - cos_phi**2)
                ST_vec_pos = sp.sqrt(2) * sp.Matrix([cos_phi, sin_phi_pos])
                ST_vec_neg = sp.sqrt(2) * sp.Matrix([cos_phi, sin_phi_neg])
                T_pos = S + sp.Point(ST_vec_pos[0], ST_vec_pos[1])
                T_neg = S + sp.Point(ST_vec_neg[0], ST_vec_neg[1])
                return {
                    'P': sp.Point(0,0),
                    'Q': sp.Point(2,0),
                    'R': R,
                    'S': S,
                    'T_pos': T_pos,
                    'T_neg': T_neg,
