            def compute_A_grid_fast(theta, N=400):
                # Use vectorized with broadcasting for speed
                xs = (np.arange(N) + 0.5) / N
                ys = (np.arange(N) + 0.5) / N
                xv, yv = np.meshgrid(xs, ys, indexing='xy')
                xv = xv.ravel()
                yv = yv.ravel()
                c = math.cos(theta)
                s = math.sin(theta)
                # compute rotated coordinates for each of four points
                # Using broadcasting: shape (4, M)
                dx = np.stack([xv, xv-1, xv, xv-1])
                dy = np.stack([yv, yv, yv-1, yv-1])
                dxp = c*dx + s*dy
                dyp = -s*dx + c*dy
                inside = (np.abs(dxp) <= 0.5) & (np.abs(dyp) <= 0.5)
