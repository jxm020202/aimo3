            def is_rational_square(frac):
                # frac is Fraction
                # reduce fraction
                n = frac.numerator
                d = frac.denominator
                # need both n and d perfect squares (allow sign)
                if n < 0:
                    return False
                sq_n = int(math.isqrt(n))
                sq_d = int(math.isqrt(d))
                return sq_n*sq_n == n and sq_d*sq_d == d
            
            def rational_sqrt(frac):
                # return sqrt as Fraction if perfect square, else None
