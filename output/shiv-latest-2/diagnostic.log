            def f_val(k, r):
                # compute optimal theta for given r (including boundary)
                # solve quadratic 2 r s^2 + k (1 - r) s - r = 0 for s in [0,1]
                if r == 0:
                    return 0.0
                a = 2*r
                b = k*(1 - r)
                c = -r
                D = b*b - 4*a*c
                s = (-b + math.sqrt(D)) / (2*a)  # positive root
                if s < 0 or s > 1:
                    # maybe boundary at s=0 or s=1
                    # compute both
                    s_candidates = [0.0, 1.0]
                else:
                    s_candidates = [s]
                best = 0.0
                for s in s_candidates:
                    ctheta = math.sqrt(max(0.0, 1 - s*s))
                    val = 4 * (r*ctheta * (r*s + k*(1 - r)))  # as derived
                    if val > best:
                        best = val
                return best
            
            def max_f_k(k, steps=20001):
                best = 0.0
                best_r = None
                for r in np.linspace(0,1,steps):
                    val = f_val(k, r)
                    if val > best:
                        best = val
                        best_r = r
                return best, best_r
            
