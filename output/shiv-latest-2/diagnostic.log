            import random, math, cmath, itertools, sys, numpy as np, sympy as sp
            def circumcenter(A,B,C):
                # using sympy for exact? We'll use numpy float
                # formula: intersection of perpendicular bisectors
                # Using linear algebra
                A = np.array(A,float)
                B = np.array(B,float)
                C = np.array(C,float)
                # Solve for center O: (O-A).(B-A) = (|B|^2 - |A|^2)/2 etc.
                # Use matrix method: Solve (B-A)·O = (|B|^2 - |A|^2)/2, (C-A)·O = (|C|^2 - |A|^2)/2
                BA = B - A
                CA = C - A
                M = np.vstack([BA, CA])
                rhs = np.array([(np.dot(B,B)-np.dot(A,A))/2.0, (np.dot(C,C)-np.dot(A,A))/2.0])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter(A,B,C):
                # sides lengths
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                P = a+b+c
                I = (a*A + b*B + c*C)/P
                return I
            
            def external_angle_bisector(F, D, E):
                # external bisector at vertex F: direction vector is sum of unit vectors along sides FD and FE but one of them reversed? internal bisector direction = unit(FD) + unit(FE). External bisector direction = unit(FD) - unit(FE) (or opposite)
                # Actually external angle bisector is line that bisects the angle formed by extensions of sides beyond F. Equivalent direction vector = unit(FD) - unit(FE) (or -unit(FD)+unit(FE)). Both give same line (opposite direction).
                u1 = (D - F) / np.linalg.norm(D - F)  # direction from F to D
                u2 = (E - F) / np.linalg.norm(E - F)  # direction from F to E
                # internal bisector direction = u1 + u2
                # external bisector direction = u1 - u2 (or -u1 + u2)
                dir_vec = u1 - u2
                # line passes through F with direction dir_vec
                return F, dir_vec
            
            def line_intersection(P1, d1, P2, d2):
                # Solve P1 + t*d1 = P2 + s*d2
                # 2D vectors
                A = np.column_stack((d1, -d2))
                b = P2 - P1
                # Solve for t,s
                try:
                    sol = np.linalg.lstsq(A, b, rcond=None)[0]
                except Exception as e:
                    return None
                t = sol[0]
                # intersection point
                return P1 + t*d1
            
            def ratio_for_triangle(D,E,F):
                O = circumcenter(D,E,F)
                I = incenter(D,E,F)
                # line through I perpendicular to OI
                dir_perp = np.array([-(O[1]-I[1]), O[0]-I[0]])  # rotate 90 deg
                # Intersection with DE
                M = line_intersection(I, dir_perp, np.array(D), np.array(E)-np.array(D))
                # external bisector at F
                Fpt, dir_ext = external_angle_bisector(np.array(F), np.array(D), np.array(E))
                N = line_intersection(I, dir_perp, Fpt, dir_ext)
                if M is None or N is None:
                    return None
                QM = np.linalg.norm(M - I)
                QN = np.linalg.norm(N - I)
                return QM/QN
            
            def random_triangle():
                # generate random non-collinear points
                while True:
                    D = np.random.rand(2)*10
                    E = np.random.rand(2)*10
                    F = np.random.rand(2)*10
                    # check area not too small
                    area = 0.5*abs(np.cross(E-D, F-D))
                    if area>1e-2:
                        return D,E,F
            
            ratios = []
            for _ in range(200):
                D,E,F = random_triangle()
                r = ratio_for_triangle(D,E,F)
                ratios.append(r)
            ratios[:10], np.mean(ratios), np.std(ratios)
            
