            import math
            
            def compute_W(s_val, u_val):
                X = sp.Point(2, 0)
                Z = sp.Point((s_val-1)/2, math.sqrt(3)*(s_val-1)/2)
                Y = sp.Point(s_val*(1 - u_val/2), u_val*math.sqrt(3)*s_val/2)
                W = sp.Point(Z.x + (X.x - Y.x), Z.y + (X.y - Y.y))
                return W
            
            def inside_triangle(P, s_val):
                # barycentric method: point inside if same orientation for all edges
                D = sp.Point(0,0)
                E = sp.Point(s_val,0)
                F = sp.Point(s_val/2, math.sqrt(3)*s_val/2)
                # compute signed areas (cross product) for edges (D->E, E->F, F->D)
                def cross(A,B,C):
                    # cross product of AB x AC (z-component)
                    return (B.x - A.x)*(C.y - A.y) - (B.y - A.y)*(C.x - A.x)
                # orientation of triangle (should be positive)
                orient = cross(D,E,F)
                # compute signs for point P
                s1 = cross(D,E,P)
                s2 = cross(E,F,P)
                s3 = cross(F,D,P)
                # point inside if s1,s2,s3 have same sign as orient (including zero)
                return (s1*orient >= 0) and (s2*orient >= 0) and (s3*orient >= 0)
            
            for s_val in [2,3,4,5]:
                u1 = (s_val-2)/s_val
                u2 = (s_val+1)/(2*s_val)
