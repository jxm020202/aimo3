            def brute_grid(N=401):
                best = 1e9
                best_params = None
                for i in range(N+1):
                    t = i / N
                    if t==0 or t==1:
                        continue
                    for j in range(N+1):
                        b = j / N
                        if b==0 or b==1:
                            continue
                        for k in range(N+1):
                            c = k * math.sqrt(3) / N
                            if c==0 or c==math.sqrt(3):
                                continue
                            # compute distances
                            AB = math.hypot(t-b, math.sqrt(3)*(1-t))
                            BC = math.hypot(b, c)
                            CA = math.hypot(t, math.sqrt(3)*(1-t)-c)
                            L = max(AB, BC, CA)
                            if L < best:
                                best = L
                                best_params = (t,b,c,AB,BC,CA)
                return best, best_params
            
            best_val, best_params = brute_grid(200)  # 200 steps each dimension ~ 8 million loops maybe heavy
            print(best_val)
            
