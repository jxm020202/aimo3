                A2 = np.column_stack((dir_F, -dir_L))
                bvec2 = I - f
                sol2 = np.linalg.lstsq(A2, bvec2, rcond=None)[0]
                u, t2 = sol2
                N = f + u*dir_F
                QN = np.linalg.norm(N - I)
                return QM/QN
            
