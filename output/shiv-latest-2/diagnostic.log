            import random, math, numpy as np
            
            def circumcenter(A,B,C):
                # using formula based on perpendicular bisectors
                # convert to numpy arrays
                A = np.array(A, dtype=float)
                B = np.array(B, dtype=float)
                C = np.array(C, dtype=float)
                # compute midpoints and direction vectors
                # using linear algebra solving for center O such that |O-A|^2 = |O-B|^2 = |O-C|^2
                # Solve (O-A).(A-B)= (|A|^2 - |B|^2)/2? Actually we can solve linear system:
                # (B-A).O = (|B|^2 - |A|^2)/2
                # (C-A).O = (|C|^2 - |A|^2)/2
                # That's derived from equal distances.
                BA = B - A
                CA = C - A
                # Build matrix
                M = np.vstack([BA, CA])
                rhs = np.array([(np.dot(B,B)-np.dot(A,A))/2.0,
                                (np.dot(C,C)-np.dot(A,A))/2.0])
                # Solve
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter(A,B,C):
                # using angle bisector intersection: weighted by side lengths
                # coordinates: (a*A + b*B + c*C)/(a+b+c) where a=|BC|, b=|CA|, c=|AB|
                A = np.array(A, dtype=float)
                B = np.array(B, dtype=float)
                C = np.array(C, dtype=float)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C)/(a+b+c)
                return I
            
            def external_bisector_at_F(A,B,F):
                # external bisector of angle at F formed by lines FD and FE.
                # direction vector is sum of unit vectors along FD and FE but external: difference?
                # For internal bisector, direction is unit vectors along FD and FE sum.
                # For external bisector, direction is difference of unit vectors (one reversed) i.e., unit(FD) - unit(FE) (or opposite)
                # Actually external bisector is perpendicular to internal bisector? Not exactly.
                # The external bisector is the line that bisects the angle between extensions of FD and FE on opposite sides.
                # Equivalent direction vector = u1 - u2 where u1 is unit vector along FD, u2 is unit vector along FE.
                # But we need a line passing through F.
                FD = np.array(A) - np.array(F)  # vector from F to D
                FE = np.array(B) - np.array(F)  # vector from F to E
                uFD = FD/np.linalg.norm(FD)
                uFE = FE/np.linalg.norm(FE)
                # internal bisector direction = uFD + uFE
                # external bisector direction = uFD - uFE (or opposite)
                dir_ext = uFD - uFE
                # Ensure not zero vector
                if np.linalg.norm(dir_ext) < 1e-9:
                    dir_ext = uFD + uFE  # fallback
                return dir_ext
            
            def line_intersection(P1, d1, P2, d2):
                # lines: P1 + t*d1, P2 + s*d2
                # solve for t,s where they intersect (assuming not parallel)
                # solve P1 + t*d1 = P2 + s*d2 => t*d1 - s*d2 = P2 - P1
                A = np.column_stack((d1, -d2))
                b = np.array(P2) - np.array(P1)
                # solve for t,s
                ts = np.linalg.lstsq(A, b, rcond=None)[0]
                t = ts[0]
                # intersection point
                X = P1 + t*d1
                return X, t
            
            def compute_ratio(A,B,C):
                # rename D,E,F as A,B,C? Actually triangle D,E,F.
                D, E, F = A, B, C
                P = circumcenter(D,E,F)
                Q = incenter(D,E,F)
                # line PQ direction
                dir_PQ = P - Q
                # perpendicular direction (rotate 90 deg)
                # In plane, perpendicular vector can be ( -dy, dx )
                perp_dir = np.array([-dir_PQ[1], dir_PQ[0]])
                # line through Q with direction perp_dir
                # intersect with DE line
                # DE line direction
                dir_DE = np.array(E) - np.array(D)
                M, tM = line_intersection(Q, perp_dir, D, dir_DE)
                # external bisector at F
                dir_ext = external_bisector_at_F(D,E,F)
                N, tN = line_intersection(Q, perp_dir, F, dir_ext)
                # distances
                QM = np.linalg.norm(M - Q)
                QN = np.linalg.norm(N - Q)
                return QM/QN
            
            def test_random():
                for i in range(10):
                    # random triangle
                    D = (random.random()*10, random.random()*10)
                    E = (random.random()*10, random.random()*10)
                    F = (random.random()*10, random.random()*10)
                    # ensure non-collinear
                    area = abs((E[0]-D[0])*(F[1]-D[1]) - (E[1]-D[1])*(F[0]-D[0]))
                    if area < 1e-3:
                        continue
                    ratio = compute_ratio(D,E,F)
                    print(ratio)
            test_random()
            
