                    # We'll use the earlier 'covered' function that checks existence of lattice point via search.
                    # Use vectorized approach for many points.
                    pts = np.random.rand(N_point, 2)  # points in torus
                    # rotate points by -theta
                    c, s = math.cos(theta), math.sin(theta)
                    x_prime = c * pts[:,0] + s * pts[:,1]
                    y_prime = -s * pts[:,0] + c * pts[:,1]
                    # For each point, need to check if there exists (i,j) integer such that max(|x' - (i*c - j*s)|, |y' - (i*s + j*c)|) <= 0.5
                    # We'll search over i,j near estimates.
                    # Compute i_est, j_est as earlier
                    i_est = c * x_prime + s * y_prime
                    j_est = -s * x_prime + c * y_prime
                    i0 = np.rint(i_est).astype(int)
                    j0 = np.rint(j_est).astype(int)
                    covered = np.zeros(N_point, dtype=bool)
                    for di in (-1,0,1):
                        for dj in (-1,0,1):
                            i = i0 + di
                            j = j0 + dj
                            lx = i * c - j * s
                            ly = i * s + j * c
                            # compute Chebyshev distance
