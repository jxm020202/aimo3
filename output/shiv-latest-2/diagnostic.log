            def count_adjacent_pairs(n=18):
                positions = [(i,j) for i in range(n) for j in range(n)]
                adj = 0
                for idx in range(len(positions)):
                    x1,y1 = positions[idx]
                    for jdx in range(idx+1, len(positions)):
