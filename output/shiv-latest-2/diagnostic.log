            import math
            
            def original_eq(x, y):
                # compute LHS and RHS
                lhs = 1 + math.sqrt(1 - 2*float(y))
                # compute cube root sum (should be 1)
                term = (1 + x**2)/2 + (1/6)*math.sqrt(9*x**4 + (4/3)*x**6 + 9 + 18*x**2)
                term2 = (1 + x**2)/2 - (1/6)*math.sqrt(9*x**4 + (4/3)*x**6 + 9 + 18*x**2)
                # real cube root
                def rcbrt(z):
                    return math.copysign(abs(z)**(1/3), z)
                cube_sum = rcbrt(term) + rcbrt(term2)
                # compute fraction term
                frac = (4*x - 2 + 2*math.sqrt(1 - 2*x)) / (3 - 5*x - math.sqrt(1 - 2*x))
                rhs = y + frac + cube_sum
                return lhs, rhs
            
