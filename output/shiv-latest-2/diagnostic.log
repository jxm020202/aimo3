            from fractions import Fraction
            
            def ratio(xs):
                S = sum(xs)
                # compute T
                T = 0
                n = len(xs)
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    g_ab = math.gcd(a,b)
                    g_bc = math.gcd(b,c)
                    l_bc = b*c // g_bc
                    T += g_ab * l_bc
                g_all = xs[0]
                for v in xs[1:]:
                    g_all = math.gcd(g_all, v)
                # ratio = S^3 / (g_all * T)
                return Fraction(S**3, g_all * T)
            
            def min_ratio(limit):
                minR = None
                min_tuple = None
