                ang2 = ang + [a+360 for a in ang]
                # precompute for each start index s the count c_s
                # We'll compute using two-pointer sliding window
                c = [0]*n
                j = 0
                for i in range(n):
                    start = ang[i]
                    end = start + 160.0
                    while j < i+n and ang2[j] <= end + 1e-9:
                        j += 1
                    c[i] = j - i  # number of points in [i, j)
                # For each point i (original index in sorted list), compute min c over intervals covering it
                # For point at sorted index i, intervals covering it are those with start index s such that s <= i <= s + c[s]-1 (i.e., i in window)
                # We'll compute min_c[i] by scanning possible s.
                min_c = [n]*n
                # For each start s, its interval covers indices s..s+c[s]-1
                for s in range(n):
                    cnt = c[s]
                    for idx in range(s, s+cnt):
                        # map idx modulo n to original point index
                        i_mod = idx % n
                        if cnt < min_c[i_mod]:
