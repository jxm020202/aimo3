            def find_labeling(M, num_labels=2):
                # brute force over all assignments of M residues to labels 0..num_labels-1
                # For M=32 and 2 labels, 2^32 possibilities too many.
                # Use SAT/backtracking search.
                from itertools import product
                
                # We'll use simple backtracking with pruning.
                labels = [None]*M
                
                # Precompute all (a,r) pairs
                pairs = [(a,r) for a in range(M) for r in range(M)]
                
                # We'll assign residues sequentially and check constraints that involve only assigned residues.
                # For each pair (a,r), the condition involves indices:
                # c = (2a + r) % M
                # b = (a + r) % M
                # a0 = a
                # Condition: label[c] must equal label[b] or label[a0].
                # If any of these three are assigned, we can enforce constraints.
                
                # Use recursion
                sys.setrecursionlimit(10000)
                
                def backtrack(idx):
                    if idx == M:
                        # all assigned, verify all constraints
                        for a,r in pairs:
                            c = (2*a + r) % M
                            b = (a + r) % M
                            if not (labels[c] == labels[b] or labels[c] == labels[a]):
                                return None
                        return labels.copy()
                    # try each label
                    for val in range(num_labels):
                        labels[idx] = val
                        # early pruning: check constraints where all involved indices <= idx (i.e., assigned)
                        ok = True
                        for a,r in pairs:
                            c = (2*a + r) % M
                            b = (a + r) % M
                            # if any of c,b,a is idx (just assigned) and others are assigned (i.e., not None)
                            # we can check constraint if all three are assigned
                            if labels[c] is not None and labels[b] is not None and labels[a] is not None:
                                if not (labels[c] == labels[b] or labels[c] == labels[a]):
                                    ok = False
                                    break
                        if ok:
                            res = backtrack(idx+1)
                            if res is not None:
                                return res
                    labels[idx] = None
                    return None
                
                return backtrack(0)
            
            print("search M=8")
            print(find_labeling(8,2))
            
