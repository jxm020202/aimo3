                # Convert to Cartesian using coordinates.
                Dp = np.array(D,float)
                Ep = np.array(E,float)
                Fp = np.array(F,float)
                a = np.linalg.norm(Ep-Fp) # side opposite D
                b = np.linalg.norm(Fp-Dp) # side opposite E
                c = np.linalg.norm(Dp-Ep) # side opposite F
                # barycentric coordinates (-a, b, c)
                # Convert: X = (α*D + β*E + γ*F)/(α+β+γ)
                α = -a
                β = b
                γ = c
                X = (α*Dp + β*Ep + γ*Fp) / (α+β+γ)
                return I, X
            
