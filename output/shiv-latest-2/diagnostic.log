            def compute_all_radii(r):
                # r: list of 4 inner radii
                b = [1/ri for ri in r]
                S = sum(b)
                # compute outer curvature using minus sign (outer sphere)
                # b_outer = S - 2*sqrt(sum_{i<j} b_i b_j) ??? Let's derive.
                # For n=3 (circles), b4 = b1 + b2 + b3 ± 2 sqrt(b1 b2 + b2 b3 + b3 b1)
                # For n=3 (spheres), formula is b5 = b1 + b2 + b3 + b4 ± 2 sqrt(b1 b2 + b1 b3 + b1 b4 + b2 b3 + b2 b4 + b3 b4)
                # So outer curvature = S - 2*sqrt(sum_{i<j} b_i b_j) (negative sign yields outer)
                sum_pair = 0
                for i in range(4):
                    for j in range(i+1,4):
                        sum_pair += b[i]*b[j]
                sqrt_term = math.sqrt(sum_pair)
                b_outer = S - 2*sqrt_term  # this should be negative (outer)
                R = -1/b_outer
                # also inner Soddy sphere curvature (small sphere) = S + 2*sqrt_term
                b_inner = S + 2*sqrt_term
                r_inner = 1/b_inner
                return R, r_inner
            
