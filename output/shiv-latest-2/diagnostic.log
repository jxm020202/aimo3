            def orthocenter_excentral_numeric2(D,E,F):
                D = sp.Point(D); E = sp.Point(E); F = sp.Point(F)
                a = float(E.distance(F))
                b = float(D.distance(F))
                c = float(D.distance(E))
                I_A = sp.Point((a*D.x + b*E.x - c*F.x)/(a+b-c), (a*D.y + b*E.y - c*F.y)/(a+b-c))
                I_B = sp.Point((-a*D.x + b*E.x + c*F.x)/(-a+b+c), (-a*D.y + b*E.y + c*F.y)/(-a+b+c))
                # line1 coefficients: (y - y1) = m1 (x - x1)
                x1, y1 = float(I_A.x), float(I_A.y)
                x2, y2 = float(F.x), float(F.y)
                x3, y3 = float(I_B.x), float(I_B.y)
                x4, y4 = float(D.x), float(D.y)
                # compute intersection using linear equations
                # Solve for x,y: (y - y1)*(x2 - x1) = (y2 - y1)*(x - x1)   (line1)
                # and (y - y3)*(x4 - x3) = (y4 - y3)*(x - x3)   (line2)
                import numpy as np
                A = np.array([[x2 - x1, -(y2 - y1)], [x4 - x3, -(y4 - y3)], dtype=float])
                b_vec = np.array([x1*(y2 - y1) - y1*(x2 - x1), x3*(y4 - y3) - y3*(x4 - x3)], dtype=float)
                # Solve A * [x, y]^T = b_vec
                sol = np.linalg.solve(A, b_vec)
                ortho = sp.Point(sol[0], sol[1])
                O = sp.geometry.Triangle(D,E,F).circumcenter
                return ortho, O, float(ortho.distance(O))
            
            ortho, O, d = orthocenter_excentral_numeric2((0,0),(5,0),(2,3))
            ortho, O, d
            
