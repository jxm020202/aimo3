            def check_solution(x_frac, y_frac):
                xv = mp.mpf(x_frac.numerator)/x_frac.denominator
                yv = mp.mpf(y_frac.numerator)/y_frac.denominator
                L = 1 + mp.sqrt(1 - 2*yv)
                sqrt_term = mp.sqrt(1 - 2*xv)
                term = (4*xv - 2 + 2*sqrt_term) / (3 - 5*xv - sqrt_term)
                inner_sqrt = mp.sqrt(9*xv**4 + (4*xv**6)/3 + 9 + 18*xv**2)
                A_plus = (1 + xv**2)/2 + (1/6)*inner_sqrt
                A_minus = (1 + xv**2)/2 - (1/6)*inner_sqrt
                C1 = mp.sign(A_plus) * abs(A_plus)**(1/3)
                C2 = mp.sign(A_minus) * abs(A_minus)**(1/3)
                R = yv + term + C1 + C2
                return L - R
            
