            import math
            from fractions import Fraction
            from math import gcd
            
            def lcm(a,b):
                return a*b//gcd(a,b)
            
            min_k = None
            solutions = []
            max_den = 20  # search up to denominator 20
            for q in range(1, max_den+1):
                for p in range(1, q):
                    if gcd(p,q)!=1:
                        continue
                    s = Fraction(p, q)
                    # ensure s in (0,1)
                    # compute left side L = 8 s (1 - s)
                    L = 8 * s * (1 - s)
                    # Now we need to find t rational such that RHS matches.
                    # RHS = (1 + 5 s^2 - 2 s) * (t^2 + 2 t - 1)
                    # Let A = 1 + 5 s^2 - 2 s, rational.
                    A = 1 + 5 * s * s - 2 * s
                    # We need t rational solving: A * (t^2 + 2 t - 1) = L
                    # => t^2 + 2 t - 1 = L / A, provided A != 0.
                    if A == 0:
                        continue
                    RHS_val = Fraction(L, A)  # rational
                    # So we need t satisfying t^2 + 2 t - 1 = RHS_val.
                    # Solve quadratic: t^2 + 2 t - (1 + RHS_val) = 0? Wait:
                    # Actually t^2 + 2 t - 1 - RHS_val = 0.
                    # So t^2 + 2 t - (1 + RHS_val) = 0.
                    C = -(1 + RHS_val)  # coefficient constant term
                    # quadratic: t^2 + 2 t + C = 0.
                    # Discriminant D = 4 - 4*C = 4 - 4*C = 4*(1 - C)
                    D = 4 - 4*C
                    # D must be non-negative rational perfect square for t rational.
                    # Compute D as Fraction.
                    D_frac = Fraction(D)
                    # D_frac must be a perfect square rational: numerator and denominator perfect squares.
                    num = D_frac.numerator
                    den = D_frac.denominator
                    # check perfect squares
                    sqrt_num = int(math.isqrt(num))
                    sqrt_den = int(math.isqrt(den))
                    if sqrt_num*sqrt_num == num and sqrt_den*sqrt_den == den:
                        # then sqrt(D) = sqrt_num / sqrt_den
                        sqrtD = Fraction(sqrt_num, sqrt_den)
                        # t = (-2 ± sqrtD) / 2 = -1 ± sqrtD/2
                        t1 = Fraction(-2 + sqrtD, 2)
                        t2 = Fraction(-2 - sqrtD, 2)
                        for t in (t1, t2):
                            # Need t in (0,1)
                            if t > 0 and t < 1:
                                # compute x,y
                                x_val = Fraction(1,2) - s*s/2  # (1 - s^2)/2
                                y_val = Fraction(1,2) - t*t/2
                                # ensure positive
