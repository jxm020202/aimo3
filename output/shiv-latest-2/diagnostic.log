            def simulated_annealing(N, steps=20000, init_temp=1.0, cooling=0.9995):
                # start with random points
                pts = random_points_in_circle(N)
                best_pts = pts[:]
                best_score = sum_ai(pts)
                cur_score = best_score
                temp = init_temp
                for step in range(steps):
                    # propose move: randomly pick a point and move slightly
                    i = random.randrange(N)
                    # small perturbation
                    dx = (random.random()*2-1)*0.05
                    dy = (random.random()*2-1)*0.05
                    new_pt = (pts[i][0]+dx, pts[i][1]+dy)
                    # ensure inside unit circle (radius 1)
                    if new_pt[0]**2 + new_pt[1]**2 > 1.0:
                        continue
                    old_pt = pts[i]
                    pts[i] = new_pt
                    new_score = sum_ai(pts)
                    delta = new_score - cur_score
                    if delta > 0 or random.random() < math.exp(delta / temp):
                        cur_score = new_score
                        if new_score > best_score:
                            best_score = new_score
                            best_pts = pts[:]
                    else:
                        pts[i] = old_pt
                    temp *= cooling
                return best_score, best_pts
            
