            import math
            def order_mod(a, mod):
                # returns smallest k>0 such that a**k % mod == 1, if gcd(a,mod)=1 else None
                if math.gcd(a, mod) != 1:
                    return None
                k=1
                val=a%mod
                while val!=1:
                    val = (val*a) % mod
                    k+=1
                    if k>1000:
                        return None
                return k
            
