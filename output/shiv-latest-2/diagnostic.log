                p = target.numerator
                q = target.denominator
                # search for k in some range
                for k in range(-max_abs, max_abs+1):
                    # Solve 11 a + 3 b = p k
                    # Find particular solution using extended Euclid
                    # 11*? + 3*? = 1 => find inv of 11 mod 3 etc.
                    # Use brute force small a,b
                    # Actually we can solve using modular inverse: a = (p*k * inv11_mod3) mod 3 etc.
                    # Let's brute force a in range
                    for a in range(-max_abs, max_abs+1):
                        # compute b from equation
                        rhs = p*k - 11*a
                        if rhs % 3 != 0:
                            continue
                        b = rhs // 3
                        if abs(b) > max_abs:
                            continue
                        # Now solve for c,d similarly
                        for c in range(-max_abs, max_abs+1):
                            rhs2 = q*k - 11*c
                            if rhs2 % 3 != 0:
