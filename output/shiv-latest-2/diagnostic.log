            def find_solutions(limit):
                sols = []
                for q in range(1, limit+1):
                    for p in range(0, limit+1):  # t can be up to maybe 1?
                        # t must be <=1 because sqrt(1-2x) = t, and x positive => t <=1
                        # t = sqrt(1-2x) >=0, so t in [0,1].
                        # So p/q in [0,1].
                        if p>q: continue
                        # compute left side rational
                        # We'll search for a rational a such that D = 5 t^2 - 2 t + 1 = 2 a^2
                        # So a^2 = D/2 must be rational square.
                        # Compute D as fraction
                        D_num = 5*p*p - 2*p*q + q*q
                        D_den = q*q
                        # D = D_num / D_den
                        # Need D/2 = (D_num) / (2*D_den) to be a perfect square rational.
                        # Simplify fraction
                        from math import gcd
                        g = gcd(D_num, 2*D_den)
                        num = D_num // g
                        den = (2*D_den) // g
                        # check if num and den are perfect squares
                        import math
                        if int(math.isqrt(num))**2 == num and int(math.isqrt(den))**2 == den:
                            a_num = int(math.isqrt(num))
                            a_den = int(math.isqrt(den))
                            # a = a_num / a_den
                            # compute s = (t+1)/a rational
                            # t+1 = (p+q)/q
                            s_num = (p+q) * a_den
                            s_den = q * a_num
                            # simplify
                            g2 = math.gcd(s_num, s_den)
                            s_num //= g2
                            s_den //= g2
                            # compute x = (1 - t^2)/2 = (1 - p^2/q^2)/2 = (q^2 - p^2)/(2 q^2)
                            x_num = q*q - p*p
                            x_den = 2*q*q
                            g3 = math.gcd(x_num, x_den)
                            x_num //= g3
                            x_den //= g3
                            # compute y = s - s^2/2 = s - (s^2)/2
                            # s = s_num/s_den
                            # s^2 = s_num^2 / s_den^2
                            y_num = s_num * s_den * 2 - s_num**2
                            y_den = 2 * s_den**2
                            # Actually y = s - s^2/2 = (2s - s^2)/2 = (2s - s^2)/2
                            # compute numerator: 2*s - s^2 = (2*s_num/s_den) - (s_num^2/s_den^2) = (2*s_num*s_den - s_num**2)/s_den**2
                            # then divide by 2: y = (2*s_num*s_den - s_num**2) / (2*s_den**2)
                            y_num = 2*s_num*s_den - s_num**2
                            y_den = 2*s_den**2
                            g4 = math.gcd(y_num, y_den)
                            y_num //= g4
                            y_den //= g4
                            # ensure positive
                            if x_num>0 and y_num>0:
                                # compute minimal k = lcm(x_den, y_den)
                                from math import lcm
                                k = lcm(x_den, y_den)
                                sols.append((k, p, q, a_num, a_den, x_num, x_den, y_num, y_den))
                return sols
            
            sols = find_solutions(20)
            len(sols)
            
