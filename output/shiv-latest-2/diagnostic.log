            def find_solution(d, Q, max_k, bound):
                # Q is sympy polynomial with integer coeffs, degree < d
                # search for k from 1 to max_k
                for k in range(1, max_k+1):
                    # choose k+1 distinct integers from range
                    # brute force combos of size k+1
                    # to reduce, we can iterate over b and combos of k others
                    ints = list(range(-bound, bound+1))
                    for b in ints:
                        others = [x for x in ints if x != b]
                        # choose k distinct others
                        for combo in itertools.combinations(others, k):
                            lhs = Q.subs(sp.Symbol('x'), b) - sum(Q.subs(sp.Symbol('x'), a) for a in combo)
                            rhs = b**d - sum(a**d for a in combo)
                            if lhs == rhs:
                                return k, (b,)+combo
                return None
            
