            import numpy as np, random, math
            
            def bisectors(A,B,C):
                # internal bisector direction at C: sum of unit vectors from C to A and C to B
                u_CA = (A-C)/np.linalg.norm(A-C)
                u_CB = (B-C)/np.linalg.norm(B-C)
                internal = u_CA + u_CB
                external = u_CA - u_CB
                return internal, external
            
