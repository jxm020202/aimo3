                                [C[0]-A[0], C[1]-A[1]]])
                rhs = np.array([B[0]**2 + B[1]**2 - A[0]**2 - A[1]**2,
                                C[0]**2 + C[1]**2 - A[0]**2 - A[1]**2])
                O = np.linalg.solve(D, rhs)
                return O
            
            def incenter(A,B,C):
                # side lengths opposite vertices
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(C-A)
                c = np.linalg.norm(A-B)
                P = a*A + b*B + c*C
                Q = (a+b+c)
                return P / Q
            
            def external_bisector_direction(F, D, E):
                FD = D - F
                FE = E - F
                # unit vectors
                FD_u = FD / np.linalg.norm(FD)
                FE_u = FE / np.linalg.norm(FE)
                # external bisector direction: difference
                dir_vec = FD_u - FE_u
                # ensure not zero
                return dir_vec
            
            def intersect_line_line(p1, d1, p2, d2):
                # lines: p1 + t*d1, p2 + s*d2
                # solve for t where they intersect (2D)
                # cross product approach
                # solve [d1, -d2] [t; s] = p2 - p1
                A = np.column_stack((d1, -d2))
                if abs(np.linalg.det(A)) < 1e-12:
                    return None
                ts = np.linalg.solve(A, p2 - p1)
                t = ts[0]
                return p1 + t*d1
            
            def ratio_numeric(A,B,C):
                P = circumcenter(A,B,C)
                Q = incenter(A,B,C)
                # line PQ direction
                dPQ = Q - P
                # perpendicular direction
                d_perp = np.array([-dPQ[1], dPQ[0]])  # rotate 90 deg
                # line through Q with direction d_perp
                # intersect with DE
                M = intersect_line_line(Q, d_perp, A, B - A)  # D=A, E=B
                # external bisector at C (F)
                dir_ext = external_bisector_direction(C, A, B)
                N = intersect_line_line(Q, d_perp, C, dir_ext)
                QM = np.linalg.norm(Q - M)
                QN = np.linalg.norm(Q - N)
                return QM/QN
            
            def test_random():
                for i in range(10):
                    A = np.random.rand(2)*10 - 5
                    B = np.random.rand(2)*10 - 5
                    C = np.random.rand(2)*10 - 5
                    # ensure non-collinear
                    if abs(np.linalg.det(np.column_stack((B-A, C-A)))) < 1e-6:
                        continue
                    r = ratio_numeric(A,B,C)
                    print(r)
            
            test_random()
            
