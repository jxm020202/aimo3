            import sys, math
            
            def last_nonzero_digit_fact(n):
                # compute last non-zero digit of n! using recurrence
                # algorithm: while n>0:
                #   result = result * product of numbers 1..n%5 ignoring multiples of 5, modulo 10
                #   result = result * pow(2, n//5, 10) % 10
                #   n //=5
                # return result
                res = 1
                while n > 0:
                    # product of numbers 1..n%5 ignoring multiples of 5 (i.e., just normal product)
                    # Actually numbers 1..r where r = n%5, none are multiples of 5, so just multiply them.
                    r = n % 5
                    # compute product 1*2*...*r mod 10
                    prod = 1
                    for i in range(1, r+1):
                        prod = (prod * i) % 10
                    res = (res * prod) % 10
                    # multiply by 2^{n//5} mod 10
                    res = (res * pow(2, n//5, 10)) % 10
                    n //= 5
                return res
            
            # test small values
            vals = [last_nonzero_digit_fact(i) for i in range(1,21)]
            vals
            
