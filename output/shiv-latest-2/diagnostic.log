            import math, fractions, itertools
            from fractions import Fraction
            def compute_solution(p,q,t,sign):
                # sign = +1 for plus (p+2t), -1 for minus (p-2t)
                a = Fraction(p + sign*2*t, 5*p)  # a = (p ± 2t)/(5p)
                if a <= 0 or a >= 1:
                    return None
                # compute s = p/q
                s = Fraction(p, q)
                # compute b = (a+1)*s - 1
                b = (a + 1) * s - 1
                if b <= 0 or b >= 1:
                    return None
                # compute x,y
                x = Fraction(1,2) - a*a/2  # (1 - a^2)/2
                y = Fraction(1,2) - b*b/2
                if x <= 0 or y <= 0:
                    return None
                # compute k = lcm of denominators
                den_x = x.denominator
                den_y = y.denominator
                k = math.lcm(den_x, den_y)
                return (x,y,k,a,b,p,q,t,sign)
            
            def search(limit):
                best = None
                for p in range(1, limit+1):
                    for q in range(1, limit+1):
                        # ensure p/q reduced? Not necessary but we can consider reduced.
                        if math.gcd(p,q)!=1:
                            continue
                        for t in range(1, limit+1):
                            # Check equation 5 q^2 - 2 p^2 = 2 t^2 (derived earlier)
                            if 5*q*q - 2*p*p != 2*t*t:
                                continue
                            # both signs
                            for sign in [1,-1]:
                                sol = compute_solution(p,q,t,sign)
                                if sol:
                                    x,y,k, a,b,pp,qq,tt,sg = sol
                                    if best is None or k < best[0]:
                                        best = (k, x, y, a, b, p,q,t,sign)
                return best
            
            best = search(30)
            best
            
