            def solve_y_for_t(t_val):
                # Solve (A - y^2)^2 = 4 t^2 (A - 2 sqrt(3)*(1 - t) y)
                t_sym = sp.nsimplify(t_val, [sp.sqrt(3)])  # maybe rational approximation
                y = sp.symbols('y', real=True)
                A = t_sym**2 + 3*(1 - t_sym)**2
                eq = sp.Eq((A - y**2)**2, 4*t_sym**2*(A - 2*sp.sqrt(3)*(1 - t_sym)*y))
