            def sum_a(angles, window=160):
                n = len(angles)
                # sort angles
                ang = sorted(angles)
                # duplicate with +360 for wrap-around
                ang2 = ang + [a+360 for a in ang]
                total = 0
                for i, a in enumerate(ang):
                    # find minimal count of points in any interval of length window that contains a
                    # we can consider intervals that start at each point <= a and end = start+window >= a
                    # Equivalent to sliding window: for each start index s where ang2[s] <= a <= ang2[s]+window
                    # The count is number of points in ang2 between s and e where ang2[e] <= ang2[s]+window
                    # We need minimal count among such s.
                    # Simpler: consider intervals that start at each point among the n points (including a) and also intervals that end at each point.
                    # We'll just slide start index s from 0..n-1 and compute interval [ang2[s], ang2[s]+window]
                    mincnt = n  # include self
                    for s in range(n):
                        start = ang2[s]
                        end = start + window
                        # count points in [start, end] among ang2 (first n points after s)
                        # find first index >= start (s) and last index <= end
                        # Use binary search
                        # We'll just loop for simplicity
                        cnt = 0
                        for t in range(s, s+n):
                            if ang2[t] <= end + 1e-9:
                                cnt += 1
                            else:
                                break
                        # check if interval contains a
                        if start - 1e-9 <= a <= end + 1e-9:
                            if cnt < mincnt:
                                mincnt = cnt
                    # mincnt includes self
                    b_i = mincnt - 1
                    total += (n-1 - b_i)
                return total
            
            def random_angles(n):
                return [random.random()*360 for _ in range(n)]
            
