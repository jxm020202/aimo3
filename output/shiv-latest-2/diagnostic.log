            import random, math, cmath, itertools, sys, numpy as np, sympy as sp
            
            def compute_angle():
                # random w1, x1 vectors in 2D
                # choose w1 = (a,0) along x-axis for simplicity, because we can rotate coordinate system.
                a = random.uniform(1,5)
                w1 = np.array([a, 0.0])
                # choose w2 = alpha * w1, with alpha not equal to 1 maybe.
                alpha = random.uniform(-2,2)
                while abs(alpha-1) < 0.1: # avoid degenerate zero diagonal length
                    alpha = random.uniform(-2,2)
                w2 = alpha * w1
                
                # choose x1 arbitrary not collinear with w1
                # pick random angle not 0 or pi
                theta = random.uniform(0.2, math.pi-0.2)
                r = random.uniform(1,5)
                x1 = np.array([r*math.cos(theta), r*math.sin(theta)])
                # choose beta such that diagonal lengths equal:
                # |alpha-1|*|w1| = |beta-1|*|x1|
                len_w = abs(alpha-1)*np.linalg.norm(w1)
                # choose sign for beta-1 maybe positive or negative
                # random sign
                sign = random.choice([1,-1])
                # compute beta-1 = sign * len_w / |x1|
                beta_minus1 = sign * len_w / np.linalg.norm(x1)
                beta = 1 + beta_minus1
                x2 = beta * x1
                
                # compute N solving linear equations
                # unknown N = (nx, ny)
                # equations: N·(x1 - w1) = (|x1|^2 - |w1|^2)/2
                #            N·(x2 - w2) = (|x2|^2 - |w2|^2)/2
                A = np.vstack([x1 - w1, x2 - w2])  # 2x2 matrix rows
                b = np.array([(np.dot(x1,x1)-np.dot(w1,w1))/2,
                             (np.dot(x2,x2)-np.dot(w2,w2))/2])
                # Solve linear system A N = b
                try:
                    N = np.linalg.solve(A, b)
                except np.linalg.LinAlgError:
                    return None
                # compute O solving:
                # O·(w2 - x1?) Wait O equations: O·(Y - X) = (|Y|^2 - |X|^2)/2
                # Y = w2, X = x1
                # O·(W - Z) = (|W|^2 - |Z|^2)/2
                A2 = np.vstack([w2 - x1, w1 - x2])
                b2 = np.array([(np.dot(w2,w2)-np.dot(x1,x1))/2,
                               (np.dot(w1,w1)-np.dot(x2,x2))/2])
                try:
                    O = np.linalg.solve(A2, b2)
                except np.linalg.LinAlgError:
                    return None
                # angle between N and O
                dot = np.dot(N, O)
                normN = np.linalg.norm(N)
                normO = np.linalg.norm(O)
                if normN==0 or normO==0:
                    return None
                cosang = dot/(normN*normO)
                # clamp
                cosang = max(min(cosang,1),-1)
                ang = math.degrees(math.acos(cosang))
                return ang
            
