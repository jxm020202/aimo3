            def compute_counts_king(n):
                # generate valid masks (no adjacent bits)
                valid_masks = [mask for mask in range(1<<n) if (mask & (mask<<1))==0]
                M = len(valid_masks)
                print("valid masks:", M)
                # precompute compatibility: for each mask, list of masks that are compatible with previous row
                compat = [[] for _ in range(M)]
                # map mask to index
                mask_to_idx = {mask:i for i,mask in enumerate(valid_masks)}
                for i, m1 in enumerate(valid_masks):
                    for j, m2 in enumerate(valid_masks):
                        if m1 & m2: continue
                        if (m1<<1) & m2: continue
                        if (m1>>1) & m2: continue
                        compat[i].append(j)
                # DP: dp[i][k] = number of ways up to current row with current mask index i and total k occupied
                max_k = ( (n+1)//2 )**2  # upper bound on independent set size
                # initialize dp for first row
                dp = [dict() for _ in range(M)]
                for i, mask in enumerate(valid_masks):
                    occ = bin(mask).count('1')
                    dp[i][occ] = 1
                # iterate rows 2..n
                for row in range(1, n):
                    newdp = [dict() for _ in range(M)]
                    for i in range(M):
