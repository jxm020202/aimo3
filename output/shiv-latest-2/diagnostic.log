            def find_cycle_state(mod, n=100, max_iters=2000000):
                # state is tuple of last n terms
                state = tuple(pow(2, k, mod) for k in range(n))
                def next_state(st):
                    s = sum(st) % mod
                    return st[1:] + (s,)
                # Floyd
                tortoise = next_state(state)
                hare = next_state(next_state(state))
                steps = 0
                while tortoise != hare and steps < max_iters:
                    tortoise = next_state(tortoise)
                    hare = next_state(next_state(hare))
                    steps += 1
                if steps >= max_iters:
                    return None
                # find mu
                mu = 0
                tortoise = state
                while tortoise != hare:
                    tortoise = next_state(tortoise)
                    hare = next_state(hare)
                    mu += 1
                # find lambda
                lam = 1
                hare = next_state(tortoise)
                while tortoise != hare:
                    hare = next_state(hare)
                    lam += 1
                return mu, lam
            
            print(find_cycle_state(25, n=100, max_iters=500000))
            
