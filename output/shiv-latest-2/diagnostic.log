            def compute_coords(D,E,F):
                O = circumcenter(D,E,F)
                I = incenter(D,E,F)
                # rotate so that O at (0,0) and I on y-axis (x=0). We'll compute rotation matrix.
                # vector OI = I - O = I
                OI = I
                # angle to rotate OI to vertical (0,1)
                angle = math.atan2(OI[0], OI[1])  # rotate by -angle to bring OI to y-axis
                # rotation matrix
                cos_a = math.cos(-angle)
                sin_a = math.sin(-angle)
                R = np.array([[cos_a, -sin_a],[sin_a, cos_a]])
                # apply rotation to all points (subtract O first)
                D_rot = R @ (np.array(D)-O)
                E_rot = R @ (np.array(E)-O)
                F_rot = R @ (np.array(F)-O)
                I_rot = R @ (I-O)
                # now I_rot should have x approx 0
                return D_rot, E_rot, F_rot, I_rot
            
            def ratio_via_rot(D,E,F):
                D_rot, E_rot, F_rot, I_rot = compute_coords(D,E,F)
                # line y = I_rot[1]
                y0 = I_rot[1]
                # compute M x
                # param t for line DE: D + t (E-D)
                t = (y0 - D_rot[1])/(E_rot[1] - D_rot[1])
                xM = D_rot[0] + t*(E_rot[0] - D_rot[0])
                # external bisector direction at A (F_rot)
                FD = D_rot - F_rot
                FE = E_rot - F_rot
                uFD = FD/np.linalg.norm(FD)
                uFE = FE/np.linalg.norm(FE)
                w = uFD - uFE
                # intersection with y=y0: solve y0 = y_A + λ w_y
                lam = (y0 - F_rot[1]) / w[1]
                xN = F_rot[0] + lam * w[0]
                return xM, xN
            
            # test
