                for i, (xi, yi) in enumerate(points):
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        angles.append(math.atan2(yj-yi, xj-xi) % (2*math.pi))
                    total += max_in_wedge(sorted(angles), width)
                return total
            
