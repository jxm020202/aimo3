            def find_solutions(max_den):
                import math
                sols = []
                for b in range(1, max_den+1):
                    for a in range(0, b+1):
                        if math.gcd(a,b)!=1:
                            continue
                        u = Fraction(a,b)
                        # u must be in [0,1)
                        if not (0 <= u < 1):
                            continue
                        # compute A,B,C etc for polynomial
                        A = 5*u*u - 2*u + 1
                        B = 10*u*u - 4*u + 2
                        C = 3*u*u - 6*u - 1
                        # solve quadratic for v rational: (A)v^2 + B v + C =0
                        # discriminant D = B^2 - 4AC must be perfect square rational
                        D = B*B - 4*A*C
                        # D must be >=0
                        if D < 0:
                            continue
                        # Check if sqrt(D) rational:
                        # Since D is rational, we can check if numerator and denominator are perfect squares.
                        # Represent D as Fraction
                        D_frac = Fraction(D)
                        # D_frac = p/q reduced
                        p = D_frac.numerator
                        q = D_frac.denominator
                        # check if p and q are perfect squares
                        import math
                        sp = int(math.isqrt(p))
                        sq = int(math.isqrt(q))
                        if sp*sp != p or sq*sq != q:
                            continue
                        sqrtD = Fraction(sp, sq)
                        # compute v solutions
                        v1 = Fraction(-B + sqrtD, 2*A)
                        v2 = Fraction(-B - sqrtD, 2*A)
