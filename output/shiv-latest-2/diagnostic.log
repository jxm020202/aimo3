            from collections import deque
            
            def closure_pair(x,y,limit=200):
                # BFS limited to numbers within [-limit, limit]
                S=set([x,y])
                queue=deque([x,y])
                while queue:
                    a=queue.popleft()
                    for b in list(S):
                        # generate numbers for i such that result within bound
                        # Since i can be any integer, we can generate many; we will generate for i in range where result within bound
                        # compute step = a*b
                        step = a*b
                        base = a*a + b*b
                        # generate i such that result in range
                        # i = (n - base) / step
                        # we can iterate i from -limit//abs(step)-2 to limit//abs(step)+2
                        if step==0:
                            continue
                        max_i = (limit - base)//step if step>0 else ( -limit - base)//step
                        min_i = (-limit - base)//step if step>0 else (limit - base)//step
                        # ensure min_i <= max_i
                        if min_i>max_i:
                            min_i, max_i = max_i, min_i
                        for i in range(min_i, max_i+1):
                            n = base + i*step
                            if -limit <= n <= limit and n not in S:
                                S.add(n)
                                queue.append(n)
                return S
            
            def closure_contains_all(x,y,limit=100):
                S=closure_pair(x,y,limit)
                # check if all integers in range [-limit,limit] are present
                return all(n in S for n in range(-limit, limit+1))
            
            for x,y in [(2,3),(2,4),(3,5),(4,6)]:
                print(x,y, closure_contains_all(x,y,limit=50))
            
