            import sympy as sp
            
            α, β, γ = sp.symbols('α β γ', real=True)
            
            # Define coordinates
            D = sp.Matrix([sp.cos(α), sp.sin(α)])
            E = sp.Matrix([sp.cos(β), sp.sin(β)])
            F = sp.Matrix([sp.cos(γ), sp.sin(γ)])
            
            # side lengths (chord lengths)
            a = 2*sp.sin((β-γ)/2)  # opposite D
            b = 2*sp.sin((γ-α)/2)  # opposite E
            c = 2*sp.sin((α-β)/2)  # opposite F
            
            # Incenter I (Q)
            I = (a*D + b*E + c*F) / (a + b + c)
            
            # Define R = rotate I by 90 degrees (counterclockwise)
            Ix, Iy = I[0], I[1]
            R = sp.Matrix([-Iy, Ix])
            
            # Solve for λ_M, μ such that I + λ_M * R = D + μ*(E-D)
            λ, μ = sp.symbols('λ μ')
            eq_M = sp.Eq(I + λ*R, D + μ*(E - D))
            # This is vector equation; we can solve componentwise
            sol_M = sp.solve([eq_M.lhs[0] - eq_M.rhs[0], eq_M.lhs[1] - eq_M.rhs[1]], (λ, μ), dict=True)
