            def find_odd_cycle(start, max_depth=9):
                # BFS with path tracking
                from collections import deque
                q = deque()
                q.append( (start, 0, []) )  # rational, depth, path list of generators
                visited = { (start,0) }  # (rational, parity?) maybe track visited with parity?
                while q:
                    r, depth, path = q.popleft()
                    if depth > max_depth:
                        continue
                    # generate neighbors
                    for gen, name in [(-r, 'A'), (1 - r, 'B'), (1/r if r!=0 else None, 'C')]:
                        if gen is None:
                            continue
                        new_depth = depth + 1
                        new_path = path + [name]
                        if gen == start and new_depth % 2 == 1:
                            return new_path
                        # avoid infinite loops: we can store (r, parity) visited
                        key = (gen, new_depth % 2)
                        if key not in visited:
                            visited.add(key)
                            q.append((gen, new_depth, new_path))
