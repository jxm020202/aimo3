            def find_subset(a, p, target):
                # simple backtracking greedy: start with largest numbers not p
                numbers = [i for i in range(200,0,-1) if i != p]
                # Use DP for subset sum with size constraint? We'll try simple recursion with pruning.
                from functools import lru_cache
                @lru_cache(None)
                def dfs(i, k, s):
                    # i index in numbers list (starting from 0)
                    if k == 0:
                        return s == 0
                    if i >= len(numbers):
                        return False
                    # prune if remaining numbers insufficient to reach sum
                    # max possible sum using next k numbers (largest remaining)
                    if s < 0:
                        return False
                    # compute max possible sum using numbers[i:i+k] (since numbers descending)
                    max_possible = sum(numbers[i:i+k])
                    if s > max_possible:
                        return False
                    # compute min possible sum using smallest k numbers from remaining (i.e., from end)
                    # but for simplicity skip pruning
                    # try include numbers[i]
                    if numbers[i] <= s:
                        if dfs(i+1, k-1, s - numbers[i]):
                            return True
                    # try skip
                    if dfs(i+1, k, s):
                        return True
                    return False
                return dfs(0, a, target)
            
