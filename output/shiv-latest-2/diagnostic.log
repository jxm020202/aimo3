            def barycentric(P, L):
                D = sp.Point(0,0)
                E = sp.Point(L,0)
                F = sp.Point(L/2, sp.sqrt(3)/2 * L)
                # Solve for a,b,c such that P = a*D + b*E + c*F, a+b+c=1
                a,b,c = sp.symbols('a b c')
                eqs = [
                    sp.Eq(P.x, a*D.x + b*E.x + c*F.x),
                    sp.Eq(P.y, a*D.y + b*E.y + c*F.y),
                    sp.Eq(a+b+c, 1)
                ]
                sol = sp.solve(eqs, (a,b,c), dict=True)[0]
                return sol[a], sol[b], sol[c]
            
            # define symbols
            Lsym = sp.symbols('L', positive=True)
            # define points symbolic for case1 and case2
