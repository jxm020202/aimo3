            from functools import lru_cache
            
            def find_gaps(m, n, max_gap=200):
                # D = required differences
                D = [fib(k) for k in range(2, m+2)]
                # we need n points => n-1 gaps
                gaps_len = n-1
                # backtrack assign gaps
                # we will generate all possible sequences of gaps (positive ints) up to max_gap
                # but prune using that we need to produce all D as interval sums.
                # We'll generate gaps incrementally and keep track of achievable sums.
                target_set = set(D)
                @lru_cache(None)
                def backtrack(pos, prev_gaps_tuple, sums_tuple):
                    # pos: number of gaps assigned so far
                    # prev_gaps_tuple: tuple of assigned gaps
                    # sums_tuple: sorted tuple of achievable sums from intervals using assigned gaps so far
                    # Actually we need to compute all interval sums from the current partial sequence.
                    # For partial sequence of length pos, we have intervals within that prefix.
                    # We'll compute set of sums of contiguous subsequences within the prefix.
                    if pos == gaps_len:
                        # final check
                        if target_set.issubset(set(sums_tuple)):
                            return list(prev_gaps_tuple)
                        else:
                            return None
                    # else assign next gap
                    # compute current max sum to bound next gap maybe
                    # we can try gaps up to max_gap
                    for g in range(1, max_gap+1):
                        # compute new sums including intervals that end at new gap
                        new_gaps = prev_gaps_tuple + (g,)
                        # compute all interval sums for new sequence
                        new_sums = set()
                        # compute prefix sums
                        prefix = [0]
                        for val in new_gaps:
                            prefix.append(prefix[-1] + val)
                        # all interval sums = prefix[j]-prefix[i] for i<j
                        for i in range(len(prefix)):
                            for j in range(i+1, len(prefix)):
                                new_sums.add(prefix[j]-prefix[i])
                        # prune if cannot possibly cover target_set (i.e., some required diff > max(new_sums) or not in new_sums)
                        # Actually we need eventual superset, so we can prune if any required diff > max(new_sums) and cannot be achieved later because max sum will increase with more gaps.
                        # Since adding more gaps can increase max sum, we cannot prune on >.
                        # But we can prune if some required diff is already impossible: if a required diff is not in new_sums and also cannot be formed later because it would require a sum that includes future gaps, which is possible.
                        # Hard to prune.
                        # For simplicity, just continue recursion.
                        res = backtrack(pos+1, new_gaps, tuple(sorted(new_sums)))
                        if res is not None:
                            return res
                    return None
                return backtrack(0, tuple(), tuple([0]))
            
