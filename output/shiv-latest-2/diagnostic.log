            def longest_zero_run_mod_n(n, max_terms=200000):
                # compute sequence modulo n
                # a[0] corresponds to a_1 (since indexing from 0)
                a = [pow(2, k, n) for k in range(n)]  # a_k = 2^{k} for k=0..n-1 (since a_1 = 2^0)
                # Actually a_k = 2^{k-1}, so a[0]=1, a[1]=2, etc.
                # Already correct: pow(2,k,n) yields 2^k mod n, which matches a_{k+1}
                # We'll compute further terms
                longest = 0
                current = 0
                # check initial terms
                for val in a:
                    if val % n == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                # generate further
                from collections import deque
                window = deque(a, maxlen=n)
                for idx in range(n, max_terms):
                    next_val = sum(window) % n
                    # update zero run
                    if next_val == 0:
                        current += 1
                        longest = max(longest, current)
                    else:
                        current = 0
                    # slide
                    window.append(next_val)
                return longest
            
