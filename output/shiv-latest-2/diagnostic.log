            from collections import deque
            
            # Define generators as matrices (a,b,c,d) representing [[a,b],[c,d]]
            A = (-1,0,0,1)   # -r
            B = (-1,1,0,1)   # 1 - r
            C = (0,1,1,0)    # 1/r
            
            def mat_mul(m1, m2):
                a1,b1,c1,d1 = m1
                a2,b2,c2,d2 = m2
                # matrix multiplication m1 * m2
                return (a1*a2 + b1*c2,
                        a1*b2 + b1*d2,
                        c1*a2 + d1*c2,
                        c1*b2 + d1*d2)
            
            def apply_mat(m, v):
                # v is (p,q)
                a,b,c,d = m
                p,q = v
                return (a*p + b*q, c*p + d*q)
            
            def bfs_to_targets(v0, targets, max_depth=12):
                # targets: set of vectors (p,q)
                visited = { (1,0,0,1): 0 }  # identity matrix distance parity
                q = deque([ (1,0,0,1) ])
                results = {}
                while q:
                    m = q.popleft()
                    dist = visited[m]
                    # apply to v0
                    vt = apply_mat(m, v0)
                    if vt in targets and vt not in results:
                        results[vt] = dist % 2
                        if len(results) == len(targets):
                            break
                    if dist >= max_depth:
                        continue
                    for gen in (A,B,C):
                        m2 = mat_mul(gen, m)  # left multiply
                        if m2 not in visited:
                            visited[m2] = dist + 1
                            q.append(m2)
                return results
            
            v0 = (11,3)
            targets_vec = [(7,3),(11,4),(2024,5),(109,11),(3,71),(5,204)]
            targets_set = set(targets_vec)
            res = bfs_to_targets(v0, targets_set, max_depth=12)
            res
            
