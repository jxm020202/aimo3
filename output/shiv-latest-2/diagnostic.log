            def P_two_equal(t, s):
                return (t*t - s*s)*(t*s - t*t)*(s*t - t*t)
            
            def min_two_equal():
                min_val = 1e9
                best = None
                # sample t in range [-sqrt(3/2), sqrt(3/2)] because 2t^2 <=3 => |t| <= sqrt(3/2)
                for t in np.linspace(-math.sqrt(3/2), math.sqrt(3/2), 20001):
