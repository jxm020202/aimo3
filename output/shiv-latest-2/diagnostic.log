            def lcm_range(k, n):
                # compute lcm of k..k+n-1
                # using math.lcm (Python 3.9+)
                # but for large numbers may overflow; but we can compute using sympy.lcm for big ints.
                # We'll use math.lcm for speed; Python's math.lcm works for many ints.
                res = 1
