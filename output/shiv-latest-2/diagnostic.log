            def angle_between(v1, v2):
                # returns absolute angle in radians between vectors
                dot = v1[0]*v2[0] + v1[1]*v2[1]
                norm1 = math.hypot(v1[0], v1[1])
                norm2 = math.hypot(v2[0], v2[1])
                return abs(math.acos(dot/(norm1*norm2)))
            
            def compute_angles(D,E,F):
                # compute triangle angles at A=D, B=E, C=F
                a = length(E,F) # BC opposite A
                b = length(F,D) # CA opposite B
                c = length(D,E) # AB opposite C
                # using law of cos
                alpha = math.acos((b**2 + c**2 - a**2)/(2*b*c))
                beta = math.acos((a**2 + c**2 - b**2)/(2*a*c))
                gamma = math.pi - alpha - beta
                # O circumcenter
                import sympy as sp
                O = sp.geometry.Triangle(sp.Point(D), sp.Point(E), sp.Point(F)).circumcenter
                I = sp.geometry.Triangle(sp.Point(D), sp.Point(E), sp.Point(F)).incenter
                O = (float(O.x), float(O.y))
                I = (float(I.x), float(I.y))
                # vector OI
                v_OI = (I[0]-O[0], I[1]-O[1])
                # side AB = DE vector
                v_AB = (E[0]-D[0], E[1]-D[1])
                # internal bisector at C (F) direction: sum of unit vectors from F to D and to E
                FD = (D[0]-F[0], D[1]-F[1])
                FE = (E[0]-F[0], E[1]-F[1])
                # unit vectors
                def unit(v):
                    norm = math.hypot(v[0], v[1])
                    return (v[0]/norm, v[1]/norm)
                uFD = unit(FD)
                uFE = unit(FE)
                v_CI = (uFD[0]+uFE[0], uFD[1]+uFE[1])  # internal bisector direction
                # angles
                theta = angle_between(v_OI, v_AB)
                phi = angle_between(v_OI, v_CI)
                return alpha, beta, gamma, theta, phi, theta+phi
            
            for i in range(5):
                D,E,F = random_triangle()
                alpha,beta,gamma,theta,phi,sumang = compute_angles(D,E,F)
                print(alpha+beta+gamma, sumang, math.degrees(sumang))
            
