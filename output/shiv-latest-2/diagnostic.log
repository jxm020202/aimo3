            def residues_covered(a,b):
                mod = a*b
                covered = set()
                for k in range(mod):
                    # multiples of a^2
                    if (k % (a*a)) == 0:
                        covered.add(k)
                    # multiples of b^2
                    if (k % (b*b)) == 0:
                        covered.add(k)
                    # offset class
                    if (k - (a*a + b*b)) % mod == 0:
                        covered.add(k)
                return len(covered) == mod
            
