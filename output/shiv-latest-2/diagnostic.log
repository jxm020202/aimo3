            def circumcenter(A,B,C):
                # solve for O = (ox,oy) such that distances squared equal
                ox, oy = sp.symbols('ox oy', real=True)
                O = sp.Point(ox, oy)
                eq1 = O.distance(A)**2 - O.distance(B)**2
                eq2 = O.distance(A)**2 - O.distance(C)**2
                sol = sp.solve([sp.simplify(eq1), sp.simplify(eq2)], (ox, oy), dict=True)
                # there may be one solution
                if sol:
                    sol = sol[0]
                    return sp.Point(sol[ox], sol[oy])
                else:
                    return None
            
            def incenter(A,B,C):
                # side lengths opposite vertices: a = BC, b = CA, c = AB
                a = B.distance(C)
                b = C.distance(A)
                c = A.distance(B)
                # coordinates weighted
                x = (a*A.x + b*B.x + c*C.x) / (a+b+c)
                y = (a*A.y + b*B.y + c*C.y) / (a+b+c)
                return sp.Point(sp.simplify(x), sp.simplify(y))
            
            O1 = circumcenter(P,Q,R)
            O2 = circumcenter(P,R,S)
            I1 = incenter(P,Q,R)
            I2 = incenter(P,R,S)
            
