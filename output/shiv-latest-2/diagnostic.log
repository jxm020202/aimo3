            def max_zero_run_mod_n(n, max_terms):
                # compute sequence modulo n
                # initial terms a_1..a_n
                a = [pow(2, k, n) for k in range(n)]  # a[0]=a1
                # sliding sum of last n terms
                window_sum = sum(a) % n
                max_run = 0
                cur_run = 0
                # check initial terms
                for val in a:
                    if val % n == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # generate further terms
                for idx in range(n, max_terms):
                    next_val = window_sum % n
                    # update run
                    if next_val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                    # update sliding window
                    # subtract a[idx-n] (the term that slides out)
                    out_val = a[idx - n]
                    window_sum = (window_sum + next_val - out_val) % n
                    a.append(next_val)
