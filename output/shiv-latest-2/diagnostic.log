            def circumcenter_numeric(A,B,C):
                # solve linear system using numpy
                A=np.array(A); B=np.array(B); C=np.array(C)
                # compute perpendicular bisector equations
                # Solve for O such that |O-A|^2 = |O-B|^2 and |O-A|^2 = |O-C|^2
                # Expand: O·O - 2O·A + A·A = O·O - 2O·B + B·B => -2O·A + A·A = -2O·B + B·B => 2O·(B-A) = B·B - A·A
                # similarly for C
                M = np.vstack([2*(B-A), 2*(C-A)])  # 2x2 matrix
                rhs = np.array([np.dot(B,B)-np.dot(A,A), np.dot(C,C)-np.dot(A,A)])
                O = np.linalg.solve(M, rhs)
                return O
            
            def incenter_numeric(A,B,C):
                A=np.array(A); B=np.array(B); C=np.array(C)
                a = np.linalg.norm(B-C)
                b = np.linalg.norm(A-C)
                c = np.linalg.norm(A-B)
                I = (a*A + b*B + c*C)/(a+b+c)
                return I
            
            def ratio_numeric(A,B,C):
