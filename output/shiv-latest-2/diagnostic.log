            def count_bidirectional(points, width_deg=100):
                width = math.radians(width_deg)
                n = len(points)
                # compute a_i as before but also store which j are seen
                seen = [set() for _ in range(n)]
                for i, (xi, yi) in enumerate(points):
                    angles = []
                    for j, (xj, yj) in enumerate(points):
                        if i==j: continue
                        ang = math.atan2(yj-yi, xj-xi) % (2*math.pi)
                        angles.append((ang, j))
                    # sort by angle
                    angles.sort()
                    # duplicate for wrap
                    angs = [a for a,_ in angles]
                    js = [j for _,j in angles]
                    angs2 = angs + [a+2*math.pi for a in angs]
                    js2 = js + js
                    maxcnt = 0
                    best_set = set()
                    jptr = 0
                    for iptr in range(len(angs)):
                        while jptr < iptr+len(angs) and angs2[jptr] - angs2[iptr] <= width + 1e-12:
                            jptr += 1
                        cnt = jptr - iptr
                        if cnt > maxcnt:
                            maxcnt = cnt
                            best_set = set(js2[iptr:jptr])
                    seen[i] = best_set
                total = sum(len(s) for s in seen)
                bidir = 0
                for i in range(n):
                    for j in seen[i]:
                        if i in seen[j]:
                            bidir += 1
                # each bidirectional pair counted twice (i->j and j->i)
                bidir_pairs = bidir//2
                return total, bidir_pairs
            
            def search_best(n, trials=2000):
                best = -1
                bestb = -1
                bestpts = None
                for _ in range(trials):
                    pts = random_points(n, radius=1.0)
                    total, bidir = count_bidirectional(pts)
                    if total > best:
                        best = total
                        bestb = bidir
