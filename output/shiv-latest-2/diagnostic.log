            def period_mod_n(n, max_iter=1000000):
                # compute sequence modulo n, detect when the last n terms equal the initial n terms (state repeats)
                init = [pow(2, k, n) for k in range(n)]
                state = init[:]
                from collections import deque
                dq = deque(state, maxlen=n)
                sum_window = sum(state) % n
                for step in range(1, max_iter+1):
                    next_val = sum_window % n
                    # update
                    oldest = dq.popleft()
                    sum_window = (sum_window - oldest) % n
                    dq.append(next_val)
                    sum_window = (sum_window + next_val) % n
                    # check if state equals init
                    if list(dq) == init:
                        return step
                return None
            
            print(period_mod_n(100, 2000000))
            
