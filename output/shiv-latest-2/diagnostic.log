            import random, math, cmath, numpy as np, sympy as sp
            
            def circumcenter(D,E,F):
                # Solve linear equations for O = (x,y)
                # (O-D).(E-D) = (O-E).(E-D) ??? Actually we can solve using perpendicular bisectors.
                # Use formula based on determinants.
                # Using numpy linear solve: (O - D).dot(O - D) = (O - E).dot(O - E)
                # => O·O - 2O·D + D·D = O·O - 2O·E + E·E => -2O·D + D·D = -2O·E + E·E
                # => 2O·(E-D) = E·E - D·D
                # Similarly with F.
                D = np.array(D); E = np.array(E); F = np.array(F)
                A = np.vstack([2*(E-D), 2*(F-D)])
                b = np.array([np.dot(E,E)-np.dot(D,D), np.dot(F,F)-np.dot(D,D)])
                O = np.linalg.solve(A, b)
                return O
            
            def incenter(D,E,F):
                # side lengths opposite vertices
                a = np.linalg.norm(E-F)
                b = np.linalg.norm(F-D)
                c = np.linalg.norm(D-E)
                I = (a*D + b*E + c*F)/(a+b+c)
                return I
            
            def rotate90(v):
                return np.array([-v[1], v[0]])
            
            def compute_ratio(D,E,F):
                O = circumcenter(D,E,F)
                I = incenter(D,E,F)
                OI = O - I
                u = rotate90(OI)  # direction vector of line through I perpendicular to OI
                # Solve I + s*u = D + t*(E-D)
                DE = E - D
                # Solve for s,t: I + s*u = D + t*DE
                # => s*u - t*DE = D - I
                A = np.column_stack((u, -DE))
                rhs = D - I
                sol = np.linalg.solve(A, rhs)
                s_M = sol[0]
                # External bisector at F: direction w = rotate90(F - I) (perpendicular to FI)
                w = rotate90(F - I)
                # Solve I + s*u = F + t*w
                A2 = np.column_stack((u, -w))
                rhs2 = F - I
                sol2 = np.linalg.solve(A2, rhs2)
                s_N = sol2[0]
                ratio = abs(s_M)/abs(s_N)
                return ratio
            
            def random_triangle():
                # generate non-collinear points
                while True:
                    D = np.random.rand(2)*10
                    E = np.random.rand(2)*10
                    F = np.random.rand(2)*10
                    # check area not too small
                    area = abs(np.cross(E-D, F-D))
                    if area > 1e-3:
                        return D,E,F
            
            for _ in range(10):
                D,E,F = random_triangle()
                r = compute_ratio(D,E,F)
                print(r)
            
