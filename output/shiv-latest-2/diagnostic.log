            def circumcenter(A,B,C):
                # returns point as sympy Matrix
                A=sp.Matrix(A); B=sp.Matrix(B); C=sp.Matrix(C)
                # using perpendicular bisectors intersection
                # Solve (X - A).dot(A-B) = (X - B).dot(A-B) and (X - A).dot(A-C) = (X - C).dot(A-C)
                x,y=sp.symbols('x y')
                X=sp.Matrix([x,y])
                eq1 = (X - A).dot(B - A) - (X - B).dot(B - A)  # dot product difference zero
                eq2 = (X - A).dot(C - A) - (X - C).dot(C - A)
                sol=sp.solve([eq1,eq2],[x,y], dict=True)
                if not sol:
                    return None
                sol=sol[0]
                return sp.Matrix([sol[x], sol[y]])
            
            def incenter(A,B,C):
                A=sp.Matrix(A); B=sp.Matrix(B); C=sp.Matrix(C)
                a = (B - C).norm()
                b = (A - C).norm()
                c = (A - B).norm()
                I = (a*A + b*B + c*C) / (a+b+c)
                return I
            
            def ratio_general(A,B,C):
                P = circumcenter(A,B,C)
                Q = incenter(A,B,C)
                # line through Q perpendicular to PQ
                PQ = Q - P
                v = sp.Matrix([-PQ[1], PQ[0]])  # rotate 90 deg
                # param t
                t = sp.symbols('t')
                # line L: Q + t v
                # intersect with DE (choose D=A, E=B)
                D = sp.Matrix(A); E = sp.Matrix(B); F = sp.Matrix(C)
                u = sp.symbols('u')
                sol = sp.solve(Q + t*v - (D + u*(E-D)), (t,u), dict=True)
                if not sol:
                    return None
                tM = sol[0][t]
                # external bisector at F (C)
                # unit vectors along FD and FE (pointing away from F)
                FD = D - F
                FE = E - F
                uFD = FD / FD.norm()
                uFE = FE / FE.norm()
                w = uFD + uFE
                w_perp = sp.Matrix([-w[1], w[0]])
                s = sp.symbols('s')
                sol2 = sp.solve(Q + t*v - (F + s*w_perp), (t,s), dict=True)
                if not sol2:
                    return None
                tN = sol2[0][t]
                ratio = sp.simplify(abs(tM)/abs(tN))
                return sp.nsimplify(ratio)
            
