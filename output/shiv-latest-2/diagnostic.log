            def find_solution(d, Qcoeffs, n, R=5):
                # Qcoeffs list of length < d, from degree 0 up to degree d-1
                # Q(x) = sum_{i=0}^{d-1} c_i x^i
                # search for k from 1..n
                # search distinct integers a_i in range [-R,R]
                # return True if found
                # Use brute force limited combos
                # For each k, we need choose k+1 distinct integers
                # We'll iterate over combinations of size k+1 from range and assign one as a_{k+1} (positive)
                # Since order matters (which is distinguished), we can try each element as distinguished.
                # Complexity grows quickly, but for small n,R it's okay.
                xs = list(range(-R, R+1))
                # Precompute Q values for each x
                Qvals = {}
                for x in xs:
                    val = sum(c * (x**i) for i,c in enumerate(Qcoeffs))
                    Qvals[x] = val
                for k in range(1, n+1):
                    # choose k+1 distinct ints
                    for combo in itertools.combinations(xs, k+1):
                        # try each element as distinguished (a_{k+1})
                        for idx in range(k+1):
                            a_pos = combo[idx]
                            others = combo[:idx] + combo[idx+1:]
                            lhs = Qvals[a_pos] - sum(Qvals[a] for a in others)
                            rhs = a_pos**d - sum(a**d for a in others)
                            if lhs == rhs:
