            import math, itertools
            
            def chord_line(i,j):
                # Return line coefficients (A,B,C) for line through points on unit circle
                theta_i = 2*math.pi*i/12
                theta_j = 2*math.pi*j/12
                xi, yi = math.cos(theta_i), math.sin(theta_i)
                xj, yj = math.cos(theta_j), math.sin(theta_j)
                # line in form Ax + By = C (through both points)
                A = yj - yi
                B = xi - xj
                C = A*xi + B*yi
                # Normalize
                norm = math.hypot(A,B)
                A,B,C = A/norm, B/norm, C/norm
                return (round(A,10), round(B,10), round(C,10))
            
