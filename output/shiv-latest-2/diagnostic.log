            def last_nonzero_digit_factorial(n):
                # compute last non-zero digit of n! in base 10
                # using recurrence
                a = [1,1,2,6,4]
                if n==0:
                    return 1
                res = 1
                while n>0:
                    res = (res * a[n%5] * pow(2, n//5, 10)) % 10
                    n //= 5
                return res
            
