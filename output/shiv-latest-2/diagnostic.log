            def generate_solutions(limit=5):
                sols = []
                for a in range(-limit, limit+1):
                    for b in range(1, limit+1):
                        m = Fraction(a, b)
                        # compute X = 2*(30 m^2 - 20 m + 3)/(10 m^2 - 1)
                        num = 2*(30*m*m - 20*m + 3)
                        den = (10*m*m - 1)
                        if den == 0:
                            continue
                        X = Fraction(num, den)
                        # compute Y = m*(X-6)+2
                        Y = m*(X - 6) + 2
                        # ensure X,Y rational (they are Fractions)
                        # Now compute s candidates
                        for sign in [+1, -1]:
                            s = Fraction(1 + sign*X, 5)
                            if s <= 0 or s >= 1:
                                continue
                            # compute r = |Y|
                            r = abs(Y)
                            # compute t = (s+1)/r - 1
                            t = Fraction(s + 1, 1) / r - 1
                            if t < 0 or t > 1:
                                continue
                            # compute x,y
                            x = Fraction(1 - s*s, 2)
                            y = Fraction(1 - t*t, 2)
