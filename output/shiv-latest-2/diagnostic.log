            def closure_contains_target(a,b,target,limit=2000):
                # compute closure of {a,b} under operation, restricted to |value| <= limit
                S = set([a,b])
                changed = True
                while changed:
                    changed = False
                    current = list(S)
                    for x in current:
                        for y in current:
                            # compute xy
                            if x*y == 0:
                                # then expression is x^2 + y^2 (since i*0 =0)
                                val = x*x + y*y
                                if abs(val) <= limit and val not in S:
                                    S.add(val)
                                    changed = True
                                continue
                            mod = abs(x*y)
                            base = x*x + y*y
                            # find smallest k such that value within bound
                            # generate values base + k*mod for k such that |value| <= limit
                            # compute k range
                            k_min = - (limit + abs(base)) // mod - 1
                            k_max = (limit + abs(base)) // mod + 1
                            for k in range(k_min, k_max+1):
                                val = base + k*mod
                                if abs(val) <= limit and val not in S:
                                    S.add(val)
                                    changed = True
                    # early exit if target found
                    if target in S:
                        return True, S
                return (target in S), S
            
