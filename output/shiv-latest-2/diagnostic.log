            import sympy as sp
            import math
            
            def compute_ratio(a_val,b_val,c_val):
                D = sp.Point(0,0)
                E = sp.Point(c_val,0)
                F = sp.Point(a_val,b_val)
                tri = sp.geometry.Triangle(D,E,F)
                O = tri.circumcircle.center
                I = tri.incenter
                # direction perpendicular to OI
                d = sp.Matrix([-(I.y-O.y), I.x-O.x])
                # line L param t
                t = sp.symbols('t')
                # Intersection with DE (y=0)
                tM = sp.solve(sp.Eq(I.y + t*d[1], 0), t)[0]
                # external bisector direction
                vec_DF = sp.Matrix([D.x - F.x, D.y - F.y])
                vec_EF = sp.Matrix([E.x - F.x, E.y - F.y])
                u1 = vec_DF/ sp.sqrt(vec_DF[0]**2 + vec_DF[1]**2)
                u2 = vec_EF/ sp.sqrt(vec_EF[0]**2 + vec_EF[1]**2)
                v_ext = u1 - u2
                # Solve intersection L with external bisector
                s = sp.symbols('s')
                sol = sp.solve([sp.Eq(I.x + t*d[0], F.x + s*v_ext[0]),
                                sp.Eq(I.y + t*d[1], F.y + s*v_ext[1])], (t,s), dict=True)[0]
                tN = sol[t]
                # ratio
                ratio = sp.simplify(abs(tM)/abs(tN))
                return sp.nsimplify(ratio.evalf())
            
