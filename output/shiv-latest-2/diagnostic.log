            def max_zero_run_fast(n, max_steps):
                # maintain deque of last n terms and rolling sum
                from collections import deque
                # initial terms
                seq = [pow(2, k, n) for k in range(n)]
                dq = deque(seq, maxlen=n)
                rolling_sum = sum(seq) % n
                longest = 0
                cur = 0
                for step in range(max_steps):
                    next_term = rolling_sum % n
                    # update longest
                    if next_term == 0:
                        cur += 1
                        if cur > longest:
                            longest = cur
                    else:
                        cur = 0
                    # update rolling sum and deque
                    oldest = dq.popleft()
                    rolling_sum = (rolling_sum - oldest + next_term) % n
                    dq.append(next_term)
                return longest
            
