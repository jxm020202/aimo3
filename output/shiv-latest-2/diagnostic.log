            def price_of_sequence(seq):
                s=0
                maxabs=0
                for a in seq:
                    s+=a
                    maxabs=max(maxabs, abs(s))
                return maxabs
            
            def optimal_price(nums):
                # brute force permutations
                best=math.inf
                for perm in itertools.permutations(nums):
                    best=min(best, price_of_sequence(perm))
                    if best==0:
                        break
                return best
            
            def george_price(nums):
                # return set of possible prices from all tie-breaking choices
                # implement recursive search
                # first choose a1 among numbers with minimal absolute value
                min_abs = min(abs(x) for x in nums)
                candidates = [i for i,x in enumerate(nums) if abs(x)==min_abs]
                prices=set()
                # recursion
                def rec(remaining, seq):
                    if not remaining:
                        prices.add(price_of_sequence(seq))
                        return
                    # compute current partial sum
                    cur_sum = sum(seq)
                    # among remaining numbers, find those minimizing |cur_sum + x|
                    best = min(abs(cur_sum + x) for x in remaining)
                    for i,x in enumerate(remaining):
                        if abs(cur_sum + x) == best:
                            new_rem = remaining[:i]+remaining[i+1:]
                            rec(new_rem, seq+[x])
                for i in candidates:
                    remaining = list(nums)
                    a = remaining.pop(i)
                    rec(remaining, [a])
                return prices
            
            def george_max_price(nums):
                return max(george_price(nums))
            
            def ratio(nums):
                S = optimal_price(nums)
                G = george_max_price(nums)
                return S/G if G!=0 else math.inf
            
