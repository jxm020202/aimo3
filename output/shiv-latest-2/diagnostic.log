            def segments_intersect(p1,p2,q1,q2):
                # check proper intersection (excluding shared endpoints)
                # using orientation
                def orient(a,b,c):
                    return (b.x - a.x)*(c.y - a.y) - (b.y - a.y)*(c.x - a.x)
                o1 = orient(p1,p2,q1)
                o2 = orient(p1,p2,q2)
                o3 = orient(q1,q2,p1)
