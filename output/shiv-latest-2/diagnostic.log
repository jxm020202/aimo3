            def random_point_on_plane():
                # sample (x,y) uniformly in triangle: x>0, y>0, 2x + y < 4
                while True:
                    # bounding box: x in (0,2), y in (0,4)
                    x = random.random()*2  # max x when y=0: 2x<4 => x<2
                    y = random.random()*4
                    if 2*x + y < 4:
                        z = 6 - 3*x - 1.5*y
                        if z>0:
                            return np.array([x,y,z])
            
            def chebyshev_dist(p,q):
                return max(abs(p[0]-q[0]), abs(p[1]-q[1]), abs(p[2]-q[2]))
            
            def random_search(iterations=200000):
                best = 1e9
                best_pair = None
                for _ in range(iterations):
                    p = random_point_on_sphere()
                    q = random_point_on_plane()
                    d = chebyshev_dist(p,q)
                    if d < best:
                        best = d
                        best_pair = (p,q)
                return best, best_pair
            
            best, pair = random_search(200000)
            best, pair[:2]
            
