                # Solve X + λ d1 = Z + μ d2
                lam, mu = sp.symbols('lam mu')
                eqs = [
                    sp.Eq(2 + lam*d1[0], Z.x + mu*d2[0]),
                    sp.Eq(0 + lam*d1[1], Z.y + mu*d2[1])
