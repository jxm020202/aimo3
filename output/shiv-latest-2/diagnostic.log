            def max_zero_run_until_correct(n, max_terms, target_run=None):
                # generate sequence modulo n up to max_terms (1-indexed)
                a = [pow(2, k, n) for k in range(n)]  # a[0] = a_1, ..., a[n-1] = a_n
                # compute a_{n+1}
                a.append(sum(a) % n)  # a[n] corresponds to term n+1
                # track longest run
                longest = 0
                cur = 0
                for val in a:
                    if val == 0:
                        cur += 1
                        longest = max(longest, cur)
                    else:
                        cur = 0
                # now use recurrence a_{k+1} = 2 a_k - a_{k-n}
                # we have a list with indices 0..len-1 representing terms 1..len
                from collections import deque
                # maintain a deque of last n+1 terms? Actually we need a_{k-n} and a_k.
                # We'll keep a deque of length n+1: from a_{k-n} to a_k inclusive.
                window = deque(a[-(n+1):], maxlen=n+1)  # contains a_{k-n},...,a_k
                # current index k corresponds to last element in window (a_k)
                for idx in range(n+1, max_terms):  # idx is term index (1-indexed) of a_{idx}
                    a_k = window[-1]
                    a_k_n = window[0]  # a_{k-n}
                    next_val = (2 * a_k - a_k_n) % n
                    # update longest
                    if next_val == 0:
                        cur += 1
                        longest = max(longest, cur)
                        if target_run is not None and longest >= target_run:
                            return longest, idx+1  # next term index
                    else:
                        cur = 0
                    # slide window
                    window.append(next_val)
                return longest, None
            
