            def find_periodic_solutions(d):
                sols = []
                import itertools, collections
                # iterate over y mapping: list of length d with values 0..d-1
                for y in itertools.product(range(d), repeat=d):
                    # compute A(r) = y[ y[r] ]
                    A = [ y[ y[r] ] for r in range(d) ]
                    # compute C_r = (1 - (y[A(r)] - y[(r+1)%d])) // d
                    C = []
                    ok = True
                    for r in range(d):
                        delta = y[ A[r] ] - y[(r+1)%d]
                        # need delta ≡ 1 mod d
                        if (delta - 1) % d != 0:
                            ok = False
                            break
                        Cr = (1 - delta) // d  # integer
                        C.append(Cr)
                    if not ok:
                        continue
                    # Build graph constraints: k_{A(r)} - k_{r+1} = C[r]
                    # We'll treat edges: from r+1 to A(r) with weight C[r]
                    adj = collections.defaultdict(list)
                    for r in range(d):
                        u = (r+1)%d
                        v = A[r]
                        w = C[r]  # k_v = k_u + w
                        adj[u].append((v, w))
                        adj[v].append((u, -w))  # reverse
                    # assign k values via BFS
                    k = [None]*d
                    consistent = True
                    for start in range(d):
                        if k[start] is not None:
                            continue
                        k[start] = 0
                        stack = [start]
                        while stack and consistent:
                            cur = stack.pop()
                            for nxt, w in adj[cur]:
                                if k[nxt] is None:
                                    k[nxt] = k[cur] + w
                                    stack.append(nxt)
                                else:
                                    if k[nxt] != k[cur] + w:
                                        consistent = False
                                        break
                        if not consistent:
                            break
                    if not consistent:
                        continue
                    # Now we have k values up to additive constant per component.
                    # Shift to make all >=0
                    min_k = min([val for val in k if val is not None])
                    shift = -min_k
                    k = [val + shift if val is not None else None for val in k]
                    # Now compute x_i = d*k_i + y_i
                    x = [d*k[i] + y[i] for i in range(d)]
                    # verify original periodic condition for residues
                    ok2 = True
                    for r in range(d):
