            import math, random
            
            def distance_point_line(px, py, x1, y1, x2, y2):
                # distance from point (px,py) to line through (x1,y1)-(x2,y2)
                # formula |(y2-y1)*px - (x2-x1)*py + x2*y1 - y2*x1| / sqrt((y2-y1)^2 + (x2-x1)^2)
                return abs((y2-y1)*px - (x2-x1)*py + x2*y1 - y2*x1) / math.hypot(y2-y1, x2-x1)
            
            def test(a,b,h):
                x0 = (b - a)/2
                P = (x0, h)
                Q = (x0 + a, h)
                R = (0,0)
                S = (b,0)
