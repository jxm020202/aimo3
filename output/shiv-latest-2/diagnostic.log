            def numeric_ratio_using_I_D(alpha,beta,gamma):
                d = np.array([math.cos(alpha), math.sin(alpha)])
                e = np.array([math.cos(beta), math.sin(beta)])
                f = np.array([math.cos(gamma), math.sin(gamma)])
                a = np.linalg.norm(e-f)  # opposite D
                b = np.linalg.norm(f-d)  # opposite E
                c = np.linalg.norm(d-e)  # opposite F
                I = (a*d + b*e + c*f)/(a+b+c)
                # line L: through I perpendicular to OI (O=0)
                # direction vector = rotate 90 deg of I
                dir_L = np.array([-I[1], I[0]])  # J I
                # Intersection with DE
                # Solve d + s*(e-d) = I + t*dir_L
                A = np.column_stack((e-d, -dir_L))
                bvec = I - d
                sol = np.linalg.lstsq(A, bvec, rcond=None)[0]
                s, t = sol
                M = d + s*(e-d)
                QM = np.linalg.norm(M - I)
                # excenter opposite D (I_D)
                I_D = (-a*d + b*e + c*f)/(-a + b + c)
                # line through F and I_D
                dir_F = I_D - f
