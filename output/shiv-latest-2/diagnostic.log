            import sympy as sp
            
            def polygon_convex(points):
                # points list in order, closed polygon
                n = len(points)
                # compute cross product z component of edges (p_i->p_{i+1}) x (p_{i+1}->p_{i+2})
                signs = []
                for i in range(n):
                    p0 = sp.Point(points[i])
                    p1 = sp.Point(points[(i+1)%n])
                    p2 = sp.Point(points[(i+2)%n])
                    v1 = sp.Matrix([p1.x-p0.x, p1.y-p0.y])
                    v2 = sp.Matrix([p2.x-p1.x, p2.y-p1.y])
                    cross = v1[0]*v2[1] - v1[1]*v2[0]
                    signs.append(sp.sign(cross))
