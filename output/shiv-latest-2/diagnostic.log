            def max_zero_run_n(n, max_terms=500000):
                a = [pow(2, k, n) for k in range(n)]
                max_run = 0
                cur_run = 0
                for val in a:
                    if val % n == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # Use sliding window sum to compute efficiently
                # maintain sum of last n terms modulo n
                window_sum = sum(a) % n
                for k in range(n, max_terms):
                    next_val = window_sum % n
                    # update sliding window
                    # remove a[-n] (the term leaving window) and add next_val
                    out_val = a[-n]
                    window_sum = (window_sum - out_val + next_val) % n
                    a.append(next_val)
                    if next_val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                return max_run
            
