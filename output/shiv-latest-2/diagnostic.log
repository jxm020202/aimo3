            def max_zero_run_n_fast(n, max_steps=5000000):
                # compute initial terms a_1..a_n = 2^{k-1} mod n
                a = [pow(2, k, n) for k in range(n)]  # a[0]=a1
                max_run = cur_run = 0
                # check initial terms
                for val in a:
                    if val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                # sliding window sum
                from collections import deque
                window = deque(a, maxlen=n)
                window_sum = sum(window) % n
                # iterate
                for step in range(max_steps):
                    next_val = window_sum % n
                    # update run
                    if next_val == 0:
                        cur_run += 1
                        max_run = max(max_run, cur_run)
                    else:
                        cur_run = 0
                    # update sliding window and sum
                    oldest = window.popleft()
                    window.append(next_val)
                    window_sum = (window_sum - oldest + next_val) % n
                return max_run
            
