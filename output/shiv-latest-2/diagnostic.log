                v = (math.cos(theta), math.sin(theta))
                # Choose a perpendicular direction w
                w = (-v[1], v[0])
                # Choose offset distance from center along v (distance from center to midpoint of chord)
                d = offset  # 0 to 1
                # chord length = 2*sqrt(1 - d^2) (since chord at distance d from center)
                L = 2*math.sqrt(max(0,1-d*d))
                # place points equally spaced along chord from -L/2 to +L/2 in w direction
                pts=[]
                for k in range(n):
                    t = -L/2 + L * k/(n-1) if n>1 else 0
                    x = d*v[0] + t*w[0]
                    y = d*v[1] + t*w[1]
                    pts.append((x,y))
                return pts
            
            def test_chord(offset):
                pts = points_on_chord(100, offset=offset)
                return total_sum(pts)
            
            for off in [0,0.2,0.5,0.8,0.9]:
                print(off, test_chord(off))
            
