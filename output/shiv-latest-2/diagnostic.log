            import itertools, collections, math
            
            def is_injective(N, C, m):
                # assign each column a distinct vector of length m with entries 0..C
                # use base representation of numbers 0..C**m-1
                vectors = []
                for i in range(N):
                    # represent i in base (C+1) with m digits
                    v = []
                    x = i
                    for _ in range(m):
                        v.append(x % (C+1))
                        x //= (C+1)
                    vectors.append(tuple(v))
                # compute sums for all subsets size>=2
                sums = {}
                for mask in range(1<<N):
                    if bin(mask).count('1') < 2:
                        continue
                    s = [0]*m
                    for i in range(N):
                        if mask>>i &1:
                            for j in range(m):
                                s[j] += vectors[i][j]
                    s = tuple(s)
                    if s in sums:
                        return False, (mask, sums[s])
                    sums[s]=mask
                return True, None
            
            for N in range(2,10):
                ok,_=is_injective(N,2,3)
                print(N, ok)
            
