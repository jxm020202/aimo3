            import random, math
            def compute_ratio(Lval, uval, vval):
                a = math.hypot(uval - Lval, vval)
                b = math.hypot(uval, vval)
                # O
                Ox = Lval/2
                Oy = (uval**2 - Lval*uval + vval**2)/(2*vval)
                # I
                denom = a + b + Lval
                Ix = Lval*(b + uval)/denom
                Iy = Lval*vval/denom
                # direction d perpendicular to OI
                dx = -(Iy - Oy)
                dy = Ix - Ox
                # t_M
                tM = -Iy / dy
                # external bisector direction e
                # unit vectors
                v1 = (-uval, -vval)
                v2 = (Lval - uval, -vval)
                b_len = b
                a_len = a
