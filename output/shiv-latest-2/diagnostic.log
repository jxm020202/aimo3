            from collections import deque
            
            def max_zero_run_circular(n, max_steps):
                # initialize buffer with first n terms
                buffer = deque([pow(2, k, n) for k in range(n)], maxlen=n)
                window_sum = sum(buffer) % n
                max_run = cur = 0
                # check initial terms
                for val in buffer:
                    if val == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                # generate further terms
                for step in range(n, max_steps):
                    new_val = window_sum % n
                    # update run
                    if new_val == 0:
                        cur += 1
                        max_run = max(max_run, cur)
                    else:
                        cur = 0
                    # update sliding sum: add new_val, subtract oldest
                    oldest = buffer[0]  # leftmost
                    window_sum = (window_sum + new_val - oldest) % n
                    # push new_val into buffer (automatically discards oldest)
                    buffer.append(new_val)
                return max_run
            
            # test for 30 million again
