            def u_of_x(x):
                sqrt_term = mp.sqrt(1 - 2*x)
                term = (4*x - 2 + 2*sqrt_term) / (3 - 5*x - sqrt_term)
                inner_sqrt = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                A_plus = (1 + x**2)/2 + (1/6)*inner_sqrt
                A_minus = (1 + x**2)/2 - (1/6)*inner_sqrt
                C1 = mp.sign(A_plus) * abs(A_plus)**(1/3)
                C2 = mp.sign(A_minus) * abs(A_minus)**(1/3)
                u = C1 + C2
                return term + u  # this is f(x)
            
            def u_sum_only(x):
                inner_sqrt = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)
                A_plus = (1 + x**2)/2 + (1/6)*inner_sqrt
                A_minus = (1 + x**2)/2 - (1/6)*inner_sqrt
                C1 = mp.sign(A_plus) * abs(A_plus)**(1/3)
                C2 = mp.sign(A_minus) * abs(A_minus)**(1/3)
                return C1 + C2
            
