            def achievable_sums(a, p):
                # returns set of achievable sums for subsets of size a from numbers 1..200 excluding p
                nums = [i for i in range(1,201) if i != p]
                # DP using set of sums for each size
                dp = [set() for _ in range(a+1)]
                dp[0].add(0)
                for num in nums:
                    for k in range(min(a, len(nums)), 0, -1):
                        for s in dp[k-1]:
                            dp[k].add(s+num)
                return dp[a]
            
