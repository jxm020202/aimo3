            def minimal_separating_set_size(n):
                # generate all independent sets of size >=2
                # use DP to generate list of sets (as bitmask of n*n cells)
                # but for n up to maybe 5, total independent sets manageable.
                total_cells = n*n
                # generate all subsets via recursion with pruning using adjacency constraints
                # We'll use backtracking row by row similar to DP but also store sets.
                # For small n, we can just generate all independent sets using DP storing masks per row.
                valid_row_masks = [mask for mask in range(1<<n) if (mask & (mask<<1))==0]
                compat = {}
                for m1 in valid_row_masks:
                    compat[m1]=[]
                    for m2 in valid_row_masks:
                        if m1 & m2: continue
                        if (m1<<1) & m2: continue
                        if (m1>>1) & m2: continue
                        compat[m1].append(m2)
                # DP storing list of sets as integer mask of total cells
                dp = {0: [0]}  # prev_mask -> list of sets (bitmask)
                for row in range(n):
                    newdp = {}
                    for prev_mask, sets in dp.items():
                        for cur_mask in valid_row_masks:
                            if cur_mask not in compat[prev_mask]:
                                continue
                            # compute bitmask for whole board: shift cur_mask by row*n bits
                            cur_bits = cur_mask << (row*n)
                            for s in sets:
                                newmask = s | cur_bits
                                newdp.setdefault(cur_mask, []).append(newmask)
                    dp = newdp
                # collect all independent sets
                indep_sets = set()
                for mask, lst in dp.items():
                    indep_sets.update(lst)
                # filter size >=2
                indep_sets = [s for s in indep_sets if bin(s).count('1')>=2]
                total = len(indep_sets)
                print(f"n={n}, total independent sets >=2: {total}")
                # Now we need minimal separating set size.
                # Brute force search over subsets of cells (up to maybe total_cells)
                from itertools import combinations
                for m in range(1, total_cells+1):
                    # iterate all subsets of size m
                    for Q in combinations(range(total_cells), m):
                        # compute pattern for each independent set
                        patterns = {}
                        ok=True
                        for s in indep_sets:
                            # pattern is tuple of bits for each q in Q
                            pat = tuple( (s>>q)&1 for q in Q )
                            if pat in patterns:
                                ok=False
                                break
                            patterns[pat]=s
                        if ok:
                            return m
                return None
            
            for n in range(2,5):
                print(minimal_separating_set_size(n))
            
