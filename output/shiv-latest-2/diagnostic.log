            def excenter_opposite_F(D,E,F):
                # opposite vertex F: excenter opposite C in triangle D,E,F
                # side lengths: a = DE opposite F, b = EF opposite D, c = FD opposite E
                D_arr = np.array(D); E_arr = np.array(E); F_arr = np.array(F)
                a = np.linalg.norm(D_arr - E_arr)  # opposite F
                b = np.linalg.norm(E_arr - F_arr)  # opposite D
                c = np.linalg.norm(F_arr - D_arr)  # opposite E
                # excenter opposite F has barycentric (a:b:-c?) Wait formula: excenter opposite C has coordinates (a:b:-c)
                # For vertex C (here F), opposite side is c? Actually standard: triangle ABC, side a = BC opposite A, b = CA opposite B, c = AB opposite C.
                # Excenter opposite C has barycentric (a:b:-c)
                # So for triangle D (A), E (B), F (C):
                # a = |EF| opposite D, b = |FD| opposite E, c = |DE| opposite F.
                # So excenter opposite F (C) has barycentric (a:b:-c) where a=|EF|, b=|FD|, c=|DE|.
                a = np.linalg.norm(E_arr - F_arr)  # opposite D (A)
                b = np.linalg.norm(F_arr - D_arr)  # opposite E (B)
                c = np.linalg.norm(D_arr - E_arr)  # opposite F (C)
                # excenter opposite F (C) => (a:b:-c)
                num = a*np.array(D_arr) + b*np.array(E_arr) - c*np.array(F_arr)
                den = a + b - c
                return num/den
            
