            from scipy.optimize import linprog
            
            def min_t_for_q(q):
                # variables: p1,p2,p3,t
                # objective: minimize t
                c = [0,0,0,1]  # coefficients for p1,p2,p3,t
                # constraints:
                # 6p1+3p2+2p3 = 12 -> two inequalities: <=12 and >=12
                A_eq = [[6,3,2,0]]
                b_eq = [12]
                # positivity: p_i >= 0
                bounds = [(0, None), (0, None), (0, None), (0, None)]  # t >=0
                # L∞ constraints: p_i - q_i <= t and -(p_i - q_i) <= t
                # p_i - q_i - t <= 0
                # -p_i + q_i - t <= 0
                A_ub = []
                b_ub = []
                for i in range(3):
                    coeff = [0,0,0,0]
                    coeff[i] = 1   # p_i
                    coeff[3] = -1  # -t
                    A_ub.append(coeff)
                    b_ub.append(q[i])
                    # -p_i - t <= -q_i? Actually -p_i + q_i - t <=0 => -p_i - t <= -q_i
                    coeff2 = [0,0,0,0]
                    coeff2[i] = -1
                    coeff2[3] = -1
                    A_ub.append(coeff2)
                    b_ub.append(-q[i])
                # Now solve
                res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
                if not res.success:
                    return None
                return res.x[3]  # t
            
