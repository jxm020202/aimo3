            import sympy as sp
            
            # define symbols
            b, alpha, xs, ys = sp.symbols('b alpha xs ys', positive=True, real=True)
            
            # define points
            P = sp.Point(0,0)
            Q = sp.Point(1,0)
            R = sp.Point(b*sp.cos(alpha), b*sp.sin(alpha))
            S = sp.Point(xs, ys)
            
            # function to compute circumcenter of triangle given three points
            def circumcenter(A, B, C):
                # Solve equations |O-A|^2 = |O-B|^2, |O-A|^2 = |O-C|^2
                Ox, Oy = sp.symbols('Ox Oy', real=True)
                O = sp.Point(Ox, Oy)
                eq1 = O.distance(A)**2 - O.distance(B)**2
                eq2 = O.distance(A)**2 - O.distance(C)**2
                sol = sp.solve([sp.simplify(eq1), sp.simplify(eq2)], (Ox, Oy), dict=True)
                # there may be one solution
                return sp.Point(sol[0][Ox], sol[0][Oy])
            
            # compute O1 = circumcenter of triangle PQR
            O1 = circumcenter(P, Q, R)
            O1_simplified = sp.simplify(O1)
            O1_simplified
            
