            from collections import deque
            
            def neighbors(r):
                # r is a rational as tuple (p,q) reduced
                p,q = r
                # generate -r, 1-r, 1/r
                # -r:
                yield (-p, q)
                # 1 - r = (q-p)/q
                yield (q-p, q)
                # 1/r = (q, p) if p != 0
                if p != 0:
                    yield (q, p)
            
            def normalize(p,q):
                # reduce fraction, keep denominator positive
                if q < 0:
                    p, q = -p, -q
                g = math.gcd(p,q)
                p //= g
                q //= g
                return (p,q)
            
            def bfs(start, target, max_depth=10):
                start = normalize(*start)
                target = normalize(*target)
                visited = {start:0}
                q = deque([start])
                while q:
                    cur = q.popleft()
                    d = visited[cur]
                    if cur == target:
                        return d
                    if d >= max_depth:
                        continue
                    for nb in neighbors(cur):
                        nb = normalize(*nb)
                        if nb not in visited:
                            visited[nb] = d+1
                            q.append(nb)
                return None
            
