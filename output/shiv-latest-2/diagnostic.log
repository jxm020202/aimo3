                return [ -r, 1 - r, Fraction(1, r) if r != 0 else None ]
            
            def bfs(start, target, max_depth=10):
                start = Fraction(start)
                target = Fraction(target)
                queue = deque()
                queue.append((start, 0))  # (value, distance)
                visited = {start}
                while queue:
                    cur, d = queue.popleft()
                    if cur == target:
                        return d
                    if d >= max_depth:
                        continue
                    for nb in neighbors(cur):
                        if nb is None:
                            continue
                        if nb not in visited:
                            visited.add(nb)
                            queue.append((nb, d+1))
                return None
            
            start = Fraction(11,3)
            targets = [Fraction(7,3), Fraction(11,4), Fraction(2024,5), Fraction(109,11), Fraction(3,71), Fraction(5,204)]
            for t in targets:
                d = bfs(start, t, max_depth=15)
                print(t, d)
            
