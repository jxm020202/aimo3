                        # ensure distinct
                        if len(set(combo)) != k+1:
                            continue
                        # treat first as b, rest as a_i
                        bb = combo[0]
                        ais = combo[1:]
                        if R(bb) == sum(R(ai) for ai in ais):
                            return True, (k, bb, ais)
                return False, None
            
