            def refine(A0,B0,steps=1000,lr=0.01):
                # simple gradient-free hill climbing: random perturb
                A = np.array(A0)
                B = np.array(B0)
                best = chebyshev_dist(A,B)
                for _ in range(steps):
                    # perturb A on sphere: small random direction then renormalize
                    v = np.random.normal(size=3)
                    v = v/np.linalg.norm(v)*0.01
                    A_new = A + v
                    A_new = A_new/np.linalg.norm(A_new)
                    # perturb B within triangle: small random barycentric shift
                    # Represent B as barycentric coordinates (u,v,w)
                    # We'll compute barycentric from B: solve linear system
                    V1 = np.array([2.0,0.0,0.0])
                    V2 = np.array([0.0,4.0,0.0])
                    V3 = np.array([0.0,0.0,6.0])
                    # Solve for barycentric (u,v,w) such that B = u*V1+v*V2+w*V3, u+v+w=1, u,v,w>=0
                    # Since V1,V2,V3 are orthogonal axes, barycentric is simply:
                    u = B[0]/2.0
                    v = B[1]/4.0
