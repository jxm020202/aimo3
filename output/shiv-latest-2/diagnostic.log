            def max_spread(points):
                # points list of (x,y)
                max_spread = 0
                for i, p in enumerate(points):
                    angles = []
                    for j, q in enumerate(points):
                        if i==j: continue
                        dx = q[0]-p[0]
                        dy = q[1]-p[1]
                        ang = math.atan2(dy, dx)  # -pi to pi
                        angles.append(ang)
                    # compute angular spread minimal interval covering all angles?
                    # We need minimal angular interval that contains all angles; compute max gap.
                    # Sort angles
                    angles.sort()
                    # duplicate with +2pi for circular
                    angles2 = angles + [a+2*math.pi for a in angles]
                    # Find minimal covering interval length = min over i of (angles2[i+len-1] - angles2[i])
                    n = len(angles)
                    min_len = 2*math.pi
                    for i in range(n):
                        length = angles2[i+n-1] - angles2[i]
                        if length < min_len:
                            min_len = length
                    # spread = min_len (the smallest arc covering all points)
                    max_spread = max(max_spread, min_len)
                return max_spread
            
            def generate_arc_points(n, R=1.0, alpha=math.radians(90)):
                # generate n points equally spaced on arc from -alpha/2 to +alpha/2
                points = []
                for k in range(n):
                    theta = -alpha/2 + alpha * k/(n-1) if n>1 else 0
                    x = R*math.cos(theta)
                    y = R*math.sin(theta)
                    points.append((x,y))
                return points
            
