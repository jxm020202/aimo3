            import itertools, math, sys, time, numpy as np, math, collections, itertools, sys, random, math, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def generate_independent_sets_n(n, min_size=2):
                vertices=[(i,j) for i in range(n) for j in range(n)]
                adj = {v:set() for v in vertices}
                for i in range(n):
                    for j in range(n):
                        v=(i,j)
                        for di in (-1,0,1):
                            for dj in (-1,0,1):
                                if di==0 and dj==0: continue
                                ni=i+di; nj=j+dj
                                if 0<=ni<n and 0<=nj<n:
                                    adj[v].add((ni,nj))
                indep=[]
                # backtrack
                def backtrack(start, current, forbidden):
                    if len(current)>=min_size:
                        indep.append(set(current))
                    for idx in range(start, len(vertices)):
                        v=vertices[idx]
                        if v in forbidden:
                            continue
                        new_forbidden = forbidden.union(adj[v])
                        new_forbidden.add(v)
                        backtrack(idx+1, current+[v], new_forbidden)
                backtrack(0, [], set())
                return indep
            
            def minimal_separating_set_milp(n):
                indep = generate_independent_sets_n(n, min_size=2)
                vertices=[(i,j) for i in range(n) for j in range(n)]
                V=len(vertices)
                # map vertex to index
                v2i={v:i for i,v in enumerate(vertices)}
                # constraints: for each pair, sum_{v in symdiff} x_v >= 1
                pairs=[]
                for i in range(len(indep)):
                    for j in range(i+1,len(indep)):
                        pairs.append((indep[i], indep[j]))
                m=len(pairs)
                # Build constraint matrix A (m x V)
                A = np.zeros((m, V), dtype=int)
                for pi,(Aset,Bset) in enumerate(pairs):
                    sym = Aset.symmetric_difference(Bset)
                    for v in sym:
                        A[pi, v2i[v]] = 1
                # objective: minimize sum x
                c = np.ones(V)
                # bounds: 0 <= x <= 1 integer
                bounds = Bounds(0, 1)
                # linear constraints: A x >= 1
                lin_con = LinearConstraint(A, np.ones(m), np.full(m, np.inf))
                # solve MILP
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=np.arange(V))
                if not res.success:
                    print("MILP failed")
                    return None
                x = np.round(res.x).astype(int)
                selected = [vertices[i] for i in range(V) if x[i]==1]
                return len(selected), selected
            
