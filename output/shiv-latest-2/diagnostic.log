                    # For word building, we can multiply on the left or right; parity not affected. Let's just multiply on left: newM = g * M.
                    a,b,c,d = M
                    e,f,g2,h = g
                    # matrix multiplication: g * M
                    M = (e*a + f*c, e*b + f*d, g2*a + h*c, g2*b + h*d)
                return M
            
