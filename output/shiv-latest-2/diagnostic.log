                # returns True if frac is a perfect square of rational (i.e., numerator and denominator are perfect squares)
                num = frac.numerator
                den = frac.denominator
                # check perfect squares
                sqrt_num = int(math.isqrt(num))
                sqrt_den = int(math.isqrt(den))
                return sqrt_num*sqrt_num == num and sqrt_den*sqrt_den == den
            
            solutions = []
            max_den = 20
            for a_num in range(0, max_den+1):
                for a_den in range(1, max_den+1):
                    a = Fraction(a_num, a_den)
                    if a < 0 or a > 1:
                        continue
                    # compute D = 5 a^2 - 2a + 1
                    D = 5*a*a - 2*a + 1
                    # check D/2 is rational square
                    if D % 2 == 0:
                        # D is integer multiple? Actually D is Fraction; we need D/2
                        D2 = D / 2
                        if is_rational_square(D2):
                            # compute s = sqrt(D/2)
                            # s rational = sqrt(D2)
                            # compute b = -1 + (a+1)/s
                            # compute s rational as sqrt of fraction
                            # get sqrt numerator and denominator
                            num = D2.numerator
                            den = D2.denominator
                            s = Fraction(int(math.isqrt(num)), int(math.isqrt(den)))
                            # ensure s*s == D2
                            if s*s != D2:
                                continue
                            # compute b
                            b = Fraction(-1,1) + Fraction(a+1,1) / s
                            # check b in [0,1]
                            if b < 0 or b > 1:
                                continue
                            # compute x,y
                            x = Fraction(1,1) - a*a
                            x = x/2
                            y = Fraction(1,1) - b*b
                            y = y/2
                            # ensure positive
                            if x <= 0 or y <= 0:
                                continue
                            # compute denominators
                            kx = x.denominator
                            ky = y.denominator
                            k = max(kx, ky)  # Actually need k such that kx and ky integers => k must be multiple of both denominators, minimal is lcm
                            k = math.lcm(kx, ky)
                            solutions.append((k, a, b, x, y))
            len(solutions)
            
