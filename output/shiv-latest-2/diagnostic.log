            def ratio(xs):
                S = sum(xs)
                G = math.gcd(xs[0], xs[1])
                for x in xs[2:]:
                    G = math.gcd(G, x)
                # compute T
                T = 0
                n = len(xs)
                for i in range(n):
                    a = xs[i]
                    b = xs[(i+1)%n]
                    c = xs[(i+2)%n]
                    g = math.gcd(a, b)
                    l = (b*c)//math.gcd(b,c)  # lcm(b,c)
                    T += g * l
                # ratio as rational
                return fractions.Fraction(S**3, G * T)
            
