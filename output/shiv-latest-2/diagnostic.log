                F = B[0]**2 + B[1]**2 - A[0]**2 - A[1]**2
                G = 2*(C[0]-A[0])
                H = 2*(C[1]-A[1])
                I = C[0]**2 + C[1]**2 - A[0]**2 - A[1]**2
                mat = np.array([[D,E],[G,H]])
                sol = np.linalg.solve(mat, np.array([F,I]))
                return sol
            
            def orthocenter(A,B,C):
