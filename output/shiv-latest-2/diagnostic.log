            def has_zero_mod_exact(p):
                if p == 2:
                    # compute a_n mod 2: a_n = 8*6^{n-1}+2^{n}+3^{n-1}-1
                    # 8*6^{n-1} is even (multiple of 8)
                    # 2^{n} is even
                    # 3^{n-1} mod 2 = 1^{...}=1
                    # So a_n mod 2 = (0+0+1-1) mod 2 = 0
                    # So a_n ≡ 0 mod 2 for all n >=1. So p=2 divides all terms.
                    return True
                if p == 3:
                    # compute a_n mod 3:
                    # 8*6^{n-1} = 8*(0)^{...} mod 3? 6 ≡ 0 mod 3, so 6^{n-1} ≡ 0 for n>=2, but for n=1, 6^{0}=1.
                    # Let's compute directly: a_1=10 ≡ 1 mod 3, a_2=54 ≡ 0 mod 3, etc. So there exists n with a_n ≡ 0 mod 3.
