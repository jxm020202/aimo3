            def generate_independent_sets(n):
                cells=[(i,j) for i in range(n) for j in range(n)]
                N=n*n
                # adjacency list: for each cell, set of cells that cannot be together
                adj=[set() for _ in range(N)]
                for i in range(N):
                    r1,c1=cells[i]
                    for j in range(N):
                        if i==j: continue
                        r2,c2=cells[j]
                        if max(abs(r1-r2),abs(c1-c2))<=1:
                            adj[i].add(j)
                # backtrack
                indep_sets=[]
                def backtrack(start, chosen):
                    # chosen is list of indices
                    # ensure at least 2 at final
                    for i in range(start, N):
                        # check compatibility
                        ok=True
                        for c in chosen:
                            if i in adj[c]:
                                ok=False
                                break
                        if not ok:
                            continue
                        # include i
                        chosen.append(i)
                        # continue recursion
                        backtrack(i+1, chosen)
                        chosen.pop()
                    # add current set if size>=2
                    if len(chosen)>=2:
                        indep_sets.append(set(chosen))
                backtrack(0, [])
                return indep_sets
            
