            def search_sequences(M, N, max_val):
                # M = a0
                a = [None]*(N+1)  # we will store up to index N
                a[0]=M
                # We'll use recursion to assign values as needed.
                # We'll keep a dict for assigned values (list a with None for unknown)
                solutions=[]
                # Predefine max index we may need: indices up to maybe max(N, M, max_val) but we can allocate larger.
                # We'll treat unknown indices beyond current length by extending list.
                def ensure_length(idx):
                    if idx >= len(a):
                        a.extend([None]*(idx - len(a) + 1))
                def backtrack(idx):
                    # idx is the smallest p for which equation not yet processed (i.e., we need to ensure equation for p)
                    # We'll process p from 0 up to N-1 sequentially.
                    if idx > N-1:
                        # all equations up to N-1 satisfied
                        solutions.append(a[:N+1])
                        return
                    # Ensure needed indices exist
                    # Need a[p], a[a[p]], a[a[a[p]]], a[p+1]
                    # Ensure a[p] defined
                    if a[idx] is None:
                        # assign possible values within 0..max_val
                        for val in range(0, max_val+1):
                            a[idx]=val
                            # proceed to process equation after assignment
                            # but we need to ensure a[a[p]] etc defined later
                            # We'll just continue recursion after setting, but may need to assign later.
                            backtrack(idx)  # reprocess same idx after assignment
                            a[idx]=None
                        return
                    # Now a[idx] defined
                    ap = a[idx]
                    # Ensure a[ap] defined
                    ensure_length(ap)
                    if a[ap] is None:
                        for val in range(0, max_val+1):
                            a[ap]=val
                            backtrack(idx)
                            a[ap]=None
                        return
                    aap = a[ap]
                    # Ensure a[aap] defined
                    ensure_length(aap)
                    if a[aap] is None:
                        for val in range(0, max_val+1):
                            a[aap]=val
                            backtrack(idx)
                            a[aap]=None
                        return
                    # Now we can compute RHS: a[p+1] = a[a[a[p]]] - 1
                    rhs = a[aap] - 1
                    if rhs < 0:
                        return  # invalid
                    # Ensure a[p+1] defined and consistent
                    ensure_length(idx+1)
                    if a[idx+1] is None:
                        a[idx+1]=rhs
                        backtrack(idx+1)
                        a[idx+1]=None
                    else:
                        if a[idx+1]==rhs:
                            backtrack(idx+1)
                        else:
                            return
                backtrack(0)
                return solutions
            
