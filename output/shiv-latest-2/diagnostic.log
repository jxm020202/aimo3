            def find_period(mod, order, max_steps=500000):
                # compute sequence modulo mod, return period length after initial transient
                a = [pow(2, k, mod) for k in range(order)]
                from collections import deque
                window = deque(a, maxlen=order)
                seen = {}
                # state is tuple of current window
                state = tuple(window)
                seen[state] = 0
                for step in range(1, max_steps+1):
                    next_val = sum(window) % mod
                    window.append(next_val)
                    state = tuple(window)
                    if state in seen:
                        return step - seen[state]
                return None
            
