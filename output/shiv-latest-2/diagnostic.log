            def num_cycles(m):
                if m % 3 == 0:
                    return None
                visited = [False] * m  # indices 0..m-1
                cycles = 0
                for x in range(1, m):
                    if not visited[x]:
                        # start new cycle
                        cycles += 1
                        y = x
                        while not visited[y]:
                            visited[y] = True
                            y = (3*y) % m
                return cycles
            
