            from collections import deque
            
            def generate_neighbors(r):
                # r is Fraction
                # apply a,b,c
                return [ -r, 1 - r, Fraction(1, r) if r != 0 else None ]
            
            def bfs(limit_steps=6):
                base = Fraction(11,3)
                color = {base: 1}
                queue = deque([base])
                steps = {base:0}
                while queue:
                    r = queue.popleft()
                    step = steps[r]
                    if step >= limit_steps:
                        continue
                    for nb in generate_neighbors(r):
                        if nb is None:
                            continue
                        # color opposite
                        col = 1 - color[r]
                        if nb in color:
                            if color[nb] != col:
                                raise ValueError("Inconsistent")
                        else:
                            color[nb] = col
                            steps[nb] = step+1
                            queue.append(nb)
                return color
            
