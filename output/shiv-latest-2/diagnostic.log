            import random, math, numpy as np
            
            def compute_angle(a,b,c,d,theta):
                t = math.cos(theta)
                # define basis vectors u=(1,0), v=(cosθ, sinθ)
                u = np.array([1.0, 0.0])
                v = np.array([math.cos(theta), math.sin(theta)])
                w = a * u
                y = -b * u
                x = c * v
                z = -d * v
                # Solve for n: linear equations n·(x-w) = (c^2 - a^2)/2, n·(z-y) = (d^2 - b^2)/2
                A = np.column_stack((x - w, z - y))  # 2x2 matrix where columns are vectors (x-w) and (z-y)
                # Actually we need to solve for n such that dot(n, v_i) = rhs_i. This is linear in n.
                # Represent unknown n = (nx, ny). Dot product with vector v = v·n = v^T n.
                # So we have equations: (x-w)^T n = rhs1, (z-y)^T n = rhs2.
                # This is linear system: [ (x-w).T ; (z-y).T ] * n = rhs
                M = np.array([x - w, z - y])  # 2x2
