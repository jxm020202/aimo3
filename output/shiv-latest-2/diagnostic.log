            def point_in_polygon(pt, poly):
                # poly: list of vertices in order (convex quadrilateral)
                x, y = pt
                # Use winding number for convex polygon: check sign of cross products
                # For each edge (vi -> vj), compute cross product (vj-vi) x (pt-vi)
                # For convex polygon, all cross products should have same sign (or zero)
                sign = None
                n = len(poly)
                for i in range(n):
                    x1, y1 = poly[i]
                    x2, y2 = poly[(i+1)%n]
                    cross = (x2 - x1)*(y - y1) - (y2 - y1)*(x - x1)
                    if cross != 0:
                        if sign is None:
                            sign = 1 if cross > 0 else -1
                        else:
                            if (cross > 0) != (sign > 0):
                                return False
                return True
            
            def square_contains_integer(theta, tx, ty):
                # vertices of unit square rotated by theta, with lower-left corner at (0,0) before translation
                # Actually we define base square vertices (0,0),(1,0),(1,1),(0,1)
                c = math.cos(theta)
                s = math.sin(theta)
                base = [(0,0),(1,0),(1,1),(0,1)]
                verts = [(c*u - s*v + tx, s*u + c*v + ty) for (u,v) in base]
                # Determine bounding box
                xs = [v[0] for v in verts]
                ys = [v[1] for v in verts]
                minx, maxx = min(xs), max(xs)
                miny, maxy = min(ys), max(ys)
                # integer points to check: floor(minx) to ceil(maxx)
                imin = math.floor(minx)
                imax = math.ceil(maxx)
                jmin = math.floor(miny)
                jmax = math.ceil(maxy)
                for i in range(imin, imax+1):
                    for j in range(jmin, jmax+1):
                        if point_in_polygon((i,j), verts):
                            return True
                return False
            
            def trial():
                theta = random.random()*2*math.pi
                tx = random.random()
                ty = random.random()
                return not square_contains_integer(theta, tx, ty)
            
            def estimate(n):
                cnt=0
                for _ in range(n):
                    if trial():
                        cnt+=1
                return cnt/n
            
            for N in [10000, 50000, 200000]:
                p_est = estimate(N)
                print(N, p_est)
            
