            def generate_closure(x, y, max_val=200, max_iter=1000):
                # BFS closure limited by max_val absolute
                S = set([x, y])
                changed = True
                iter_count = 0
                while changed and iter_count < max_iter:
                    changed = False
                    iter_count += 1
                    new_vals = set()
                    for a in list(S):
                        for b in list(S):
                            # generate results for i around optimal to keep within bound
                            if a==0 or b==0:
                                # then expression = a^2 + b^2 (since iab =0)
                                val = a*a + b*b
                                if abs(val) <= max_val:
                                    new_vals.add(val)
                                continue
                            # optimal i to minimize absolute value:
                            i0 = - (a*a + b*b) // (a*b)  # floor
                            for di in range(-2, 3):
                                i = i0 + di
                                val = a*a + i*a*b + b*b
                                if abs(val) <= max_val:
                                    new_vals.add(val)
                    # also include squares of sums/diffs explicitly (i=2,-2)
                    # but those are already covered by i values
                    for v in new_vals:
                        if v not in S:
                            S.add(v)
                            changed = True
                return S
            
