            def real_cuberoot(z):
                if z >= 0:
                    return z**(1/3)
                else:
                    return -((-z)**(1/3))
            def term_cuberoot_real(x):
                A = (1 + x**2)/2
                D = 9*x**4 + (4*x**6)/3 + 9 + 18*x**2
                sqrtD = mp.sqrt(D)
                return real_cuberoot(A + sqrtD/6) + real_cuberoot(A - sqrtD/6)
            
