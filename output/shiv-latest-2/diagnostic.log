            def compute_A_grid(theta, N=2000):
                # grid points at centers of cells for better approximation
                xs = (np.arange(N) + 0.5) / N  # shape (N,)
                ys = (np.arange(N) + 0.5) / N
                xv, yv = np.meshgrid(xs, ys, indexing='xy')
                # flatten
                xv = xv.ravel()
                yv = yv.ravel()
                c = math.cos(theta)
                s = math.sin(theta)
                # compute distances to each of four integer points
                # vectorized
                # shape (4, M)
                dx0 = xv - 0.0
                dy0 = yv - 0.0
                dx1 = xv - 1.0
                dy1 = yv - 0.0
                dx2 = xv - 0.0
                dy2 = yv - 1.0
                dx3 = xv - 1.0
                dy3 = yv - 1.0
                # rotate by -theta
                def inside(dx, dy):
                    dxp = c*dx + s*dy
                    dyp = -s*dx + c*dy
                    return (np.abs(dxp) <= 0.5) & (np.abs(dyp) <= 0.5)
                covered = inside(dx0, dy0) | inside(dx1, dy1) | inside(dx2, dy2) | inside(dx3, dy3)
