                v_OI = (I[0]-O[0], I[1]-O[1])
                v_AB = (E[0]-D[0], E[1]-D[1])
                return angle_between(v_OI, v_AB)
            
            def angles_triangle(D,E,F):
                a = length(E,F)
                b = length(F,D)
                c = length(D,E)
                alpha = math.acos((b**2 + c**2 - a**2)/(2*b*c))
                beta = math.acos((a**2 + c**2 - b**2)/(2*a*c))
                gamma = math.pi - alpha - beta
                return alpha, beta, gamma
            
            def test_formula():
                D,E,F = random_triangle()
                alpha,beta,gamma = angles_triangle(D,E,F)
                theta = angle_OI_AB(D,E,F)
                return theta, abs(alpha-beta)/2
            
