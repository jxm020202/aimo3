            def min_size_for_n(n, max_range_factor=2):
                # D = {F_2,...,F_n}
                F = fib_upto(n)
                D = set(F[2:n+1])
                max_val = max(D)
                # try m from lower bound to maybe n+1
                lower = 1
                while lower*(lower-1)//2 < len(D):
                    lower+=1
                for m in range(lower, n+2):
                    # search sets of size m within [0, max_val*max_range_factor]
                    # include 0 for convenience (we can shift later)
                    # We'll assume set includes 0 to reduce search.
                    # Choose other m-1 points from 1..max_val*max_range_factor
                    limit = max_val*max_range_factor
                    # generate combinations (could be huge)
                    # We'll use simple heuristic: try small m.
                    for combo in itertools.combinations(range(1, limit+1), m-1):
                        S = (0,)+combo
                        diffs=set()
                        for i in range(m):
                            for j in range(i):
