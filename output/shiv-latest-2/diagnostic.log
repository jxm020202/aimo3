            def count_independent_sets_matrix(n):
                rows = [mask for mask in range(1<<n) if (mask & (mask<<1))==0]
                m = len(rows)
                M = np.zeros((m,m), dtype=object)
                for i,a in enumerate(rows):
                    for j,b in enumerate(rows):
                        if (a & b)==0:
                            M[i,j]=1
                # compute M^{n-1}
                power = n-1
                # fast exponentiation
                result = np.identity(m, dtype=object)
                base = M.copy()
                while power>0:
                    if power%2==1:
                        result = result.dot(base)
                    base = base.dot(base)
                    power//=2
                total = result.sum()
