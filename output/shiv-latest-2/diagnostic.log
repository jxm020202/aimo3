            def ratio_pow2(exps):
                # exps list of 6 nonnegative ints, at least one zero (ensured)
                A = sum(2**e for e in exps)
                B = 0
                for i in range(6):
                    e_i = exps[i]
                    e_ip1 = exps[(i+1)%6]
                    e_ip2 = exps[(i+2)%6]
                    term = 2**(min(e_i, e_ip1) + max(e_ip1, e_ip2))
                    B += term
                return fractions.Fraction(A**3, B)
            
            def brute_max_exp(limit):
                min_ratio = None
                min_exps = None
                # generate all 6-tuples of exponents 0..limit, ensure at least one zero
                for exps in itertools.product(range(limit+1), repeat=6):
                    if 0 not in exps:
                        continue
                    r = ratio_pow2(exps)
                    if min_ratio is None or r < min_ratio:
                        min_ratio = r
                        min_exps = exps
