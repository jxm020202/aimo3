            import itertools
            
            def exists_sequence(n, L, m):
                # n flavors labeled 0..n-1
                flavors = list(range(n))
                # generate all sequences of length m (exponential) not feasible for large m
                # but for small n,m we can brute force
                for seq in itertools.product(flavors, repeat=m):
                    ok=True
                    for start in range(m):
                        # get block of length L
                        block = [seq[(start+i)%m] for i in range(L)]
                        # check each flavor appears at least once
                        for f in flavors:
                            if f not in block:
                                ok=False
                                break
                        if not ok:
                            break
                    if ok:
                        return True, seq
                return False, None
            
            def possible_m(n, max_m=12):
                L=n+1
                poss=[]
                for m in range(L, max_m+1):
                    exists,_=exists_sequence(n, L, m)
                    if exists:
                        poss.append(m)
                return poss
            
            for n in range(2,5):
                print(n, possible_m(n, max_m=12))
            
