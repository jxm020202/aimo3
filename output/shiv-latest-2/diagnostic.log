            def C_real(x):
                A = (1 + x**2)/2
                B = mp.sqrt(9*x**4 + (4*x**6)/3 + 9 + 18*x**2)/6
                # Use real cube root: sign*abs**(1/3)
                def real_cuberoot(z):
                    return mp.sign(z) * abs(z)**(1/3)
                return real_cuberoot(A + B) + real_cuberoot(A - B)
            
