            import itertools
            
            def steps_to_all_tails(state):
                # state as tuple of bits length n, 1 for H, 0 for T
                n = len(state)
                seen = {}
                steps = 0
                while True:
                    k = sum(state)
                    if k == 0:
                        return steps
                    # toggle bit at position k (1-indexed)
                    idx = k-1  # zero-indexed
                    # toggle
                    lst = list(state)
                    lst[idx] ^= 1
                    state = tuple(lst)
                    steps += 1
                    # optional detection of loops (shouldn't happen)
                    if state in seen:
                        # loop
                        return None
                    seen[state] = steps
            
            def avg_steps(n):
                total = 0
                for bits in itertools.product([0,1], repeat=n):
                    total += steps_to_all_tails(bits)
                return total / (2**n)
            
