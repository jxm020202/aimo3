                    E1 = [edges[i] for i in range(len(edges)) if (mask>>i)&1]
                    # compute forced edges F
                    forced = set()
                    # for each vertex w, find neighbors via 1-edges
                    neigh = {v:[] for v in vertices}
                    for (u,v) in E1:
                        neigh[u].append(v)
                        neigh[v].append(u)
                    for w in vertices:
                        nb = neigh[w]
                        for i in range(len(nb)):
                            for j in range(i+1,len(nb)):
                                u,v = nb[i], nb[j]
                                if u>v: u,v=v,u
                                forced.add((u,v))
                    # check condition: any triangle with two 1s must have third edge forced 3, which is satisfied by forced set.
