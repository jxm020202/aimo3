            def point_in_hull(p, points):
                # check if p in convex hull of points (2D) using linear programming via scipy? We'll brute force combos of up to 3.
                # also check combos of 2 (line segment)
                for a,b in points:
                    if (abs(a-p[0])<1e-9 and abs(b-p[1])<1e-9):
                        return True
                # check line segments
                for (x1,y1),(x2,y2) in itertools.combinations(points,2):
                    # solve p = t*(x1,y1)+(1-t)*(x2,y2)
                    # t in [0,1]
                    denom = (x1 - x2, y1 - y2)
                    # solve for t using one coordinate if denominator not zero
                    if denom[0]!=0:
                        t = (p[0]-x2)/(x1-x2)
                    elif denom[1]!=0:
                        t = (p[1]-y2)/(y1-y2)
                    else:
                        continue
                    if 0-1e-9 <= t <= 1+1e-9:
                        # check other coordinate matches
                        if abs(p[1] - (t*y1 + (1-t)*y2))<1e-6:
                            return True
                # check triangles
                for combo in itertools.combinations(points,3):
                    if in_triangle(p, *combo):
                        return True
                return False
            
