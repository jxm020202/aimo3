                # recursion
                best = math.inf
                def dfs(idx, current_sum):
                    nonlocal best
                    if current_sum >= best:
                        return
                    if idx == m:
                        best = current_sum
                        return
                    i,j = edges[idx]
                    for w in (1,2,3):
                        # assign
