            def min_total_sum(n):
                # edges index mapping
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                edge_index = {e:i for i,e in enumerate(edges)}
                # objective coefficients
                c = np.ones(m)
                # constraints: for each triangle, sum >=5
                A = []
                b = []
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            row = np.zeros(m)
                            row[edge_index[(i,j)]] = 1
                            row[edge_index[(i,k)]] = 1
                            row[edge_index[(j,k)]] = 1
                            A.append(-row)  # -sum <= -5
                            b.append(-5)
                A = np.array(A)
                b = np.array(b)
                # bounds 1 to 3
                bounds = opt.Bounds(1,3)
                # integrality: all variables integer
                integrality = np.ones(m, dtype=int)
                res = opt.milp(c=c, constraints=opt.LinearConstraint(A, -np.inf, b), bounds=bounds,
                               integrality=integrality, options={'presolve': True})
                if not res.success:
                    print("fail", n)
                    return None
                total = sum(res.x)
                return total, res.x
            
