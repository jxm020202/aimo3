                    for angles in itertools.product([0,1], repeat=n):
                        # check constraints
                        ok=True
                        for i in range(n):
                            t=angles[i]
                            e_prev=edges[i]      # edge before angle i? Let's define edges[i] adjacent to angle i on one side, edges[(i+1)%n] on other side
