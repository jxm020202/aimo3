            def antiprism_vertices(n):
                # generate coordinates for regular n-gon top and bottom
                import math, numpy as np
                R = 1.0
                top = [(R*math.cos(2*math.pi*i/n), R*math.sin(2*math.pi*i/n), 0.5) for i in range(n)]
                bottom = [(R*math.cos(2*math.pi*(i+0.5)/n), R*math.sin(2*math.pi*(i+0.5)/n), -0.5) for i in range(n)]
                return top, bottom
            
            def antiprism_faces(n):
                top, bottom = antiprism_vertices(n)
                # side triangles: for each i, connect top i, bottom i, bottom i+1
                faces = []
                for i in range(n):
                    faces.append((('t',i), ('b',i), ('b',(i+1)%n)))  # triangle
                    faces.append((('b',i), ('t',i), ('t',(i+1)%n)))  # other triangle
                return faces
            
            def count_vertex_degrees(n):
                faces = antiprism_faces(n)
                deg = {}
                for f in faces:
                    for v in f:
                        deg[v] = deg.get(v,0)+1
                return deg
            
            deg5 = count_vertex_degrees(5)
            deg5
            
