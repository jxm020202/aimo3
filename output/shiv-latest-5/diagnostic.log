            import itertools, numpy as np
            
            def in_triangle(p, a,b,c):
                # barycentric
                M = np.array([a,b,c]).T
                # solve M * w = p, with w sum to 1
                # add constraint sum w =1
                A = np.vstack([M, np.ones(3)])
                bvec = np.array([p[0], p[1], 1])
                try:
                    w = np.linalg.lstsq(A, bvec, rcond=None)[0]
                except np.linalg.LinAlgError:
                    return False
                return all(w>=-1e-9) and abs(sum(w)-1)<1e-9
            
