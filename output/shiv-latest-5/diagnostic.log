            def min_total_sum(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                best = None
                # simple recursion with pruning
                # order edges
                # maintain adjacency matrix
                adj = [[None]*n for _ in range(n)]
                triangles = list(combinations(range(n),3))
                # Precompute which edges belong to each triangle
                tri_edges = []
                for (a,b,c) in triangles:
