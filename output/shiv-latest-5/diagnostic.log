            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            # Prepare data
            a_vals = np.array([a for a,b in types])
            b_vals = np.array([b for a,b in types])
            # Number of types
            n = len(types)
            
            def feasible(V):
                # Variables: n_i counts for each type
                # constraints:
                # sum n_i = V
                # sum a_i n_i = 2V - 4
                # sum b_i n_i = 4V - 8
                # n_i >=0 integer
                # We'll set up as linear constraints
                A_eq = np.vstack([np.ones(n), a_vals, b_vals])
                lb_eq = np.array([V, 2*V - 4, 4*V - 8])
                ub_eq = lb_eq.copy()
                # No inequality constraints besides nonnegativity
                bounds = Bounds(0, np.inf)
                # integer integrality
                integrality = np.ones(n, dtype=int)
                # objective: dummy zero vector
                c = np.zeros(n)
                res = milp(c=c, constraints=LinearConstraint(A_eq, lb_eq, ub_eq), bounds=bounds,
                           integrality=integrality, options={"disp": False})
                return res.success, res.x if res.success else None
            
            # Test for some V values
            for V in range(4, 60):
                ok,_ = feasible(V)
                if ok:
