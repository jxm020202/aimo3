            def f_formula_general(n):
                # if n+1 even (n odd), use p=2
                if (n+1) % 2 == 0:
                    return (n-1)//2
                # else n+1 odd: need smallest prime factor >2
                m = n+1
                # find smallest prime factor
                p = sp.factorint(m)
                smallest = min(p.keys())
                if smallest == m: # prime
