            def functional_graph(f, n):
                # returns dict mapping i (1..n) -> f(i)
                return {i: f(i) for i in range(1, n+1)}
            
            def sigma_map(n):
                def f(x):
                    return ((866*x - 1) % n) + 1
                return f
            
            def tau_map(n):
                m = n+1
                def f(x):
                    return pow(x, 866, m)  # returns 0..m-1, but we need in 1..n
                    # note: if result is 0, map to m? but domain is 1..n, result 0 is not allowed.
                return f
            
            def tau_map_valid(n):
                m=n+1
                def f(x):
                    r=pow(x,866,m)
                    if r==0:
                        # map 0 to m? but m is not in domain {1..n}
                        # then tau is not a map into {1..n} -> invalid
                        # We'll treat as invalid
                        return None
                    else:
                        return r
                return f
            
            def is_valid_tau(n):
                m=n+1
                for x in range(1,n+1):
                    if pow(x,866,m)==0:
                        return False
                return True
            
            def graph_structure(f, n):
                # compute for each node: (cycle_len, distance_to_cycle)
                visited=[False]*(n+1)
                result={}
                for i in range(1,n+1):
                    if visited[i]: continue
                    # follow chain
                    path=[]
                    cur=i
                    while not visited[cur]:
                        visited[cur]=True
                        path.append(cur)
                        cur=f(cur)
                    # cur is now visited; need to detect cycle
                    if cur in path:
                        idx=path.index(cur)
                        cycle=path[idx:]
                        cycle_len=len(cycle)
                        # assign for cycle nodes
                        for node in cycle:
                            result[node]=(cycle_len,0)
                        # nodes before cycle
                        for dist,node in enumerate(reversed(path[:idx]), start=1):
                            # distance to cycle = dist
                            result[node]=(cycle_len,dist)
                    else:
                        # reached a node already processed earlier, which already has result
                        # get its (cycle_len, dist)
                        cyc_len,dist_to_cycle=result[cur]
                        # assign for nodes in path reversed
                        for d,node in enumerate(reversed(path), start=1):
                            result[node]=(cyc_len,dist_to_cycle+d)
                return result
            
            def graphs_isomorphic(n):
                sigma=sigma_map(n)
                tau=tau_map(n)
                # need to ensure tau maps into 1..n
                # if any tau(x)==0, then not valid (cannot map to domain)
                for x in range(1,n+1):
                    if tau(x)==0:
                        return False
                # compute structures
                struct_sigma=graph_structure(sigma,n)
                struct_tau=graph_structure(tau,n)
                # compare multiset of (cycle_len, distance_to_cycle) counts
                # Actually isomorphic if there exists bijection preserving these pairs.
                # So we can compare sorted list of pairs
                list_sigma=sorted(struct_sigma.values())
                list_tau=sorted(struct_tau.values())
                return list_sigma==list_tau
            
            def find_candidates(limit):
                cand=[]
                for n in range(1,limit+1):
                    if graphs_isomorphic(n):
                        cand.append(n)
                return cand
            
            print(find_candidates(200))
            
