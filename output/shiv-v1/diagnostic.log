            def construct_f(n):
                import math
                phi = {x: ((866*x - 1) % n) + 1 for x in range(1,n+1)}
                g = math.gcd(866, n)
                # image set
                image = [y for y in range(1,n+1) if y % g == 0]  # multiples of g
                # preimage sets
                preimages = {}
                for y in image:
                    preimages[y] = [x for x in range(1,n+1) if phi[x]==y]
                # verify each preimage set size g
                assert all(len(preimages[y])==g for y in image)
                # compute exponentiation fibers modulo n+1
                mod = n+1
                # map from result to list of roots
                fibers = {}
                for a in range(1,n+1):
                    res = pow(a,866,mod)
                    if res==0:
                        # shouldn't happen since mod is prime
                        return None
                    fibers.setdefault(res, []).append(a)
                # each fiber should have size g
                assert all(len(v)==g for v in fibers.values())
                # now match each y to a result res
                used_res=set()
                used_roots=set()
                f = {}
                # iterate over y in image
                for y in image:
                    # find a result not used yet
                    for res, roots in fibers.items():
                        if res in used_res:
                            continue
                        # roots should be unused
                        if any(r in used_roots for r in roots):
                            continue
                        # assign
                        f[y]=res
                        for x,root in zip(preimages[y], roots):
                            f[x]=root
                        used_res.add(res)
                        used_roots.update(roots)
                        break
                    else:
                        raise ValueError("no match")
                # assign remaining elements (those not in image)
                remaining = [i for i in range(1,n+1) if i not in f]
                # they have no constraints; assign any unused values
                unused_vals = [i for i in range(1,n+1) if i not in f.values()]
                for i,val in zip(remaining, unused_vals):
                    f[i]=val
                # verify bijection and condition
                # bijection
                if len(set(f.values()))!=n:
                    return None
                # condition
                for x in range(1,n+1):
                    y=phi[x]
                    if (pow(f[x],866, n+1) - f[y]) % (n+1)!=0:
                        return None
                return f
            
