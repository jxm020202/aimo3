            from fractions import Fraction
            import math
            
            def f_N(N):
                # compute smallest odd prime divisor p of N-1 (S)
                S = N-1
                # find smallest odd prime divisor >2
                p = None
                for q in sp.primerange(5, 1000):
                    if S % q == 0:
                        p = q
                        break
                if p is None:
                    # treat as large prime
                    p = None
                if p is None:
                    # fallback: compute minimal lcm by brute force small N
                    # but for testing we assume p found
                    raise ValueError("p not found")
                # compute f = S * (p-1)//p (since divisible)
                return S * (p-1) // p
            
            def g_c(c, K):
                M = 3**K
                N = M + c
                # compute smallest odd prime divisor p of N-1
                S = N-1
                # find smallest odd prime divisor
                p = None
                for q in sp.primerange(5, 200):
                    if S % q == 0:
                        p = q
                        break
                # compute f(N) using formula
                if p is not None:
                    f = S * (p-1) // p
                else:
                    # fallback compute via brute force for small N
                    # find min lcm of three distinct divisors sum N
                    # brute force over triples a<b<c, a+b+c=N, compute lcm
                    min_l = None
                    for a in range(1, N-1):
                        for b in range(a+1, N):
                            c3 = N - a - b
                            if c3 <= b:
                                continue
                            # distinct
                            # compute lcm of a,b,c3
                            l = sp.ilcm(a,b,c3)
                            if min_l is None or l < min_l:
                                min_l = l
                    f = min_l
                # compute g
                val = (math.factorial(K) * f) // M  # floor
                g = Fraction(val, math.factorial(K))
                return g
            
