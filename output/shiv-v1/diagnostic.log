            def f_by_one_d_method(n):
                best = None
                # consider d divisor of n-1, d>=2 (distinct from 1)
                for d in sp.divisors(n-1):
                    if d==1:
                        continue
                    if d == (n-1)//2 and (n-1)%2==0:
                        continue
                    N = n-1-d
                    if N<=0:
                        continue
                    if N==d or N==1:
                        continue
                    # check that indeed 1,d,N are divisors of N (by construction)
                    # need d | N (ensured because N = (n-1)-d = d*((n-1)/d -1))
                    # also 1 always.
                    if best is None or N < best:
                        best = N
                return best
            
