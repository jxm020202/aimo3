            def has_perfect_matching(n):
                # returns True if there exists bijection f satisfying condition
                # n must be >=1
                m = n+1
                # compute cycles of g
                perm = permutation_g(n)
                cycles = cycles_of_perm(perm)
                # map position to cycle length
                pos_cycle_len = {}
                for c in cycles:
                    L = len(c)
                    for pos in c:
                        pos_cycle_len[pos] = L
                # precompute exponent 866^L (big int)
                exp_cache = {L: pow(866, L) for L in set(pos_cycle_len.values())}
                # Build bipartite graph: left nodes = positions (1..n), right nodes = numbers (1..n)
                # Edge if number a satisfies a^{866^L} ≡ a (mod m) where L = pos_cycle_len[pos]
                G = nx.Graph()
                left_nodes = [f"p{pos}" for pos in range(1, n+1)]
                right_nodes = [f"a{a}" for a in range(1, n+1)]
                G.add_nodes_from(left_nodes, bipartite=0)
                G.add_nodes_from(right_nodes, bipartite=1)
                # For each position, compute allowed numbers
                # We'll precompute for each L the set of numbers satisfying condition
                allowed_by_L = {}
                for L in set(pos_cycle_len.values()):
                    exp = exp_cache[L]
                    allowed = set()
                    for a in range(1, n+1):
                        if pow(a, exp, m) == a % m:  # a < m so a% m = a
                            allowed.add(a)
                    allowed_by_L[L] = allowed
                # Add edges
                for pos in range(1, n+1):
                    L = pos_cycle_len[pos]
                    allowed = allowed_by_L[L]
                    for a in allowed:
                        G.add_edge(f"p{pos}", f"a{a}")
                # Compute maximum matching
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # matching includes both sides; size is number of matched pairs *2
                matched = sum(1 for node in matching if node.startswith('p'))
                return matched == n
            
