                    phi[a] = b
                if len(set(phi[1:])) != n:
                    return False
                # compare cycle length multisets
                cycles_h = cycles_perm(h)
                cycles_phi = cycles_perm(phi)
                lengths_h = sorted([len(c) for c in cycles_h])
                lengths_phi = sorted([len(c) for c in cycles_phi])
                return lengths_h == lengths_phi
            
