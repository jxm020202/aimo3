            def functional_graph_code(n, mapping):
                # mapping dict 1..n -> 1..n
                # Build reverse adjacency
                rev = {i: [] for i in range(1, n+1)}
                for u, v in mapping.items():
                    rev[v].append(u)
                visited = [False]*(n+1)
                components = []
                for i in range(1, n+1):
                    if visited[i]:
                        continue
                    # find cycle starting from i using tortoise-hare
                    # first, follow until we see a visited node
                    path = []
                    cur = i
                    while not visited[cur]:
                        visited[cur] = True
                        path.append(cur)
                        cur = mapping[cur]
                    # now cur is already visited; it may be part of current path (cycle) or previous component
                    if cur in path:
                        idx = path.index(cur)
                        cycle = path[idx:]  # list of nodes in cycle order
                        # compute tree codes for each node in cycle
                        # define recursive code function with memoization
                        sys.setrecursionlimit(10000)
                        from functools import lru_cache
                        @lru_cache(maxsize=None)
                        def tree_code(node, exclude):
                            # exclude is the predecessor in cycle to avoid using that edge
                            children = [c for c in rev[node] if c != exclude]
                            child_codes = [tree_code(c, None) for c in children]
                            child_codes.sort()
                            return tuple(child_codes)
                        # compute codes for each node in cycle, with exclude being its predecessor in cycle
                        codes = []
                        L = len(cycle)
                        for idx_node, node in enumerate(cycle):
                            pred = cycle[(idx_node-1)%L]  # predecessor in cycle (mapping[pred]=node)
                            code_node = tree_code(node, pred)
                            codes.append(code_node)
                        # canonical rotation: find minimal lexicographic rotation of codes
                        # Since codes are tuples, we can compare sequences
                        # generate all rotations
                        best = None
                        for r in range(L):
                            rot = tuple(codes[(r+i)%L] for i in range(L))
                            if best is None or rot < best:
                                best = rot
                        components.append((L, best))
                    # else cur not in current path -> already processed component
                # sort components multiset
                components.sort()
                return tuple(components)
            
