            def indegree_distribution_g(n):
                # g(x) = ((866*x - 1) % n) + 1
                indeg = [0]*(n+1)
                for x in range(1, n+1):
                    y = ((866*x - 1) % n) + 1
                    indeg[y] += 1
                # return sorted list of indegrees (excluding index 0)
                return sorted(indeg[1:])
            
            def indegree_distribution_h(n):
                N = n+1
                indeg = [0]*(n+1)  # we consider residues 1..n
                for a in range(1, n+1):
                    r = pow(a, 866, N)
                    if r == 0 or r > n:
                        # invalid mapping (should not happen if N squarefree)
                        return None
                    indeg[r] += 1
                return sorted(indeg[1:])
            
            def check_n(n):
                if not is_squarefree(n+1):
                    return False
                dg = indegree_distribution_g(n)
                dh = indegree_distribution_h(n)
                if dh is None:
                    return False
                return dg == dh
            
            def find_n(limit=100000):
                candidates = []
                for n in range(866, limit+1):
                    if check_n(n):
                        candidates.append(n)
                        break
                return candidates
            
