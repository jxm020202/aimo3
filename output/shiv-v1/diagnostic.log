            def f_bruteforce(N):
                best = None
                best_trip = None
                for a in range(1, N-2):
                    for b in range(a+1, N-a-1):
                        c = N - a - b
                        if c <= b:
                            continue
                        # distinct a<b<c
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
