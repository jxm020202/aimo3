            def L_min(k):
                # compute minimal lcm of three distinct positive integers summing to k
                # brute force for small k
                best = None
                for a in range(1, k):
                    for b in range(a+1, k):
                        c = k - a - b
                        if c <= b:
                            continue
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                return best
            
            def compute_r_up_to(K):
                r = {}
                for k in range(6, K+1):
