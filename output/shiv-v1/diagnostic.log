            import sympy as sp
            
            def order_mod(a, n):
                # returns multiplicative order of a modulo n (assuming gcd(a,n)=1)
                return sp.n_order(a, n)
            
            def cycle_type(perm):
                # perm is dict mapping 1..n to 1..n
                n = len(perm)
                visited = [False]*(n+1)
                lengths = []
                for i in range(1,n+1):
                    if not visited[i]:
                        # traverse cycle
                        cur = i
                        length = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = perm[cur]
                            length += 1
                        lengths.append(length)
                lengths.sort()
                return tuple(lengths)
            
            def permutation_mul_by_a(n, a):
                perm = {}
                for x in range(1,n+1):
                    y = (a*x) % n
                    if y == 0:
                        y = n
                    perm[x] = y
                return perm
            
            def permutation_pow_mod(n, a):
                perm = {}
                mod = n+1
                for x in range(1,n+1):
                    y = pow(x, a, mod)
                    if y == 0:
                        y = mod  # but this would be n+1 > n, not allowed; but should not happen
                    perm[x] = y
                return perm
            
            def is_squarefree(m):
                # check squarefree
                return sp.factorint(m) and all(e==1 for e in sp.factorint(m).values())
            
            def check_n(n):
                if sp.gcd(n, 866) != 1:
                    return False
                if not is_squarefree(n+1):
                    return False
                # compute permutations
                P = permutation_mul_by_a(n, 866)
                Q = permutation_pow_mod(n, 866)
                # verify Q is permutation (bijection)
                if len(set(Q.values())) != n:
                    return False
                # compare cycle types
                return cycle_type(P) == cycle_type(Q)
            
            # test small range
            candidates = []
            for n in range(866, 2000):
                if check_n(n):
                    candidates.append(n)
            candidates[:20], len(candidates)
            
