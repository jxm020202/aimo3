            import math, itertools, functools, sys, sympy as sp
            
            def f_bruteforce(n, limit=10000):
                # find smallest positive integer x that has three distinct divisors summing to n
                # search x up to limit
                for x in range(1, limit+1):
                    # get divisors
                    divs = sp.divisors(x)
                    # need three distinct
                    for a,b,c in itertools.combinations(divs,3):
                        if a+b+c == n:
