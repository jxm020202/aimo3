            def f_formula_smallest_divisor(n):
                # find smallest divisor d >=3 of n-1
                m = n-1
                # find smallest divisor >=3
                d = None
                # iterate from 3 up to sqrt
                for i in range(3, int(math.isqrt(m))+1):
                    if m % i == 0:
                        d = i
                        break
                if d is None:
                    # n-1 is prime or 1 or 2
                    # if n-1 is prime >=3, then smallest divisor >=3 is n-1 itself
                    if m >= 3:
                        d = m
                    else:
