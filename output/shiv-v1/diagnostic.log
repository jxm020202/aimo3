            def f_bruteforce(n):
                S = n-1
                best = None
                for a in range(2, S-1):
                    b = S - a
                    if b <= 1 or b == a:
                        continue
                    l = (a*b)//math.gcd(a,b)
                    if best is None or l < best:
                        best = l
                return best
            
            def f_formula(n):
