            def perm_mod(k, m):
                # return True if map a->a^k mod m is permutation on 1..m-1
                seen=set()
                for a in range(1,m):
                    b=pow(a,k,m)
                    if b==0: # maps to 0 (which is not allowed)
                        return False
                    if b in seen:
                        return False
                    seen.add(b)
                return True
            
            def find_mods(k, limit):
                res=[]
                for m in range(3, limit+1):
                    if perm_mod(k,m):
                        res.append(m)
                return res
            
