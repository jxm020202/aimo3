            import sympy as sp
            
            def factorial_mod(n, mod):
                # compute n! mod mod
                res = 1 % mod
                for i in range(2, n+1):
                    res = (res * i) % mod
                return res
            
            # Precompute e_mod for many mod values? We'll compute on the fly.
            
            def M_mod(d):
                # compute 3^{2025!} mod d
                # factor d
                fac = sp.factorint(d)
                residues = []
                moduli = []
                for p, k in fac.items():
                    pk = p**k
                    if p == 3:
                        # exponent >= k, so 3^{e} ≡ 0 mod 3^k
                        residues.append(0)
                        moduli.append(pk)
                    else:
                        # compute phi(pk)
                        phi = pk - pk//p
                        # compute e mod phi
                        e_mod_phi = factorial_mod(2025, phi)
                        # if e_mod_phi == 0, set exponent = phi
                        exp = e_mod_phi if e_mod_phi != 0 else phi
                        residues.append(pow(3, exp, pk))
                        moduli.append(pk)
