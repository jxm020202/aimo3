            def is_form(r):
                # check if r = 2^e * 3^a where e in {0,1}
                # i.e., r is power of 3 or twice a power of 3
                # handle r=0 separately
                if r==0:
                    return True  # zero? Actually r=0 is sum of 0? but we treat as special
                # factor out powers of 2
                e=0
                while r%2==0:
                    r//=2
                    e+=1
                if e>1:
                    return False
                # now r should be power of 3
                while r%3==0:
                    r//=3
                return r==1
            
