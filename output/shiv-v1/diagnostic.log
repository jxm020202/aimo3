                G = build_graph_g(n)
                H = build_graph_h(n)
                # Use DiGraphMatcher with node_match maybe based on indegree/outdegree
                GM = nx.algorithms.isomorphism.DiGraphMatcher(G, H)
                return GM.is_isomorphic()
            
