            def f_brutal(n):
                best = None
                best_trip = None
                for a in range(1,n):
                    for b in range(a+1,n):
                        c = n - a - b
                        if c<=b or c<=0:
                            continue
                        # distinct a<b<c
                        l = math.lcm(a,b,c)
                        if best is None or l<best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
