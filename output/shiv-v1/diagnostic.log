            def r_of_T(T):
                best = sp.Rational(10,1)
                best_trip = None
                for a in range(1, T):
                    for b in range(a+1, T):
                        c = T - a - b
                        if c <= b:
                            continue
                        # distinct automatically because c > b > a
                        L = sp.ilcm(a,b,c)
                        r = sp.Rational(L, T)
                        if r < best:
                            best = r
                            best_trip = (a,b,c)
                return best, best_trip
            
