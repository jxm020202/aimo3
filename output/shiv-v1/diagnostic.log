            def smallest_divisor_ge6(c):
                # returns smallest k>=6 dividing N = M + c, using condition described.
                # Since M ≡ 1 mod p for p not 3, and M ≡ 0 mod 3^e.
                # We'll just test k up to some bound.
                for k in range(6, 500):
                    # test if k divides N
                    # compute condition
                    # factor k into 3^e * m where m not divisible by 3
                    e = 0
                    temp = k
                    while temp % 3 == 0:
                        e += 1
                        temp //= 3
                    m = temp
                    # condition: c ≡ 0 mod 3^e and c ≡ -1 mod m
                    cond = (c % (3**e) == 0) and ((c + 1) % m == 0)
                    if cond:
                        return k
                return None
            
