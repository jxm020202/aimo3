            import math, itertools
            
            def f_brutal(n):
                S=n-1
                best=10**9
                best_pair=None
                for a in range(2,S-1):
                    b=S-a
                    if b<=1 or a==b: continue
                    # ensure a,b distinct >1
                    l=math.lcm(a,b)
                    if l<best:
                        best=l
                        best_pair=(a,b)
                return best,best_pair
            
            def f_formula(n):
                S=n-1
                # find smallest divisor d>=3 of S that is not S (i.e., proper divisor)
                # if none (i.e., S is prime or S=2?), then fallback to brute
                d=None
                for i in range(3,int(math.sqrt(S))+1):
                    if S%i==0:
                        d=i
                        break
                if d is None:
                    # S may be prime or maybe 2*? but we need smallest divisor >=3.
                    # If S even, divisor 2 not allowed. So next divisor could be S itself if S odd prime.
                    # We'll fallback to brute.
                    return None
                a=S//d
                l=S - a
                return l
            
            def test(limit):
                for n in range(6,limit+1):
                    brute,_=f_brutal(n)
                    formula=f_formula(n)
                    if formula is None:
                        continue
                    if brute!=formula:
                        print("mismatch", n, brute, formula)
                        break
                else:
                    print("all ok up to", limit)
            
            test(200)
            
