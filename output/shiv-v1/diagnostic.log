                            steps += 1
                            cur = func[cur]-1
                        cycle_start = path[cur]
                        cycle_nodes = [node for node, idx in path.items() if idx >= cycle_start]
                        # Now collect component nodes: all nodes that eventually reach any cycle node
                        # We'll perform reverse BFS from cycle nodes
                        rev = [[] for _ in range(n)]
                        for src, dst in enumerate(func):
