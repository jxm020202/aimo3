            import networkx as nx
            
            def build_graph_g(n, e=866):
                G = nx.DiGraph()
                G.add_nodes_from(range(n))  # nodes 0..n-1
                for i in range(n):
                    G.add_edge(i, (e*i) % n)
                return G
            
            def build_graph_h(n, e=866):
                M = n+1
                H = nx.DiGraph()
                H.add_nodes_from(range(n))  # map residues 1..n to indices 0..n-1
                for a in range(1, n+1):
                    target = pow(a, e, M)
                    if target == 0:
                        raise ValueError("zero")
                    H.add_edge(a-1, target-1)
                return H
            
