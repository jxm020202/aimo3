            E = math.factorial(2025)  # large exponent
            # Precompute M_mod for m up to bound
            B = 2000
            
            # function to compute L0(m) via brute force O(m^2)
            def L0_bruteforce(m):
                best = None
                # a up to m//3
                for a in range(1, m//3 + 1):
                    for b in range(a+1, (m-a)//2 + 1):
                        c = m - a - b
                        if c <= b:
                            continue
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                return best
            
            # cache
            L0_cache = {}
            def get_L0(m):
                if m in L0_cache:
                    return L0_cache[m]
                val = L0_bruteforce(m)
                L0_cache[m] = val
                return val
            
            def find_best_m(N_mod_func):
                # N_mod_func(m) returns N mod m
                best_ratio = None
