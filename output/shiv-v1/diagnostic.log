            def divisors(n):
                divs = []
                for i in range(1, int(n**0.5)+1):
                    if n % i == 0:
                        divs.append(i)
                        if i != n//i:
                            divs.append(n//i)
                return sorted(divs)
            
            def is_norwegian(N, target):
                # check if N has three distinct positive divisors summing to target
                divs = divisors(N)
                # need three distinct
                L = len(divs)
                for i in range(L):
                    for j in range(i+1, L):
                        for k in range(j+1, L):
                            if divs[i] + divs[j] + divs[k] == target:
                                return True
                return False
            
            def f_of_n(n, max_search=1000000):
                # find smallest N that is n-Norwegian
                for N in range(1, max_search+1):
                    if is_norwegian(N, n):
                        return N
                return None
            
