            def carmichael_lambda(n):
                if n == 1:
                    return 1
                factors = sp.factorint(n)
                lambdas = []
                for p, a in factors.items():
                    if p == 2:
                        if a == 1:
                            lam = 1
                        elif a == 2:
                            lam = 2
                        else:
                            lam = 2**(a-2)
                    else:
                        lam = (p-1) * p**(a-1)
                    lambdas.append(lam)
                # lcm of lambdas
                from math import gcd
                l = 1
                for lam in lambdas:
                    l = l * lam // gcd(l, lam)
                return l
            
            # test
            print(carmichael_lambda(9), carmichael_lambda(8), carmichael_lambda(15))
            
