            import math, itertools
            
            def f_bruteforce(n):
                best = None
                best_trip = None
                # search a<b<c distinct positive ints sum to n
                for a in range(1, n-2):
                    for b in range(a+1, n-a-1):
                        c = n - a - b
                        if c <= b: continue
                        # distinct automatically as c>b
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
            def f_formula_a1(n):
                N = n-1
                # find largest divisor d of N with d <= N//3
                best = 0
                for d in range(1, int(math.isqrt(N))+1):
                    if N % d == 0:
                        # d and N//d are divisors
                        if d <= N//3 and d > best:
                            best = d
                        d2 = N//d
                        if d2 <= N//3 and d2 > best:
                            best = d2
                if best == 0:
                    return None
                return N - best
            
