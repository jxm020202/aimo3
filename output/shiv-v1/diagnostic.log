            def f_formula(n):
                # compute smallest divisor t>=3 of n-1
                m = n-1
                # find smallest divisor >=3
                t = None
                # check divisibility by 3,4,... but we need divisor (not necessarily prime)
                for d in range(3, int(math.isqrt(m))+1):
                    if m % d == 0:
                        t = d
                        break
                if t is None:
                    # m itself is prime >2, t = m
                    t = m
                # compute x
                x = (n-1)*(t-1)//t
                return x, t
            
            def compare(N):
                mismatches=[]
