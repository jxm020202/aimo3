            def construct_f(n):
                m = n+1
                d = math.gcd(866, n)
                # compute T mapping
                def T(x):
                    return ((866*x - 1) % n) + 1
                # compute fibers of T: for each y, list of x mapping to y
                fibers_T = {}
                for x in range(1, n+1):
                    y = T(x)
                    fibers_T.setdefault(y, []).append(x)
                # image set
                image_T = set(fibers_T.keys())
                # compute phi map
                def phi(a):
                    return pow(a, 866, m)
                # compute fibers of phi: for each b, list of a mapping to b
                fibers_phi = {}
                for a in range(1, n+1):
                    b = phi(a)
                    if b == 0:
                        # ignore, shouldn't happen for prime m
                        continue
                    fibers_phi.setdefault(b, []).append(a)
                # image of phi
                image_phi = set(fibers_phi.keys())
                # check sizes
                assert len(image_T) == len(image_phi) == n//d
                # each fiber size should be d
                for lst in fibers_T.values():
                    assert len(lst) == d
                for lst in fibers_phi.values():
                    assert len(lst) == d
                # create bijection mapping
                f = {}
                # map even y (image_T) to quadratic residues (image_phi) via arbitrary bijection
                # sort lists for deterministic mapping
                image_T_list = sorted(image_T)
                image_phi_list = sorted(image_phi)
                # map each y to corresponding b
                for y, b in zip(image_T_list, image_phi_list):
                    # assign f(y) = b
                    f[y] = b
                    # assign preimages
                    xs = fibers_T[y]
                    as_ = fibers_phi[b]
                    # assign each x to a distinct a
                    for x_val, a_val in zip(xs, as_):
                        f[x_val] = a_val
                # remaining elements (odd y not in image_T) and remaining a not used
                used_vals = set(f.values())
                remaining_vals = [a for a in range(1, n+1) if a not in used_vals]
                remaining_keys = [y for y in range(1, n+1) if y not in f]
                # assign arbitrarily
                for y, a in zip(remaining_keys, remaining_vals):
                    f[y] = a
                # return f as dict
                return f
            
