            def cycles_perm(mapping):
                n = len(mapping)-1  # mapping index from 1..n
                visited = [False]*(n+1)
                lengths = []
                for i in range(1,n+1):
                    if not visited[i]:
                        cur = i
                        cnt = 0
                        while not visited[cur]:
                            visited[cur]=True
                            cur = mapping[cur]
                            cnt+=1
                        lengths.append(cnt)
                lengths.sort()
                return tuple(lengths)
            
            def check_n(n):
                # condition: n >= 866
                if n < 866:
                    return False
                # compute T mapping
                T = [0]*(n+1)
                for x in range(1,n+1):
                    y = (866*x) % n
                    if y==0:
                        y=n
                    T[x]=y
                # compute g mapping
                mod = n+1
                # check squarefree condition: ensure no i gives 0
                for i in range(1,n+1):
                    if pow(i,866,mod)==0:
                        return False
                G = [0]*(n+1)
                for i in range(1,n+1):
                    G[i]=pow(i,866,mod)
                    # ensure not zero (already checked)
                # compute cycle length multisets
                cycles_T = cycles_perm(T)
                cycles_G = cycles_perm(G)
                return cycles_T == cycles_G
            
            def find_min(limit=20000):
                for n in range(866, limit+1):
                    if check_n(n):
                        return n
                return None
            
            print(find_min(5000))
            
