            import math, itertools
            
            def f_bruteforce(n, limit=200):
                # search N up to limit
                # find smallest N that has three distinct divisors sum n
                for N in range(1, limit+1):
                    divs = [d for d in range(1, N+1) if N % d == 0]
                    # need three distinct
                    for combo in itertools.combinations(divs, 3):
                        if sum(combo) == n:
                            return N
                return None
            
            def f_formula(n):
                # compute min lcm(a,b) with a+b=n-1, a,b>1 distinct
                best = None
                for a in range(2, n-2):
                    b = n-1-a
                    if b<=1 or b==a:
                        continue
                    l = a*b//math.gcd(a,b)
                    if best is None or l<best:
                        best = l
                # also consider triples? but we ignore for now
                return best
            
            def f_bruteforce_general(n):
                # compute exact f(n) by brute up to some bound
                # search N up to maybe 5000
                for N in range(1, 5000):
                    divs = [d for d in range(1, N+1) if N % d == 0]
                    for combo in itertools.combinations(divs, 3):
                        if sum(combo) == n:
                            return N
                return None
            
            for n in range(6, 31):
                f1 = f_bruteforce_general(n)
                f2 = f_formula(n)
                print(n, f1, f2, f1==f2)
            
