            def f_candidate_pattern(n):
                best = None
                # pattern: a = d, b = 2d, c = n - 3d
                # need distinct: d != 2d (true), c != d, c != 2d
                # require c > 0, distinctness c != 2d => n-3d != 2d => n != 5d
                # Also need c integer positive.
                for d in range(1, n//3):
                    c = n - 3*d
                    if c <= 0:
                        continue
                    if c == d or c == 2*d:
                        continue
                    L = sp.ilcm(d, 2*d, c)  # which is lcm(2d,c)
                    if best is None or L < best:
                        best = L
                return best
            
