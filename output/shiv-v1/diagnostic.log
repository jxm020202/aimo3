            def f_formula(n):
                N = n - 1
                # find smallest divisor k >= 3 of N
                # if N is divisible by 3, k=3 else find smallest prime divisor >=3
                # if N is prime (i.e., no divisor), then we need fallback? but we assume divisor exists
                # find smallest divisor d >= 3
                for d in range(3, int(N**0.5)+1):
                    if N % d == 0:
                        k = d
                        break
                else:
                    k = N  # prime
                # compute L = N * (k-1) // k (integer division)
                L = N * (k-1) // k
                return L
            
            def f_bruteforce_n(n):
