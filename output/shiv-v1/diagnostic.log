            def component_structure(func):
                n = len(func)
                visited = [False]*n
                comps = []
                for i in range(n):
                    if not visited[i]:
                        # follow orbit
                        cur = i
                        path = {}
                        steps = 0
                        while cur not in path:
                            path[cur] = steps
                            steps += 1
                            cur = func[cur]-1  # convert to 0-index
                        # found cycle start
                        cycle_start = path[cur]
                        cycle_len = steps - cycle_start
                        # nodes in component
                        comp_nodes = list(path.keys())
                        # record depths
                        depths = {}
                        for node, idx in path.items():
                            if idx < cycle_start:
                                depths[node] = cycle_start - idx
                            else:
                                depths[node] = 0
                        comps.append((cycle_len, sorted(depths.values())))
                        # mark visited
                        for node in comp_nodes:
