            import sympy as sp
            
            def is_squarefree(num):
                fac=sp.factorint(num)
                for e in fac.values():
                    if e>1:
                        return False
                return True
            
            def get_cycle_data(n):
                T=[0]*(n+1)
                for x in range(1,n+1):
                    y=(866*x)%n
                    if y==0:
                        y=n
                    T[x]=y
                mod=n+1
                G=[0]*(n+1)
                for i in range(1,n+1):
                    G[i]=pow(i,866,mod)
                return T,G
            
            def canonical_component_reps(mapping):
                n=len(mapping)-1
                rep=[0]*(n+1)
                dist=[-1]*(n+1)
                for i in range(1,n+1):
                    if dist[i]!=-1:
                        continue
                    path=[]
                    cur=i
                    while True:
                        if dist[cur]!=-1:
                            # reached known node
                            break
                        if cur in path:
                            # found cycle
                            break
                        path.append(cur)
                        cur=mapping[cur]
                    if dist[cur]!=-1:
                        base_rep=rep[cur]
                        base_dist=dist[cur]
                        for node in reversed(path):
                            base_dist+=1
                            rep[node]=base_rep
                            dist[node]=base_dist
                    else:
                        idx=path.index(cur)
                        cycle_nodes=path[idx:]
                        for node in cycle_nodes:
                            rep[node]=node
                            dist[node]=0
                        for node in reversed(path[:idx]):
                            nxt=mapping[node]
                            rep[node]=rep[nxt]
                            dist[node]=dist[nxt]+1
                # reverse adjacency
                rev=[[] for _ in range(n+1)]
                for i in range(1,n+1):
                    rev[mapping[i]].append(i)
                from functools import lru_cache
                @lru_cache(None)
                def tree_canonical(v):
                    child_forms=[]
                    for u in rev[v]:
                        # exclude predecessor that is previous cycle node if both are cycle nodes
                        if dist[u]==0 and dist[v]==0:
                            continue
                        child_forms.append(tree_canonical(u))
                    child_forms.sort()
                    return '(' + ''.join(child_forms) + ')'
                visited_cycle=set()
                components=[]
                for v in range(1,n+1):
                    if dist[v]==0 and v not in visited_cycle:
                        cyc=[]
                        cur=v
                        while cur not in visited_cycle:
                            cyc.append(cur)
                            visited_cycle.add(cur)
                            cur=mapping[cur]
                        forms=[tree_canonical(node) for node in cyc]
                        L=len(forms)
                        best=None
                        for shift in range(L):
                            rot=tuple(forms[(i+shift)%L] for i in range(L))
                            if best is None or rot<best:
                                best=rot
                        components.append(best)
                components.sort()
                return components
            
            def graphs_isomorphic(T,G):
                return canonical_component_reps(T)==canonical_component_reps(G)
            
            def exists_solution(n):
                if not is_squarefree(n+1):
                    return False
                T,G=get_cycle_data(n)
                return graphs_isomorphic(T,G)
            
            def find_min_candidate(limit):
                for n in range(866, limit+1):
                    if exists_solution(n):
                        return n
                return None
            
