            def spf(x):
                # smallest prime factor
                if x%2==0:
                    return 2
                p=3
                while p*p<=x:
                    if x%p==0:
                        return p
                    p+=2
                return x
            
            def f_spf_formula(n):
                s=n-1
                p=spf(s)
                if p==s: # prime
                    return None
                return s-p
            
