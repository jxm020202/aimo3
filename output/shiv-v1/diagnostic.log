            def smallest_odd_prime_factor(num):
                # return smallest odd prime divisor of num, or None if none (i.e., num is power of 2)
                # trial division up to sqrt
                n = num
                # remove factors of 2
                while n % 2 == 0:
                    n //= 2
                if n == 1:
                    return None
                # trial division up to sqrt
                p = 3
                while p * p <= n:
                    if n % p == 0:
                        return p
                    p += 2
                return n  # n is prime
            
