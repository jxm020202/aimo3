            def f_bruteforce(n):
                # compute minimal LCM of three distinct positive integers summing to n
                best = None
                for a in range(1, n-1):
                    for b in range(a+1, n):
                        c = n - a - b
                        if c <= b or c <= 0:
                            continue
                        # distinct a<b<c
                        L = sp.ilcm(a, b, c)  # sympy's lcm
                        if best is None or L < best:
                            best = L
                return best
            
            for n in range(6, 20):
                print(n, f_bruteforce(n))
            
