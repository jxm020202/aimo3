            def smallest_divisor_rule(c, max_d=5000):
                # returns smallest d>1, d!=2, such that:
                # if d is power of 3: (c-1) % d == 0
                # else if gcd(d,3)==1: c % d == 0
                # else need full check (but we can ignore for now)
                for d in range(3, max_d+1):
                    if d == 2:
                        continue
                    # check if d is power of 3
                    temp = d
                    is_pow3 = True
                    while temp % 3 == 0 and temp > 1:
                        temp //= 3
                    if temp != 1:
                        is_pow3 = False
                    if is_pow3:
                        if (c - 1) % d == 0:
