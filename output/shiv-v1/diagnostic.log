            def functional_structure(n, mapping):
                # mapping dict from 1..n to 1..n
                visited = [False]*(n+1)
                components = []
                for i in range(1, n+1):
                    if not visited[i]:
                        # traverse to find cycle
                        path = []
                        cur = i
                        while not visited[cur]:
                            visited[cur] = True
                            path.append(cur)
                            cur = mapping[cur]
                        # now cur is already visited, could be part of current path (cycle) or earlier component
                        if cur in path:
                            # cycle found
                            idx = path.index(cur)
                            cycle = path[idx:]
                            # compute depths for nodes in cycle (depth 0)
                            # for nodes before cycle in path, compute distance to cycle
                            depths = {}
                            for node in cycle:
                                depths[node] = 0
                            # process nodes before cycle in reverse order
                            for node in reversed(path[:idx]):
                                # node maps to next node (already processed)
                                depths[node] = depths[mapping[node]] + 1
                            # Now we have depths for all nodes in this component
                            # For each cycle node, collect depths of nodes that map (directly or indirectly) to it
                            # We'll compute list of multiset of depths attached to each cycle node
                            attach = {c: [] for c in cycle}
                            for node in path[:idx]:
                                # find which cycle node it's attached to: follow mapping until reach cycle node
                                cur2 = node
                                while depths[cur2] != 0:
                                    cur2 = mapping[cur2]
                                # cur2 is the cycle node
                                attach[cur2].append(depths[node])
                            # For each cycle node, sort its attached depths
                            comp = (len(cycle), tuple(sorted([tuple(sorted(attach[c])) for c in cycle])))
                            components.append(comp)
                        else:
                            # cur belongs to a previously discovered component; we can ignore because nodes already accounted
                            pass
                # sort components multiset
                components.sort()
                return tuple(components)
            
