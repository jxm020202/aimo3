            def minimal_t_for_c(c, max_t=5000):
                # returns minimal t such that c can be expressed as sum of two distinct numbers from D(t)
                # D(t) = {d * 3**k | d divides t, k >=0}
                # We only need numbers <= c (since sum of two positive numbers = c)
                import math
                # precompute divisors for each t as needed
                for t in range(1, max_t+1):
                    # compute divisors of t
                    divs = []
                    for i in range(1, int(math.isqrt(t))+1):
                        if t % i == 0:
                            divs.append(i)
                            if i != t//i:
                                divs.append(t//i)
                    # generate numbers <= c
                    nums = set()
                    # compute max exponent such that d*3^k <= c
                    max_k = 0
                    # we can compute max exponent for smallest divisor (1) => 3^k <= c => k <= floor(log_3(c))
                    # compute log_3
                    # We'll just loop while 3**k <= c
                    pow3 = 1
                    ks = []
                    while pow3 <= c:
                        ks.append(pow3)
                        pow3 *= 3
                    # ks list of 3^k values
                    for d in divs:
                        for p in ks:
                            val = d * p
                            if val <= c:
                                nums.add(val)
                            else:
                                break
                    # need two distinct numbers sum to c
