            def f_estimate(n):
                # bound using divisor of n-1
                if n-1 <= 1:
                    return None
                # find smallest divisor >1 of n-1
                d = None
                for i in range(2, int(math.isqrt(n-1))+1):
                    if (n-1) % i == 0:
                        d = i
                        break
                if d is None:
                    # n-1 prime
                    return None
                # ensure distinctness: need d != (n-1)//2
                if d == (n-1)//2:
                    # then b = d, not distinct, need next divisor maybe
                    # find another divisor
