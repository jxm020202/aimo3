            def N_mod_func_factory(c_type, c_val):
                # c_type: 0 for small integer c, 1 for multiple of M (k*M)
                if c_type == 0:
                    c = c_val
                    def N_mod(m):
                        return (pow(3, E, m) + c % m) % m
                    return N_mod
                elif c_type == 1:
                    k = c_val  # integer multiplier of M
                    def N_mod(m):
