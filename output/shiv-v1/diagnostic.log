            def construct_f(n):
                # get cycles of h and phi as lists of lists
                # h: multiplication by 866 modulo n on residues 0..n-1, map 0->n
                a = 866 % n
                visited = [False]*n
                h_cycles = []
                for i in range(n):
                    if not visited[i]:
                        cur = i
                        cyc = []
                        while not visited[cur]:
                            visited[cur] = True
                            cyc.append(cur)
                            cur = (a*cur) % n
                        h_cycles.append(cyc)
                # phi cycles
                m = n+1
                visited = [False]*m
                phi_cycles = []
                for x in range(1, m):
                    if not visited[x]:
                        cur = x
                        cyc = []
                        while not visited[cur]:
                            visited[cur] = True
                            cyc.append(cur)
                            cur = pow(cur, 866, m)
                        phi_cycles.append(cyc)
                # Now map cycles of same length
                # sort cycles by length
                h_cycles.sort(key=len)
                phi_cycles.sort(key=len)
                # ensure same multiset lengths
                if [len(c) for c in h_cycles] != [len(c) for c in phi_cycles]:
                    raise ValueError("Lengths mismatch")
                f = {}
                for hc, pc in zip(h_cycles, phi_cycles):
