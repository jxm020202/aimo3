            import sympy as sp
            
            def is_squarefree(m):
                return sp.factorint(m).values() and all(exp==1 for exp in sp.factorint(m).values())
            
            def perm_cycle_type(perm):
                # perm is dict mapping 0..n-1 to 0..n-1 (or 1..n)
                n = len(perm)
                visited = [False]*n
                cycles = []
                for i in range(n):
                    if not visited[i]:
                        cur = i
                        length = 0
                        while not visited[cur]:
                            visited[cur]=True
                            cur = perm[cur]
                            length+=1
                        cycles.append(length)
                cycles.sort()
                return tuple(cycles)
            
            def check_n(n):
                if sp.gcd(866, n) != 1:
                    return False
                m = n+1
                if not is_squarefree(m):
                    return False
                # compute permutation g on 0..n-1 (representing 1..n with 0 as n)
                g = {}
                for x in range(n):
                    y = (866 * x) % n
                    g[x] = y
                # compute permutation h on 1..n (we will index 0..n-1 for convenience)
                h = {}
                for a in range(1, n+1):
                    b = pow(a, 866, m)
                    if b == 0:
                        # shouldn't happen for squarefree m
                        return False
                    h[a-1] = b-1  # map to 0-index
                # compare cycle types
                ct_g = perm_cycle_type(g)
                ct_h = perm_cycle_type(h)
                return ct_g == ct_h
            
            def find_min(limit=2000):
                for n in range(866, limit+1):
                    if check_n(n):
                        return n
                return None
            
            print(find_min(2000))
            
