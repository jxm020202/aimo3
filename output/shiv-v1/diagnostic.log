            def cycle_lengths_mul(a, mod):
                # permutation on 0..mod-1 given by x -> a*x mod mod
                visited = [False]*mod
                lengths = []
                for i in range(mod):
                    if not visited[i]:
                        # start cycle
                        cur = i
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = (a*cur) % mod
                            cnt += 1
                        lengths.append(cnt)
                return sorted(lengths)
            
            def cycle_lengths_pow(k, mod):
                # permutation on 1..mod-1 given by x -> x**k mod mod (value in 1..mod-1)
                visited = [False]*mod  # index 0 unused
                lengths = []
                for x in range(1, mod):
                    if not visited[x]:
                        cur = x
                        cnt = 0
                        while not visited[cur]:
                            visited[cur] = True
                            cur = pow(cur, k, mod)
                            cnt += 1
                        lengths.append(cnt)
                return sorted(lengths)
            
            def exists_f(n):
                # compute cycle lengths
                h_lengths = cycle_lengths_mul(866, n)  # includes 0..n-1
                # but our domain is 1..n, where n corresponds to 0 residue.
                # So we need to map 0 to n. The cycle lengths are same.
