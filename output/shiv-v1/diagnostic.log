            def carmichael(n):
                # compute Carmichael function lambda(n)
                fac = sp.factorint(n)
                vals = []
                for p, e in fac.items():
                    if p == 2:
                        if e == 1:
                            lam = 1
                        elif e == 2:
                            lam = 2
                        else:
                            lam = 2**(e-2)
                    else:
                        lam = (p-1) * p**(e-1)  # phi(p^e)
                    vals.append(lam)
                # lcm of all lam
                from math import gcd
                l = 1
                for val in vals:
                    l = l * val // gcd(l, val)
                return l
            
            def factorial_mod_n(n, mod):
                res = 1 % mod
                for i in range(2, n+1):
                    res = (res * i) % mod
                return res
            
            def M_mod(d):
                # compute 3^{2025!} mod d
                # factor out powers of 3
                e = 0
                temp = d
                while temp % 3 == 0 and temp > 0:
                    e += 1
                    temp //= 3
                d1 = temp
                # remainder modulo 3^e part
                # if e>0, remainder is 0 because exponent >= e
                rem_mod_3e = 0 if e > 0 else None
                # remainder modulo d1
                if d1 == 1:
                    r1 = 0
                else:
                    lam = carmichael(d1)
                    exp_mod = factorial_mod_n(2025, lam)  # 2025! mod lam
                    # if exp_mod == 0, set exponent = lam (since a^0 =1 but we need a^{lam} =1)
                    # Actually pow(3,0, d1) =1 mod d1, which is correct because exponent multiple of lam => 3^{lam} ≡1 => 3^{F} ≡1
                    r1 = pow(3, exp_mod, d1)
                # combine using CRT
                if e == 0:
                    return r1 % d
                else:
                    # modulus components: m1 = 3**e, r1_mod = 0; m2 = d1, r2 = r1
                    m1 = 3**e
                    m2 = d1
                    # Use sympy.crt
                    # sympy.crt returns (solution, lcm)
                    sol, lcm = sp.crt([m1, m2], [0, r1])
                    return int(sol % d)
            
