            def f_fast(N):
                # compute minimal c using divisor search for each c from lower bound
                lower = (N+2)//3  # ceil((N+2)/3)
                for c in range(lower, N):
                    target = N - c
                    # find divisors of c
                    # we can get divisors efficiently via factorization
                    divs = []
                    # factor c using trial division up to sqrt
                    i=1
                    # we need all proper divisors less than c
                    # naive method: iterate up to sqrt
                    for d in range(1, int(math.isqrt(c))+1):
                        if c % d == 0:
                            divs.append(d)
                            if d != c//d:
                                divs.append(c//d)
                    # remove c itself
                    divs = [d for d in divs if d < c]
                    # need two distinct sum to target
                    sset = set(divs)
                    for a in divs:
                        b = target - a
                        if b != a and b in sset:
                            return c
                return None
            
            def test_k(k, maxc0):
                M = 3**k
                res = {}
                for c0 in range(maxc0+1):
                    N = M + c0
                    c = f_fast(N)
                    res[c0] = c
                return res
            
