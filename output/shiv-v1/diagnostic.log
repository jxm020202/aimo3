            import math, itertools
            
            def f_bruteforce(n):
                # compute minimal lcm of three distinct positive integers summing to n
                best = None
                best_triplet = None
                # naive: iterate a<b<c positive ints with sum n, compute lcm
                for a in range(1, n-2):
                    for b in range(a+1, n-a-1):
                        c = n - a - b
                        if c <= b: continue
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_triplet = (a,b,c)
                return best, best_triplet
            
            def f_via_c(n):
                # using min c approach: find minimal c such that exists proper divisors a,b distinct with a+b = n-c
                bestc = None
                bestab = None
                for c in range(1, n):
                    # need a,b distinct proper divisors of c (i.e., <c)
                    target = n - c
                    # find divisors of c
                    divs = [d for d in range(1,c) if c % d == 0]
                    # need two distinct from divs sum to target
                    found=False
                    for i in range(len(divs)):
                        for j in range(i+1,len(divs)):
                            if divs[i]+divs[j]==target:
                                found=True
                                a,b=divs[i],divs[j]
                                break
                        if found: break
                    if found:
                        bestc = c
                        bestab = (a,b)
                        break
                return bestc, bestab
            
            def test_M(k, maxc0):
                M = 3**k
                results = {}
                for c0 in range(maxc0+1):
                    n = M + c0
                    f_val,_ = f_bruteforce(n)
                    f_c,_ = f_via_c(n)
                    results[c0] = (f_val, f_c)
                return results
            
