            def cycles_perm(mapping):
                n = len(mapping)-1  # mapping[1..n]
                visited = [False]*(n+1)
                cycles = []
                for i in range(1, n+1):
                    if not visited[i]:
                        cur = i
                        cyc = []
                        while not visited[cur]:
                            visited[cur] = True
                            cyc.append(cur)
                            cur = mapping[cur]
                        cycles.append(cyc)
                return cycles
            
            def check_n(n):
                # compute h mapping
                h = [0]*(n+1)
                for x in range(1, n+1):
                    y = ((866*x - 1) % n) + 1
                    h[x] = y
                # check h is permutation
                if len(set(h[1:])) != n:
                    return False
                # compute phi mapping
                phi = [0]*(n+1)
                for a in range(1, n+1):
