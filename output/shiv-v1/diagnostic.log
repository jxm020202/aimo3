            def exists_f_backtrack_limit(n, time_limit=5):
                import time, sys
                start = time.time()
                mod = n+1
                # compute y mapping
                y_of = {}
                for x in range(1,n+1):
                    y = (866*x) % n
                    if y == 0:
                        y = n
                    y_of[x] = y
                # precompute h(a)
                h = {a: pow(a,866,mod) for a in range(1,n+1)}
                # check no zero
                if any(v==0 for v in h.values()):
                    return False, None
                # domains: each variable can be any 1..n initially
                # We'll use recursion with forward propagation
                used = [False]*(n+1)
                f = [0]*(n+1)
                # order nodes maybe by indegree? compute indegree
                indeg = {i:0 for i in range(1,n+1)}
                for x in range(1,n+1):
                    indeg[y_of[x]]+=1
                # sort nodes by indegree descending (process sources first)
                order = sorted(range(1,n+1), key=lambda i: indeg[i])
                # recursion
                sys.setrecursionlimit(10000)
                def dfs(idx):
                    if time.time() - start > time_limit:
                        raise TimeoutError
                    if idx == n:
                        return True
                    x = order[idx]
                    if f[x]!=0:
                        return dfs(idx+1)
                    # possible values for f(x) are those not used
                    for a in range(1,n+1):
                        if used[a]:
                            continue
                        # assign a to f(x)
                        # enforce constraint on y = g(x)
                        y = y_of[x]
                        b = h[a]
                        if b==0:
                            continue
                        # if f(y) already assigned, must match b
                        if f[y]!=0 and f[y]!=b:
                            continue
                        # also need that if y has other predecessors already assigned, their constraints must be consistent with b
                        consistent=True
                        # check predecessors p where g(p)=y
                        for p in range(1,n+1):
                            if y_of[p]==y and f[p]!=0:
                                if h[f[p]] != b:
                                    consistent=False
                                    break
                        if not consistent:
                            continue
                        # assign
                        used[a]=True
                        f[x]=a
                        # assign f(y) if not assigned
                        assigned_y=False
                        if f[y]==0:
                            if used[b]:
                                # b already used elsewhere, cannot assign
                                used[a]=False
                                f[x]=0
                                continue
                            used[b]=True
                            f[y]=b
                            assigned_y=True
                        # recurse
                        if dfs(idx+1):
                            return True
                        # backtrack
                        used[a]=False
                        f[x]=0
                        if assigned_y:
                            used[b]=False
                            f[y]=0
                    return False
                try:
                    res = dfs(0)
                except TimeoutError:
                    return False, None
                return res, f[1:] if res else None
            
