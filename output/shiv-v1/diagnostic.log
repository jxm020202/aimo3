            import math
            def carmichael_lambda(m):
                fac = sp.factorint(m)
                lambdas = []
                for p, e in fac.items():
                    if p == 2:
                        if e == 1:
                            lam = 1
                        elif e == 2:
                            lam = 2
                        else:
                            lam = 2**(e-2)
                    else:
                        lam = (p-1) * p**(e-1)  # φ(p^e)
                    lambdas.append(lam)
                # lcm of list
                l = 1
                for lam in lambdas:
                    l = l * lam // math.gcd(l, lam)
                return l
            
