            from sympy import factorint
            from sympy.ntheory.modular import crt
            
            def M_mod(d):
                fac = factorint(d)
                residues = []
                moduli = []
                for p, exp in fac.items():
                    mod = p**exp
                    if p == 3:
                        residues.append(0)
                        moduli.append(mod)
                    else:
                        phi = mod - mod//p
                        phi_int = int(phi)
                        # compute 2025! mod phi
                        fact_mod = 1
                        for i in range(2, 2025+1):
                            fact_mod = (fact_mod * i) % phi_int
                        e = fact_mod
                        if e == 0:
                            e = phi_int
                        res = pow(3, e, mod)
                        residues.append(res)
                        moduli.append(mod)
                if len(moduli) == 1:
                    return residues[0] % moduli[0]
                sol, lcm_val = crt(moduli, residues)
                return int(sol % lcm_val)
            
            def precompute_M_mod(limit):
                M_mods = {}
                for d in range(1, limit+1):
                    M_mods[d] = M_mod(d)
                return M_mods
            
