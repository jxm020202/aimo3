            def f_brutal(n):
                # find smallest N with three distinct divisors sum to n
                for N in range(1,500):
                    divs = [d for d in range(1,N+1) if N%d==0]
                    # need three distinct positive divisors
                    for i in range(len(divs)):
                        for j in range(i+1,len(divs)):
                            for k in range(j+1,len(divs)):
                                if divs[i]+divs[j]+divs[k]==n:
                                    return N
                return None
            
            def f_formula(n):
                s=n-1
                # find smallest prime factor
                from sympy import factorint
                fac = factorint(s)
                if len(fac)==0:
                    return None
                if len(fac)==1 and list(fac.values())[0]==1 and list(fac.keys())[0]==s:
                    # s prime
                    return None
                # smallest prime factor
                p=min(fac.keys())
                return s-p
            
            for n in range(6,21):
                brute=f_brutal(n)
                formula=f_formula(n)
                print(n, brute, formula)
            
