            def f_bruteforce(n):
                best = None
                best_trip = None
                # iterate distinct triples a<b<c positive sum n
                for a in range(1, n-1):
                    for b in range(a+1, n):
                        c = n - a - b
                        if c <= b: continue
                        # distinct automatically a<b<c
                        l = (a*b*c)//math.gcd(a, math.gcd(b,c))
                        # Actually lcm of three numbers
                        # compute using math.lcm (py3.9)
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
            import math, itertools, sys, random, time, functools, collections, math, itertools, sympy as sp
            def f_two(n):
                # using 1, a, b
                S = n-1
                best = None
                best_pair = None
                for a in range(2, S-1):
                    b = S - a
                    if b <= a: continue
                    if b < 2: continue
                    l = math.lcm(a,b)
                    if best is None or l < best:
                        best = l
                        best_pair = (a,b)
                return best, best_pair
            
