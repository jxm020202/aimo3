            import sympy as sp
            
            def primes_in_interval(n):
                lower = n**2
                upper = (n + sp.Rational(1,510))**2  # exact rational
                # integer p must satisfy lower < p < upper
                # So p in range(lower+1, floor(upper))
                # But need strict less than upper, so max p = floor(upper - 1e-12)
                # Since upper is rational, we can compute floor of upper - epsilon = floor(upper) if upper is not integer, else upper-1
                # Let's compute integer candidates
                up = sp.floor(upper - sp.Rational(1,10**12))  # small epsilon
                # Actually easier: if upper is integer, then p <= upper-1, else p <= floor(upper)
                if upper.is_integer:
                    maxp = int(upper) - 1
                else:
                    maxp = int(sp.floor(upper))
                candidates = list(range(lower+1, maxp+1))
                primes = [p for p in candidates if sp.isprime(p)]
                return primes, lower, upper, maxp
            
            for n in range(1,260):
                primes, lower, upper, maxp = primes_in_interval(n)
                if primes:
                    print(n, lower, upper, maxp, primes)
            
