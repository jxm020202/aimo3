def solve_min_extra(N):
    # edges mapping
    edges = {}
    idx = 0
    for i in range(N):
        for j in range(i+1,N):
            edges[(i,j)] = idx
            idx += 1
    m = idx  # number of edges
    # variables x_e integer 0-2
    c = np.ones(m)  # minimize sum x_e
    # bounds
    bounds = Bounds(0, 2)
    # integrality
    integrality = np.ones(m, dtype=int)
    # constraints: for each triangle sum >=2
    A = []
    b = []
    for i in range(N):
        for j in range(i+1,N):
            for k in range(j+1,N):
                row = np.zeros(m)
                row[edges[(i,j)]] = 1
                row[edges[(i,k)]] = 1
                row[edges[(j,k)]] = 1
                A.append(row)
                b.append(2)
    A = np.array(A)
    b = np.array(b)
    # inequality: A @ x >= b -> -A x <= -b
    lin_con = LinearConstraint(-A, -np.inf, -b)  # Actually we need -A x <= -b? Wait:
    # For milp, constraints are LinearConstraint(A_ub, lb, ub) where we can set A_ub @ x <= ub and A_ub @ x >= lb?
    # Actually LinearConstraint defines A @ x within [lb, ub].
    # So we can set A @ x >= 2 -> lb=2, ub=np.inf
    lin_con = LinearConstraint(A, 2, np.inf)
    res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={"disp": False})
    return res

