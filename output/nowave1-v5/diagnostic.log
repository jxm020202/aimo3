            def min_total_sum(N):
                edges = [(i,j) for i in range(N) for j in range(i+1,N)]
                edge_index = {e: idx for idx, e in enumerate(edges)}
                m = len(edges)
                # variables: for each edge, three binary vars: a=label1, b=label2, c=label3
                # total variables = 3*m
                var_count = 3*m
                # objective coefficients
                c = np.zeros(var_count, dtype=int)
                for idx in range(m):
                    c[3*idx] = 1   # a
                    c[3*idx+1] = 2 # b
                    c[3*idx+2] = 3 # c
                # constraints
                A = []
                lb = []
                ub = []
                # each edge: a+b+c = 1
                for idx in range(m):
                    row = np.zeros(var_count, dtype=int)
                    row[3*idx] = 1
                    row[3*idx+1] = 1
                    row[3*idx+2] = 1
                    A.append(row)
                    lb.append(1)
                    ub.append(1)
                # triangle constraints
                for i in range(N):
                    for j in range(i+1,N):
                        for k in range(j+1,N):
                            row = np.zeros(var_count, dtype=int)
                            # edges (i,j), (i,k), (j,k)
                            for (u,v) in [(i,j),(i,k),(j,k)]:
                                idx = edge_index[(u,v) if u<v else (v,u)]
                                row[3*idx] = 1   # a*1
                                row[3*idx+1] = 2 # b*2
                                row[3*idx+2] = 3 # c*3
                            A.append(row)
                            lb.append(5)
                            ub.append(np.inf)
                A = np.array(A)
                lb = np.array(lb, dtype=float)
                ub = np.array(ub, dtype=float)
                # integrality: all variables integer (binary)
                integrality = np.ones(var_count, dtype=int)
                bounds = Bounds(0,1)
                res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    raise Exception("MILP failed")
                total = sum(c[i]*round(res.x[i]) for i in range(var_count))
                return total
            
