            def min_sum_milp_n(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variables: binary for each label
                var_count = m*3
                import numpy as np
                c = np.zeros(var_count, dtype=int)
                for idx in range(m):
                    c[3*idx] = 1
                    c[3*idx+1] = 2
                    c[3*idx+2] = 3
                # equality constraints: each edge exactly one label
                A_eq = np.zeros((m, var_count), dtype=int)
                b_eq = np.ones(m, dtype=int)
                for idx in range(m):
                    A_eq[idx, 3*idx:3*idx+3] = 1
                # triangle constraints: sum >=5 => -sum <= -5
                triangles = [(i,j,k) for i in range(n) for j in range(i+1,n) for k in range(j+1,n)]
                T = len(triangles)
                A_ub = np.zeros((T, var_count), dtype=int)
                b_ub = np.full(T, -5, dtype=int)
                edge_index = {e:i for i,e in enumerate(edges)}
                for t_idx, (i,j,k) in enumerate(triangles):
                    for (u,v) in [(i,j),(i,k),(j,k)]:
                        e_idx = edge_index[(u,v)]
                        A_ub[t_idx, 3*e_idx] = -1
                        A_ub[t_idx, 3*e_idx+1] = -2
                        A_ub[t_idx, 3*e_idx+2] = -3
                from scipy.optimize import milp, LinearConstraint, Bounds
                eq_con = LinearConstraint(A_eq, b_eq, b_eq)
                ineq_con = LinearConstraint(A_ub, -np.inf, b_ub)
                bounds = Bounds(0,1)
                integrality = np.ones(var_count, dtype=int)
                res = milp(c=c, constraints=[eq_con, ineq_con], bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("fail", n, res.message)
                    return None
                total = int(round(sum(res.x * c)))
                return total
            
            for n in range(9,12):
                total = min_sum_milp_n(n)
                print(n, total, total/ math.comb(n,2))
            
