def min_extra_small(N):
    # brute force search for very small N using integer programming via brute force enumeration maybe
    # For N up to 6 maybe feasible: edges up to 15, 3^15 ~ 14 million, maybe okay for N=6.
    from itertools import product
    edges = [(i,j) for i in range(N) for j in range(i+1,N)]
    m=len(edges)
    best=10**9
    best_assign=None
    for assign in product([0,1,2], repeat=m):
        # quick pruning: sum assign already > best
        s=sum(assign)
        if s>=best: continue
        # check triangles
        ok=True
        # map edge to value
        val=dict(zip(edges, assign))
        for i in range(N):
            for j in range(i+1,N):
                for k in range(j+1,N):
                    if val[(i,j)]+val[(i,k)]+val[(j,k)]<2:
                        ok=False
                        break
                if not ok: break
            if not ok: break
        if ok:
            best=s
            best_assign=assign
    return best, best_assign

