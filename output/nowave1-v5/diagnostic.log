from math import comb
def brute_opt(n):
    # edges list
    vertices = list(range(n))
    edges = [(i,j) for i in range(n) for j in range(i+1,n)]
    m = len(edges)
    best = None
    best_assign = None
    # iterate over all labelings using base-3 representation
    total = 3**m
    # Too many for n>5
    for idx in range(total):
        # decode
        labels = {}
        x = idx
        for e in edges:
            labels[e] = (x % 3) + 1  # 1,2,3
            x //= 3
        # check triangle constraints
        ok = True
        for a in range(n):
            for b in range(a+1,n):
                for c in range(b+1,n):
                    s = labels[(a,b)] + labels[(a,c)] + labels[(b,c)]
                    if s < 5:
                        ok = False
                        break
                if not ok: break
            if not ok: break
        if not ok:
            continue
        total_sum = sum(labels[e] for e in edges)
        if best is None or total_sum < best:
            best = total_sum
            best_assign = labels.copy()
    return best, best_assign

