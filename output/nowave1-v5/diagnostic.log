            import numpy as np, math, itertools, fractions, sys, time, random, math, collections, itertools, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def solve_milp(n):
                # variables: for each edge (i,j) three binary variables for label 1,2,3
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variable order: for each edge, three binary variables (x1, x2, x3)
                var_count = 3*m
                # objective: minimize sum of labels = sum (1*x1 + 2*x2 + 3*x3)
                c = np.zeros(var_count, dtype=int)
                for e_idx in range(m):
                    c[3*e_idx] = 1
                    c[3*e_idx+1] = 2
                    c[3*e_idx+2] = 3
                # constraints:
                # each edge: x1 + x2 + x3 = 1
                A_eq = np.zeros((m, var_count), dtype=int)
                b_eq = np.ones(m, dtype=int)
                for e_idx in range(m):
                    A_eq[e_idx, 3*e_idx:3*e_idx+3] = 1
                # triangle constraints: sum of labels >=5
                # for each triple (i,j,k): sum over edges of (1*x1+2*x2+3*x3) >=5
                # which is linear: (1*x1 + 2*x2 + 3*x3) for each of the three edges sum >=5
                # Convert to -sum <= -5 (i.e., A_ub * x <= b_ub)
                triples = [(i,j,k) for i in range(n) for j in range(i+1,n) for k in range(j+1,n)]
                num_tri = len(triples)
                A_ub = np.zeros((num_tri, var_count), dtype=int)
                b_ub = -np.full(num_tri, 5, dtype=int)  # we will set -sum <= -5
                for t_idx, (i,j,k) in enumerate(triples):
                    # edges indices
                    edge_ij = edges.index((i,j))
                    edge_ik = edges.index((i,k))
                    edge_jk = edges.index((j,k))
                    for edge_idx in (edge_ij, edge_ik, edge_jk):
                        # add coefficients: - (1*x1 + 2*x2 + 3*x3)
                        A_ub[t_idx, 3*edge_idx] = -1
                        A_ub[t_idx, 3*edge_idx+1] = -2
                        A_ub[t_idx, 3*edge_idx+2] = -3
                # combine equality constraints as LinearConstraint? milp expects A_ub, A_eq separate.
                # Use LinearConstraint for equality.
                # However milp signature: milp(c, constraints=..., integrality=..., bounds=...)
                # Let's build constraints list.
                from scipy.optimize import LinearConstraint, Bounds, milp
                constraints = []
                # equality constraints
                constraints.append(LinearConstraint(A_eq, b_eq, b_eq))
                # inequality constraints
                constraints.append(LinearConstraint(A_ub, -np.inf*np.ones(num_tri), b_ub))
                # integrality
                integrality = np.ones(var_count, dtype=int)
                # bounds: each variable binary 0<=x<=1
                bounds = Bounds(0, 1)
                res = milp(c=c, constraints=constraints, integrality=integrality, bounds=bounds, options={'disp': False})
                return res
            
            # test for n=6
            res6 = solve_milp(6)
            res6.success, res6.fun
            
