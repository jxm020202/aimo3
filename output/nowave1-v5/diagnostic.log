            def point_in_polygon(pt, polygon):
                # ray casting algorithm
                x, y = pt
                inside = False
                n = len(polygon)
                for i in range(n):
                    x1, y1 = polygon[i]
                    x2, y2 = polygon[(i+1)%n]
                    # check if edge intersects ray to the right
                    if ((y1 > y) != (y2 > y)):
                        xinters = (x2 - x1) * (y - y1) / (y2 - y1) + x1
                        if xinters > x:
                            inside = not inside
                return inside
            
