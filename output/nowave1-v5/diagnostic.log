def min_extra(N):
    edges = {}
    idx = 0
    for i in range(N):
        for j in range(i+1,N):
            edges[(i,j)] = idx
            idx+=1
    m=idx
    c=np.ones(m)
    bounds=Bounds(0,2)
    integrality=np.ones(m,dtype=int)
    # constraints
    rows=[]
    lbs=[]
    for i in range(N):
        for j in range(i+1,N):
            for k in range(j+1,N):
                row=np.zeros(m)
                row[edges[(i,j)]]=1
                row[edges[(i,k)]]=1
                row[edges[(j,k)]]=1
                rows.append(row)
                lbs.append(2)
    A=np.array(rows)
    lc=LinearConstraint(A, lbs, np.inf)
    res=milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={"disp": False})
    return int(round(res.fun))

