                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                # bounds for variables: 0 <= var <= 1
                bounds = Bounds(0, 1)
                # integrality: all variables integer
                integrality = np.ones(num_vars, dtype=int)
                # solve
                res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds, integrality=integrality, options={'presolve': True})
