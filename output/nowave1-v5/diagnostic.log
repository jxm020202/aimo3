                            ub.append(-5)
                A = np.array(rows)
                ub = np.array(ub)
                # No lower bound (i.e., -inf)
                # Use LinearConstraint with ub only
                lc = opt.LinearConstraint(A, -np.inf*np.ones_like(ub), ub)
                bounds = opt.Bounds(np.ones(m), 3*np.ones(m))
                integrality = np.ones(m, dtype=int)
                res = opt.milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("Failed", res.message)
                    return None
                total = int(round(np.sum(res.x)))
                return total, res.x
            
