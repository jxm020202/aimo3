                            if ok:
                                adj[i][j]=adj[j][i]=1
                return adj
            
            def compute_stats(adj):
                n=len(adj)
                E=0
                deg=[0]*n
                for i in range(n):
                    for j in range(i+1,n):
                        if adj[i][j]:
                            E+=1
                            deg[i]+=1
                            deg[j]+=1
                sumC = sum(d*(d-1)//2 for d in deg)
                return E, sumC
            
