            def optimal_savings(n):
                # map edge to index
                edge_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1, n):
                        edge_index[(i,j)] = idx
                        idx += 1
                m = idx
                # objective coefficients
                c = -np.ones(m)  # milp minimizes, so use -1 to maximize sum
                # constraints: each triangle sum <= 4
                triangles = []
                for i in range(n):
                    for j in range(i+1, n):
                        for k in range(j+1, n):
                            # edges indices
                            e1 = edge_index[(i,j)]
                            e2 = edge_index[(i,k)]
                            e3 = edge_index[(j,k)]
                            triangles.append((e1, e2, e3))
                # Build A matrix for constraints
                A = np.zeros((len(triangles), m), dtype=int)
                for t_idx, (e1, e2, e3) in enumerate(triangles):
                    A[t_idx, e1] = 1
                    A[t_idx, e2] = 1
                    A[t_idx, e3] = 1
                # Upper bounds for each triangle sum <=4
                lb = np.full(len(triangles), -np.inf)
                ub = np.full(len(triangles), 4)
                lin_con = LinearConstraint(A, lb, ub)
                # variable bounds 0 <= s <= 2, integer
                bounds = Bounds(0, 2)
                # integrality: all variables integer
                integrality = np.ones(m, dtype=bool)
                res = milp(c=c, constraints=[lin_con], bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("Failed", n, res.message)
                    return None
                s_vals = np.rint(res.x).astype(int)  # round
                total = int(s_vals.sum())
                return total
            
            for n in range(3,9):
                print(n, optimal_savings(n))
            
