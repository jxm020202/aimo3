            from itertools import combinations
            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def solve_n(n):
                # Map edge to index
                edges = list(combinations(range(n), 2))
                m = len(edges)
                # Variables: first m are x (label 1), next m are y (label 2)
                total_vars = 2*m
                # Objective: maximize 2*sum x + 1*sum y => c = [-2,...,-1,...] for minimization? milp solves min c^T x
                # We'll set c = -objective to minimize.
                c = np.zeros(total_vars)
                c[:m] = -2.0  # x variables
                c[m:] = -1.0  # y variables
                
                # Constraints:
                A = []
                lb = []
                ub = []
                # Edge constraints: x+ y <= 1
                for i in range(m):
                    row = np.zeros(total_vars)
                    row[i] = 1
                    row[m+i] = 1
                    A.append(row)
                    lb.append(-np.inf)
                    ub.append(1.0)
                # Triangle constraints: 2*(x_ij + x_ik + x_jk) + (y_ij + y_ik + y_jk) <= 4
                edge_index = {e:i for i,e in enumerate(edges)}
                for (i,j,k) in combinations(range(n), 3):
                    row = np.zeros(total_vars)
                    # edges:
                    e1 = tuple(sorted((i,j)))
                    e2 = tuple(sorted((i,k)))
                    e3 = tuple(sorted((j,k)))
                    for e in (e1, e2, e3):
                        idx = edge_index[e]
                        row[idx] = 2.0
                        row[m+idx] = 1.0
                    A.append(row)
                    lb.append(-np.inf)
                    ub.append(4.0)
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                # Bounds for variables: 0 <= x <= 1, integer; same for y.
                bounds = Bounds(0, 1)
                # integer constraints: all variables integer
                integrality = np.ones(total_vars, dtype=int)
                # Use milp
                res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=bounds,
                           integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("Failed", n)
                    return None
                x = res.x
                # compute objective
                obj = -res.fun  # since we minimized negative
                # compute sum of x and y
                sumx = sum(x[:m])
                sumy = sum(x[m:])
                # total edges
                total_edges = m
                total_sum_labels = 3*total_edges - (2*sumx + sumy)
                return {
                    'n': n,
                    'total_edges': total_edges,
                    'sumx': sumx,
                    'sumy': sumy,
                    'objective': obj,
                    'total_sum_labels': total_sum_labels,
                    'average': total_sum_labels/total_edges
                }
            
            for n in range(3,9):
                sol = solve_n(n)
                print(sol)
            
