            def max_diff_bruteforce(n):
                from itertools import combinations
                N = n*(n-1)//2
                max_val = -1
                for mask in range(1<<N):
                    # build adjacency list
                    edges = []
                    idx=0
                    adj = [[0]*n for _ in range(n)]
                    for i in range(n):
                        for j in range(i+1,n):
                            if (mask>>idx)&1:
                                edges.append((i,j))
                                adj[i][j]=adj[j][i]=1
                            idx+=1
                    e = len(edges)
                    # compute covered pairs: pairs {u,w} such that exists v with edges (v,u) and (v,w)
                    covered=set()
                    for v in range(n):
                        neigh=[u for u in range(n) if adj[v][u]==1]
                        for a in range(len(neigh)):
                            for b in range(a+1,len(neigh)):
                                u=neigh[a]; w=neigh[b]
                                covered.add(tuple(sorted((u,w))))
                    diff = e - len(covered)
                    if diff>max_val:
                        max_val=diff
                return max_val
            
            for n in range(2,7):
                print(n, max_diff_bruteforce(n))
            
