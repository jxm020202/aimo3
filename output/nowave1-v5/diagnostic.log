            def intersect_segment(p1,p2):
                # segment p1->p2, line y=2x
                x1,y1 = p1
                x2,y2 = p2
                # param t from 0 to1: (x,y) = p1 + t*(p2-p1)
                # need y = 2x
                # y1 + t*(y2-y1) = 2*(x1 + t*(x2-x1))
                # solve for t
                dx = x2 - x1
                dy = y2 - y1
                # equation: y1 + t*dy = 2*x1 + 2*t*dx
                # => t*dy - 2*t*dx = 2*x1 - y1
                # => t*(dy - 2*dx) = 2*x1 - y1
                denom = dy - 2*dx
                if abs(denom) < 1e-9:
                    return None
                t = (2*x1 - y1)/denom
                if 0 <= t <= 1:
                    x = x1 + t*dx
                    y = y1 + t*dy
                    return (x,y)
                else:
                    return None
            
