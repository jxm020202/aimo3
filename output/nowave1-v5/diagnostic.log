def feasible(m):
    if m % 2 != 0:
        return False
    V = m//2 + 2
    k = len(pairs)
    c = np.zeros(k, dtype=int)  # objective zero, we just need feasibility
    # constraints matrix A x = b (equality)
    A_eq = np.zeros((3, k), dtype=int)
    b_eq = np.zeros(3, dtype=int)
    # sum n_i = V
    A_eq[0,:] = 1
    b_eq[0] = V
    # sum a_i n_i = m
    A_eq[1,:] = [a for a,b in pairs]
    b_eq[1] = m
    # sum b_i n_i = 2m
    A_eq[2,:] = [b for a,b in pairs]
    b_eq[2] = 2*m
    # Use LinearConstraint for equality
    lincon = LinearConstraint(A_eq, b_eq, b_eq)
    # bounds: n_i >= 0, integer
    bounds = Bounds(0, np.inf)
    # integrality: all variables integer
    integrality = np.ones(k, dtype=int)
    # solve MILP
    res = milp(c, constraints=lincon, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
    return res.success

