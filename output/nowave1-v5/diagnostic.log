def lp_max_m():
    k = len(types)
    # objective: maximize sum a_i n_i => minimize -a_i
    c = -np.array([a for a,b,d in types], dtype=float)
    # constraints: A_eq x = b_eq
    A_eq = np.zeros((2,k))
    b_eq = np.zeros(2)
    # sum d_i n_i = 48
    A_eq[0,:] = [d for a,b,d in types]
    b_eq[0] = 48
    # sum c_i n_i = 0
    A_eq[1,:] = [b - 2*a for a,b,d in types]
    b_eq[1] = 0
    bounds = [(0, None)]*k
    res = linprog(c, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method='highs')
