            def min_total_sum_n(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                c = np.ones(m)  # minimize sum
                integrality = np.ones(m, dtype=int)
                bounds = Bounds([1]*m, [3]*m)
                # Build constraints matrix
                rows = []
                lbs = []
                ubs = []
                for (i,j,k) in itertools.combinations(range(n),3):
                    row = np.zeros(m)
                    row[edges.index((i,j) if i<j else (j,i))] = 1
                    row[edges.index((i,k) if i<k else (k,i))] = 1
                    row[edges.index((j,k) if j<k else (k,j))] = 1
                    rows.append(row)
                    lbs.append(5)
                    ubs.append(np.inf)
                A = np.vstack(rows) if rows else np.zeros((0,m))
