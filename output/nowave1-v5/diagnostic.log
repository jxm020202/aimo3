import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds

def max_m():
    k = len(types)
    # objective: maximize sum a_i n_i => minimize -a_i
    c = -np.array([a for a,b,d in types], dtype=int)
    # constraints: A_eq x = b_eq
    A_eq = np.zeros((2, k), dtype=int)
    b_eq = np.zeros(2, dtype=int)
    # sum d_i n_i = 48
    A_eq[0,:] = [d for a,b,d in types]
    b_eq[0] = 48
    # sum b_i n_i - 2 sum a_i n_i = 0
    A_eq[1,:] = [b - 2*a for a,b,d in types]
    b_eq[1] = 0
    lincon = LinearConstraint(A_eq, b_eq, b_eq)
    bounds = Bounds(0, np.inf)
    integrality = np.ones(k, dtype=int)
    res = milp(c, constraints=lincon, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
    if not res.success:
        return None
    n = np.rint(res.x).astype(int)
    m_val = int(np.dot([a for a,b,d in types], n))
    return m_val, n

