            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def min_sum_milp(n):
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variables: for each edge, three binary vars
                var_count = m*3
                c = np.zeros(var_count, dtype=int)
                # objective coefficients: weight
                for idx in range(m):
                    c[3*idx] = 1
                    c[3*idx+1] = 2
                    c[3*idx+2] = 3
                # constraints:
                # each edge exactly one label
                A_eq = np.zeros((m, var_count), dtype=int)
                b_eq = np.ones(m, dtype=int)
                for idx in range(m):
                    A_eq[idx, 3*idx:3*idx+3] = 1
                # triangle constraints: sum >=5
                triangles = [(i,j,k) for i in range(n) for j in range(i+1,n) for k in range(j+1,n)]
                T = len(triangles)
                A_ub = np.zeros((T, var_count), dtype=int)
                b_ub = np.full(T, -5)  # we will convert >= to <= by multiplying -1
                # Actually we need inequality of form A x >= 5 -> -A x <= -5
                for t_idx, (i,j,k) in enumerate(triangles):
                    # edges indices
                    e1 = edges.index((i,j))
                    e2 = edges.index((i,k))
                    e3 = edges.index((j,k))
                    # For each edge, add weight coefficients to A_ub (negative)
                    for e in [e1,e2,e3]:
                        # weight contributions: 1*y1 + 2*y2 + 3*y3
                        A_ub[t_idx, 3*e] = -1
                        A_ub[t_idx, 3*e+1] = -2
                        A_ub[t_idx, 3*e+2] = -3
                # combine equality constraints as linear constraints
                # SciPy milp expects LinearConstraint objects for equality and inequality? Let's use LinearConstraint for equality and inequality.
                eq_con = LinearConstraint(A_eq, b_eq, b_eq)
                ineq_con = LinearConstraint(A_ub, -np.inf, b_ub)  # A_ub x <= b_ub
                # bounds: each variable binary 0-1
                bounds = Bounds(0, 1)
                # integrality: all variables integer
                integrality = np.ones(var_count, dtype=int)
                res = milp(c=c, constraints=[eq_con, ineq_con], bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("fail", n, res.message)
                    return None
                total = sum(res.x * c)
                return int(round(total))
            
