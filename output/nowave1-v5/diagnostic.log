                        idx += 1
                m = len(edges)
                # variables: x_i for label1, y_i for label2, total 2m variables
                num_vars = 2*m
                # objective: maximize 2*sum x + sum y => minimize -2*sum x - sum y
                c = np.zeros(num_vars)
                c[:m] = -2  # x variables
                c[m:] = -1   # y variables
                
                # constraints list
                A = []
                lb = []
                ub = []
                # edge constraint: x_i + y_i <= 1
                for i in range(m):
                    row = np.zeros(num_vars)
                    row[i] = 1
                    row[m+i] = 1
                    A.append(row)
                    lb.append(-np.inf)
                    ub.append(1)
                # triangle constraints
                # for each triple i<j<k
                for i in range(n):
                    for j in range(i+1, n):
                        for k in range(j+1, n):
                            # indices
                            idx_ij = edge_index[(i,j)]
                            idx_ik = edge_index[(i,k)]
                            idx_jk = edge_index[(j,k)]
                            row = np.zeros(num_vars)
