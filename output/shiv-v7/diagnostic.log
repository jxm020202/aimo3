            def max_locked(n):
                cells = [(r,c) for r in range(n) for c in range(n)]
                cell_index = {(r,c): r*n + c for r,c in cells}
                num_cells = n*n
                placements = []
                for r in range(n):
                    for c in range(n-1):
                        placements.append(('H', r, c, [(r,c),(r,c+1)]))
                for r in range(n-1):
                    for c in range(n):
                        placements.append(('V', r, c, [(r,c),(r+1,c)]))
                num_vars = len(placements)
                # map cell to placements covering it
                placements_covering_cell = {i: [] for i in range(num_cells)}
                for idx, (_,_,_, cells_cov) in enumerate(placements):
                    for (rr,cc) in cells_cov:
                        placements_covering_cell[cell_index[(rr,cc)]].append(idx)
                # constraints
                A_rows = []
                lb = []
                ub = []
                # non-overlap
                for cell in range(num_cells):
                    row = np.zeros(num_vars, dtype=int)
                    for p in placements_covering_cell[cell]:
                        row[p]=1
                    A_rows.append(row); lb.append(-np.inf); ub.append(1)
                def add_conditional(i, cell_set):
                    row = np.zeros(num_vars, dtype=int)
                    seen=set()
                    for cell in cell_set:
                        for p in placements_covering_cell[cell]:
                            if p not in seen:
                                row[p]=1; seen.add(p)
                    row[i] -= 1
                    A_rows.append(row); lb.append(0); ub.append(np.inf)
                for i, (orient, r, c, cells_cov) in enumerate(placements):
                    if orient=='H':
                        if c-1>=0: add_conditional(i, [cell_index[(r,c-1)]])
                        if c+2<n: add_conditional(i, [cell_index[(r,c+2)]])
                        if r-1>=0: add_conditional(i, [cell_index[(r-1,c)], cell_index[(r-1,c+1)]])
                        if r+1<n: add_conditional(i, [cell_index[(r+1,c)], cell_index[(r+1,c+1)]])
                    else:
                        if r-1>=0: add_conditional(i, [cell_index[(r-1,c)]])
                        if r+2<n: add_conditional(i, [cell_index[(r+2,c)]])
                        if c-1>=0: add_conditional(i, [cell_index[(r,c-1)], cell_index[(r+1,c-1)]])
                        if c+1<n: add_conditional(i, [cell_index[(r,c+1)], cell_index[(r+1,c+1)]])
