            def can_slide(board, typ, r, c):
                # board occupancy: True if occupied
                occ = [[False]*n for _ in range(n)]
                # fill occupancy from placements_selected
                for idx in placements_selected:
                    t, rr, cc = placements[idx]
                    if t == 'H':
                        occ[rr][cc] = True
                        occ[rr][cc+1] = True
                    else:
                        occ[rr][cc] = True
                        occ[rr+1][cc] = True
                # check slide directions
                if typ == 'H':
                    # left
                    if c > 0:
                        if not occ[r][c-1]:
                            return True
                    # right
                    if c+2 < n:
                        if not occ[r][c+2]:
                            return True
                    # up
                    if r > 0:
                        if not occ[r-1][c] and not occ[r-1][c+1]:
                            return True
                    # down
                    if r+1 < n:
                        if not occ[r+1][c] and not occ[r+1][c+1]:
                            return True
                else:
                    # vertical
                    # up
                    if r > 0:
                        if not occ[r-1][c]:
                            return True
                    # down
                    if r+2 < n:
                        if not occ[r+2][c]:
                            return True
                    # left
                    if c > 0:
                        if not occ[r][c-1] and not occ[r+1][c-1]:
                            return True
                    # right
                    if c+1 < n:
                        if not occ[r][c+1] and not occ[r+1][c+1]:
