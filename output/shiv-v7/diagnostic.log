                ub.append(1)
            
            def add_conditional_lock(i, cell_set):
                # constraint: sum_{j covering any cell in cell_set} x_j - x_i >= 0
                # i is placement index
                row = np.zeros(num_vars, dtype=int)
                # add covering placements
                seen = set()
                for cell in cell_set:
                    for p in placements_covering_cell[cell]:
                        if p not in seen:
                            row[p] = 1
                            seen.add(p)
                # subtract x_i
                row[i] -= 1
                # If row sum is zero (no covering placements), then constraint becomes -x_i >=0 => x_i <=0, which forces x_i=0.
                # That's okay (cannot place domino if cannot be blocked)
                A_rows.append(row)
                lb.append(0)
                ub.append(np.inf)
            
            for i, (orient, r, c, cells_cov) in enumerate(placements):
                if orient == 'H':
                    # left
                    if c-1 >= 0:
                        add_conditional_lock(i, [cell_index[(r, c-1)]])
                    # right
                    if c+2 < n:
                        add_conditional_lock(i, [cell_index[(r, c+2)]])
                    # up
                    if r-1 >= 0:
                        add_conditional_lock(i, [cell_index[(r-1, c)], cell_index[(r-1, c+1)]])
                    # down
                    if r+1 < n:
