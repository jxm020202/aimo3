            from scipy.optimize import milp, LinearConstraint, Bounds
            import numpy as np
            
            # board size
            n=7
            
            # generate domino placements
            placements = []  # each is tuple of cell indices (r,c) list of two cells, orientation, and direction info
            cell_index = lambda r,c: r*n + c
            
            for r in range(n):
                for c in range(n-1):
                    # horizontal domino covering (r,c) and (r,c+1)
                    placements.append({
                        'cells': [cell_index(r,c), cell_index(r,c+1)],
                        'type': 'H',
                        'pos': (r,c)
                    })
            for r in range(n-1):
                for c in range(n):
                    placements.append({
                        'cells': [cell_index(r,c), cell_index(r+1,c)],
                        'type': 'V',
                        'pos': (r,c)
                    })
            len(placements)
            
