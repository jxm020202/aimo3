            def solve_board_min_dominos(n, require_at_least_one=True):
                placements = []
                for r in range(n):
                    for c in range(n-1):
                        placements.append(('H', r, c))
                for r in range(n-1):
                    for c in range(n):
                        placements.append(('V', r, c))
                num_vars = len(placements)
                cell_to_placements = collections.defaultdict(list)
                for idx, (typ, r, c) in enumerate(placements):
                    cells = [(r,c), (r,c+1)] if typ=='H' else [(r,c), (r+1,c)]
                    for cell in cells:
                        cell_to_placements[cell].append(idx)
                rows = []; lb=[]; ub=[]
                # non-overlap
                for cell, idxs in cell_to_placements.items():
                    coeff = np.zeros(num_vars); coeff[idxs]=1
                    rows.append(coeff); lb.append(-np.inf); ub.append(1)
                # blocking constraints
                for i, (typ, r, c) in enumerate(placements):
                    if typ == 'H':
                        # left single cell
                        if c > 0:
                            S = cell_to_placements[(r,c-1)]
                            coeff = np.zeros(num_vars); coeff[S]=1; coeff[i]=-1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                        # right single cell
                        if c+2 < n:
                            S = cell_to_placements[(r,c+2)]
                            coeff = np.zeros(num_vars); coeff[S]=1; coeff[i]=-1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                        # up: need at least one of two cells above
                        if r > 0:
                            S1 = cell_to_placements[(r-1,c)]
                            S2 = cell_to_placements[(r-1,c+1)]
                            coeff = np.zeros(num_vars)
                            coeff[S1] = 1
                            coeff[S2] = 1
                            coeff[i] = -1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                        # down: at least one of two cells below
                        if r+2 < n:
                            S1 = cell_to_placements[(r+2,c)]
                            S2 = cell_to_placements[(r+2,c+1)]
                            coeff = np.zeros(num_vars)
                            coeff[S1] = 1
                            coeff[S2] = 1
                            coeff[i] = -1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                    else: # vertical
                        # left: at least one of two cells left
                        if c > 0:
                            S1 = cell_to_placements[(r,c-1)]
                            S2 = cell_to_placements[(r+1,c-1)]
                            coeff = np.zeros(num_vars); coeff[S1]=1; coeff[S2]=1; coeff[i]=-1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                        # right: at least one of two cells right
                        if c+1 < n:
                            S1 = cell_to_placements[(r,c+1)]
                            S2 = cell_to_placements[(r+1,c+1)]
                            coeff = np.zeros(num_vars); coeff[S1]=1; coeff[S2]=1; coeff[i]=-1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                        # up: single cell above
                        if r > 0:
                            S = cell_to_placements[(r-1,c)]
                            coeff = np.zeros(num_vars); coeff[S]=1; coeff[i]=-1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                        # down: single cell below (r+2)
                        if r+2 < n:
                            S = cell_to_placements[(r+2,c)]
                            coeff = np.zeros(num_vars); coeff[S]=1; coeff[i]=-1
                            rows.append(coeff); lb.append(0); ub.append(np.inf)
                A = np.vstack(rows)
                lb = np.array(lb, dtype=float)
                ub = np.array(ub, dtype=float)
                cvec = np.ones(num_vars)
                bounds = Bounds(0,1)
