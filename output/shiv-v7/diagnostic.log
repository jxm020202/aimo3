            def solve_m_with_constraints(m, A, lb, ub):
                num_vars = A.shape[1]
                # add equality sum x_i = m
                A_eq = np.ones((1, num_vars), dtype=int)
                lb_eq = np.array([m], dtype=float)
                ub_eq = np.array([m], dtype=float)
                A_comb = np.vstack([A, A_eq])
                lb_comb = np.concatenate([lb, lb_eq])
                ub_comb = np.concatenate([ub, ub_eq])
                lin_con = LinearConstraint(A_comb, lb_comb, ub_comb)
                bounds = Bounds(0, 1)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=np.zeros(num_vars), constraints=lin_con, bounds=bounds,
