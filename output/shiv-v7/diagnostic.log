            # Locking constraints
            def add_locking_constraint(cell_set):
                # cell_set is list of cell indices that need at least one occupied
                if not cell_set:
                    return
                row = np.zeros(num_vars, dtype=int)
                # any placement covering any of these cells
                seen = set()
                for cell in cell_set:
                    for p in placements_covering_cell[cell]:
                        if p not in seen:
                            row[p] = 1
                            seen.add(p)
                # if no placements cover these cells (should not happen), skip
                if row.sum() == 0:
                    # no way to block, constraint impossible -> we could set infeasible
                    pass
                else:
                    A_rows.append(row)
                    lb.append(1)
                    ub.append(np.inf)
            
            for idx, (orient, r, c, cells_cov) in enumerate(placements):
                if orient == 'H':
                    # left
                    if c-1 >= 0:
                        add_locking_constraint([cell_index[(r, c-1)]])
