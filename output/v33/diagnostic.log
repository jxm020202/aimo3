                        edge_index[(i,j)] = idx
                        idx += 1
                m_edges = idx
                # y variables: ordered pairs (u,v) u!=v
                y_index = {}
                for u in range(n):
                    for v in range(n):
                        if u == v:
                            continue
                        y_index[(u,v)] = idx
                        idx += 1
                total_vars = idx
                # objective: maximize sum of edge variables
                c = np.zeros(total_vars)
                for (i,j), e_idx in edge_index.items():
                    c[e_idx] = -1  # milp minimizes, so negative for max
