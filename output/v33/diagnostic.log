            def generate_functions(max_x, max_y):
                allowed = [(1,2),(2,1),(-1,-2),(-2,-1),(1,-1),(-1,1)]
                a = {}
                b = {}
                g = {(0,0):0}
                solutions = []
                vertices = [(x,y) for x in range(max_x+1) for y in range(max_y+1)]
                # sort vertices in row-major order
                def backtrack(idx):
                    if idx == len(vertices):
                        solutions.append(dict(g))
                        return
                    x,y = vertices[idx]
                    # ensure g at (x,y) is already defined (it should be, because we start from (0,0) and assign neighbors)
                    if (x,y) not in g:
                        # cannot assign a,b without g value
                        return
                    gx = g[(x,y)]
                    for av,bv in allowed:
                        # compute g for right neighbor
                        nx, ny = x+1, y
                        g_right = gx + av
                        if nx <= max_x:
                            if (nx,ny) in g and g[(nx,ny)] != g_right:
                                continue
                            if g_right < 0:
                                continue
                        # compute g for up neighbor
                        ux, uy = x, y+1
                        g_up = gx + bv
                        if uy <= max_y:
                            if (ux,uy) in g and g[(ux,uy)] != g_up:
                                continue
                            if g_up < 0:
                                continue
                        # consistency with left neighbor
                        if x-1 >= 0 and (x-1,y) in a:
                            if g[(x-1,y)] + a[(x-1,y)] != gx:
                                continue
                        # consistency with down neighbor
                        if y-1 >= 0 and (x,y-1) in b:
                            if g[(x,y-1)] + b[(x,y-1)] != gx:
                                continue
                        # assign
                        a[(x,y)] = av
                        b[(x,y)] = bv
                        added = []
                        if nx <= max_x and (nx,ny) not in g:
                            g[(nx,ny)] = g_right
                            added.append((nx,ny))
                        if uy <= max_y and (ux,uy) not in g:
                            g[(ux,uy)] = g_up
                            added.append((ux,uy))
                        backtrack(idx+1)
                        # backtrack
                        del a[(x,y)]
                        del b[(x,y)]
                        for pt in added:
                            del g[pt]
                backtrack(0)
                return solutions
            
