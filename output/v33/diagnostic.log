            def is_valid(points, n):
                # points is set of (x,y) with 1-indexed coordinates (1..n)
                # Check no isosceles trapezoid with base parallel to x or y axis.
                pts = list(points)
                # Build dictionary rows->list of x, cols->list of y
                rows = {}
                cols = {}
                for x,y in pts:
                    rows.setdefault(y, []).append(x)  # careful: y is row? Actually y coordinate is vertical axis. Base parallel to x-axis means same y.
                    cols.setdefault(x, []).append(y)
                # Check for each pair of rows
                for y1, xs1 in rows.items():
                    for y2, xs2 in rows.items():
                        if y1 >= y2: continue
                        if len(xs1) < 2 or len(xs2) < 2: continue
                        # compute all absolute differences
                        diffs = {}
                        for a in xs1:
                            for c in xs2:
                                d = abs(a - c)
                                if d in diffs:
                                    # we have another pair (b,d2) with same diff?
                                    # Need to ensure that the previous pair uses distinct points (b,d2) not same as (a,c)
                                    # Since we just need any two distinct pairs (a,c) and (b,d) with a!=b, c!=d.
                                    # So if we encounter same diff again with a different a or c, we have a violation.
                                    # However we must ensure that the previous pair is not the same pair.
                                    # Since we iterate all combos, any repeat diff indicates violation.
                                    # But we need to ensure that the previous pair's points are not same as current.
                                    # That's guaranteed if we store only first occurrence.
                                    # So violation.
                                    return False
                                diffs[d] = (a,c)
                # Check for columns similarly
                for x1, ys1 in cols.items():
                    for x2, ys2 in cols.items():
                        if x1 >= x2: continue
                        if len(ys1) < 2 or len(ys2) < 2: continue
                        diffs = {}
                        for a in ys1:
                            for c in ys2:
                                d = abs(a - c)
                                if d in diffs:
                                    return False
                                diffs[d] = (a,c)
                return True
            
            def construct_points(n, k):
                # slopes a = 0..k-1, intercept 0
                pts = set()
                for a in range(k):
                    for x in range(1, n+1):
                        y = (a * x) % n
                        # convert to 1..n range: if y==0 use n
                        if y == 0:
                            y = n
                        pts.add((x, y))
                return pts
            
            def max_k_bruteforce(n):
                # try k from floor(sqrt(n)) downwards to find valid
                maxk = int(math.isqrt(n))
                for k in range(maxk, 0, -1):
                    pts = construct_points(n, k)
                    if is_valid(pts, n):
                        return k, len(pts)
                return None
            
