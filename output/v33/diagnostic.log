                vertices = [(i,j) for i in range(m) for j in range(n)]
                idx = {v:k for k,v in enumerate(vertices)}
                # edges list of pairs of vertex indices
                edges = []
                for i in range(m):
                    for j in range(n):
                        v = idx[(i,j)]
                        if i+1 < m:
                            edges.append((v, idx[(i+1,j)]))
                        if j+1 < n:
                            edges.append((v, idx[(i,j+1)]))
                # binary variables x_{v,k} for each vertex v and label k (1..N)
                # total variables = N*N
                num_vars = N*N
                # variable order: for each v, for each k (0-indexed)
                # We'll use c vector for objective (maximize S). We'll treat S as separate variable.
                # We'll use linear constraints: each vertex assigned exactly one label.
                # each label assigned to exactly one vertex.
                # edge constraints: sum_{k} k+1 * x_{u,k} + sum_{l} l+1 * x_{v,l} >= S
                # We'll treat S as integer variable with bounds [2, 2N].
                # We'll convert to standard form: A_ub * x <= b_ub, A_eq * x = b_eq.
                # Since we have inequality with >= S, we can rewrite as -sum >= -S.
                # We'll include S as variable at end of vector.
                # So total variables = N*N + 1
                total_vars = num_vars + 1
                # Build constraints
                rows = []
                lbs = []
                ubs = []
