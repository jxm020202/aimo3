            def total_missing_pairs(pts, angle=100):
                # count ordered pairs not covered
                missing = 0
                for i, p in enumerate(pts):
                    angles = []
                    for j, q in enumerate(pts):
                        if i==j: continue
                        ang = math.degrees(math.atan2(q[1]-p[1], q[0]-p[0]))
                        if ang<0: ang+=360
                        angles.append(ang)
                    angles.sort()
                    # find max number covered by interval length angle
                    maxcov = max_in_interval(angles, interval_deg=angle)
                    missing += (len(pts)-1 - maxcov)
                return missing
            
