            def construct_perm(N):
                # N odd
                rows_available=set(range(1,N+1))
                cols_available=set(range(1,N+1))
                pairs={}
                # we will leave one row and one column unused (they will be the same maybe)
                # We'll try to assign N-1 distances
                distances=list(range(1,N))  # 1..N-1
                # We'll try assign in decreasing order to have more flexibility
                for d in reversed(distances):
                    assigned=False
                    # try forward: need i in rows_available, i+d in cols_available, i+d<=N, i!=i+d
                    for i in list(rows_available):
                        j=i+d
                        if j<=N and j in cols_available and i!=j:
                            # assign
                            pairs[i]=j
                            rows_available.remove(i)
                            cols_available.remove(j)
                            assigned=True
                            break
                    if not assigned:
                        # try backward
                        for i in list(rows_available):
                            j=i-d
                            if j>=1 and j in cols_available and i!=j:
                                pairs[i]=j
                                rows_available.remove(i)
                                cols_available.remove(j)
                                assigned=True
                                break
                    if not assigned:
                        # cannot assign this distance
                        return None
                # after loop, we have N-1 pairs, one row and one column left unused
