            def get_solution_grid(m,n, res):
                N=m*n
                total_vars = N*N
                assign = res.x[:total_vars]
                # reshape to (cell, number)
                assign = assign.reshape((N,N))
                # each cell's assigned number is argmax
                grid = np.zeros((m,n), dtype=int)
                for i in range(m):
                    for j in range(n):
                        cell = i*n + j
                        k = np.argmax(assign[cell])
                        grid[i,j] = k+1
                return grid
            
