                                feasible &= poss
                    # If feasible empty, fail
                    if not feasible:
                        return False
                    for val in sorted(feasible):
                        g[p]=val
                        if check_constraints():
                            if backtrack(idx+1):
                                return True
                        del g[p]
                    return False
                
                success = backtrack(0)
                return success, g
            
