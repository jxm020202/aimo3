            def walk_counts(N, start):
                # start index (0-based)
                pos = start
                f = [0]*N
                f[pos] += 1
                # move right to N-1
                while pos < N-1:
                    pos += 1
                    f[pos] += 1
                # move left to 0
                while pos > 0:
                    pos -= 1
                    f[pos] += 1
                return f
            
