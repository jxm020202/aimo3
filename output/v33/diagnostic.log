def has_isosceles_trapezoid(points):
    # points is a set of (x,y) tuples
    pts = list(points)
    n = len(pts)
    # check all quadruples
    for i in range(n):
        x1,y1 = pts[i]
        for j in range(i+1,n):
            x2,y2 = pts[j]
            # consider horizontal bases: need same y for two points
            if y1 == y2:
                # base points (x1,y1),(x2,y1)
                for k in range(n):
                    x3,y3 = pts[k]
                    if y3 == y1: continue
                    for l in range(k+1,n):
                        x4,y4 = pts[l]
                        if y4 != y3: continue
                        # now we have two rows y1 and y3
                        # need x1+x2 == x3+x4
                        if x1 + x2 == x3 + x4:
                            # ensure four distinct points
                            if len({(x1,y1),(x2,y2),(x3,y3),(x4,y4)})==4:
                                return True
            # vertical bases
            if x1 == x2:
                for k in range(n):
                    x3,y3 = pts[k]
                    if x3 == x1: continue
                    for l in range(k+1,n):
                        x4,y4 = pts[l]
                        if x4 != x3: continue
                        if y1 + y2 == y3 + y4:
                            if len({(x1,y1),(x2,y2),(x3,y3),(x4,y4)})==4:
                                return True
    return False

def construct_cycle(n):
    points = set()
    for i in range(1,n+1):
        points.add((i,i))
        points.add((i, i% n + 1))
    return points

for n in range(3,9):
    pts = construct_cycle(n)
    print(n, len(pts), has_isosceles_trapezoid(pts))
