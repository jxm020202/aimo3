            def max_weighted_sum(m,n):
                N = m*n
                # counts
                corners = 4
                edges = 2*(m-2) + 2*(n-2)  # number of edge (non-corner) vertices
                interior = N - corners - edges
                # assign largest labels to interior (degree 4)
                labels = list(range(N,0,-1))  # descending
                # compute sum
                total = 0
                idx = 0
                # interior
                for _ in range(interior):
                    total += 4 * labels[idx]
                    idx += 1
                # edges
                for _ in range(edges):
                    total += 3 * labels[idx]
                    idx += 1
                # corners
                for _ in range(corners):
                    total += 2 * labels[idx]
                    idx += 1
                return total
            
