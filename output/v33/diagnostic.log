            def simulated_annealing(m,n,steps=500000, start_temp=1.0, end_temp=0.001):
                N=m*n
                arr=list(range(1,N+1))
                random.shuffle(arr)
                cur=min_adj_sum_grid(arr,m,n)
                best=cur
                best_arr=arr[:]
                for step in range(steps):
                    t = start_temp + (end_temp - start_temp) * (step/steps)
                    # propose swap
                    i,j=random.sample(range(N),2)
                    arr[i],arr[j]=arr[j],arr[i]
                    new=min_adj_sum_grid(arr,m,n)
                    delta=new-cur
                    if delta>0 or random.random()<math.exp(delta/t):
                        cur=new
                        if cur>best:
                            best=cur
                            best_arr=arr[:]
                    else:
                        # revert
                        arr[i],arr[j]=arr[j],arr[i]
                return best,best_arr
            
