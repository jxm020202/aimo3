                        if c+1 < cols:
                            edges.append((idx, r*cols + (c+1)))
                n_edges = len(edges)
            
                # Build equality constraints matrix
                # For each cell: row length n_vars, 1 at positions cell*N + (num-1) for num=1..N
                rows_eq = []
                b_eq = []
                # cell constraints
                for cell in range(N):
                    row = np.zeros(n_vars, dtype=int)
                    row[cell*N:(cell+1)*N] = 1
                    rows_eq.append(row)
                    b_eq.append(1)
                # number constraints
                for num in range(N):
                    row = np.zeros(n_vars, dtype=int)
                    # positions cell*N + num for each cell
                    for cell in range(N):
                        row[cell*N + num] = 1
                    rows_eq.append(row)
                    b_eq.append(1)
            
                A_eq = csr_matrix(np.vstack(rows_eq))
                b_eq = np.array(b_eq)
            
                # Build inequality constraints for edges (A_ub * x <= b_ub)
                # For each edge (i,j): - sum_{num} num * x_{i,num} - sum_{num} num * x_{j,num} <= -S
                # We'll construct coefficient matrix later for given S.
                # We'll precompute coefficient rows (without -S)
                edge_rows = []
                for (i,j) in edges:
