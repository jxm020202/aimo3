            def bishop_domination_number(n):
                num_vars = n*n
                # Build constraints: for each square (i,j), sum over squares on same diag1 or diag2 >= 1
                diag1 = {}
                diag2 = {}
                for i in range(n):
                    for j in range(n):
                        d1 = i - j
                        d2 = i + j
                        diag1.setdefault(d1, []).append(i*n+j)
                        diag2.setdefault(d2, []).append(i*n+j)
                A = []
                lb = []
                ub = []
                for i in range(n):
                    for j in range(n):
                        row = np.zeros(num_vars, dtype=int)
                        for v in diag1[i-j]:
                            row[v] = 1
                        for v in diag2[i+j]:
                            row[v] = 1
                        A.append(row)
                        lb.append(1)
                        ub.append(np.inf)
                A = np.array(A)
                c = np.ones(num_vars, dtype=int)
                bounds = Bounds(np.zeros(num_vars), np.ones(num_vars))
                lin_con = LinearConstraint(A, lb, ub)
                res = milp(c=c, constraints=lin_con, bounds=bounds, integrality=np.ones(num_vars, dtype=int))
                if not res.success:
                    return None
                return int(round(res.fun))
            
