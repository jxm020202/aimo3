            def min_moves_linear(N):
                # Build linear system over GF(2) for variables e_i (i=1..N-1) and start/end bits s_i,t_i (but we can treat start and end as variables)
                # We'll treat start vertex a and end vertex b (could be same). We'll have binary variables start_i (1 if start at i) and end_i (1 if end at i).
                # Constraints: exactly one start, exactly one end (could be same). But we can allow start=end, then both bits at same i =1 each.
                # However parity condition uses s_i + t_i mod2.
                # We'll search over possible start and end positions (N^2 possibilities) to find minimal sum e_i.
                import itertools
                p = [1 if i%2==0 else 0 for i in range(N)]  # 0-indexed: tails at even indices
                best = None
                best_solution = None
                for start in range(N):
                    for end in range(N):
                        # compute required parity for each edge variable e_i (i from 0 to N-2)
                        # equations: e_{i-1} + e_i ≡ p_i + ( (i==start) ^ (i==end) ) (mod2)
                        # For i=0, e_{-1}=0 (no edge left of first vertex). Similarly for i=N-1, e_{N-1}=0 (no edge right of last vertex).
                        # So we have N equations for N-1 unknowns; system may be solvable only for certain start/end.
                        # We'll solve by forward substitution: e_i determined recursively.
                        e = [0]*(N-1)
                        # For i=0:
                        # e_{-1}=0, so e_0 ≡ p_0 + (start==0) ^ (end==0) (mod2)
                        e[0] = (p[0] + ((start==0) ^ (end==0))) % 2
                        # For i=1..N-2:
                        for i in range(1,N-1):
                            # equation: e_{i-1} + e_i ≡ p_i + ( (i==start) ^ (i==end) )
                            rhs = (p[i] + ((i==start) ^ (i==end))) % 2
                            e[i] = (rhs - e[i-1]) % 2  # since e_i = rhs - e_{i-1} mod2
                        # Check last equation for i=N-1:
                        # e_{N-2} + e_{N-1}=0 (since e_{N-1}=0) ≡ p_{N-1} + ( (N-1==start) ^ (N-1==end) )
                        lhs = e[N-2] % 2
                        rhs = (p[N-1] + ((N-1==start) ^ (N-1==end))) % 2
                        if lhs != rhs:
                            continue  # no solution
                        total_edges = sum(e)
                        moves = total_edges + 1
                        if best is None or moves < best:
                            best = moves
                            best_solution = (start,end,e)
                return best, best_solution
            
            for N in range(3,15,2):
                best,_ = min_moves_linear(N)
                print(N,best)
            
