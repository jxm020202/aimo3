            def min_moves_bruteforce(N):
                # initial pattern: T H T H ... starting with T at position 1
                init = tuple(1 if i%2==1 else 0 for i in range(1,N+1))  # 1 for T (needs odd flips), 0 for H (needs even flips)
                # state: (position, flips_parity tuple) where flips_parity is tuple of parity of flips (0 even,1 odd) for each coin
                # Actually we need to track current coin sides: 0 for H, 1 for T.
