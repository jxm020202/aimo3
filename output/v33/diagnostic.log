            def f_bruteforce_limit(n, max_m):
                # compute f(n) up to max_m
                for m in range(1, max_m+1):
                    divs = sp.divisors(m)
                    if len(divs) < 3:
                        continue
                    # check combos
                    for i in range(len(divs)):
                        for j in range(i+1, len(divs)):
                            for k in range(j+1, len(divs)):
                                if divs[i] + divs[j] + divs[k] == n:
                                    return m
                return None
            
            def compute_f_for_power(k):
                N = 3**k
                f_val = f_bruteforce_limit(N, 10*N)  # search up to 10*N
                return f_val
            
