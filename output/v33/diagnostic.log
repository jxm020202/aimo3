            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def edge_dominating_set(parity):
                # Build list of edges (i,j) with given parity (i+j parity)
                edges = []
                # Map edge index
                for i in range(1, n+1):
                    for j in range(1, n+1):
                        if (i+j)%2 == parity:
                            edges.append((i,j))
                m = len(edges)
                # Build adjacency list: for each edge, list of edges that share a diagonal
                # We'll create constraint matrix A where each row corresponds to an edge, columns edges.
                # For each edge e, we need sum_{f adjacent to e} x_f >= 1.
                # We'll build a dense matrix maybe okay (max 85x85).
                A = np.zeros((m,m), dtype=int)
                for idx_e, (i_e,j_e) in enumerate(edges):
                    d1_e = i_e - j_e
                    d2_e = i_e + j_e
                    for idx_f, (i_f,j_f) in enumerate(edges):
                        if (i_f - j_f == d1_e) or (i_f + j_f == d2_e):
                            A[idx_e, idx_f] = 1
                # Objective: minimize sum x
                c = np.ones(m)
                # Constraints: A @ x >= 1
                # Convert to LinearConstraint with lb=1, ub=inf
                # Since milp expects Ax <= b, we can multiply by -1: -A x <= -1
                lc = LinearConstraint(-A, -np.ones(m), np.full(m, np.inf))
                # Bounds 0 <= x <= 1, integer
                bounds = Bounds(np.zeros(m), np.ones(m))
                integrality = np.ones(m)  # all integer
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={"presolve": True})
                if not res.success:
                    print("MILP failed", res.message)
                return res
            
            res_even = edge_dominating_set(0)  # parity 0 (even i+j)
            res_odd = edge_dominating_set(1)
            print(res_even.x, res_even.fun, res_odd.x, res_odd.fun)
