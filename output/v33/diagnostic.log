                N=m*n
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx, (i+1)*n+j))
                        if j+1<n:
                            edges.append((idx, i*n+(j+1)))
                total_vars = N*N + 1
                c = np.zeros(total_vars)  # objective irrelevant
                lower = np.zeros(total_vars)
                upper = np.ones(total_vars)
                upper[-1] = S_target  # set upper bound to S_target
                bounds = Bounds(lower, upper)
                integrality = np.ones(total_vars, dtype=int)
                # equality constraints same as before
                A_eq_rows=[]
                b_eq=[]
                for cell in range(N):
                    row=np.zeros(total_vars)
                    for num in range(N):
                        row[cell*N+num]=1
                    A_eq_rows.append(row); b_eq.append(1)
                for num in range(N):
                    row=np.zeros(total_vars)
                    for cell in range(N):
                        row[cell*N+num]=1
                    A_eq_rows.append(row); b_eq.append(1)
                A_eq=np.array(A_eq_rows); b_eq=np.array(b_eq)
                # inequality constraints: sum - S >= 0 => -sum + S <= 0
                A_ub_rows=[]; b_ub=[]
                for (c1,c2) in edges:
                    row=np.zeros(total_vars)
                    for num in range(N):
