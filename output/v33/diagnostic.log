            def generate_segments():
                n=9
                segs=[]
                # horizontal
                for r in range(n):
                    for c in range(n-5+1):
                        cells=[(r,c+i) for i in range(5)]
                        segs.append(cells)
                # vertical
                for c in range(n):
                    for r in range(n-5+1):
                        cells=[(r+i,c) for i in range(5)]
                        segs.append(cells)
                # diag NW-SE (down-right)
                # start positions where diagonal length >=5
                for r in range(n-5+1):
                    for c in range(n-5+1):
                        # diagonal starting at (r,c) goes down-right length min(n-r,n-c)
                        length=min(n-r,n-c)
                        if length>=5:
                            # generate all length-5 subsegments along this diagonal
                            for offset in range(length-5+1):
                                cells=[(r+offset+i, c+offset+i) for i in range(5)]
                                segs.append(cells)
                # diag NE-SW (down-left)
                for r in range(n-5+1):
                    for c in range(4, n): # c start at least 4 (index 4) to have enough leftwards cells
                        length=min(n-r, c+1) # number of cells down-left from (r,c)
                        if length>=5:
                            for offset in range(length-5+1):
