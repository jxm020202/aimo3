            def min_vertex_cover():
                # Use networkx to compute min vertex cover via Konig's theorem
                # Build bipartite graph as before
                G=nx.Graph()
                left_nodes = ['L'+str(d) for d in range(-12,13)]
                right_nodes = ['R'+str(d) for d in range(0,25)]
                G.add_nodes_from(left_nodes, bipartite=0)
                G.add_nodes_from(right_nodes, bipartite=1)
                for i in range(-12,13):
                    for j in range(0,25):
                        if (i+j)%2==0:
                            row=(i+j)//2
                            col=(j-i)//2
                            if 0<=row<13 and 0<=col<13:
                                G.add_edge('L'+str(i), 'R'+str(j))
                # maximum matching
                M = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # Build directed graph for alternating BFS from unmatched left vertices
                # Unmatched left vertices:
                matched_left = {u for u in M if u.startswith('L')}
                unmatched_left = [u for u in left_nodes if u not in matched_left]
                # BFS
                Z = set(unmatched_left)
                queue = list(unmatched_left)
                while queue:
                    u = queue.pop(0)
                    if u.startswith('L'):
                        # explore unmatched edges from left to right
                        for v in G.neighbors(u):
                            if (u,v) not in M.items():  # edge not in matching
                                if v not in Z:
                                    Z.add(v)
                                    queue.append(v)
                    else:
                        # u is right vertex, explore matched edge to left
                        # find its matched left partner
                        partner = M.get(u)
                        if partner and partner not in Z:
                            Z.add(partner)
                            queue.append(partner)
                # Minimum vertex cover
                C = set([u for u in left_nodes if u not in Z]) | set([u for u in right_nodes if u in Z])
                return C
            
            C = min_vertex_cover()
            len(C)
            
