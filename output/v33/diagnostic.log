                # bipartite colors: black if (i+j)%2==0
                # collect black and white cells with degree
                cells = [(i,j) for i in range(m) for j in range(n)]
                # compute degree
                def degree(i,j):
                    deg=0
                    if i>0: deg+=1
                    if i<m-1: deg+=1
                    if j>0: deg+=1
                    if j<n-1: deg+=1
                    return deg
                black = []
                white = []
                for i,j in cells:
                    deg = degree(i,j)
                    if (i+j)%2==0:
                        black.append(((i,j),deg))
                    else:
                        white.append(((i,j),deg))
                # sort black by degree ascending (corners deg2, edges deg3, interior deg4)
                black.sort(key=lambda x: x[1])  # ascending
                # sort white by degree descending (interior first)
                white.sort(key=lambda x: -x[1])  # descending
                N=m*n
