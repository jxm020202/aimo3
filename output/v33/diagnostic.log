            def quadratic_residues_mod_n(n):
                # returns list of a in [1,n-1] such that a is a quadratic residue modulo n (i.e., exists x with x^2 ≡ a mod n)
                residues = set()
                for x in range(1, n):
                    residues.add((x*x) % n)
                # exclude 0
                residues.discard(0)
                return sorted(residues)
            
            def test_mod_n(n, max_e=10):
