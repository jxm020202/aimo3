            def construct_graph(c=10, n=160):
                p = n - c
                # assign leaves to cores
                leaves_per_core = [p // c] * c
                rem = p % c
                for i in range(rem):
                    leaves_per_core[i] += 1
                # assign vertex indices
                core_vertices = list(range(c))
                leaf_vertices = list(range(c, n))
                groups = []
                idx = c
                for size in leaves_per_core:
                    group = list(range(idx, idx+size))
                    groups.append(group)
                    idx += size
                edges = set()
                # core clique
                for i in range(c):
                    for j in range(i+1, c):
                        edges.add((core_vertices[i], core_vertices[j]))
                # core-leaf edges
                for i, group in enumerate(groups):
                    core = core_vertices[i]
                    for leaf in group:
                        edges.add((core, leaf))
                # leaf-leaf edges across groups
                for i in range(c):
                    for j in range(i+1, c):
                        for leaf_i in groups[i]:
                            for leaf_j in groups[j]:
                                edges.add((leaf_i, leaf_j))
