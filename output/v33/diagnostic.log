            import numpy as np, math, random, time
            
            def sum_for_angles_fast(angles):
                N=len(angles)
                pts=np.column_stack((np.cos(angles), np.sin(angles)))  # shape (N,2)
                L=math.radians(100)
                total=0
                for i in range(N):
                    diffs=pts - pts[i]  # shape (N,2)
                    # compute angles to others
                    angs=np.arctan2(diffs[:,1], diffs[:,0])
                    # remove self
                    angs = np.delete(angs, i)
                    angs.sort()
                    angs2 = np.concatenate((angs, angs+2*math.pi))
                    # sliding window
                    left=0
                    maxcnt=0
                    for right in range(len(angs2)):
                        while angs2[right]-angs2[left] > L+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>maxcnt:
                            maxcnt=cnt
                    total+=maxcnt
                return int(total)
            
            def anneal_angles_fast(N, steps=20000):
                angles=np.random.rand(N)*2*math.pi
                best=sum_for_angles_fast(angles)
                best_angles=angles.copy()
                T0=1.0
                for step in range(steps):
                    T=T0*(1-step/steps)
                    i=random.randrange(N)
                    old=angles[i]
                    new=(old + (random.random()*2-1)*0.2) % (2*math.pi)
                    angles[i]=new
                    s=sum_for_angles_fast(angles)
                    delta=s-best
                    if delta>0 or random.random()<math.exp(delta/T):
                        if s>best:
                            best=s
                            best_angles=angles.copy()
                    else:
                        angles[i]=old
                return best, best_angles
            
            def best_N(N, steps=15000, trials=2):
                best=0
                for _ in range(trials):
                    b,_=anneal_angles_fast(N, steps=steps)
                    if b>best:
                        best=b
                return best
            
            for N in range(5,21,5):
                start=time.time()
                b=best_N(N, steps=12000, trials=2)
                print(N, b, "deficit", N*(N-1)-b, "time", time.time()-start)
            
