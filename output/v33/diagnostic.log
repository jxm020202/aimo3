            import itertools, math
            
            def max_min_sum_grid(m,n):
                # m rows, n cols
                N = m*n
                cells = [(i,j) for i in range(m) for j in range(n)]
                # adjacency edges
                edges = []
                for i in range(m):
                    for j in range(n):
                        if i+1 < m:
                            edges.append(((i,j),(i+1,j)))
                        if j+1 < n:
                            edges.append(((i,j),(i,j+1)))
                max_S = -1
                best_assign = None
                for perm in itertools.permutations(range(1,N+1)):
                    # assign numbers to cells
                    assign = {cells[i]: perm[i] for i in range(N)}
                    min_sum = min(assign[a]+assign[b] for a,b in edges)
                    if min_sum > max_S:
                        max_S = min_sum
                        best_assign = assign
                return max_S, best_assign
            
