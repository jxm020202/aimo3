            def solve_x(d):
                n = len(d)
                # edges count = n-1
                # we need x[0]=d[0], x[n-2]=d[n-1], and interior constraints.
                # We'll solve recursively.
                x = [None]*(n-1)
                x[0] = d[0]
                # compute forward
                for i in range(1, n-1):
                    # constraint: x[i-1] + x[i] = d[i]
                    # => x[i] = d[i] - x[i-1]
                    x[i] = d[i] - x[i-1]
                # check final constraint x[n-2] should equal d[n-1]
                if x[-1] != d[-1]:
                    return None
                if any(val<0 for val in x):
                    return None
                return x
            
            def baseline_solution_possible(n, start, end):
                # start and end indices
                # compute f_i: 1 for T (odd positions index 0,2,...), 2 for H (even positions index 1,3,...)
                f = [1 if i%2==0 else 2 for i in range(n)]
                # adjust start/end: they may be T or H; f_i unchanged (still need odd/even)
                a = [0]*n
                b = [0]*n
                a[start]=1
                b[end]=1
                d = [2*f[i] - a[i] - b[i] for i in range(n)]
                # Solve for x
                return solve_x(d)
            
            def test_baseline_possible(n):
                # try any start/end pair to see if feasible
                for s in range(n):
