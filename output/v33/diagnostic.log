                    # need {g(x,y), g(x,y+1), g(x+1,y)} consecutive
                    a = g.get((x,y))
                    b = g.get((x,y+1))
                    c = g.get((x+1,y))
                    if a is None or b is None or c is None:
                        return True  # not all assigned yet
                    s = {a,b,c}
                    if len(s)!=3:
