            def construct_grid(m,n):
                N=m*n
                # compute degrees and color
                deg={}
                color={}
                for i in range(m):
                    for j in range(n):
                        d=0
                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            if 0<=i+di<m and 0<=j+dj<n:
                                d+=1
                        deg[(i,j)]=d
                        color[(i,j)]=(i+j)%2  # 0 black, 1 white
                # separate black and white cells
                black_cells=[(i,j) for i in range(m) for j in range(n) if color[(i,j)]==0]
                white_cells=[(i,j) for i in range(m) for j in range(n) if color[(i,j)]==1]
                # sort black cells by degree ascending (corners first)
                black_cells_sorted=sorted(black_cells, key=lambda c: deg[c])
                # assign low numbers 1..len(black_cells) to black cells in this order
                low_numbers=range(1, len(black_cells)+1)
                grid=[[0]*n for _ in range(m)]
                for (i,j), val in zip(black_cells_sorted, low_numbers):
                    grid[i][j]=val
                # sort white cells by degree descending (interior first)
                white_cells_sorted=sorted(white_cells, key=lambda c: -deg[c])
                # assign high numbers N, N-1,... descending to white cells
                high_numbers=range(N, N-len(white_cells), -1)
                for (i,j), val in zip(white_cells_sorted, high_numbers):
