            import sympy as sp
            
            def f_bruteforce(n, max_m=5000):
                for m in range(1, max_m+1):
                    divs = sp.divisors(m)
                    if len(divs) < 3:
                        continue
                    # need three distinct positive divisors sum to n
                    # choose any combination of 3 distinct divisors
                    # we can early break if sum > n? but just brute
                    for i in range(len(divs)):
                        for j in range(i+1, len(divs)):
                            for k in range(j+1, len(divs)):
                                if divs[i] + divs[j] + divs[k] == n:
                                    return m
                return None
            
            def f_pair_method(n):
                # compute min lcm(a,b) with a,b>1 distinct, a+b = n-1
                min_m = None
                for a in range(2, n-1):
                    b = n-1 - a
                    if b <= 1 or b == a:
                        continue
                    m = sp.ilcm(a,b)
                    if min_m is None or m < min_m:
                        min_m = m
                # also consider triple >1?
                # We'll compute brute for small n to compare.
                return min_m
            
            # test for n up to 30
            vals = {}
            for n in range(6, 31):
                f_br = f_bruteforce(n, max_m=5000)
                f_pair = f_pair_method(n)
                vals[n] = (f_br, f_pair)
                if f_br != f_pair:
                    print(n, f_br, f_pair)
            
