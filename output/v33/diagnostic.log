            def upper_bound_S(rows, cols):
                N = rows*cols
                # degrees
                corners = 4
                edge_non_corner = 2*(rows-2) + 2*(cols-2)
                interior = N - corners - edge_non_corner
                # list of degrees per vertex
                degrees = [4]*interior + [3]*edge_non_corner + [2]*corners
                degrees.sort(reverse=True)  # descending
                # assign labels 1..N to vertices sorted by degree descending: largest labels to highest degree
                labels = list(range(1, N+1))
                labels.sort()  # ascending
                # we need to assign largest labels to highest degree: so pair reversed
                total = sum(d * l for d, l in zip(degrees, reversed(labels)))  # reversed labels: largest to highest degree
                # edges count
                E = (rows-1)*cols + rows*(cols-1)
                S_bound = total // E
