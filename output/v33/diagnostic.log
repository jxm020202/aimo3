            import math, itertools
            
            def f_bruteforce(n):
                best = None
                # search N up to maybe some bound, but we can search over triples a<b<c with sum=n and compute lcm
                # Since lcm may be large, but we can bound N by n maybe.
                for a in range(1, n-1):
                    for b in range(a+1, n):
                        c = n - a - b
                        if c <= b: continue
                        # distinct positive integers a<b<c, sum=n
                        # compute lcm
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                return best
            
