            import sympy as sp
            
            def f_bruteforce(n, limit=10000):
                # find smallest N such that there exist three distinct divisors summing to n
                for N in range(1, limit+1):
                    divs = sp.divisors(N)
                    # need three distinct positive divisors
                    for i in range(len(divs)):
                        for j in range(i+1, len(divs)):
                            for k in range(j+1, len(divs)):
                                if divs[i] + divs[j] + divs[k] == n:
                                    return N
                return None
            
            def f_formula(n):
                m = n-1
                # find largest divisor d of m with 2 <= d < m/2
                # if none, return None?
                maxd = None
                for d in sp.divisors(m):
                    if 2 <= d < m/2:
                        if maxd is None or d > maxd:
                            maxd = d
                if maxd is None:
                    return None
                return n - maxd - 1
            
