            import math, itertools
            
            def max_in_interval(angles, interval_deg=100):
                # angles in degrees sorted
                n = len(angles)
                # duplicate angles +360 for wrap-around
                angles2 = angles + [a+360 for a in angles]
                maxcnt = 0
