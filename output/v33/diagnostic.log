            def max_N(R, Smax):
                # find max N such that minimal sum of C(k,2) <= Smax
                # binary search
                lo, hi = 0, R*R  # upper bound
                while lo < hi:
                    mid = (lo+hi+1)//2
                    q = mid // R
                    r = mid - q*R
                    # sum C
                    def C2(k):
                        return k*(k-1)//2
                    total = r*C2(q+1) + (R - r)*C2(q)
                    if total <= Smax:
                        lo = mid
                    else:
                        hi = mid-1
                return lo
            
