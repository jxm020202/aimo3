                # Build equality constraints:
                # For each cell i: sum_{num} x_{i,num}=1
                # For each number n: sum_{cell} x_{cell,n}=1
                # Edge constraints: for each edge (i,j): sum_{num} num * x_{i,num} + sum_{num} num * x_{j,num} >= S
                # This is linear: - sum_{num} num * x_{i,num} - sum_{num} num * x_{j,num} <= -S
                # We'll construct A_ub matrix rows for each edge.
                # Use scipy.sparse? We'll use dense for small size.
                from scipy.sparse import csr_matrix, vstack, hstack, diags
            
