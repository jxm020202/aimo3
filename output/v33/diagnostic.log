            def find_perm_backtrack(N):
                # use backtracking with pruning
                used = [False]*(N+1)
                perm = [0]*N
                diffs_used = set()
                # we need exactly one fixed point (diff 0)
                # We'll try to place fixed point at some position later.
                def backtrack(i):
                    if i==N:
                        # check condition
                        diffs = [abs(perm[j]-(j+1)) for j in range(N)]
                        if diffs.count(0)!=1:
                            return False
                        nonzero = [d for d in diffs if d!=0]
                        if sorted(nonzero)==list(range(1,N)):
                            return True
                        return False
                    # try possible values for position i (1-indexed)
                    for val in range(1,N+1):
                        if not used[val]:
                            diff = abs(val-(i+1))
                            # prune: if diff in diffs_used (nonzero) then cannot repeat
                            if diff!=0 and diff in diffs_used:
                                continue
                            # also ensure we don't exceed count of diff 0 >1
                            if diff==0 and any(abs(perm[j]-(j+1))==0 for j in range(i)):
                                continue
                            # assign
                            used[val]=True
                            perm[i]=val
                            if diff!=0:
                                diffs_used.add(diff)
                            if backtrack(i+1):
                                return True
                            # undo
                            used[val]=False
                            if diff!=0:
                                diffs_used.remove(diff)
                    return False
                if backtrack(0):
                    return perm
                else:
                    return None
            
            print(find_perm_backtrack(13))
            
