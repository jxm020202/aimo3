            def feasible_with_k(k):
                # Build MILP with constraint sum x <= k
                n=13
                left_vals = list(range(-(n-1), n))
                right_vals = list(range(2, 2*n+1))
                left_index = {v:i for i,v in enumerate(left_vals)}
                right_index = {v:i for i,v in enumerate(right_vals)}
                num_left = len(left_vals)
                num_right = len(right_vals)
                cells = []
                for r in range(1,n+1):
                    for c in range(1,n+1):
                        d1 = r - c
                        d2 = r + c
                        cells.append((r,c,d1,d2))
                num_cells = len(cells)
                num_vars = num_cells + num_left + num_right
                A = []
                lb = []
                ub = []
                # cell constraints: y_left + y_right >= 1
                for idx,(r,c,d1,d2) in enumerate(cells):
                    row = np.zeros(num_vars)
                    row[num_cells + left_index[d1]] = 1
                    row[num_cells + num_left + right_index[d2]] = 1
                    A.append(row)
                    lb.append(1)
                    ub.append(np.inf)
                # left diag: sum x - y >= 0
                for d1, li in left_index.items():
                    row = np.zeros(num_vars)
                    for idx,(r,c,dd1,dd2) in enumerate(cells):
                        if dd1 == d1:
                            row[idx] = 1
                    row[num_cells + li] = -1
                    A.append(row)
                    lb.append(0)
                    ub.append(np.inf)
                # right diag
                for d2, ri in right_index.items():
                    row = np.zeros(num_vars)
                    for idx,(r,c,dd1,dd2) in enumerate(cells):
                        if dd2 == d2:
                            row[idx] = 1
                    row[num_cells + num_left + ri] = -1
                    A.append(row)
                    lb.append(0)
                    ub.append(np.inf)
                # objective: minimize sum x (but we will add constraint sum x <= k)
                c = np.zeros(num_vars)
                c[:num_cells] = 1
                # constraint sum x <= k
                row = np.zeros(num_vars)
                row[:num_cells] = 1
                A.append(row)
                lb.append(-np.inf)
                ub.append(k)
                # Build LinearConstraint
                A = np.array(A)
                lb = np.array(lb, dtype=float)
                ub = np.array(ub, dtype=float)
                lincon = LinearConstraint(A, lb, ub)
                var_bounds = Bounds(0,1)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=lincon, bounds=var_bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                return res.success
            
