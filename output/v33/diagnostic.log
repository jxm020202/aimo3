                start_states = []
                # first move can flip any coin, so we can start from any position after flipping it.
                # We'll BFS over (pos, config) after each move.
                from itertools import product
                # Represent config as bitmask integer for speed (0=H,1=T)
                init_mask = 0
                for i in range(N):
                    if (i+1)%2==1:  # odd position T
                        init_mask |= (1<<i)
                # BFS
                visited = set()
                q = deque()
                # initial moves: flip any coin i (0-index)
                for i in range(N):
                    mask = init_mask ^ (1<<i)  # flip coin i
                    state = (i, mask)
                    visited.add(state)
                    q.append((state, 1))
                target_mask = 0  # all heads
                while q:
                    (pos, mask), d = q.popleft()
                    if mask == target_mask:
                        return d
                    # next moves: flip adjacent coin
                    for nb in [pos-1, pos+1]:
                        if 0 <= nb < N:
                            new_mask = mask ^ (1<<nb)
                            new_state = (nb, new_mask)
                            if new_state not in visited:
                                visited.add(new_state)
                                q.append((new_state, d+1))
                return None
            
