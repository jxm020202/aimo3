            def check_condition(edges, n=160):
                # adjacency list
                adj = {i:set() for i in range(n)}
                for u,v in edges:
                    adj[u].add(v)
                    adj[v].add(u)
                for u in range(n):
                    # find a neighbor v such that N(u) ∩ N(v) == empty
                    found=False
                    for v in adj[u]:
                        # compute common neighbors
                        common = adj[u].intersection(adj[v])
                        # exclude u and v themselves (they are not in adjacency sets)
                        if len(common)==0:
                            found=True
                            break
                    if not found:
                        return False, u
                return True, None
            
