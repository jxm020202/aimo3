        cur=min_edge_sum_grid(grid)
        if cur>best:
            best=cur
            best_grid=grid.copy()
        # acceptance
        if cur>=best or random.random()<math.exp((cur-best)/temp):
            pass
        else:
            grid[i1,j1],grid[i2,j2]=grid[i2,j2],grid[i1,j1]
