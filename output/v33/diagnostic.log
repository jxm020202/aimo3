            def max_min_sum(m,n):
                N=m*n
                # bipartite coloring: (i+j)%2
                best=0
                best_assign=None
                for perm in itertools.permutations(range(1,N+1)):
                    # assign numbers to cells row-major order
                    grid=[[0]*n for _ in range(m)]
                    idx=0
                    for i in range(m):
