            def max_S_grid(rows, cols):
                N = rows*cols
                # variable ordering: x_{cell, num} flattened: index = cell*N + (num-1)
                n_vars = N * N
                # objective: maximize S, but S is not a variable; we can binary search on S.
                # We'll implement feasibility check for given S.
