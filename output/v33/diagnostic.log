            def find_permutation_solution(n):
                # ILP: binary variables x_{i,j} with row sum = 1
                num_vars = n*n
                # constraints: covering as before
                A_cov = np.zeros((n*n, num_vars), dtype=int)
                for i in range(n):
                    for j in range(n):
                        row = i*n + j
                        for v in diag1[i-j]:
                            A_cov[row, v] = 1
                        for v in diag2[i+j]:
                            A_cov[row, v] = 1
                # row sum constraints
                A_rows = np.zeros((n, num_vars), dtype=int)
                for i in range(n):
                    for j in range(n):
                        A_rows[i, i*n + j] = 1
                # combine
                A = np.vstack([A_cov, A_rows])
                lb = np.concatenate([np.ones(n*n), np.ones(n)])  # covering >=1, row sum >=1 (actually =1)
                ub = np.concatenate([np.full(n*n, np.inf), np.ones(n)])  # row sum <=1
                c = np.ones(num_vars)
                bounds = Bounds(np.zeros(num_vars), np.ones(num_vars))
