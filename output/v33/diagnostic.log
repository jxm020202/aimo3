            def can_slide(dom_idx, direction, sol):
                # direction: 'left','right','up','down'
                d = dominos[dom_idx]
                typ = d['type']
                r,c = d['pos']
                # compute cells after slide
                if direction == 'left':
                    # shift left by 1
                    new_cells = [(r, c-1), (r, c)] if typ == 'H' else [(r, c-1), (r+1, c-1)]
                elif direction == 'right':
                    new_cells = [(r, c+1), (r, c+2)] if typ == 'H' else [(r, c+1), (r+1, c+1)]
                elif direction == 'up':
                    new_cells = [(r-1, c), (r-1, c+1)] if typ == 'H' else [(r-1, c), (r, c)]
                elif direction == 'down':
                    new_cells = [(r+1, c), (r+1, c+1)] if typ == 'H' else [(r+2, c), (r+1, c)]
                else:
                    raise ValueError
                # check if new cells within board
                for (rr,cc) in new_cells:
                    if not (0 <= rr < n and 0 <= cc < n):
                        return False  # off-board, cannot slide
                # check if new cells are empty (not occupied by other dominos)
                # current occupied cells by this domino are d['cells']; they will become empty after slide
                occupied = set()
                for i, val in enumerate(sol):
                    if val == 1 and i != dom_idx:
                        occupied.update(dominos[i]['cells'])
                # now check if any new cell is occupied
                for cell in new_cells:
                    if cell in occupied:
                        return False
                # also need to ensure that the cells vacated are not needed for other dominos? Actually they become empty, that's fine.
                return True
            
            # verify all placed dominos cannot slide any direction
            bad = []
            for idx in placed:
                for dirc in ['left','right','up','down']:
                    if can_slide(idx, dirc, solution):
                        bad.append((idx, dirc))
            len(bad), bad[:10]
            
