            from scipy.optimize import LinearConstraint, milp, Bounds
            def max_edges_n(n):
                pairs = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(pairs)
                idx = {pair: k for k,pair in enumerate(pairs)}
                total_vars = 2*m
                # Build constraints matrices
                rows = []
                lb = []
                ub = []
                # Constraint 1: y <= x  => y - x <= 0
                for (i,j), k in idx.items():
                    row = np.zeros(total_vars)
                    row[m + k] = 1   # y
                    row[k] = -1      # -x
                    rows.append(row)
                    lb.append(-np.inf)
                    ub.append(0)
                # Constraint 2: y_{ij} + x_{i,w} + x_{j,w} <= 2
                for (i,j), k in idx.items():
                    for w in range(n):
                        if w==i or w==j:
                            continue
                        a,b = (i,w) if i<w else (w,i)
                        idx_iw = idx[(a,b)]
                        a,b = (j,w) if j<w else (w,j)
                        idx_jw = idx[(a,b)]
                        row = np.zeros(total_vars)
                        row[m + k] = 1
                        row[idx_iw] = 1
                        row[idx_jw] = 1
                        rows.append(row)
                        lb.append(-np.inf)
                        ub.append(2)
                # Constraint 3: sum_{j != i} y_{i,j} >= 1  => -sum y <= -1
                for i in range(n):
                    row = np.zeros(total_vars)
                    for j in range(n):
                        if i==j: continue
                        a,b = (i,j) if i<j else (j,i)
                        k = idx[(a,b)]
                        row[m + k] = -1
                    rows.append(row)
                    lb.append(-np.inf)
                    ub.append(-1)
                A = np.vstack(rows)
                lin_con = LinearConstraint(A, lb, ub)
                # bounds for variables
                bounds = Bounds(0, 1)
                # integrality vector
                integrality = np.ones(total_vars, dtype=int)
                # objective: maximize sum x => minimize -sum x
                c = np.zeros(total_vars)
                c[:m] = -1  # minimize -sum x = maximize sum x
                res = milp(c=c, constraints=[lin_con], bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    print("Failed:", res.message)
                    return None
                x_vals = np.rint(res.x[:m]).astype(int)
                total_edges = x_vals.sum()
                return total_edges
            
