            import random, itertools, math, time
            
            def min_adj_sum_grid(arr,m,n):
                # arr is list of length m*n
                # convert to 2D
                grid = [arr[i*n:(i+1)*n] for i in range(m)]
                min_sum = 10**9
                for i in range(m):
                    for j in range(n):
                        if i+1<m:
                            min_sum = min(min_sum, grid[i][j]+grid[i+1][j])
                        if j+1<n:
                            min_sum = min(min_sum, grid[i][j]+grid[i][j+1])
                return min_sum
            
            def random_arrangement(m,n):
                N=m*n
                arr=list(range(1,N+1))
                random.shuffle(arr)
                return arr
            
            def improve(m,n,iterations=100000):
                N=m*n
                arr=list(range(1,N+1))
                random.shuffle(arr)
                best=min_adj_sum_grid(arr,m,n)
                best_arr=arr[:]
                for it in range(iterations):
                    # random swap two positions
                    i,j=random.sample(range(N),2)
                    arr[i],arr[j]=arr[j],arr[i]
                    cur=min_adj_sum_grid(arr,m,n)
