            import random, math, itertools, time, copy, sys, numpy as np
            
            def min_adj_sum(grid):
                m = len(grid)
                n = len(grid[0])
                mins = sys.maxsize
                for i in range(m):
                    for j in range(n):
                        v = grid[i][j]
                        if i+1<m:
                            mins = min(mins, v+grid[i+1][j])
                        if j+1<n:
                            mins = min(mins, v+grid[i][j+1])
                return mins
            
            def random_grid(m,n):
                N = m*n
                perm = list(range(1,N+1))
                random.shuffle(perm)
                grid = [perm[i*n:(i+1)*n] for i in range(m)]
                return grid
            
            def hill_climb(m,n,iterations=50000):
                N=m*n
                # start with checkerboard assignment: low numbers on black squares, high on white
                # define color parity (i+j)%2
                low_numbers = list(range(1,N//2+1))
                high_numbers = list(range(N//2+1,N+1))
                grid=[[0]*n for _ in range(m)]
                low_idx=0
                high_idx=0
                for i in range(m):
                    for j in range(n):
                        if (i+j)%2==0:
                            grid[i][j]=low_numbers[low_idx]; low_idx+=1
                        else:
                            grid[i][j]=high_numbers[high_idx]; high_idx+=1
                best=grid
                best_score=min_adj_sum(grid)
                for it in range(iterations):
                    # pick two random cells and swap
                    i1,j1=random.randrange(m),random.randrange(n)
                    i2,j2=random.randrange(m),random.randrange(n)
                    if (i1,j1)==(i2,j2): continue
                    # swap
                    grid[i1][j1],grid[i2][j2]=grid[i2][j2],grid[i1][j1]
                    score=min_adj_sum(grid)
                    if score>=best_score:
                        best_score=score
                        best=[row[:] for row in grid]
                    else:
                        # revert with some probability (simulated annealing)
                        # simple hill climb: revert if worse
                        grid[i1][j1],grid[i2][j2]=grid[i2][j2],grid[i1][j1]
                return best_score,best
            
            print(hill_climb(3,4,iterations=200000)[0])
            
