            def max_in_interval(angles, interval_deg=100):
                n = len(angles)
                angles2 = angles + [a+360 for a in angles]
                maxcnt = 0
                j = 0
                for i in range(n):
                    while j < i+n and angles2[j] - angles2[i] <= interval_deg + 1e-9:
                        j += 1
                    cnt = j - i
                    if cnt > maxcnt:
                        maxcnt = cnt
                return maxcnt
            
