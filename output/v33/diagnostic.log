            import sympy as sp
            
            def solve_n(n):
                # n = number of d_i variables, sum d_i = total_sum
                total_sum = sp.symbols('total_sum')
                # variables d1..dn
                d = sp.symbols('d1:'+str(n+1))
                lam = sp.symbols('lam')
                eqs = []
                # sum constraint
                eqs.append(sp.Eq(sum(d), total_sum))
                # boundary equations derived from KKT (including lambda)
                # For k=1:
                eqs.append(sp.Eq(2 + 4*d[0] + 2*d[1] + lam, 0))
                # For interior 2..n-1 (if n>=3)
                for k in range(2, n):
                    # index k-1 in 0-based is k-1
                    eqs.append(sp.Eq(2*d[k-2] + 4*d[k-1] + 2*d[k] + lam, 0))
                # For k=n (last):
                eqs.append(sp.Eq(2*d[n-2] + 4*d[n-1] - 398 + lam, 0))
                # Solve linear system
                sol = sp.solve(eqs, list(d)+[lam], dict=True)
                return sol
            
