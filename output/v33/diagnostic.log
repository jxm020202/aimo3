            def find_perm_distinct(N):
                # backtrack for permutation sigma with exactly one fixed point and distinct nonzero diffs covering 1..N-1
                used_vals = [False]*(N+1)
                sigma = [0]*N
                diffs_used = set()
                fixed_used = False
                def backtrack(i):
                    nonlocal fixed_used
                    if i==N:
                        # check coverage
                        if len(diffs_used)==N-1 and fixed_used:
                            return True
                        return False
                    # try assign sigma[i] (i+1)
                    for val in range(1,N+1):
                        if not used_vals[val]:
                            diff = abs(val - (i+1))
                            if diff==0:
                                if fixed_used:
