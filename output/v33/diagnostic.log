            import sympy as sp, random, math, itertools, sys, numpy as np, cmath, time, warnings, math
            warnings.filterwarnings('ignore')
            def find_solution(n,m,tries=20):
                # variables: r_0,...,r_{n-1}
                rs = sp.symbols('r0:'+str(n))
                eqs = []
                for e in range(1,m+1):
                    prod = 1
                    for r in rs:
                        prod *= (r**e + 1)
                    eqs.append(sp.Eq(prod, 1))
                # convert to equations for nsolve (real and imag)
                eqs_complex = []
                for eq in eqs:
                    # eq.lhs - eq.rhs = 0
                    expr = eq.lhs - eq.rhs
                    eqs_complex.append(sp.re(expr))
                    eqs_complex.append(sp.im(expr))
                # initial guess random
                for t in range(tries):
                    guess = []
                    for i in range(2*n):
                        guess.append(random.uniform(-2,2))
                    try:
                        sol = sp.nsolve(eqs_complex, list(rs), guess, tol=1e-14, maxsteps=100)
                        # check if not all zero
                        if any(abs(complex(sol[i]))>1e-6 for i in range(n)):
                            return sol
                    except Exception as e:
                        continue
                return None
            
            sol = find_solution(3,3,tries=30)
            print(sol)
            
