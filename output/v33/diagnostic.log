                    for y2 in range(y1+1, n+1):
                        # choose two distinct columns for top row
                        cols = list(range(1, n+1))
                        for a,b in combinations(cols,2):
                            for c,d in combinations(cols,2):
                                # need to consider pairing (a,c) and (b,d) as legs
                                if abs(a - c) == abs(b - d):
                                    # add constraint for points (a,y1),(b,y1),(c,y2),(d,y2)
                                    indices = [(a-1)*n + (y1-1), (b-1)*n + (y1-1), (c-1)*n + (y2-1), (d-1)*n + (y2-1)]
                                    constraints.append(indices)
                                # also consider pairing (a,d) and (b,c) maybe? That would correspond to crossing legs; not a trapezoid.
