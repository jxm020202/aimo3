            import itertools, math
            
            def max_min_adj_sum(m,n):
                N=m*n
                # generate all permutations of numbers 1..N assigned to cells in row-major order
                # For N up to 9 maybe.
                best=0
                best_perm=None
                # adjacency edges list
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx, (i+1)*n+j))
                        if j+1<n:
                            edges.append((idx, i*n+(j+1)))
                for perm in itertools.permutations(range(1,N+1)):
                    # compute min edge sum
                    mins=math.inf
                    for u,v in edges:
                        s=perm[u]+perm[v]
                        if s<mins:
                            mins=s
                            if mins<=best: # early break
                                break
                    else:
                        # all edges processed
                        if mins>best:
                            best=mins
                            best_perm=perm
                return best, best_perm
            
