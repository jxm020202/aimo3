            def min_vertex_cover_bipartite(G, U):
                # G bipartite with bipartition (U,V)
                V = set(G.nodes()) - set(U)
                # find maximum matching
                M = nx.algorithms.bipartite.maximum_matching(G, top_nodes=U)
                # M is dict mapping each matched vertex to its partner
                # Build set of unmatched vertices in U
                unmatched_U = [u for u in U if u not in M]
                # BFS alternating paths starting from unmatched_U
                visited = set()
                queue = list(unmatched_U)
                while queue:
                    u = queue.pop(0)
                    if u in visited:
                        continue
                    visited.add(u)
                    # If u in U, follow edges not in matching to V
                    if u in U:
                        for v in G[u]:
                            if M.get(u) != v:  # edge not in matching
                                if v not in visited:
                                    queue.append(v)
                    else:  # u in V, follow matched edge to U
                        if u in M:
                            w = M[u]
                            if w not in visited:
                                queue.append(w)
                Z = visited
                # min vertex cover = (U - Z) ∪ (V ∩ Z)
                cover = set(u for u in U if u not in Z) | set(v for v in V if v in Z)
                return cover
            
