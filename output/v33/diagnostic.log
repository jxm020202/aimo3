            def upper_bound_S(m,n):
                N=m*n
                # count degrees
                corners = 4
                edge_noncorner = 2*m + 2*n - 8  # perimeter cells minus corners
                interior = N - corners - edge_noncorner
                # edges count
                edges = (m-1)*n + (n-1)*m
                # assign numbers descending to interior, edge, corners
                numbers = list(range(N,0,-1))
                idx=0
                weighted_sum=0
                # interior
                for _ in range(interior):
                    weighted_sum += numbers[idx]*4
                    idx+=1
                # edge
                for _ in range(edge_noncorner):
                    weighted_sum += numbers[idx]*3
                    idx+=1
                # corners
                for _ in range(corners):
                    weighted_sum += numbers[idx]*2
                    idx+=1
                return weighted_sum // edges
            
