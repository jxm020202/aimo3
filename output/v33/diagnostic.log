            def backtrack(n, used, perm, diffs_used):
                i = len(perm)  # next index i (0-based) corresponds to element i+1
                if i==n:
                    return perm
                for val in range(1,n+1):
                    if not used[val]:
                        diff = abs(val - (i+1))
                        if diff==0 or diffs_used[diff]:
                            continue
                        used[val]=True
                        diffs_used[diff]=True
                        perm.append(val)
                        res = backtrack(n, used, perm, diffs_used)
                        if res:
                            return res
                        perm.pop()
                        used[val]=False
                        diffs_used[diff]=False
                return None
            
            def find_perm_backtrack(n):
                used = [False]*(n+1)
                diffs_used = [False]*(n+1)
                return backtrack(n, used, [], diffs_used)
            
            for n in range(2,13):
                perm = find_perm_backtrack(n)
                print(n, perm)
            
