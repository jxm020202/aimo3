                # Use recursion/backtracking
                def backtrack(seq):
                    nonlocal min_val, best_seq
                    i = len(seq)
                    if i == N-1:
                        # last element must be M
                        if seq[-1] <= M:
                            full = seq + [M]
                            # compute f
