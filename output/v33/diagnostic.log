            import itertools
            
            def max_S_grid(m,n):
                N=m*n
                cells = [(i,j) for i in range(m) for j in range(n)]
                adj = []
                for i,j in cells:
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            if (i,j) < (ni,nj):
                                adj.append(((i,j),(ni,nj)))
                maxS=0
                best=None
                for perm in itertools.permutations(range(1,N+1)):
                    assign = dict(zip(cells, perm))
                    min_sum = min(assign[a]+assign[b] for a,b in adj)
                    if min_sum>maxS:
                        maxS=min_sum
                        best=assign
                return maxS, best
            
            print(max_S_grid(2,2)[0])
            
