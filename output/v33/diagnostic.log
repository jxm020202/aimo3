            def brute_min_f(n, a1, an):
                # n odd length, a1 fixed, an fixed
                # generate all nondecreasing integer sequences a_i between a1 and an inclusive
                # brute force for small n only
                from itertools import product
                # number of positions = n
                # we can generate sequences via recursion
                best = None
                best_seq = None
                def rec(idx, prev, seq):
                    nonlocal best, best_seq
                    if idx == n:
                        # compute f
                        a = [0] + seq  # 1-indexed
                        S = sum(x*x for x in a[1:])
                        P = sum(a[i]*a[i+2] for i in range(1, n-1))
                        f = S - P
                        if best is None or f < best:
                            best = f
                            best_seq = a[1:]
                        return
                    # remaining positions: need to ensure we can reach an at end
                    # minimal possible value for remaining positions is prev
                    # maximal possible is an
                    for val in range(prev, an+1):
                        # prune: if we cannot reach an with remaining steps (since monotone)
                        # we need at most (n-idx) steps left, can increase at most (an - val)
                        # but monotonic allows any increase, so no prune needed
                        rec(idx+1, val, seq+[val])
                rec(1, a1, [a1])
                return best, best_seq
            
            def test_small():
                for n in [5,7,9]:
                    best, seq = brute_min_f(n, 1, 5)
                    print(n, best, seq)
            test_small()
            
