            def generate_grid(max_x, max_y):
                # backtracking generator yields dict assignments
                positions = [(i,j) for i in range(max_x+1) for j in range(max_y+1)]
                # order: maybe row-major
                positions.sort()
                # we know (0,0)=0
                initial = {(0,0):0}
                # recursion
                def backtrack(idx, assign):
                    if idx == len(positions):
                        yield assign
                        return
                    pos = positions[idx]
                    if pos in assign:
                        # already assigned (like (0,0))
                        yield from backtrack(idx+1, assign)
                        return
                    # Determine possible values: we can bound by existing neighbors?
                    # For simplicity, try values from 0..max_val where max_val maybe 10
                    # but we need to be generous.
                    # We'll compute constraints that involve this pos and already assigned others.
                    # The constraints are L-shapes where this pos is one of the three.
                    # For each (x,y) such that set includes pos and other two are assigned,
                    # we can deduce possible values.
                    possible_vals = None
                    # iterate over all (x,y) such that pos in { (x,y), (x,y+1), (x+1,y) }
                    for x in range(max_x):
                        for y in range(max_y):
                            triple = [(x,y), (x,y+1), (x+1,y)]
                            if pos not in triple:
                                continue
                            # check which of the triple are assigned
                            assigned = [(p, assign[p]) for p in triple if p in assign]
                            if len(assigned) == 3:
                                # already fully assigned, check condition
                                vals = [v for _,v in assigned]
                                if max(vals)-min(vals)!=2 or len(set(vals))!=3:
                                    return
                            elif len(assigned) == 2:
                                # two values known, third unknown (pos)
                                # The three values must be consecutive integers.
                                known_vals = [v for _,v in assigned]
                                # Determine possible third values that make set consecutive
                                # The set of three consecutive numbers must contain both known values.
                                # So the min of the three is min(known_vals, third), max is max(...).
                                # Let's brute: try third from 0..max_known+2 maybe.
                                cand = set()
                                for n in range(min(known_vals)-2, max(known_vals)+3):
                                    s = {n, n+1, n+2}
                                    if set(known_vals).issubset(s):
                                        # third value is the element of s not in known_vals
                                        third_val = (s - set(known_vals)).pop()
                                        cand.add(third_val)
                                if possible_vals is None:
                                    possible_vals = cand
                                else:
                                    possible_vals &= cand
                    if possible_vals is None:
                        # no constraints yet, allow a range
                        # we can bound by max existing value +2 maybe
                        max_existing = max(assign.values())
                        # allow values up to max_existing+2
                        possible_vals = set(range(0, max_existing+3))
                    # iterate possible values
                    for v in sorted(possible_vals):
                        # assign and continue
                        new_assign = dict(assign)
                        new_assign[pos] = v
                        # check any fully assigned constraints for violation early
                        ok = True
                        for x in range(max_x):
                            for y in range(max_y):
                                triple = [(x,y), (x,y+1), (x+1,y)]
                                if all(p in new_assign for p in triple):
                                    vals = [new_assign[p] for p in triple]
                                    if max(vals)-min(vals)!=2 or len(set(vals))!=3:
                                        ok=False
                                        break
                            if not ok:
                                break
                        if ok:
                            yield from backtrack(idx+1, new_assign)
                # start recursion
                yield from backtrack(0, initial)
            
