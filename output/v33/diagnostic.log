            import sympy as sp
            
            def smallest_odd_divisor_n_minus_1(c, max_prime=100000):
                # returns smallest odd divisor >2 of n-1 = M + c - 1
                # M = 3**(2025!)
                # We'll search odd primes up to max_prime
                # For each prime p, test divisibility.
                # Use pow with exponent e = 2025! mod (p-1)
                # Compute factorial_mod = 2025! % (p-1)
                # Since 2025! huge, compute product modulo (p-1)
                # For p-1 <= 2025, factorial_mod = 0
                # We'll compute using loop up to min(2025, p-2)
                for p in sp.primerange(3, max_prime+1):
                    if p == 3:
                        if (c - 1) % 3 == 0:
                            return 3
                        else:
                            continue
                    # compute e = 2025! mod (p-1)
                    mod = p - 1
                    if mod <= 2025:
                        e = 0
                    else:
                        # compute factorial modulo mod
                        e = 1
                        for i in range(2, 2026):
                            e = (e * i) % mod
                    M_mod = pow(3, e, p)
