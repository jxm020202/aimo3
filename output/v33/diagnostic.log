            def max_matching_parity_edges(parity):
                # Build bipartite graph adjacency left->right
                left = [d for d in d1_vals if d%2==parity]
                right = [d for d in d2_vals if d%2==parity]
                adj = {u: [] for u in left}
                for i in range(1, n+1):
                    for j in range(1, n+1):
                        if (i+j)%2==parity:
                            d1 = i - j
                            d2 = i + j
                            adj[d1].append(d2)
                # maximum matching using augmenting path
                matchR = {}
                matchL = {}
                def dfs(u, seen):
                    for v in adj[u]:
                        if v in seen:
                            continue
                        seen.add(v)
                        if v not in matchR or dfs(matchR[v], seen):
                            matchR[v] = u
                            matchL[u] = v
                            return True
                    return False
                for u in left:
                    dfs(u, set())
                return len(matchL)
            
