            def black_squares_reachable(n):
                max_reach = 0
                max_pos = None
                for i in range(n):
                    for j in range(n):
                        if (i+j)%2==0: # black
                            # compute reachable black squares
                            reach = set()
                            # NW-SE diagonal
                            d = i-j
                            for ii in range(n):
                                jj = ii - d
                                if 0 <= jj < n and (ii+jj)%2==0:
                                    reach.add((ii,jj))
                            # NE-SW diagonal
                            s = i+j
                            for ii in range(n):
                                jj = s - ii
                                if 0 <= jj < n and (ii+jj)%2==0:
                                    reach.add((ii,jj))
                            if len(reach) > max_reach:
                                max_reach = len(reach)
                                max_pos = (i,j)
                return max_reach, max_pos
            
