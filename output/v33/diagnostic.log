            import itertools, math, numpy as np, sys, time, math, collections, itertools, random, sys, os, json, math, numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def feasible_grid(m,n,S):
                N=m*n
                # cell indices 0..N-1
                # edges list
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx,(i+1)*n+j))
                        if j+1<n:
                            edges.append((idx,i*n+(j+1)))
                # Variables: x_{cell, number} binary
                # Flatten index: var index = cell*N + (num-1) (num from 1..N)
                var_count = N*N
                # Build constraints
                # 1) each cell assigned exactly one number: sum_{k} x_{cell,k}=1
                A_eq = np.zeros((N, var_count), dtype=int)
                for cell in range(N):
                    for k in range(N):
                        A_eq[cell, cell*N + k] = 1
                # 2) each number assigned to exactly one cell: sum_{cell} x_{cell,k}=1
                A_eq2 = np.zeros((N, var_count), dtype=int)
                for k in range(N):
                    for cell in range(N):
                        A_eq2[k, cell*N + k] = 1
                # combine equality constraints
                A_eq_all = np.vstack([A_eq, A_eq2])
                lb_eq = np.ones(N*2)  # each sum =1
                ub_eq = np.ones(N*2)
                # 3) edge constraints: for each edge (i,j) and each pair (k,l) with (k+1)+(l+1) < S
                # numbers are 1-indexed, but k,l are 0-indexed.
                # For each such pair, add inequality x_{i,k}+x_{j,l} <= 1
                # Also need symmetric pair (l,k) for edge (j,i) but same edge, we can include both.
                # We'll generate constraints list.
                rows=[]
                lbs=[]
                ubs=[]
                for (i,j) in edges:
                    for k in range(N):
                        a=k+1
                        # l must satisfy a + (l+1) < S => l < S-1-a
                        max_l = S-2 - k  # because l+1 < S - a => l < S-1 - a => l <= S-2-a
                        if max_l < 0:
                            continue
                        max_l = min(max_l, N-1)
                        for l in range(max_l+1):
                            # add constraint
                            row = np.zeros(var_count, dtype=int)
                            row[i*N + k] = 1
                            row[j*N + l] = 1
                            rows.append(row)
                            lbs.append(-np.inf)  # no lower bound
                            ubs.append(1)
                if rows:
                    A_ub = np.vstack(rows)
                    lb_ub = np.full(len(rows), -np.inf)
                    ub_ub = np.ones(len(rows))
                else:
                    A_ub = None
                    lb_ub = None
                    ub_ub = None
                # Build LinearConstraint objects
                constraints = []
                # equality constraints
                constraints.append(LinearConstraint(A_eq_all, lb_eq, ub_eq))
                if A_ub is not None:
                    constraints.append(LinearConstraint(A_ub, lb_ub, ub_ub))
                # objective: zero vector
                c = np.zeros(var_count)
                # bounds for variables: binary 0-1
                bounds = Bounds(0, 1)
                # integrality vector
                integrality = np.ones(var_count, dtype=int)
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={"presolve": True, "disp": False})
                return res.success
            
            print(feasible_grid(4,4,17))
            
