                        for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                            ni,nj=i+di,j+dj
                            if 0<=ni<m and 0<=nj<n:
                                mins=min(mins, v+grid[ni][nj])
                return mins
            
