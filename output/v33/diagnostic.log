            def max_sum_pairwise(N, max_rows=6):
                # brute force over possible a_i values up to N
                best = 0
                best_seq = None
                # we can limit number of rows to N (since at most N rows)
                # Use recursion to assign a_i values non-increasing to reduce sym.
                def rec(prev, rows_left, current_sum, seq):
                    nonlocal best, best_seq
                    if rows_left == 0:
                        if current_sum > best:
                            best = current_sum
                            best_seq = seq[:]
                        return
                    # maximum possible a_i is prev (non-increasing) and at most N
                    for a in range(min(prev, N), -1, -1):
                        # check product constraint with existing seq
                        ok = True
                        for prev_a in seq:
                            if a * prev_a > N:
                                ok = False
                                break
                        if not ok:
                            continue
                        # bound: even if we fill remaining rows with a each, sum would be current_sum + a*rows_left
                        # but we need not prune heavily.
                        rec(a, rows_left-1, current_sum + a, seq + [a])
                rec(N, N, 0, [])
                return best, best_seq
            
            for N in range(2,11):
                best, seq = max_sum_pairwise(N)
                print(N, best, seq[:10])
            
