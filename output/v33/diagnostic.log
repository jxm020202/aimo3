            from scipy.optimize import milp, LinearConstraint, Bounds, milp
            def max_edges_milp(n):
                # map edge (i,j) with i<j to index
                edge_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1,n):
                        edge_index[(i,j)] = idx
                        idx += 1
                m = idx  # number of edges
                # total variables: x (m) + y (m) = 2m
                total_vars = 2*m
                # objective: maximize sum x, i.e., c = [1]*m + [0]*m
                c = np.concatenate([np.ones(m), np.zeros(m)])
                # variable bounds: binary 0/1
                bounds = Bounds(np.zeros(total_vars), np.ones(total_vars))
                integrality = np.ones(total_vars, dtype=int)
                # constraints list
                A = []
                lb = []
                ub = []
                # For each vertex, sum of y incident >=1
                for u in range(n):
                    row = np.zeros(total_vars)
                    for v in range(n):
                        if v==u: continue
                        i,j = (u,v) if u<v else (v,u)
                        e_idx = edge_index[(i,j)]
                        # y variable index offset m
                        row[m + e_idx] = 1
                    A.append(row)
                    lb.append(1)
                    ub.append(np.inf)
                # y <= x constraints
                for (i,j), e_idx in edge_index.items():
                    row = np.zeros(total_vars)
                    # y - x <= 0 => y - x <= 0
                    row[m + e_idx] = 1
                    row[e_idx] = -1
                    A.append(row)
                    lb.append(-np.inf)
                    ub.append(0)
                # triangle constraints: for each triple i<j<k
                for i in range(n):
