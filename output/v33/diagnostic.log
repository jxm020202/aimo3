            def min_moves_algorithmic(n):
                # compute minimal L using parity method
                # p_i = 1 if i odd (1-indexed)
                p = [0]*(n+1) # 1-indexed
                for i in range(1,n+1):
                    p[i] = 1 if i%2==1 else 0
                best = None
                best_pair = None
                for s in range(1,n+1):
                    for t in range(1,n+1):
                        if (s%2)!=(t%2):
                            continue  # distance must be even
                        # compute b_i (incoming parity) for base walk from s to t
                        b = [0]*(n+1)
                        if s<t:
                            for i in range(s+1, t+1):
                                b[i]=1
                        elif s>t:
                            for i in range(t, s):
                                b[i]=1
                        # desired incoming parity t_i
                        target = [0]*(n+1)
                        for i in range(1,n+1):
                            target[i] = p[i] if i!=s else 1-p[i]
                        # compute d_i = target xor b
                        d = [0]*(n+1)
                        for i in range(1,n+1):
                            d[i] = (target[i] ^ b[i])
                        # compute e_i for i=1..n-1 as prefix parity of d
                        e = [0]*(n)  # e[1..n-1]
                        prefix = 0
                        for i in range(1,n):
                            prefix ^= d[i]
                            e[i]=prefix
                        # check consistency: need b[n] ^ e[n-1] == target[n] (mod2)
                        if (b[n] ^ e[n-1]) != target[n]:
                            continue
                        num_e = sum(e[1:])  # count of 1's
                        L = abs(s-t) + 2*num_e + 1
                        if best is None or L<best:
                            best = L
                            best_pair = (s,t,num_e)
                return best, best_pair
            
            for n in range(1,25,2):
                best, pair = min_moves_algorithmic(n)
                print(n, best, pair, formula_moves(n))
            
