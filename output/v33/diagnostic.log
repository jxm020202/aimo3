            def bound_max_S(m,n):
                N=m*n
                # degree distribution
                interior = max(0,(m-2)*(n-2))
                edge = 2*(m-2)+2*(n-2)  # non-corner edge cells
                corner = 4
                # assign largest numbers to interior, then edge, then corner
                numbers = list(range(1,N+1))
                # assign largest to interior
                interior_nums = list(range(N-interior+1, N+1))
                edge_nums = list(range(N-interior-edge+1, N-interior+1))
                corner_nums = list(range(1, N-interior-edge+1))
                total_edge_sum = sum(interior_nums)*4 + sum(edge_nums)*3 + sum(corner_nums)*2
                edges = (m-1)*n + (n-1)*m
                return total_edge_sum // edges
            
