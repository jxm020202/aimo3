            def feasible_for_S(black_assignment, S=3601):
                # black_assignment: dict from black cell to value (1..1800)
                # compute L_w for each white cell
                L = {}
                for w in white_cells:
                    max_req = -1
                    for nb in neighbors(w):
                        if nb in black_assignment:
                            a = black_assignment[nb]
                            req = S - a
                            if req > max_req:
                                max_req = req
                    # if white cell has no black neighbor (should not happen)
                    if max_req == -1:
                        max_req = -10**9
                    L[w] = max_req
                # sort white cells by required threshold descending
                sorted_ws = sorted(white_cells, key=lambda w: L[w], reverse=True)
                # available high numbers list descending
                high_numbers = list(range(3600, 1800, -1))  # 3600..1801
                # assign
                for w in sorted_ws:
                    req = L[w]
                    # find the largest remaining number that >= req
                    # high_numbers is sorted descending, so take first that >= req
                    # if first < req, fail
                    if high_numbers[0] < req:
                        return False
                    # assign the first (largest) to this cell (could also assign smallest >= req)
                    # but we just pop the first
