                # initialize start nodes (1,a2)
                for a2 in range(1, max_val+1):
                    node=(1,a2)
                    cost=1 + a2*a2
                    dist[node]=cost
                    heapq.heappush(pq,(cost,node))
                target=(max_val,max_val)
                while pq:
                    cost,node=heapq.heappop(pq)
                    if cost!=dist[node]:
                        continue
                    if node==target:
                        return cost
                    p,q=node
                    # generate edges to (q,r) for r>=q
                    for r in range(q, max_val+1):
                        newnode=(q,r)
                        newcost=cost + r*r - p*r
                        if newcost < dist.get(newnode, INF):
                            dist[newnode]=newcost
                            heapq.heappush(pq,(newcost,newnode))
