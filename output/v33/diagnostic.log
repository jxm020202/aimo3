                positions = [(i,j) for i in range(n) for j in range(n)]
                for it in range(iterations):
                    # temperature schedule linear
                    T = start_temp + (end_temp - start_temp) * it / iterations
                    # pick two random positions to swap
                    (i1,j1), (i2,j2) = random.sample(positions, 2)
                    # swap
                    arr[i1,j1], arr[i2,j2] = arr[i2,j2], arr[i1,j1]
                    new_min = min_adjacent_sum_grid(arr)
                    delta = new_min - current_min
