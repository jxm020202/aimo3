                                    constraints.append(indices)
                return constraints
            
            def max_points_bruteforce_milp(n):
                from scipy.optimize import milp, LinearConstraint, Bounds
                N = n*n
                c = -np.ones(N)  # maximize sum => minimize negative
                # variable bounds 0-1 integer
                bounds = Bounds(0, 1)
                # constraints: each forbidden 4-set sum <= 3
                cons = generate_trapezoid_constraints(n)
                A = np.zeros((len(cons), N), dtype=int)
                for i, idxs in enumerate(cons):
                    for idx in idxs:
                        A[i, idx] = 1
                # linear constraint: A x <= 3
                linear_constraint = LinearConstraint(A, -np.inf, np.full(len(cons), 3))
                res = milp(c=c, constraints=[linear_constraint], integrality=np.ones(N), bounds=bounds, options={'disp': False})
                if not res.success:
                    print("MILP failed")
                    return None
                selected = np.where(np.round(res.x) > 0.5)[0]
                return len(selected), selected
            
