            def min_max_grid(max_x, max_y):
                # compute min and max reachable a for each cell using DP with sets (but prune to min/max)
                # We'll use backtracking to compute min and max via BFS but store only min and max per cell.
                # However min and max may not be independent; we need to compute reachable sets.
                # Instead we can compute reachable sets for each cell using DP with sets, but limit size.
                # For small grid (<=10) it's fine.
                from collections import defaultdict
                # We'll use backtracking enumeration as before but collect min/max per cell.
                # Use same enumeration as reachable_values but only store min/max.
                assigned = {(0,0):0}
                min_vals = defaultdict(lambda: float('inf'))
                max_vals = defaultdict(lambda: -float('inf'))
                coords = [(x,y) for x in range(max_x+1) for y in range(max_y+1)]
                def get(coord):
                    return assigned.get(coord, None)
                def check_triple(x,y):
                    a = get((x,y))
                    b = get((x,y+1))
                    c = get((x+1,y))
                    if a is None or b is None or c is None:
                        return True
                    s = sorted([a,b,c])
                    return s[0]+1==s[1] and s[1]+1==s[2]
                def backtrack(idx):
                    if idx==len(coords):
                        for coord,val in assigned.items():
                            if val<min_vals[coord]:
                                min_vals[coord]=val
                            if val>max_vals[coord]:
                                max_vals[coord]=val
                        return
                    coord=coords[idx]
                    if coord in assigned:
                        backtrack(idx+1)
                        return
                    x,y=coord
                    max_dist = x+y
                    low = 0
                    high = 2*max_dist
                    for val in range(low, high+1):
                        assigned[coord]=val
                        ok=True
                        if x>0 and not check_triple(x-1,y):
                            ok=False
                        if y>0 and not check_triple(x,y-1):
                            ok=False
                        if x<max_x and y<max_y and not check_triple(x,y):
                            ok=False
                        if ok:
                            backtrack(idx+1)
                        del assigned[coord]
                backtrack(0)
                return dict(min_vals), dict(max_vals)
            
