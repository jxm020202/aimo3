                        a,b = (i,j) if i<j else (j,i)
                        k = idx[(a,b)]
                        row[m + k] = -1   # -y
                    A_ub.append(row)
                    b_ub.append(-1)
                # Objective: maximize sum x
                c = np.zeros(total_vars)
                for k in range(m):
                    c[k] = -1  # milp minimizes, so negative for max
                # Convert lists to arrays
                A_ub = np.array(A_ub)
                b_ub = np.array(b_ub)
                # Use milp
                res = opt.milp(c=c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, integrality=integrality, options={'disp': False})
