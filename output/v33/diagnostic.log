            import random, math, numpy as np
            
            def random_points_inside_circle(n, radius=1.0):
                pts = []
                for _ in range(n):
                    # random radius sqrt for uniform distribution
                    r = radius * math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    x = r*math.cos(theta)
                    y = r*math.sin(theta)
                    pts.append((x,y))
                return pts
            
            def compute_sum_points(pts, alpha_deg=100):
                n = len(pts)
                alpha = math.radians(alpha_deg)
                total = 0
                for i in range(n):
                    xi, yi = pts[i]
                    dirs = []
                    for j in range(n):
                        if i==j: continue
                        xj, yj = pts[j]
                        vx, vy = xj - xi, yj - yi
                        ang = math.atan2(vy, vx)
                        dirs.append(ang)
                    dirs.sort()
                    dirs2 = dirs + [a + 2*math.pi for a in dirs]
                    left = 0
                    maxcnt = 0
                    for right in range(len(dirs2)):
                        while dirs2[right] - dirs2[left] > alpha + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
