            from collections import deque
            
            def min_moves(N):
                # initial config: alternating T(0) H(1), starting with T at position 0 (index 0)
                init = tuple([0 if i%2==0 else 1 for i in range(N)])  # 0 tails, 1 heads
                target = tuple([1]*N)
                # BFS over (position, config) where position is index of last flipped coin (0-indexed)
                # first move can be any position, we treat start as flipping that coin.
                # We'll store visited states to avoid repeats.
                from collections import deque
                q = deque()
                visited = set()
                # initial moves: flip any coin i
                for i in range(N):
                    cfg = list(init)
                    cfg[i] ^= 1  # flip
                    state = (i, tuple(cfg))
                    q.append((state, 1))
                    visited.add(state)
                while q:
                    (pos, cfg), steps = q.popleft()
                    if cfg == target:
                        return steps
                    # next moves: flip adjacent coin left or right if exists
                    for np in [pos-1, pos+1]:
                        if 0 <= np < N:
                            newcfg = list(cfg)
                            newcfg[np] ^= 1
                            newstate = (np, tuple(newcfg))
                            if newstate not in visited:
                                visited.add(newstate)
                                q.append((newstate, steps+1))
                return None
            
            for N in range(1, 11):
                print(N, min_moves(N))
            
