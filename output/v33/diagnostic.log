            def can_all_see_all(pts, angle=100):
                for i, p in enumerate(pts):
                    angles = []
                    for j, q in enumerate(pts):
                        if i==j: continue
                        ang = math.degrees(math.atan2(q[1]-p[1], q[0]-p[0]))
                        if ang<0: ang+=360
                        angles.append(ang)
                    angles.sort()
                    # check if there exists interval of length angle covering all angles
                    # Equivalent to max gap between consecutive angles (including wrap) <= angle
                    # Actually we need interval length angle that contains all points, so the complement gap must be >= 360-angle
                    # Simpler: compute max angular gap between consecutive angles (including wrap)
                    max_gap = max((angles[(k+1)%len(angles)] - angles[k]) % 360 for k in range(len(angles)))
                    # If max_gap >= 360 - angle, then there is an interval of length angle covering all points
                    if max_gap < 360 - angle - 1e-9:
                        return False
                return True
            
