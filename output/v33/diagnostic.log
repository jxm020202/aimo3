            def angular_spread_point_on_arc(phi, theta, R=1):
                # point at angle phi on circle radius R
                # endpoints at 0 and theta
                ox, oy = R*math.cos(phi), R*math.sin(phi)
                # endpoint A at angle 0
                ax, ay = R, 0
                # endpoint B at angle theta
                bx, by = R*math.cos(theta), R*math.sin(theta)
                # direction vectors
                vA = (ax-ox, ay-oy)
                vB = (bx-ox, by-oy)
                # compute angle between vA and vB
                dot = vA[0]*vB[0] + vA[1]*vB[1]
                normA = math.hypot(*vA)
                normB = math.hypot(*vB)
                angle = math.degrees(math.acos(dot/(normA*normB)))
                return angle
            
