            import math, itertools
            
            def f_bruteforce(n, limit=200):
                # search N up to some limit? Actually we need to search triples (a,b,c) distinct positive ints sum=n
                # compute minimal lcm
                best = None
                best_trip = None
                for a in range(1, n-1):
                    for b in range(a+1, n):
                        c = n - a - b
                        if c <= b: continue
                        # distinct positive
                        # compute lcm
                        l = math.lcm(a,b,c)
                        if best is None or l < best:
                            best = l
                            best_trip = (a,b,c)
                return best, best_trip
            
            def f_bruteforce_with_1(n):
                # restrict to triples containing 1
                best = None
                best_trip = None
                for a in range(2, n-1):
                    b = n - 1 - a
                    if b <= a or b < 2: continue
                    l = math.lcm(a,b) # lcm with 1 is same
                    if best is None or l < best:
                        best = l
                        best_trip = (1,a,b)
                return best, best_trip
            
            for n in range(6, 31):
                f_all, trip_all = f_bruteforce(n)
                f1, trip1 = f_bruteforce_with_1(n)
                print(n, f_all, trip_all, f1, trip1, f_all==f1)
            
