    for i in range(m):
        for j in range(n):
            if i+1<m:
                mins=min(mins, grid[i,j]+grid[i+1,j])
            if j+1<n:
                mins=min(mins, grid[i,j]+grid[i,j+1])
    return mins

def simulated_annealing_grid(m,n,iterations=500000,initial_temp=5.0,cooling=0.9999):
