                for v in range(1, M+1):
                    DP[1, v] = 1 + v*v
                # store DP tables
                DP_list = [None, None, DP.copy()]  # index by i
                # also store predecessor for each (prev,curr) at each step
                pred_list = [None, None, np.zeros((M+1, M+1), dtype=np.int16)]  # store previous prev (x)
                for i in range(3, N+1):
                    DP_next = np.full((M+1, M+1), INF, dtype=np.int32)
                    pred = np.zeros((M+1, M+1), dtype=np.int16)
                    for y in range(1, M+1):
                        # values for x <= y
                        A = DP[1:y+1, y]  # shape (y,)
                        # pointer
                        ptr = 0
                        for z in range(y, M+1):
                            while ptr+1 < y:
                                cur = int(A[ptr]) - (ptr+1)*z
