                # We'll index cells 0..N-1
                # Flatten variable vector length N*N
                # Build constraints:
                # each cell gets exactly one number: sum_k x_{i,k}=1
                # each number assigned to exactly one cell: sum_i x_{i,k}=1
                # For each edge (i,j) and each possible pair (k,l) where k+l < S, we need to forbid assignment.
                # Instead we can binary search on S and check feasibility.
                # We'll implement feasibility check for given S.
                # Build adjacency list
                cells = [(i,j) for i in range(m) for j in range(n)]
                cell_index = {cells[i]: i for i in range(N)}
                edges = []
                for i in range(m):
                    for j in range(n):
                        idx = cell_index[(i,j)]
                        if i+1 < m:
                            edges.append((idx, cell_index[(i+1,j)]))
                        if j+1 < n:
                            edges.append((idx, cell_index[(i,j+1)]))
                # Precompute for each edge, list of forbidden (k,l) combos where k+l < S
                # We'll binary search S from 1 to 2N maybe.
                def feasible(S):
                    # Build constraints matrix A x >= b (or equality)
                    # We'll use LinearConstraint with equality for each cell and each number.
                    # Also for each edge, we need sum_{k,l: k+l < S} (x_{i,k} * x_{j,l}) = 0 (i.e., cannot assign such pair)
                    # This is quadratic, not linear. So MILP with linear constraints can't directly enforce pairwise sum constraints.
                    # Alternative: Use big-M linearization: For each edge (i,j) and each pair (k,l) with k+l < S, we can add constraint x_{i,k}+x_{j,l} <=1 (cannot both be 1). That's linear.
                    # Number of such constraints may be large but manageable for N=16.
                    pairs = [(k,l) for k in range(1,N+1) for l in range(1,N+1) if k+l < S]
                    # Build constraints list
                    # We'll collect rows for LinearConstraint
                    rows = []
                    lbs = []
                    ubs = []
                    # cell constraints
                    for i in range(N):
                        row = np.zeros(N*N)
                        for k in range(1,N+1):
                            row[i*N + (k-1)] = 1
                        rows.append(row)
                        lbs.append(1)
                        ubs.append(1)
                    # number constraints
                    for k in range(1,N+1):
                        row = np.zeros(N*N)
                        for i in range(N):
                            row[i*N + (k-1)] = 1
                        rows.append(row)
                        lbs.append(1)
                        ubs.append(1)
                    # edge constraints
                    for (i,j) in edges:
                        for (k,l) in pairs:
                            row = np.zeros(N*N)
                            row[i*N + (k-1)] = 1
                            row[j*N + (l-1)] = 1
                            rows.append(row)
                            lbs.append(0)
                            ubs.append(1)  # sum <=1
                    A = np.vstack(rows)
                    lc = LinearConstraint(A, lbs, ubs)
                    # variable bounds 0-1
                    bounds = Bounds(0,1)
                    # objective dummy
                    c = np.zeros(N*N)
                    # integrality
                    integrality = np.ones(N*N)
                    res = milp(c, integrality=integrality, bounds=bounds, constraints=lc, options={"disp": False})
                    return res.success
            
                # binary search S
                low, high = 0, 2*N+1
                best=0
                while low <= high:
                    mid = (low+high)//2
                    if feasible(mid):
                        best=mid
                        low=mid+1
                    else:
                        high=mid-1
                return best
            
