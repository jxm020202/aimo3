            # Precompute main and anti diagonal sets
            main_diag = {}
            anti_diag = {}
            for i,j in coords:
                d1 = i-j
                d2 = i+j
                main_diag.setdefault(d1, []).append(index[(i,j)])
                anti_diag.setdefault(d2, []).append(index[(i,j)])
            
            # Build constraint matrix A: each row for a cell; we need sum of x over its main diag + sum over anti diag - x_i >= 1
            A = np.zeros((N, N), dtype=int)
            b = np.ones(N, dtype=int)  # RHS 1
            
            for i,j in coords:
                row = index[(i,j)]
                # add main diag
                for idx in main_diag[i-j]:
                    A[row, idx] += 1
                # add anti diag
                for idx in anti_diag[i+j]:
                    A[row, idx] += 1
                # subtract x_i (since counted twice)
                A[row, row] -= 1
            
