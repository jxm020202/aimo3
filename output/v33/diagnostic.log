            def count_segments_containing(cell):
                r,c = cell
                count=0
                # horizontal segments containing cell: start column s such that s <= c <= s+4 and s in [0,4]
                for s in range(max(0,c-4), min(c,4)+1):
                    count+=1
                # vertical
                for s in range(max(0,r-4), min(r,4)+1):
                    count+=1
                # main diagonal
                # start positions (sr,sc) such that sr <= r <= sr+4, sc <= c <= sc+4, and sr+4<=8, sc+4<=8
                for sr in range(max(0,r-4), min(r,4)+1):
                    for sc in range(max(0,c-4), min(c,4)+1):
                        if sr+4<=8 and sc+4<=8:
                            # also need (r-sr) == (c-sc) for diagonal alignment
                            if r-sr == c-sc:
                                count+=1
                # anti-diagonal
                for sr in range(max(0,r-4), min(r,4)+1):
                    for sc in range(max(4,c), min(c+4,8)+1): # sc >=4, sc <=8, and sc-4 >=0
