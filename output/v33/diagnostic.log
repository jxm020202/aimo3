            import numpy as np, math, itertools, random, collections, functools, sys, time
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_S_grid(m,n):
                N = m*n
                edges = []
                for i in range(m):
                    for j in range(n):
                        idx = i*n + j
                        if i+1 < m:
                            edges.append((idx, (i+1)*n + j))
                        if j+1 < n:
                            edges.append((idx, i*n + (j+1)))
                # Precompute variable mapping for cell and number
                num_vars = N*N
                # Build base constraints (cell assignment, number assignment) once
                A_base = []
                lb_base = []
                ub_base = []
                # each cell exactly one number
                for cell in range(N):
                    row = np.zeros(num_vars)
                    row[cell*N : cell*N + N] = 1
                    A_base.append(row)
                    lb_base.append(1)
                    ub_base.append(1)
                # each number exactly one cell
                for num in range(N):
                    row = np.zeros(num_vars)
                    for cell in range(N):
                        row[cell*N + num] = 1
                    A_base.append(row)
                    lb_base.append(1)
                    ub_base.append(1)
                A_base = np.array(A_base)
                lb_base = np.array(lb_base)
                ub_base = np.array(ub_base)
                # function to test feasibility for given S
                def feasible(S):
                    # add edge constraints
                    A = np.vstack([A_base, np.zeros((len(edges), num_vars))])
                    lb = np.concatenate([lb_base, np.full(len(edges), S)])
                    ub = np.concatenate([ub_base, np.full(len(edges), np.inf)])
                    for idx_e, (c1,c2) in enumerate(edges):
                        row = np.zeros(num_vars)
                        for num in range(N):
                            val = num+1
                            row[c1*N + num] = val
                            row[c2*N + num] = val
                        A[-len(edges)+idx_e] = row  # assign row
                    # solve MILP
                    var_bounds = Bounds(0,1)
                    integrality = np.ones(num_vars, dtype=int)
                    c = np.zeros(num_vars)
                    res = milp(c=c, constraints=LinearConstraint(A, lb, ub), bounds=var_bounds,
                               integrality=integrality, options={"disp": False})
                    return res.success
                low, high = 0, 2*N
                while low < high:
                    mid = (low+high+1)//2
                    if feasible(mid):
                        low = mid
                    else:
                        high = mid-1
                return low
            
