                    dirs=[]
                    for j,(x2,y2) in enumerate(pts):
                        if i==j: continue
                        ang=math.atan2(y2-y, x2-x)
                        dirs.append(ang)
                    # sort
                    dirs.sort()
                    # duplicate +2π
                    dirs2=dirs+[a+2*math.pi for a in dirs]
                    # sliding window to find max count within interval length 100° = 100*pi/180 rad
                    L=math.radians(100)
