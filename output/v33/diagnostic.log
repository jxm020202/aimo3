            import itertools, math
            
            def max_S_grid(m,n):
                N=m*n
                # generate all permutations maybe for small N
                maxS=0
                best=None
                # edges list
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx, (i+1)*n+j))
                        if j+1<n:
                            edges.append((idx, i*n+(j+1)))
                # enumerate permutations
                for perm in itertools.permutations(range(1,N+1)):
                    # compute min edge sum
                    min_sum=math.inf
                    for u,v in edges:
                        s=perm[u]+perm[v]
                        if s<min_sum:
                            min_sum=s
                            if min_sum<=maxS:
                                break
                    else:
                        # all edges checked
                        if min_sum>maxS:
                            maxS=min_sum
                            best=perm
                return maxS, best
            
