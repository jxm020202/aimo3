            import itertools, math
            
            def max_min_sum(m,n):
                # grid m rows, n cols
                N = m*n
                best = -1
                best_assign = None
                # generate all permutations for small N
                for perm in itertools.permutations(range(1,N+1)):
                    # assign to grid row-major
                    grid = [list(perm[i*n:(i+1)*n]) for i in range(m)]
                    # compute min sum across adjacent pairs
                    min_sum = math.inf
                    for i in range(m):
                        for j in range(n):
                            v = grid[i][j]
                            if i+1<m:
                                min_sum = min(min_sum, v+grid[i+1][j])
                            if j+1<n:
                                min_sum = min(min_sum, v+grid[i][j+1])
                    if min_sum > best:
                        best = min_sum
                        best_assign = [row[:] for row in grid]
                return best, best_assign
            
