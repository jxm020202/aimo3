            def get_one_path(n):
                init = 0
                for i in range(n):
                    if (i+1)%2==1:
                        init |= (1<<i)
                target = 0
                from collections import deque
                q = deque()
                parent = {}
                # first move any coin
                for pos in range(n):
                    cfg = init ^ (1<<pos)
                    state = (pos, cfg)
                    parent[state] = None
                    q.append((pos, cfg, 1))
                    if cfg == target:
                        return [pos+1]
                while q:
                    pos, cfg, steps = q.popleft()
                    for np in (pos-1, pos+1):
                        if 0 <= np < n:
                            ncfg = cfg ^ (1<<np)
                            nstate = (np, ncfg)
                            if nstate not in parent:
                                parent[nstate] = (pos, cfg)
                                if ncfg == target:
                                    # reconstruct path
                                    path = [np+1]
                                    cur = (pos, cfg)
                                    while cur is not None:
                                        ppos, _ = cur
                                        path.append(ppos+1)
                                        cur = parent[cur]
                                    path.reverse()
                                    return path
                                q.append((np, ncfg, steps+1))
                return None
            
