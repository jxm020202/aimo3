            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_S_grid_milp(m,n):
                N=m*n
                # edges
                edges=[]
                for i in range(m):
                    for j in range(n):
                        idx=i*n+j
                        if i+1<m:
                            edges.append((idx, (i+1)*n+j))
                        if j+1<n:
                            edges.append((idx, i*n+(j+1)))
                total_vars = N*N + 1  # X matrix + S
                # objective: maximize S => minimize -S
                c = np.zeros(total_vars)
                c[-1] = -1.0
                # bounds for variables
                # X binary: 0 <= X <= 1
                lower = np.zeros(total_vars)
                upper = np.ones(total_vars)
                # S upper bound can be N (maybe N+something). Set to N+10.
                upper[-1] = N+10
                bounds = Bounds(lower, upper)
                # integrality: all variables integer
                integrality = np.ones(total_vars, dtype=int)
                # Equality constraints: each cell gets exactly one number
                A_eq_rows = []
                b_eq = []
                # each cell
                for cell in range(N):
                    row = np.zeros(total_vars)
                    for num in range(N):
                        row[cell*N + num] = 1
                    A_eq_rows.append(row)
                    b_eq.append(1)
                # each number assigned once
                for num in range(N):
                    row = np.zeros(total_vars)
                    for cell in range(N):
                        row[cell*N + num] = 1
                    A_eq_rows.append(row)
                    b_eq.append(1)
                A_eq = np.array(A_eq_rows)
                b_eq = np.array(b_eq)
                # Inequality constraints for edges: sum - S >= 0 -> -sum + S <= 0
                A_ub_rows = []
                b_ub = []
                for (c1,c2) in edges:
                    row = np.zeros(total_vars)
                    # contributions from c1
                    for num in range(N):
                        row[c1*N + num] = -(num+1)  # negative for -sum
                    for num in range(N):
                        row[c2*N + num] = -(num+1)
                    row[-1] = 1  # +S
                    A_ub_rows.append(row)
                    b_ub.append(0)
                A_ub = np.array(A_ub_rows)
                b_ub = np.array(b_ub)
                # Build LinearConstraint objects
                eq_con = LinearConstraint(A_eq, b_eq, b_eq)
                ub_con = LinearConstraint(A_ub, -np.inf*np.ones_like(b_ub), b_ub)
                # Solve
                res = milp(c=c, constraints=[eq_con, ub_con], bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if res.success:
                    S_opt = int(round(res.x[-1]))
                    return S_opt
                else:
                    print("No solution", res.message)
                    return None
            
            print(max_S_grid_milp(2,2))
            
