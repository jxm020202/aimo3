                            row=(d1+d2)//2
                            col=(d2-d1)//2
                            if 0<=row<n and 0<=col<n:
                                adj[i].append(j)
                # Hungarian algorithm (simple augmenting path)
                matchR = [-1]*R
                def dfs(u, seen):
                    for v in adj[u]:
                        if seen[v]:
                            continue
                        seen[v]=True
                        if matchR[v]==-1 or dfs(matchR[v], seen):
                            matchR[v]=u
                            return True
                    return False
                matchL = [-1]*L
                for u in range(L):
                    seen=[False]*R
                    if dfs(u, seen):
                        pass
                # Build matchL from matchR
                for v,u in enumerate(matchR):
                    if u!=-1:
                        matchL[u]=v
                # Determine unmatched vertices
                unmatched_left = [i for i in range(L) if matchL[i]==-1]
                unmatched_right = [j for j in range(R) if matchR[j]==-1]
                return matchL, matchR, left_vals, right_vals, unmatched_left, unmatched_right
            
