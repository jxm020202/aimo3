            def max_edges_milp_maximize(n):
                edge_index = {}
                idx = 0
                for i in range(n):
                    for j in range(i+1,n):
                        edge_index[(i,j)] = idx
                        idx+=1
                m = idx
                total_vars = 2*m
                c = np.concatenate([-np.ones(m), np.zeros(m)])  # minimize negative sum = maximize sum
                bounds = Bounds(np.zeros(total_vars), np.ones(total_vars))
                integrality = np.ones(total_vars, dtype=int)
                A = []
                lb = []
                ub = []
                # vertex constraints
                for u in range(n):
                    row = np.zeros(total_vars)
                    for v in range(n):
                        if v==u: continue
                        i,j = (u,v) if u<v else (v,u)
                        e_idx = edge_index[(i,j)]
                        row[m+e_idx]=1
                    A.append(row); lb.append(1); ub.append(np.inf)
                # y <= x
                for (i,j), e_idx in edge_index.items():
                    row = np.zeros(total_vars)
                    row[m+e_idx]=1
                    row[e_idx]=-1
                    A.append(row); lb.append(-np.inf); ub.append(0)
                # triangle constraints
                for i in range(n):
                    for j in range(i+1,n):
                        for k in range(j+1,n):
                            e_ij = edge_index[(i,j)]
                            e_ik = edge_index[(i,k)]
                            e_jk = edge_index[(j,k)]
                            # (i,j) with k
                            row = np.zeros(total_vars)
                            row[m+e_ij]=1; row[e_ik]=1; row[e_jk]=1
                            A.append(row); lb.append(-np.inf); ub.append(2)
                            # (i,k) with j
                            row = np.zeros(total_vars)
                            row[m+e_ik]=1; row[e_ij]=1; row[e_jk]=1
                            A.append(row); lb.append(-np.inf); ub.append(2)
                            # (j,k) with i
                            row = np.zeros(total_vars)
                            row[m+e_jk]=1; row[e_ij]=1; row[e_ik]=1
                            A.append(row); lb.append(-np.inf); ub.append(2)
                A = np.array(A)
                lb = np.array(lb)
                ub = np.array(ub)
                lin_con = LinearConstraint(A, lb, ub)
                result = milp(c=c, constraints=lin_con, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                if not result.success:
                    raise RuntimeError("MILP failed")
                x = result.x[:m]
                edges = int(round(x.sum()))
                return edges
            
            for n in range(2,9):
                print(n, max_edges_milp_maximize(n))
            
