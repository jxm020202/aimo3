            def spread_at_angle(observer_angle, theta):
                # observer at angle obs, other points at angles from 0 to theta (excluding observer)
                # assume observer is within [0, theta]
                phis = np.linspace(0, theta, 1000)
                # exclude observer angle
                phis = phis[abs(phis - observer_angle) > 1e-9]
