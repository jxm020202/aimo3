            def upper_bound_S(m,n):
                N = m*n
                # degree distribution
                deg2 = 4
                deg3 = 2*(m-2) + 2*(n-2)  # edges non-corner on perimeter
                deg4 = N - deg2 - deg3
                # assign largest numbers to degree4, next to degree3, smallest to degree2
                # numbers from 1..N
                # compute weighted sum max
                # assign numbers to degree4: top deg4 numbers
                start_deg4 = N - deg4 + 1
                sum_deg4 = sum(range(start_deg4, N+1))
                sum_deg3 = sum(range(N - deg4 - deg3 + 1, N - deg4 + 1))
                sum_deg2 = sum(range(1, deg2+1))
                total_weighted = sum_deg4*4 + sum_deg3*3 + sum_deg2*2
                edges = (m-1)*n + (n-1)*m
                return total_weighted // edges, total_weighted / edges
            
            print(upper_bound_S(5,5))
            
