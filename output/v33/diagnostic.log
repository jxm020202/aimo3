            def max_matching(adj, L, R):
                # adj: dict left->list of right neighbors
                matchR = {}  # right node -> left node
                def dfs(u, seen):
                    for v in adj.get(u, []):
                        if v in seen:
                            continue
                        seen.add(v)
                        if v not in matchR or dfs(matchR[v], seen):
                            matchR[v] = u
                            return True
                    return False
                result = 0
                for u in L:
                    if dfs(u, set()):
                        result += 1
                return result
            
            def compute_max_match(parity):
                L = [d for d in d1_vals if d%2==parity]
                R = [d for d in d2_vals if d%2==parity]
