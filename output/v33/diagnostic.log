            def min_moves_bfs(n):
                init = 0
                for i in range(n):
                    if (i+1)%2==1:
                        init |= (1<<i)
                target = 0
                from collections import deque
                q = deque()
                visited = set()
                # first move any coin
                for pos in range(n):
                    cfg = init ^ (1<<pos)
                    state = (pos, cfg)
                    visited.add(state)
                    q.append((pos, cfg, 1))
                    if cfg == target:
                        return 1
                while q:
                    pos, cfg, steps = q.popleft()
                    for np in (pos-1, pos+1):
                        if 0 <= np < n:
                            ncfg = cfg ^ (1<<np)
                            nstate = (np, ncfg)
                            if nstate not in visited:
                                if ncfg == target:
                                    return steps+1
                                visited.add(nstate)
                                q.append((np, ncfg, steps+1))
                return None
            
            for n in range(1,11):
