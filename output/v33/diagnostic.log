            # Use Konig's theorem to get min vertex cover from max matching
            def min_vertex_cover_bipartite(G, top):
                # top: set of left nodes
                # compute maximum matching
                M = nx.algorithms.bipartite.maximum_matching(G, top_nodes=top)
                # Build alternating tree from unmatched left vertices
                # left side: top
                left = set(top)
                right = set(G) - left
                # vertices reachable via alternating paths from unmatched left vertices
                # BFS
                from collections import deque
                # start with unmatched left vertices
                unmatched_left = [u for u in left if u not in M]
                visited_left = set()
                visited_right = set()
                q = deque()
                for u in unmatched_left:
                    q.append(u)
                    visited_left.add(u)
                while q:
                    u = q.popleft()
                    if u in left:
                        # explore edges not in matching
                        for v in G[u]:
                            if (u,v) not in M.items():
                                # edge not in matching
                                if v not in visited_right:
                                    visited_right.add(v)
                                    q.append(v)
                    else:
                        # u in right, explore matched edge
                        v = M.get(u)
                        if v and v not in visited_left:
                            visited_left.add(v)
                            q.append(v)
                # Minimum vertex cover = (left - visited_left) union (right ∩ visited_right)
                cover = (left - visited_left) | (right & visited_right)
                return cover
            
            cover_black = min_vertex_cover_bipartite(G_black, [f"d{d}" for d in black_diffs])
            len(cover_black)
            
