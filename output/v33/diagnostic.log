            def min_moves_bruteforce(n):
                # n coins, alternating T (odd) start T
                # state: position of last flipped coin (index 0..n-1) and parity vector of flips? That's huge.
                # Instead use BFS on (position, visited parity pattern) where parity vector is bitmask length n.
                # For n up to maybe 13 feasible.
                from collections import deque
                target = 0
                # Represent parity of each coin as bit: 0=heads, 1=tails (need to be heads finally). Starting pattern: T at odd indices (0-indexed? leftmost tails)
                # Let's use 0-index: position 0 is leftmost T.
                start_state = 0
                for i in range(n):
                    if i%2==0: # T
                        start_state |= (1<<i)
                # target all heads = 0
                # BFS over (pos, mask) where pos is index of last flipped coin (or -1 for before first move)
                # first move can be any coin, so we can start with any position flipping it.
                visited=set()
                dq=deque()
                # initial moves: flip any coin i
                for i in range(n):
                    mask = start_state ^ (1<<i) # flip i
                    state = (i, mask)
                    visited.add(state)
                    dq.append((state,1))
                while dq:
                    (pos, mask), dist = dq.popleft()
                    if mask==0:
                        return dist
                    # next moves: flip adjacent coin
                    for nxt in (pos-1, pos+1):
                        if 0<=nxt<n:
                            newmask = mask ^ (1<<nxt)
                            newstate = (nxt, newmask)
                            if newstate not in visited:
                                visited.add(newstate)
                                dq.append((newstate, dist+1))
                return None
            
            for n in range(1,13):
                print(n, min_moves_bruteforce(n))
            
