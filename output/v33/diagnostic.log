            import random, math, copy, time
            
            def total_sum(points):
                N=len(points)
                total=0
                L=math.radians(100)
                for i in range(N):
                    x,y=points[i]
                    dirs=[]
                    for j in range(N):
                        if i==j: continue
                        x2,y2=points[j]
                        ang=math.atan2(y2-y, x2-x)
                        dirs.append(ang)
                    dirs.sort()
                    # duplicate
                    dirs2=dirs+[a+2*math.pi for a in dirs]
                    maxcnt=0
                    left=0
                    for right in range(len(dirs2)):
                        while dirs2[right]-dirs2[left] > L+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>maxcnt: maxcnt=cnt
                    total+=maxcnt
                return total
            
            def random_points(N, radius=1.0):
                pts=[]
                for _ in range(N):
                    r=radius*math.sqrt(random.random())
                    theta=random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def anneal(N, steps=20000):
                pts=random_points(N, radius=1.0)
                best=total_sum(pts)
                best_pts=pts[:]
                T0=1.0
                for step in range(steps):
                    T=T0*(1-step/steps)
                    # propose move: pick a point, move slightly
                    i=random.randrange(N)
                    x,y=pts[i]
                    # small perturbation
                    dx=(random.random()*2-1)*0.1
                    dy=(random.random()*2-1)*0.1
                    newx, newy = x+dx, y+dy
                    # keep inside unit circle
                    if newx**2+newy**2>1.0:
                        continue
                    old_pt=pts[i]
                    pts[i]=(newx,newy)
                    new_total=total_sum(pts)
                    delta=new_total-best
                    if delta>0 or random.random()<math.exp(delta/T):
                        if new_total>best:
                            best=new_total
                            best_pts=pts[:]
                    else:
                        pts[i]=old_pt
                return best, best_pts
            
            for N in [5,6,7,8,9,10]:
                best,_=anneal(N, steps=5000)
                print(N, best, "max possible", N*(N-1))
            
