            def solve_min_marked_squares(n=13):
                # board size n x n
                # map left diagonal index: r - c from -(n-1) .. (n-1) -> 0..2n-2
                # map right diagonal index: r + c from 2 .. 2n -> 0..2n-2
                left_indices = {}
                right_indices = {}
                left_list = []
                right_list = []
                # compute mapping
                left_vals = list(range(-(n-1), n))
                right_vals = list(range(2, 2*n+1))
                left_index = {v:i for i,v in enumerate(left_vals)}
                right_index = {v:i for i,v in enumerate(right_vals)}
                num_left = len(left_vals)  # 2n-1
                num_right = len(right_vals)  # 2n-1
                # cells list
                cells = []
                for r in range(1, n+1):
                    for c in range(1, n+1):
                        d1 = r - c
                        d2 = r + c
                        cells.append((r,c,d1,d2))
                num_cells = len(cells)
                # variable order: first x for each cell, then y_left, then y_right
                num_vars = num_cells + num_left + num_right
                # Build constraints
                A = []
                b = []
                sense = []  # we will use LinearConstraint with lb, ub
                # 1. For each cell: y_left[d1] + y_right[d2] >= 1
                for idx, (r,c,d1,d2) in enumerate(cells):
                    row = np.zeros(num_vars)
                    # y_left index offset
                    row[num_cells + left_index[d1]] = 1
                    row[num_cells + num_left + right_index[d2]] = 1
                    # inequality: - (y_left + y_right) <= -1   (i.e., -(y_left+y_right) <= -1)
                    # but LinearConstraint uses lb <= Ax <= ub
                    # We'll set lb = 1, ub = np.inf for y_left+y_right
                    A.append(row)
                    b.append(1)  # lower bound
                    sense.append('ge')
                # 2. For each left diagonal: sum_{cells on diag} x_cell - y_left >= 0
                for d1, li in left_index.items():
                    row = np.zeros(num_vars)
                    # sum x for cells on this diagonal
                    for idx, (r,c,dd1,dd2) in enumerate(cells):
                        if dd1 == d1:
                            row[idx] = 1
                    # - y_left
                    row[num_cells + li] = -1
                    A.append(row)
                    b.append(0)
                    sense.append('ge')
                # 3. For each right diagonal: sum_{cells on diag} x_cell - y_right >= 0
                for d2, ri in right_index.items():
                    row = np.zeros(num_vars)
                    for idx, (r,c,dd1,dd2) in enumerate(cells):
                        if dd2 == d2:
                            row[idx] = 1
                    row[num_cells + num_left + ri] = -1
                    A.append(row)
                    b.append(0)
                    sense.append('ge')
                # Convert to matrix form for LinearConstraint
                A = np.array(A)
                # Build lower and upper bounds arrays
                lb = np.full(A.shape[0], -np.inf)
                ub = np.full(A.shape[0], np.inf)
                for i, s in enumerate(sense):
                    if s == 'ge':
                        lb[i] = b[i]
                    elif s == 'le':
                        ub[i] = b[i]
                    elif s == 'eq':
                        lb[i] = ub[i] = b[i]
                # variable bounds 0-1
                var_bounds = Bounds(0, 1)
                # integrality: all variables integer (binary)
                integrality = np.ones(num_vars, dtype=int)
                # objective: minimize sum of x (first num_cells variables)
                c = np.zeros(num_vars)
                c[:num_cells] = 1
                # Solve MILP
                res = milp(c=c,
                           constraints=LinearConstraint(A, lb, ub),
                           bounds=var_bounds,
                           integrality=integrality,
                           options={'presolve': True, 'disp': False})
                return res, cells, left_vals, right_vals
            
            res, cells, left_vals, right_vals = solve_min_marked_squares(13)
            print(res.success, res.fun)
            
