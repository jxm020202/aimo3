            def sum_m(N, points):
                total=0
                for i,(xi,yi) in enumerate(points):
                    angles=[]
                    for j,(xj,yj) in enumerate(points):
                        if i==j: continue
                        ang=math.atan2(yj-yi, xj-xi) # range -pi to pi
                        angles.append(ang)
                    # sort angles
                    angles.sort()
                    # duplicate with +2pi for wrap-around
                    angles2=angles+[a+2*math.pi for a in angles]
                    # sliding window to find max count within 100 degrees = 100*pi/180 rad
                    maxcnt=0
                    L=100*math.pi/180
                    left=0
                    for right in range(len(angles2)):
                        while angles2[right]-angles2[left] > L+1e-12:
                            left+=1
                        cnt=right-left+1
                        if cnt>maxcnt:
                            maxcnt=cnt
                    total+=maxcnt
                return total
            
