            def anneal(m,n, target, time_limit=5.0):
                start=time.time()
                N=m*n
                # start with a heuristic: assign low numbers to corners etc
                grid=random_grid(m,n)
                best=min_adj(grid)
                best_grid=[row[:] for row in grid]
                while time.time()-start < time_limit:
