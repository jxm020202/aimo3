            import math, itertools, sys, time, collections, functools, random, fractions, decimal, statistics, numpy as np, sympy as sp
            def f_bruteforce_limit(N, max_x_factor=2):
                # search up to max_x_factor * N
                limit = int(max_x_factor * N) + 10
                for x in range(1, limit+1):
                    divs = sp.divisors(x)
                    if len(divs) < 3:
                        continue
                    # check triples
                    # we can use combinations
                    for a,b,c in itertools.combinations(divs,3):
                        if a+b+c == N:
                            return x
                return None
            
