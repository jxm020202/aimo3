            from scipy.optimize import milp, LinearConstraint, Bounds
            
            num_edges = len(edges)
            # Build adjacency list: for each edge e, list of edges incident to either endpoint
            incident = []
            # Build mapping from vertex to edges
            edges_by_u = collections.defaultdict(list)
            edges_by_v = collections.defaultdict(list)
            for idx, (u,v) in enumerate(edges):
                edges_by_u[u].append(idx)
                edges_by_v[v].append(idx)
            
            for idx, (u,v) in enumerate(edges):
                incident_edges = set(edges_by_u[u]) | set(edges_by_v[v])
                incident.append(list(incident_edges))
            
            # Build constraint matrix A x >= 1 for each edge
            A = np.zeros((num_edges, num_edges), dtype=int)
            for i, inc in enumerate(incident):
                A[i, inc] = 1
            lb = np.ones(num_edges)  # lower bound 1 for each constraint (>=1)
            ub = np.full(num_edges, np.inf)
