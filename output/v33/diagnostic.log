            def compute_G_i(angles):
                n = len(angles)
                G = []
                for i, th_i in enumerate(angles):
                    # compute directed angles from i to others
                    deltas = []
                    for j, th_j in enumerate(angles):
                        if i == j: continue
                        delta = (th_j - th_i) % (2*math.pi)
                        deltas.append(delta)
                    deltas.sort()
                    # compute gaps between consecutive deltas (including wrap-around)
                    gaps = []
                    for k in range(len(deltas)):
                        nxt = deltas[(k+1)%len(deltas)]
                        cur = deltas[k]
                        gap = (nxt - cur) % (2*math.pi)
                        gaps.append(gap)
                    G.append(max(gaps))
