                # N length, a1=1, aN=M
                best = None
                best_seq = None
                # generate monotone sequences using nondecreasing values from 1..M
                # we can generate all combos of N-2 intermediate values (positions 2..N-1)
                # using product with nondecreasing constraint.
                # We'll generate via recursion.
                def rec(pos, prev, seq):
                    nonlocal best, best_seq
                    if pos == N:
                        # last position must be M
                        if prev <= M:
                            seq.append(M)
                            # compute f
                            a = seq
                            f = sum(x*x for x in a) - sum(a[i]*a[i+2] for i in range(N-2))
                            if best is None or f < best:
                                best = f
                                best_seq = a.copy()
                            seq.pop()
                        return
                    # positions 2..N-1
                    # choose current value >= prev and <= M (but must leave enough room to reach M)
                    # For simplicity just iterate up to M.
                    for val in range(prev, M+1):
                        # ensure that we can still reach M in remaining steps (nondecreasing)
                        # Since we can always stay same then jump at end, no constraint.
                        seq.append(val)
                        rec(pos+1, val, seq)
                        seq.pop()
                rec(1, 1, [1])  # pos index currently at 1 (a1)
                return best, best_seq
            
