            import numpy as np
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def feasible_grid(m,n,S):
                N=m*n
                cells = [(i,j) for i in range(m) for j in range(n)]
                cell_index = {c:i for i,c in enumerate(cells)}
                # binary variables x_{c,k} for each cell c and number k (1..N)
                num_vars = N*N
                # objective dummy (0)
                c = np.zeros(num_vars)
                # constraints:
                A_eq = []
                b_eq = []
                # each cell assigned exactly one number
                for c_idx in range(N):
                    row = np.zeros(num_vars)
                    for k in range(N):
                        row[c_idx*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each number assigned to exactly one cell
                for k in range(N):
                    row = np.zeros(num_vars)
                    for c_idx in range(N):
                        row[c_idx*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # edge constraints: sum >= S
                # For each edge (c1,c2):
                edges = []
                for i in range(m):
                    for j in range(n):
                        for di,dj in [(1,0),(0,1)]:
                            ni,nj=i+di,j+dj
                            if 0<=ni<m and 0<=nj<n:
                                edges.append(((i,j),(ni,nj)))
                A_ub = []
                b_ub = []
                for (c1,c2) in edges:
                    row = np.zeros(num_vars)
                    # sum_{k} k * x_{c1,k}
                    c1_idx = cell_index[c1]
                    c2_idx = cell_index[c2]
                    for k in range(N):
                        row[c1_idx*N + k] += (k+1)
                        row[c2_idx*N + k] += (k+1)
                    # constraint: - (sum) <= -S  => sum >= S
                    A_ub.append(-row)
                    b_ub.append(-S)
                # Build LinearConstraint
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                A_ub = np.array(A_ub)
                b_ub = np.array(b_ub)
                lin_con = LinearConstraint(np.vstack([A_eq, A_ub]), np.hstack([b_eq, b_ub]), np.hstack([b_eq, np.full(len(b_ub), np.inf)]))
                # Actually LinearConstraint expects A matrix and lower/upper bounds.
                # We'll separate equality and inequality constraints.
                # Use milp with constraints list
                constraints = []
                # equality constraints
                constraints.append(LinearConstraint(A_eq, b_eq, b_eq))
                # inequality constraints (sum >= S)
                constraints.append(LinearConstraint(A_ub, -np.inf, b_ub))
                # bounds for binary variables
                bounds = Bounds(0,1)
                integrality = np.ones(num_vars, dtype=int)
                res = milp(c=c, constraints=constraints, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                return res.success
            
            print(feasible_grid(2,2,4))
            
