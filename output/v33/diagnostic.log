            def min_f_dp(N, M):
                # DP over i, storing minimal cost for each (prev1, prev2) after processing up to i (i >=2)
                # We'll use dictionary for states.
                # After processing i elements (i>=2), we have a_{i-1}=prev1, a_{i-2}=prev2.
                # cost includes sum of squares up to a_{i-1} and cross terms up to i-3.
                # We'll initialize after processing i=2 (a1=1, a2 variable)
                from math import inf
                # state dict: key (prev1, prev2) -> cost
                states = {}
                # a1=1 fixed
                for a2 in range(1, M+1):
                    cost = 1*1 + a2*a2  # squares of a1 and a2
                    # No cross term yet
                    states[(a2, 1)] = cost
                # iterate i from 3 to N
                for i in range(3, N+1):
                    new_states = {}
                    for (prev1, prev2), cost in states.items():
                        # choose a_i >= prev1, <= M
                        for ai in range(prev1, M+1):
                            # if i==N, must be M
                            if i==N and ai!=M:
                                continue
                            new_cost = cost + ai*ai - prev2*ai
                            key = (ai, prev1)
                            if key not in new_states or new_cost < new_states[key]:
                                new_states[key] = new_cost
                    states = new_states
                # after processing N, we have final states where a_N = M (enforced)
                # The cost already includes all squares and cross terms.
                best = min(states.values())
                return best
            
            print(min_f_dp(10,9))
            
