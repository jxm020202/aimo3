                # Determine orientation
                r1,c1 = divmod(cells[0],7)
                r2,c2 = divmod(cells[1],7)
                if r1==r2: # horizontal
                    # left side cell = side1, right side = side2
                    # slide left possible if side1 is inside board and empty (not covered)
