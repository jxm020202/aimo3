            import itertools, math
            from scipy.optimize import milp, LinearConstraint, Bounds
            def max_edges_n(n):
                # map edge (i,j) with i<j to index
                edges = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges)
                # variables: x_e (edge existence), g_e (good edge indicator)
                # order: first x variables then g variables
                num_vars = 2*m
                # objective: maximize sum x_e
                c = np.zeros(num_vars)
                c[:m] = -1  # milp minimizes, so negative for maximize
                # constraints:
                A = []
                b = []
                # g_e <= x_e
                for idx in range(m):
                    row = np.zeros(num_vars)
                    row[idx] = -1  # -x_e
                    row[m+idx] = 1  # +g_e
                    A.append(row)
                    b.append(0)  # -x + g <= 0 => g <= x
                # For each vertex i: sum of incident g >= 1
                for i in range(n):
                    row = np.zeros(num_vars)
                    for idx, (u,v) in enumerate(edges):
                        if u==i or v==i:
                            row[m+idx] = -1  # -g
                    A.append(row)
                    b.append(-1)  # -sum g <= -1 => sum g >= 1
                # triangle constraints: for each edge (i,j) and each k != i,j:
                for idx, (i,j) in enumerate(edges):
                    for k in range(n):
                        if k==i or k==j:
                            continue
                        # x_{i,k} + x_{j,k} <= 2 - g_{i,j}
                        row = np.zeros(num_vars)
                        # find indices for edges (i,k) and (j,k) (order i<k)
                        def edge_index(a,b):
                            if a>b:
                                a,b = b,a
                            return edges.index((a,b))
                        ik_idx = edge_index(i,k)
                        jk_idx = edge_index(j,k)
                        row[ik_idx] = 1
                        row[jk_idx] = 1
                        row[m+idx] = 1  # + g_{i,j}
                        A.append(row)
                        b.append(2)  # sum + g <= 2
                # bounds: variables binary
                integrality = np.ones(num_vars)
                # variable bounds 0-1
                bounds = Bounds(0,1)
                # Convert to arrays
                A = np.array(A)
                b = np.array(b)
                # Solve
                res = milp(c=c, constraints=LinearConstraint(A, -np.inf, b), bounds=bounds,
                           integrality=integrality, options={'presolve': True, 'disp': False})
                if not res.success:
                    print("Failed", n)
                    return None
                x = res.x[:m]
                # round to int
                edges_selected = [edges[i] for i in range(m) if x[i] > 0.5]
                return len(edges_selected)
            for n in range(2,9):
                print(n, max_edges_n(n))
            
