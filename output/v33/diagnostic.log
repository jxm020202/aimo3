                best=0
                best_grid=None
                for _ in range(iterations):
                    perm = np.arange(1,N+1)
                    np.random.shuffle(perm)
                    grid = perm.reshape((m,n))
                    s = min_adj_sum_grid(grid)
                    if s>best:
                        best=s
                        best_grid=grid.copy()
