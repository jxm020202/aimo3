                idx = {pair: k for k,pair in enumerate(pairs)}
                # y variables also m count, placed after x variables
                total_vars = 2*m
                # bounds: all binary
                bounds = [(0,1)]*total_vars
                integrality = np.ones(total_vars, dtype=int)
                # constraints
                A_ub = []
                b_ub = []
                A_eq = []
                b_eq = []
                # Constraint 1: y <= x
                for (i,j), k in idx.items():
                    row = np.zeros(total_vars)
                    row[m + k] = 1   # y index
                    row[k] = -1      # -x
                    A_ub.append(row)
                    b_ub.append(0)
                # Constraint 2: for each (i,j) and w != i,j: y_{ij} + x_{i,w} + x_{j,w} <= 2
                for (i,j), k in idx.items():
                    for w in range(n):
                        if w==i or w==j:
                            continue
                        # get x_{i,w}
                        a,b = (i,w) if i<w else (w,i)
                        idx_iw = idx[(a,b)]
                        a,b = (j,w) if j<w else (w,j)
                        idx_jw = idx[(a,b)]
                        row = np.zeros(total_vars)
                        row[m + k] = 1   # y_{ij}
                        row[idx_iw] = 1  # x_{i,w}
                        row[idx_jw] = 1  # x_{j,w}
                        A_ub.append(row)
