            import cmath, math, itertools
            
            def exists_solution(m, max_vars, max_order=15):
                # try to assign up to max_vars non-zero roots of unity (odd order to avoid zero)
                # also allow zeros as filler.
                # We'll search combinations of primitive roots of unity of orders up to max_order (odd)
                # For each combination (list of (order, exponent)), compute products for j=1..m.
                # zeros are just omitted.
                orders = [d for d in range(3, max_order+1, 2)]  # odd orders
                # generate list of possible r values (primitive roots)
                roots = []
                for d in orders:
                    for a in range(1, d):
                        if math.gcd(a, d) == 1:
                            roots.append((d, a))
                # limit search size
                for n in range(1, max_vars+1):
                    for combo in itertools.combinations_with_replacement(roots, n):
                        # compute product for each j
                        ok = True
                        for j in range(1, m+1):
                            prod = 1+0j
                            for d,a in combo:
                                r = cmath.exp(2j*math.pi*a/d)
                                prod *= (r**j + 1)
                            # zeros omitted
                            if abs(prod - 1) > 1e-6:
                                ok = False
                                break
                        if ok:
                            return True, combo
                return False, None
            
            for m in range(1,9):
                found, combo = exists_solution(m, max_vars=3, max_order=15)
                print(m, found)
            
