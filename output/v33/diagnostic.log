            def total_moves_general(n, s, e):
                # compute arrivals block
                arrivals = [0]*(n+1)
                if s < e:
                    for i in range(s+1, e+1):
                        arrivals[i] = 1
                elif e < s:
                    for i in range(e, s):
                        arrivals[i] = 1
                # compute b_i
                target = [1 if (i%2==1) else 0 for i in range(1,n+1)]
                b = [0]*(n+1)
                for i in range(1,n+1):
                    if i == s:
                        b[i] = target[i-1] ^ 1  # toggle
                    else:
                        b[i] = target[i-1] ^ arrivals[i]  # XOR
                # feasibility: sum b even
                if sum(b[1:]) % 2 != 0:
                    return None
                # compute k_i via recurrence, also sum
                k_prev = 0
                sum_k = 0
                for i in range(1, n):
                    k_i = (b[i] + k_prev) % 2
                    sum_k += k_i
                    k_prev = k_i
                # final condition: k_{n-1} must equal b_n (since k_n=0)
                if k_prev != b[n]:
                    return None
                total_traversals = abs(e - s) + 2*sum_k
