                    # coefficients for cell i: -num
                    for num in range(N):
                        row[i*N + num] = -(num+1)  # num+1 is actual label
                    for num in range(N):
                        row[j*N + num] -= (num+1)
                    edge_rows.append(row)
                A_ub_base = csr_matrix(np.vstack(edge_rows))
            
