            def bound_S(m,n):
                N=m*n
                corners=4
                edges=2*(m-2)+2*(n-2)
                interior=N-corners-edges
                labels=list(range(N,0,-1))
                total=0
                idx=0
                for _ in range(interior):
                    total+=4*labels[idx]; idx+=1
                for _ in range(edges):
                    total+=3*labels[idx]; idx+=1
                for _ in range(corners):
                    total+=2*labels[idx]; idx+=1
                E=2*m*n- m - n  # Actually edges = m*(n-1)+n*(m-1) = 2*m*n - m - n
                avg=total/E
                return avg
            
