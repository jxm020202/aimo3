            def get_solution(m,n,S):
                N = m*n
                vertices = [(i,j) for i in range(m) for j in range(n)]
                idx = {v:k for k,v in enumerate(vertices)}
                edges = []
                for i in range(m):
                    for j in range(n):
                        v = idx[(i,j)]
                        if i+1 < m:
                            edges.append((v, idx[(i+1,j)]))
                        if j+1 < n:
                            edges.append((v, idx[(i,j+1)]))
                num_vars = N*N
                rows = []
                lbs = []
                ubs = []
                # vertex constraints
                for v in range(N):
                    row = np.zeros(num_vars)
                    row[v*N:(v+1)*N] = 1
                    rows.append(row); lbs.append(1); ubs.append(1)
                # label constraints
                for k in range(N):
                    row = np.zeros(num_vars)
                    row[k::N] = 1
                    rows.append(row); lbs.append(1); ubs.append(1)
                # edge constraints
                for (u,v) in edges:
                    row = np.zeros(num_vars)
                    row[u*N:(u+1)*N] = np.arange(1,N+1)
                    row[v*N:(v+1)*N] = np.arange(1,N+1)
                    rows.append(row); lbs.append(S); ubs.append(np.inf)
                A = np.vstack(rows)
                lc = opt.LinearConstraint(A, lbs, ubs)
                c = np.zeros(num_vars)
                bounds = opt.Bounds(0,1)
                integrality = np.ones(num_vars, dtype=int)
                res = opt.milp(c, constraints=lc, bounds=bounds, integrality=integrality, options={'disp': False})
                if not res.success:
                    return None
                # decode assignment
                assign = {}
                x = np.round(res.x).astype(int)
                for v in range(N):
                    for k in range(N):
                        if x[v*N + k]:
                            assign[vertices[v]] = k+1
                            break
                return assign
            
            sol = get_solution(4,4,15)
            sol
            
