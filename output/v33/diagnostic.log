            def find_solution():
                n=13
                even_sums = list(range(2,2*n+1,2))  # 2,4,...,26
                # backtrack assign each row i a column j such that sum is unique even and j in 1..13
                used_cols = set()
                used_sums = set()
                sol = [None]*n
                def backtrack(i):
                    if i==n:
                        return True
                    row = i+1
                    for col in range(1,n+1):
                        if col in used_cols:
                            continue
                        s = row+col
                        if s%2!=0:
                            continue
                        if s in used_sums:
                            continue
                        # assign
                        used_cols.add(col)
                        used_sums.add(s)
                        sol[i]= (row,col)
                        if backtrack(i+1):
                            return True
                        used_cols.remove(col)
                        used_sums.remove(s)
                    return False
