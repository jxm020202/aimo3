            def hill_climb(m,n,iterations=20000):
                N=m*n
                # start with initial assignment: low numbers on black cells, high on white maybe
                # Use simple pattern: assign numbers 1..N row-major
                perm=list(range(1,N+1))
                grid=[perm[i*n:(i+1)*n] for i in range(m)]
                best=min_adj(grid)
                best_grid=[row[:] for row in grid]
                for it in range(iterations):
