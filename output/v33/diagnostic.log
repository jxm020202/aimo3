            def construct_grid_distance(m,n):
                N=m*n
                # compute distances from (0,0) (or any corner)
                dist={}
                for i in range(m):
                    for j in range(n):
                        dist[(i,j)]=i+j  # Manhattan distance from top-left
                # separate black and white cells
                black=[(i,j) for i in range(m) for j in range(n) if (i+j)%2==0]
                white=[(i,j) for i in range(m) for j in range(n) if (i+j)%2==1]
                # sort black by dist ascending (small distance first)
                black_sorted=sorted(black, key=lambda c: dist[c])
                # assign low numbers 1..len(black) to black in this order
                grid=[[0]*n for _ in range(m)]
                for val, (i,j) in enumerate(black_sorted, start=1):
                    grid[i][j]=val
                # sort white by dist ascending as well? we want large numbers near corner, so assign descending numbers to white sorted by dist ascending
                white_sorted=sorted(white, key=lambda c: dist[c])
                high_start=N
                for (i,j), val in zip(white_sorted, range(N, N-len(white), -1)):
                    grid[i][j]=val
                return grid
            
            def min_adj_sum_grid(grid):
                m=len(grid); n=len(grid[0])
                mins=10**9
                for i in range(m):
                    for j in range(n):
