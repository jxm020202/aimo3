            def f_bruteforce(n, limit=10000):
                # find smallest m such that there exist three distinct divisors summing to n
                for m in range(1, limit+1):
                    # find divisors
                    divs = []
                    for d in range(1, int(m**0.5)+1):
                        if m % d == 0:
                            divs.append(d)
                            if d != m//d:
                                divs.append(m//d)
                    divs = sorted(set(divs))
                    if len(divs) < 3:
                        continue
                    # check triples distinct
                    L = len(divs)
                    for i in range(L):
                        for j in range(i+1, L):
                            for k in range(j+1, L):
                                if divs[i] + divs[j] + divs[k] == n:
                                    return m
                return None
            
