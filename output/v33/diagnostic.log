            import itertools
            
            def construct_graph(n=160):
                # n must be even
                assert n%2==0
                pairs = [(2*i, 2*i+1) for i in range(n//2)]
                edges = set()
                # internal edges
                for a,b in pairs:
                    edges.add(tuple(sorted((a,b))))
                # between pairs: match same index
                for i in range(len(pairs)):
                    a_i,b_i = pairs[i]
                    for j in range(i+1, len(pairs)):
                        a_j,b_j = pairs[j]
                        # connect a_i-a_j and b_i-b_j
                        edges.add(tuple(sorted((a_i, a_j))))
                        edges.add(tuple(sorted((b_i, b_j))))
                return edges
            
            edges = construct_graph()
            len(edges)
            
