                points.sort(key=lambda p: p[0]+p[1])
                
                # Predefine function to check constraints for any L shape that is fully assigned.
                def check_constraints():
                    for x in range(max_x):
                        for y in range(max_y):
                            # L shape at (x,y)
                            pts = [(x,y),(x+1,y),(x,y+1)]
                            if all(p in g for p in pts):
                                vals = [g[p] for p in pts]
                                # check distinct and max-min=2
                                if len(set(vals))!=3 or max(vals)-min(vals)!=2:
                                    return False
                    return True
                
                # Backtrack
                def backtrack(idx):
                    if idx==len(points):
                        return True
                    p = points[idx]
                    if p in g:
                        return backtrack(idx+1)
                    # Determine possible values for p based on constraints with already assigned neighbors
                    # Look at L shapes where p is one of three points; they involve other two points maybe known.
                    # We'll compute feasible values from each such L shape (must be integer >=0)
                    feasible = set(range(0, 10))  # limit maybe up to some bound
                    # We'll refine based on each L shape that includes p and has other two assigned.
                    for (dx,dy) in [(0,0), (-1,0), (0,-1)]:  # p could be lower-left, right neighbor, up neighbor
                        x = p[0]+dx
                        y = p[1]+dy
                        if 0<=x<max_x and 0<=y<max_y:
                            pts = [(x,y),(x+1,y),(x,y+1)]
                            # Identify which of these are assigned
                            assigned = [pt for pt in pts if pt in g]
                            unknown = [pt for pt in pts if pt not in g]
                            if len(unknown)==1:
                                # one unknown, we can deduce its possible values
                                known_vals = [g[pt] for pt in assigned]
                                # need to find integer v >=0 such that {v} ∪ known_vals are three consecutive distinct ints
                                # Determine min and max of known_vals
                                # The unknown could be min, middle, or max.
                                # Let's brute compute possible v in 0..20 that satisfy condition.
