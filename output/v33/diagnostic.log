            def checkerboard_grid(m,n):
                N=m*n
                # assign small numbers to black squares (i+j even) and large to white
                black_coords = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==0]
                white_coords = [(i,j) for i in range(m) for j in range(n) if (i+j)%2==1]
