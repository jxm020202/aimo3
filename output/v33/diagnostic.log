                init = tuple(1 if (i%2)==0 else 0 for i in range(N))  # i 0-indexed: i even => position odd => tail=1
                # BFS state: (pos, config)
                # pos is index of coin just flipped (i.e., current position)
                # moves count is steps taken so far
                # start: we can flip any coin as first move, so we consider all possible start positions
                # We'll BFS from all start states simultaneously.
                visited = {}
                q = deque()
                for start in range(N):
                    # flip start coin
                    cfg = list(init)
                    cfg[start] ^= 1  # toggle
                    state = (start, tuple(cfg))
                    visited[state] = 1  # moves count (including first flip)
                    q.append(state)
                    if all(v==0 for v in cfg):
                        return 1
                while q:
                    pos, cfg = q.popleft()
                    moves = visited[(pos,cfg)]
                    # try adjacent flips
                    for nxt in (pos-1, pos+1):
                        if 0 <= nxt < N:
