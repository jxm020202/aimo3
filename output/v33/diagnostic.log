            def subgroup_squares(N):
                # returns exponents a (0..N-1) such that a is even (i.e., squares in Z/NZ)
                # Actually squares modulo N are set {a^2 mod N} but for cyclic group of N-th roots, squares correspond to even exponents because (ω^b)^2 = ω^{2b}
                # So the subgroup generated by ω^2 has exponents multiples of 2.
                return [a for a in range(N) if a % 2 == 0]
            
            def test_subgroup(N, max_e=20):
                sub = subgroup_squares(N)
                omega = complex(sp.exp(2*sp.pi*sp.I/N).evalf(30))
                for e in range(1, max_e+1):
                    prod = 1+0j
                    for a in sub:
                        prod *= (1 + omega**(a*e))
                    if abs(prod - 1) > 1e-9:
