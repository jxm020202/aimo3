            import math, random, itertools, numpy as np
            
            def compute_sum(angles, alpha_deg=100):
                n = len(angles)
                alpha = math.radians(alpha_deg)
                total = 0
                for i, th_i in enumerate(angles):
                    # compute direction angles from point i to others
                    # point coordinates on unit circle
                    xi, yi = math.cos(th_i), math.sin(th_i)
                    dirs = []
                    for j, th_j in enumerate(angles):
                        if i == j: continue
                        xj, yj = math.cos(th_j), math.sin(th_j)
                        vx, vy = xj - xi, yj - yi
                        ang = math.atan2(vy, vx)  # range -pi to pi
                        dirs.append(ang)
                    # sort angles
                    dirs.sort()
                    # duplicate with +2π for circular wrap
                    dirs2 = dirs + [a + 2*math.pi for a in dirs]
                    # sliding window
                    maxcnt = 0
                    m = len(dirs)
                    left = 0
                    for right in range(len(dirs2)):
                        while dirs2[right] - dirs2[left] > alpha + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def test_arc(L_deg):
                n = 100
                # place points equally spaced on arc of length L_deg centered at 0
                L = math.radians(L_deg)
                start = -L/2
                angles = [start + i*(L/(n-1)) for i in range(n)]
                return compute_sum(angles)
            
