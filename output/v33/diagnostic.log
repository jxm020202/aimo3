            import random, math, time
            
            def random_points_in_circle(n, radius=1.0):
                pts = []
                for _ in range(n):
                    r = radius * math.sqrt(random.random())
                    theta = random.random()*2*math.pi
                    pts.append((r*math.cos(theta), r*math.sin(theta)))
                return pts
            
            def compute_sum_pts(pts, alpha_deg=100):
                n = len(pts)
                alpha = math.radians(alpha_deg)
                total = 0
                for i in range(n):
                    xi, yi = pts[i]
                    dirs = []
                    for j in range(n):
                        if i==j: continue
                        xj, yj = pts[j]
                        vx, vy = xj - xi, yj - yi
                        ang = math.atan2(vy, vx)
                        dirs.append(ang)
                    dirs.sort()
                    dirs2 = dirs + [a + 2*math.pi for a in dirs]
                    left = 0
                    maxcnt = 0
                    for right in range(len(dirs2)):
                        while dirs2[right] - dirs2[left] > alpha + 1e-12:
                            left += 1
                        cnt = right - left + 1
                        if cnt > maxcnt:
                            maxcnt = cnt
                    total += maxcnt
                return total
            
            def simulated_annealing(n=100, iterations=20000):
                pts = random_points_in_circle(n)
                best = compute_sum_pts(pts)
                best_pts = pts[:]
                current = best
                T0 = 1.0
                for it in range(iterations):
                    T = T0 * (1 - it/iterations)
                    # pick random point and move slightly
                    i = random.randrange(n)
                    old = pts[i]
                    # propose new location within small radius
                    r = math.sqrt(random.random())*0.05  # small move
                    theta = random.random()*2*math.pi
                    new = (old[0] + r*math.cos(theta), old[1] + r*math.sin(theta))
                    # ensure inside unit circle
                    if new[0]**2 + new[1]**2 > 1.0:
                        continue
                    pts[i] = new
                    new_sum = compute_sum_pts(pts)
                    delta = new_sum - current
                    if delta > 0 or random.random() < math.exp(delta / (T+1e-9)):
                        current = new_sum
                        if new_sum > best:
                            best = new_sum
                            best_pts = pts[:]
                            #print("Iter", it, "new best", best)
                    else:
                        pts[i] = old
                return best, best_pts
            
            best_val, best_pts = simulated_annealing(iterations=2000)
            best_val
            
