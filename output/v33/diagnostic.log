                # x must be <= N maybe? Not necessarily but we can bound search up to N (since if x > N, we can maybe use larger)
                # We'll search up to N (since minimal x likely <= N)
                for x in range(1, N+1):
                    divisors = sp.divisors(x)
                    # need three distinct positive divisors
                    if len(divisors) < 3:
                        continue
                    # check all triples
                    for i in range(len(divisors)):
                        for j in range(i+1, len(divisors)):
                            for k in range(j+1, len(divisors)):
