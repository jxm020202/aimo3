            def product_QR(p):
                z = sp.exp(2*sp.pi*sp.I/p)
                # quadratic residues modulo p (excluding 0)
                residues = [a for a in range(1,p) if sp.legendre_symbol(a,p)==1]
                prod = 1
                for a in residues:
                    prod *= (z**a + 1)
                return sp.simplify(prod)
            
