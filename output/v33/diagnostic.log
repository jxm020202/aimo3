            def max_sum_bruteforce_grid(n, grid_step=0.2):
                # generate points on a grid inside unit circle for small n
                pts = []
                # generate candidate points
                candidates = []
                step = grid_step
                for x in np.arange(-1,1+1e-9,step):
                    for y in np.arange(-1,1+1e-9,step):
                        if x**2 + y**2 <= 1+1e-9:
                            candidates.append((x,y))
                # brute force choose n distinct points (combinatorial explosion)
                from itertools import combinations
                best = 0
                best_comb = None
                for comb in combinations(candidates, n):
                    s = total_sum(comb)
                    if s > best:
                        best = s
                        best_comb = comb
                return best, best_comb
            
