            import math
            
            def max_edges(n):
                best = (0, None)
                for c in range(1, n):  # core size at least 1, less than n (since need leaves)
                    p = n - c
                    # minimal sum of squares when leaves distributed as evenly as possible
                    # compute integer distribution: each l_i = floor(p/c) or ceil
                    base = p // c
                    rem = p % c
                    # sum of squares = rem*(base+1)^2 + (c-rem)*base^2
                    sum_sq = rem*(base+1)**2 + (c-rem)*base**2
                    E = c*(c-1)//2 + p + (p**2 - sum_sq)//2
                    if E > best[0]:
                        best = (E, (c, p, base, rem, sum_sq))
                return best
            
            best = max_edges(160)
            best
            
