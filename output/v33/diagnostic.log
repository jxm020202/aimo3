            import itertools
            
            def min_f_bruteforce(n, last):
                # n odd length, start=1, end=last
                # generate nondecreasing integer sequences of length n with a1=1, an=last
                # brute force via recursion with limited range (0..last)
                best = None
                best_seq=None
                # Use recursion to generate monotone sequences
                def rec(idx, prev, seq):
                    nonlocal best,best_seq
                    if idx==n:
                        if seq[-1]!=last:
                            return
                        # compute f
                        S=sum(x*x for x in seq)
                        T=sum(seq[i]*seq[i+2] for i in range(n-2))
                        f=S-T
                        if best is None or f<best:
                            best=f
                            best_seq=seq[:]
                        return
                    # Determine allowed range for current element
                    # Must be >= prev and <= last (since monotone)
                    # Also need to ensure enough room to reach last in remaining steps: we can just bound by last.
                    for val in range(prev, last+1):
                        seq.append(val)
                        rec(idx+1, val, seq)
                        seq.pop()
                rec(1,1,[1])
                return best,best_seq
            
            def min_f_formula(n,last):
                # n odd, start=1, end=last
                # compute minimal f using derived formula
                # number of odd positions = (n+1)//2
                odd_cnt = (n+1)//2
                even_cnt = n - odd_cnt
                # total increase needed for odd subsequence = last-1
                total_inc = last-1
                # number of odd gaps = odd_cnt-1
                odd_gaps = odd_cnt-1
                # minimal sum of squares for odd increments = total_inc (since using +1 increments)
                odd_sum = total_inc
                # For even subsequence, total increase = total_inc - 1? Actually even subsequence ends at value maybe last-1? Let's compute.
                # In optimal construction, even ends at last-1 (since we skip final odd increment)
                even_end = last-1
                even_start = 1
                even_inc = even_end - even_start
                even_sum = even_inc  # using +1 increments
                # a2 = even_start = 1
                a2_sq = 1
                a_last_even_sq = even_end**2
                f = (1 + a2_sq + a_last_even_sq + last**2 + odd_sum + even_sum)//2
                return f
            
