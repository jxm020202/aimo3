            import numpy as np, itertools, math, sys, time
            from scipy.optimize import milp, LinearConstraint, Bounds
            
            def max_min_sum_grid(m,n):
                N=m*n
                # vertices indexed 0..N-1
                # edges list of (i,j) with i<j
                edges=[]
                for i in range(m):
                    for j in range(n):
                        v=i*n+j
                        if i+1<m:
                            edges.append((v,(i+1)*n+j))
                        if j+1<n:
                            edges.append((v,i*n+j+1))
                # binary variables x_{v,k} flattened
                # size = N * N
                var_count = N*N
                # constraints:
                A_eq=[]
                b_eq=[]
                # each vertex assigned exactly one number
                for v in range(N):
                    row = np.zeros(var_count)
                    for k in range(N):
                        row[v*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each number assigned to exactly one vertex
                for k in range(N):
                    row = np.zeros(var_count)
                    for v in range(N):
                        row[v*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # binary constraints: integrality vector
                integrality = np.ones(var_count, dtype=int)
                # bounds 0-1
                bounds = Bounds(0,1)
                # function to test feasibility for given T
                def feasible(T):
                    # inequality constraints: for each edge, sum k*x_{v,k} + sum l*x_{u,l} >= T
                    # Convert to - >= -T form: -sum ... <= -T
                    A_ub = []
                    b_ub = []
                    for (v,u) in edges:
                        row = np.zeros(var_count)
                        for k in range(N):
                            row[v*N + k] = - (k+1)  # negative because we will use <=
                            row[u*N + k] = - (k+1)
                        A_ub.append(row)
                        b_ub.append(-T)
                    A_ub = np.array(A_ub)
                    b_ub = np.array(b_ub)
                    # Solve MILP with dummy objective (0)
                    c = np.zeros(var_count)
                    try:
                        res = milp(c, constraints=[LinearConstraint(A_eq,b_eq,b_eq), LinearConstraint(A_ub,b_ub,np.full(len(edges), -np.inf)], bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
                    except Exception as e:
                        print("milp error", e)
                        return False
                    if res.success:
                        return True
                    else:
                        return False
                # binary search T between lower bound and upper bound
                low=2 # min possible sum (1+1) but numbers distinct so min sum >= 1+2=3, but we set low=3
                high=2*N # max possible sum (N + (N-1))? Actually max sum of two numbers is N+(N-1)=2N-1. So high=2*N
                best=0
                while low<=high:
                    mid=(low+high)//2
                    if feasible(mid):
                        best=mid
                        low=mid+1
                    else:
                        high=mid-1
                return best
            
