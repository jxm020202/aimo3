            import itertools
            
            def edge_domination_number(m,n):
                left = list(range(m))
                right = list(range(n))
                edges = [(i,j) for i in left for j in right]
                for k in range(1, m*n+1):
                    for subset in itertools.combinations(edges, k):
                        # compute dominated edges
                        dominated = set()
                        for e in edges:
                            if e in subset:
                                dominated.add(e)
                            else:
                                # check adjacency: share left or right vertex with some edge in subset
                                for s in subset:
                                    if e[0]==s[0] or e[1]==s[1]:
                                        dominated.add(e)
                                        break
                        if len(dominated)==len(edges):
                            return k
                return None
            
            for n in range(2,6):
