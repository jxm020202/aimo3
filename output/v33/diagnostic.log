            import numpy as np
            
            def solve_continuous(n, total_sum):
                # n variables d[0..n-1]
                # Build matrix for unknowns d and lambda (n+1 unknowns)
                N = n + 1
                A = np.zeros((N, N))
                b = np.zeros(N)
                # Equation 0: sum d_i = total_sum
                A[0, :n] = 1
                b[0] = total_sum
                # Equation for k=1 (index 0)
                # 2 + 4 d1 + 2 d2 + lam = 0
                # => 4 d1 + 2 d2 + lam = -2
                A[1, 0] = 4
                A[1, 1] = 2
                A[1, n] = 1  # lambda coefficient
                b[1] = -2
                # Interior equations for k=2..n-1 (index 1..n-2)
                eq_idx = 2
                for k in range(2, n):  # k is 2..n-1 inclusive
                    # 2 d_{k-1} + 4 d_k + 2 d_{k+1} + lam = 0
                    A[eq_idx, k-2] = 2
                    A[eq_idx, k-1] = 4
                    A[eq_idx, k] = 2
                    A[eq_idx, n] = 1
                    b[eq_idx] = 0
                    eq_idx += 1
                # Last equation for k=n
                # 2 d_{n-1} + 4 d_n - 398 + lam = 0
                # => 2 d_{n-1} + 4 d_n + lam = 398
                A[eq_idx, n-2] = 2
                A[eq_idx, n-1] = 4
                A[eq_idx, n] = 1
                b[eq_idx] = 398
                # Solve linear system
                sol = np.linalg.solve(A, b)
                d = sol[:n]
                lam = sol[n]
                return d, lam
            
