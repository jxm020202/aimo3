            def min_vertex_cover(parity):
                L = [d for d in d1_vals if d%2==parity]
                R = [d for d in d2_vals if d%2==parity]
                adj = {u: [] for u in L}
                for i in range(1, n+1):
                    for j in range(1, n+1):
                        d1 = i - j
                        d2 = i + j
                        if d1%2==parity and d2%2==parity:
                            adj[d1].append(d2)
                # compute maximum matching using augmenting path algorithm returning matchL and matchR
                matchR = {}
                matchL = {}
                def dfs(u, seen):
                    for v in adj.get(u, []):
                        if v in seen:
                            continue
                        seen.add(v)
                        if v not in matchR or dfs(matchR[v], seen):
                            matchR[v] = u
                            matchL[u] = v
                            return True
                    return False
                for u in L:
                    dfs(u, set())
                # find vertices reachable from unmatched left vertices via alternating paths
                # BFS
                from collections import deque
                reachableL = set()
                reachableR = set()
                q = deque()
                for u in L:
                    if u not in matchL:
                        q.append(u)
                        reachableL.add(u)
                while q:
                    u = q.popleft()
                    # u is left vertex
                    for v in adj[u]:
                        if v not in reachableR:
                            reachableR.add(v)
                            # if v is matched, add its matched left vertex
                            if v in matchR and matchR[v] not in reachableL:
                                reachableL.add(matchR[v])
                                q.append(matchR[v])
                # min vertex cover = (L \ reachableL) ∪ (R ∩ reachableR)
                coverL = [u for u in L if u not in reachableL]
                coverR = [v for v in R if v in reachableR]
                return coverL, coverR
            
            coverL_even, coverR_even = min_vertex_cover(0)
            coverL_odd, coverR_odd = min_vertex_cover(1)
            len(coverL_even)+len(coverR_even), len(coverL_odd)+len(coverR_odd)
