            def product_qr(p, e):
                # p prime
                omega = sp.exp(2*sp.pi*sp.I/p)
                # quadratic residues modulo p (excluding 0)
                residues = [a for a in range(1, p) if pow(a, (p-1)//2, p) == 1]
                prod = 1
                for a in residues:
                    prod *= (1 + omega**(a*e))
                prod = sp.simplify(prod)
                return sp.nsimplify(prod)
            
            def test_prime(p, max_e=10):
                for e in range(1, max_e+1):
