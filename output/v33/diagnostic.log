                        row[c2*N+num]=-(num+1)
                    row[-1]=1
                    A_ub_rows.append(row); b_ub.append(0)
                A_ub=np.array(A_ub_rows); b_ub=np.array(b_ub)
                # also add lower bound for S: S >= S_target => we set lower bound for variable S as S_target
                lower[-1]=S_target
                bounds=Bounds(lower, upper)
