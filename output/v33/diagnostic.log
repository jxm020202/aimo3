            from collections import deque
            
            def min_moves(n):
                # initial config: 1 for tails at odd indices (1-indexed), 0 for heads at even
                init = 0
                for i in range(n):
                    if (i+1)%2==1: # odd index
                        init |= (1<<i)
                target = 0
                # BFS over (pos, config)
                # pos can be any index 0..n-1 (first move any)
                # We'll treat first move as flipping any coin; we can start with any pos.
                # BFS queue holds (pos, config, steps)
                visited = set()
                q = deque()
                for pos in range(n):
                    cfg = init ^ (1<<pos)  # flip pos
                    state = (pos, cfg)
                    visited.add(state)
                    q.append((pos, cfg, 1))
                    if cfg == target:
                        return 1
                while q:
                    pos, cfg, steps = q.popleft()
                    # next moves: flip adjacent coin (pos-1 or pos+1)
                    for np in (pos-1, pos+1):
                        if 0 <= np < n:
                            ncfg = cfg ^ (1<<np)
                            nstate = (np, ncfg)
                            if nstate not in visited:
                                if ncfg == target:
                                    return steps+1
                                visited.add(nstate)
                                q.append((np, ncfg, steps+1))
                return None
            
            for n in range(1,13):
                print(n, min_moves(n))
            
