                grid = np.zeros((m,n), dtype=int)
                # sort black coords maybe any order
                for idx, (i,j) in enumerate(black_coords):
                    grid[i,j] = numbers[idx]
                # assign remaining numbers to white
                for idx, (i,j) in enumerate(white_coords):
                    grid[i,j] = numbers[len(black_coords)+idx]
