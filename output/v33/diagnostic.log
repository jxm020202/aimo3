            from scipy.optimize import LinearConstraint, Bounds, milp
            def max_S_grid_milp(m,n, time_limit=30):
                N=m*n
                cell_index=lambda i,j: i*n+j
                edges=[]
                for i in range(m):
                    for j in range(n):
                        c=cell_index(i,j)
                        if i+1<m:
                            edges.append((c, cell_index(i+1,j)))
                        if j+1<n:
                            edges.append((c, cell_index(i,j+1)))
                total_vars = N*N  # binary assignment variables
                # Add one variable for S
                total = total_vars + 1
                # Objective: maximize S => minimize -S
                c_obj = np.zeros(total)
                c_obj[-1] = -1.0
                # Equality constraints
                A_eq = []
                b_eq = []
                # each cell assigned exactly one number
                for cell in range(N):
                    row = np.zeros(total)
                    for k in range(N):
                        row[cell*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                # each number assigned to exactly one cell
                for k in range(N):
                    row = np.zeros(total)
                    for cell in range(N):
                        row[cell*N + k] = 1
                    A_eq.append(row)
                    b_eq.append(1)
                A_eq = np.array(A_eq)
                b_eq = np.array(b_eq)
                # Edge constraints: sum_{k} (k+1)*(x_c1k + x_c2k) - S >= 0
                A_ub = []
                b_ub = []
                for c1,c2 in edges:
                    row = np.zeros(total)
                    for k in range(N):
                        row[c1*N + k] += (k+1)
                        row[c2*N + k] += (k+1)
                    row[-1] = -1  # -S
                    # inequality: - (sum - S) <= 0 => -sum + S <= 0
                    A_ub.append(row)
                    b_ub.append(0)
                A_ub = np.array(A_ub)
                b_ub = np.array(b_ub)
                # Bounds: binary for first total_vars, S between 0 and 2N
                lb = np.zeros(total)
                ub = np.full(total, np.inf)
                ub[:total_vars] = 1  # binary upper bound 1
                # S bounds
                ub[-1] = 2*N  # max possible sum
                bounds = Bounds(lb, ub)
                # Integrality: first total_vars are integer (binary), S integer
                integrality = np.ones(total)
                # Constraints object
                constraints = []
                constraints.append(LinearConstraint(A_eq, b_eq, b_eq))
                constraints.append(LinearConstraint(A_ub, -np.inf*np.ones_like(b_ub), b_ub))
                # Solve
                res = milp(c=c_obj, constraints=constraints, bounds=bounds, integrality=integrality,
                            options={'disp': False, 'time_limit': time_limit})
                if not res.success:
                    print("MILP failed:", res.message)
                    return None
                S_opt = int(round(-res.fun))
                return S_opt
            
            print("2x2", max_S_grid_milp(2,2))
            
