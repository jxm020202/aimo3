            def f_formula_general(n):
                # find smallest odd divisor d >=5 of n
                d = None
                for k in range(5, n+1, 2):
                    if n % k == 0:
                        d = k
                        break
                if d is None:
                    # no odd divisor >=5, fallback: we need other method.
                    # For our cases, there will be.
                    return None
                # compute C = n * (d-1) / (2*d)
                # Should be integer? Not necessarily; but f is integer minimal lcm, which must be integer.
                # Since C = k * p where n = d * k, p = (d-1)/2, so C = k * p integer.
                k = n // d
                p = (d - 1) // 2
                C = k * p
                # f = C (since lcm = C)
                return C
            
