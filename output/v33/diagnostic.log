            def lp_relax(parity):
                # Build covering LP for whole board (both colors)
                # We'll just use whole board variables (169)
                n=13
                num=n*n
                # Build A matrix as before
                A = np.zeros((num, num), dtype=int)
                for i in range(n):
                    for j in range(n):
                        row_idx = i*n + j
                        for i2 in range(n):
                            for j2 in range(n):
                                if (i2 - j2 == i - j) or (i2 + j2 == i + j):
                                    A[row_idx, i2*n + j2] = 1
                # LP relaxation
                c = np.ones(num)
                bounds = Bounds(0, None)
                # constraints: A x >= 1
                lincon = LinearConstraint(A, np.ones(num), np.full(num, np.inf))
                from scipy.optimize import linprog
                # Convert to standard form: minimize c^T x subject to -A x <= -1
                res = linprog(c=c, A_ub=-A, b_ub=-np.ones(num), bounds=(0, None), method='highs')
