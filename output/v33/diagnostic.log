            import math, itertools
            
            def f_bruteforce(n):
                min_lcm = None
                best = None
                # iterate a<b<c distinct positive ints sum n
                for a in range(1, n-2):
                    for b in range(a+1, n-a-1):
                        c = n - a - b
                        if c <= b: continue
                        # distinct automatically
                        l = math.lcm(a,b,c)
                        if min_lcm is None or l < min_lcm:
                            min_lcm = l
                            best = (a,b,c)
                return min_lcm, best
            
            def f_bruteforce2(n):
                # allow any order distinct
                min_lcm = None
                best = None
                for a in range(1, n-1):
                    for b in range(1, n-a):
                        if b==a: continue
                        c = n - a - b
                        if c<=0 or c==a or c==b: continue
                        l = math.lcm(a,b,c)
                        if min_lcm is None or l < min_lcm:
                            min_lcm = l
                            best = (a,b,c)
