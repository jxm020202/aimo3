            # Find a maximum matching using earlier algorithm and also record matched vertices
            def max_matching_with_match(parity):
                # Build adjacency for all vertices (including isolated)
                left_vals = [d for d in range(-12,13) if (d%2+2)%2 == parity]
                right_vals = [d for d in range(0,25) if (d%2) == parity]
                L=len(left_vals); R=len(right_vals)
                adj={i:[] for i in range(L)}
                for i,d1 in enumerate(left_vals):
