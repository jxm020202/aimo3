            import itertools, math
            
            def max_min_sum(m,n):
                N=m*n
                # generate all permutations? For N up to 9 maybe.
                maxS=0
                best=None
                cells=[(i,j) for i in range(m) for j in range(n)]
                # adjacency list
                adj={}
                for idx,(i,j) in enumerate(cells):
                    neigh=[]
                    for di,dj in [(1,0),(-1,0),(0,1),(0,-1)]:
                        ni,nj=i+di,j+dj
                        if 0<=ni<m and 0<=nj<n:
                            neigh.append(cells.index((ni,nj)))
                    adj[idx]=neigh
                for perm in itertools.permutations(range(1,N+1)):
                    min_sum=math.inf
                    for v in range(N):
                        for u in adj[v]:
                            if u>v: # each edge once
                                s=perm[v]+perm[u]
                                if s<min_sum:
                                    min_sum=s
                                    if min_sum<=maxS:
                                        break
                        if min_sum<=maxS:
                            break
                    else:
                        # after loop
                        if min_sum>maxS:
                            maxS=min_sum
                            best=perm
                return maxS, best
            
