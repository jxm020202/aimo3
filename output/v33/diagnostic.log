            def find_path(N):
                start_bits = 0
                for i in range(N):
                    if i%2==1:
                        start_bits |= 1<<i
                goal_bits = (1<<N)-1
                from collections import deque
                visited = {}
                q = deque()
                for i in range(N):
                    bits = start_bits ^ (1<<i)
                    state = (i,bits)
                    visited[state] = (None, i) # parent
                    q.append((state,1))
                while q:
                    (pos,bits),d = q.popleft()
                    if bits == goal_bits:
