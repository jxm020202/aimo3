            def min_edge_dom_K(n):
                # brute force for small n
                from itertools import combinations
                edges = [(i,j) for i in range(n) for j in range(n)]
                m = len(edges)
                for k in range(1, m+1):
                    for combo in combinations(range(m), k):
                        selected = [edges[i] for i in combo]
                        # compute dominated edges
                        dominated=set()
                        for e in edges:
                            for s in selected:
                                if e[0]==s[0] or e[1]==s[1]:
                                    dominated.add(e)
                                    break
                        if len(dominated)==m:
                            return k
                return None
            
            for n in range(1,6):
                print(n, min_edge_dom_K(n))
            
