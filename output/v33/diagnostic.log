            def resultant_via_sylvester(Pcoeffs, Qcoeffs):
                # Pcoeffs list from highest degree to constant
                m = len(Pcoeffs)-1
                n = len(Qcoeffs)-1
                import sympy as sp
                # Build Sylvester matrix of size m+n
                rows = []
                for i in range(n):
                    rows.append(Pcoeffs + [0]*i)
                for i in range(m):
                    rows.append(Qcoeffs + [0]*i)
                M = sp.Matrix(rows)
                return sp.factor(M.det())
            # Example
            Pcoeffs=[sp.I, -sp.I*sp.Symbol('r')] # I*x - I*r = I*(x - r)
            Qcoeffs=[1,1] # x+1
            resultant_via_sylvester(Pcoeffs, Qcoeffs)
            
