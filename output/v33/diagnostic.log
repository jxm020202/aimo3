            def construct_grid(S):
                n = 60
                # degrees per cell
                deg = {}
                cells = []
                for i in range(n):
                    for j in range(n):
                        d = 4
                        if i==0 or i==n-1: d -= 1
                        if j==0 or j==n-1: d -= 1
                        deg[(i,j)] = d
                        cells.append((i,j))
                # sort cells by degree descending (interior first)
                cells.sort(key=lambda pos: deg[pos], reverse=True)
                # available numbers descending
                available = list(range(3600, 0, -1))
                # grid dict
                grid = {}
                # neighbor offsets
                dirs = [(1,0),(-1,0),(0,1),(0,-1)]
                for pos in cells:
                    # find the largest available number that satisfies constraints with already assigned neighbors
                    for idx, val in enumerate(available):
                        ok = True
                        i,j = pos
                        for di,dj in dirs:
                            ni,nj = i+di, j+dj
                            if 0 <= ni < n and 0 <= nj < n and (ni,nj) in grid:
                                if val + grid[(ni,nj)] < S:
                                    ok = False
                                    break
                        if ok:
                            grid[pos] = val
                            del available[idx]
                            break
                    else:
                        # no value fits
                        return None
                return grid
            
