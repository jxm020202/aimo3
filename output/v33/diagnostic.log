            import numpy as np, math, itertools, collections, random, sys, sympy as sp
            R, C = 7, 7
            dominos = []
            for r in range(R):
                for c in range(C-1):
                    dominos.append(((r,c),(r,c+1)))  # horizontal
            for r in range(R-1):
                for c in range(C):
                    dominos.append(((r,c),(r+1,c)))  # vertical
            
            n = len(dominos)
            # mapping cell -> list of dominos covering it
            cell_to_dominos = {}
            for idx, cells in enumerate(dominos):
                for cell in cells:
                    cell_to_dominos.setdefault(cell, []).append(idx)
            
            # Build constraints rows and bounds
            rows = []
            lb = []
            ub = []
            
            # Packing constraints: sum <=1
            for cell, idxs in cell_to_dominos.items():
                row = np.zeros(n, dtype=int)
                for i in idxs:
                    row[i] = 1
                rows.append(row)
                lb.append(-np.inf)
                ub.append(1)
            
            # Covering constraints: for each domino i, each side cell s inside board
            for i, cells in enumerate(dominos):
                (r1,c1),(r2,c2) = cells
                if r1 == r2:  # horizontal
                    r = r1
                    c_left = min(c1,c2)
                    c_right = max(c1,c2)
                    # left side
                    if c_left - 1 >= 0:
                        side = (r, c_left-1)
                        row = np.zeros(n, dtype=int)
                        for j in cell_to_dominos.get(side, []):
                            row[j] = 1
                        row[i] = -1
                        rows.append(row)
                        lb.append(0)
                        ub.append(np.inf)
                    # right side
                    if c_right + 1 < C:
                        side = (r, c_right+1)
                        row = np.zeros(n, dtype=int)
                        for j in cell_to_dominos.get(side, []):
                            row[j] = 1
                        row[i] = -1
                        rows.append(row)
                        lb.append(0)
                        ub.append(np.inf)
                else:  # vertical
                    c = c1
                    r_top = min(r1,r2)
                    r_bottom = max(r1,r2)
                    # up side
                    if r_top - 1 >= 0:
                        side = (r_top-1, c)
                        row = np.zeros(n, dtype=int)
                        for j in cell_to_dominos.get(side, []):
                            row[j] = 1
                        row[i] = -1
                        rows.append(row)
                        lb.append(0)
                        ub.append(np.inf)
                    # down side
