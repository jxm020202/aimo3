# Brute-force ILP for small n to guess the maximum size.
import itertools
import math
import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds

def max_points(n):
    # Variables: one binary variable for each lattice point (i,j) with 1-indexed coordinates.
    # Flatten index: idx = (i-1)*n + (j-1)
    N = n * n
    c = -np.ones(N)  # maximize sum => minimize negative sum

    # Constraints: for each forbidden quadruple, sum <= 3
    A = []
    b = []

    # Horizontal-base isosceles trapezoid (including rectangle)
    # For each column midpoint xm (1..n), each offset d>0 such that xm-d>=1 and xm+d<=n,
    # for each pair of distinct rows y1<y2, forbid four points:
    # (xm-d, y1), (xm+d, y1), (xm-d, y2), (xm+d, y2)
    for xm in range(1, n+1):
        for d in range(1, min(xm-1, n-xm)+1):
            x_left = xm - d
            x_right = xm + d
            for y1 in range(1, n+1):
                for y2 in range(y1+1, n+1):
                    coeff = np.zeros(N, dtype=int)
                    # map (x,y) to index
                    idx1 = (y1-1)*n + (x_left-1)
                    idx2 = (y1-1)*n + (x_right-1)
                    idx3 = (y2-1)*n + (x_left-1)
                    idx4 = (y2-1)*n + (x_right-1)
                    coeff[idx1] = 1
                    coeff[idx2] = 1
                    coeff[idx3] = 1
                    coeff[idx4] = 1
                    A.append(coeff)
                    b.append(3)  # sum <= 3

    # Vertical-base isosceles trapezoid (including rectangle)
    # Symmetric about a row midpoint ym
    for ym in range(1, n+1):
        for d in range(1, min(ym-1, n-ym)+1):
            y_low = ym - d
            y_high = ym + d
            for x1 in range(1, n+1):
                for x2 in range(x1+1, n+1):
                    coeff = np.zeros(N, dtype=int)
                    idx1 = (y_low-1)*n + (x1-1)
                    idx2 = (y_high-1)*n + (x1-1)
                    idx3 = (y_low-1)*n + (x2-1)
                    idx4 = (y_high-1)*n + (x2-1)
                    coeff[idx1] = 1
                    coeff[idx2] = 1
                    coeff[idx3] = 1
                    coeff[idx4] = 1
                    A.append(coeff)
                    b.append(3)

    A = np.array(A, dtype=int)
    b = np.array(b, dtype=int)

    # Bounds: each variable between 0 and 1, integer
    bounds = Bounds(0, 1)

    # Linear constraints
    lin_con = LinearConstraint(A, -np.inf, b)

    # Solve MILP
    res = milp(c=c, constraints=lin_con, bounds=bounds,
                integrality=np.ones(N, dtype=int), options={"presolve": True, "disp": False})
    if not res.success:
        raise RuntimeError("MILP failed")
    max_val = -res.fun  # because we minimized negative sum
    return int(round(max_val))

# Test for small n
for n in range(2, 7):
    print(n, max_points(n))
```

