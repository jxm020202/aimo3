            import itertools
            
            def max_edges_bruteforce(n):
                max_e = 0
                best = None
                vertices = list(range(n))
                edges_list = [(i,j) for i in range(n) for j in range(i+1,n)]
                m = len(edges_list)
                for mask in range(1<<m):
                    edges = set()
                    for idx, e in enumerate(edges_list):
                        if mask & (1<<idx):
                            edges.add(e)
                    # check condition
                    ok = True
                    for u in vertices:
                        # find neighbor v such that N(u) ∩ N(v) = ∅
                        found = False
                        # neighbors of u
                        N_u = {v for (a,v) in edges if a==u} | {a for (a,b) in edges if b==u}
                        for v in N_u:
                            N_v = {w for (a,w) in edges if a==v} | {a for (a,b) in edges if b==v}
                            if N_u.intersection(N_v) == set():
                                found = True
                                break
                        if not found:
                            ok = False
                            break
                    if ok:
                        ecount = len(edges)
                        if ecount > max_e:
                            max_e = ecount
                            best = edges
                return max_e, best
            
