            def min_marked(n):
                # Build edges for n x n
                d1_vals = list(range(-(n-1), n))
                d2_vals = list(range(2, 2*n+1))
                edges = []
                for d1 in d1_vals:
                    for d2 in d2_vals:
                        if (d1 + d2) % 2 != 0:
                            continue
                        i = (d1 + d2)//2
                        j = (d2 - d1)//2
                        if 1 <= i <= n and 1 <= j <= n:
                            idx1 = d1 - d1_vals[0]
                            idx2 = d2 - d2_vals[0]
                            edges.append((idx1, idx2))
                num_edges = len(edges)
                # Build incident edges list
                left_vertices = len(d1_vals)
                right_vertices = len(d2_vals)
                edges_by_u = collections.defaultdict(list)
                edges_by_v = collections.defaultdict(list)
                for idx, (u,v) in enumerate(edges):
                    edges_by_u[u].append(idx)
                    edges_by_v[v].append(idx)
                incident = []
                for idx, (u,v) in enumerate(edges):
                    incident.append(list(set(edges_by_u[u]) | set(edges_by_v[v])))
                A = np.zeros((num_edges, num_edges), dtype=int)
                for i, inc in enumerate(incident):
