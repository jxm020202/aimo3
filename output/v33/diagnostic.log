            def brute_f(k, n=2001):
                # sample x,y in [0,1] grid
                xs = np.linspace(0,1,n)
                max_val = 0.0
                best = None
                for x in xs:
                    # max y for given x such that x^2 + y^2 <=1
                    max_y = math.sqrt(max(0,1 - x*x))
                    # sample y values
                    # Use n points for y as well but limited to max_y
                    ys = np.linspace(0, max_y, n)
                    # compute O
                    # r = sqrt(x^2 + y^2)
                    # O = 4*(x*y + k*x*(1 - r))
                    # compute vectorized
                    r = np.sqrt(x*x + ys*ys)
                    O = 4*(x*ys + k*x*(1 - r))
                    idx = np.argmax(O)
                    if O[idx] > max_val:
                        max_val = O[idx]
                        best = (x, ys[idx], 1 - r[idx])
                return max_val, best
            
