            def possible_values_at_target(max_x, max_y, target):
                # target is (tx,ty)
                # returns set of possible values at target
                values = set()
                # order of cells to assign: row-major
                cells = [(i,j) for i in range(max_x+1) for j in range(max_y+1)]
                # ensure target is included
                assert target in cells
                # Precompute constraints: each (x,y) defines a triple of cells
                triples = {}
                for x in range(max_x):
                    for y in range(max_y):
                        triples[(x,y)] = [(x,y), (x,y+1), (x+1,y)]
                # We'll backtrack
                assign = {}
                # bound for values: we can set a reasonable range based on steps
                # max difference per step is 2, so max absolute value <= 2*(max_x+max_y)
                bound = 2*(max_x+max_y)+5
                
                def check_triple(triple):
                    vals = [assign[p] for p in triple]
                    # must be three distinct ints forming consecutive numbers
                    s = set(vals)
                    if len(s)!=3:
                        return False
                    mn = min(vals)
                    mx = max(vals)
                    if mx - mn != 2:
                        return False
                    # also they must be exactly {mn,mn+1,mn+2}
                    if set(vals)!={mn,mn+1,mn+2}:
                        return False
                    return True
                
                # For pruning, we can also check partial triples: if two assigned, we can bound third?
                # Not needed for small grid.
                
                def backtrack(idx):
                    if idx==len(cells):
                        # all assigned, record target value
                        values.add(assign[target])
                        return
                    x,y = cells[idx]
                    # possible values: from 0 to bound
                    for v in range(0, bound+1):
                        # assign
                        assign[(x,y)] = v
                        # early prune: check any triple that is now fully assigned
                        ok = True
                        # also check any triple that includes this cell and is fully assigned
                        # find triples that involve (x,y)
                        # triples are keyed by (i,j) bottom-left; includes (i,j), (i,j+1), (i+1,j)
                        # So (x,y) could be bottom-left, top-left, or bottom-right.
                        related = []
                        # bottom-left
                        if (x,y) in triples:
                            related.append(triples[(x,y)])
                        # top-left: (x, y-1) if y>0
                        if y>0 and (x, y-1) in triples:
                            related.append(triples[(x, y-1)])
                        # bottom-right: (x-1, y) if x>0
                        if x>0 and (x-1, y) in triples:
                            related.append(triples[(x-1, y)])
                        for tri in related:
                            if all(p in assign for p in tri):
                                if not check_triple(tri):
                                    ok=False
                                    break
                        if ok:
                            backtrack(idx+1)
                        # remove assignment
                        del assign[(x,y)]
                    # end for
                # set initial condition g(0,0)=0
                # we can start with that fixed
                # reorder cells to start with (0,0) first
                # Ensure (0,0) is first in cells
                # We'll just set assign before recursion
                assign[(0,0)] = 0
                # Remove (0,0) from cells list
                cells2 = [c for c in cells if c!=(0,0)]
                # Use new order
                cells = cells2
                backtrack(0)
                return values
            
