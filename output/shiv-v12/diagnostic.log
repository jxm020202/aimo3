from functools import lru_cache

def possible_next_diagonal(prev):
    # prev is a tuple of values for diagonal d (length d+1)
    d = len(prev) - 1
    results = []
    # We'll generate all possible sequences for next diagonal of length d+2
    # using backtracking
    def backtrack(i, cur):
        # i is index in prev (0..d) we are processing; cur is list of b values built so far (length i+1)
        if i == d:
            # need to choose b_{d+1} such that triple {prev[d], cur[d], b_{d+1}} consecutive
            a = prev[d]
            b = cur[d]
            # compute possible c values
            candidates = []
            diff = abs(a - b)
            if diff == 1:
                m = min(a,b)
                M = max(a,b)
                candidates = [m-1, M+1]
            elif diff == 2:
                candidates = [min(a,b)+1]
            else:
                # diff cannot be 0 or >2 for valid triple
                return
            for c in candidates:
                if c >= 0:
                    results.append(tuple(cur + [c]))
            return
        else:
            # need to choose b_{i+1} given a_i = prev[i], b_i = cur[i]
            a = prev[i]
            b = cur[i]
            diff = abs(a - b)
            if diff == 1:
                m = min(a,b)
                M = max(a,b)
                candidates = [m-1, M+1]
            elif diff == 2:
                candidates = [min(a,b)+1]
            else:
                return
            for c in candidates:
                if c >= 0:
                    backtrack(i+1, cur + [c])
    # Need to start with possible b0 values. For i=0, we don't have b_{-1}, but we need to consider triple with a0 and b0,b1 later.
    # We'll try all possible b0 values (non-negative) and then backtrack from i=0 after we later choose b1.
    # However backtrack expects cur length i+1 at step i, so we need to start with b0 and then proceed.
    # We'll try b0 from 0 up to some reasonable bound, say max(prev)+2 (since values cannot differ by more than 2 from a0)
    max_val = max(prev) + 2
    for b0 in range(max(0, prev[0]-2), max_val+1):
        # b0 must be such that there exists some b1 making triple consecutive; we will let backtrack handle.
        backtrack(0, [b0])
    return set(results)

# Test for small diagonals
