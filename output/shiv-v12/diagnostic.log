            def reachable_values_exact(target_x, target_y, max_val):
                # exhaustive search with pruning, limited domain 0..max_val
                X = target_x+1
                Y = target_y+1
                points = [(x,y) for x in range(X+1) for y in range(Y+1)]
                order = sorted(points)
                L_shapes = []
                for x in range(X):
                    for y in range(Y):
                        L_shapes.append(((x,y),(x,y+1),(x+1,y)))
                assign = {}
                reachable = set()
                def backtrack(idx):
                    if idx == len(order):
                        reachable.add(assign[(target_x,target_y)])
                        return
                    pt = order[idx]
                    if pt == (0,0):
                        poss = [0]
                    else:
                        poss = range(max_val+1)
                    for v in poss:
                        assign[pt] = v
                        ok=True
                        for a,b,c in L_shapes:
                            if pt not in (a,b,c):
                                continue
                            if a in assign and b in assign and c in assign:
                                vals=[assign[a],assign[b],assign[c]]
                                mn=min(vals)
                                if set(vals)!=set([mn,mn+1,mn+2]):
