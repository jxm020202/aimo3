            def is_linear(sol, size):
                # Determine if there exist A,B,C such that a(x,y)=A*x+B*y+C matches sol
                # Solve for A,B,C using three points (0,0), (1,0), (0,1)
                # Must have integer A,B,C
                a00 = sol[(0,0)]
                a10 = sol[(1,0)]
                a01 = sol[(0,1)]
                # Then A = a10 - a00, B = a01 - a00, C = a00
                A = a10 - a00
                B = a01 - a00
                C = a00
                # Check if (A,B) is one of six allowed pairs
                allowed = [(1,2),(2,1),(-1,1),(1,-1),(-2,-1),(-1,-2)]
                if (A,B) not in allowed:
                    return False
                # Check all points
                for x in range(size):
                    for y in range(size):
                        if sol[(x,y)] != A*x + B*y + C:
                            return False
                return True
            
