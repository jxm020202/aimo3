            def max_matching_size(n):
                G = nx.Graph()
                left = [d for d in range(-(n-1), n) ]  # -n+1..n-1
                right = [d for d in range(0, 2*n-1)]
                G.add_nodes_from([('L',d) for d in left], bipartite=0)
                G.add_nodes_from([('R',d) for d in right], bipartite=1)
                for i in range(n):
                    for j in range(n):
                        d1 = i - j
                        d2 = i + j
                        G.add_edge(('L',d1), ('R',d2))
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=[('L',d) for d in left])
                # matching includes both sides; count edges
                matched_edges = [(u,v) for u,v in matching.items() if u[0]=='L']
                return len(matched_edges)
            
