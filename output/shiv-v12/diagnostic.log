            import itertools
            
            def edge_domination_number_K(n):
                # vertices left 0..n-1, right n..2n-1
                left = list(range(n))
                right = list(range(n,2*n))
                edges = [(l,r) for l in left for r in right]
                m = len(edges)
                for k in range(1, n+1):
                    for subset in itertools.combinations(range(m), k):
                        # compute dominated edges
                        dominated = set()
                        for idx in subset:
                            l,r = edges[idx]
                            # edges sharing l or r
                            for e in edges:
                                if e[0]==l or e[1]==r:
                                    dominated.add(e)
                        if len(dominated)==m:
                            return k
                return None
            
