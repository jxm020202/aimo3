            # compute min vertex cover using Konig's theorem: vertices not reachable from free left vertices in alternating BFS
            def min_vertex_cover_bipartite(G, left_nodes):
                # find maximum matching
                M = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # Build directed graph for alternating BFS
                # Unmatched left vertices are free
                # BFS from free left vertices using alternating edges: unmatched edges from left to right, matched edges from right to left
                # Determine vertices reachable
                # left_nodes set
                left_set = set(left_nodes)
                # Build adjacency for alternating BFS
                # matched edges dict
                matched = {}
                for u,v in M.items():
                    matched[u]=v
                # BFS
                from collections import deque
                visited = set()
                q = deque()
                for u in left_set:
                    if u not in matched:  # free left vertex
                        q.append(u)
                        visited.add(u)
                while q:
                    u = q.popleft()
                    if u in left_set:
                        # explore unmatched edges from left to right
                        for v in G[u]:
                            if (u,v) not in M.items() and (v,u) not in M.items():
                                if v not in visited:
                                    visited.add(v)
                                    q.append(v)
                    else:
                        # u is right vertex, explore matched edge back to left
                        if u in matched:
                            v = matched[u]
                            if v not in visited:
                                visited.add(v)
                                q.append(v)
                # min vertex cover = (left not visited) union (right visited)
                left_not_vis = left_set - visited
                right_vis = set(G) - left_set
                right_vis = right_vis & visited
                cover = left_not_vis | right_vis
                return cover
            
            cover = min_vertex_cover_bipartite(G, left_nodes=L)
            len(cover)
            
