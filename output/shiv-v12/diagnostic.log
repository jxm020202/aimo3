            def build_seq(N):
                # produce sequence of length N with minimal ones (ceil(2N/3))
                # pattern of [1,1,-2] repeated, then extra 1 if needed
                seq = []
                full = N // 3
                rem = N % 3
                seq = [1,1,-2] * full
                if rem == 1:
                    seq.append(1)
                elif rem == 2:
                    seq.extend([1,1])
                return seq[:N]
            
            def compute_g(x,y,seq):
                N = x+y
                # seq length N
                # compute sum of b(s) for first N terms
                total = sum(seq[:N])
                return total + x
            
