            def exists_disjoint_sets(n, msize, asize):
                main_indices=list(range(-(n-1), n))
                anti_indices=list(range(0,2*n-1))
                # precompute intersections: for each main, set of anti it intersects
                inter={}
                for d in main_indices:
                    anti=set()
                    for i in range(n):
                        j=i-d
                        if 0<=j<n:
                            anti.add(i+j)
                    inter[d]=anti
                # brute force small n
                for M in itertools.combinations(main_indices, msize):
                    # compute anti that intersect M
                    anti_inter=set()
                    for d in M:
                        anti_inter.update(inter[d])
                    # we need to choose A subset of anti_indices of size asize such that A ∩ anti_inter = empty
                    # i.e., A must be subset of complement of anti_inter
                    complement=[a for a in anti_indices if a not in anti_inter]
                    if len(complement) >= asize:
                        return True, M, complement[:asize]
                return False, None, None
            
            for n in range(2,9):
                possible, M, A = exists_disjoint_sets(n, n, n)
                print(n, possible)
            
