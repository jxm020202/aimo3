                N = n*n
                # variable ordering: (i,j) -> idx = i*n + j
                # Build constraint matrix A (rows constraints, columns variables)
                rows = []
                for i in range(n):
                    for j in range(n):
                        indices = []
                        # main diagonal: cells where i - j = const
                        const = i - j
                        for x in range(n):
