            def enumerate_grid(max_x, max_y, max_val):
                grid = [[None]*(max_y+1) for _ in range(max_x+1)]
                grid[0][0]=0
                positions = [(i,j) for i in range(max_x+1) for j in range(max_y+1) if not (i==0 and j==0)]
                solutions = []
                def check_cell(i,j):
                    if i>=max_x or j>=max_y:
                        return True
                    a=grid[i][j]
                    b=grid[i+1][j]
                    c=grid[i][j+1]
                    if a is None or b is None or c is None:
                        return True
                    s={a,b,c}
                    if len(s)!=3 or max(s)-min(s)!=2:
