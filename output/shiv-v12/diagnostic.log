        ```python
import numpy as np
from scipy.optimize import milp, LinearConstraint, Bounds

n = 13
N = n * n

def idx(i, j):
    return i * n + j

# Build constraint matrix
A_rows = []
lb = []
ub = []

for i in range(n):
    for j in range(n):
        # squares on same NW-SE diagonal (i-j constant)
        d = i - j
        diag1 = [idx(ii, ii - d) for ii in range(n) if 0 <= ii - d < n]
        # squares on same NE-SW diagonal (i+j constant)
        s = i + j
        diag2 = [idx(ii, s - ii) for ii in range(n) if 0 <= s - ii < n]
        indices = set(diag1) | set(diag2)
        row = np.zeros(N, dtype=int)
        for k in indices:
            row[k] = 1
        A_rows.append(row)
        lb.append(1)          # need at least one marked square on these diagonals
        ub.append(np.inf)    # no upper bound for the sum

A = np.array(A_rows)
lb = np.array(lb)
ub = np.array(ub)

c = np.ones(N)  # objective: minimize total marked squares

lin_con = LinearConstraint(A, lb, ub)
bounds = Bounds(0, 1)   # variables are binary

# Solve integer linear program
res = milp(c=c, constraints=lin_con, integrality=np.arange(N), bounds=bounds, options={"disp": False})

print("ILP success:", res.success)
if not res.success:
    raise RuntimeError("MILP did not solve")

x = np.rint(res.x).astype(int)   # round to 0/1
marked = [(i, j) for i in range(n) for j in range(n) if x[idx(i, j)] == 1]
print("Number of marked squares (minimum):", len(marked))

# Verify that every square threatens a marked square
def threatens(i, j):
    for a, b in marked:
        if abs(a - i) == abs(b - j):
            return True
    return False

all_threatened = all(threatens(i, j) for i in range(n) for j in range(n))
print("All squares threatened:", all_threatened)

# Show the board (optional)
board = np.full((n, n), '.', dtype=str)
for a, b in marked:
    board[a, b] = 'X'
print("\nBoard layout (X = marked):")
for row in board:
    print(' '.join(row))
```

