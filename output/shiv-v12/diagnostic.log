            def valid_colorings(N):
                # grid size N+1 x N+1 (0..N)
                # assign residues 0,1,2 to each point
                # condition: for all (x,y) with x<N, y<N, the set {c[x,y], c[x+1,y], c[x,y+1]} = {0,1,2}
                # backtrack
                c = {}
                solutions = []
                def backtrack(pos):
                    if pos == (N+1)*(N+1):
                        # all assigned
                        solutions.append(c.copy())
                        return
                    # compute coordinates from pos
                    x = pos // (N+1)
                    y = pos % (N+1)
                    # assign possible values
                    for val in (0,1,2):
                        c[(x,y)] = val
                        # check any triangle that is now fully assigned
                        ok = True
                        # triangle with right angle at (x-1,y-1) if x>0 and y>0
                        if x>0 and y>0:
                            tri = [(x-1,y-1),(x,y-1),(x-1,y)]
                            if all(p in c for p in tri):
                                if set(c[p] for p in tri) != {0,1,2}:
                                    ok=False
                        # triangle with right angle at (x-1,y) if x>0 and y<N
                        if ok and x>0 and y<N:
                            tri = [(x-1,y),(x,y),(x-1,y+1)]
                            if all(p in c for p in tri):
                                if set(c[p] for p in tri) != {0,1,2}:
                                    ok=False
                        # triangle with right angle at (x,y-1) if x<N and y>0
                        if ok and x<N and y>0:
                            tri = [(x,y-1),(x+1,y-1),(x,y)]
                            if all(p in c for p in tri):
                                if set(c[p] for p in tri) != {0,1,2}:
                                    ok=False
                        if ok:
                            backtrack(pos+1)
                        # remove assignment
                        del c[(x,y)]
                # set c(0,0)=0 as given
                c[(0,0)] = 0
                # start backtrack from pos=1 (skip (0,0))
                backtrack(1)
                return solutions
            
