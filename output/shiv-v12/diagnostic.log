            import itertools
            
            def min_squares(n):
                cells = [(i,j) for i in range(n) for j in range(n)]
                # Precompute diagonals
                left = lambda i,j: i-j
                right = lambda i,j: i+j
                # All possible squares to mark
                all_squares = cells
                for k in range(1, n*n+1):
                    for combo in itertools.combinations(all_squares, k):
                        # compute covered diagonals
                        L = set(left(i,j) for i,j in combo)
                        R = set(right(i,j) for i,j in combo)
                        ok = True
                        for i,j in cells:
                            if left(i,j) not in L and right(i,j) not in R:
                                ok=False
                                break
                        if ok:
                            return k, combo
                return None
            
