            def min_vertex_cover_from_matching(G, left_nodes):
                # left_nodes: list of left node identifiers
                # Compute set Z of vertices reachable from free (unmatched) left vertices via alternating paths
                # Using standard algorithm
                # Build adjacency dict
                adj = {u: set() for u in G.nodes()}
                for u,v in G.edges():
                    adj[u].add(v)
                    adj[v].add(u)
                # Determine matched pairs
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # Build dict of matches
                match_of = {}
                for u,v in matching.items():
                    match_of[u]=v
                # BFS
                from collections import deque
                Z_left = set()
                Z_right = set()
                queue = deque()
                # start from unmatched left vertices
                for u in left_nodes:
                    if u not in match_of:
                        queue.append(u)
                        Z_left.add(u)
                while queue:
                    u = queue.popleft()
                    if u[0]=='L':  # left node
                        for v in adj[u]:
                            if v not in Z_right and match_of.get(u)!=v:  # edge not in matching
                                Z_right.add(v)
                                if v in match_of:
                                    w = match_of[v]
                                    if w not in Z_left:
                                        Z_left.add(w)
                                        queue.append(w)
                    else:  # right node
                        # follow matched edge only
                        if u in match_of:
                            v = match_of[u]
                            if v not in Z_left:
                                Z_left.add(v)
                                queue.append(v)
                # min vertex cover = (L \ Z_left) ∪ (R ∩ Z_right)
                cover = set()
                for u in left_nodes:
                    if u not in Z_left:
                        cover.add(u)
                for u in G.nodes():
                    if u[0]=='R' and u in Z_right:
                        cover.add(u)
                return cover
            
