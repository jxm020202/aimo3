                n=13
                squares = [(i,j) for i in range(n) for j in range(n)]
                sq_index = { (i,j): idx for idx,(i,j) in enumerate(squares) }
                d1_vals = list(range(-(n-1), n))
                d2_vals = list(range(0, 2*n-1))
                d1_index = {d:i for i,d in enumerate(d1_vals)}
                d2_index = {d:i for i,d in enumerate(d2_vals)}
                num_sq = len(squares)
                num_d1 = len(d1_vals)
                num_d2 = len(d2_vals)
                total_vars = num_sq + num_d1 + num_d2
                # Build constraints as before
                rows = []
                lbs = []
                ubs = []
                for (i,j) in squares:
                    row = np.zeros(total_vars, dtype=int)
                    d1 = i - j
                    d2 = i + j
                    row[num_sq + d1_index[d1]] = 1
                    row[num_sq + num_d1 + d2_index[d2]] = 1
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(np.inf)
                for d1 in d1_vals:
                    row = np.zeros(total_vars, dtype=int)
                    row[num_sq + d1_index[d1]] = 1
                    for i in range(n):
                        j = i - d1
                        if 0 <= j < n:
                            row[sq_index[(i,j)]] = -1
                    rows.append(row); lbs.append(-np.inf); ubs.append(0)
                for (i,j) in squares:
                    d1 = i - j
                    row = np.zeros(total_vars, dtype=int)
                    row[sq_index[(i,j)]] = 1
                    row[num_sq + d1_index[d1]] = -1
                    rows.append(row); lbs.append(-np.inf); ubs.append(0)
                for d2 in d2_vals:
                    row = np.zeros(total_vars, dtype=int)
                    row[num_sq + num_d1 + d2_index[d2]] = 1
                    for i in range(n):
                        j = d2 - i
                        if 0 <= j < n:
                            row[sq_index[(i,j)]] = -1
                    rows.append(row); lbs.append(-np.inf); ubs.append(0)
                for (i,j) in squares:
                    d2 = i + j
                    row = np.zeros(total_vars, dtype=int)
                    row[sq_index[(i,j)]] = 1
                    row[num_sq + num_d1 + d2_index[d2]] = -1
                    rows.append(row); lbs.append(-np.inf); ubs.append(0)
                A = np.vstack(rows)
