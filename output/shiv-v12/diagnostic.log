            def max_matching_size():
                import networkx as nx
                n=13
                G = nx.Graph()
                # left nodes: d1 indices with prefix 'L'
                d1_vals = list(range(-(n-1), n))
                d2_vals = list(range(0, 2*n-1))
                for d1 in d1_vals:
                    G.add_node(('L',d1), bipartite=0)
                for d2 in d2_vals:
                    G.add_node(('R',d2), bipartite=1)
                for i in range(n):
                    for j in range(n):
                        d1 = i - j
                        d2 = i + j
                        G.add_edge(('L',d1), ('R',d2))
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=[('L',d) for d in d1_vals])
                # matching is dict mapping each node to its partner
                # size = number of edges = len(matching)//2
                size = len(matching)//2
                return size
            
