            # compute minimum vertex cover using Konig's theorem (networkx has function)
            def min_vertex_cover_bipartite(G, left_nodes):
                # from networkx docs: use maximum matching to get min vertex cover
                # compute set of vertices reachable from unmatched left vertices via alternating paths
                # then cover = (left - reachable_left) union (right ∩ reachable)
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # Build dict of matches
                # Determine unmatched left vertices
                matched_left = {u for u in matching if u in left_nodes}
                unmatched_left = set(left_nodes) - matched_left
                # BFS alternating paths
                visited_left = set()
                visited_right = set()
                from collections import deque
                q = deque(unmatched_left)
                while q:
                    u = q.popleft()
                    if u in left_nodes:
                        visited_left.add(u)
                        # edges not in matching
                        for v in G[u]:
                            if matching.get(u) != v and v not in visited_right:
                                visited_right.add(v)
                                q.append(v)
                    else:
                        visited_right.add(u)
                        # matched edge
                        v = matching.get(u)
                        if v and v not in visited_left:
                            visited_left.add(v)
                            q.append(v)
                # min vertex cover
                cover = (set(left_nodes) - visited_left) | visited_right
                return cover
            
            cover = min_vertex_cover_bipartite(G, left_nodes)
            len(cover)
            
