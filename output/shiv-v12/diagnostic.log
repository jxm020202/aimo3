            import networkx as nx
            def max_matching_size(n):
                G=nx.Graph()
                # left nodes: main diagonals indexed -n+1..n-1
                # right nodes: anti diagonals 0..2n-2
                for i in range(n):
                    for j in range(n):
                        d1=i-j
                        d2=i+j
                        G.add_edge(('m',d1), ('a',d2))
                matching=nx.algorithms.bipartite.maximum_matching(G, top_nodes=[('m',d) for d in range(-(n-1), n)])
                # matching includes both directions, size is half of dict length
                size=len(matching)//2
                return size
            for n in range(1,15):
                print(n, max_matching_size(n))
            
