            def find_balanced_vertex_cover(max_left=12, max_right=12):
                n=13
                # variables for each diagonal left and right: binary
                d1_vals = list(range(-(n-1), n))
                d2_vals = list(range(0, 2*n-1))
                num_left = len(d1_vals)
                num_right = len(d2_vals)
                total_vars = num_left + num_right
                # constraints: for each square (i,j), left[d1] + right[d2] >= 1
                rows = []
                lbs = []
                ubs = []
                for i in range(n):
                    for j in range(n):
                        row = np.zeros(total_vars, dtype=int)
                        d1 = i - j
                        d2 = i + j
                        row[d1_index[d1]] = 1
                        row[num_left + d2_index[d2]] = 1
                        rows.append(row)
                        lbs.append(1)
                        ubs.append(np.inf)
                A = np.vstack(rows)
                lc = LinearConstraint(A, lbs, ubs)
                # objective: minimize total selected diagonals (should be 24)
                c = np.ones(total_vars)
                bounds = Bounds(0,1)
                integrality = np.ones(total_vars, dtype=int)
                # add constraints for max left/right
                # left sum <= max_left, right sum <= max_right, and total sum = 24
                # We'll add them as linear constraints
                # left sum <= max_left
                row_left = np.zeros(total_vars)
                row_left[:num_left] = 1
