            def is_linear(sol):
                # check if sol matches ax+by+c with (a,b) being (1,2) or (2,1)
                # compute coefficients via solving linear equations from three points
                # use points (0,0),(1,0),(0,1)
                c0 = sol[(0,0)]
                c1 = sol[(1,0)]
                c2 = sol[(0,1)]
                # we need a,b such that:
                # c1 = a*1 + b*0 + c0 => a = c1 - c0
                # c2 = a*0 + b*1 + c0 => b = c2 - c0
                a = c1 - c0
                b = c2 - c0
                # check if a,b are (1,2) or (2,1)
                if (a,b) not in [(1,2),(2,1)]:
                    return False
                # verify all points
                for (x,y), val in sol.items():
                    if val != a*x + b*y + c0:
                        return False
                return True
            
