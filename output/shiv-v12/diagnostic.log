            def solve_min_marked():
                n=13
                # map squares to index
                squares = [(i,j) for i in range(n) for j in range(n)]
                sq_index = { (i,j): idx for idx,(i,j) in enumerate(squares) }
                # diagonals
                d1_vals = list(range(-(n-1), n))  # -12..12
                d2_vals = list(range(0, 2*n-1))   # 0..24
                d1_index = {d:i for i,d in enumerate(d1_vals)}
                d2_index = {d:i for i,d in enumerate(d2_vals)}
                num_sq = len(squares)  # 169
                num_d1 = len(d1_vals)  # 25
                num_d2 = len(d2_vals)  # 25
                total_vars = num_sq + num_d1 + num_d2
                # variable ordering: x (sq), y (d1), z (d2)
                # Build constraints
                rows = []
                lbs = []
                ubs = []
                # Constraint 1: for each square, y[d1] + z[d2] >= 1
                for (i,j) in squares:
                    row = np.zeros(total_vars, dtype=int)
                    d1 = i - j
                    d2 = i + j
                    row[num_sq + d1_index[d1]] = 1  # y
                    row[num_sq + num_d1 + d2_index[d2]] = 1  # z
                    rows.append(row)
                    lbs.append(1)
                    ubs.append(np.inf)
                # Constraint 2: y[d1] <= sum x on that diagonal
                # For each d1
                for d1 in d1_vals:
                    row = np.zeros(total_vars, dtype=int)
                    row[num_sq + d1_index[d1]] = 1  # y
                    # subtract x for squares on this diagonal
                    for i in range(n):
                        j = i - d1
                        if 0 <= j < n:
                            row[sq_index[(i,j)]] = -1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(0)
                # Constraint 3: x <= y for each square on diagonal d1
                for (i,j) in squares:
                    d1 = i - j
                    row = np.zeros(total_vars, dtype=int)
                    row[sq_index[(i,j)]] = 1
                    row[num_sq + d1_index[d1]] = -1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(0)
                # Constraint 4: z[d2] <= sum x on that diagonal
                for d2 in d2_vals:
                    row = np.zeros(total_vars, dtype=int)
                    row[num_sq + num_d1 + d2_index[d2]] = 1  # z
                    for i in range(n):
                        j = d2 - i
                        if 0 <= j < n:
                            row[sq_index[(i,j)]] = -1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(0)
                # Constraint 5: x <= z for each square
                for (i,j) in squares:
                    d2 = i + j
                    row = np.zeros(total_vars, dtype=int)
                    row[sq_index[(i,j)]] = 1
                    row[num_sq + num_d1 + d2_index[d2]] = -1
                    rows.append(row)
                    lbs.append(-np.inf)
                    ubs.append(0)
                A = np.vstack(rows)
                lc = LinearConstraint(A, lbs, ubs)
                # Objective: minimize sum x (first num_sq entries)
                c = np.zeros(total_vars)
                c[:num_sq] = 1
                # Bounds: all variables binary 0-1
                bounds = Bounds(0, 1)
                integrality = np.ones(total_vars, dtype=int)
                # Solve
                res = milp(c=c, constraints=lc, bounds=bounds, integrality=integrality, options={'presolve': True, 'disp': False})
