            def min_vertex_cover(G, left_nodes):
                # left_nodes is list of left side nodes
                # compute maximum matching
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # matching dict includes both directions
                # Build sets
                left_set = set(left_nodes)
                right_set = set(G) - left_set
                # Find unmatched left vertices
                unmatched_left = [v for v in left_set if v not in matching]
                # BFS alternating
                visited_left = set()
                visited_right = set()
                from collections import deque
                q = deque()
                for v in unmatched_left:
                    q.append((v, 'L'))  # start from left
                    visited_left.add(v)
                while q:
                    v, side = q.popleft()
                    if side == 'L':
                        # traverse edges not in matching
                        for nbr in G[v]:
                            if matching.get(v) == nbr:
                                continue  # skip matched edge
                            if nbr not in visited_right:
                                visited_right.add(nbr)
                                q.append((nbr, 'R'))
                    else:  # side == 'R'
                        # traverse matched edge only
                        mate = matching.get(v)
                        if mate is not None and mate not in visited_left:
                            visited_left.add(mate)
                            q.append((mate, 'L'))
                Z_left = visited_left
                Z_right = visited_right
                # min vertex cover = (L \ Z) ∪ (R ∩ Z)
                cover = (left_set - Z_left) | (Z_right)
                return cover
            
