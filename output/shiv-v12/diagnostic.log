            def min_vertex_cover_from_matching(G, left_nodes):
                # G bipartite with left_nodes set
                # Compute maximum matching (dictionary)
                matching = nx.algorithms.bipartite.maximum_matching(G, top_nodes=left_nodes)
                # matching includes both sides; each edge appears twice
                # Build adjacency for alternating paths
                # Unmatched left vertices
                unmatched_left = [u for u in left_nodes if u not in matching]
                # BFS alternating
                visited_left = set()
                visited_right = set()
                from collections import deque
                q = deque()
                for u in unmatched_left:
                    q.append(('L', u))
                    visited_left.add(u)
                while q:
                    side, v = q.popleft()
                    if side == 'L':
                        # edges not in matching
                        for w in G.neighbors(v):
                            if matching.get(v) != w and w not in visited_right:
                                visited_right.add(w)
                                q.append(('R', w))
                    else:  # side == 'R'
                        # follow matched edge
                        w = matching.get(v)
                        if w and w not in visited_left:
                            visited_left.add(w)
                            q.append(('L', w))
                # Minimum vertex cover = (Left - visited_left) ∪ (Right ∩ visited_right)
                left_set = set(left_nodes)
                right_set = set(G) - left_set
                cover = (left_set - visited_left) | (right_set & visited_right)
                return cover
            
