            def possible_values_grid(max_x, max_y):
                # Initialize possible sets
                poss = {}
                for i in range(max_x+1):
                    for j in range(max_y+1):
                        max_val = 2*(i+j)  # upper bound
                        poss[(i,j)] = set(range(max_val+1))
                poss[(0,0)] = {0}
                changed = True
                while changed:
                    changed=False
                    # enforce cell constraints
                    for i in range(max_x):
                        for j in range(max_y):
                            Aset = poss[(i,j)]
                            Bset = poss[(i+1,j)]
                            Cset = poss[(i,j+1)]
                            # compute allowed triples
                            # For each possible n, allowed set = {n,n+1,n+2}
                            # So we need to keep only values that can be part of some triple.
                            # We'll compute new possible values for each variable as those that appear in any allowed triple consistent with other sets.
                            newA=set()
                            newB=set()
                            newC=set()
                            # iterate over possible n within reasonable range
                            # n can be from 0 to max possible value (maybe up to max of sets)
                            max_n = max(max(Aset), max(Bset), max(Cset))
                            for n in range(max_n+1):
                                triple = {n, n+1, n+2}
                                # check if there exists assignment of A,B,C to these three values such that each is in its set
                                # i.e., there is a bijection from {A,B,C} to triple where each assigned value in respective set.
                                # Equivalent to check if triple intersect Aset nonempty, etc, and can assign distinct values.
                                # We'll brute force permutations.
                                from itertools import permutations
                                for perm in permutations(triple):
                                    a,b,c = perm
                                    if a in Aset and b in Bset and c in Cset:
                                        newA.add(a); newB.add(b); newC.add(c)
                            # Update sets
                            if newA and newA != Aset:
                                poss[(i,j)] = newA
                                changed=True
                            if newB and newB != Bset:
                                poss[(i+1,j)] = newB
                                changed=True
                            if newC and newC != Cset:
                                poss[(i,j+1)] = newC
                                changed=True
                return poss
            
