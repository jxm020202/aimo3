            def bishop_domination_number(n):
                # brute force search for small n using ILP
                from itertools import product
                import numpy as np
                from scipy.optimize import milp, LinearConstraint, Bounds
                # map squares
                idx = {}
                for i in range(n):
                    for j in range(n):
                        idx[(i,j)] = len(idx)
                N = n*n
                # constraints: each square must be covered by a marked square on same diagonal
                A = np.zeros((N,N), dtype=int)
                for i in range(n):
                    for j in range(n):
                        s = idx[(i,j)]
                        for a in range(n):
                            for b in range(n):
                                if a-b == i-j or a+b == i+j:
                                    A[s, idx[(a,b)]] = 1
                c = np.ones(N, dtype=int)
                lin = LinearConstraint(A, np.ones(N, dtype=int), np.full(N, np.inf))
                bounds = Bounds(0,1)
                res = milp(c=c, constraints=lin, bounds=bounds, integrality=np.ones(N, dtype=int))
                return int(round(res.fun))
            
            for n in range(1,9):
                print(n, bishop_domination_number(n))
            
